s":"cropped-headed"}],"gloss":"cropped-headed","split_unverified":true},{"surface":"பாவை","parts":[{"text":"பாவை","lemma":"pāvai","gloss":"doll"}],"gloss":"doll-like stubble"}]},{"words":[{"surface":"இருவிசேர்","parts":[{"text":"இருவி","lemma":"iruvi","gloss":"stubble"},{"text":"சேர்","lemma":"cēr","gloss":"near"}],"gloss":"near the stubble"},{"surface":"மருங்கிற்","parts":[{"text":"மருங்கிற்","lemma":"மருங்கிற்","gloss":"at the side"}],"gloss":"at the side","split_unverified":true},{"surface":"பூத்த","parts":[{"text":"பூ","lemma":"pū","gloss":"flower"},{"text":"த்த","lemma":"tta","gloss":"past relative participle suffix"}],"gloss":"blossomed"},{"surface":"முல்லை","parts":[{"text":"முல்லை","lemma":"mullai","gloss":"jasmine"}],"gloss":"jasmine"}]},{"words":[{"surface":"வெருகுசிரித்","parts":[{"text":"வெருகுசிரித்","lemma":"வெருகுசிரித்","gloss":"wildcat grinning"}],"gloss":"wildcat grinning","split_unverified":true},{"surface":"தன்ன","parts":[{"text":"தன்ன","lemma":"தன்ன","gloss":"like"}],"gloss":"like","split_unverified":true},{"surface":"பசுவீ","parts":[{"text":"பசு","lemma":"pacu","gloss":"fresh"},{"text":"வீ","lemma":"vī","gloss":"flower"}],"gloss":"fresh flowers"},{"surface":"மென்பிணி","parts":[{"text":"மென்பிணி","lemma":"மென்பிணி","gloss":"softly bound"}],"gloss":"softly bound","split_unverified":true}]},{"words":[{"surface":"குறுமுகை","parts":[{"text":"குறு","lemma":"kuṟu","gloss":"short"},{"text":"முகை","lemma":"mukai","gloss":"bud"}],"gloss":"small buds"},{"surface":"அவிழ்ந்த","parts":[{"text":"அவிழ்","lemma":"aviḻ","gloss":"open"},{"text":"ந்த","lemma":"nta","gloss":"past relative participle suffix"}],"gloss":"opened"},{"surface":"நறுமலர்ப்","parts":[{"text":"நறுமலர்ப்","lemma":"நறுமலர்ப்","gloss":"fragrant flowers"}],"gloss":"fragrant flowers","split_unverified":true},{"surface":"புறவின்","parts":[{"text":"புறவு","lemma":"puṟavu","gloss":"woodland"},{"text":"இன்","lemma":"iṉ","gloss":"of"}],"gloss":"of the woodland"}]},{"words":[{"surface":"வண்டுசூழ்","parts":[{"text":"வண்டு","lemma":"vaṇṭu","gloss":"bee"},{"text":"சூழ்","lemma":"cūḻ","gloss":"surround"}],"gloss":"bee-surrounded"},{"surface":"மாலையும்","parts":[{"text":"மாலை","lemma":"mālai","gloss":"evening"},{"text":"உம்","lemma":"um","gloss":"even"}],"gloss":"even the evening"},{"surface":"வாரார்","parts":[{"text":"வாரார்","lemma":"வாரார்","gloss":"he has not returned"}],"gloss":"he has not returned","split_unverified":true}]},{"words":[{"surface":"கண்டிசிற்","parts":[{"text":"கண்டிசிற்","lemma":"கண்டிசிற்","gloss":"look!"}],"gloss":"look!","split_unverified":true},{"surface":"றோழி","parts":[{"text":"றோழி","lemma":"றோழி","gloss":"O friend!"}],"gloss":"O friend!","split_unverified":true},{"surface":"பொருட்பிரிந்","parts":[{"text":"பொருட்பிரிந்","lemma":"பொருட்பிரிந்","gloss":"parted for wealth"}],"gloss":"parted for wealth","split_unverified":true},{"surface":"தோரே","parts":[{"text":"தோர்","lemma":"tōr","gloss":"he who"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"he who"}]}],"literal":"Sprouted by old rain, of the new upland field's millet / grazed by the stag, the cropped-headed doll-like stubble / near the side of which blossomed the jasmine / like a wildcat grinning, the fresh flowers' softly bound / small buds opened in the fragrant-flowered woodland / even in the evening surrounded by bees, he has not returned / look, O friend, he who parted for wealth!","translation":"O friend, look! He who parted from me in search of wealth has still not returned, even as evening falls and bees swarm. In the fragrant woodland, the soft, tightly bound buds of the fresh jasmine have blossomed near the cropped millet stubble—which, grazed by stags in the upland fields nourished by early rains, now stands looking like headless dolls—and their opening petals resemble the white, grinning teeth of a wildcat.","modern":"பழைய மழையினால் செழித்து வளர்ந்த புதிய புனத்து வரகினை ஆண் மான் மேய்ந்ததால், மொட்டையடிக்கப்பட்ட தலைகளை உடைய பொம்மைகளைப் போலத் தோன்றும் வரகுத் தாள்களின் பக்கத்திலே பூத்த முல்லைக் கொடியின், காட்டுப்பூனையின் சிரிப்பைப் போன்ற பசிய இதழ்களைக் கொண்ட மென்மையான கட்டுகளையுடைய சிறிய மொட்டுகள் அவிழ்ந்து மலர்ந்த நறுமணம் வீசும் காட்டில், வண்டுகள் சூழ்ந்து சுழலும் மாலைக் காலத்திலும் அவர் வரவில்லை; தோழியே! பொருள் தேடப் பிரிந்து சென்றவரைப் பார்!","explanation":"This poem is spoken by the heroine to her friend during the rainy season, which was the agreed time for the hero's return. The setting is the mullai (forest) landscape, which is traditionally associated with patient waiting. The heroine describes the woodland where early rains have caused the millet to grow, which has now been harvested and grazed by stags, leaving stubble that resembles headless dolls. Next to this stubble, the fresh jasmine buds have opened, and their white petals are compared to the grinning teeth of a wildcat. This striking and slightly unsettling image of the wildcat's grin reflects the heroine's inner anxiety and distress as evening falls and bees swarm, yet her lover has still not returned.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.68],[0.77,1.1],[1.1,1.51],[1.83,2.06],[2.17,2.4],[2.4,2.4],[2.4,3.07],[3.07,3.33],[3.6,4.7],[4.7,5.1],[5.1,5.2],[5.2,5.6],[5.6,6.9],[6.9,7.0],[7.0,7.4],[7.5,7.9],[7.9,8.9],[8.9,9.5],[9.5,9.7],[9.7,10.3],[10.3,11.0],[11.0,11.5],[11.5,11.7],[11.7,12.87],[12.95,13.2],[13.2,13.8],[13.8,14.1]],"female":[[0.0,0.8],[0.94,1.22],[1.22,1.8],[1.8,1.9],[1.9,2.8],[2.8,2.9],[2.9,3.7],[3.7,4.0],[4.0,4.0],[4.0,5.8],[5.8,6.0],[6.0,6.5],[6.5,6.5],[6.5,6.5],[6.5,6.5],[6.5,6.5],[6.5,10.1],[10.1,10.6],[10.6,10.8],[10.8,11.4],[11.4,12.1],[12.1,12.6],[12.6,12.8],[12.8,13.69],[13.87,14.04],[14.4,15.13],[15.13,15.33]]}}