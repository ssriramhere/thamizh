{"text":"kuruntokai","n":220,"lines":["பழமழைக் கலித்த புதுப்புன வரகின்","இரலை மேய்ந்த குறைத்தலைப் பாவை","இருவிசேர் மருங்கிற் பூத்த முல்லை","வெருகுசிரித் தன்ன பசுவீ மென்பிணி","குறுமுகை அவிழ்ந்த நறுமலர்ப் புறவின்","வண்டுசூழ் மாலையும் வாரார்","கண்டிசிற் றோழி பொருட்பிரிந் தோரே"],"tr":["paḻamaḻaik kalitta putuppuṉa varakiṉ","iralai mēynta kuṟaittalaip pāvai","iruvicēr maruṅkiṟ pūtta mullai","verukucirit taṉṉa pacuvī meṉpiṇi","kuṟumukai aviḻnta naṟumalarp puṟaviṉ","vaṇṭucūḻ mālaiyum vārār","kaṇṭiciṟ ṟōḻi poruṭpirin tōrē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"ஒக்கூர் மாசாத்தியார்","speaker_en":"the heroine (talaivi)","poet_tr":"Okkūr Mācāttiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 14, āciriyattaḷai 12"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பழமழைக்","tr":"paḻamaḻaik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பழ","tr":"paḻa"},{"kind":"nirai","text":"மழைக்","tr":"maḻaik"}]},{"text":"கலித்த","tr":"kalitta","foot":"puḷimā","acai":[{"kind":"nirai","text":"கலித்","tr":"kalit"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"புதுப்புன","tr":"putuppuṉa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"புதுப்","tr":"putup"},{"kind":"nirai","text":"புன","tr":"puṉa"}]},{"text":"வரகின்","tr":"varakiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"வர","tr":"vara"},{"kind":"nēr","text":"கின்","tr":"kiṉ"}]}],[{"text":"இரலை","tr":"iralai","foot":"puḷimā","acai":[{"kind":"nirai","text":"இர","tr":"ira"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"மேய்ந்த","tr":"mēynta","foot":"tēmā","acai":[{"kind":"nēr","text":"மேய்ந்","tr":"mēyn"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"குறைத்தலைப்","tr":"kuṟaittalaip","foot":"karuviḷam","acai":[{"kind":