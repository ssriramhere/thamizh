{"text":"kuruntokai","n":180,"lines":["பழூஉப்பல் அன்ன பருவுகிர்ப் பாவடி","இருங்களிற் றினநிரை யேந்தல் வரின்மாய்ந்","தறைமடி கரும்பின் கண்ணிடை யன்ன","பைத லொருகழை நீடிய சுரனிறந்து","எய்தினர் கொல்லோ பொருளே யல்குல்","அவ்வரி வாடத் துறந்தோர்","வன்ப ராகத்தாஞ் சென்ற நாட்டே"],"tr":["paḻūuppal aṉṉa paruvukirp pāvaṭi","iruṅkaḷiṟ ṟiṉanirai yēntal variṉmāyn","taṟaimaṭi karumpiṉ kaṇṇiṭai yaṉṉa","paita lorukaḻai nīṭiya curaṉiṟantu","eytiṉar kollō poruḷē yalkul","avvari vāṭat tuṟantōr","vaṉpa rākattāñ ceṉṟa nāṭṭē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"கச்சிப்பேட்டு நன்னாகையார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kaccippēṭṭu Naṉṉākaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 24, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 15, āciriyattaḷai 11"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பழூஉப்பல்","tr":"paḻūuppal","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"பழூ","tr":"paḻū"},{"kind":"nēr","text":"உப்","tr":"up"},{"kind":"nēr","text":"பல்","tr":"pal"}]},{"text":"அன்ன","tr":"aṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"அன்","tr":"aṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"பருவுகிர்ப்","tr":"paruvukirp","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பரு","tr":"paru"},{"kind":"nirai","text":"வுகிர்ப்","tr":"vukirp"}]},{"text":"பாவடி","tr":"pāvaṭi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nirai","text":"வடி","tr":"vaṭi"}]}],[{"text":"இருங்களிற்","tr":"iruṅkaḷiṟ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இருங்","tr":"iruṅ"},{"kind":"nirai","text":"களிற்","tr":"kaḷiṟ"}]},{"text":"றினநிரை","tr":"ṟiṉanirai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"றின","tr":"ṟiṉa"},{"kind":"nirai","text":"நிரை","tr":"nirai"}]},{"text":"யேந்தல்","tr":"yēntal"