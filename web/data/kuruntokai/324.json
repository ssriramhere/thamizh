{"text":"kuruntokai","n":324,"lines":["கொடுங்கால் முதலைக் கோள்வ லேற்றை","வழிவழக் கறுக்குங் கானலம் பெருந்துறை","இனமீன் இருங்கழி நீந்தி நீநின்","நயனுடை மையின் வருதி யிவடன்","மடனுடை மையின் உயங்கும் யானது","கவைமக நஞ்சுண் டாஅங்","கஞ்சுவல் பெருமவென் னெஞ்சத் தானே"],"tr":["koṭuṅkāl mutalaik kōḷva lēṟṟai","vaḻivaḻak kaṟukkuṅ kāṉalam peruntuṟai","iṉamīṉ iruṅkaḻi nīnti nīniṉ","nayaṉuṭai maiyiṉ varuti yivaṭaṉ","maṭaṉuṭai maiyiṉ uyaṅkum yāṉatu","kavaimaka nañcuṇ ṭāaṅ","kañcuval perumaveṉ ṉeñcat tāṉē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தோழி கூற்று","poet_ta":"கவை மகனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kavai Makaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 13, āciriyattaḷai 13"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கொடுங்கால்","tr":"koṭuṅkāl","foot":"puḷimā","acai":[{"kind":"nirai","text":"கொடுங்","tr":"koṭuṅ"},{"kind":"nēr","text":"கால்","tr":"kāl"}]},{"text":"முதலைக்","tr":"mutalaik","foot":"puḷimā","acai":[{"kind":"nirai","text":"முத","tr":"muta"},{"kind":"nēr","text":"லைக்","tr":"laik"}]},{"text":"கோள்வ","tr":"kōḷva","foot":"tēmā","acai":[{"kind":"nēr","text":"கோள்","tr":"kōḷ"},{"kind":"nēr","text":"வ","tr":"va"}]},{"text":"லேற்றை","tr":"lēṟṟai","foot":"tēmā","acai":[{"kind":"nēr","text":"லேற்","tr":"lēṟ"},{"kind":"nēr","text":"றை","tr":"ṟai"}]}],[{"text":"வழிவழக்","tr":"vaḻivaḻak","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வழி","tr":"vaḻi"},{"kind":"nirai","text":"வழக்","tr":"vaḻak"}]},{"text":"கறுக்குங்","tr":"kaṟukkuṅ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கறுக்","tr":"kaṟuk"},{"kind":"nēr","text":"குங்","tr":"kuṅ"}]},{"text":"கானலம்","tr":"kāṉalam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"னலம்","tr":"ṉal