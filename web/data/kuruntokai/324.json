"துறை","lemma":"துறை","gloss":"shore"}],"gloss":"great shore"}]},{"words":[{"surface":"இனமீன்","parts":[{"text":"இனம்","lemma":"இனம்","gloss":"shoal"},{"text":"மீன்","lemma":"மீன்","gloss":"fish"}],"gloss":"shoals of fish"},{"surface":"இருங்கழி","parts":[{"text":"இருமை","lemma":"இருமை","gloss":"dark"},{"text":"கழி","lemma":"கழி","gloss":"backwater"}],"gloss":"dark backwater"},{"surface":"நீந்தி","parts":[{"text":"நீந்து","lemma":"நீந்து","gloss":"swim"},{"text":"இ","lemma":"இ","gloss":"having"}],"gloss":"having swum"},{"surface":"நீ","parts":[{"text":"நீ","lemma":"நீ","gloss":"you"}],"gloss":"you"},{"surface":"நின்","parts":[{"text":"நின்","lemma":"நின்","gloss":"your"}],"gloss":"your"}]},{"words":[{"surface":"நயனுடை","parts":[{"text":"நயனுடை","lemma":"நயனுடை","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மையின்","parts":[{"text":"மையின்","lemma":"மையின்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"வருதி","parts":[{"text":"வருதி","lemma":"வருதி","gloss":""}],"gloss":"","split_unverified":true},{"surface":"யிவடன்","parts":[{"text":"யிவடன்","lemma":"யிவடன்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"மடனுடைமையின்","parts":[{"text":"மடன்","lemma":"மடன்","gloss":"innocence"},{"text":"உடைமை","lemma":"உடைமை","gloss":"possession"},{"text":"இன்","lemma":"இன்","gloss":"because of"}],"gloss":"because of having innocence"},{"surface":"உயங்கும்","parts":[{"text":"உயங்கு","lemma":"உயங்கு","gloss":"grieve"},{"text":"உம்","lemma":"உம்","gloss":"does"}],"gloss":"grieves"},{"surface":"யான்","parts":[{"text":"யான்","lemma":"யான்","gloss":"I"}],"gloss":"I"},{"surface":"அது","parts":[{"text":"அது","lemma":"அது","gloss":"that"}],"gloss":"that"}]},{"words":[{"surface":"கவைமக","parts":[{"text":"கவைமக","lemma":"கவைமக","gloss":""}],"gloss":"","split_unverified":true},{"surface":"நஞ்சுண்","parts":[{"text":"நஞ்சுண்","lemma":"நஞ்சுண்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"டாஅங்","parts":[{"text":"டாஅங்","lemma":"டாஅங்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"கஞ்சுவல்","parts":[{"text":"கஞ்சுவல்","lemma":"கஞ்சுவல்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"பெருமவென்","parts":[{"text":"பெருமவென்","lemma":"பெருமவென்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"னெஞ்சத்","parts":[{"text":"னெஞ்சத்","lemma":"னெஞ்சத்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தானே","parts":[{"text":"தானே","lemma":"தானே","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true}],"literal":"Curved-legged crocodile's strong-at-seizing male / blocks the usage of the path in the beautiful seaside grove's great shore. / Swimming the dark backwater with shoals of fish, you, because of your / affection, come. She, / because of her innocence, grieves. I, / like a double-headed child who has consumed poison, / fear, O Lord, in my heart.","translation":"The strong male crocodile with curved legs blocks the path along the great shore of the beautiful seaside grove. Yet, swimming through the dark backwater filled with shoals of fish, you come here out of your great love. She, in her innocence, suffers from worry. And I, O Lord, feel a deep dread in my heart, like a double-headed child when one of its heads has consumed poison.","modern":"வளைந்த கால்களையும் இரையைப்பற்றும் வலிமையையும் உடைய ஆண் முதலை நடமாடும் வழியை அடைக்கும் சோலை சூழ்ந்த பெரிய கடற்கரைத் துறைமுகத்தில், மீன் கூட்டங்கள் நிறைந்த கரிய கழியை நீந்தி உமது அன்பின் காரணமாக நீர் வருகிறீர். இவளோ தன் அறியாமையினால் வருந்துகிறாள். பெருமானே! இருதலைப் பறவை நஞ்சுண்டது போல, யான் என் நெஞ்சத்தில் அஞ்சுகிறேன்.","explanation":"This poem is spoken by the heroine's friend to the hero when he arrives for a secret meeting at night. She describes the extreme dangers of his journey to urge him to seek a formal public marriage. The path is blocked by a fierce male crocodile, and he must swim through dark, deep backwaters. While the hero undertakes this perilous journey out of deep affection, the heroine is consumed by worry due to her innocent love. The friend compares her own state of mind to a double-headed child (or creature) that has consumed poison; even if only one part is affected, the entire being trembles in fear. This striking image belongs to the Neytal landscape, where the coastal elements of backwaters and crocodiles emphasize the themes of anxiety, waiting, and the fragility of life.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,1.1],[1.1,1.43],[1.43,1.6],[1.6,2.71],[2.71,3.1],[3.1,3.8],[3.8,4.3],[4.3,5.4],[5.4,5.9],[5.9,6.3],[6.3,6.6],[6.6,7.6],[7.6,7.6],[7.6,8.0],[8.0,8.08],[8.08,8.08],[8.08,8.08],[8.08,8.32],[8.32,8.4],[8.4,8.4],[8.4,10.88],[10.88,12.44],[12.44,13.4],[13.4,13.7],[13.74,13.95],[13.95,14.1]],"female":[[0.0,0.6],[0.6,1.07],[1.07,1.36],[1.36,1.6],[1.6,2.55],[2.55,2.9],[2.9,3.8],[3.8,4.4],[4.4,5.5],[5.5,6.0],[6.0,6.3],[6.4,6.5],[6.5,7.7],[7.7,7.8],[7.8,8.19],[8.19,8.58],[8.58,8.58],[8.58,9.36],[9.36,9.36],[9.36,11.3],[11.3,12.2],[12.2,12.7],[12.7,13.25],[13.25,14.3],[14.3,14.8],[14.84,15.05],[15.05,15.2]]}}