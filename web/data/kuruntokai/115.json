{"text":"kuruntokai","n":115,"lines":["பெருநன் றாற்றிற் பேணாரும் உளரே","ஒருநன் றுடையள் ஆயினும் புரிமாண்டு","புலவி தீர அளிமதி இலைகவர்","பாடமை ஒழுகிய தண்ணறுஞ் சாரல்","மென்னடை மரையா துஞ்சும்","நன்மலை நாட நின்னல திலளே"],"tr":["perunaṉ ṟāṟṟiṟ pēṇārum uḷarē","orunaṉ ṟuṭaiyaḷ āyiṉum purimāṇṭu","pulavi tīra aḷimati ilaikavar","pāṭamai oḻukiya taṇṇaṟuñ cāral","meṉṉaṭai maraiyā tuñcum","naṉmalai nāṭa niṉṉala tilaḷē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"கபிலர்","speaker_en":"her friend (tōḻi)","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 7, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பெருநன்","tr":"perunaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெரு","tr":"peru"},{"kind":"nēr","text":"நன்","tr":"naṉ"}]},{"text":"றாற்றிற்","tr":"ṟāṟṟiṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"றாற்","tr":"ṟāṟ"},{"kind":"nēr","text":"றிற்","tr":"ṟiṟ"}]},{"text":"பேணாரும்","tr":"pēṇārum","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"பே","tr":"pē"},{"kind":"nēr","text":"ணா","tr":"ṇā"},{"kind":"nēr","text":"ரும்","tr":"rum"}]},{"text":"உளரே","tr":"uḷarē","foot":"puḷimā","acai":[{"kind":"nirai","text":"உள","tr":"uḷa"},{"kind":"nēr","text":"ரே","tr":"rē"}]}],[{"text":"ஒருநன்","tr":"orunaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"ஒரு","tr":"oru"},{"kind":"nēr","text":"நன்","tr":"naṉ"}]},{"text":"றுடையள்","tr":"ṟuṭaiyaḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"றுடை","tr":"ṟuṭai"},{"kind":"nēr","text":"யள்","tr":"yaḷ"}]},{"text":"ஆயினும்","tr":"āyiṉum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nirai","text":"யினும்","tr":"yiṉum"}]},{"text":"புரிமாண்டு","tr":"purimāṇṭu","foot":"p