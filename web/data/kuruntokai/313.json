{"text":"kuruntokai","n":313,"lines":["பெருங்கடற் கரையது சிறுவெண் காக்கை","நீத்துநீர் இருங்கழி இரைதேர்ந் துண்டு","பூக்கமழ் பொதும்பிற் சேக்குந் துறைவனொடு","யாத்தேம் யாத்தன்று நட்பே","அவிழ்த்தற் கரிதது முடிந்தமைந் தன்றே"],"tr":["peruṅkaṭaṟ karaiyatu ciṟuveṇ kākkai","nīttunīr iruṅkaḻi iraitērn tuṇṭu","pūkkamaḻ potumpiṟ cēkkun tuṟaivaṉoṭu","yāttēm yāttaṉṟu naṭpē","aviḻttaṟ karitatu muṭintamain taṉṟē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","speaker_en":"the heroine (talaivi)"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 6"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பெருங்கடற்","tr":"peruṅkaṭaṟ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெருங்","tr":"peruṅ"},{"kind":"nirai","text":"கடற்","tr":"kaṭaṟ"}]},{"text":"கரையது","tr":"karaiyatu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கரை","tr":"karai"},{"kind":"nirai","text":"யது","tr":"yatu"}]},{"text":"சிறுவெண்","tr":"ciṟuveṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nēr","text":"வெண்","tr":"veṇ"}]},{"text":"காக்கை","tr":"kākkai","foot":"tēmā","acai":[{"kind":"nēr","text":"காக்","tr":"kāk"},{"kind":"nēr","text":"கை","tr":"kai"}]}],[{"text":"நீத்துநீர்","tr":"nīttunīr","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நீத்","tr":"nīt"},{"kind":"nirai","text":"துநீர்","tr":"tunīr"}]},{"text":"இருங்கழி","tr":"iruṅkaḻi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இருங்","tr":"iruṅ"},{"kind":"nirai","text":"கழி","tr":"kaḻi"}]},{"text":"இரைதேர்ந்","tr":"iraitērn","foot":"puḷimā","acai":[{"kind":"nirai","text":"இரை","tr":"irai"},{"kind":"nēr","text":"தேர்ந்","tr":"tērn"}]},{"text":"துண்டு","tr":"tuṇṭu","foot":"tēmā","acai":[{"kind":"nēr","text":"துண்","tr