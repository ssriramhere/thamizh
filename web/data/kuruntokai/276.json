{"text":"kuruntokai","n":276,"lines":["பணைத்தோட் குறுமகள் பாவை தைஇயும்","பஞ்சாய்ப் பள்ளஞ் சூழ்ந்து மற்றிவள்","உருத்தெழு வனமுலை ஒளிபெற எழுதிய","தொய்பில் காப்போர் அறிதலும் அறியார்","முறையுடை யரசன் செங்கோல் அவையத்","தியான்றற் கடவின் யாங்கா வதுகொல்","பெரிதும் பேதை மன்ற","அளிதோ னேயிவ் வழுங்கல் ஊரே"],"tr":["paṇaittōṭ kuṟumakaḷ pāvai taiiyum","pañcāyp paḷḷañ cūḻntu maṟṟivaḷ","urutteḻu vaṉamulai oḷipeṟa eḻutiya","toypil kāppōr aṟitalum aṟiyār","muṟaiyuṭai yaracaṉ ceṅkōl avaiyat","tiyāṉṟaṟ kaṭaviṉ yāṅkā vatukol","peritum pētai maṉṟa","aḷitō ṉēyiv vaḻuṅkal ūrē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"கோழிக் கொற்றனார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Kōḻik Koṟṟaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 31"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 13"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பணைத்தோட்","tr":"paṇaittōṭ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பணைத்","tr":"paṇait"},{"kind":"nēr","text":"தோட்","tr":"tōṭ"}]},{"text":"குறுமகள்","tr":"kuṟumakaḷ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குறு","tr":"kuṟu"},{"kind":"nirai","text":"மகள்","tr":"makaḷ"}]},{"text":"பாவை","tr":"pāvai","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"வை","tr":"vai"}]},{"text":"தைஇயும்","tr":"taiiyum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தை","tr":"tai"},{"kind":"nirai","text":"இயும்","tr":"iyum"}]}],[{"text":"பஞ்சாய்ப்","tr":"pañcāyp","foot":"tēmā","acai":[{"kind":"nēr","text":"பஞ்","tr":"pañ"},{"kind":"nēr","text":"சாய்ப்","tr":"cāyp"}]},{"text":"பள்ளஞ்","tr":"paḷḷañ","foot":"tēmā","acai":[{"kind":"nēr","text":"பள்","tr":"paḷ"},{"kind":"nēr","text":"ளஞ்","tr":"ḷañ"}]},{"text":"சூழ்ந்து","tr":"cūḻntu","foot":"tēmā","acai":[{"kind"