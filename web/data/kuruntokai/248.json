{"text":"kuruntokai","n":248,"lines":["அதுவர லன்மையோ அரிதே அவன்மார்","புறுக வென்ற நாளே குறுகி","ஈங்கா கின்றே தோழி கானல்","ஆடரை புதையக் கோடை யிட்ட","அடும்பிவர் மணற்கோ டூர நெடும்பனைக்","குறிய வாகுந் துறைவனைப்","பெரிய கூறி யாயறிந் தனளே"],"tr":["atuvara laṉmaiyō aritē avaṉmār","puṟuka veṉṟa nāḷē kuṟuki","īṅkā kiṉṟē tōḻi kāṉal","āṭarai putaiyak kōṭai yiṭṭa","aṭumpivar maṇaṟkō ṭūra neṭumpaṉaik","kuṟiya vākun tuṟaivaṉaip","periya kūṟi yāyaṟin taṉaḷē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தோழி கூற்று","poet_ta":"உலோச்சனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Ulōccaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 7, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அதுவர","tr":"atuvara","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அது","tr":"atu"},{"kind":"nirai","text":"வர","tr":"vara"}]},{"text":"லன்மையோ","tr":"laṉmaiyō","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"லன்","tr":"laṉ"},{"kind":"nēr","text":"மை","tr":"mai"},{"kind":"nēr","text":"யோ","tr":"yō"}]},{"text":"அரிதே","tr":"aritē","foot":"puḷimā","acai":[{"kind":"nirai","text":"அரி","tr":"ari"},{"kind":"nēr","text":"தே","tr":"tē"}]},{"text":"அவன்மார்","tr":"avaṉmār","foot":"puḷimā","acai":[{"kind":"nirai","text":"அவன்","tr":"avaṉ"},{"kind":"nēr","text":"மார்","tr":"mār"}]}],[{"text":"புறுக","tr":"puṟuka","foot":"puḷimā","acai":[{"kind":"nirai","text":"புறு","tr":"puṟu"},{"kind":"nēr","text":"க","tr":"ka"}]},{"text":"வென்ற","tr":"veṉṟa","foot":"tēmā","acai":[{"kind":"nēr","text":"வென்","tr":"veṉ"},{"kind":"nēr","text":"ற","tr":"ṟa"}]},{"text":"நாளே","tr":"nāḷē","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"ளே","tr":"ḷē"}]},{"text":"குறுகி","tr":"kuṟu