{"text":"kuruntokai","n":250,"lines":["பரலவல் படுநீர் மாந்தித் துணையோ","டிரலை நன்மா னெறிமுத லுகளும்","மாலை வாரா வளவைக் காலியற்","கடுமாக் கடவுமதி பாக நெடுநீர்ப்","பொருகயன் முரணிய உண்கண்","தெரிதீங் கிளவி தெருமர லுயவே"],"tr":["paralaval paṭunīr māntit tuṇaiyō","ṭiralai naṉmā ṉeṟimuta lukaḷum","mālai vārā vaḷavaik kāliyaṟ","kaṭumāk kaṭavumati pāka neṭunīrp","porukayaṉ muraṇiya uṇkaṇ","teritīṅ kiḷavi terumara luyavē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவன் கூற்று","poet_ta":"நாமலார் மகனார் இளங்கண்ணனார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Nāmalār Makaṉār Iḷaṅkaṇṇaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 12, āciriyattaḷai 10"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பரலவல்","tr":"paralaval","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பர","tr":"para"},{"kind":"nirai","text":"லவல்","tr":"laval"}]},{"text":"படுநீர்","tr":"paṭunīr","foot":"puḷimā","acai":[{"kind":"nirai","text":"படு","tr":"paṭu"},{"kind":"nēr","text":"நீர்","tr":"nīr"}]},{"text":"மாந்தித்","tr":"māntit","foot":"tēmā","acai":[{"kind":"nēr","text":"மாந்","tr":"mān"},{"kind":"nēr","text":"தித்","tr":"tit"}]},{"text":"துணையோ","tr":"tuṇaiyō","foot":"puḷimā","acai":[{"kind":"nirai","text":"துணை","tr":"tuṇai"},{"kind":"nēr","text":"யோ","tr":"yō"}]}],[{"text":"டிரலை","tr":"ṭiralai","foot":"puḷimā","acai":[{"kind":"nirai","text":"டிர","tr":"ṭira"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"நன்மா","tr":"naṉmā","foot":"tēmā","acai":[{"kind":"nēr","text":"நன்","tr":"naṉ"},{"kind":"nēr","text":"மா","tr":"mā"}]},{"text":"னெறிமுத","tr":"ṉeṟimuta","foot":"karuviḷam","acai":[{"kind":"nirai","text":"னெறி","tr":"ṉeṟi"},{"kind":"nirai","text":"முத","tr":"muta"}]},{"text":"லுகளும்","tr":"lukaḷum","foot":