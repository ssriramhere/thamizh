{"kind":"nēr","text":"றோய்","tr":"ṟōy"}]},{"text":"வற்றே","tr":"vaṟṟē","foot":"tēmā","acai":[{"kind":"nēr","text":"வற்","tr":"vaṟ"},{"kind":"nēr","text":"றே","tr":"ṟē"}]},{"text":"காமம்","tr":"kāmam","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"மம்","tr":"mam"}]}],[{"text":"சான்றோர்","tr":"cāṉṟōr","foot":"tēmā","acai":[{"kind":"nēr","text":"சான்","tr":"cāṉ"},{"kind":"nēr","text":"றோர்","tr":"ṟōr"}]},{"text":"அல்லர்யாம்","tr":"allaryām","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"அல்","tr":"al"},{"kind":"nēr","text":"லர்","tr":"lar"},{"kind":"nēr","text":"யாம்","tr":"yām"}]},{"text":"மரீஇ","tr":"marīi","foot":"puḷimā","acai":[{"kind":"nirai","text":"மரீ","tr":"marī"},{"kind":"nēr","text":"இ","tr":"i"}]},{"text":"யோரே","tr":"yōrē","foot":"tēmā","acai":[{"kind":"nēr","text":"யோ","tr":"yō"},{"kind":"nēr","text":"ரே","tr":"rē"}]}]]},"ai":{"lines":[{"words":[{"surface":"உள்ளின்","parts":[{"text":"உள்","lemma":"உள்ளு","gloss":"think"},{"text":"இன்","lemma":"இன்","gloss":"if"}],"gloss":"if [I] think"},{"surface":"உள்ளம்","parts":[{"text":"உள்ளம்","lemma":"உள்ளம்","gloss":"heart"}],"gloss":"heart"},{"surface":"வேமே","parts":[{"text":"வே","lemma":"வே","gloss":"burn"},{"text":"ம்","lemma":"உம்","gloss":"will"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"will indeed burn"},{"surface":"உள்ளா","parts":[{"text":"உள்","lemma":"உள்ளு","gloss":"think"},{"text":"ஆ","lemma":"ஆ","gloss":"without"}],"gloss":"without thinking"}]},{"words":[{"surface":"திருப்பின்","parts":[{"text":"திருப்பு","lemma":"திருப்பு","gloss":"turn back"},{"text":"இன்","lemma":"இன்","gloss":"if"}],"gloss":"if [I] turn back"},{"surface":"எம்","parts":[{"text":"எம்","lemma":"யாம்","gloss":"my"}],"gloss":"my"},{"surface":"அளவைத்து","parts":[{"text":"அளவை","lemma":"அளவை","gloss":"measure"},{"text":"து","lemma":"து","gloss":"it"}],"gloss":"of the measure"},{"surface":"அன்றே","parts":[{"text":"அன்றே","lemma":"அன்றே","gloss":"is it not indeed"}],"gloss":"is it not indeed","split_unverified":true},{"surface":"வருத்தி","parts":[{"text":"வருத்து","lemma":"வருத்து","gloss":"cause pain"},{"text":"இ","lemma":"இ","gloss":"having"}],"gloss":"causing pain"}]},{"words":[{"surface":"வான்றோய்","parts":[{"text":"வான்","lemma":"வான்","gloss":"sky"},{"text":"தோய்","lemma":"தோய்","gloss":"touch"}],"gloss":"sky-touching"},{"surface":"வற்றே","parts":[{"text":"வற்று","lemma":"வற்று","gloss":"like"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"is of the nature indeed"},{"surface":"காமம்","parts":[{"text":"காமம்","lemma":"காமம்","gloss":"love"}],"gloss":"love"}]},{"words":[{"surface":"சான்றோர்","parts":[{"text":"சான்றோர்","lemma":"சான்றோர்","gloss":"noble person"}],"gloss":"noble person","split_unverified":true},{"surface":"அல்லர்","parts":[{"text":"அல்","lemma":"அல்","gloss":"not"},{"text":"அர்","lemma":"அர்","gloss":"honorific plural suffix"}],"gloss":"is not"},{"surface":"யாம்","parts":[{"text":"யாம்","lemma":"யாம்","gloss":"I"}],"gloss":"I"},{"surface":"மரீஇயோரே","parts":[{"text":"மரீஇ","lemma":"மருவு","gloss":"having associated"},{"text":"ஓர்","lemma":"ஓர்","gloss":"person"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"the one whom I associated with indeed"}]}],"literal":"If [I] think, [my] heart will indeed burn; without thinking, / if [I] try to turn [it] back, is it not indeed beyond my measure, causing pain? / Sky-touching is of the nature indeed, [my] love; / a noble person is not, the one whom I associated with indeed.","translation":"If I think of him, my heart burns. If, to stop thinking, I try to turn my mind back, it is beyond my strength and only causes pain. My love is as vast as the sky that touches the heavens. But he whom I embraced is not a noble man.","modern":"நினைத்துப் பார்த்தால் என் நெஞ்சம் வேகின்றது. நினைக்காமல் இருக்க என் மனதைத் திருப்ப முயன்றால், அது என் சக்திக்கு அப்பாற்பட்டதாகி என்னை வருத்துகிறது. என் காதல் வானத்தைத் தொடும் அளவுக்குப் பெரியது. ஆனால், நான் நெருங்கிப் பழகிய அவரோ சான்றோர் அல்லர்.","explanation":"This poem is spoken by the heroine to her confidante in the Neytal (seashore) landscape, expressing her deep grief over her lover's prolonged absence. She describes the agonizing nature of her love: thinking of him burns her heart, yet trying to divert her mind is an impossible task that only brings more pain. She compares her love to the vast sky, highlighting its immense scale. However, she laments that the man she loved and trusted has proven to be ignoble because he has abandoned her to suffer. The contrast between her sky-high love and his lack of virtue intensifies the emotional pain of her separation.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.35],[0.35,0.7],[0.7,1.1],[1.1,1.8],[1.8,2.4],[2.4,2.8],[2.8,3.1],[3.1,3.3],[3.3,4.21],[4.21,4.9],[4.9,5.5],[5.5,6.15],[6.15,7.12],[7.12,7.6],[7.6,7.9]],"female":[[0.0,0.4],[0.4,0.8],[0.8,1.0],[1.0,1.6],[1.68,2.5],[2.5,3.0],[3.0,3.3],[3.3,3.5],[3.5,4.24],[4.24,4.8],[4.8,5.4],[5.4,5.88],[5.88,6.61],[6.61,6.97],[6.97,7.2]]},"sync":[[["உள்ளின்","if [I] think"]],[["உள்ளம்","heart"]],[["வேமே","will indeed burn"]],[["உள்ளா","without thinking"]],[["திருப்பின்","if [I] turn back"],["எம்","my"]],[["அளவைத்து","of the measure"]],[["அளவைத்து","of the measure"],["அன்றே","is it not indeed"]],[["வருத்தி","causing pain"]],[["வான்றோய்","sky-touching"]],[["வற்றே","is of the nature indeed"]],[["காமம்","love"]],[["சான்றோர்","noble person"]],[["அல்லர்","is not"],["யாம்","I"]],[["மரீஇயோரே","the one whom I associated with indeed"]],[["மரீஇயோரே","the one whom I associated with indeed"]]]}