{"text":"kuruntokai","n":148,"lines":["செல்வச் சிறாஅர் சீறடிப் பொலிந்த","தவளை வாய பொலஞ்செய் கிண்கிணிக்","காசி னன்ன போதீன் கொன்றை","குருந்தோ டலம்வரும் பெருந்தண் காலையும்","காரன் றென்றி யாயிற்","கனவோ மற்றிது வினவுவல் யானே"],"tr":["celvac ciṟāar cīṟaṭip polinta","tavaḷai vāya polañcey kiṇkiṇik","kāci ṉaṉṉa pōtīṉ koṉṟai","kuruntō ṭalamvarum peruntaṇ kālaiyum","kāraṉ ṟeṉṟi yāyiṟ","kaṉavō maṟṟitu viṉavuval yāṉē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"இளங் கீரந்தையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Iḷaṅ Kīrantaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 9"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"செல்வச்","tr":"celvac","foot":"tēmā","acai":[{"kind":"nēr","text":"செல்","tr":"cel"},{"kind":"nēr","text":"வச்","tr":"vac"}]},{"text":"சிறாஅர்","tr":"ciṟāar","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிறா","tr":"ciṟā"},{"kind":"nēr","text":"அர்","tr":"ar"}]},{"text":"சீறடிப்","tr":"cīṟaṭip","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சீ","tr":"cī"},{"kind":"nirai","text":"றடிப்","tr":"ṟaṭip"}]},{"text":"பொலிந்த","tr":"polinta","foot":"puḷimā","acai":[{"kind":"nirai","text":"பொலிந்","tr":"polin"},{"kind":"nēr","text":"த","tr":"ta"}]}],[{"text":"தவளை","tr":"tavaḷai","foot":"puḷimā","acai":[{"kind":"nirai","text":"தவ","tr":"tava"},{"kind":"nēr","text":"ளை","tr":"ḷai"}]},{"text":"வாய","tr":"vāya","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"பொலஞ்செய்","tr":"polañcey","foot":"puḷimā","acai":[{"kind":"nirai","text":"பொலஞ்","tr":"polañ"},{"kind":"nēr","text":"செய்","tr":"cey"}]},{"text":"கிண்கிணிக்","tr":"kiṇkiṇik","foot":"kūviḷam","acai":[{"kind":"nēr","text":