{"text":"kuruntokai","n":385,"lines":["பலவிற் சேர்ந்த பழமார் இனக்கலை","சிலைவிற் கானவன் செந்தொடை வெரீஇச்","செருவுறு குதிரையிற் பொங்கிச் சாரல்","இருவெதிர் நீடமை தயங்கப் பாயும்","பெருவரை அடுக்கத்துக் கிழவோன் என்றும்","அன்றை யன்ன நட்பினன்","புதுவோர்த் தம்மவிவ் வழுங்க லூரே"],"tr":["palaviṟ cērnta paḻamār iṉakkalai","cilaiviṟ kāṉavaṉ centoṭai verīic","ceruvuṟu kutiraiyiṟ poṅkic cāral","iruvetir nīṭamai tayaṅkap pāyum","peruvarai aṭukkattuk kiḻavōṉ eṉṟum","aṉṟai yaṉṉa naṭpiṉaṉ","putuvōrt tammaviv vaḻuṅka lūrē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"கபிலர்","speaker_en":"the heroine (talaivi)","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 8, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பலவிற்","tr":"palaviṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பல","tr":"pala"},{"kind":"nēr","text":"விற்","tr":"viṟ"}]},{"text":"சேர்ந்த","tr":"cērnta","foot":"tēmā","acai":[{"kind":"nēr","text":"சேர்ந்","tr":"cērn"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"பழமார்","tr":"paḻamār","foot":"puḷimā","acai":[{"kind":"nirai","text":"பழ","tr":"paḻa"},{"kind":"nēr","text":"மார்","tr":"mār"}]},{"text":"இனக்கலை","tr":"iṉakkalai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இனக்","tr":"iṉak"},{"kind":"nirai","text":"கலை","tr":"kalai"}]}],[{"text":"சிலைவிற்","tr":"cilaiviṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிலை","tr":"cilai"},{"kind":"nēr","text":"விற்","tr":"viṟ"}]},{"text":"கானவன்","tr":"kāṉavaṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"னவன்","tr":"ṉavaṉ"}]},{"text":"செந்தொடை","tr":"centoṭai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"செந்","tr":"cen"},