lit_unverified":true},{"surface":"வெரீஇ","parts":[{"text":"வெரீஇ","lemma":"வெரீஇ","gloss":"having feared"}],"gloss":"having feared","split_unverified":true}]},{"words":[{"surface":"செருவுறு","parts":[{"text":"செரு","lemma":"ceru","gloss":"battle"},{"text":"உறு","lemma":"uṟu","gloss":"engage"}],"gloss":"battle-engaged"},{"surface":"குதிரையின்","parts":[{"text":"குதிரை","lemma":"kutirai","gloss":"horse"},{"text":"இன்","lemma":"iṉ","gloss":"like"}],"gloss":"like a horse"},{"surface":"பொங்கி","parts":[{"text":"பொங்கு","lemma":"poṅku","gloss":"leap"},{"text":"இ","lemma":"i","gloss":"having"}],"gloss":"leaping"},{"surface":"சாரல்","parts":[{"text":"சாரல்","lemma":"cāral","gloss":"mountain slope"}],"gloss":"mountain slope"}]},{"words":[{"surface":"இருவெதிர்","parts":[{"text":"இரு","lemma":"iru","gloss":"big"},{"text":"வெதிர்","lemma":"vetir","gloss":"bamboo"}],"gloss":"big bamboo"},{"surface":"நீடமை","parts":[{"text":"நீடு","lemma":"nīṭu","gloss":"grow long"},{"text":"அமை","lemma":"amai","gloss":"bamboo"}],"gloss":"tall bamboo"},{"surface":"தயங்க","parts":[{"text":"தயங்கு","lemma":"tayaṅku","gloss":"sway"},{"text":"அ","lemma":"a","gloss":"to"}],"gloss":"to sway"},{"surface":"பாயும்","parts":[{"text":"பாய்","lemma":"pāy","gloss":"leap"},{"text":"உம்","lemma":"um","gloss":"that"}],"gloss":"that leaps"}]},{"words":[{"surface":"பெருவரை","parts":[{"text":"பெரு","lemma":"peru","gloss":"big"},{"text":"வரை","lemma":"varai","gloss":"mountain"}],"gloss":"great mountain"},{"surface":"அடுக்கத்து","parts":[{"text":"அடுக்கத்து","lemma":"அடுக்கத்து","gloss":"of the mountain range"}],"gloss":"of the mountain range","split_unverified":true},{"surface":"கிழவோன்","parts":[{"text":"கிழவோன்","lemma":"kiḻavōṉ","gloss":"lord"}],"gloss":"the lord"},{"surface":"என்றும்","parts":[{"text":"என்று","lemma":"eṉṟu","gloss":"always"},{"text":"உம்","lemma":"um","gloss":"even"}],"gloss":"always"}]},{"words":[{"surface":"அன்றை","parts":[{"text":"அன்று","lemma":"aṉṟu","gloss":"that day"},{"text":"ஐ","lemma":"ai","gloss":"of"}],"gloss":"of that first day"},{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"aṉṉa","gloss":"like"}],"gloss":"like"},{"surface":"நட்பினன்","parts":[{"text":"நட்பு","lemma":"naṭpu","gloss":"friendship"},{"text":"இன்","lemma":"iṉ","gloss":"of"},{"text":"அன்","lemma":"aṉ","gloss":"he"}],"gloss":"he who has friendship"}]},{"words":[{"surface":"புதுவோர்","parts":[{"text":"புதுவோர்","lemma":"புதுவோர்","gloss":"strangers"}],"gloss":"strangers","split_unverified":true},{"surface":"தம்ம","parts":[{"text":"தம்ம","lemma":"tamma","gloss":"alas"}],"gloss":"alas"},{"surface":"இவ்","parts":[{"text":"இவ்","lemma":"இவ்","gloss":"this"}],"gloss":"this","split_unverified":true},{"surface":"அழுங்கல்","parts":[{"text":"அழுங்கல்","lemma":"aḻuṅkal","gloss":"noisy"}],"gloss":"noisy"},{"surface":"ஊரே","parts":[{"text":"ஊர்","lemma":"ūr","gloss":"town"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"the town indeed"}]}],"literal":"At the jackfruit tree, staying, eating fruit, the male monkey of the herd, / fearing the straight-aimed arrow of the hunter with a strung bow, / leaping like a battle-engaged horse on the mountain slope, / so that the big bamboo and tall bamboo sway, leaps— / the lord of the great mountain range, always, / is of a friendship like that of the first day; / but this noisy town treats us as strangers, alas!","translation":"The male monkey of the herd, eating ripe fruit on the jackfruit tree, fears the straight-aimed arrow of the hunter with his strung bow, and leaps like a battle-charged horse on the mountain slope, making the tall, dark bamboos sway. The lord of these great mountain ranges is always of the same constant love as on the very first day. Yet, alas, this noisy town treats us as if we were strangers!","modern":"பலா மரத்தில் தங்கிப் பழங்களை உண்ணும் கூட்டத்து ஆண் குரங்கு, வில்லேந்திய வேடனின் நேர்மையான அம்புக்கு அஞ்சி, போர்க்களத்துக் குதிரையைப் போலப் பாய்ந்து, மலைச்சரிவில் உள்ள பெரிய மூங்கில்களும் நீண்ட மூங்கில்களும் அசையும்படித் தாவும். அத்தகைய பெரிய மலைநாட்டின் தலைவன், அன்று முதல் இன்று வரை மாறாத அன்பு உடையவனாகவே இருக்கிறான். ஆனால், இந்த ஆரவாரமிக்க ஊர் மக்கள் எங்களை ஏதோ புதியவர்களைப் போலப் பார்க்கிறார்களே!","explanation":"The heroine speaks to her confidante about the constancy of the hero's love and the painful gossip of the town. She describes how the male monkey leaps in fear of the hunter's arrow, shaking the tall bamboos on the mountain slopes. This vivid image of the mountain landscape (kuriñci) reflects the sudden disruption and anxiety caused by the town's rumors. While the hero's affection remains as fresh and true as it was on the very first day, the noisy townspeople treat them with suspicion and hostility. The key contrast lies between the enduring, natural love of the mountain lord and the superficial, clamorous gossip of the village.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,1.0],[1.0,1.26],[1.26,1.9],[1.9,2.5],[2.5,2.9],[2.9,3.5],[3.5,4.57],[4.57,5.0],[5.0,5.5],[5.5,5.86],[5.86,6.1],[7.26,7.79],[7.79,8.12],[8.12,8.65],[8.65,8.97],[8.97,9.29],[9.29,9.86],[9.86,10.18],[10.18,10.5],[10.5,11.17],[11.17,11.3],[11.3,12.1],[12.1,12.9],[12.9,13.2],[13.2,13.65],[13.65,14.1]],"female":[[0.0,0.38],[0.5,0.9],[0.9,1.16],[1.16,1.61],[1.61,1.96],[1.96,2.32],[2.32,2.68],[2.68,3.04],[3.04,3.4],[3.4,3.84],[3.84,4.2],[4.2,4.33],[4.84,6.13],[6.13,6.91],[6.91,7.56],[7.56,9.2],[9.2,9.68],[9.68,10.52],[10.52,11.0],[11.0,11.4],[11.4,12.2],[12.53,12.9],[12.9,13.4],[13.4,13.89],[13.89,14.38],[14.38,14.51],[14.97,15.7]]},"sync":[[["பலவில்","at the jackfruit tree"]],[["சேர்ந்த","that stayed"]],[["பழமார்","eating fruit"]],[["இனக்கலை","the male monkey of the herd"]],[["சிலைவில்","strung bow"]],[["கானவன்","hunter"]],[["செந்தொடை","straight-aimed arrow"]],[["வெரீஇ","having feared"]],[["செருவுறு","battle-engaged"]],[["குதிரையின்","like a horse"]],[["பொங்கி","leaping"],["சாரல்","mountain slope"]],[["சாரல்","mountain slope"]],[["இருவெதிர்","big bamboo"]],[["நீடமை","tall bamboo"]],[["தயங்க","to sway"],["பாயும்","that leaps"]],[["பாயும்","that leaps"]],[["பெருவரை","great mountain"]],[["அடுக்கத்து","of the mountain range"],["கிழவோன்","the lord"]],[["கிழவோன்","the lord"]],[["என்றும்","always"]],[["அன்றை","of that first day"]],[["அன்ன","like"]],[["நட்பினன்","he who has friendship"]],[["புதுவோர்","strangers"],["தம்ம","alas"]],[["தம்ம","alas"],["இவ்","this"]],[["அழுங்கல்","noisy"]],[["அழுங்கல்","noisy"],["ஊரே","the town indeed"]]]}