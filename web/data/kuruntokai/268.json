{"text":"kuruntokai","n":268,"lines":["சேறிரோ எனச் செப்பலு மாற்றாம்","வருவி ரோஎன வினவலும் வினவாம்","யாங்குச் செய்வாங்கொல் தோழிபாம்பின்","பையுடை இருந்தலை துமிக்கும் ஏற்றொடு","நடுநாள் என்னார் வந்து","நெடுமென் பணைத்தோள் அடைந்திசி னோரே"],"tr":["cēṟirō eṉac ceppalu māṟṟām","varuvi rōeṉa viṉavalum viṉavām","yāṅkuc ceyvāṅkol tōḻipāmpiṉ","paiyuṭai iruntalai tumikkum ēṟṟoṭu","naṭunāḷ eṉṉār vantu","neṭumeṉ paṇaittōḷ aṭaintici ṉōrē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"கருவூர்ச் சேரமான் சாத்தனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Karuvūrc Cēramāṉ Cāttaṉār"},"scan":{"meter":"iṇaikkuṟaḷ āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 2×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19, veṇcīr 2, other 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 8, ? 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"சேறிரோ","tr":"cēṟirō","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சே","tr":"cē"},{"kind":"nirai","text":"றிரோ","tr":"ṟirō"}]},{"text":"எனச்","tr":"eṉac","foot":"malar","acai":[{"kind":"nirai","text":"எனச்","tr":"eṉac"}]},{"text":"செப்பலு","tr":"ceppalu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"செப்","tr":"cep"},{"kind":"nirai","text":"பலு","tr":"palu"}]},{"text":"மாற்றாம்","tr":"māṟṟām","foot":"tēmā","acai":[{"kind":"nēr","text":"மாற்","tr":"māṟ"},{"kind":"nēr","text":"றாம்","tr":"ṟām"}]}],[{"text":"வருவி","tr":"varuvi","foot":"puḷimā","acai":[{"kind":"nirai","text":"வரு","tr":"varu"},{"kind":"nēr","text":"வி","tr":"vi"}]},{"text":"ரோஎன","tr":"rōeṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ரோ","tr":"rō"},{"kind":"nirai","text":"என","tr":"eṉa"}]},{"text":"வினவலும்","tr":"viṉavalum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வின","tr":"viṉa"},{"kind":"nirai","text":"வலும்","tr":"valum"}]},{"text":"வினவாம்","tr":"viṉavām","foot":"puḷimā","acai":[{"kind