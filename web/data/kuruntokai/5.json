{"text":"kuruntokai","n":5,"lines":["அதுகொல் தோழி காம நோயே","வதிகுரு குறங்கும் இன்னிழற் புன்னை","உடைதிரைத் திவலை அரும்புந் தீநீர்","மெல்லம் புலம்பன் பிரிந்தெனப்","பல்லிதழ் உண்கண் பாடொல் லாவே"],"tr":["atukol tōḻi kāma nōyē","vatikuru kuṟaṅkum iṉṉiḻaṟ puṉṉai","uṭaitirait tivalai arumpun tīnīr","mellam pulampaṉ pirinteṉap","pallitaḻ uṇkaṇ pāṭol lāvē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"நரிவெரூ உத்தலையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Nariverū Uttalaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அதுகொல்","tr":"atukol","foot":"puḷimā","acai":[{"kind":"nirai","text":"அது","tr":"atu"},{"kind":"nēr","text":"கொல்","tr":"kol"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"காம","tr":"kāma","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"ம","tr":"ma"}]},{"text":"நோயே","tr":"nōyē","foot":"tēmā","acai":[{"kind":"nēr","text":"நோ","tr":"nō"},{"kind":"nēr","text":"யே","tr":"yē"}]}],[{"text":"வதிகுரு","tr":"vatikuru","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வதி","tr":"vati"},{"kind":"nirai","text":"குரு","tr":"kuru"}]},{"text":"குறங்கும்","tr":"kuṟaṅkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"குறங்","tr":"kuṟaṅ"},{"kind":"nēr","text":"கும்","tr":"kum"}]},{"text":"இன்னிழற்","tr":"iṉṉiḻaṟ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"இன்","tr":"iṉ"},{"kind":"nirai","text":"னிழற்","tr":"ṉiḻaṟ"}]},{"text":"புன்னை","tr":"puṉṉai","foot":"tēmā","acai":[{"kind":"nēr","text":"புன்","tr":"puṉ"},{"kind":"nēr","text":"னை","tr":"ṉai"}]}],[{"text":"உடைதிரைத்","tr