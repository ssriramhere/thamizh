t":"நோய்","lemma":"நோய்","gloss":"affliction"},{"text":"ஏ","lemma":"ஏ","gloss":"emphatic particle"}],"gloss":"the affliction indeed"}]},{"words":[{"surface":"வதி","parts":[{"text":"வதி","lemma":"வதி","gloss":"stay"}],"gloss":"staying"},{"surface":"குருகு","parts":[{"text":"குருகு","lemma":"குருகு","gloss":"bird"}],"gloss":"bird"},{"surface":"உறங்கும்","parts":[{"text":"உறங்கும்","lemma":"உறங்கு","gloss":"sleeping"}],"gloss":"sleeping"},{"surface":"இன்","parts":[{"text":"இன்","lemma":"இனிமை","gloss":"sweetness"}],"gloss":"sweet"},{"surface":"நிழல்","parts":[{"text":"நிழல்","lemma":"நிழல்","gloss":"shade"}],"gloss":"shade"},{"surface":"புன்னை","parts":[{"text":"புன்னை","lemma":"புன்னை","gloss":"mastwood tree"}],"gloss":"mastwood tree"}]},{"words":[{"surface":"உடை","parts":[{"text":"உடை","lemma":"உடை","gloss":"break"}],"gloss":"breaking"},{"surface":"திரை","parts":[{"text":"திரை","lemma":"திரை","gloss":"wave"}],"gloss":"wave"},{"surface":"திவலை","parts":[{"text":"திவலை","lemma":"திவலை","gloss":"droplet"}],"gloss":"droplets"},{"surface":"அரும்பும்","parts":[{"text":"அரும்பும்","lemma":"அரும்பு","gloss":"bud/appear"}],"gloss":"appearing"},{"surface":"தீ","parts":[{"text":"தீ","lemma":"தீ","gloss":"sweet/cool"}],"gloss":"sweet"},{"surface":"நீர்","parts":[{"text":"நீர்","lemma":"நீர்","gloss":"water"}],"gloss":"water"}]},{"words":[{"surface":"மெல்","parts":[{"text":"மெல்","lemma":"மென்மை","gloss":"softness"}],"gloss":"soft"},{"surface":"அம்","parts":[{"text":"அம்","lemma":"அம்","gloss":"beauty"}],"gloss":"beautiful"},{"surface":"புலம்பன்","parts":[{"text":"புலம்பன்","lemma":"புலம்பன்","gloss":"lord of the shore"}],"gloss":"lord of the shore"},{"surface":"பிரிந்தென","parts":[{"text":"பிரிந்து","lemma":"பிரி","gloss":"separate"},{"text":"என","lemma":"என","gloss":"because"}],"gloss":"because [he] separated"}]},{"words":[{"surface":"பல்","parts":[{"text":"பல்","lemma":"பல","gloss":"many"}],"gloss":"many"},{"surface":"இதழ்","parts":[{"text":"இதழ்","lemma":"இதழ்","gloss":"petal/eyelid"}],"gloss":"petal-like (eyelids)"},{"surface":"உண்கண்","parts":[{"text":"உண்","lemma":"உண்","gloss":"be painted with collyrium"},{"text":"கண்","lemma":"கண்","gloss":"eye"}],"gloss":"collyrium-painted eyes"},{"surface":"பாடு","parts":[{"text":"பாடு","lemma":"பாடு","gloss":"closing/sleep"}],"gloss":"closing"},{"surface":"ஒல்லாவே","parts":[{"text":"ஒல்லா","lemma":"ஒல்","gloss":"agree/be possible"},{"text":"ஏ","lemma":"ஏ","gloss":"emphatic particle"}],"gloss":"do not agree indeed"}]}],"literal":"Is that indeed, O friend, the disease of love? / In the sweet shade of the mastwood tree where the staying bird sleeps, / where the spray of breaking waves buds like sweet water, / because the lord of the soft, beautiful shore separated, / the collyrium-painted eyes with many petals do not agree to close.","translation":"Is this indeed the affliction of love, my friend? Because the lord of the soft, beautiful shore has departed—where birds roost and sleep in the sweet shade of the mastwood tree, sprinkled by the cool water droplets from breaking waves—my collyrium-painted eyes, like many-petaled flowers, refuse to close in sleep.","modern":"தோழி! காம நோய் என்பது இதுதானோ? தங்கும் பறவைகள் உறங்குகின்ற இனிய நிழலையுடைய புன்னை மரத்தில், கரையில் உடையும் அலைகளின் நீர்த்துளிகள் குளிர்ந்த நீர் போல அரும்பித் தெளிக்கும் மென்மையான அழகிய கடற்கரைத் தலைவன் நம்மைப் பிரிந்து சென்றதால், பல இதழ்களைக் கொண்ட மலர் போன்ற மை தீட்டிய என் கண்கள் உறங்குவதற்கு உடன்படவில்லை.","explanation":"The speaker is the heroine addressing her close friend. She is suffering from the pain of separation after the hero, the lord of the maritime tract, has departed. She wonders if this intense sleeplessness is what people call the 'affliction of love'. The poem is set in the Neithal (maritime) landscape, where the imagery of the roosting bird sleeping peacefully in the shade of the mastwood tree contrasts with the heroine's own restless, sleepless state. The cool spray of the breaking waves on the shore represents the sensory richness of the hero's land, making his absence even harder to bear. Her eyes, compared to many-petaled flowers, refuse to close, highlighting her deep longing and sorrow.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.47],[0.47,0.7],[0.7,1.1],[1.1,1.4],[1.93,3.0],[3.0,3.46],[3.51,3.74],[3.8,4.1],[4.1,5.16],[5.16,5.8],[5.8,6.0],[6.0,6.6],[6.6,8.1],[8.1,8.5],[8.5,9.0],[9.0,9.78],[9.78,10.4],[10.4,10.93],[11.2,11.4]],"female":[[0.0,0.53],[0.53,0.8],[0.8,1.1],[1.1,1.5],[1.62,2.73],[2.73,3.77],[3.84,4.13],[4.28,4.6],[4.6,5.85],[5.85,6.6],[6.6,6.8],[6.8,7.6],[7.6,9.1],[9.1,9.5],[9.5,10.1],[10.1,11.3],[11.3,11.6],[11.6,12.12],[12.3,12.7]]},"sync":[[["அது","that"],["கொல்","is it?"]],[["தோழி","O friend"]],[["காம","of love"]],[["நோயே","the affliction indeed"]],[["வதி","staying"],["குருகு","bird"]],[["குருகு","bird"],["உறங்கும்","sleeping"]],[["இன்","sweet"],["நிழல்","shade"]],[["புன்னை","mastwood tree"]],[["உடை","breaking"],["திரை","wave"]],[["திவலை","droplets"]],[["அரும்பும்","appearing"]],[["தீ","sweet"],["நீர்","water"]],[["மெல்","soft"],["அம்","beautiful"]],[["புலம்பன்","lord of the shore"]],[["பிரிந்தென","because [he] separated"]],[["பல்","many"],["இதழ்","petal-like (eyelids)"]],[["உண்கண்","collyrium-painted eyes"]],[["பாடு","closing"],["ஒல்லாவே","do not agree indeed"]],[["ஒல்லாவே","do not agree indeed"]]]}