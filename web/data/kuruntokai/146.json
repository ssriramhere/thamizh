{"text":"kuruntokai","n":146,"lines":["அம்ம வாழி தோழி நம்மூர்ப்","பிரிந்தோர்ப் புணர்ப்போர் இருந்தனர் கொல்லோ","தண்டுடைக் கையர் வெண்டலைச் சிதவலர்","நன்றுநன் றென்னு மாக்களோ","டின்றுபெரி தென்னும் ஆங்கண தவையே"],"tr":["amma vāḻi tōḻi nammūrp","pirintōrp puṇarppōr iruntaṉar kollō","taṇṭuṭaik kaiyar veṇṭalaic citavalar","naṉṟunaṉ ṟeṉṉu mākkaḷō","ṭiṉṟuperi teṉṉum āṅkaṇa tavaiyē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"வெள்ளி வீதியார்","speaker_en":"her friend (tōḻi)","poet_tr":"Veḷḷi Vītiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 9, veṇṭaḷai 9"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அம்ம","tr":"amma","foot":"tēmā","acai":[{"kind":"nēr","text":"அம்","tr":"am"},{"kind":"nēr","text":"ம","tr":"ma"}]},{"text":"வாழி","tr":"vāḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"நம்மூர்ப்","tr":"nammūrp","foot":"tēmā","acai":[{"kind":"nēr","text":"நம்","tr":"nam"},{"kind":"nēr","text":"மூர்ப்","tr":"mūrp"}]}],[{"text":"பிரிந்தோர்ப்","tr":"pirintōrp","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிரிந்","tr":"pirin"},{"kind":"nēr","text":"தோர்ப்","tr":"tōrp"}]},{"text":"புணர்ப்போர்","tr":"puṇarppōr","foot":"puḷimā","acai":[{"kind":"nirai","text":"புணர்ப்","tr":"puṇarp"},{"kind":"nēr","text":"போர்","tr":"pōr"}]},{"text":"இருந்தனர்","tr":"iruntaṉar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இருந்","tr":"irun"},{"kind":"nirai","text":"தனர்","tr":"taṉar"}]},{"text":"கொல்லோ","tr":"kollō","foot":"tēmā","acai":[{"kind":"nēr","text":"கொல்","tr":"kol"},{"kind":"nēr","text