{"text":"kuruntokai","n":240,"lines":["பனிப்புத லிவர்ந்த பைங்கொடி யவரைக்","கிளிவா யொப்பின் ஒளிவிடு பன்மலர்","வெருக்குப்பல் லுருவின் முல்லையொடு கஞலி","வாடை வந்ததன் றலையும் நோய்பொரக்","கண்டிசின் வாழி தோழி தெண்டிரைக்","கடலாழ் கலத்திற் றோன்றி","மாலை மறையு மவர் மணிநெடுங் குன்றே"],"tr":["paṉipputa livarnta paiṅkoṭi yavaraik","kiḷivā yoppiṉ oḷiviṭu paṉmalar","verukkuppal luruviṉ mullaiyoṭu kañali","vāṭai vantataṉ ṟalaiyum nōyporak","kaṇṭiciṉ vāḻi tōḻi teṇṭiraik","kaṭalāḻ kalattiṟ ṟōṉṟi","mālai maṟaiyu mavar maṇineṭuṅ kuṉṟē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"கொல்லனழிசியார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kollaṉaḻiciyār"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"1×5, 5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 1, vañcicīr 1, other 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 9, kalittaḷai 1, oṉṟiya vañcittaḷai 1, ? 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"1 five-foot line (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"பனிப்புத","tr":"paṉipputa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பனிப்","tr":"paṉip"},{"kind":"nirai","text":"புத","tr":"puta"}]},{"text":"லிவர்ந்த","tr":"livarnta","foot":"puḷimā","acai":[{"kind":"nirai","text":"லிவர்ந்","tr":"livarn"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"பைங்கொடி","tr":"paiṅkoṭi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பைங்","tr":"paiṅ"},{"kind":"nirai","text":"கொடி","tr":"koṭi"}]},{"text":"யவரைக்","tr":"yavaraik","foot":"puḷimā","acai":[{"kind":"nirai","text":"யவ","tr":"yava"},{"kind":"nēr","text":"ரைக்","tr":"raik"}]}],[{"text":"கிளிவா","tr":"kiḷivā","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிளி","tr":"kiḷi"},{"kind":"nēr","text":"வா","tr":"vā"}]},{"text":"யொப்பின்","tr":"yoppiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"யொப்","t