{"text":"kuruntokai","n":51,"lines":["கூன்முண் முண்டகக் கூர்ம்பனி மாமலர்","நூலறு முத்திற் காலொடு பாறித்","துறைதொறும் பரக்குந் தூமணற் சேர்ப்பனை","யானும் காதலென் யாயுநனி வெய்யள்","எந்தையுங் கொடீஇயர் வேண்டும்","அம்ப லூரும் அவனொடு மொழிமே"],"tr":["kūṉmuṇ muṇṭakak kūrmpaṉi māmalar","nūlaṟu muttiṟ kāloṭu pāṟit","tuṟaitoṟum parakkun tūmaṇaṟ cērppaṉai","yāṉum kātaleṉ yāyunaṉi veyyaḷ","entaiyuṅ koṭīiyar vēṇṭum","ampa lūrum avaṉoṭu moḻimē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தோழி கூற்று","poet_ta":"குன்றியனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kuṉṟiyaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 12, āciriyattaḷai 9, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கூன்முண்","tr":"kūṉmuṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"கூன்","tr":"kūṉ"},{"kind":"nēr","text":"முண்","tr":"muṇ"}]},{"text":"முண்டகக்","tr":"muṇṭakak","foot":"kūviḷam","acai":[{"kind":"nēr","text":"முண்","tr":"muṇ"},{"kind":"nirai","text":"டகக்","tr":"ṭakak"}]},{"text":"கூர்ம்பனி","tr":"kūrmpaṉi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கூர்ம்","tr":"kūrm"},{"kind":"nirai","text":"பனி","tr":"paṉi"}]},{"text":"மாமலர்","tr":"māmalar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"மலர்","tr":"malar"}]}],[{"text":"நூலறு","tr":"nūlaṟu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நூ","tr":"nū"},{"kind":"nirai","text":"லறு","tr":"laṟu"}]},{"text":"முத்திற்","tr":"muttiṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"முத்","tr":"mut"},{"kind":"nēr","text":"திற்","tr":"tiṟ"}]},{"text":"காலொடு","tr":"kāloṭu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"லொடு","tr":"loṭu"}]},{"text":"பாறித்","tr":"pāṟit","foot":"tēm