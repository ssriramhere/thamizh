{"text":"kuruntokai","n":267,"lines":["இருங்கண் ஞாலத் தீண்டுபயப் பெருவளம்","ஒருங்குடன் இயைவ தாயினுங் கரும்பின்","காலெறி கடிகைக் கண்ணயின் றன்ன","வாலெயி றூறிய வசையில் தீநீர்க்","கோலமை குறுந்தொடிக் குறுமக ளொழிய","ஆள்வினை மருங்கிற் பிரியார் நாளும்","உறன்முறை மரபிற் கூற்றத்","தறனில் கோணற் கறிந்திசி னோரே"],"tr":["iruṅkaṇ ñālat tīṇṭupayap peruvaḷam","oruṅkuṭaṉ iyaiva tāyiṉuṅ karumpiṉ","kāleṟi kaṭikaik kaṇṇayiṉ ṟaṉṉa","vāleyi ṟūṟiya vacaiyil tīnīrk","kōlamai kuṟuntoṭik kuṟumaka ḷoḻiya","āḷviṉai maruṅkiṟ piriyār nāḷum","uṟaṉmuṟai marapiṟ kūṟṟat","taṟaṉil kōṇaṟ kaṟintici ṉōrē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவன் கூற்று","poet_ta":"காலெறி கடிகையார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Kāleṟi Kaṭikaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 22, veṇṭaḷai 7, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இருங்கண்","tr":"iruṅkaṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"இருங்","tr":"iruṅ"},{"kind":"nēr","text":"கண்","tr":"kaṇ"}]},{"text":"ஞாலத்","tr":"ñālat","foot":"tēmā","acai":[{"kind":"nēr","text":"ஞா","tr":"ñā"},{"kind":"nēr","text":"லத்","tr":"lat"}]},{"text":"தீண்டுபயப்","tr":"tīṇṭupayap","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"தீண்","tr":"tīṇ"},{"kind":"nirai","text":"டுப","tr":"ṭupa"},{"kind":"nēr","text":"யப்","tr":"yap"}]},{"text":"பெருவளம்","tr":"peruvaḷam","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெரு","tr":"peru"},{"kind":"nirai","text":"வளம்","tr":"vaḷam"}]}],[{"text":"ஒருங்குடன்","tr":"oruṅkuṭaṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"ஒருங்","tr":"oruṅ"},{"kind":"nirai","text":"குடன்","tr":"kuṭaṉ"}]},{"text":"இயைவ","tr":"iyaiva","foot":"puḷimā","acai":[{"kind":"nirai","text":"இயை","tr":"iyai"},{"kin