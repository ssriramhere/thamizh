{"text":"kuruntokai","n":298,"lines":["சேரி சேர மெல்ல வந்துவந்","தரிது வாய்விட் டினிய கூறி","வைகல் தோறும் நிறம்பெயர்ந் துறையுமவன்","பைதல் நோக்கம் நினையாய் தோழி","இன்கடுங் கள்ளின் அகுதை தந்தை","வெண்கடைச் சிறுகோ லகவன் மகளிர்","மடப்பிடிப் பரிசில் மானப்","பிறிதொன்று குறித்ததவ னெடும்புற நிலையே"],"tr":["cēri cēra mella vantuvan","taritu vāyviṭ ṭiṉiya kūṟi","vaikal tōṟum niṟampeyarn tuṟaiyumavaṉ","paital nōkkam niṉaiyāy tōḻi","iṉkaṭuṅ kaḷḷiṉ akutai tantai","veṇkaṭaic ciṟukō lakavaṉ makaḷir","maṭappiṭip paricil māṉap","piṟitoṉṟu kuṟittatava ṉeṭumpuṟa nilaiyē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"பரணர்","speaker_en":"her friend (tōḻi)","poet_tr":"Paraṇar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 10, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"சேரி","tr":"cēri","foot":"tēmā","acai":[{"kind":"nēr","text":"சே","tr":"cē"},{"kind":"nēr","text":"ரி","tr":"ri"}]},{"text":"சேர","tr":"cēra","foot":"tēmā","acai":[{"kind":"nēr","text":"சே","tr":"cē"},{"kind":"nēr","text":"ர","tr":"ra"}]},{"text":"மெல்ல","tr":"mella","foot":"tēmā","acai":[{"kind":"nēr","text":"மெல்","tr":"mel"},{"kind":"nēr","text":"ல","tr":"la"}]},{"text":"வந்துவந்","tr":"vantuvan","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வந்","tr":"van"},{"kind":"nirai","text":"துவந்","tr":"tuvan"}]}],[{"text":"தரிது","tr":"taritu","foot":"puḷimā","acai":[{"kind":"nirai","text":"தரி","tr":"tari"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"வாய்விட்","tr":"vāyviṭ","foot":"tēmā","acai":[{"kind":"nēr","text":"வாய்","tr":"vāy"},{"kind":"nēr","text":"விட்","tr":"viṭ"}]},{"text":"டினிய","tr":"ṭiṉiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"டினி","tr":"ṭiṉi"},{"kind":"nēr