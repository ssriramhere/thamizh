{"text":"kuruntokai","n":252,"lines":["நெடிய திரண்ட தோள்வளை ஞெகிழ்த்த","கொடிய னாகிய குன்றுகெழு நாடன்","வருவதோர் காலை யின்முகந் திரியாது","கடவுட் கற்பி னவனெதிர் பேணி","மடவை மன்ற நீயெனக் கடவுபு","துனியல் வாழி தோழி சான்றோர்","புகழு முன்னர் நாணுப","பழியாங் கொல்பவோ காணுங் காலே"],"tr":["neṭiya tiraṇṭa tōḷvaḷai ñekiḻtta","koṭiya ṉākiya kuṉṟukeḻu nāṭaṉ","varuvatōr kālai yiṉmukan tiriyātu","kaṭavuṭ kaṟpi ṉavaṉetir pēṇi","maṭavai maṉṟa nīyeṉak kaṭavupu","tuṉiyal vāḻi tōḻi cāṉṟōr","pukaḻu muṉṉar nāṇupa","paḻiyāṅ kolpavō kāṇuṅ kālē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"கிடங்கிற் குலபதி நக்கண்ணனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kiṭaṅkiṟ Kulapati Nakkaṇṇaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 29, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 11, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நெடிய","tr":"neṭiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெடி","tr":"neṭi"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"திரண்ட","tr":"tiraṇṭa","foot":"puḷimā","acai":[{"kind":"nirai","text":"திரண்","tr":"tiraṇ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"தோள்வளை","tr":"tōḷvaḷai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தோள்","tr":"tōḷ"},{"kind":"nirai","text":"வளை","tr":"vaḷai"}]},{"text":"ஞெகிழ்த்த","tr":"ñekiḻtta","foot":"puḷimā","acai":[{"kind":"nirai","text":"ஞெகிழ்த்","tr":"ñekiḻt"},{"kind":"nēr","text":"த","tr":"ta"}]}],[{"text":"கொடிய","tr":"koṭiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"கொடி","tr":"koṭi"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"னாகிய","tr":"ṉākiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"னா","tr":"ṉā"},{"kind":"nirai","text":"கிய","tr":"kiya"}]},{"text":"குன்றுகெழு","tr":"kuṉṟukeḻu","foot":"kūv