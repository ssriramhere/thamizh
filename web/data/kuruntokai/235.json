{"text":"kuruntokai","n":235,"lines":["ஓம்புமதி வாழியோ வாடை பாம்பின்","தூங்குதோல் கடுக்குந் தூவெள் ளருவிக்","கல்லுயர் நண்ணி யதுவே நெல்லி","மரையின மாரு முன்றிற்","புல்வேய் குரம்பை நல்லோ ளூரே"],"tr":["ōmpumati vāḻiyō vāṭai pāmpiṉ","tūṅkutōl kaṭukkun tūveḷ ḷaruvik","kalluyar naṇṇi yatuvē nelli","maraiyiṉa māru muṉṟiṟ","pulvēy kurampai nallō ḷūrē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவன் கூற்று","poet_ta":"மரயேண்டனார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Marayēṇṭaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஓம்புமதி","tr":"ōmpumati","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"ஓம்","tr":"ōm"},{"kind":"nirai","text":"பும","tr":"puma"},{"kind":"nēr","text":"தி","tr":"ti"}]},{"text":"வாழியோ","tr":"vāḻiyō","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nirai","text":"ழியோ","tr":"ḻiyō"}]},{"text":"வாடை","tr":"vāṭai","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"டை","tr":"ṭai"}]},{"text":"பாம்பின்","tr":"pāmpiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"பாம்","tr":"pām"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]}],[{"text":"தூங்குதோல்","tr":"tūṅkutōl","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தூங்","tr":"tūṅ"},{"kind":"nirai","text":"குதோல்","tr":"kutōl"}]},{"text":"கடுக்குந்","tr":"kaṭukkun","foot":"puḷimā","acai":[{"kind":"nirai","text":"கடுக்","tr":"kaṭuk"},{"kind":"nēr","text":"குந்","tr":"kun"}]},{"text":"தூவெள்","tr":"tūveḷ","foot":"tēmā","acai":[{"kind":"nēr","text":"தூ","tr":"tū"},{"kind":"nēr","text":"வெள்","tr":"veḷ"}]},{"text":"ளருவிக்","tr":"ḷaruvik","foot":"puḷimā","acai":[{"kind":"nirai","text":"ளரு","tr":"ḷaru"},{"kind":"nē