{"text":"kuruntokai","n":214,"lines":["மரங்கொல் கானவன் புனந்துளர்ந்து வித்திய","பிறங்குகுரல் இறடி காக்கும் புறந்தாழ்","அஞ்சி லோதி அசையியற் கொடிச்சி","திருந்திழை அல்குற்குப் பெருந்தழை உதவிச்","செயலை முழுமுதல் ஒழிய அயல","தரலை மாலை சூட்டி","ஏமுற் றன்றிவ் வழுங்க லூரே"],"tr":["maraṅkol kāṉavaṉ puṉantuḷarntu vittiya","piṟaṅkukural iṟaṭi kākkum puṟantāḻ","añci lōti acaiyiyaṟ koṭicci","tiruntiḻai alkuṟkup peruntaḻai utavic","ceyalai muḻumutal oḻiya ayala","taralai mālai cūṭṭi","ēmuṟ ṟaṉṟiv vaḻuṅka lūrē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"கூடலூர்கிழார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kūṭalūrkiḻār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 24, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 10, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மரங்கொல்","tr":"maraṅkol","foot":"puḷimā","acai":[{"kind":"nirai","text":"மரங்","tr":"maraṅ"},{"kind":"nēr","text":"கொல்","tr":"kol"}]},{"text":"கானவன்","tr":"kāṉavaṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"னவன்","tr":"ṉavaṉ"}]},{"text":"புனந்துளர்ந்து","tr":"puṉantuḷarntu","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"புனந்","tr":"puṉan"},{"kind":"nirai","text":"துளர்ந்","tr":"tuḷarn"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"வித்திய","tr":"vittiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வித்","tr":"vit"},{"kind":"nirai","text":"திய","tr":"tiya"}]}],[{"text":"பிறங்குகுரல்","tr":"piṟaṅkukural","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"பிறங்","tr":"piṟaṅ"},{"kind":"nirai","text":"குகு","tr":"kuku"},{"kind":"nēr","text":"ரல்","tr":"ral"}]},{"text":"இறடி","tr":"iṟaṭi","foot":"puḷimā","acai":[{"kind":"nirai","text":"இற","tr":"iṟa"},{"kind":"nēr","text