{"text":"kuruntokai","n":270,"lines":["தாழிருள் துமிய மின்னித் தண்ணென","வீழுறை யினிய சிதறி ஊழிற்","கடிப்பிடு முரசின் முழங்கி இடித்திடித்துப்","பெய்தினி வாழியோ பெறுவான் யாமே","செய்வினை முடித்த செம்ம லுள்ளமோ","டிவளின் மேவின மாகிக் குவளைக்","குறுந்தாள் நாள்மலர் நாறும்","நறுமென் கூந்தல் மெல்லணை யேமே"],"tr":["tāḻiruḷ tumiya miṉṉit taṇṇeṉa","vīḻuṟai yiṉiya citaṟi ūḻiṟ","kaṭippiṭu muraciṉ muḻaṅki iṭittiṭittup","peytiṉi vāḻiyō peṟuvāṉ yāmē","ceyviṉai muṭitta cemma luḷḷamō","ṭivaḷiṉ mēviṉa mākik kuvaḷaik","kuṟuntāḷ nāḷmalar nāṟum","naṟumeṉ kūntal mellaṇai yēmē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவன் கூற்று","poet_ta":"பாண்டியன் பன்னாடுதந்தான்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Pāṇṭiyaṉ Paṉṉāṭutantāṉ"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 13"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"தாழிருள்","tr":"tāḻiruḷ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nirai","text":"ழிருள்","tr":"ḻiruḷ"}]},{"text":"துமிய","tr":"tumiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"துமி","tr":"tumi"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"மின்னித்","tr":"miṉṉit","foot":"tēmā","acai":[{"kind":"nēr","text":"மின்","tr":"miṉ"},{"kind":"nēr","text":"னித்","tr":"ṉit"}]},{"text":"தண்ணென","tr":"taṇṇeṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தண்","tr":"taṇ"},{"kind":"nirai","text":"ணென","tr":"ṇeṉa"}]}],[{"text":"வீழுறை","tr":"vīḻuṟai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வீ","tr":"vī"},{"kind":"nirai","text":"ழுறை","tr":"ḻuṟai"}]},{"text":"யினிய","tr":"yiṉiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"யினி","tr":"yiṉi"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"சிதறி","tr":"citaṟi","foot":"puḷimā","acai