ast participle suffix"}],"gloss":"having flashed"},{"surface":"தண்","parts":[{"text":"தண்","lemma":"taṇ","gloss":"cool"}],"gloss":"cool"},{"surface":"என","parts":[{"text":"என்","lemma":"eṉ","gloss":"to say/sound"},{"text":"அ","lemma":"a","gloss":"infinitive suffix"}],"gloss":"coolly"}]},{"words":[{"surface":"வீழ்","parts":[{"text":"வீழ்","lemma":"vīḻ","gloss":"falling"}],"gloss":"falling"},{"surface":"உறை","parts":[{"text":"உறை","lemma":"uṟai","gloss":"drop of rain"}],"gloss":"drops"},{"surface":"இனிய","parts":[{"text":"இனி","lemma":"iṉi","gloss":"sweetness/pleasing"},{"text":"அ","lemma":"a","gloss":"adjectival suffix"}],"gloss":"sweet"},{"surface":"சிதறி","parts":[{"text":"சிதறு","lemma":"citaṟu","gloss":"to scatter"},{"text":"இ","lemma":"i","gloss":"past participle suffix"}],"gloss":"having scattered"},{"surface":"ஊழின்","parts":[{"text":"ஊழ்","lemma":"ūḻ","gloss":"proper order/turn"},{"text":"இன்","lemma":"iṉ","gloss":"locative/instrumental suffix"}],"gloss":"in turn"}]},{"words":[{"surface":"கடிப்பு","parts":[{"text":"கடிப்பு","lemma":"kaṭippu","gloss":"drumstick"}],"gloss":"drumstick"},{"surface":"இடு","parts":[{"text":"இடு","lemma":"iṭu","gloss":"to strike/place"}],"gloss":"struck"},{"surface":"முரசின்","parts":[{"text":"முரசு","lemma":"muracu","gloss":"drum"},{"text":"இன்","lemma":"iṉ","gloss":"like/oblique suffix"}],"gloss":"like a drum"},{"surface":"முழங்கி","parts":[{"text":"முழங்கு","lemma":"muḻaṅku","gloss":"to thunder/roar"},{"text":"இ","lemma":"i","gloss":"past participle suffix"}],"gloss":"having roared"},{"surface":"இடித்திடித்து","parts":[{"text":"இடித்து","lemma":"iṭittu","gloss":"having thundered"},{"text":"இடித்து","lemma":"iṭittu","gloss":"having thundered"}],"gloss":"thundering repeatedly"}]},{"words":[{"surface":"பெய்து","parts":[{"text":"பெய்","lemma":"pey","gloss":"to rain"},{"text":"து","lemma":"tu","gloss":"past participle suffix"}],"gloss":"having rained"},{"surface":"இனி","parts":[{"text":"இனி","lemma":"iṉi","gloss":"now/henceforth"}],"gloss":"now"},{"surface":"வாழியோ","parts":[{"text":"வாழியோ","lemma":"வாழியோ","gloss":"may you live!"}],"gloss":"may you live!","split_unverified":true},{"surface":"பெறுவான்","parts":[{"text":"பெறு","lemma":"peṟu","gloss":"to obtain"},{"text":"வான்","lemma":"vāṉ","gloss":"future participle/purposive suffix"}],"gloss":"to obtain"},{"surface":"யாமே","parts":[{"text":"யாம்","lemma":"yām","gloss":"we"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"we"}]},{"words":[{"surface":"செய்வினை","parts":[{"text":"செய்","lemma":"செய்","gloss":"do"},{"text":"வினை","lemma":"வினை","gloss":"work"}],"gloss":"the work done"},{"surface":"முடித்த","parts":[{"text":"முடி","lemma":"முடி","gloss":"finish"},{"text":"த்த","lemma":"த்த","gloss":"past adjectival participle suffix"}],"gloss":"that completed"},{"surface":"செம்மல்","parts":[{"text":"செம்மல்","lemma":"செம்மல்","gloss":"pride"}],"gloss":"pride"},{"surface":"உள்ளமோ","parts":[{"text":"உள்ளமோ","lemma":"உள்ளமோ","gloss":"with the mind"}],"gloss":"with the mind","split_unverified":true}]},{"words":[{"surface":"டிவளின்","parts":[{"text":"டிவளின்","lemma":"டிவளின்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மேவின","parts":[{"text":"மேவின","lemma":"மேவின","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மாகிக்","parts":[{"text":"மாகிக்","lemma":"மாகிக்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"குவளைக்","parts":[{"text":"குவளைக்","lemma":"குவளைக்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"குறுந்தாள்","parts":[{"text":"குறுந்தாள்","lemma":"குறுந்தாள்","gloss":"short-stemmed"}],"gloss":"short-stemmed","split_unverified":true},{"surface":"நாள்","parts":[{"text":"நாள்","lemma":"nāḷ","gloss":"fresh/day"}],"gloss":"fresh"},{"surface":"மலர்","parts":[{"text":"மலர்","lemma":"malar","gloss":"flower"}],"gloss":"flower"},{"surface":"நாறும்","parts":[{"text":"நாறு","lemma":"nāṟu","gloss":"to smell sweet"},{"text":"உம்","lemma":"um","gloss":"relative participle suffix"}],"gloss":"smelling sweet"}]},{"words":[{"surface":"நறு","parts":[{"text":"நறு","lemma":"naṟu","gloss":"fragrant"}],"gloss":"fragrant"},{"surface":"மென்","parts":[{"text":"மென்","lemma":"மென்","gloss":"soft"}],"gloss":"soft","split_unverified":true},{"surface":"கூந்தல்","parts":[{"text":"கூந்தல்","lemma":"kūntal","gloss":"hair"}],"gloss":"hair"},{"surface":"மெல்","parts":[{"text":"மெல்","lemma":"mel","gloss":"soft"}],"gloss":"soft"},{"surface":"அணையேமே","parts":[{"text":"அணை","lemma":"aṇai","gloss":"embrace/bed"},{"text":"ஏம்","lemma":"ēm","gloss":"we"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"on the embrace/bed we are"}]}],"literal":"Dense darkness to disperse, having flashed, coolly / falling drops, sweet, having scattered, in turn / like a drum struck by a drumstick, having roared, thundering repeatedly / rain now, may you live! To obtain, we / the work to be done having finished, with a proud mind / with her, having united, the blue water-lily's / short-stemmed fresh flower smelling sweet / fragrant soft hair, on the soft bed/embrace we are.","translation":"O rain, may you live long! Flash so that the deep darkness is dispersed, scatter sweet falling drops, and roar in turn like a drum beaten with a drumstick, thundering repeatedly as you pour down now! For we, having finished our duty with a proud heart, have united with her, and are now resting in the soft embrace of her fragrant, soft hair that smells of fresh, short-stemmed blue water-lilies.","modern":"அடர்ந்த இருள் விலகும்படி மின்னல் மின்னி, குளிர்ச்சியாக இனிய மழைத்துளிகளைத் தூவி, முறைப்படி குறுந்தடியால் அடிக்கப்படும் முரசு போல முழங்கி, மீண்டும் மீண்டும் இடித்து இப்போது மழை பொழிவாயாக! நீ வாழ்க! கடமையை முடித்த பெருமித உணர்வோடு நாம் இவளுடன் கூடி, குவளையின் குட்டையான தண்டையுடைய புதிய மலரின் மணம் வீசும் நறிய மென்மையான கூந்தலாகிய மெல்லிய அணையில் துயில்கின்றோம்.","explanation":"The hero is speaking to the rain upon his return to his beloved. He has successfully completed his mission and returned to his wife in the Mullai (forest/pastoral) region just as the rainy season begins. He blesses the rain and urges it to pour down generously, now that he is safely back home and reunited with his wife. He describes the thunderous, rhythmic sound of the rain like a beaten drum, and contrasts the wild storm outside with the peaceful, fragrant intimacy of his wife's embrace inside. The Mullai landscape is characterized by the rainy season, which is the time of the hero's promised return. The key words are 'செய்வினை முடித்த' (having finished the task), 'மேவினமாகி' (having united), and 'நறுமென் கூந்தல்' (fragrant soft hair).","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,1.1],[1.1,1.2],[1.34,1.9],[1.9,2.5],[2.6,2.9],[2.9,3.3],[3.3,3.35],[3.35,3.6],[3.6,5.0],[5.0,5.3],[5.3,6.0],[6.15,6.9],[6.9,7.4],[7.4,7.9],[7.9,8.2],[8.2,9.2],[9.2,9.6],[9.6,9.67],[9.67,9.95],[10.0,10.05],[10.1,10.73],[11.04,12.36],[12.36,12.6],[12.6,13.4],[13.4,13.4],[13.4,14.0],[14.0,15.2],[15.2,15.3],[15.3,16.0],[16.0,16.3]],"female":[[0.0,0.8],[0.8,1.2],[1.2,1.3],[1.44,2.0],[2.0,2.38],[2.38,3.5],[3.5,3.9],[3.9,3.98],[3.98,4.14],[4.3,6.0],[6.0,6.3],[6.39,6.9],[7.07,8.0],[8.2,8.6],[8.6,9.1],[9.1,9.5],[9.5,10.4],[10.4,10.9],[10.9,10.97],[10.97,11.25],[11.3,13.0],[13.0,13.5],[13.5,13.92],[13.92,14.4],[14.4,15.3],[15.3,15.4],[15.4,16.0],[16.0,17.4],[17.4,17.6],[17.6,17.85],[17.85,18.1]]},"sync":[[["தாழ்","dense"],["இருள்","darkness"]],[["துமிய","to disperse"]],[["மின்னி","having flashed"],["தண்","cool"]],[["தண்","cool"],["என","coolly"]],[["வீழ்","falling"],["உறை","drops"]],[["இனிய","sweet"]],[["சிதறி","having scattered"]],[["ஊழின்","in turn"]],[["கடிப்பு","drumstick"],["இடு","struck"]],[["முரசின்","like a drum"]],[["முழங்கி","having roared"]],[["இடித்திடித்து","thundering repeatedly"]],[["பெய்து","having rained"],["இனி","now"]],[["வாழியோ","may you live!"]],[["பெறுவான்","to obtain"]],[["யாமே","we"]],[["செய்வினை","the work done"]],[["முடித்த","that completed"]],[["செம்மல்","pride"]],[["செம்மல்","pride"],["உள்ளமோ","with the mind"]],[["டிவளின்",""]],[["மேவின",""]],[["மாகிக்",""]],[["குவளைக்",""]],[["குறுந்தாள்","short-stemmed"]],[["நாள்","fresh"],["மலர்","flower"]],[["நாறும்","smelling sweet"]],[["நறு","fragrant"],["மென்","soft"]],[["கூந்தல்","hair"]],[["மெல்","soft"],["அணையேமே","on the embrace/bed we are"]],[["அணையேமே","on the embrace/bed we are"]]]}