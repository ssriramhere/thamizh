{"text":"kuruntokai","n":270,"lines":["தாழிருள் துமிய மின்னித் தண்ணென","வீழுறை யினிய சிதறி ஊழிற்","கடிப்பிடு முரசின் முழங்கி இடித்திடித்துப்","பெய்தினி வாழியோ பெறுவான் யாமே","செய்வினை முடித்த செம்ம லுள்ளமோ","டிவளின் மேவின மாகிக் குவளைக்","குறுந்தாள் நாள்மலர் நாறும்","நறுமென் கூந்தல் மெல்லணை யேமே"],"tr":["tāḻiruḷ tumiya miṉṉit taṇṇeṉa","vīḻuṟai yiṉiya citaṟi ūḻiṟ","kaṭippiṭu muraciṉ muḻaṅki iṭittiṭittup","peytiṉi vāḻiyō peṟuvāṉ yāmē","ceyviṉai muṭitta cemma luḷḷamō","ṭivaḷiṉ mēviṉa mākik kuvaḷaik","kuṟuntāḷ nāḷmalar nāṟum","naṟumeṉ kūntal mellaṇai yēmē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவன் கூற்று","poet_ta":"பாண்டியன் பன்னாடுதந்தான்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Pāṇṭiyaṉ Paṉṉāṭutantāṉ"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 13"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"தாழிருள்","tr":"tāḻiruḷ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nirai","text":"ழிருள்","tr":"ḻiruḷ"}]},{"text":"துமிய","tr":"tumiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"துமி","tr":"tumi"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"மின்னித்","tr":"miṉṉit","foot":"tēmā","acai":[{"kind":"nēr","text":"மின்","tr":"miṉ"},{"kind":"nēr","text":"னித்","tr":"ṉit"}]},{"text":"தண்ணென","tr":"taṇṇeṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தண்","tr":"taṇ"},{"kind":"nirai","text":"ணென","tr":"ṇeṉa"}]}],[{"text":"வீழுறை","tr":"vīḻuṟai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வீ","tr":"vī"},{"kind":"nirai","text":"ழுறை","tr":"ḻuṟai"}]},{"text":"யினிய","tr":"yiṉiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"யினி","tr":"yiṉi"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"சிதறி","tr":"citaṟi","foot":"puḷimā","acai":[{"kind":"nirai","text":"சித","tr":"cita"},{"kind":"nēr","text":"றி","tr":"ṟi"}]},{"text":"ஊழிற்","tr":"ūḻiṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"ஊ","tr":"ū"},{"kind":"nēr","text":"ழிற்","tr":"ḻiṟ"}]}],[{"text":"கடிப்பிடு","tr":"kaṭippiṭu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கடிப்","tr":"kaṭip"},{"kind":"nirai","text":"பிடு","tr":"piṭu"}]},{"text":"முரசின்","tr":"muraciṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"முர","tr":"mura"},{"kind":"nēr","text":"சின்","tr":"ciṉ"}]},{"text":"முழங்கி","tr":"muḻaṅki","foot":"puḷimā","acai":[{"kind":"nirai","text":"முழங்","tr":"muḻaṅ"},{"kind":"nēr","text":"கி","tr":"ki"}]},{"text":"இடித்திடித்துப்","tr":"iṭittiṭittup","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"இடித்","tr":"iṭit"},{"kind":"nirai","text":"திடித்","tr":"tiṭit"},{"kind":"nēr","text":"துப்","tr":"tup"}]}],[{"text":"பெய்தினி","tr":"peytiṉi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பெய்","tr":"pey"},{"kind":"nirai","text":"தினி","tr":"tiṉi"}]},{"text":"வாழியோ","tr":"vāḻiyō","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nirai","text":"ழியோ","tr":"ḻiyō"}]},{"text":"பெறுவான்","tr":"peṟuvāṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெறு","tr":"peṟu"},{"kind":"nēr","text":"வான்","tr":"vāṉ"}]},{"text":"யாமே","tr":"yāmē","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"மே","tr":"mē"}]}],[{"text":"செய்வினை","tr":"ceyviṉai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"செய்","tr":"cey"},{"kind":"nirai","text":"வினை","tr":"viṉai"}]},{"text":"முடித்த","tr":"muṭitta","foot":"puḷimā","acai":[{"kind":"nirai","text":"முடித்","tr":"muṭit"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"செம்ம","tr":"cemma","foot":"tēmā","acai":[{"kind":"nēr","text":"செம்","tr":"cem"},{"kind":"nēr","text":"ம","tr":"ma"}]},{"text":"லுள்ளமோ","tr":"luḷḷamō","foot":"kūviḷam","acai":[{"kind":"nēr","text":"லுள்","tr":"luḷ"},{"kind":"nirai","text":"ளமோ","tr":"ḷamō"}]}],[{"text":"டிவளின்","tr":"ṭivaḷ