gloss":"small feet","split_unverified":true}]},{"words":[{"surface":"சிறுபசும்","parts":[{"text":"சிறு","lemma":"சிறு","gloss":"small"},{"text":"பசும்","lemma":"பசுமை","gloss":"green/fresh"}],"gloss":"small fresh"},{"surface":"பாவையும்","parts":[{"text":"பாவை","lemma":"பாவை","gloss":"doll"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and the doll"},{"surface":"எம்மும்","parts":[{"text":"எம்","lemma":"யாம்","gloss":"us/me"},{"text":"உம்","lemma":"உம்","gloss":"also"}],"gloss":"and me"},{"surface":"உள்ளார்","parts":[{"text":"உள்","lemma":"உள்ளுதல்","gloss":"think of"},{"text":"ஆர்","lemma":"ஆர்","gloss":"negative third person honorific suffix"}],"gloss":"he does not think of"}]},{"words":[{"surface":"கொடியர்","parts":[{"text":"கொடி","lemma":"கொடுமை","gloss":"cruel"},{"text":"அர்","lemma":"அர்","gloss":"pronominal suffix"}],"gloss":"he is cruel"},{"surface":"வாழி","parts":[{"text":"வாழ்","lemma":"வாழ்தல்","gloss":"live"},{"text":"இ","lemma":"இ","gloss":"optative suffix"}],"gloss":"may you live"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"தோழி","gloss":"friend"}],"gloss":"friend"},{"surface":"கடுவன்","parts":[{"text":"கடுவன்","lemma":"கடுவன்","gloss":"male monkey"}],"gloss":"male monkey"}]},{"words":[{"surface":"ஊழுறு","parts":[{"text":"ஊழ்","lemma":"ஊழ்","gloss":"ripeness"},{"text":"உறு","lemma":"உறு","gloss":"reach/have"}],"gloss":"ripe"},{"surface":"தீங்கனி","parts":[{"text":"தீம்","lemma":"தீமை","gloss":"sweet"},{"text":"கனி","lemma":"கனி","gloss":"fruit"}],"gloss":"sweet fruit"},{"surface":"உதிர்ப்பக்","parts":[{"text":"உதிர்","lemma":"உதிர்தல்","gloss":"fall"},{"text":"ப்ப","lemma":"ப்ப","gloss":"infinitive suffix"},{"text":"க்","lemma":"க்","gloss":"sandhi consonant"}],"gloss":"shedding"},{"surface":"கீழ்","parts":[{"text":"கீழ்","lemma":"கீழ்","gloss":"below"}],"gloss":"below"},{"surface":"இருந்","parts":[{"text":"இருந்","lemma":"இருந்","gloss":"staying"}],"gloss":"staying","split_unverified":true}]},{"words":[{"surface":"தேற்பன","parts":[{"text":"தேற்பன","lemma":"தேற்பன","gloss":"those that are received"}],"gloss":"those that are received","split_unverified":true},{"surface":"ஏற்பன","parts":[{"text":"ஏற்பன","lemma":"ஏற்பன","gloss":"those that are received"}],"gloss":"those that are received"},{"surface":"உண்ணும்","parts":[{"text":"உண்","lemma":"உண்ணுதல்","gloss":"eat"},{"text":"உம்","lemma":"உம்","gloss":"adjectival participle suffix"}],"gloss":"eating"}]},{"words":[{"surface":"பார்ப்புடை","parts":[{"text":"பார்ப்பு","lemma":"பார்ப்பு","gloss":"young one"},{"text":"உடை","lemma":"உடை","gloss":"possessing"}],"gloss":"having a young one"},{"surface":"மந்திய","parts":[{"text":"மந்தி","lemma":"மந்தி","gloss":"female monkey"},{"text":"அ","lemma":"அ","gloss":"genitive suffix"}],"gloss":"of the female monkey"},{"surface":"மலையிறந்","parts":[{"text":"மலையிறந்","lemma":"மலையிறந்","gloss":"having traversed the mountain"}],"gloss":"having traversed the mountain","split_unverified":true},{"surface":"தோரே","parts":[{"text":"தோரே","lemma":"தோரே","gloss":"he (emphatic)"}],"gloss":"he (emphatic)","split_unverified":true}]}],"literal":"Strong wind shaken beautiful tender leaf mango tree's / sprout seen like soft small feet / small green doll and me also he does not think of / cruel he is, may you live friend! Male monkey / ripe sweet fruit shedding, staying below / those received those received eating / having young one female monkey's mountain traversed he.","translation":"May you live, my friend! He is cruel indeed. He does not think of me, nor of this small green doll with soft little feet that look like the tender sprouts of a mango tree shaken by strong winds. He has traversed the mountains where the male monkey shakes down ripe, sweet fruits, and the female monkey with her young one stays below, catching and eating them as they fall.","modern":"தோழியே, நீ வாழ்க! அவர் இரக்கமற்றவர். பலத்த காற்றினால் அசைக்கப்பட்ட அழகிய தளிர் இலைகளைக் கொண்ட மாமரத்தின் தளிரைக் கண்டாற்போன்ற மென்மையான சிறிய பாதங்களைக் கொண்ட சிறிய பச்சைப் பாவையையும் என்னையும் அவர் நினைக்கவில்லை. ஆண் குரங்கு பழுத்த இனிய பழங்களை உதிர்க்க, கீழே இருந்து அவற்றை ஏற்று ஏற்று உண்ணும் குட்டியையுடைய பெண் குரங்கைக் கொண்ட மலைகளைக் கடந்து சென்றவர் அவர்.","explanation":"This poem is spoken by the heroine to her friend during the hero's absence. She laments that the hero has gone away through the harsh mountain paths and has forgotten both her and her beloved green play-doll. She describes the doll as having soft little feet resembling the tender sprouts of a wind-shaken mango tree. The landscape of the mountains he traversed is described with a poignant image: a male monkey shakes down sweet, ripe fruits from above, while the female monkey with her young one waits below to catch and eat them. This scene of familial care and sharing among the monkeys in the mountain landscape contrasts sharply with the hero's abandonment of the heroine, emphasizing his cruelty.","model":"gemini-3.5-flash"},"timing":{"male":[[0.27,0.6],[0.6,1.1],[1.1,1.5],[1.5,2.0],[2.0,2.47],[2.47,3.1],[3.1,3.3],[3.3,3.6],[3.6,5.1],[5.1,5.4],[5.4,5.9],[5.9,6.4],[6.4,6.9],[6.9,6.9],[6.9,7.4],[7.4,7.8],[7.8,7.83],[7.83,7.83],[7.83,7.9],[7.9,7.9],[7.9,7.9],[7.9,7.9],[7.9,8.0],[8.0,12.7],[12.7,13.1],[13.1,13.55],[13.55,13.7]],"female":[[0.33,0.7],[0.7,1.2],[1.2,1.8],[1.8,2.2],[2.2,2.71],[2.71,3.4],[3.4,3.8],[3.8,4.1],[4.1,5.7],[5.7,6.0],[6.0,6.5],[6.5,7.0],[7.0,7.7],[7.7,7.7],[7.7,8.2],[8.2,8.7],[8.98,9.54],[9.54,11.5],[11.5,11.64],[11.64,11.64],[11.64,12.2],[12.2,12.5],[12.5,12.8],[12.8,14.3],[14.3,14.72],[14.8,15.3],[15.3,15.5]]}}