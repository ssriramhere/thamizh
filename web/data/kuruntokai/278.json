{"text":"kuruntokai","n":278,"lines":["உறுவளி உளரிய அந்தளிர் மாஅத்து","முறிகண் டன்ன மெல்லென் சீறடிச்","சிறுபசும் பாவையும் எம்மும் உள்ளார்","கொடியர் வாழி தோழி கடுவன்","ஊழுறு தீங்கனி உதிர்ப்பக் கீழிருந்","தேற்பன ஏற்பன உண்ணும்","பார்ப்புடை மந்திய மலையிறந் தோரே"],"tr":["uṟuvaḷi uḷariya antaḷir māattu","muṟikaṇ ṭaṉṉa melleṉ cīṟaṭic","ciṟupacum pāvaiyum emmum uḷḷār","koṭiyar vāḻi tōḻi kaṭuvaṉ","ūḻuṟu tīṅkaṉi utirppak kīḻirun","tēṟpaṉa ēṟpaṉa uṇṇum","pārppuṭai mantiya malaiyiṟan tōrē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"பேரி சாத்தனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Pēri Cāttaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 12, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"உறுவளி","tr":"uṟuvaḷi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"உறு","tr":"uṟu"},{"kind":"nirai","text":"வளி","tr":"vaḷi"}]},{"text":"உளரிய","tr":"uḷariya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"உள","tr":"uḷa"},{"kind":"nirai","text":"ரிய","tr":"riya"}]},{"text":"அந்தளிர்","tr":"antaḷir","foot":"kūviḷam","acai":[{"kind":"nēr","text":"அந்","tr":"an"},{"kind":"nirai","text":"தளிர்","tr":"taḷir"}]},{"text":"மாஅத்து","tr":"māattu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"அத்","tr":"at"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"முறிகண்","tr":"muṟikaṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"முறி","tr":"muṟi"},{"kind":"nēr","text":"கண்","tr":"kaṇ"}]},{"text":"டன்ன","tr":"ṭaṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"டன்","tr":"ṭaṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"மெல்லென்","tr":"melleṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"மெல்","tr":"mel"},