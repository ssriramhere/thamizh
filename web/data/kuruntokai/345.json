{"text":"kuruntokai","n":345,"lines":["இழையணிந் தியல்வருங் கொடுஞ்சி நெடுந்தேர்","வரைமருள் நெடுமணல் தவிர்த்துநின் றசைஇத்","தங்கினி ராயின் தவறோ தெய்ய","தழைதாழ் அல்குல் இவள்புலம் பகலத்","தாழை தைஇய தயங்குதிரைக் கொடுங்கழி","இழுமென ஒலிக்கும் ஆங்கண்","பெருநீர் வேலியெம் சிறுநல் லூரே"],"tr":["iḻaiyaṇin tiyalvaruṅ koṭuñci neṭuntēr","varaimaruḷ neṭumaṇal tavirttuniṉ ṟacaiit","taṅkiṉi rāyiṉ tavaṟō teyya","taḻaitāḻ alkul ivaḷpulam pakalat","tāḻai taiiya tayaṅkutiraik koṭuṅkaḻi","iḻumeṉa olikkum āṅkaṇ","perunīr vēliyem ciṟunal lūrē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தோழி கூற்று","poet_ta":"அண்டர்மகன் குறுவழுதியார்","speaker_en":"her friend (tōḻi)","poet_tr":"Aṇṭarmakaṉ Kuṟuvaḻutiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 7, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இழையணிந்","tr":"iḻaiyaṇin","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இழை","tr":"iḻai"},{"kind":"nirai","text":"யணிந்","tr":"yaṇin"}]},{"text":"தியல்வருங்","tr":"tiyalvaruṅ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தியல்","tr":"tiyal"},{"kind":"nirai","text":"வருங்","tr":"varuṅ"}]},{"text":"கொடுஞ்சி","tr":"koṭuñci","foot":"puḷimā","acai":[{"kind":"nirai","text":"கொடுஞ்","tr":"koṭuñ"},{"kind":"nēr","text":"சி","tr":"ci"}]},{"text":"நெடுந்தேர்","tr":"neṭuntēr","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெடுந்","tr":"neṭun"},{"kind":"nēr","text":"தேர்","tr":"tēr"}]}],[{"text":"வரைமருள்","tr":"varaimaruḷ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வரை","tr":"varai"},{"kind":"nirai","text":"மருள்","tr":"maruḷ"}]},{"text":"நெடுமணல்","tr":"neṭumaṇal","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நெடு","tr":"neṭu"},{"kind":"nirai","text":"மணல்","tr":"maṇal"