{"text":"kuruntokai","n":382,"lines":["தண்துளிக் கேற்ற பைங்கொடி முல்லை","முகைதலைத் திறந்த நாற்றம் புதல்மிசை","பூமலி தளவமொடு தேங்கமழ்பு கஞல","வம்புப் பெய்யுமால் மழையே வம்பன்று","காரிது பருவம் ஆயின்","வாரா ரோநம் காத லோரே"],"tr":["taṇtuḷik kēṟṟa paiṅkoṭi mullai","mukaitalait tiṟanta nāṟṟam putalmicai","pūmali taḷavamoṭu tēṅkamaḻpu kañala","vampup peyyumāl maḻaiyē vampaṉṟu","kāritu paruvam āyiṉ","vārā rōnam kāta lōrē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தோழி கூற்று","poet_ta":"குறுங்கீரனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kuṟuṅkīraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 20, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 7, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"தண்துளிக்","tr":"taṇtuḷik","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தண்","tr":"taṇ"},{"kind":"nirai","text":"துளிக்","tr":"tuḷik"}]},{"text":"கேற்ற","tr":"kēṟṟa","foot":"tēmā","acai":[{"kind":"nēr","text":"கேற்","tr":"kēṟ"},{"kind":"nēr","text":"ற","tr":"ṟa"}]},{"text":"பைங்கொடி","tr":"paiṅkoṭi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பைங்","tr":"paiṅ"},{"kind":"nirai","text":"கொடி","tr":"koṭi"}]},{"text":"முல்லை","tr":"mullai","foot":"tēmā","acai":[{"kind":"nēr","text":"முல்","tr":"mul"},{"kind":"nēr","text":"லை","tr":"lai"}]}],[{"text":"முகைதலைத்","tr":"mukaitalait","foot":"karuviḷam","acai":[{"kind":"nirai","text":"முகை","tr":"mukai"},{"kind":"nirai","text":"தலைத்","tr":"talait"}]},{"text":"திறந்த","tr":"tiṟanta","foot":"puḷimā","acai":[{"kind":"nirai","text":"திறந்","tr":"tiṟan"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"நாற்றம்","tr":"nāṟṟam","foot":"tēmā","acai":[{"kind":"nēr","text":"நாற்","tr":"nāṟ"},{"kind":"nēr","text":"றம்","tr":"ṟam"}]},{"text":"புதல்மிசை","tr":"putalmicai","foot":"k