"நம்","tr":"nam"}]},{"text":"காத","tr":"kāta","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"லோரே","tr":"lōrē","foot":"tēmā","acai":[{"kind":"nēr","text":"லோ","tr":"lō"},{"kind":"nēr","text":"ரே","tr":"rē"}]}]]},"ai":{"lines":[{"words":[{"surface":"தண்துளிக்கு","parts":[{"text":"தண்","lemma":"தண்மை","gloss":"cool"},{"text":"துளி","lemma":"துளி","gloss":"drop"},{"text":"கு","lemma":"கு","gloss":"to"}],"gloss":"to the cool drops"},{"surface":"ஏற்ற","parts":[{"text":"ஏற்ற","lemma":"ஏற்ற","gloss":"suited"}],"gloss":"suited"},{"surface":"பைங்கொடி","parts":[{"text":"பைங்கொடி","lemma":"பைங்கொடி","gloss":"green creeper"}],"gloss":"green creeper","split_unverified":true},{"surface":"முல்லை","parts":[{"text":"முல்லை","lemma":"முல்லை","gloss":"jasmine"}],"gloss":"jasmine"}]},{"words":[{"surface":"முகைதலை","parts":[{"text":"முகை","lemma":"முகை","gloss":"bud"},{"text":"தலை","lemma":"தலை","gloss":"tip"}],"gloss":"tip of the bud"},{"surface":"திறந்த","parts":[{"text":"திறந்த","lemma":"திறந்த","gloss":"which opened"}],"gloss":"which opened","split_unverified":true},{"surface":"நாற்றம்","parts":[{"text":"நாற்றம்","lemma":"நாற்றம்","gloss":"fragrance"}],"gloss":"fragrance"},{"surface":"புதல்மிசை","parts":[{"text":"புதல்","lemma":"புதல்","gloss":"shrub"},{"text":"மிசை","lemma":"மிசை","gloss":"upon"}],"gloss":"upon the shrub"}]},{"words":[{"surface":"பூமலி","parts":[{"text":"பூ","lemma":"பூ","gloss":"flower"},{"text":"மலி","lemma":"மலி","gloss":"abundant"}],"gloss":"flower-abundant"},{"surface":"தளவமொடு","parts":[{"text":"தளவம்","lemma":"தளவம்","gloss":"wild jasmine"},{"text":"ஒடு","lemma":"ஒடு","gloss":"with"}],"gloss":"with wild jasmine"},{"surface":"தேங்கமழ்பு","parts":[{"text":"தேங்கமழ்பு","lemma":"தேங்கமழ்பு","gloss":"sweet-smelling"}],"gloss":"sweet-smelling","split_unverified":true},{"surface":"கஞல","parts":[{"text":"கஞல","lemma":"கஞலுதல்","gloss":"to crowd"}],"gloss":"to crowd"}]},{"words":[{"surface":"வம்பு","parts":[{"text":"வம்பு","lemma":"வம்பு","gloss":"unseasonable"}],"gloss":"unseasonably"},{"surface":"பெய்யுமால்","parts":[{"text":"பெய்யும்","lemma":"பெய்தல்","gloss":"will rain"},{"text":"ஆல்","lemma":"ஆல்","gloss":"indeed"}],"gloss":"it rains indeed"},{"surface":"மழையே","parts":[{"text":"மழை","lemma":"மழை","gloss":"rain"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"the rain indeed"},{"surface":"வம்பன்று","parts":[{"text":"வம்பு","lemma":"வம்பு","gloss":"unseasonable"},{"text":"அன்று","lemma":"அன்று","gloss":"it is not"}],"gloss":"it is not unseasonable"}]},{"words":[{"surface":"காரிது","parts":[{"text":"கார்","lemma":"கார்","gloss":"rainy season"},{"text":"இது","lemma":"இது","gloss":"this"}],"gloss":"this is the rainy season"},{"surface":"பருவம்","parts":[{"text":"பருவம்","lemma":"பருவம்","gloss":"season"}],"gloss":"season"},{"surface":"ஆயின்","parts":[{"text":"ஆயின்","lemma":"ஆயின்","gloss":"if it is"}],"gloss":"if it is"}]},{"words":[{"surface":"வாராரோ","parts":[{"text":"வாரார்","lemma":"வருதல்","gloss":"they will not come"},{"text":"ஓ","lemma":"ஓ","gloss":"interrogative particle"}],"gloss":"will he not come?"},{"surface":"நம்","parts":[{"text":"நம்","lemma":"நம்","gloss":"our"}],"gloss":"our"},{"surface":"காதலோரே","parts":[{"text":"காதலோர்","lemma":"காதலர்","gloss":"lover"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"lover indeed"}]}],"literal":"To the cool drops suited green-creeper jasmine / bud-tips opened fragrance upon the shrubs / flower-abundant wild jasmine with sweet-smelling to crowd / unseasonably rains indeed the rain, it is not unseasonable / the rainy season this season if it is / will he not come, our lover?","translation":"The rain pours down, seemingly out of season, making the green-creeper jasmine that welcomes the cool drops open its buds, spreading fragrance over the bushes, while the flower-rich wild jasmine crowds together, smelling sweet. But if this is indeed the true rainy season, and not an unseasonable one, would our lover not have returned?","modern":"குளிர்ந்த மழைத்துளிகளை ஏற்றுக்கொண்ட பசுமையான முல்லைக் கொடியின் அரும்புகள் மலர்ந்து, புதர்களின் மேல் நறுமணத்தைப் பரப்புகின்றன. பூக்கள் நிறைந்த காட்டு மல்லிகையோடு சேர்ந்து இனிமையான மணம் கமழுமாறு நெருங்கி வளர்கின்றன. மழை இப்போது பெய்கிறது. இது பருவம் அல்லாத மழை என்கிறார்கள்; ஆனால், இதுவே உண்மையான கார்காலம் என்றால், நம் காதலர் திரும்பி வந்திருக்க மாட்டாரா?","explanation":"This poem is set in the Mullai (forest) landscape, which is associated with the rainy season and the patient waiting of the heroine. The heroine is distressed because the rains have started, signaling the arrival of the season when the hero promised to return, but he has not yet arrived. The foster-mother or others might console her by saying this is just an unseasonable, passing rain ('vampu'). However, the friend (tōḻi) speaks to comfort the heroine or to express her own anxiety, pointing out the blooming of the mullai and talavam jasmines. She reasons: if this were truly the rainy season, the hero, who loves her so dearly, would definitely have returned. By calling the rain 'unseasonable' (vampu), she tries to ease the heroine's grief, suggesting that the actual season of his return has not yet commenced.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.62],[0.62,0.9],[0.9,1.4],[1.4,1.89],[1.89,2.7],[2.7,3.2],[3.2,3.6],[3.6,4.1],[4.1,4.35],[4.35,4.77],[4.77,4.93],[4.93,5.1],[5.1,5.97],[5.97,7.05],[7.05,7.7],[7.8,8.2],[8.2,9.3],[9.3,9.7],[9.7,9.9],[9.9,10.63],[10.63,11.2],[11.2,11.41],[11.41,11.7]],"female":[[0.0,0.62],[0.62,0.9],[0.9,1.5],[1.5,1.7],[1.7,3.1],[3.1,3.6],[3.6,4.1],[4.1,4.7],[4.7,5.14],[5.14,5.87],[5.87,6.43],[6.43,7.0],[7.0,7.8],[7.8,8.8],[8.8,9.33],[9.33,10.21],[10.21,10.74],[10.74,11.45],[11.45,11.98],[11.98,12.33],[12.33,13.1],[13.1,13.4],[13.4,13.8]]},"sync":[[["தண்துளிக்கு","to the cool drops"]],[["தண்துளிக்கு","to the cool drops"],["ஏற்ற","suited"]],[["பைங்கொடி","green creeper"]],[["முல்லை","jasmine"]],[["முகைதலை","tip of the bud"]],[["திறந்த","which opened"]],[["நாற்றம்","fragrance"]],[["புதல்மிசை","upon the shrub"]],[["பூமலி","flower-abundant"]],[["தளவமொடு","with wild jasmine"]],[["தேங்கமழ்பு","sweet-smelling"]],[["கஞல","to crowd"]],[["வம்பு","unseasonably"]],[["பெய்யுமால்","it rains indeed"]],[["மழையே","the rain indeed"]],[["வம்பன்று","it is not unseasonable"]],[["காரிது","this is the rainy season"]],[["பருவம்","season"]],[["ஆயின்","if it is"]],[["வாராரோ","will he not come?"]],[["வாராரோ","will he not come?"],["நம்","our"]],[["காதலோரே","lover indeed"]],[["காதலோரே","lover indeed"]]]}