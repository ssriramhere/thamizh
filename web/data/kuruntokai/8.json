{"text":"kuruntokai","n":8,"lines":["கழனி மாஅத்து விளைந்துகு தீம்பழம்","பழன வாளை கதூஉ மூரன்","எம்மிற் பெருமொழி கூறித் தம்மிற்","கையும் காலும் தூக்கத் தூக்கும்","ஆடிப் பாவை போல","மேவன செய்யுந்தன் புதல்வன் தாய்க்கே"],"tr":["kaḻaṉi māattu viḷaintuku tīmpaḻam","paḻaṉa vāḷai katūu mūraṉ","emmiṟ perumoḻi kūṟit tammiṟ","kaiyum kālum tūkkat tūkkum","āṭip pāvai pōla","mēvaṉa ceyyuntaṉ putalvaṉ tāykkē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"காதற் பரத்தை கூற்று","poet_ta":"ஆலங்குடி வங்கனார்","speaker_en":null,"poet_tr":"Ālaṅkuṭi Vaṅkaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 5, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கழனி","tr":"kaḻaṉi","foot":"puḷimā","acai":[{"kind":"nirai","text":"கழ","tr":"kaḻa"},{"kind":"nēr","text":"னி","tr":"ṉi"}]},{"text":"மாஅத்து","tr":"māattu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"அத்","tr":"at"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"விளைந்துகு","tr":"viḷaintuku","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விளைந்","tr":"viḷain"},{"kind":"nirai","text":"துகு","tr":"tuku"}]},{"text":"தீம்பழம்","tr":"tīmpaḻam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தீம்","tr":"tīm"},{"kind":"nirai","text":"பழம்","tr":"paḻam"}]}],[{"text":"பழன","tr":"paḻaṉa","foot":"puḷimā","acai":[{"kind":"nirai","text":"பழ","tr":"paḻa"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"வாளை","tr":"vāḷai","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ளை","tr":"ḷai"}]},{"text":"கதூஉ","tr":"katūu","foot":"puḷimā","acai":[{"kind":"nirai","text":"கதூ","tr":"katū"},{"kind":"nēr","text":"உ","tr":"u"}]},{"text":"மூரன்","tr":"mūraṉ","foot":"tēmā","acai":[{"kin