{"text":"kuruntokai","n":28,"lines":["மூட்டு வேன்கொல் தாக்கு வேன்கொல்","ஓரேன் யானுமோர் பெற்றி மேலிட்டு","ஆஅ ஒல்லெனக் கூவு வேன்கொல்","அலமரல் அசைவளி அலைப்பவென்","உயவுநோ யறியாது துஞ்சும் ஊர்க்கே"],"tr":["mūṭṭu vēṉkol tākku vēṉkol","ōrēṉ yāṉumōr peṟṟi mēliṭṭu","āa olleṉak kūvu vēṉkol","alamaral acaivaḷi alaippaveṉ","uyavunō yaṟiyātu tuñcum ūrkkē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"ஔவையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 5"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மூட்டு","tr":"mūṭṭu","foot":"tēmā","acai":[{"kind":"nēr","text":"மூட்","tr":"mūṭ"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"வேன்கொல்","tr":"vēṉkol","foot":"tēmā","acai":[{"kind":"nēr","text":"வேன்","tr":"vēṉ"},{"kind":"nēr","text":"கொல்","tr":"kol"}]},{"text":"தாக்கு","tr":"tākku","foot":"tēmā","acai":[{"kind":"nēr","text":"தாக்","tr":"tāk"},{"kind":"nēr","text":"கு","tr":"ku"}]},{"text":"வேன்கொல்","tr":"vēṉkol","foot":"tēmā","acai":[{"kind":"nēr","text":"வேன்","tr":"vēṉ"},{"kind":"nēr","text":"கொல்","tr":"kol"}]}],[{"text":"ஓரேன்","tr":"ōrēṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"ஓ","tr":"ō"},{"kind":"nēr","text":"ரேன்","tr":"rēṉ"}]},{"text":"யானுமோர்","tr":"yāṉumōr","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nirai","text":"னுமோர்","tr":"ṉumōr"}]},{"text":"பெற்றி","tr":"peṟṟi","foot":"tēmā","acai":[{"kind":"nēr","text":"பெற்","tr":"peṟ"},{"kind":"nēr","text":"றி","tr":"ṟi"}]},{"text":"மேலிட்டு","tr":"mēliṭṭu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"மே","tr":"mē"},{"kind":"nēr","text":"லிட்","tr":"liṭ"},{"kind":"nēr","text":"டு","tr":"ṭu"}]}],[{"text":"ஆஅ","