{"text":"kuruntokai","n":191,"lines":["உதுக்கா ணதுவே யிதுவென் மொழிகோ","நோன்சினை யிருந்த இருந்தோட்டுப் புள்ளினம்","தாம்புணர்ந் தமையிற் பிரிந்தோ ருள்ளத்","தீங்குரல் அகவக் கேட்டு நீங்கிய","ஏதி லாள ரிவண்வரிற் போதிற்","பொம்ம லோதியும் புனையல்","எம்முந் தொடாஅ லென்குவே மன்னே"],"tr":["utukkā ṇatuvē yituveṉ moḻikō","nōṉciṉai yirunta iruntōṭṭup puḷḷiṉam","tāmpuṇarn tamaiyiṟ pirintō ruḷḷat","tīṅkural akavak kēṭṭu nīṅkiya","ēti lāḷa rivaṇvariṟ pōtiṟ","pomma lōtiyum puṉaiyal","emmun toṭāa leṉkuvē maṉṉē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","speaker_en":"the heroine (talaivi)"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 12"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"உதுக்கா","tr":"utukkā","foot":"puḷimā","acai":[{"kind":"nirai","text":"உதுக்","tr":"utuk"},{"kind":"nēr","text":"கா","tr":"kā"}]},{"text":"ணதுவே","tr":"ṇatuvē","foot":"puḷimā","acai":[{"kind":"nirai","text":"ணது","tr":"ṇatu"},{"kind":"nēr","text":"வே","tr":"vē"}]},{"text":"யிதுவென்","tr":"yituveṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"யிது","tr":"yitu"},{"kind":"nēr","text":"வென்","tr":"veṉ"}]},{"text":"மொழிகோ","tr":"moḻikō","foot":"puḷimā","acai":[{"kind":"nirai","text":"மொழி","tr":"moḻi"},{"kind":"nēr","text":"கோ","tr":"kō"}]}],[{"text":"நோன்சினை","tr":"nōṉciṉai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நோன்","tr":"nōṉ"},{"kind":"nirai","text":"சினை","tr":"ciṉai"}]},{"text":"யிருந்த","tr":"yirunta","foot":"puḷimā","acai":[{"kind":"nirai","text":"யிருந்","tr":"yirun"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"இருந்தோட்டுப்","tr":"iruntōṭṭup","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"இருந்","tr":"irun"},{"kind":"nēr","text":"தோட்","tr":"tōṭ"},{"kind":"nēr","text":"