{"text":"kuruntokai","n":396,"lines":["பாலும் உண்ணாள் பந்துடன் மேவாள்","விளையாடு ஆயமொடு அயர்வோ ளினியே","எளிதென உணர்ந்தனள் கொல்லோ முளிசினை","ஓமை குத்திய உயர்கோட் டொருத்தல்","வேனிற் குன்றத்து வெவ்வரைக் கவாஅன்","மழைமுழங்கு கடுங்குரல் ஓர்க்கும்","கழைதிரங் காரிடை அவனொடு செலவே"],"tr":["pālum uṇṇāḷ pantuṭaṉ mēvāḷ","viḷaiyāṭu āyamoṭu ayarvō ḷiṉiyē","eḷiteṉa uṇarntaṉaḷ kollō muḷiciṉai","ōmai kuttiya uyarkōṭ ṭoruttal","vēṉiṟ kuṉṟattu vevvaraik kavāaṉ","maḻaimuḻaṅku kaṭuṅkural ōrkkum","kaḻaitiraṅ kāriṭai avaṉoṭu celavē"],"colophon":{"tinai":"பாால","tinai_ta":"பாால","speaker_ta":"செவிலி கூற்று","poet_ta":"கமயனார்","speaker_en":"the foster-mother (cevili)","poet_tr":"Kamayaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 14, āciriyattaḷai 10, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பாலும்","tr":"pālum","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"லும்","tr":"lum"}]},{"text":"உண்ணாள்","tr":"uṇṇāḷ","foot":"tēmā","acai":[{"kind":"nēr","text":"உண்","tr":"uṇ"},{"kind":"nēr","text":"ணாள்","tr":"ṇāḷ"}]},{"text":"பந்துடன்","tr":"pantuṭaṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பந்","tr":"pan"},{"kind":"nirai","text":"துடன்","tr":"tuṭaṉ"}]},{"text":"மேவாள்","tr":"mēvāḷ","foot":"tēmā","acai":[{"kind":"nēr","text":"மே","tr":"mē"},{"kind":"nēr","text":"வாள்","tr":"vāḷ"}]}],[{"text":"விளையாடு","tr":"viḷaiyāṭu","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"விளை","tr":"viḷai"},{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"ஆயமொடு","tr":"āyamoṭu","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nirai","text":"யமொ","tr":"yamo"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"அயர்வோ","tr":"ayarvō","foot":