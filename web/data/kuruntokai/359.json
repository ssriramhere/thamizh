{"text":"kuruntokai","n":359,"lines":["கண்டிசிற் பாண பண்புடைத் தம்ம","மாலை விரிந்த பசுவெண் ணிலவிற்","குறுங்கால் கட்டில் நறும்பூஞ் சேக்கைப்","பள்ளி யானையின் உயிர்த்தனன் நசையிற்","புதல்வற் றழீஇயினன் விறலவன்","புதல்வன் தாயவன் புறங்கவைஇ யினளே"],"tr":["kaṇṭiciṟ pāṇa paṇpuṭait tamma","mālai virinta pacuveṇ ṇilaviṟ","kuṟuṅkāl kaṭṭil naṟumpūñ cēkkaip","paḷḷi yāṉaiyiṉ uyirttaṉaṉ nacaiyiṟ","putalvaṟ ṟaḻīiyiṉaṉ viṟalavaṉ","putalvaṉ tāyavaṉ puṟaṅkavaii yiṉaḷē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தோழி கூற்று","poet_ta":"பேயனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Pēyaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 20, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 9, kalittaḷai 3"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கண்டிசிற்","tr":"kaṇṭiciṟ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கண்","tr":"kaṇ"},{"kind":"nirai","text":"டிசிற்","tr":"ṭiciṟ"}]},{"text":"பாண","tr":"pāṇa","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"ண","tr":"ṇa"}]},{"text":"பண்புடைத்","tr":"paṇpuṭait","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பண்","tr":"paṇ"},{"kind":"nirai","text":"புடைத்","tr":"puṭait"}]},{"text":"தம்ம","tr":"tamma","foot":"tēmā","acai":[{"kind":"nēr","text":"தம்","tr":"tam"},{"kind":"nēr","text":"ம","tr":"ma"}]}],[{"text":"மாலை","tr":"mālai","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"விரிந்த","tr":"virinta","foot":"puḷimā","acai":[{"kind":"nirai","text":"விரிந்","tr":"virin"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"பசுவெண்","tr":"pacuveṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பசு","tr":"pacu"},{"kind":"nēr","text":"வெண்","tr":"veṇ"}]},{"text":"ணிலவிற்","tr":"ṇilaviṟ","foot":"puḷimā","aca