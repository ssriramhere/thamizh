},{"kind":"nirai","text":"யவன்","tr":"yavaṉ"}]},{"text":"புறங்கவைஇ","tr":"puṟaṅkavaii","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"புறங்","tr":"puṟaṅ"},{"kind":"nirai","text":"கவை","tr":"kavai"},{"kind":"nēr","text":"இ","tr":"i"}]},{"text":"யினளே","tr":"yiṉaḷē","foot":"puḷimā","acai":[{"kind":"nirai","text":"யின","tr":"yiṉa"},{"kind":"nēr","text":"ளே","tr":"ḷē"}]}]]},"ai":{"lines":[{"words":[{"surface":"கண்டிசின்","parts":[{"text":"கண்","lemma":"காண்","gloss":"see"},{"text":"திசின்","lemma":"திசின்","gloss":"particle of imperative force"}],"gloss":"look!"},{"surface":"பாண","parts":[{"text":"பாண","lemma":"பாணன்","gloss":"O bard (vocative)"}],"gloss":"O bard!"},{"surface":"பண்புடைத்து","parts":[{"text":"பண்பு","lemma":"பண்பு","gloss":"good character"},{"text":"உடைத்து","lemma":"உடைத்து","gloss":"it has"}],"gloss":"it is noble/virtuous"},{"surface":"அம்ம","parts":[{"text":"அம்ம","lemma":"அம்ம","gloss":"excl. particle"}],"gloss":"indeed"}]},{"words":[{"surface":"மாலை","parts":[{"text":"மாலை","lemma":"மாலை","gloss":"evening"}],"gloss":"evening"},{"surface":"விரிந்த","parts":[{"text":"விரி","lemma":"விரி","gloss":"spread"},{"text":"ந்த","lemma":"அ","gloss":"adjectival suffix"}],"gloss":"spread"},{"surface":"பசுவெண்","parts":[{"text":"பசுவெண்","lemma":"பசுவெண்","gloss":"fresh white"}],"gloss":"fresh white","split_unverified":true},{"surface":"நிலவில்","parts":[{"text":"நிலவு","lemma":"நிலவு","gloss":"moonlight"},{"text":"இல்","lemma":"இல்","gloss":"locative suffix"}],"gloss":"in the moonlight"}]},{"words":[{"surface":"குறுங்கால்","parts":[{"text":"குறுங்கால்","lemma":"குறுங்கால்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"கட்டில்","parts":[{"text":"கட்டில்","lemma":"கட்டில்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"நறும்பூஞ்","parts":[{"text":"நறும்பூஞ்","lemma":"நறும்பூஞ்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"சேக்கைப்","parts":[{"text":"சேக்கைப்","lemma":"சேக்கைப்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"பள்ளி","parts":[{"text":"பள்ளி","lemma":"பள்ளி","gloss":"sleeping"}],"gloss":"sleeping"},{"surface":"யானையின்","parts":[{"text":"யானை","lemma":"யானை","gloss":"elephant"},{"text":"இன்","lemma":"இன்","gloss":"like"}],"gloss":"like an elephant"},{"surface":"உயிர்த்தனன்","parts":[{"text":"உயிர்த்து","lemma":"உயிர்த்தல்","gloss":"sigh"},{"text":"அனன்","lemma":"அன்","gloss":"he (pronominal suffix)"}],"gloss":"he sighed"},{"surface":"நசையில்","parts":[{"text":"நசை","lemma":"நசை","gloss":"desire/love"},{"text":"இல்","lemma":"இல்","gloss":"with"}],"gloss":"with desire"}]},{"words":[{"surface":"புதல்வற்","parts":[{"text":"புதல்வற்","lemma":"புதல்வற்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"றழீஇயினன்","parts":[{"text":"றழீஇயினன்","lemma":"றழீஇயினன்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"விறலவன்","parts":[{"text":"விறலவன்","lemma":"விறலவன்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"புதல்வன்","parts":[{"text":"புதல்வன்","lemma":"புதல்வன்","gloss":"son"}],"gloss":"son's"},{"surface":"தாய்","parts":[{"text":"தாய்","lemma":"தாய்","gloss":"mother"}],"gloss":"mother"},{"surface":"அவன்","parts":[{"text":"அவன்","lemma":"அவன்","gloss":"his"}],"gloss":"his"},{"surface":"புறம்","parts":[{"text":"புறம்","lemma":"புறம்","gloss":"back"}],"gloss":"back"},{"surface":"கவைஇயினளே","parts":[{"text":"கவை","lemma":"கவைத்தல்","gloss":"embrace"},{"text":"இயினள்","lemma":"இனள்","gloss":"she did (past)"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"she embraced indeed"}]}],"literal":"Look, O bard! It is of noble character indeed! / In the fresh white moonlight spread in the evening, / on the bed of fragrant flowers on the short-legged cot, / like a sleeping elephant, he sighed, and with desire, / the victorious hero embraced his son; / the mother of the son embraced his back indeed.","translation":"\"Look, O bard! How noble it is! In the fresh white moonlight that spreads in the evening, on a short-legged cot strewn with fragrant flowers, the victorious hero, sighing like a sleeping elephant, embraced his son with deep love. And the mother of his son, in turn, embraced him from behind.\"","modern":"பாணனே, பார்! இது எவ்வளவு பண்பான செயல்! மாலை நேரத்தில் பரவிய புதிய வெண்மையான நிலவொளியில், குட்டையான கால்களைக் கொண்ட கட்டிலில் பரப்பப்பட்ட நறுமணமிக்க மலர்ப்படுக்கையில், உறங்கும் யானையைப் போலப் பெருமூச்சு விட்டபடி, தன் மகன் மீது கொண்ட அன்பினால் அந்த வெற்றியாளன் தன் மகனைத் தழுவிக்கொண்டான். உடனே, அச்சிறுவனின் தாயான தலைவி, அவனது முதுகைக் கட்டியணைத்துக் கொண்டாள்.","explanation":"This poem is set in the Marutam (agricultural) landscape, which deals with infidelity and reconciliation. The speaker is the heroine's friend (tōḻi), addressing the bard (pāṇan) who has come as a messenger from the hero. She describes a beautiful domestic scene that occurred in the evening under the soft moonlight. The hero, returning home, lovingly embraced his sleeping son on their flower-strewn bed, sighing deeply like a resting elephant. Seeing this display of paternal love, the heroine forgot her anger over his trysts with courtesans and embraced him from behind. By sharing this, the friend indicates to the bard that the heroine has forgiven the hero, and he is welcome to return.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.83],[0.83,0.94],[1.0,1.39],[1.39,1.44],[1.5,2.3],[2.3,2.6],[2.6,3.1],[3.1,3.1],[3.1,4.5],[4.5,4.7],[4.7,5.2],[5.2,5.5],[5.5,6.17],[6.17,6.7],[6.7,7.67],[7.67,7.76],[7.76,8.01],[8.01,8.01],[8.01,8.1],[8.1,9.6],[9.6,11.13],[11.13,11.13],[11.13,11.9]],"female":[[0.0,0.84],[0.84,1.08],[1.2,1.78],[1.78,2.02],[2.1,3.0],[3.0,3.4],[3.4,3.9],[3.9,3.9],[3.9,5.0],[5.0,5.2],[5.2,5.8],[5.8,6.1],[6.1,7.04],[7.04,7.8],[7.8,8.2],[8.2,8.56],[8.56,8.8],[8.8,9.28],[9.28,10.7],[10.7,11.6],[11.6,12.4],[12.4,12.84],[12.84,13.4]]}}