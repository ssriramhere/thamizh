{"text":"kuruntokai","n":19,"lines":["எவ்வி இழந்த வறுமையாழ்ப் பாணர்","பூவில் வறுந்தலை போலப் புல்லென்","றினைமதி வாழியர் நெஞ்சே மனைமரத்","தெல்லுறு மௌவல் நாறும்","பல்லிருங் கூந்தல் யாரளோ நமக்கே"],"tr":["evvi iḻanta vaṟumaiyāḻp pāṇar","pūvil vaṟuntalai pōlap pulleṉ","ṟiṉaimati vāḻiyar neñcē maṉaimarat","telluṟu mauval nāṟum","palliruṅ kūntal yāraḷō namakkē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தலைவன் கூற்று","poet_ta":"பரணர்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Paraṇar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 12, āciriyattaḷai 6"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"எவ்வி","tr":"evvi","foot":"tēmā","acai":[{"kind":"nēr","text":"எவ்","tr":"ev"},{"kind":"nēr","text":"வி","tr":"vi"}]},{"text":"இழந்த","tr":"iḻanta","foot":"puḷimā","acai":[{"kind":"nirai","text":"இழந்","tr":"iḻan"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"வறுமையாழ்ப்","tr":"vaṟumaiyāḻp","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"வறு","tr":"vaṟu"},{"kind":"nēr","text":"மை","tr":"mai"},{"kind":"nēr","text":"யாழ்ப்","tr":"yāḻp"}]},{"text":"பாணர்","tr":"pāṇar","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"ணர்","tr":"ṇar"}]}],[{"text":"பூவில்","tr":"pūvil","foot":"tēmā","acai":[{"kind":"nēr","text":"பூ","tr":"pū"},{"kind":"nēr","text":"வில்","tr":"vil"}]},{"text":"வறுந்தலை","tr":"vaṟuntalai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வறுந்","tr":"vaṟun"},{"kind":"nirai","text":"தலை","tr":"talai"}]},{"text":"போலப்","tr":"pōlap","foot":"tēmā","acai":[{"kind":"nēr","text":"போ","tr":"pō"},{"kind":"nēr","text":"லப்","tr":"lap"}]},{"text":"புல்லென்","tr":"pulleṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"புல்","tr":"pul"},{"kind":"nēr","text":"லென