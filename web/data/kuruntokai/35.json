{"text":"kuruntokai","n":35,"lines":["நாணில மன்றவெங் கண்ணே நாணேர்பு","சினைப்பசும் பாம்பின் சூன்முதிர்ப் பன்ன","கனைத்த கரும்பின் கூம்புபொதி யவிழ","நுண்ணுறை யழிதுளி தலைஇய","தண்வரல் வாடையும் பிரிந்திசினோர்க் கழலே"],"tr":["nāṇila maṉṟaveṅ kaṇṇē nāṇērpu","ciṉaippacum pāmpiṉ cūṉmutirp paṉṉa","kaṉaitta karumpiṉ kūmpupoti yaviḻa","nuṇṇuṟai yaḻituḷi talaiiya","taṇvaral vāṭaiyum pirinticiṉōrk kaḻalē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தலைவி கூற்று","poet_ta":"கழார்க்கீரனெயிற்றி","speaker_en":"the heroine (talaivi)","poet_tr":"Kaḻārkkīraṉeyiṟṟi"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 15, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 8, āciriyattaḷai 6, kalittaḷai 4"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நாணில","tr":"nāṇila","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nirai","text":"ணில","tr":"ṇila"}]},{"text":"மன்றவெங்","tr":"maṉṟaveṅ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மன்","tr":"maṉ"},{"kind":"nirai","text":"றவெங்","tr":"ṟaveṅ"}]},{"text":"கண்ணே","tr":"kaṇṇē","foot":"tēmā","acai":[{"kind":"nēr","text":"கண்","tr":"kaṇ"},{"kind":"nēr","text":"ணே","tr":"ṇē"}]},{"text":"நாணேர்பு","tr":"nāṇērpu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"ணேர்","tr":"ṇēr"},{"kind":"nēr","text":"பு","tr":"pu"}]}],[{"text":"சினைப்பசும்","tr":"ciṉaippacum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சினைப்","tr":"ciṉaip"},{"kind":"nirai","text":"பசும்","tr":"pacum"}]},{"text":"பாம்பின்","tr":"pāmpiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"பாம்","tr":"pām"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]},{"text":"சூன்முதிர்ப்","tr":"cūṉmutirp","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சூன்","tr":"cūṉ"},{"kind":"nirai","text":"முதிர்ப்","tr":"mutirp"}]},{"