{"text":"kuruntokai","n":238,"lines":["பாசவ லிடித்த கருங்கா ழுலக்கை","ஆய்கதிர் நெல்லின் வரம்பணைத் துயிற்றி","ஒண்டொடி மகளிர் வண்ட லயரும்","தொண்டி யன்னவென் நலந்தந்து","கொண்டனை சென்மோ மகிழ்நநின் சூளே"],"tr":["pācava liṭitta karuṅkā ḻulakkai","āykatir nelliṉ varampaṇait tuyiṟṟi","oṇṭoṭi makaḷir vaṇṭa layarum","toṇṭi yaṉṉaveṉ nalantantu","koṇṭaṉai ceṉmō makiḻnaniṉ cūḷē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தோழி கூற்று","poet_ta":"குன்றியனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kuṉṟiyaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 9, veṇṭaḷai 9"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பாசவ","tr":"pācava","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nirai","text":"சவ","tr":"cava"}]},{"text":"லிடித்த","tr":"liṭitta","foot":"puḷimā","acai":[{"kind":"nirai","text":"லிடித்","tr":"liṭit"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"கருங்கா","tr":"karuṅkā","foot":"puḷimā","acai":[{"kind":"nirai","text":"கருங்","tr":"karuṅ"},{"kind":"nēr","text":"கா","tr":"kā"}]},{"text":"ழுலக்கை","tr":"ḻulakkai","foot":"puḷimā","acai":[{"kind":"nirai","text":"ழுலக்","tr":"ḻulak"},{"kind":"nēr","text":"கை","tr":"kai"}]}],[{"text":"ஆய்கதிர்","tr":"āykatir","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஆய்","tr":"āy"},{"kind":"nirai","text":"கதிர்","tr":"katir"}]},{"text":"நெல்லின்","tr":"nelliṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"நெல்","tr":"nel"},{"kind":"nēr","text":"லின்","tr":"liṉ"}]},{"text":"வரம்பணைத்","tr":"varampaṇait","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வரம்","tr":"varam"},{"kind":"nirai","text":"பணைத்","tr":"paṇait"}]},{"text":"துயிற்றி","tr":"tuyiṟṟi","foot":"puḷimā","acai":[{"kind":"nirai","text":"துயிற்","tr":"tuyiṟ"},{