{"text":"kuruntokai","n":67,"lines":["உள்ளார் கொல்லோ தோழி கிள்ளை","வளைவாய்க் கொண்ட வேப்ப ஒண்பழம்","புதுநாண் நுழைப்பான் நுதிமாண் வள்ளுகிர்ப்","பொலங்கல ஒருகா சேய்க்கும்","நிலங்கரி கள்ளியங் காடிறந் தோரே"],"tr":["uḷḷār kollō tōḻi kiḷḷai","vaḷaivāyk koṇṭa vēppa oṇpaḻam","putunāṇ nuḻaippāṉ nutimāṇ vaḷḷukirp","polaṅkala orukā cēykkum","nilaṅkari kaḷḷiyaṅ kāṭiṟan tōrē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"அள்ளூர் நன்முல்லையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Aḷḷūr Naṉmullaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 7"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"உள்ளார்","tr":"uḷḷār","foot":"tēmā","acai":[{"kind":"nēr","text":"உள்","tr":"uḷ"},{"kind":"nēr","text":"ளார்","tr":"ḷār"}]},{"text":"கொல்லோ","tr":"kollō","foot":"tēmā","acai":[{"kind":"nēr","text":"கொல்","tr":"kol"},{"kind":"nēr","text":"லோ","tr":"lō"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"கிள்ளை","tr":"kiḷḷai","foot":"tēmā","acai":[{"kind":"nēr","text":"கிள்","tr":"kiḷ"},{"kind":"nēr","text":"ளை","tr":"ḷai"}]}],[{"text":"வளைவாய்க்","tr":"vaḷaivāyk","foot":"puḷimā","acai":[{"kind":"nirai","text":"வளை","tr":"vaḷai"},{"kind":"nēr","text":"வாய்க்","tr":"vāyk"}]},{"text":"கொண்ட","tr":"koṇṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"கொண்","tr":"koṇ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"வேப்ப","tr":"vēppa","foot":"tēmā","acai":[{"kind":"nēr","text":"வேப்","tr":"vēp"},{"kind":"nēr","text":"ப","tr":"pa"}]},{"text":"ஒண்பழம்","tr":"oṇpaḻam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஒண்","tr":"oṇ"},{"kind":"nirai","text":"பழம்","tr":"paḻam"}]}],[{"text":"புதுநாண்","tr":