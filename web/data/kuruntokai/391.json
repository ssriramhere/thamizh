{"text":"kuruntokai","n":391,"lines":["உவரி யொருத்தல் உழாது மடியப்","புகரி புழுங்கிய புயனீங்கு புறவிற்","கடிதிடி உருமிற் பாம்புபை அவிய","இடியொடு மயங்கி இனிதுவீழ்ந் தன்றே","வீழ்ந்த மாமழை தழீஇப் பிரிந்தோர்","கையற வந்த பையுள் மாலைப்","பூஞ்சினை யிருந்த போழ்கண் மஞ்ஞை","தாஅம் நீர் நனந்தலை புலம்பக்","கூஉந் தோழி பெரும்பே தையவே"],"tr":["uvari yoruttal uḻātu maṭiyap","pukari puḻuṅkiya puyaṉīṅku puṟaviṟ","kaṭitiṭi urumiṟ pāmpupai aviya","iṭiyoṭu mayaṅki iṉituvīḻn taṉṟē","vīḻnta māmaḻai taḻīip pirintōr","kaiyaṟa vanta paiyuḷ mālaip","pūñciṉai yirunta pōḻkaṇ maññai","tāam nīr naṉantalai pulampak","kūun tōḻi perumpē taiyavē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"பொன்மணியார்","speaker_en":"the heroine (talaivi)","poet_tr":"Poṉmaṇiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"9×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 34, veṇcīr 1, other 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 21, veṇṭaḷai 12, kalittaḷai 1, ? 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"உவரி","tr":"uvari","foot":"puḷimā","acai":[{"kind":"nirai","text":"உவ","tr":"uva"},{"kind":"nēr","text":"ரி","tr":"ri"}]},{"text":"யொருத்தல்","tr":"yoruttal","foot":"puḷimā","acai":[{"kind":"nirai","text":"யொருத்","tr":"yorut"},{"kind":"nēr","text":"தல்","tr":"tal"}]},{"text":"உழாது","tr":"uḻātu","foot":"puḷimā","acai":[{"kind":"nirai","text":"உழா","tr":"uḻā"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"மடியப்","tr":"maṭiyap","foot":"puḷimā","acai":[{"kind":"nirai","text":"மடி","tr":"maṭi"},{"kind":"nēr","text":"யப்","tr":"yap"}]}],[{"text":"புகரி","tr":"pukari","foot":"puḷimā","acai":[{"kind":"nirai","text":"புக","tr":"puka"},{"kind":"nēr","text":"ரி","tr":"ri"}]},{"text":"புழுங்கிய","tr":"puḻuṅkiya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"புழுங்","tr":"puḻuṅ"},{"kind":"nirai","text":