{"text":"kuruntokai","n":357,"lines":["முனிபடர் உழந்த பாடில் உண்கண்","பனிகால் போழ்ந்து பணியெழில் ஞெகிழ்தோள்","மெல்லிய ஆகலின் மேவரத் திரண்டு","நல்ல என்னுஞ் சொல்லை மன்னிய","ஏனலஞ் சிறுதினை காக்குஞ் சேணோன்","ஞெகிழியிற் பெயர்ந்த நெடுநல் யானை","மின்படு சுடரொளி வெரூஉம்","வான்தோய் வெற்பன் மணவா ஊங்கே"],"tr":["muṉipaṭar uḻanta pāṭil uṇkaṇ","paṉikāl pōḻntu paṇiyeḻil ñekiḻtōḷ","melliya ākaliṉ mēvarat tiraṇṭu","nalla eṉṉuñ collai maṉṉiya","ēṉalañ ciṟutiṉai kākkuñ cēṇōṉ","ñekiḻiyiṟ peyarnta neṭunal yāṉai","miṉpaṭu cuṭaroḷi verūum","vāṉtōy veṟpaṉ maṇavā ūṅkē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"கபிலர்","speaker_en":"her friend (tōḻi)","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 31"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 21, veṇṭaḷai 9"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"முனிபடர்","tr":"muṉipaṭar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"முனி","tr":"muṉi"},{"kind":"nirai","text":"படர்","tr":"paṭar"}]},{"text":"உழந்த","tr":"uḻanta","foot":"puḷimā","acai":[{"kind":"nirai","text":"உழந்","tr":"uḻan"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"பாடில்","tr":"pāṭil","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"டில்","tr":"ṭil"}]},{"text":"உண்கண்","tr":"uṇkaṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"உண்","tr":"uṇ"},{"kind":"nēr","text":"கண்","tr":"kaṇ"}]}],[{"text":"பனிகால்","tr":"paṉikāl","foot":"puḷimā","acai":[{"kind":"nirai","text":"பனி","tr":"paṉi"},{"kind":"nēr","text":"கால்","tr":"kāl"}]},{"text":"போழ்ந்து","tr":"pōḻntu","foot":"tēmā","acai":[{"kind":"nēr","text":"போழ்ந்","tr":"pōḻn"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"பணியெழில்","tr":"paṇiyeḻil","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பணி","tr":"paṇi"},{"