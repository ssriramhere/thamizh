{"text":"kuruntokai","n":262,"lines":["ஊஉ ரலரெழச் சேரி கல்லென","ஆனா தலைக்கும் அறனி லன்னை","தானே இருக்க தன்மனை யானே","நெல்லி தின்ற முள்ளெயிறு தயங்க","உணலாய்ந் திசினா லவரொடு சேய்நாட்டு","விண்தொட நிவந்த விலங்குமலைக் கவாஅற்","கரும்புநடு பாத்தி யன்ன","பெருங்களிற் றடிவழி நிலைஇய நீரே"],"tr":["ūu ralareḻac cēri kalleṉa","āṉā talaikkum aṟaṉi laṉṉai","tāṉē irukka taṉmaṉai yāṉē","nelli tiṉṟa muḷḷeyiṟu tayaṅka","uṇalāyn ticiṉā lavaroṭu cēynāṭṭu","viṇtoṭa nivanta vilaṅkumalaik kavāaṟ","karumpunaṭu pātti yaṉṉa","peruṅkaḷiṟ ṟaṭivaḻi nilaiiya nīrē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"பாலைபாடிய பெருங்கடுங்கோ","speaker_en":"her friend (tōḻi)","poet_tr":"Pālaipāṭiya Peruṅkaṭuṅkō"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 17, āciriyattaḷai 11, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஊஉ","tr":"ūu","foot":"tēmā","acai":[{"kind":"nēr","text":"ஊ","tr":"ū"},{"kind":"nēr","text":"உ","tr":"u"}]},{"text":"ரலரெழச்","tr":"ralareḻac","foot":"karuviḷam","acai":[{"kind":"nirai","text":"ரல","tr":"rala"},{"kind":"nirai","text":"ரெழச்","tr":"reḻac"}]},{"text":"சேரி","tr":"cēri","foot":"tēmā","acai":[{"kind":"nēr","text":"சே","tr":"cē"},{"kind":"nēr","text":"ரி","tr":"ri"}]},{"text":"கல்லென","tr":"kalleṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கல்","tr":"kal"},{"kind":"nirai","text":"லென","tr":"leṉa"}]}],[{"text":"ஆனா","tr":"āṉā","foot":"tēmā","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nēr","text":"னா","tr":"ṉā"}]},{"text":"தலைக்கும்","tr":"talaikkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"தலைக்","tr":"talaik"},{"kind":"nēr","text":"கும்","tr":"kum"}]},{"text":"அறனி","tr":"aṟaṉi","foot":"puḷimā","acai":[{"kind":"nirai","text":"அற","tr":"aṟa"},