{"text":"kuruntokai","n":196,"lines":["வேம்பின் பைங்காயென் தோழி தரினே","தேம்பூங் கட்டி என்றனிர் இனியே","பாரி பறம்பிற் பனிச்சுனைத் தெண்ணீர்","தைஇத் திங்கள் தண்ணிய தரினும்","வெய்ய உவர்க்கும் என்றனிர்","ஐய அற்றால் அன்பின் பாலே"],"tr":["vēmpiṉ paiṅkāyeṉ tōḻi tariṉē","tēmpūṅ kaṭṭi eṉṟaṉir iṉiyē","pāri paṟampiṟ paṉiccuṉait teṇṇīr","taiit tiṅkaḷ taṇṇiya tariṉum","veyya uvarkkum eṉṟaṉir","aiya aṟṟāl aṉpiṉ pālē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தோழி கூற்று","poet_ta":"மிளைக் கந்தனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Miḷaik Kantaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 7"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வேம்பின்","tr":"vēmpiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"வேம்","tr":"vēm"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]},{"text":"பைங்காயென்","tr":"paiṅkāyeṉ","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"பைங்","tr":"paiṅ"},{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"யென்","tr":"yeṉ"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"தரினே","tr":"tariṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"தரி","tr":"tari"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}],[{"text":"தேம்பூங்","tr":"tēmpūṅ","foot":"tēmā","acai":[{"kind":"nēr","text":"தேம்","tr":"tēm"},{"kind":"nēr","text":"பூங்","tr":"pūṅ"}]},{"text":"கட்டி","tr":"kaṭṭi","foot":"tēmā","acai":[{"kind":"nēr","text":"கட்","tr":"kaṭ"},{"kind":"nēr","text":"டி","tr":"ṭi"}]},{"text":"என்றனிர்","tr":"eṉṟaṉir","foot":"kūviḷam","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nirai","text":"றனிர்","tr":"ṟaṉir"}]},{"text":"இனியே","tr":"iṉiyē","foot":"puḷimā","acai":[{"kind":"n