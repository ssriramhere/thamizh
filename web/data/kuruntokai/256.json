{"text":"kuruntokai","n":256,"lines":["மணிவார்ந் தன்ன மாக்கொடி யறுகை","பிணிகான் மென்கொம்பு பிணையொடு மார்ந்த","மானே றுகளுங் கானம் பிற்பட","வினைநலம் படீஇ வருது மவ்வரைத்","தாங்கல் ஒல்லுமோ பூங்குழை யோயெனச்","சொல்லா முன்னர் நில்லா வாகி","நீர்விலங் கழுத லானா","தேர்விலங் கினவால் தெரிவை கண்ணே"],"tr":["maṇivārn taṉṉa mākkoṭi yaṟukai","piṇikāṉ meṉkompu piṇaiyoṭu mārnta","māṉē ṟukaḷuṅ kāṉam piṟpaṭa","viṉainalam paṭīi varutu mavvarait","tāṅkal ollumō pūṅkuḻai yōyeṉac","collā muṉṉar nillā vāki","nīrvilaṅ kaḻuta lāṉā","tērvilaṅ kiṉavāl terivai kaṇṇē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவன் கூற்று","speaker_en":"the hero (talaivaṉ)"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 20, veṇṭaḷai 9, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மணிவார்ந்","tr":"maṇivārn","foot":"puḷimā","acai":[{"kind":"nirai","text":"மணி","tr":"maṇi"},{"kind":"nēr","text":"வார்ந்","tr":"vārn"}]},{"text":"தன்ன","tr":"taṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"தன்","tr":"taṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"மாக்கொடி","tr":"mākkoṭi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மாக்","tr":"māk"},{"kind":"nirai","text":"கொடி","tr":"koṭi"}]},{"text":"யறுகை","tr":"yaṟukai","foot":"puḷimā","acai":[{"kind":"nirai","text":"யறு","tr":"yaṟu"},{"kind":"nēr","text":"கை","tr":"kai"}]}],[{"text":"பிணிகான்","tr":"piṇikāṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிணி","tr":"piṇi"},{"kind":"nēr","text":"கான்","tr":"kāṉ"}]},{"text":"மென்கொம்பு","tr":"meṉkompu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"மென்","tr":"meṉ"},{"kind":"nēr","text":"கொம்","tr":"kom"},{"kind":"nēr","text":"பு","tr":"pu"}]},{"text":"பிணையொடு","tr":"piṇaiyoṭu","foot":"karuviḷam","acai":[{"kind":"nirai","