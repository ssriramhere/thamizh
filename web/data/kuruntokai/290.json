{"text":"kuruntokai","n":290,"lines":["காமந் தாங்குமதி யென்போர் தாமஃ","தறியலர் கொல்லோ அனைமது கையர்கொல்","யாமெங் காதலர்க் காணே மாயிற்","செறிதுனி பெருகிய நெஞ்சமொடு பெருநீர்க்","கல்பொரு சிறுநுரை போல","மெல்ல மெல்ல இல்லா குதுமே"],"tr":["kāman tāṅkumati yeṉpōr tāmaḵ","taṟiyalar kollō aṉaimatu kaiyarkol","yāmeṅ kātalark kāṇē māyiṟ","ceṟituṉi perukiya neñcamoṭu perunīrk","kalporu ciṟunurai pōla","mella mella illā kutumē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"கல்பொரு சிறுநுரையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kalporu Ciṟunuraiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 20, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 11, āciriyattaḷai 10, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"காமந்","tr":"kāman","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"மந்","tr":"man"}]},{"text":"தாங்குமதி","tr":"tāṅkumati","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"தாங்","tr":"tāṅ"},{"kind":"nirai","text":"கும","tr":"kuma"},{"kind":"nēr","text":"தி","tr":"ti"}]},{"text":"யென்போர்","tr":"yeṉpōr","foot":"tēmā","acai":[{"kind":"nēr","text":"யென்","tr":"yeṉ"},{"kind":"nēr","text":"போர்","tr":"pōr"}]},{"text":"தாமஃ","tr":"tāmaḵ","foot":"tēmā","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"மஃ","tr":"maḵ"}]}],[{"text":"தறியலர்","tr":"taṟiyalar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தறி","tr":"taṟi"},{"kind":"nirai","text":"யலர்","tr":"yalar"}]},{"text":"கொல்லோ","tr":"kollō","foot":"tēmā","acai":[{"kind":"nēr","text":"கொல்","tr":"kol"},{"kind":"nēr","text":"லோ","tr":"lō"}]},{"text":"அனைமது","tr":"aṉaimatu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அனை","tr":"aṉai"},{"kind":"nirai","text":"மது","tr":"matu"}]},{"text":