text":"ல","tr":"la"}]},{"text":"இல்லா","tr":"illā","foot":"tēmā","acai":[{"kind":"nēr","text":"இல்","tr":"il"},{"kind":"nēr","text":"லா","tr":"lā"}]},{"text":"குதுமே","tr":"kutumē","foot":"puḷimā","acai":[{"kind":"nirai","text":"குது","tr":"kutu"},{"kind":"nēr","text":"மே","tr":"mē"}]}]]},"ai":{"lines":[{"words":[{"surface":"காமம்","parts":[{"text":"காமம்","lemma":"காமம்","gloss":"passion"}],"gloss":"passion"},{"surface":"தாங்குமதி","parts":[{"text":"தாங்கு","lemma":"தாங்கு","gloss":"bear"},{"text":"மதி","lemma":"மதி","gloss":"imperative suffix"}],"gloss":"do bear!"},{"surface":"என்போர்","parts":[{"text":"என்","lemma":"என்","gloss":"say"},{"text":"போர்","lemma":"போர்","gloss":"those who"}],"gloss":"those who say"},{"surface":"தாம்","parts":[{"text":"தாம்","lemma":"தாம்","gloss":"they"}],"gloss":"they themselves"},{"surface":"அஃ","parts":[{"text":"அஃ","lemma":"அஃது","gloss":"that"}],"gloss":"that (part 1)"}]},{"words":[{"surface":"தறியலர்","parts":[{"text":"தறியலர்","lemma":"தறியலர்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"கொல்லோ","parts":[{"text":"கொல்லோ","lemma":"கொல்லோ","gloss":""}],"gloss":"","split_unverified":true},{"surface":"அனைமது","parts":[{"text":"அனைமது","lemma":"அனைமது","gloss":""}],"gloss":"","split_unverified":true},{"surface":"கையர்கொல்","parts":[{"text":"கையர்கொல்","lemma":"கையர்கொல்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"யாம்","parts":[{"text":"யாம்","lemma":"யாம்","gloss":"we"}],"gloss":"we"},{"surface":"எம்","parts":[{"text":"எம்","lemma":"எம்","gloss":"our"}],"gloss":"our"},{"surface":"காதலர்","parts":[{"text":"காதல்","lemma":"காதல்","gloss":"love"},{"text":"அர்","lemma":"அர்","gloss":"he (honorific)"}],"gloss":"lover"},{"surface":"காணேம்","parts":[{"text":"காண்","lemma":"காண்","gloss":"see"},{"text":"ஏம்","lemma":"ஏம்","gloss":"we do not"}],"gloss":"we do not see"},{"surface":"ஆயின்","parts":[{"text":"ஆயின்","lemma":"ஆயின்","gloss":"if"}],"gloss":"if"}]},{"words":[{"surface":"செறி","parts":[{"text":"செறி","lemma":"செறி","gloss":"be dense"}],"gloss":"dense"},{"surface":"துனி","parts":[{"text":"துனி","lemma":"துனி","gloss":"grief"}],"gloss":"grief"},{"surface":"பெருகிய","parts":[{"text":"பெருகு","lemma":"பெருகு","gloss":"increase"},{"text":"இய","lemma":"இய","gloss":"adjectival participle suffix"}],"gloss":"increased"},{"surface":"நெஞ்சம்","parts":[{"text":"நெஞ்சம்","lemma":"நெஞ்சம்","gloss":"heart"}],"gloss":"heart"},{"surface":"ஒடு","parts":[{"text":"ஒடு","lemma":"ஒடு","gloss":"with"}],"gloss":"with"},{"surface":"பெரு","parts":[{"text":"பெரு","lemma":"பெரு","gloss":"great"}],"gloss":"great"},{"surface":"நீர்","parts":[{"text":"நீர்","lemma":"நீர்","gloss":"water"}],"gloss":"water"}]},{"words":[{"surface":"கல்","parts":[{"text":"கல்","lemma":"கல்","gloss":"rock"}],"gloss":"rock"},{"surface":"பொரு","parts":[{"text":"பொரு","lemma":"பொரு","gloss":"dash against"}],"gloss":"dashing against"},{"surface":"சிறு","parts":[{"text":"சிறு","lemma":"சிறு","gloss":"small"}],"gloss":"small"},{"surface":"நுரை","parts":[{"text":"நுரை","lemma":"நுரை","gloss":"foam"}],"gloss":"foam"},{"surface":"போல","parts":[{"text":"போல","lemma":"போல","gloss":"like"}],"gloss":"like"}]},{"words":[{"surface":"மெல்ல","parts":[{"text":"மெல்ல","lemma":"மெல்ல","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மெல்ல","parts":[{"text":"மெல்ல","lemma":"மெல்ல","gloss":""}],"gloss":"","split_unverified":true},{"surface":"இல்லா","parts":[{"text":"இல்லா","lemma":"இல்லா","gloss":""}],"gloss":"","split_unverified":true},{"surface":"குதுமே","parts":[{"text":"குதுமே","lemma":"குதுமே","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true}],"literal":"Those who say, 'Bear your love!' do they / not know that? Or do they possess such strength? / If we do not see our lover, / with a heart filled with dense grief, like the tiny foam / dashing against the rocks in the great ocean, / slowly, slowly, we will indeed cease to exist.","translation":"Those who tell me to bear my love—do they not know what it is like, or are they themselves possessed of such immense strength? If I do not see my lover, then with a heart swollen with dense grief, like the tiny foam that dashes against the rocks in the great ocean, slowly, slowly, I will cease to exist.","modern":"காதலைத் தாங்கிக் கொள் என்று சொல்பவர்கள், அதன் தன்மையை அறியாதவர்களோ? அல்லது அவ்வளவு வலிமை உடையவர்களோ? நம் காதலரைக் காணவில்லை என்றால், மிகுந்த துன்பம் பெருகிய நெஞ்சத்தோடு, பெரிய கடலின் பாறைகளில் மோதும் சிறு நுரையைப் போல, மெல்ல மெல்ல நாம் அழிந்து போவோம்.","explanation":"The heroine is speaking to her confidante in deep distress because her lover has been away for a long time. She questions the advice of onlookers who casually tell her to control her passion, wondering if they are completely ignorant of love's power or if they possess superhuman strength. She compares her fragile state to the tiny foam of the vast ocean that repeatedly dashes against hard rocks. This poignant image belongs to the Neytal (coastal) landscape, which represents the grief of waiting and separation. The key words are 'காமம்' (passion), 'சிறுநுரை' (tiny foam), and 'இல்லாகுதுமே' (we will cease to exist).","model":"gemini-3.5-flash"}}