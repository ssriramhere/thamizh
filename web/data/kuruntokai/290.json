text":"ல","tr":"la"}]},{"text":"இல்லா","tr":"illā","foot":"tēmā","acai":[{"kind":"nēr","text":"இல்","tr":"il"},{"kind":"nēr","text":"லா","tr":"lā"}]},{"text":"குதுமே","tr":"kutumē","foot":"puḷimā","acai":[{"kind":"nirai","text":"குது","tr":"kutu"},{"kind":"nēr","text":"மே","tr":"mē"}]}]]},"ai":{"lines":[{"words":[{"surface":"காமந்","parts":[{"text":"காமந்","lemma":"காமந்","gloss":"passion"}],"gloss":"passion","split_unverified":true},{"surface":"தாங்குமதி","parts":[{"text":"தாங்கு","lemma":"தாங்கு","gloss":"bear"},{"text":"மதி","lemma":"மதி","gloss":"exhortative particle"}],"gloss":"do bear!"},{"surface":"யென்போர்","parts":[{"text":"யென்போர்","lemma":"யென்போர்","gloss":"those who say"}],"gloss":"those who say","split_unverified":true},{"surface":"தாம்","parts":[{"text":"தாம்","lemma":"தாம்","gloss":"they"}],"gloss":"they themselves"},{"surface":"அஃ","parts":[{"text":"அஃ","lemma":"அஃ","gloss":"that"}],"gloss":"that","split_unverified":true}]},{"words":[{"surface":"தறியலர்","parts":[{"text":"தறியலர்","lemma":"தறியலர்","gloss":"they do not know that"}],"gloss":"they do not know that","split_unverified":true},{"surface":"கொல்லோ","parts":[{"text":"கொல்லோ","lemma":"கொல்லோ","gloss":"particle of wonder"}],"gloss":"I wonder?"},{"surface":"அனை","parts":[{"text":"அனை","lemma":"அனை","gloss":"such"}],"gloss":"such"},{"surface":"மது","parts":[{"text":"மது","lemma":"மது","gloss":"strength"}],"gloss":"strength","split_unverified":true},{"surface":"கையர்கொல்","parts":[{"text":"கை","lemma":"மதுகை","gloss":"strength"},{"text":"அர்","lemma":"அர்","gloss":"they (pronominal suffix)"},{"text":"கொல்","lemma":"கொல்","gloss":"particle of doubt"}],"gloss":"are they possessed of? (strength)"}]},{"words":[{"surface":"யாம்","parts":[{"text":"யாம்","lemma":"யாம்","gloss":"we"}],"gloss":"we"},{"surface":"மெங்","parts":[{"text":"மெங்","lemma":"மெங்","gloss":"our"}],"gloss":"our","split_unverified":true},{"surface":"காதலர்க்","parts":[{"text":"காதலர்க்","lemma":"காதலர்க்","gloss":"lover"}],"gloss":"lover","split_unverified":true},{"surface":"காணே","parts":[{"text":"காணே","lemma":"காணே","gloss":"we do not see"}],"gloss":"we do not see","split_unverified":true},{"surface":"மாயிற்","parts":[{"text":"மாயிற்","lemma":"மாயிற்","gloss":"if"}],"gloss":"if","split_unverified":true}]},{"words":[{"surface":"செறி","parts":[{"text":"செறி","lemma":"செறி","gloss":"dense"}],"gloss":"dense"},{"surface":"துனி","parts":[{"text":"துனி","lemma":"துனி","gloss":"distress"}],"gloss":"distress"},{"surface":"பெருகிய","parts":[{"text":"பெருகு","lemma":"பெருகு","gloss":"grow"},{"text":"இ","lemma":"இ","gloss":"past tense marker"},{"text":"அ","lemma":"அ","gloss":"adjectival participle suffix"}],"gloss":"which has increased"},{"surface":"நெஞ்சமொடு","parts":[{"text":"நெஞ்சம்","lemma":"நெஞ்சம்","gloss":"heart"},{"text":"ஒடு","lemma":"ஒடு","gloss":"with"}],"gloss":"with the heart"},{"surface":"பெருநீர்க்","parts":[{"text":"பெருநீர்க்","lemma":"பெருநீர்க்","gloss":"of the great water"}],"gloss":"of the great water","split_unverified":true}]},{"words":[{"surface":"கல்பொரு","parts":[{"text":"கல்","lemma":"கல்","gloss":"stone/rock"},{"text":"பொரு","lemma":"பொரு","gloss":"dash against"}],"gloss":"dashing against the rock"},{"surface":"சிறுநுரை","parts":[{"text":"சிறு","lemma":"சிறு","gloss":"small"},{"text":"நுரை","lemma":"நுரை","gloss":"foam"}],"gloss":"small foam"},{"surface":"போல","parts":[{"text":"போல","lemma":"போல","gloss":"like"}],"gloss":"like"}]},{"words":[{"surface":"மெல்ல","parts":[{"text":"மெல்ல","lemma":"மெல்ல","gloss":"slowly"}],"gloss":"slowly"},{"surface":"மெல்ல","parts":[{"text":"மெல்ல","lemma":"மெல்ல","gloss":"slowly"}],"gloss":"slowly"},{"surface":"இல்லா","parts":[{"text":"இல்","lemma":"இல்","gloss":"not"},{"text":"ஆ","lemma":"ஆகு","gloss":"become"}],"gloss":"not becoming"},{"surface":"குதுமே","parts":[{"text":"கு","lemma":"ஆகு","gloss":"become"},{"text":"தும்","lemma":"தும்","gloss":"first person plural future suffix"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis particle"}],"gloss":"we will indeed become"}]}],"literal":"Those who say 'bear the passion!', do they / not know that? I wonder, are they of such strength? / We, if we do not see our lover, / with a heart of dense distress increased, of the great water's / rock-dashing small foam like, / slowly, slowly, we will cease to exist.","translation":"Those who say, 'Bear your passion!'—do they not know what it is, or are they possessed of such great strength? If we do not see our lover, with a heart filled with growing distress, like the tiny foam beaten against the rocks by the great ocean, slowly, slowly, we will cease to exist.","modern":"காமத்தைத் தாங்கிக் கொள் என்று சொல்பவர்கள், அதை அறியாதவர்களோ? அல்லது அவ்வளவு வலிமை உடையவர்களோ? நாம் நம் காதலரைக் காணவில்லை என்றால், மிகுந்த துன்பம் பெருகிய நெஞ்சத்தோடு, பெரிய கடலின் பாறையில் மோதும் சிறு நுரையைப் போல, மெல்ல மெல்ல இல்லாமல் போய்விடுவோம்.","explanation":"The heroine is speaking to her confidante (or to herself) in deep distress during the hero's absence. She questions the advice of onlookers who casually tell her to control and endure her passion, wondering if they lack understanding or possess superhuman strength. She describes her fragile state of mind, filled with growing grief because she cannot see her lover. She compares her life to the tiny foam created when waves crash against the rocks of the vast ocean. Just as that delicate foam is slowly and inevitably dissolved by the relentless waves, her existence is gradually fading away. This poignant image of the seashore (Neytal tiṇai) perfectly captures the themes of separation, despair, and the fragility of life.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,1.1],[1.17,1.6],[1.6,1.75],[2.0,2.2],[2.2,2.6],[3.0,3.6],[3.6,4.2],[4.2,5.1],[5.1,5.7],[5.7,6.0],[6.0,6.51],[6.51,7.2],[7.3,7.9],[7.9,8.4],[8.4,8.9],[8.9,9.5],[9.5,9.9],[9.9,10.3],[10.3,11.1],[11.1,11.4],[11.51,11.97],[11.97,12.2]],"female":[[0.0,0.6],[0.6,1.2],[1.3,1.9],[1.9,2.05],[2.26,2.91],[2.91,3.3],[3.3,4.2],[4.2,4.6],[4.9,5.5],[5.5,6.3],[6.3,6.6],[6.6,7.01],[7.01,7.56],[7.56,8.11],[8.11,8.8],[8.8,9.8],[9.8,10.5],[10.5,11.0],[11.0,11.4],[11.4,12.4],[12.4,12.7],[12.78,13.1],[13.1,13.27]]},"sync":[[["காமந்","passion"]],[["தாங்குமதி","do bear!"]],[["யென்போர்","those who say"]],[["தாம்","they themselves"],["அஃ","that"]],[["தறியலர்","they do not know that"]],[["கொல்லோ","I wonder?"]],[["அனை","such"],["மது","strength"]],[["கையர்கொல்","are they possessed of? (strength)"]],[["யாம்","we"],["மெங்","our"]],[["காதலர்க்","lover"]],[["காணே","we do not see"]],[["மாயிற்","if"]],[["செறி","dense"],["துனி","distress"]],[["பெருகிய","which has increased"]],[["நெஞ்சமொடு","with the heart"]],[["பெருநீர்க்","of the great water"]],[["கல்பொரு","dashing against the rock"]],[["சிறுநுரை","small foam"]],[["போல","like"]],[["மெல்ல","slowly"]],[["மெல்ல","slowly"]],[["இல்லா","not becoming"]],[["குதுமே","we will indeed become"]]]}