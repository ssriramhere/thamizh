{"text":"kuruntokai","n":90,"lines":["எற்றோ வாழி தோழி முற்றுபு","கறிவளர் அடுக்கத் திரவின் முழங்கிய","மங்குல் மாமழை வீழ்ந்தெனப் பொங்குமயிர்க்","கலைதொட இழுக்கிய பூநாறு பலவுக்கனி","வரையிழி அருவி உண்துறைத் தரூஉம்","குன்ற நாடன் கேண்மை","மென்தோள் சாய்த்துஞ் சால்பீன் றன்றே"],"tr":["eṟṟō vāḻi tōḻi muṟṟupu","kaṟivaḷar aṭukkat tiraviṉ muḻaṅkiya","maṅkul māmaḻai vīḻnteṉap poṅkumayirk","kalaitoṭa iḻukkiya pūnāṟu palavukkaṉi","varaiyiḻi aruvi uṇtuṟait tarūum","kuṉṟa nāṭaṉ kēṇmai","meṉtōḷ cāyttuñ cālpīṉ ṟaṉṟē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"மதுரை எழுத்தாளன் சேந்தன்பூதனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Maturai Eḻuttāḷaṉ Cēntaṉpūtaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 24, veṇcīr 2, vañcicīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 6, kalittaḷai 2, oṉṟiya vañcittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"எற்றோ","tr":"eṟṟō","foot":"tēmā","acai":[{"kind":"nēr","text":"எற்","tr":"eṟ"},{"kind":"nēr","text":"றோ","tr":"ṟō"}]},{"text":"வாழி","tr":"vāḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"முற்றுபு","tr":"muṟṟupu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"முற்","tr":"muṟ"},{"kind":"nirai","text":"றுபு","tr":"ṟupu"}]}],[{"text":"கறிவளர்","tr":"kaṟivaḷar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கறி","tr":"kaṟi"},{"kind":"nirai","text":"வளர்","tr":"vaḷar"}]},{"text":"அடுக்கத்","tr":"aṭukkat","foot":"puḷimā","acai":[{"kind":"nirai","text":"அடுக்","tr":"aṭuk"},{"kind":"nēr","text":"கத்","tr":"kat"}]},{"text":"திரவின்","tr":"tiraviṉ","foot":"puḷimā","acai":[{"kind