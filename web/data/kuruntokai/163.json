"ஏ","lemma":"ஏ","gloss":"vocative particle"}],"gloss":"O sea!"},{"surface":"பூழியர்","parts":[{"text":"பூழியர்","lemma":"பூழியர்","gloss":"people of Pūḻi country"}],"gloss":"of the Pūḻiyar"}]},{"words":[{"surface":"சிறுதலை","parts":[{"text":"சிறு","lemma":"சிறு","gloss":"small"},{"text":"தலை","lemma":"தலை","gloss":"head"}],"gloss":"small-headed"},{"surface":"வெள்ளை","parts":[{"text":"வெள்ளை","lemma":"வெள்ளை","gloss":"white"}],"gloss":"white"},{"surface":"தோடு","parts":[{"text":"தோடு","lemma":"தோடு","gloss":"flock/herd"}],"gloss":"flock"},{"surface":"பரந்தன்ன","parts":[{"text":"பரந்து","lemma":"பர","gloss":"having spread"},{"text":"அன்ன","lemma":"அன்ன","gloss":"like"}],"gloss":"like spread out"}]},{"words":[{"surface":"மீனார்","parts":[{"text":"மீன்","lemma":"மீன்","gloss":"fish"},{"text":"ஆர்","lemma":"ஆர்","gloss":"eating"}],"gloss":"fish-eating"},{"surface":"குருகின்","parts":[{"text":"குருகு","lemma":"குருகு","gloss":"heron"},{"text":"இன்","lemma":"இன்","gloss":"of"}],"gloss":"of the herons"},{"surface":"கானலம்","parts":[{"text":"கானல்","lemma":"கானல்","gloss":"seaside grove"},{"text":"அம்","lemma":"அம்","gloss":"beautiful"}],"gloss":"beautiful seaside grove"},{"surface":"பெருந்துறை","parts":[{"text":"பெருந்துறை","lemma":"பெருந்துறை","gloss":"great shore"}],"gloss":"great shore","split_unverified":true}]},{"words":[{"surface":"வெள்வீ","parts":[{"text":"வெள்","lemma":"வெள்","gloss":"white"},{"text":"வீ","lemma":"வீ","gloss":"flower"}],"gloss":"white-flowered"},{"surface":"தாழை","parts":[{"text":"தாழை","lemma":"தாழை","gloss":"screwpine"}],"gloss":"screwpine"},{"surface":"திரை","parts":[{"text":"திரை","lemma":"திரை","gloss":"wave"}],"gloss":"wave"},{"surface":"அலை","parts":[{"text":"அலை","lemma":"அலை","gloss":"beating"}],"gloss":"beating"}]},{"words":[{"surface":"நள்ளென்","parts":[{"text":"நள்","lemma":"நள்","gloss":"midnight/darkness"},{"text":"என்","lemma":"என்","gloss":"sounding/saying"}],"gloss":"dark midnight"},{"surface":"கங்குலும்","parts":[{"text":"கங்குல்","lemma":"கங்குல்","gloss":"night"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"even in the night"},{"surface":"கேட்கும்","parts":[{"text":"கேட்கும்","lemma":"கேள்","gloss":"is heard"}],"gloss":"is heard"},{"surface":"நின்","parts":[{"text":"நின்","lemma":"நீ","gloss":"your"}],"gloss":"your"},{"surface":"குரலே","parts":[{"text":"குரல்","lemma":"குரல்","gloss":"voice"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"voice indeed"}]}],"literal":"Who afflicted you, O sea? / Like the small-headed white flock of the Pūḻiyar spread out, / in the beautiful seaside grove's great shore of fish-eating herons, / where the waves beat the white-flowered screwpine, / even in the dark midnight, your voice is heard.","translation":"Who has caused you distress, O sea? Even in the dead of night, your voice is heard crying out on this great shore with its beautiful seaside groves, where fish-eating herons gather like the spread-out flocks of small-headed white sheep belonging to the Pūḻiyar, and where waves beat against the white-flowered screwpine trees.","modern":"கடலே! பூழியர்களுடைய சிறிய தலைகளைக் கொண்ட வெள்ளாட்டு மந்தைகள் பரவி இருப்பது போல, மீன்களை உண்ணும் நாரைகள் பரவிக் கிடக்கின்ற, அழகிய கடற்கரைச் சோலையையுடைய பெரிய துறையில், வெண்மையான மலர்களைக் கொண்ட தாழை மரங்களை அலைகள் மோதும் நள்ளிரவிலும் உன்னுடைய குரல் கேட்கிறதே! உனக்குத் துன்பம் செய்தவர் யார்?","explanation":"The heroine, suffering from the pain of separation from her lover, addresses the roaring sea. She compares her own sleeplessness and constant crying to the endless sound of the waves. She asks the sea who has caused it such distress that it keeps wailing even in the dead of night, just as she does. The image of the white herons spread across the shore like the white sheep of the Pūḻi country highlights the vast, lonely expanse of the neytal (coastal) landscape. By projecting her own grief onto the sea, she expresses the depth of her sorrow.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,0.87],[1.0,1.4],[1.4,1.6],[1.6,2.7],[2.7,3.08],[3.08,3.5],[3.5,3.74],[3.8,4.7],[4.7,4.8],[4.8,5.3],[5.3,6.0],[6.0,6.4],[6.5,6.6],[6.6,7.3],[7.3,7.97],[7.97,8.8],[8.8,9.4],[9.6,9.7]],"female":[[0.0,0.6],[0.6,1.03],[1.2,1.5],[1.5,1.8],[1.8,3.0],[3.0,3.78],[3.78,3.94],[3.94,4.1],[4.1,5.6],[5.6,5.7],[5.7,6.3],[6.3,7.3],[7.3,7.6],[7.6,7.9],[7.9,8.2],[8.2,8.5],[8.5,8.8],[8.8,9.1],[9.1,9.4]]},"sync":[[["யார்","who"],["அணங்குற்றனை","you suffered distress"]],[["அணங்குற்றனை","you suffered distress"]],[["கடலே","O sea!"]],[["பூழியர்","of the Pūḻiyar"]],[["சிறுதலை","small-headed"]],[["வெள்ளை","white"],["தோடு","flock"]],[["தோடு","flock"],["பரந்தன்ன","like spread out"]],[["பரந்தன்ன","like spread out"]],[["மீனார்","fish-eating"]],[["குருகின்","of the herons"]],[["கானலம்","beautiful seaside grove"]],[["பெருந்துறை","great shore"]],[["வெள்வீ","white-flowered"]],[["தாழை","screwpine"]],[["திரை","wave"],["அலை","beating"]],[["நள்ளென்","dark midnight"]],[["கங்குலும்","even in the night"]],[["கேட்கும்","is heard"],["நின்","your"]],[["குரலே","voice indeed"]]]}