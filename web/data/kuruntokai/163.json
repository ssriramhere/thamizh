{"text":"kuruntokai","n":163,"lines":["யாரணங் குற்றனை கடலே பூழியர்","சிறுதலை வெள்ளைத் தோடுபரந் தன்ன","மீனார் குருகின் கானலம் பெருந்துறை","வெள்வீத் தாழை திரையலை","நள்ளென் கங்குலுங் கேட்குநின் குரலே"],"tr":["yāraṇaṅ kuṟṟaṉai kaṭalē pūḻiyar","ciṟutalai veḷḷait tōṭuparan taṉṉa","mīṉār kurukiṉ kāṉalam peruntuṟai","veḷvīt tāḻai tiraiyalai","naḷḷeṉ kaṅkuluṅ kēṭkuniṉ kuralē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"அம்மூவனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Ammūvaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"யாரணங்","tr":"yāraṇaṅ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nirai","text":"ரணங்","tr":"raṇaṅ"}]},{"text":"குற்றனை","tr":"kuṟṟaṉai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"குற்","tr":"kuṟ"},{"kind":"nirai","text":"றனை","tr":"ṟaṉai"}]},{"text":"கடலே","tr":"kaṭalē","foot":"puḷimā","acai":[{"kind":"nirai","text":"கட","tr":"kaṭa"},{"kind":"nēr","text":"லே","tr":"lē"}]},{"text":"பூழியர்","tr":"pūḻiyar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பூ","tr":"pū"},{"kind":"nirai","text":"ழியர்","tr":"ḻiyar"}]}],[{"text":"சிறுதலை","tr":"ciṟutalai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nirai","text":"தலை","tr":"talai"}]},{"text":"வெள்ளைத்","tr":"veḷḷait","foot":"tēmā","acai":[{"kind":"nēr","text":"வெள்","tr":"veḷ"},{"kind":"nēr","text":"ளைத்","tr":"ḷait"}]},{"text":"தோடுபரந்","tr":"tōṭuparan","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nirai","text":"டுப","tr":"ṭupa"},{"kind":"nēr","text":"ரந்","tr":"ran"}]},{"text":"தன்ன","tr":"taṉṉa","foot":"tēmā","acai":[{"kind":"nēr","