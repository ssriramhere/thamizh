{"text":"kuruntokai","n":136,"lines":["காமங் காமம் என்ப காமம்","அணங்கும் பிணியும் அன்றே நுணங்கிக்","கடுத்தலுந் தணிதலும் இன்றே யானை","குளகுமென் றாள்மதம் போலப்","பாணியும் உடைத்தது காணுநர்ப் பெறினே"],"tr":["kāmaṅ kāmam eṉpa kāmam","aṇaṅkum piṇiyum aṉṟē nuṇaṅkik","kaṭuttalun taṇitalum iṉṟē yāṉai","kuḷakumeṉ ṟāḷmatam pōlap","pāṇiyum uṭaittatu kāṇunarp peṟiṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"மிளைப்பெருங் கந்தனார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Miḷaipperuṅ Kantaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 9, veṇṭaḷai 9"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"காமங்","tr":"kāmaṅ","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"மங்","tr":"maṅ"}]},{"text":"காமம்","tr":"kāmam","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"மம்","tr":"mam"}]},{"text":"என்ப","tr":"eṉpa","foot":"tēmā","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nēr","text":"ப","tr":"pa"}]},{"text":"காமம்","tr":"kāmam","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"மம்","tr":"mam"}]}],[{"text":"அணங்கும்","tr":"aṇaṅkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"அணங்","tr":"aṇaṅ"},{"kind":"nēr","text":"கும்","tr":"kum"}]},{"text":"பிணியும்","tr":"piṇiyum","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிணி","tr":"piṇi"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"அன்றே","tr":"aṉṟē","foot":"tēmā","acai":[{"kind":"nēr","text":"அன்","tr":"aṉ"},{"kind":"nēr","text":"றே","tr":"ṟē"}]},{"text":"நுணங்கிக்","tr":"nuṇaṅkik","foot":"puḷimā","acai":[{"kind":"nirai","text":"நுணங்","tr":"nuṇaṅ"},{"kind":"nēr","text":"கிக்","tr":"kik"}]}],[{"text":"கடுத்தலுந்","tr