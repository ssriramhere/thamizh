{"text":"kuruntokai","n":17,"lines":["மாவென மடலும் ஊர்ப பூவெனக்","குவிமுகிழ் எருக்கங் கண்ணியும் சூடுப","மறுகி னார்க்கவும் படுப","பிறிது மாகுப காமங்காழ் கொளினே"],"tr":["māveṉa maṭalum ūrpa pūveṉak","kuvimukiḻ erukkaṅ kaṇṇiyum cūṭupa","maṟuki ṉārkkavum paṭupa","piṟitu mākupa kāmaṅkāḻ koḷiṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"பேரெயின் முறுவலார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Pēreyiṉ Muṟuvalār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 14, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 3, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மாவென","tr":"māveṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"வென","tr":"veṉa"}]},{"text":"மடலும்","tr":"maṭalum","foot":"puḷimā","acai":[{"kind":"nirai","text":"மட","tr":"maṭa"},{"kind":"nēr","text":"லும்","tr":"lum"}]},{"text":"ஊர்ப","tr":"ūrpa","foot":"tēmā","acai":[{"kind":"nēr","text":"ஊர்","tr":"ūr"},{"kind":"nēr","text":"ப","tr":"pa"}]},{"text":"பூவெனக்","tr":"pūveṉak","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பூ","tr":"pū"},{"kind":"nirai","text":"வெனக்","tr":"veṉak"}]}],[{"text":"குவிமுகிழ்","tr":"kuvimukiḻ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குவி","tr":"kuvi"},{"kind":"nirai","text":"முகிழ்","tr":"mukiḻ"}]},{"text":"எருக்கங்","tr":"erukkaṅ","foot":"puḷimā","acai":[{"kind":"nirai","text":"எருக்","tr":"eruk"},{"kind":"nēr","text":"கங்","tr":"kaṅ"}]},{"text":"கண்ணியும்","tr":"kaṇṇiyum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கண்","tr":"kaṇ"},{"kind":"nirai","text":"ணியும்","tr":"ṇiyum"}]},{"text":"சூடுப","tr":"cūṭupa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சூ","tr":"cū"},{"kind":"nirai","text":"டுப","tr":"ṭupa"}]}],[{"text":"மறுகி","t