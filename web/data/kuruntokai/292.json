{"text":"kuruntokai","n":292,"lines":["மண்ணிய சென்ற ஒண்ணுத லரிவை","புனல்தரு பசுங்காய் தின்றதன் தப்பற்","கொன்பதிற் றொன்பது களிற்றொ டவணிறை","பொன்செய் பாவை கொடுப்பவுங் கொள்ளான்","பெண்கொலை புரிந்த நன்னன் போல","வரையா நிரையத்துச் செலீஇயரோ அன்னை","ஒருநாள் நகைமுக விருந்தினன் வந்தெனப்","பகைமுக ஊரின் துஞ்சலோ இலளே"],"tr":["maṇṇiya ceṉṟa oṇṇuta larivai","puṉaltaru pacuṅkāy tiṉṟataṉ tappaṟ","koṉpatiṟ ṟoṉpatu kaḷiṟṟo ṭavaṇiṟai","poṉcey pāvai koṭuppavuṅ koḷḷāṉ","peṇkolai purinta naṉṉaṉ pōla","varaiyā niraiyattuc celīiyarō aṉṉai","orunāḷ nakaimuka viruntiṉaṉ vanteṉap","pakaimuka ūriṉ tuñcalō ilaḷē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"பரணர்","speaker_en":"her friend (tōḻi)","poet_tr":"Paraṇar"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"8×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 15, āciriyattaḷai 15, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மண்ணிய","tr":"maṇṇiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மண்","tr":"maṇ"},{"kind":"nirai","text":"ணிய","tr":"ṇiya"}]},{"text":"சென்ற","tr":"ceṉṟa","foot":"tēmā","acai":[{"kind":"nēr","text":"சென்","tr":"ceṉ"},{"kind":"nēr","text":"ற","tr":"ṟa"}]},{"text":"ஒண்ணுத","tr":"oṇṇuta","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஒண்","tr":"oṇ"},{"kind":"nirai","text":"ணுத","tr":"ṇuta"}]},{"text":"லரிவை","tr":"larivai","foot":"puḷimā","acai":[{"kind":"nirai","text":"லரி","tr":"lari"},{"kind":"nēr","text":"வை","tr":"vai"}]}],[{"text":"புனல்தரு","tr":"puṉaltaru","foot":"karuviḷam","acai":[{"kind":"nirai","text":"புனல்","tr":"puṉal"},{"kind":"nirai","text":"தரு","tr":"taru"}]},{"text":"பசுங்காய்","tr":"pacuṅkāy","foot":"puḷimā","acai":[{"kind":"nirai","text":"பசுங்","tr":"pacuṅ"},{"kind":"nēr","text":"காய்","tr":"kāy"}]},{"text":"தின்றதன்","tr":"tiṉṟ