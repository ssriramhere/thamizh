{"text":"kuruntokai","n":401,"lines":["அடும்பி னாய்மலர் விரைஇ நெய்தல்","நெடுந்தொடை வேய்ந்த நீர்வார் கூந்தல்","ஓரை மகளி ரஞ்சியீர் ஞெண்டு","கடலிற் பரிக்குந் துறைவனொ டொருநாள்","நக்குவிளை யாடலுங் கடிந்தன்","றைதே கம்ம மெய்தோய் நட்பே"],"tr":["aṭumpi ṉāymalar viraii neytal","neṭuntoṭai vēynta nīrvār kūntal","ōrai makaḷi rañciyīr ñeṇṭu","kaṭaliṟ parikkun tuṟaivaṉo ṭorunāḷ","nakkuviḷai yāṭaluṅ kaṭintaṉ","ṟaitē kamma meytōy naṭpē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"அம்மூவனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Ammūvaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அடும்பி","tr":"aṭumpi","foot":"puḷimā","acai":[{"kind":"nirai","text":"அடும்","tr":"aṭum"},{"kind":"nēr","text":"பி","tr":"pi"}]},{"text":"னாய்மலர்","tr":"ṉāymalar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"னாய்","tr":"ṉāy"},{"kind":"nirai","text":"மலர்","tr":"malar"}]},{"text":"விரைஇ","tr":"viraii","foot":"puḷimā","acai":[{"kind":"nirai","text":"விரை","tr":"virai"},{"kind":"nēr","text":"இ","tr":"i"}]},{"text":"நெய்தல்","tr":"neytal","foot":"tēmā","acai":[{"kind":"nēr","text":"நெய்","tr":"ney"},{"kind":"nēr","text":"தல்","tr":"tal"}]}],[{"text":"நெடுந்தொடை","tr":"neṭuntoṭai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நெடுந்","tr":"neṭun"},{"kind":"nirai","text":"தொடை","tr":"toṭai"}]},{"text":"வேய்ந்த","tr":"vēynta","foot":"tēmā","acai":[{"kind":"nēr","text":"வேய்ந்","tr":"vēyn"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"நீர்வார்","tr":"nīrvār","foot":"tēmā","acai":[{"kind":"nēr","text":"நீர்","tr":"nīr"},{"kind":"nēr","text":"வார்","tr":"vār"}]},{"text":"கூந்தல்","tr":"kūntal","foot":"tēmā","acai":[{"k