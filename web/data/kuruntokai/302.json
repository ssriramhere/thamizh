{"text":"kuruntokai","n":302,"lines":["உரைத்திசின் தோழியது புரைத்தோ அன்றே","அருந்துயர் உழத்தலும் ஆற்றாம் இதன்றலைப்","பெரும்பிறி தாகல் அதனினும் அஞ்சுதும்","அன்னோ இன்னும் நன்மலை நாடன்","பிரியா நண்பினர் இருவரும் என்னும்","அலரதற் கஞ்சினன் கொல்லோ பலருடன்","துஞ்சூர் யாமத் தானுமென்","நெஞ்சத் தல்லது வரவறி யானே"],"tr":["uraitticiṉ tōḻiyatu puraittō aṉṟē","aruntuyar uḻattalum āṟṟām itaṉṟalaip","perumpiṟi tākal ataṉiṉum añcutum","aṉṉō iṉṉum naṉmalai nāṭaṉ","piriyā naṇpiṉar iruvarum eṉṉum","alarataṟ kañciṉaṉ kollō palaruṭaṉ","tuñcūr yāmat tāṉumeṉ","neñcat tallatu varavaṟi yāṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"மாங்குடிகிழார்","speaker_en":"the heroine (talaivi)","poet_tr":"Māṅkuṭikiḻār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 18, āciriyattaḷai 11, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"உரைத்திசின்","tr":"uraitticiṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"உரைத்","tr":"urait"},{"kind":"nirai","text":"திசின்","tr":"ticiṉ"}]},{"text":"தோழியது","tr":"tōḻiyatu","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nirai","text":"ழிய","tr":"ḻiya"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"புரைத்தோ","tr":"puraittō","foot":"puḷimā","acai":[{"kind":"nirai","text":"புரைத்","tr":"purait"},{"kind":"nēr","text":"தோ","tr":"tō"}]},{"text":"அன்றே","tr":"aṉṟē","foot":"tēmā","acai":[{"kind":"nēr","text":"அன்","tr":"aṉ"},{"kind":"nēr","text":"றே","tr":"ṟē"}]}],[{"text":"அருந்துயர்","tr":"aruntuyar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அருந்","tr":"arun"},{"kind":"nirai","text":"துயர்","tr":"tuyar"}]},{"text":"உழத்தலும்","tr":"uḻattalum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"உழத்","tr":"uḻ