oss":"besides"}]},{"words":[{"surface":"மழையும்","parts":[{"text":"மழை","lemma":"மழை","gloss":"rain/cloud"},{"text":"உம்","lemma":"உம்","gloss":"also"}],"gloss":"the rain also"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"தோழி","gloss":"friend"}],"gloss":"O friend"},{"surface":"மான்று","parts":[{"text":"மான்று","lemma":"மான்று","gloss":"having darkened"}],"gloss":"having darkened"},{"surface":"பட்டன்றே","parts":[{"text":"பட்டன்றே","lemma":"பட்டன்றே","gloss":"has indeed set in"}],"gloss":"has indeed set in","split_unverified":true}]},{"words":[{"surface":"பட்ட","parts":[{"text":"பட்ட","lemma":"படு","gloss":"poured/fallen"}],"gloss":"poured"},{"surface":"மாரி","parts":[{"text":"மாரி","lemma":"மாரி","gloss":"rain"}],"gloss":"rain"},{"surface":"படாஅ","parts":[{"text":"படாஅ","lemma":"படு","gloss":"not falling"}],"gloss":"not falling"},{"surface":"கண்ணும்","parts":[{"text":"கண்","lemma":"கண்","gloss":"time/when"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"even when"}]},{"words":[{"surface":"அவர்திறத்து","parts":[{"text":"அவர்","lemma":"அவர்","gloss":"his"},{"text":"திறத்து","lemma":"திறம்","gloss":"side/sake"}],"gloss":"on his account"},{"surface":"இரங்கும்","parts":[{"text":"இரங்கும்","lemma":"இரங்கு","gloss":"grieves"}],"gloss":"grieves"},{"surface":"நம்மினும்","parts":[{"text":"நம்","lemma":"நம்","gloss":"us"},{"text":"இனும்","lemma":"இனும்","gloss":"more than"}],"gloss":"more than us"}]},{"words":[{"surface":"நந்திறத்து","parts":[{"text":"நம்","lemma":"நம்","gloss":"our"},{"text":"திறத்து","lemma":"திறம்","gloss":"side/sake"}],"gloss":"on our account"},{"surface":"இரங்கும்","parts":[{"text":"இரங்கும்","lemma":"இரங்கு","gloss":"grieves"}],"gloss":"grieves"},{"surface":"இவ்","parts":[{"text":"இவ்","lemma":"இ","gloss":"this"}],"gloss":"this"},{"surface":"வழங்கல்","parts":[{"text":"வழங்கல்","lemma":"வழங்கல்","gloss":"bustling/moving"}],"gloss":"bustling"},{"surface":"ஊரே","parts":[{"text":"ஊர்","lemma":"ஊர்","gloss":"town"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"town indeed"}]}],"literal":"Like the growing crescent moon, step by step increasing, / with the distressing pain that made the wrist-bangles slip, / becoming like a crushed soft leaf-shoot and wasting away, / not only suffering because those who are near are absent, / the rain also, O friend, has darkened and set in! / Even when the poured rain does not fall, / more than us who grieve on his account, / on our account grieves this bustling town!","translation":"O friend, like the growing crescent moon, my distressing pain increases step by step, making my wrist-bangles slip. Wasted away, I have become like a crushed soft leaf-shoot. Not only do I suffer because he is not near, but the rain clouds have also darkened and set in! Even when the poured rain does not fall, this bustling town grieves for us, even more than we grieve for him!","modern":"தோழியே! வளரும் பிறை நிலவைப்போல நாளுக்கு நாள் வளர்ந்து, என் மணிக்கட்டு வளையல்களைக் கழலச் செய்த துன்பம் தரும் நோயோடு, கசக்கிய தளிர் போலாகி நான் மெலிந்து கிடக்கிறேன். என் அருகில் அவர் இல்லாததால் நான் படும் துன்பம் ஒருபுறமிருக்க, மேகங்களும் இருண்டு மழையைப் பொழியத் தொடங்கிவிட்டன. பெய்ய வேண்டிய மழை பெய்யாத காலத்திலும், நாம் அவருக்காக வருந்துவதை விட, இந்த நடமாட்டம் மிகுந்த ஊர் நமக்காக அதிகமாக வருந்துகிறது.","explanation":"The heroine is speaking to her friend during the rainy season, which is the designated time for the hero's return. She laments that her physical distress has grown steadily like a waxing moon, causing her to lose weight so that her bangles slip off, and making her look like a crushed leaf-shoot. To make matters worse, the dark rain clouds have set in, intensifying her longing. However, she notes a surprising change in her surroundings: the bustling townspeople, who are usually prone to gossip, are now showing deep sympathy for her state. They seem to grieve for her suffering even more than she herself grieves for the absent hero.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,1.0],[1.0,1.5],[1.5,1.89],[1.89,2.4],[2.4,2.8],[2.8,3.15],[3.15,3.5],[3.5,4.8],[4.8,5.2],[5.2,5.5],[5.5,5.8],[5.8,6.2],[6.2,6.7],[6.7,6.82],[6.82,7.8],[7.8,8.7],[8.7,9.0],[9.02,9.63],[9.63,9.99],[9.99,10.36],[10.36,10.6],[10.6,11.1],[11.1,11.5],[11.5,12.2],[12.2,12.51],[12.51,12.9],[13.02,13.6],[13.6,14.5],[14.53,14.7],[14.7,15.1]],"female":[[0.0,0.9],[0.9,1.3],[1.3,1.9],[1.9,2.37],[2.37,2.81],[2.81,3.37],[3.37,3.7],[3.7,4.4],[4.4,5.87],[5.87,6.2],[6.2,6.53],[6.53,7.2],[7.2,7.63],[7.63,8.16],[8.16,8.59],[8.7,9.0],[9.0,10.3],[10.3,10.73],[10.73,11.38],[11.38,11.6],[11.6,12.4],[12.4,12.7],[12.7,12.9],[12.9,13.5],[13.5,14.4],[14.4,15.1],[15.1,15.95],[15.95,16.8],[16.9,17.4],[17.42,17.6],[17.6,18.2]]},"sync":[[["வளர்பிறை","growing crescent moon"]],[["போல","like"]],[["வழிவழி","step by step"],["பெருகி","having increased"]],[["பெருகி","having increased"]],[["இறைவளை","wrist-bangles"]],[["நெகிழ்த்த","which made loose"]],[["எவ்வ","distressing"]],[["நோயொடு","with pain"]],[["குழை","tender leaf"],["பிசைந்தனையேம்","we who are like those who crushed"]],[["பிசைந்தனையேம்","we who are like those who crushed"]],[["பிசைந்தனையேம்","we who are like those who crushed"],["ஆகி","having become"]],[["சாஅய்","having languished"]],[["உழையர்","those who are near"]],[["அன்மையின்","because of not being near"]],[["உழப்பது","suffering"]],[["உழப்பது","suffering"],["அன்றியும்","besides"]],[["மழையும்","the rain also"]],[["தோழி","O friend"]],[["மான்று","having darkened"],["பட்டன்றே","has indeed set in"]],[["பட்டன்றே","has indeed set in"]],[["பட்ட","poured"]],[["மாரி","rain"]],[["படாஅ","not falling"],["கண்ணும்","even when"]],[["கண்ணும்","even when"]],[["அவர்திறத்து","on his account"]],[["அவர்திறத்து","on his account"],["இரங்கும்","grieves"]],[["நம்மினும்","more than us"]],[["நந்திறத்து","on our account"]],[["நந்திறத்து","on our account"],["இரங்கும்","grieves"],["இவ்","this"]],[["வழங்கல்","bustling"]],[["ஊரே","town indeed"]]]}