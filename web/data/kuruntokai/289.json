{"text":"kuruntokai","n":289,"lines":["வளர்பிறை போல வழிவழிப் பெருகி","இறைவளை நெகிழ்த்த எவ்வ நோயொடு","குழைபிசைந் தனையே மாகிச் சாஅய்","உழையர் அன்மையின் உழப்ப தன்றியும்","மழையுந் தோழி மான்றுபட் டன்றே","பட்ட மாரி படாஅக் கண்ணும்","அவர்திறத் திரங்கு நம்மினும்","நந்திறத் திரங்குமிவ் வழங்கல் ஊரே"],"tr":["vaḷarpiṟai pōla vaḻivaḻip peruki","iṟaivaḷai nekiḻtta evva nōyoṭu","kuḻaipicain taṉaiyē mākic cāay","uḻaiyar aṉmaiyiṉ uḻappa taṉṟiyum","maḻaiyun tōḻi māṉṟupaṭ ṭaṉṟē","paṭṭa māri paṭāak kaṇṇum","avartiṟat tiraṅku nammiṉum","nantiṟat tiraṅkumiv vaḻaṅkal ūrē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"பெருங் கண்ணனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Peruṅ Kaṇṇaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 21, veṇṭaḷai 8, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வளர்பிறை","tr":"vaḷarpiṟai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வளர்","tr":"vaḷar"},{"kind":"nirai","text":"பிறை","tr":"piṟai"}]},{"text":"போல","tr":"pōla","foot":"tēmā","acai":[{"kind":"nēr","text":"போ","tr":"pō"},{"kind":"nēr","text":"ல","tr":"la"}]},{"text":"வழிவழிப்","tr":"vaḻivaḻip","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வழி","tr":"vaḻi"},{"kind":"nirai","text":"வழிப்","tr":"vaḻip"}]},{"text":"பெருகி","tr":"peruki","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெரு","tr":"peru"},{"kind":"nēr","text":"கி","tr":"ki"}]}],[{"text":"இறைவளை","tr":"iṟaivaḷai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இறை","tr":"iṟai"},{"kind":"nirai","text":"வளை","tr":"vaḷai"}]},{"text":"நெகிழ்த்த","tr":"nekiḻtta","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெகிழ்த்","tr":"nekiḻt"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"எவ்வ","tr":"evva","