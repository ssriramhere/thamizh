{"text":"kuruntokai","n":247,"lines":["எழின்மிக வுடைய தீங்கணிப் படூஉம்","திறவோர் செய்வினை அறவ தாகும்","கிளையுடை மாந்தர்க்குப் புணையுமா மிவ்வென","ஆங்கறிந் திசினே தோழி வேங்கை","வீயா மென்சினை வீயுக யானை","ஆர்துயில் இயம்பு நாடன்","மார்புரித் தாகிய மறுவில் நட்பே"],"tr":["eḻiṉmika vuṭaiya tīṅkaṇip paṭūum","tiṟavōr ceyviṉai aṟava tākum","kiḷaiyuṭai māntarkkup puṇaiyumā mivveṉa","āṅkaṟin ticiṉē tōḻi vēṅkai","vīyā meṉciṉai vīyuka yāṉai","ārtuyil iyampu nāṭaṉ","mārpurit tākiya maṟuvil naṭpē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"சேந்தம் பூதனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Cēntam Pūtaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 8, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"எழின்மிக","tr":"eḻiṉmika","foot":"karuviḷam","acai":[{"kind":"nirai","text":"எழின்","tr":"eḻiṉ"},{"kind":"nirai","text":"மிக","tr":"mika"}]},{"text":"வுடைய","tr":"vuṭaiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"வுடை","tr":"vuṭai"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"தீங்கணிப்","tr":"tīṅkaṇip","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தீங்","tr":"tīṅ"},{"kind":"nirai","text":"கணிப்","tr":"kaṇip"}]},{"text":"படூஉம்","tr":"paṭūum","foot":"puḷimā","acai":[{"kind":"nirai","text":"படூ","tr":"paṭū"},{"kind":"nēr","text":"உம்","tr":"um"}]}],[{"text":"திறவோர்","tr":"tiṟavōr","foot":"puḷimā","acai":[{"kind":"nirai","text":"திற","tr":"tiṟa"},{"kind":"nēr","text":"வோர்","tr":"vōr"}]},{"text":"செய்வினை","tr":"ceyviṉai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"செய்","tr":"cey"},{"kind":"nirai","text":"வினை","tr":"viṉai"}]},{"text":"அறவ","tr":"aṟava","foot":"puḷimā","acai":[{"kind":"nirai","text":"அற","tr":"aṟa"},{"kind":"