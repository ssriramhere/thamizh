{"text":"kuruntokai","n":344,"lines":["நோற்றோர் மன்ற தோழி தண்ணெனத்","தூற்றுந் துவலைப் பனிக்கடுந் திங்கட்","புலம்பயி ரருந்த அண்ண லேற்றொடு","நிலந்தூங் கணல வீங்குமுலைச் செருத்தல்","பால்வார்பு குழவி யுள்ளி நிரையிறந்","தூர்வயிற் பெயரும் புன்கண் மாலை","அரும்பெறற் பொருட்பிணிப் போகிப்","பிரிந்துறை காதலர் வரக்காண் போரே"],"tr":["nōṟṟōr maṉṟa tōḻi taṇṇeṉat","tūṟṟun tuvalaip paṉikkaṭun tiṅkaṭ","pulampayi rarunta aṇṇa lēṟṟoṭu","nilantūṅ kaṇala vīṅkumulaic ceruttal","pālvārpu kuḻavi yuḷḷi niraiyiṟan","tūrvayiṟ peyarum puṉkaṇ mālai","arumpeṟaṟ poruṭpiṇip pōkip","pirintuṟai kātalar varakkāṇ pōrē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"குறுங்குடி மருதனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kuṟuṅkuṭi Marutaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 29, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 12, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நோற்றோர்","tr":"nōṟṟōr","foot":"tēmā","acai":[{"kind":"nēr","text":"நோற்","tr":"nōṟ"},{"kind":"nēr","text":"றோர்","tr":"ṟōr"}]},{"text":"மன்ற","tr":"maṉṟa","foot":"tēmā","acai":[{"kind":"nēr","text":"மன்","tr":"maṉ"},{"kind":"nēr","text":"ற","tr":"ṟa"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"தண்ணெனத்","tr":"taṇṇeṉat","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தண்","tr":"taṇ"},{"kind":"nirai","text":"ணெனத்","tr":"ṇeṉat"}]}],[{"text":"தூற்றுந்","tr":"tūṟṟun","foot":"tēmā","acai":[{"kind":"nēr","text":"தூற்","tr":"tūṟ"},{"kind":"nēr","text":"றுந்","tr":"ṟun"}]},{"text":"துவலைப்","tr":"tuvalaip","foot":"puḷimā","acai":[{"kind":"nirai","text":"துவ","tr":"tuva"},{"kind":"nēr","text":"லைப்","tr":"laip"}]},{"text":"பனிக்கடுந்","tr":"paṉi