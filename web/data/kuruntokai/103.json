":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"யானே","tr":"yāṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"கடும்புனல்","parts":[{"text":"கடுமை","lemma":"kaṭumai","gloss":"swiftness"},{"text":"புனல்","lemma":"puṉal","gloss":"flood"}],"gloss":"swift flood"},{"surface":"தொகுத்த","parts":[{"text":"தொகு","lemma":"toku","gloss":"gather"},{"text":"த்த","lemma":"tta","gloss":"past relative participle suffix"}],"gloss":"gathered"},{"surface":"நடுங்கஞர்","parts":[{"text":"நடுங்கு","lemma":"naṭuṅku","gloss":"tremble"},{"text":"அஞர்","lemma":"añar","gloss":"distress"}],"gloss":"trembling distress"},{"surface":"அள்ளல்","parts":[{"text":"அள்ளல்","lemma":"aḷḷal","gloss":"muddy mire"}],"gloss":"muddy mire"}]},{"words":[{"surface":"கவரிதழ்","parts":[{"text":"கவரிதழ்","lemma":"கவரிதழ்","gloss":"split petal"}],"gloss":"split petal","split_unverified":true},{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"aṉṉa","gloss":"like"}],"gloss":"like"},{"surface":"தூவிச்","parts":[{"text":"தூவிச்","lemma":"தூவிச்","gloss":"feather"}],"gloss":"feather","split_unverified":true},{"surface":"செவ்வாய்","parts":[{"text":"செவ்வாய்","lemma":"செவ்வாய்","gloss":"red beak"}],"gloss":"red beak","split_unverified":true}]},{"words":[{"surface":"இரை","parts":[{"text":"இரை","lemma":"irai","gloss":"prey"}],"gloss":"prey"},{"surface":"தேர்","parts":[{"text":"தேர்","lemma":"tēr","gloss":"search"}],"gloss":"searching"},{"surface":"நாரைக்கு","parts":[{"text":"நாரை","lemma":"nārai","gloss":"heron"},{"text":"க்கு","lemma":"kku","gloss":"dative case marker"}],"gloss":"to the heron"},{"surface":"எவ்வம்","parts":[{"text":"எவ்வம்","lemma":"evvam","gloss":"suffering"}],"gloss":"suffering"},{"surface":"ஆக","parts":[{"text":"ஆகு","lemma":"āku","gloss":"become"},{"text":"அ","lemma":"a","gloss":"infinitive suffix"}],"gloss":"to become"}]},{"words":[{"surface":"தூஉம்","parts":[{"text":"தூஉம்","lemma":"தூஉம்","gloss":"scattering"}],"gloss":"scattering","split_unverified":true},{"surface":"துவலை","parts":[{"text":"துவலை","lemma":"tuvalai","gloss":"drizzle"}],"gloss":"drizzle"},{"surface":"துயர்கூர்","parts":[{"text":"துயர்","lemma":"tuyar","gloss":"sorrow"},{"text":"கூர்","lemma":"kūr","gloss":"increase"}],"gloss":"sorrow-increasing"},{"surface":"வாடையும்","parts":[{"text":"வாடை","lemma":"vāṭai","gloss":"north wind"},{"text":"உம்","lemma":"um","gloss":"and"}],"gloss":"and the north wind"}]},{"words":[{"surface":"வாரார்","parts":[{"text":"வாரார்","lemma":"வாரார்","gloss":"he does not come"}],"gloss":"he does not come","split_unverified":true},{"surface":"போல்வர்","parts":[{"text":"போல்வர்","lemma":"போல்வர்","gloss":"it seems"}],"gloss":"it seems","split_unverified":true},{"surface":"நம்","parts":[{"text":"நம்","lemma":"nam","gloss":"our"}],"gloss":"our"},{"surface":"காதலர்","parts":[{"text":"காதல்","lemma":"kātal","gloss":"love"},{"text":"அர்","lemma":"ar","gloss":"honorific suffix"}],"gloss":"lover"}]},{"words":[{"surface":"வாழேன்","parts":[{"text":"வாழ்","lemma":"vāḻ","gloss":"live"},{"text":"ஏன்","lemma":"ēṉ","gloss":"first person singular negative suffix"}],"gloss":"I will not live"},{"surface":"போல்வல்","parts":[{"text":"போல்வல்","lemma":"போல்வல்","gloss":"it seems I"}],"gloss":"it seems I","split_unverified":true},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"tōḻi","gloss":"friend"}],"gloss":"friend"},{"surface":"யானே","parts":[{"text":"யான்","lemma":"yāṉ","gloss":"I"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"I indeed"}]}],"literal":"Swift flood gathered trembling distress muddy mire / split petal like feather red beak / prey searching heron to suffering to become / scattering drizzle sorrow-increasing north wind and / come not seems our lover / live not seems friend I indeed","translation":"The cold north wind blows, scattering fine drizzle and increasing our sorrow, bringing distress to the red-beaked heron with feathers like split petals as it searches for prey in the muddy mire gathered by the swift flood. My friend, it seems my lover will not return; and it seems I shall not survive.","modern":"வேகமான வெள்ளம் சேர்த்த நடுங்கச் செய்யும் துன்பத்தைத் தரும் சேற்றில், பிளவுபட்ட இதழ் போன்ற இறகுகளையும் சிவந்த வாயையும் உடைய, இரையைத் தேடும் நாரைக்குத் துன்பம் உண்டாகும்படி, தூறலைத் தூவுகின்ற, துயரத்தை மிகுதிப்படுத்தும் வாடைக் காற்றும் வீசுகிறது. தோழி! நம் காதலர் வரமாட்டார் போலிருக்கிறது; நானும் உயிர்வாழ மாட்டேன் போலிருக்கிறது.","explanation":"In this Neytal (seashore) poem, the heroine speaks to her close friend in deep despair during the cold season. Her lover has not returned as promised, and the chilly north wind has set in, bringing a fine drizzle that intensifies her grief. The poem uses the vivid image of a red-beaked heron struggling to find food in the cold, wet mud brought by a swift flood, symbolizing the heroine's own helpless and distressed state. The harsh weather and the bird's suffering mirror her internal emotional turmoil. Feeling completely abandoned and overwhelmed by the cold wind, she concludes that her lover will not return and that she will not survive.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,1.1],[1.1,1.6],[1.6,1.8],[1.8,2.2],[2.2,2.2],[2.2,3.4],[3.4,3.6],[3.6,5.21],[5.21,5.21],[5.21,5.53],[5.53,6.11],[6.11,6.23],[6.23,6.8],[6.8,7.5],[7.5,7.9],[7.9,8.7],[8.7,8.7],[8.7,8.7],[8.7,8.7],[8.7,8.7],[8.7,9.1],[9.1,12.0]],"female":[[0.0,0.6],[0.6,1.1],[1.1,1.8],[1.8,2.0],[2.0,3.25],[3.25,3.5],[3.5,3.9],[3.9,4.1],[4.1,5.57],[5.57,5.57],[5.57,5.57],[5.57,6.44],[6.44,6.59],[6.59,7.3],[7.3,8.0],[8.0,8.5],[8.5,9.3],[9.43,10.1],[10.1,10.8],[10.8,10.8],[10.8,12.3],[12.3,12.7],[12.7,13.1]]}}