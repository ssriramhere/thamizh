{"text":"kuruntokai","n":93,"lines":["நன்னலந் தொலைய நலமிகச் சாஅய்","இன்னுயிர் கழியினும் உரைய லவர்நமக்கு","அன்னையும் அத்தனும் அல்லரோ தோழி","புலவியஃ தெவனோ அன்பிலங் கடையே"],"tr":["naṉṉalan tolaiya nalamikac cāay","iṉṉuyir kaḻiyiṉum uraiya lavarnamakku","aṉṉaiyum attaṉum allarō tōḻi","pulaviyaḵ tevaṉō aṉpilaṅ kaṭaiyē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தலைவி கூற்று","poet_ta":"அள்ளூர் நன்முல்லையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Aḷḷūr Naṉmullaiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"4×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 14, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 8, āciriyattaḷai 7"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நன்னலந்","tr":"naṉṉalan","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நன்","tr":"naṉ"},{"kind":"nirai","text":"னலந்","tr":"ṉalan"}]},{"text":"தொலைய","tr":"tolaiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"தொலை","tr":"tolai"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"நலமிகச்","tr":"nalamikac","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நல","tr":"nala"},{"kind":"nirai","text":"மிகச்","tr":"mikac"}]},{"text":"சாஅய்","tr":"cāay","foot":"tēmā","acai":[{"kind":"nēr","text":"சா","tr":"cā"},{"kind":"nēr","text":"அய்","tr":"ay"}]}],[{"text":"இன்னுயிர்","tr":"iṉṉuyir","foot":"kūviḷam","acai":[{"kind":"nēr","text":"இன்","tr":"iṉ"},{"kind":"nirai","text":"னுயிர்","tr":"ṉuyir"}]},{"text":"கழியினும்","tr":"kaḻiyiṉum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கழி","tr":"kaḻi"},{"kind":"nirai","text":"யினும்","tr":"yiṉum"}]},{"text":"உரைய","tr":"uraiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"உரை","tr":"urai"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"லவர்நமக்கு","tr":"lavarnamakku","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"லவர்","tr":"lavar"},{"kind":"nirai","text":"நம