{"text":"kuruntokai","n":300,"lines":["குவளை நாறுங் குவையிருங் கூந்தல்","ஆம்பல் நாறும் தேம்பொதி துவர்வாய்க்","குண்டுநீர்த் தாமரைக் கொங்கின் அன்ன","நுண்பல் தித்தி மாஅ யோயே","நீயே அஞ்ச லென்றவென் சொல்லஞ் சலையே","யானே குறுங்கா லன்னங் குவவுமணற் சேக்கும்","கடல்சூழ் மண்டிலம் பெறினும்","விடல்சூ ழலனான் நின்னுடை நட்பே"],"tr":["kuvaḷai nāṟuṅ kuvaiyiruṅ kūntal","āmpal nāṟum tēmpoti tuvarvāyk","kuṇṭunīrt tāmaraik koṅkiṉ aṉṉa","nuṇpal titti māa yōyē","nīyē añca leṉṟaveṉ collañ calaiyē","yāṉē kuṟuṅkā laṉṉaṅ kuvavumaṇaṟ cēkkum","kaṭalcūḻ maṇṭilam peṟiṉum","viṭalcū ḻalaṉāṉ niṉṉuṭai naṭpē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"சிறைக்குடி ஆந்தையார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Ciṟaikkuṭi Āntaiyār"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"2×5, 5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 32, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 19, veṇṭaḷai 13"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"2 five-foot lines (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"குவளை","tr":"kuvaḷai","foot":"puḷimā","acai":[{"kind":"nirai","text":"குவ","tr":"kuva"},{"kind":"nēr","text":"ளை","tr":"ḷai"}]},{"text":"நாறுங்","tr":"nāṟuṅ","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"றுங்","tr":"ṟuṅ"}]},{"text":"குவையிருங்","tr":"kuvaiyiruṅ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குவை","tr":"kuvai"},{"kind":"nirai","text":"யிருங்","tr":"yiruṅ"}]},{"text":"கூந்தல்","tr":"kūntal","foot":"tēmā","acai":[{"kind":"nēr","text":"கூந்","tr":"kūn"},{"kind":"nēr","text":"தல்","tr":"tal"}]}],[{"text":"ஆம்பல்","tr":"āmpal","foot":"tēmā","acai":[{"kind":"nēr","text":"ஆம்","tr":"ām"},{"kind":"nēr","text":"பல்","tr":"pal"}]},{"text":"நாறும்","tr":"nāṟum","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","t