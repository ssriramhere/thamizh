ma":"யாம்","gloss":"we"}],"gloss":"we"},{"surface":"துஞ்சலம்","parts":[{"text":"துஞ்சு","lemma":"துஞ்சு","gloss":"sleep"},{"text":"அல்","lemma":"அல்","gloss":"negative suffix"},{"text":"அம்","lemma":"அம்","gloss":"first person plural suffix"}],"gloss":"we do not sleep"},{"surface":"ஏ","parts":[{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"indeed"}]},{"words":[{"surface":"எம்","parts":[{"text":"எம்","lemma":"யாம்","gloss":"our"}],"gloss":"our"},{"surface":"இல்","parts":[{"text":"இல்","lemma":"இல்","gloss":"house"}],"gloss":"house"},{"surface":"அயலது","parts":[{"text":"அயல்","lemma":"அயல்","gloss":"neighborhood"},{"text":"அது","lemma":"அது","gloss":"pronominal suffix"}],"gloss":"that which is adjacent"},{"surface":"ஏழில்","parts":[{"text":"ஏழில்","lemma":"ஏழில்","gloss":"hedge"}],"gloss":"hedge"},{"surface":"உம்பர்","parts":[{"text":"உம்பர்","lemma":"உம்பர்","gloss":"above"}],"gloss":"above"}]},{"words":[{"surface":"மயிலடி","parts":[{"text":"மயிலடி","lemma":"மயிலடி","gloss":""}],"gloss":"","split_unverified":true},{"surface":"யிலைய","parts":[{"text":"யிலைய","lemma":"யிலைய","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மாக்குர","parts":[{"text":"மாக்குர","lemma":"மாக்குர","gloss":""}],"gloss":"","split_unverified":true},{"surface":"னொச்சி","parts":[{"text":"னொச்சி","lemma":"னொச்சி","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"அணி","parts":[{"text":"அணி","lemma":"அணி","gloss":"beauty"}],"gloss":"beauty"},{"surface":"மிகு","parts":[{"text":"மிகு","lemma":"மிகு","gloss":"abundant"}],"gloss":"abundant"},{"surface":"மென்","parts":[{"text":"மென்","lemma":"மென்","gloss":"soft"}],"gloss":"soft","split_unverified":true},{"surface":"கொம்பு","parts":[{"text":"கொம்பு","lemma":"கொம்பு","gloss":"branch"}],"gloss":"branch"},{"surface":"ஊழ்த்த","parts":[{"text":"ஊழ்","lemma":"ஊழ்","gloss":"blossom"},{"text":"த்","lemma":"த்","gloss":"past tense marker"},{"text":"த","lemma":"அ","gloss":"adjectival suffix"}],"gloss":"blossomed"}]},{"words":[{"surface":"மணி","parts":[{"text":"மணி","lemma":"மணி","gloss":"sapphire"}],"gloss":"sapphire"},{"surface":"மருள்","parts":[{"text":"மருள்","lemma":"மருள்","gloss":"resembling"}],"gloss":"resembling"},{"surface":"பூவின்","parts":[{"text":"பூ","lemma":"பூ","gloss":"flower"},{"text":"இன்","lemma":"இன்","gloss":"oblique suffix"}],"gloss":"of the flower"},{"surface":"பாடு","parts":[{"text":"பாடு","lemma":"பாடு","gloss":"falling"}],"gloss":"falling"},{"surface":"நனி","parts":[{"text":"நனி","lemma":"நனி","gloss":"clearly"}],"gloss":"clearly"},{"surface":"கேட்டே","parts":[{"text":"கேள்","lemma":"கேள்","gloss":"hear"},{"text":"ட்","lemma":"த்","gloss":"past participle ending"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"having heard indeed"}]}],"literal":"Even if the useless town sleeps, we do not sleep indeed, / above the hedge adjacent to our house, / the nocci tree with dark clusters and leaves like a peacock's foot, / on its beautiful, abundant, soft branches, / having heard clearly indeed the falling of its sapphire-resembling flowers.","translation":"Even if this entire town falls asleep, we do not sleep. For, from the nocci tree with dark clusters and leaves shaped like a peacock's foot, growing above the fence adjacent to our house, we clearly hear the sound of sapphire-like flowers falling from its beautiful, soft branches.","modern":"இந்த ஊரே தூங்கினாலும், நாம் தூங்குவதில்லை. நம் வீட்டிற்குப் பக்கத்தில் உள்ள வேலிக்கு மேலே, மயிலின் அடி போன்ற இலைகளையும் கரிய பூங்கொத்துகளையும் கொண்ட நொச்சி மரத்தின் அழகிய மெல்லிய கிளைகளிலிருந்து, நீலமணி போன்ற பூக்கள் உதிரும் சத்தத்தை மிகத் தெளிவாகக் கேட்டுக்கொண்டே இருக்கிறோம்.","explanation":"The companion speaks to the heroine (or to herself within earshot of the hero) during the night, highlighting the heroine's sleeplessness and pining. Even if the entire town is asleep, they cannot sleep because they are constantly listening to the soft sound of the sapphire-like flowers of the backyard nocci tree falling onto the ground. The nocci tree, with its peacock-foot-like leaves and dark clusters, stands right by the fence. The delicate sound of its falling flowers, which would normally go unnoticed, is so loud to their sleepless, hyper-alert ears, emphasizing the quietness of the night and the depth of their distress. This belongs to the Marutam landscape, where domestic spaces and subtle nature reflect the emotional tension of waiting and longing.","model":"gemini-3.5-flash"}}