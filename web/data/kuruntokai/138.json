{"text":"kuruntokai","n":138,"lines":["கொன்னூர் துஞ்சினும் யாந்துஞ் சலமே","எம்மி லயல தேழி லும்பர்","மயிலடி யிலைய மாக்குர னொச்சி","அணிமிகு மென்கொம் பூழ்த்த","மணிமருள் பூவின் பாடுநனி கேட்டே"],"tr":["koṉṉūr tuñciṉum yāntuñ calamē","emmi layala tēḻi lumpar","mayilaṭi yilaiya mākkura ṉocci","aṇimiku meṉkom pūḻtta","maṇimaruḷ pūviṉ pāṭunaṉi kēṭṭē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தோழி கூற்று","poet_ta":"கொல்லன் அழிசி","speaker_en":"her friend (tōḻi)","poet_tr":"Kollaṉ Aḻici"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 10, āciriyattaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கொன்னூர்","tr":"koṉṉūr","foot":"tēmā","acai":[{"kind":"nēr","text":"கொன்","tr":"koṉ"},{"kind":"nēr","text":"னூர்","tr":"ṉūr"}]},{"text":"துஞ்சினும்","tr":"tuñciṉum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"துஞ்","tr":"tuñ"},{"kind":"nirai","text":"சினும்","tr":"ciṉum"}]},{"text":"யாந்துஞ்","tr":"yāntuñ","foot":"tēmā","acai":[{"kind":"nēr","text":"யாந்","tr":"yān"},{"kind":"nēr","text":"துஞ்","tr":"tuñ"}]},{"text":"சலமே","tr":"calamē","foot":"puḷimā","acai":[{"kind":"nirai","text":"சல","tr":"cala"},{"kind":"nēr","text":"மே","tr":"mē"}]}],[{"text":"எம்மி","tr":"emmi","foot":"tēmā","acai":[{"kind":"nēr","text":"எம்","tr":"em"},{"kind":"nēr","text":"மி","tr":"mi"}]},{"text":"லயல","tr":"layala","foot":"puḷimā","acai":[{"kind":"nirai","text":"லய","tr":"laya"},{"kind":"nēr","text":"ல","tr":"la"}]},{"text":"தேழி","tr":"tēḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தே","tr":"tē"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"லும்பர்","tr":"lumpar","foot":"tēmā","acai":[{"kind":"nēr","text":"லும்","tr":"lum"},{"kind":"nēr","text":"பர்","tr":"par"}]}],[{"text":"மயிலடி","tr":"mayilaṭi","foot":"karu