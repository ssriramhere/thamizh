{"text":"kuruntokai","n":320,"lines":["பெருங்கடற் பரதவர் கொண்மீன் உணங்கல்","அருங்கழிக் கொண்ட இறவின் வாடலொடு","நிலவுநிற வெண்மணல் புலவப் பலவுடன்","எக்கர்தொறும் பரக்குந் துறைவனொ டொருநாள்","நக்கதோர் பழியு மிலமே போதவிழ்","பொன்னிணர் மரீஇய புள்ளிமிழ் பொங்கர்ப்","புன்னையஞ் சேரி யிவ்வூர்","கொன்னலர் தூற்றந்தன் கொடுமை யானே"],"tr":["peruṅkaṭaṟ paratavar koṇmīṉ uṇaṅkal","aruṅkaḻik koṇṭa iṟaviṉ vāṭaloṭu","nilavuniṟa veṇmaṇal pulavap palavuṭaṉ","ekkartoṟum parakkun tuṟaivaṉo ṭorunāḷ","nakkatōr paḻiyu milamē pōtaviḻ","poṉṉiṇar marīiya puḷḷimiḻ poṅkarp","puṉṉaiyañ cēri yivvūr","koṉṉalar tūṟṟantaṉ koṭumai yāṉē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"தும்பிசேர் கீரனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Tumpicēr Kīraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 4, vañcicīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 15, āciriyattaḷai 12, kalittaḷai 2, oṉṟiya vañcittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பெருங்கடற்","tr":"peruṅkaṭaṟ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெருங்","tr":"peruṅ"},{"kind":"nirai","text":"கடற்","tr":"kaṭaṟ"}]},{"text":"பரதவர்","tr":"paratavar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பர","tr":"para"},{"kind":"nirai","text":"தவர்","tr":"tavar"}]},{"text":"கொண்மீன்","tr":"koṇmīṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"கொண்","tr":"koṇ"},{"kind":"nēr","text":"மீன்","tr":"mīṉ"}]},{"text":"உணங்கல்","tr":"uṇaṅkal","foot":"puḷimā","acai":[{"kind":"nirai","text":"உணங்","tr":"uṇaṅ"},{"kind":"nēr","text":"கல்","tr":"kal"}]}],[{"text":"அருங்கழிக்","tr":"aruṅkaḻik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அருங்","tr":"aruṅ"},{"kind":"nirai","text":"கழிக்","tr":"kaḻik"}]},{"text":"கொண்ட","tr":"koṇṭa","foot":"tēmā","acai":[{"kind":"nē