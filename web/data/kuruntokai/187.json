xt":"மறி","lemma":"maṟi","gloss":"young one"}],"gloss":"young kid of the mountain goat"}]},{"words":[{"surface":"சுரைபொழி","parts":[{"text":"சுரை","lemma":"curai","gloss":"udder"},{"text":"பொழி","lemma":"poḻi","gloss":"pouring"}],"gloss":"udder-pouring"},{"surface":"தீம்பால்","parts":[{"text":"தீம்","lemma":"tīm","gloss":"sweet"},{"text":"பால்","lemma":"pāl","gloss":"milk"}],"gloss":"sweet milk"},{"surface":"ஆர","parts":[{"text":"ஆர்","lemma":"ār","gloss":"to become full"},{"text":"அ","lemma":"a","gloss":"infinitive suffix"}],"gloss":"abundantly"},{"surface":"மாந்தி","parts":[{"text":"மாந்து","lemma":"māntu","gloss":"to drink"},{"text":"இ","lemma":"i","gloss":"past participle suffix"}],"gloss":"having drunk"}]},{"words":[{"surface":"பெருவரை","parts":[{"text":"பெருமை","lemma":"perumai","gloss":"greatness"},{"text":"வரை","lemma":"varai","gloss":"mountain"}],"gloss":"big mountain"},{"surface":"நீழல்","parts":[{"text":"நீழல்","lemma":"nīḻal","gloss":"shade"}],"gloss":"shade"},{"surface":"உகளும்","parts":[{"text":"உகளு","lemma":"ukaḷu","gloss":"to leap"},{"text":"உம்","lemma":"um","gloss":"relative participle suffix"}],"gloss":"leaping"},{"surface":"நாடன்","parts":[{"text":"நாடு","lemma":"nāṭu","gloss":"land"},{"text":"அன்","lemma":"aṉ","gloss":"masculine singular suffix"}],"gloss":"lord of the land"}]},{"words":[{"surface":"கல்லினும்","parts":[{"text":"கல்","lemma":"kal","gloss":"stone"},{"text":"இன்","lemma":"iṉ","gloss":"comparative suffix"},{"text":"உம்","lemma":"um","gloss":"even"}],"gloss":"even more than stone"},{"surface":"வலியன்","parts":[{"text":"வலியன்","lemma":"வலியன்","gloss":"he is hard-hearted"}],"gloss":"he is hard-hearted","split_unverified":true},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"tōḻi","gloss":"friend"}],"gloss":"O friend"}]},{"words":[{"surface":"வலியன்","parts":[{"text":"வலியன்","lemma":"வலியன்","gloss":"he is hard-hearted"}],"gloss":"he is hard-hearted","split_unverified":true},{"surface":"என்னாது","parts":[{"text":"என்","lemma":"eṉ","gloss":"to say"},{"text":"ஆது","lemma":"ātu","gloss":"without"}],"gloss":"without considering"},{"surface":"மெலியும்","parts":[{"text":"மெலி","lemma":"meli","gloss":"to soften"},{"text":"உம்","lemma":"um","gloss":"habitual suffix"}],"gloss":"softens"},{"surface":"என்","parts":[{"text":"என்","lemma":"eṉ","gloss":"my"}],"gloss":"my"},{"surface":"நெஞ்சே","parts":[{"text":"நெஞ்சு","lemma":"neñcu","gloss":"heart"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"heart indeed"}]}],"literal":"On the red mountain bed, the mountain goat's kid / having drunk sweet milk pouring from the udder to its fill, / leaps in the shade of the big mountain, such is the lord of the land. / He is harder than stone, my friend. / Without saying 'he is hard-hearted', my heart softens.","translation":"O friend! The lord of the land where the young kid of the mountain goat drinks sweet milk pouring from the udder to its fill on its red mountain bed, and leaps playfully in the shade of the great mountain, is harder than stone. Yet, my heart, not realizing that he is so hard-hearted, continues to pine and waste away for him.","modern":"செம்மண் பாறைப் படுக்கையில், வரையாட்டின் குட்டி மடியிலிருந்து சுரந்து பொழியும் இனிய பாலை வயிறாரக் குடித்துவிட்டு, பெரிய மலையின் நிழலில் துள்ளி விளையாடும் நாட்டை உடையவன் தலைவன். தோழியே! அவன் கல்லை விடவும் நெஞ்சக் கடினமுடையவன். அவன் இரக்கமற்றவன் என்று நினைக்காமல், என் நெஞ்சம் அவனுக்காக உருகித் தளர்கிறது.","explanation":"This poem is set in the Kurinji (mountainous) landscape, spoken by the heroine to her friend. She laments the indifference of her lover, the lord of the mountains, who has delayed their marriage. The mountain goat's kid represents the heroine, who was once nurtured and happy in his love, just as the kid is nourished by sweet milk and plays happily in the mountain's shade. However, the lord himself remains unmoved by her suffering, showing a heart harder than the mountain stones. Despite recognizing his cruelty, the heroine's heart cannot detach itself and continues to pine for him, highlighting the helpless nature of her love.","model":"gemini-3.5-flash"}}