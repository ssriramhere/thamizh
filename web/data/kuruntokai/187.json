{"text":"kuruntokai","n":187,"lines":["செவ்வரைச் சேக்கை வருடை மான்மறி","சுரைபொழி தீம்பால் ஆர மாந்திப்","பெருவரை நீழ லுகளு நாடன்","கல்லினும் வலியன் தோழி","வலிய னென்னாது மெலியுமென் னெஞ்சே"],"tr":["cevvaraic cēkkai varuṭai māṉmaṟi","curaipoḻi tīmpāl āra māntip","peruvarai nīḻa lukaḷu nāṭaṉ","kalliṉum valiyaṉ tōḻi","valiya ṉeṉṉātu meliyumeṉ ṉeñcē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"கபிலர்","speaker_en":"the heroine (talaivi)","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 9, veṇṭaḷai 8, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"செவ்வரைச்","tr":"cevvaraic","foot":"kūviḷam","acai":[{"kind":"nēr","text":"செவ்","tr":"cev"},{"kind":"nirai","text":"வரைச்","tr":"varaic"}]},{"text":"சேக்கை","tr":"cēkkai","foot":"tēmā","acai":[{"kind":"nēr","text":"சேக்","tr":"cēk"},{"kind":"nēr","text":"கை","tr":"kai"}]},{"text":"வருடை","tr":"varuṭai","foot":"puḷimā","acai":[{"kind":"nirai","text":"வரு","tr":"varu"},{"kind":"nēr","text":"டை","tr":"ṭai"}]},{"text":"மான்மறி","tr":"māṉmaṟi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மான்","tr":"māṉ"},{"kind":"nirai","text":"மறி","tr":"maṟi"}]}],[{"text":"சுரைபொழி","tr":"curaipoḻi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சுரை","tr":"curai"},{"kind":"nirai","text":"பொழி","tr":"poḻi"}]},{"text":"தீம்பால்","tr":"tīmpāl","foot":"tēmā","acai":[{"kind":"nēr","text":"தீம்","tr":"tīm"},{"kind":"nēr","text":"பால்","tr":"pāl"}]},{"text":"ஆர","tr":"āra","foot":"tēmā","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nēr","text":"ர","tr":"ra"}]},{"text":"மாந்திப்","tr":"māntip","foot":"tēmā","acai":[{"kind":"nēr","text":"மாந்","tr":"mān"},{"kind":"nēr","text":"திப்","tr":"tip"}]}],[{"t