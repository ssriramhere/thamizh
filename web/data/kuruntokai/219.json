face":"செறிவும்","parts":[{"text":"செறிவு","lemma":"செறிவு","gloss":"modesty"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and modesty"},{"surface":"சேணிகந்தன்றே","parts":[{"text":"சேண்","lemma":"சேண்","gloss":"distance"},{"text":"இகந்தன்று","lemma":"இகத்தல்","gloss":"has gone beyond"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"has gone far indeed"},{"surface":"அறிவே","parts":[{"text":"அறிவு","lemma":"அறிவு","gloss":"understanding"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"understanding indeed"}]},{"words":[{"surface":"ஆங்கண்","parts":[{"text":"ஆங்கு","lemma":"ஆங்கு","gloss":"there"},{"text":"கண்","lemma":"கண்","gloss":"place"}],"gloss":"in that place"},{"surface":"செல்கம்","parts":[{"text":"செல்","lemma":"செல்","gloss":"go"},{"text":"கம்","lemma":"கம்","gloss":"we (subjunctive suffix)"}],"gloss":"let us go"},{"surface":"எழுக","parts":[{"text":"எழு","lemma":"எழு","gloss":"rise"},{"text":"க","lemma":"க","gloss":"optative suffix"}],"gloss":"let us rise"},{"surface":"என","parts":[{"text":"என்","lemma":"என்","gloss":"say"},{"text":"அ","lemma":"அ","gloss":"infinitive suffix"}],"gloss":"saying"},{"surface":"ஈங்கே","parts":[{"text":"ஈங்கு","lemma":"ஈங்கு","gloss":"here"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"right here"}]},{"words":[{"surface":"வல்லா","parts":[{"text":"வல்லா","lemma":"வல்லா","gloss":"unable"}],"gloss":"unable"},{"surface":"கூறி","parts":[{"text":"கூறு","lemma":"கூறு","gloss":"say"},{"text":"இ","lemma":"இ","gloss":"past participle suffix"}],"gloss":"having said"},{"surface":"இருக்கும்","parts":[{"text":"இரு","lemma":"இரு","gloss":"be"},{"text":"க்கும்","lemma":"க்கும்","gloss":"habitual relative participle suffix"}],"gloss":"which is"},{"surface":"முள்ளிலை","parts":[{"text":"முள்","lemma":"முள்","gloss":"thorn"},{"text":"இலை","lemma":"இலை","gloss":"leaf"}],"gloss":"thorny leaf"}]},{"words":[{"surface":"தடவுநிலைத்","parts":[{"text":"தடவுநிலைத்","lemma":"தடவுநிலைத்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தாழைச்","parts":[{"text":"தாழைச்","lemma":"தாழைச்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"சேர்ப்பர்க்","parts":[{"text":"சேர்ப்பர்க்","lemma":"சேர்ப்பர்க்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"கிடமற்","parts":[{"text":"கிடமற்","lemma":"கிடமற்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"றோழியெந்","parts":[{"text":"றோழியெந்","lemma":"றோழியெந்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"நீரிரோ","parts":[{"text":"நீரிரோ","lemma":"நீரிரோ","gloss":""}],"gloss":"","split_unverified":true},{"surface":"வெனினே","parts":[{"text":"வெனினே","lemma":"வெனினே","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true}],"literal":"My paleness is on my body / in the path of the heart of him who loves me, which is devoid of affection / and my modesty and my mind have gone far away / saying 'let us rise and go there!' / where the thorny-leaved / curved screwpine trees stand unable to speak, to the place of the lord of the shore / if you ask, 'O friend, what is your state?'","translation":"My body is pale. My modesty and my mind have gone far away, saying 'let us rise and go there!' to the shore of the lord, where thorny-leaved, curved screwpine trees stand unable to speak, into the heart of him who loved me, which is now devoid of affection. O friend, if you ask 'what is your state?', this is indeed it.","modern":"தோழியே! 'உன் நிலைமை என்ன?' என்று நீ கேட்டால், என் உடம்பில் பசலை படர்ந்துள்ளது. என்னை விரும்பியவருடைய அன்பில்லாத நெஞ்சத்தின் வழியே, 'அங்கே எழுந்து செல்வோம்' என்று கூறி, என் அடக்கமும் அறிவும் வெகுதூரம் கடந்து சென்றுவிட்டன. அது, முட்களைக் கொண்ட இலைகளையுடைய வளைந்த தாழை மரங்கள் பேச இயலாமல் நிற்கின்ற கடற்கரைத் தலைவனுடைய இடமாகும்.","explanation":"The heroine is speaking to her confidante (tōḻi) who has asked about her deteriorating physical and mental state due to the hero's prolonged absence. She explains that her body has turned pale with grief, while her modesty (ceṟivu) and her intellect (aṟivu) have abandoned her, rushing towards the hero's coastal land. She describes his land as a place where thorny-leaved, curved screwpine (tāḻai) trees stand in silence, unable to speak. This image of the silent, thorny screwpine reflects her own helpless state of suffering in silence, unable to express her grief to the indifferent hero. The poem belongs to the neytal tiṇai (maritime landscape), where themes of anxious waiting and separation are heightened by the harsh coastal elements.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,0.9],[0.96,1.2],[1.2,1.7],[1.7,2.6],[2.6,2.98],[2.98,3.15],[3.3,3.7],[3.7,4.5],[4.6,5.1],[5.2,5.4],[5.7,6.0],[6.16,6.64],[6.8,7.5],[7.5,7.6],[7.6,7.6],[7.6,7.6],[7.6,9.33],[9.33,10.93],[10.93,10.93],[10.93,11.2],[11.2,11.7],[11.9,12.5],[12.83,13.0],[13.0,13.4],[13.53,13.63]],"female":[[0.0,0.9],[0.9,1.1],[1.2,1.5],[1.81,2.1],[2.1,2.9],[2.9,2.98],[3.23,3.34],[3.45,3.9],[3.94,3.98],[3.98,3.98],[3.98,4.06],[4.58,6.5],[6.5,6.78],[6.92,7.2],[7.2,8.0],[8.0,8.24],[8.24,8.24],[8.24,10.13],[10.13,11.05],[11.05,12.2],[12.4,12.5],[12.5,14.0],[14.33,14.5],[14.5,14.67],[14.67,14.67],[14.67,15.17]]},"sync":[[["பயப்பென்","my paleness"]],[["மேனி","body"]],[["அதுவே","that indeed"]],[["நயப்பவர்","he who loves"]],[["நாரில்","without affection"]],[["நெஞ்சத்தார்","those of the heart"]],[["நெஞ்சத்தார்","those of the heart"],["இடை","path"]],[["அதுவே","that indeed"]],[["செறிவும்","and modesty"]],[["சேணிகந்தன்றே","has gone far indeed"]],[["சேணிகந்தன்றே","has gone far indeed"]],[["அறிவே","understanding indeed"]],[["ஆங்கண்","in that place"]],[["செல்கம்","let us go"]],[["எழுக","let us rise"],["என","saying"]],[["ஈங்கே","right here"]],[["வல்லா","unable"]],[["கூறி","having said"],["இருக்கும்","which is"]],[["முள்ளிலை","thorny leaf"]],[["தடவுநிலைத்",""]],[["தாழைச்",""]],[["சேர்ப்பர்க்",""]],[["கிடமற்",""]],[["றோழியெந்",""]],[["நீரிரோ",""]],[["வெனினே",""]]]}