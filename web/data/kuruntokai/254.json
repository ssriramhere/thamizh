{"text":"kuruntokai","n":254,"lines":["இலையி லஞ்சினை யினவண் டார்ப்ப","முலையேர் மென்முகை அவிழ்ந்த கோங்கின்","தலையலர் வந்தன வாரா தோழி","துயிலின் கங்குல் துயிலவர் மறந்தனர்","பயினறுங் கதுப்பிற் பாயலு முள்ளார்","செய்பொருள் தரனசைஇச் சென்றோர்","எய்தின ராலென வரூஉந் தூதே"],"tr":["ilaiyi lañciṉai yiṉavaṇ ṭārppa","mulaiyēr meṉmukai aviḻnta kōṅkiṉ","talaiyalar vantaṉa vārā tōḻi","tuyiliṉ kaṅkul tuyilavar maṟantaṉar","payiṉaṟuṅ katuppiṟ pāyalu muḷḷār","ceyporuḷ taraṉacaiic ceṉṟōr","eytiṉa rāleṉa varūun tūtē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"பார்காப்பானார்","speaker_en":"the heroine (talaivi)","poet_tr":"Pārkāppāṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 9"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இலையி","tr":"ilaiyi","foot":"puḷimā","acai":[{"kind":"nirai","text":"இலை","tr":"ilai"},{"kind":"nēr","text":"யி","tr":"yi"}]},{"text":"லஞ்சினை","tr":"lañciṉai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"லஞ்","tr":"lañ"},{"kind":"nirai","text":"சினை","tr":"ciṉai"}]},{"text":"யினவண்","tr":"yiṉavaṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"யின","tr":"yiṉa"},{"kind":"nēr","text":"வண்","tr":"vaṇ"}]},{"text":"டார்ப்ப","tr":"ṭārppa","foot":"tēmā","acai":[{"kind":"nēr","text":"டார்ப்","tr":"ṭārp"},{"kind":"nēr","text":"ப","tr":"pa"}]}],[{"text":"முலையேர்","tr":"mulaiyēr","foot":"puḷimā","acai":[{"kind":"nirai","text":"முலை","tr":"mulai"},{"kind":"nēr","text":"யேர்","tr":"yēr"}]},{"text":"மென்முகை","tr":"meṉmukai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மென்","tr":"meṉ"},{"kind":"nirai","text":"முகை","tr":"mukai"}]},{"text":"அவிழ்ந்த","tr":"aviḻnta","foot":"puḷimā","acai":[{"kind":"nirai","text":"அவிழ்ந்","tr":"aviḻn"},{"kind":"nēr","