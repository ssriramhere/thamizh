{"text":"kuruntokai","n":233,"lines":["கவலை கெண்டிய அகல்வாய்ச் சிறுகுழி","கொன்றை யொள்வீ தாஅய்ச் செல்வர்","பொன்பெய் பேழை மூய்திறந் தன்ன","காரெதிர் புறவி னதுவே உயர்ந்தோர்க்கு","நீரொடு சொரிந்த மிச்சில் யாவர்க்கும்","வரைகோ ளறியாச் சொன்றி","நிரைகோற் குறுந்தொடி தந்தை யூரே"],"tr":["kavalai keṇṭiya akalvāyc ciṟukuḻi","koṉṟai yoḷvī tāayc celvar","poṉpey pēḻai mūytiṟan taṉṉa","kāretir puṟavi ṉatuvē uyarntōrkku","nīroṭu corinta miccil yāvarkkum","varaikō ḷaṟiyāc coṉṟi","niraikōṟ kuṟuntoṭi tantai yūrē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவன் கூற்று","poet_ta":"பேயனார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Pēyaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 10, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கவலை","tr":"kavalai","foot":"puḷimā","acai":[{"kind":"nirai","text":"கவ","tr":"kava"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"கெண்டிய","tr":"keṇṭiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கெண்","tr":"keṇ"},{"kind":"nirai","text":"டிய","tr":"ṭiya"}]},{"text":"அகல்வாய்ச்","tr":"akalvāyc","foot":"puḷimā","acai":[{"kind":"nirai","text":"அகல்","tr":"akal"},{"kind":"nēr","text":"வாய்ச்","tr":"vāyc"}]},{"text":"சிறுகுழி","tr":"ciṟukuḻi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nirai","text":"குழி","tr":"kuḻi"}]}],[{"text":"கொன்றை","tr":"koṉṟai","foot":"tēmā","acai":[{"kind":"nēr","text":"கொன்","tr":"koṉ"},{"kind":"nēr","text":"றை","tr":"ṟai"}]},{"text":"யொள்வீ","tr":"yoḷvī","foot":"tēmā","acai":[{"kind":"nēr","text":"யொள்","tr":"yoḷ"},{"kind":"nēr","text":"வீ","tr":"vī"}]},{"text":"தாஅய்ச்","tr":"tāayc","foot":"tēmā","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"அய்ச்","tr"