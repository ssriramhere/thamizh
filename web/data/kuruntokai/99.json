{"text":"kuruntokai","n":99,"lines":["உள்ளினென் அல்லனோ யானே உள்ளி","நினைத்தனென் அல்லனோ பெரிதே நினைத்து","மருண்டனென் அல்லனோ உலகத்துப் பண்பே","நீடிய மராஅத்த கோடுதோய் மலிர்நிறை","இறைத்துணச் சென்றற் றாஅங்கு","அனைப்பெருங் காமம் மீண்டுகடைக் கொளவே"],"tr":["uḷḷiṉeṉ allaṉō yāṉē uḷḷi","niṉaittaṉeṉ allaṉō peritē niṉaittu","maruṇṭaṉeṉ allaṉō ulakattup paṇpē","nīṭiya marāatta kōṭutōy malirniṟai","iṟaittuṇac ceṉṟaṟ ṟāaṅku","aṉaipperuṅ kāmam mīṇṭukaṭaik koḷavē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவன் கூற்று","poet_ta":"ஔவையார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 11, āciriyattaḷai 9, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"உள்ளினென்","tr":"uḷḷiṉeṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"உள்","tr":"uḷ"},{"kind":"nirai","text":"ளினென்","tr":"ḷiṉeṉ"}]},{"text":"அல்லனோ","tr":"allaṉō","foot":"kūviḷam","acai":[{"kind":"nēr","text":"அல்","tr":"al"},{"kind":"nirai","text":"லனோ","tr":"laṉō"}]},{"text":"யானே","tr":"yāṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னே","tr":"ṉē"}]},{"text":"உள்ளி","tr":"uḷḷi","foot":"tēmā","acai":[{"kind":"nēr","text":"உள்","tr":"uḷ"},{"kind":"nēr","text":"ளி","tr":"ḷi"}]}],[{"text":"நினைத்தனென்","tr":"niṉaittaṉeṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நினைத்","tr":"niṉait"},{"kind":"nirai","text":"தனென்","tr":"taṉeṉ"}]},{"text":"அல்லனோ","tr":"allaṉō","foot":"kūviḷam","acai":[{"kind":"nēr","text":"அல்","tr":"al"},{"kind":"nirai","text":"லனோ","tr":"laṉō"}]},{"text":"பெரிதே","tr":"peritē","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெரி","tr":"peri"},{"kind":"nēr","text":"தே","tr":"tē"}]},{"text":"நினைத்து","tr":"niṉaittu",