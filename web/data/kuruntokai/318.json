{"text":"kuruntokai","n":318,"lines":["எறிசுறாக் கலித்த இலங்குநீர்ப் பரப்பின்","நறுவீ ஞாழலொடு புன்னை தாஅய்","வெறியயர் களத்தினில் தோன்றுந் துறைவன்","குறியா னாயினும் குறிப்பினும் பிறிதொன்","றறியாற் குரைப்பலோ யானே யெய்த்தவிப்","பணையெழின் மென்றோ ளணைஇய வந்நாட்","பிழையா வஞ்சினஞ் செய்த","கள்வனும் கடவனும் புனைவனுந் தானே"],"tr":["eṟicuṟāk kalitta ilaṅkunīrp parappiṉ","naṟuvī ñāḻaloṭu puṉṉai tāay","veṟiyayar kaḷattiṉil tōṉṟun tuṟaivaṉ","kuṟiyā ṉāyiṉum kuṟippiṉum piṟitoṉ","ṟaṟiyāṟ kuraippalō yāṉē yeyttavip","paṇaiyeḻiṉ meṉṟō ḷaṇaiiya vannāṭ","piḻaiyā vañciṉañ ceyta","kaḷvaṉum kaṭavaṉum puṉaivaṉun tāṉē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"அம்மூவனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Ammūvaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 16, āciriyattaḷai 14"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"எறிசுறாக்","tr":"eṟicuṟāk","foot":"karuviḷam","acai":[{"kind":"nirai","text":"எறி","tr":"eṟi"},{"kind":"nirai","text":"சுறாக்","tr":"cuṟāk"}]},{"text":"கலித்த","tr":"kalitta","foot":"puḷimā","acai":[{"kind":"nirai","text":"கலித்","tr":"kalit"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"இலங்குநீர்ப்","tr":"ilaṅkunīrp","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இலங்","tr":"ilaṅ"},{"kind":"nirai","text":"குநீர்ப்","tr":"kunīrp"}]},{"text":"பரப்பின்","tr":"parappiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பரப்","tr":"parap"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]}],[{"text":"நறுவீ","tr":"naṟuvī","foot":"puḷimā","acai":[{"kind":"nirai","text":"நறு","tr":"naṟu"},{"kind":"nēr","text":"வீ","tr":"vī"}]},{"text":"ஞாழலொடு","tr":"ñāḻaloṭu","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"ஞா","tr":"ñā"},{"kind":"nirai","text":"ழலொ","tr":"