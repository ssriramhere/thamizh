{"text":"kuruntokai","n":318,"lines":["எறிசுறாக் கலித்த இலங்குநீர்ப் பரப்பின்","நறுவீ ஞாழலொடு புன்னை தாஅய்","வெறியயர் களத்தினில் தோன்றுந் துறைவன்","குறியா னாயினும் குறிப்பினும் பிறிதொன்","றறியாற் குரைப்பலோ யானே யெய்த்தவிப்","பணையெழின் மென்றோ ளணைஇய வந்நாட்","பிழையா வஞ்சினஞ் செய்த","கள்வனும் கடவனும் புனைவனுந் தானே"],"tr":["eṟicuṟāk kalitta ilaṅkunīrp parappiṉ","naṟuvī ñāḻaloṭu puṉṉai tāay","veṟiyayar kaḷattiṉil tōṉṟun tuṟaivaṉ","kuṟiyā ṉāyiṉum kuṟippiṉum piṟitoṉ","ṟaṟiyāṟ kuraippalō yāṉē yeyttavip","paṇaiyeḻiṉ meṉṟō ḷaṇaiiya vannāṭ","piḻaiyā vañciṉañ ceyta","kaḷvaṉum kaṭavaṉum puṉaivaṉun tāṉē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"அம்மூவனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Ammūvaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 16, āciriyattaḷai 14"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"எறிசுறாக்","tr":"eṟicuṟāk","foot":"karuviḷam","acai":[{"kind":"nirai","text":"எறி","tr":"eṟi"},{"kind":"nirai","text":"சுறாக்","tr":"cuṟāk"}]},{"text":"கலித்த","tr":"kalitta","foot":"puḷimā","acai":[{"kind":"nirai","text":"கலித்","tr":"kalit"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"இலங்குநீர்ப்","tr":"ilaṅkunīrp","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இலங்","tr":"ilaṅ"},{"kind":"nirai","text":"குநீர்ப்","tr":"kunīrp"}]},{"text":"பரப்பின்","tr":"parappiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பரப்","tr":"parap"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]}],[{"text":"நறுவீ","tr":"naṟuvī","foot":"puḷimā","acai":[{"kind":"nirai","text":"நறு","tr":"naṟu"},{"kind":"nēr","text":"வீ","tr":"vī"}]},{"text":"ஞாழலொடு","tr":"ñāḻaloṭu","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"ஞா","tr":"ñā"},{"kind":"nirai","text":"ழலொ","tr":"ḻalo"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"புன்னை","tr":"puṉṉai","foot":"tēmā","acai":[{"kind":"nēr","text":"புன்","tr":"puṉ"},{"kind":"nēr","text":"னை","tr":"ṉai"}]},{"text":"தாஅய்","tr":"tāay","foot":"tēmā","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"அய்","tr":"ay"}]}],[{"text":"வெறியயர்","tr":"veṟiyayar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வெறி","tr":"veṟi"},{"kind":"nirai","text":"யயர்","tr":"yayar"}]},{"text":"களத்தினில்","tr":"kaḷattiṉil","foot":"karuviḷam","acai":[{"kind":"nirai","text":"களத்","tr":"kaḷat"},{"kind":"nirai","text":"தினில்","tr":"tiṉil"}]},{"text":"தோன்றுந்","tr":"tōṉṟun","foot":"tēmā","acai":[{"kind":"nēr","text":"தோன்","tr":"tōṉ"},{"kind":"nēr","text":"றுந்","tr":"ṟun"}]},{"text":"துறைவன்","tr":"tuṟaivaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"துறை","tr":"tuṟai"},{"kind":"nēr","text":"வன்","tr":"vaṉ"}]}],[{"text":"குறியா","tr":"kuṟiyā","foot":"puḷimā","acai":[{"kind":"nirai","text":"குறி","tr":"kuṟi"},{"kind":"nēr","text":"யா","tr":"yā"}]},{"text":"னாயினும்","tr":"ṉāyiṉum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"னா","tr":"ṉā"},{"kind":"nirai","text":"யினும்","tr":"yiṉum"}]},{"text":"குறிப்பினும்","tr":"kuṟippiṉum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குறிப்","tr":"kuṟip"},{"kind":"nirai","text":"பினும்","tr":"piṉum"}]},{"text":"பிறிதொன்","tr":"piṟitoṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிறி","tr":"piṟi"},{"kind":"nēr","text":"தொன்","tr":"toṉ"}]}],[{"text":"றறியாற்","tr":"ṟaṟiyāṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"றறி","tr":"ṟaṟi"},{"kind":"nēr","text":"யாற்","tr":"yāṟ"}]},{"text":"குரைப்பலோ","tr":"kuraippalō","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குரைப்","tr":"kuraip"},{"kind":"nirai","text":"பலோ","tr":"palō"}]},{"text":"யானே","tr":"yāṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னே","tr":"ṉē"}]},{"text":"யெய்த்தவிப்","tr":"yeyttavip","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யெய்