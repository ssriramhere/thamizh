:"nirai","text":"குவ","tr":"kuva"},{"kind":"nēr","text":"ளை","tr":"ḷai"}]},{"text":"யுண்கண்","tr":"yuṇkaṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"யுண்","tr":"yuṇ"},{"kind":"nēr","text":"கண்","tr":"kaṇ"}]},{"text":"கலுழப்","tr":"kaluḻap","foot":"puḷimā","acai":[{"kind":"nirai","text":"கலு","tr":"kalu"},{"kind":"nēr","text":"ழப்","tr":"ḻap"}]}],[{"text":"பசலை","tr":"pacalai","foot":"puḷimā","acai":[{"kind":"nirai","text":"பச","tr":"paca"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"யாகா","tr":"yākā","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"கா","tr":"kā"}]},{"text":"வூங்கலங்","tr":"vūṅkalaṅ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வூங்","tr":"vūṅ"},{"kind":"nirai","text":"கலங்","tr":"kalaṅ"}]},{"text":"கடையே","tr":"kaṭaiyē","foot":"puḷimā","acai":[{"kind":"nirai","text":"கடை","tr":"kaṭai"},{"kind":"nēr","text":"யே","tr":"yē"}]}]]},"ai":{"lines":[{"words":[{"surface":"நறையகில்","parts":[{"text":"நறை","lemma":"naṟai","gloss":"fragrance"},{"text":"அகில்","lemma":"akil","gloss":"eaglewood"}],"gloss":"fragrant eaglewood"},{"surface":"வயங்கிய","parts":[{"text":"வயங்கிய","lemma":"vayaṅku","gloss":"shining"}],"gloss":"rising"},{"surface":"நளிபுன","parts":[{"text":"நளிபுன","lemma":"நளிபுன","gloss":"dense upland field"}],"gloss":"dense upland field","split_unverified":true},{"surface":"நறும்புகை","parts":[{"text":"நறும்புகை","lemma":"நறும்புகை","gloss":"fragrant smoke"}],"gloss":"fragrant smoke","split_unverified":true}]},{"words":[{"surface":"உறையறு","parts":[{"text":"உறை","lemma":"uṟai","gloss":"rain drop"},{"text":"அறு","lemma":"aṟu","gloss":"ceased"}],"gloss":"rain-ceased"},{"surface":"மையின்","parts":[{"text":"மை","lemma":"mai","gloss":"dark cloud"},{"text":"இன்","lemma":"iṉ","gloss":"like"}],"gloss":"like a dark cloud"},{"surface":"போகிச்","parts":[{"text":"போகிச்","lemma":"போகிச்","gloss":"rising"}],"gloss":"rising","split_unverified":true},{"surface":"சாரல்","parts":[{"text":"சாரல்","lemma":"cāral","gloss":"mountain slope"}],"gloss":"mountain slope"}]},{"words":[{"surface":"குறவர்","parts":[{"text":"குறவர்","lemma":"kuṟavar","gloss":"hill-dwellers"}],"gloss":"hill-dwellers"},{"surface":"பாக்கத்து","parts":[{"text":"பாக்கத்து","lemma":"பாக்கத்து","gloss":"in the hamlet"}],"gloss":"in the hamlet","split_unverified":true},{"surface":"இழிதரு","parts":[{"text":"இழி","lemma":"iḻi","gloss":"descend"},{"text":"தரு","lemma":"taru","gloss":"auxiliary verb of direction"}],"gloss":"descending"},{"surface":"நாடன்","parts":[{"text":"நாடு","lemma":"nāṭu","gloss":"land"},{"text":"அன்","lemma":"aṉ","gloss":"he"}],"gloss":"lord of the land"}]},{"words":[{"surface":"மயங்குமலர்க்","parts":[{"text":"மயங்குமலர்க்","lemma":"மயங்குமலர்க்","gloss":"mixed flowers"}],"gloss":"mixed flowers","split_unverified":true},{"surface":"கோதை","parts":[{"text":"கோதை","lemma":"kōtai","gloss":"garland"}],"gloss":"garland"},{"surface":"நன்மார்பு","parts":[{"text":"நன்மார்பு","lemma":"நன்மார்பு","gloss":"beautiful chest"}],"gloss":"beautiful chest","split_unverified":true},{"surface":"முயங்கல்","parts":[{"text":"முயங்கல்","lemma":"muyaṅku","gloss":"embracing"}],"gloss":"embracing"}]},{"words":[{"surface":"இனிதுமன்","parts":[{"text":"இனிது","lemma":"iṉitu","gloss":"sweet"},{"text":"மன்","lemma":"maṉ","gloss":"indeed"}],"gloss":"is sweet indeed"},{"surface":"வாழி","parts":[{"text":"வாழி","lemma":"vāḻi","gloss":"may you live long"}],"gloss":"may you live long"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"tōḻi","gloss":"friend"}],"gloss":"friend"},{"surface":"மாயிதழ்க்","parts":[{"text":"மாயிதழ்க்","lemma":"மாயிதழ்க்","gloss":"dark-petalled"}],"gloss":"dark-petalled","split_unverified":true}]},{"words":[{"surface":"குவளை","parts":[{"text":"குவளை","lemma":"kuvaḷai","gloss":"blue water-lily"}],"gloss":"blue water-lily"},{"surface":"உண்கண்","parts":[{"text":"உண்","lemma":"uṇ","gloss":"painted with collyrium"},{"text":"கண்","lemma":"kaṇ","gloss":"eye"}],"gloss":"collyrium-painted eyes"},{"surface":"கலுழப்","parts":[{"text":"கலுழப்","lemma":"கலுழப்","gloss":"to weep"}],"gloss":"to weep","split_unverified":true}]},{"words":[{"surface":"பசலை","parts":[{"text":"பசலை","lemma":"pacalai","gloss":"pallor"}],"gloss":"pallor"},{"surface":"ஆகா","parts":[{"text":"ஆகா","lemma":"ā","gloss":"not becoming"}],"gloss":"not spreading"},{"surface":"ஊங்கு","parts":[{"text":"ஊங்கு","lemma":"ūṅku","gloss":"before"}],"gloss":"before"},{"surface":"அலங்கடையே","parts":[{"text":"அலங்கடை","lemma":"alaṅkaṭai","gloss":"unless"},{"text":"ஏ","lemma":"ē","gloss":"emphatic"}],"gloss":"unless"}]}],"literal":"Fragrant eaglewood burning in the dense upland field, the fragrant smoke / rising like a rain-ceased dark cloud, over the mountain slope / descending into the hamlet of the hill-dwellers, the lord of such a land, / embracing his beautiful chest wearing a garland of mixed flowers, / is sweet indeed, may you live long, my friend! But dark-petalled / blue water-lily-like collyrium-painted eyes weeping, / unless it is before the pallor of separation spreads.","translation":"May you live long, my friend! Embracing the beautiful chest, adorned with a garland of mixed flowers, of the lord of the land where the fragrant smoke of burning eaglewood from the dense upland fields rises like a rainless dark cloud and descends over the mountain slopes into the hamlet of the hill-dwellers, is sweet indeed—but only if it happens before our dark-petalled, blue-lily-like eyes weep and the pallor of separation spreads over us.","modern":"தோழியே! நீ வாழ்க! அடர்ந்த கொல்லைப் புனத்தில் எரிக்கப்படும் நறிய அகில் கட்டையின் நறுமணப் புகை, மழையற்ற கரிய மேகத்தைப் போல எழுந்து, மலைச்சாரலில் உள்ள குறவர்களின் சிற்றூர்களில் இறங்கிப் பரவும் நாட்டை உடையவன் தலைவன். அவனுடைய கலம்பக மலர்மாலை அணிந்த மார்பைத் தழுவுவது மிகவும் இன்பமானதுதான். ஆனால், கரிய இதழ்களைக் கொண்ட குவளை மலர் போன்ற மை தீட்டிய கண்கள் அழுது வருந்தவும், உடலில் பசலை நோய் படரவும் தொடங்குவதற்கு முன்னரே அது நிகழாவிட்டால், அந்தத் தழுவலால் என்ன பயன்?","explanation":"The confidante (tōḻi) is speaking to the heroine (talaivi) about the hero's secret visits. She acknowledges that embracing the hero, who is the lord of the mountain slopes, is indeed sweet. However, she points out that this joy is meaningless if it does not lead to a permanent union before the heroine wastes away from the pain of separation. The imagery of the fragrant eaglewood smoke rising like a dark cloud and descending into the mountain hamlet represents the hero's love, which should envelop the heroine's life completely rather than being a fleeting, secret occurrence. The poem belongs to the Kuriñci tiṇai (mountain landscape), using the elements of the hills, hill-dwellers, and mountain slopes to frame the emotional urgency of marriage.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.8],[0.8,1.3],[1.3,1.9],[1.9,2.3],[2.3,2.93],[3.24,3.4],[3.4,3.52],[3.65,3.9],[4.08,4.62],[4.62,4.8],[4.98,5.16],[5.16,5.34],[5.34,5.34],[5.34,5.34],[5.34,8.5],[8.5,8.59],[8.59,9.7],[9.7,10.2],[10.2,10.4],[10.4,11.0],[11.0,11.8],[11.8,11.8],[11.8,12.6],[12.6,13.5],[13.5,13.62],[13.62,13.99],[13.99,14.6]],"female":[[0.0,0.9],[0.9,1.4],[1.4,1.9],[1.9,2.5],[2.5,2.61],[2.73,3.3],[3.3,4.5],[4.5,4.5],[4.5,5.7],[5.7,5.7],[5.7,6.48],[6.7,6.7],[6.7,6.7],[6.7,6.7],[6.7,9.4],[9.4,9.57],[9.6,11.4],[11.4,11.8],[11.8,12.2],[12.2,13.0],[13.0,13.6],[13.65,13.9],[13.9,14.4],[14.4,14.68],[14.68,14.68],[14.68,15.51],[15.51,16.9]]},"sync":[[["நறையகில்","fragrant eaglewood"]],[["வயங்கிய","rising"]],[["நளிபுன","dense upland field"]],[["நறும்புகை","fragrant smoke"]],[["உறையறு","rain-ceased"]],[["மையின்","like a dark cloud"]],[["போகிச்","rising"]],[["சாரல்","mountain slope"]],[["குறவர்","hill-dwellers"]],[["பாக்கத்து","in the hamlet"]],[["பாக்கத்து","in the hamlet"],["இழிதரு","descending"]],[["நாடன்","lord of the land"]],[["மயங்குமலர்க்","mixed flowers"]],[["கோதை","garland"]],[["நன்மார்பு","beautiful chest"]],[["முயங்கல்","embracing"]],[["இனிதுமன்","is sweet indeed"]],[["வாழி","may you live long"]],[["தோழி","friend"]],[["மாயிதழ்க்","dark-petalled"]],[["குவளை","blue water-lily"]],[["உண்கண்","collyrium-painted eyes"]],[["கலுழப்","to weep"]],[["பசலை","pallor"]],[["ஆகா","not spreading"]],[["ஊங்கு","before"],["அலங்கடையே","unless"]],[["அலங்கடையே","unless"]]]}