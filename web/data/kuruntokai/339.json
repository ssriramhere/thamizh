{"text":"kuruntokai","n":339,"lines":["நறையகில் வயங்கிய நளிபுன நறும்புகை","உறையறு மையிற் போகிச் சாரற்","குறவர் பாக்கத் திழிதரு நாடன்","மயங்குமலர்க் கோதை நன்மார்பு முயங்கல்","இனிதுமன் வாழி தோழி மாயிதழ்க்","குவளை யுண்கண் கலுழப்","பசலை யாகா வூங்கலங் கடையே"],"tr":["naṟaiyakil vayaṅkiya naḷipuṉa naṟumpukai","uṟaiyaṟu maiyiṟ pōkic cāraṟ","kuṟavar pākkat tiḻitaru nāṭaṉ","mayaṅkumalark kōtai naṉmārpu muyaṅkal","iṉitumaṉ vāḻi tōḻi māyitaḻk","kuvaḷai yuṇkaṇ kaluḻap","pacalai yākā vūṅkalaṅ kaṭaiyē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"பேயார்","speaker_en":"her friend (tōḻi)","poet_tr":"Pēyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 10, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நறையகில்","tr":"naṟaiyakil","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நறை","tr":"naṟai"},{"kind":"nirai","text":"யகில்","tr":"yakil"}]},{"text":"வயங்கிய","tr":"vayaṅkiya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வயங்","tr":"vayaṅ"},{"kind":"nirai","text":"கிய","tr":"kiya"}]},{"text":"நளிபுன","tr":"naḷipuṉa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நளி","tr":"naḷi"},{"kind":"nirai","text":"புன","tr":"puṉa"}]},{"text":"நறும்புகை","tr":"naṟumpukai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நறும்","tr":"naṟum"},{"kind":"nirai","text":"புகை","tr":"pukai"}]}],[{"text":"உறையறு","tr":"uṟaiyaṟu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"உறை","tr":"uṟai"},{"kind":"nirai","text":"யறு","tr":"yaṟu"}]},{"text":"மையிற்","tr":"maiyiṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"மை","tr":"mai"},{"kind":"nēr","text":"யிற்","tr":"yiṟ"}]},{"text":"போகிச்","tr":"pōkic","foot":"tēmā","acai":[{"kind":"nēr","text":"போ","tr":"p