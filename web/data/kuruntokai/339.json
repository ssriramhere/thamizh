:"nirai","text":"குவ","tr":"kuva"},{"kind":"nēr","text":"ளை","tr":"ḷai"}]},{"text":"யுண்கண்","tr":"yuṇkaṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"யுண்","tr":"yuṇ"},{"kind":"nēr","text":"கண்","tr":"kaṇ"}]},{"text":"கலுழப்","tr":"kaluḻap","foot":"puḷimā","acai":[{"kind":"nirai","text":"கலு","tr":"kalu"},{"kind":"nēr","text":"ழப்","tr":"ḻap"}]}],[{"text":"பசலை","tr":"pacalai","foot":"puḷimā","acai":[{"kind":"nirai","text":"பச","tr":"paca"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"யாகா","tr":"yākā","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"கா","tr":"kā"}]},{"text":"வூங்கலங்","tr":"vūṅkalaṅ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வூங்","tr":"vūṅ"},{"kind":"nirai","text":"கலங்","tr":"kalaṅ"}]},{"text":"கடையே","tr":"kaṭaiyē","foot":"puḷimā","acai":[{"kind":"nirai","text":"கடை","tr":"kaṭai"},{"kind":"nēr","text":"யே","tr":"yē"}]}]]},"ai":{"lines":[{"words":[{"surface":"நறையகில்","parts":[{"text":"நறையகில்","lemma":"நறையகில்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"வயங்கிய","parts":[{"text":"வயங்கிய","lemma":"வயங்கிய","gloss":""}],"gloss":"","split_unverified":true},{"surface":"நளிபுன","parts":[{"text":"நளிபுன","lemma":"நளிபுன","gloss":""}],"gloss":"","split_unverified":true},{"surface":"நறும்புகை","parts":[{"text":"நறும்புகை","lemma":"நறும்புகை","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"உறை","parts":[{"text":"உறை","lemma":"uṟai","gloss":"rain"}],"gloss":"rain"},{"surface":"அறு","parts":[{"text":"அறு","lemma":"aṟu","gloss":"cease"}],"gloss":"ceased"},{"surface":"மையின்","parts":[{"text":"மை","lemma":"mai","gloss":"dark cloud"},{"text":"இன்","lemma":"iṉ","gloss":"like"}],"gloss":"like a dark cloud"},{"surface":"போகி","parts":[{"text":"போகு","lemma":"pōku","gloss":"go"},{"text":"இ","lemma":"i","gloss":"having"}],"gloss":"having gone"},{"surface":"சாரல்","parts":[{"text":"சாரல்","lemma":"cāral","gloss":"mountain slope"}],"gloss":"mountain slope"}]},{"words":[{"surface":"குறவர்","parts":[{"text":"குறவர்","lemma":"kuṟavar","gloss":"hill-dwellers"}],"gloss":"hill-dwellers"},{"surface":"பாக்கத்து","parts":[{"text":"பாக்கத்து","lemma":"பாக்கத்து","gloss":"in the hamlet"}],"gloss":"in the hamlet","split_unverified":true},{"surface":"இழிதரு","parts":[{"text":"இழி","lemma":"iḻi","gloss":"descend"},{"text":"தரு","lemma":"taru","gloss":"auxiliary verb"}],"gloss":"descending"},{"surface":"நாடன்","parts":[{"text":"நாடு","lemma":"nāṭu","gloss":"land"},{"text":"அன்","lemma":"aṉ","gloss":"he"}],"gloss":"lord of the land"}]},{"words":[{"surface":"மயங்குமலர்க்","parts":[{"text":"மயங்குமலர்க்","lemma":"மயங்குமலர்க்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"கோதை","parts":[{"text":"கோதை","lemma":"கோதை","gloss":""}],"gloss":"","split_unverified":true},{"surface":"நன்மார்பு","parts":[{"text":"நன்மார்பு","lemma":"நன்மார்பு","gloss":""}],"gloss":"","split_unverified":true},{"surface":"முயங்கல்","parts":[{"text":"முயங்கல்","lemma":"முயங்கல்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"இனிது","parts":[{"text":"இனிது","lemma":"initu","gloss":"sweet"}],"gloss":"is sweet"},{"surface":"மன்","parts":[{"text":"மன்","lemma":"maṉ","gloss":"indeed"}],"gloss":"indeed"},{"surface":"வாழி","parts":[{"text":"வாழி","lemma":"vāḻi","gloss":"may you live long"}],"gloss":"may you live long"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"tōḻi","gloss":"friend"}],"gloss":"O friend"},{"surface":"மா","parts":[{"text":"மா","lemma":"mā","gloss":"dark"}],"gloss":"dark"},{"surface":"இதழ்","parts":[{"text":"இதழ்","lemma":"itaḻ","gloss":"petal"}],"gloss":"petal"}]},{"words":[{"surface":"குவளை","parts":[{"text":"குவளை","lemma":"kuvaḷai","gloss":"blue water-lily"}],"gloss":"blue water-lily"},{"surface":"உண்கண்","parts":[{"text":"உண்","lemma":"uṇ","gloss":"kohl-adorned"},{"text":"கண்","lemma":"kaṇ","gloss":"eye"}],"gloss":"kohl-adorned eyes"},{"surface":"கலுழ","parts":[{"text":"கலுழ்","lemma":"kaluḻ","gloss":"weep"},{"text":"அ","lemma":"a","gloss":"infinitive suffix"}],"gloss":"to weep"}]},{"words":[{"surface":"பசலை","parts":[{"text":"பசலை","lemma":"பசலை","gloss":""}],"gloss":"","split_unverified":true},{"surface":"யாகா","parts":[{"text":"யாகா","lemma":"யாகா","gloss":""}],"gloss":"","split_unverified":true},{"surface":"வூங்கலங்","parts":[{"text":"வூங்கலங்","lemma":"வூங்கலங்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"கடையே","parts":[{"text":"கடையே","lemma":"கடையே","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true}],"literal":"Fragrant eaglewood's glowing, dense upland field's sweet smoke, / going like a rain-ceased dark cloud, onto the slope / of the hill-dwellers' hamlet descending, the lord of such a land's / closely intertwined flower garlanded beautiful chest embracing / is sweet indeed, may you live long, O friend, dark petaled / blue water-lily kohl-adorned eyes weep / and pallor does not come, before that state.","translation":"Embracing the beautiful chest of the lord of the land, where the sweet smoke of fragrant eaglewood burning in the dense upland fields rises like a rainless dark cloud and descends upon the hill-dwellers' hamlet on the slopes, would indeed be sweet, my friend. May you live long! But only if it happens before your dark-petaled, kohl-rimmed lily-like eyes weep and are overcome by the pallor of separation.","modern":"தோழியே! நீ வாழ்க! நறுமணமிக்க அகில் கட்டைகள் எரிவதால் உண்டாகும் அடர்ந்த கொல்லைப் புறத்து நறும்புகையானது, மழை பெய்து ஓய்ந்த மேகத்தைப் போல எழுந்து சென்று, மலைச்சாரலில் உள்ள குறவர்களின் குடியிருப்புகளில் இறங்கும் நாட்டை உடையவன் தலைவன். அவனுடைய நெருங்கிய மலர்மாலை அணிந்த அழகிய மார்பினைத் தழுவுதல் மிகவும் இன்பமானதுதான். ஆனால், உன்னுடைய கரிய இதழ்களைக் கொண்ட குவளை மலர் போன்ற மை தீட்டிய கண்கள் அழுது வருந்தி, பசலை நோய் உன்னைத் தாக்குவதற்கு முன்னரே அது நிகழ வேண்டும்; இல்லாவிட்டால் அது பயனற்றது.","explanation":"The foster-sister (thozhi) speaks to the heroine (thalaivi) regarding the hero's delay in finalizing their marriage. She acknowledges that embracing the hero's chest, adorned with intertwined garlands, is indeed a source of great joy. However, she warns that this embrace is only meaningful if it happens before the heroine's dark, lily-like eyes are ruined by tears and her body is consumed by the pallor of separation (pasalai). The imagery of fragrant eaglewood smoke rising like a rainless cloud and settling on the mountain hamlet represents the hero's presence, which should bring comfort but is currently causing anxiety due to his absence. The key words are 'நாடன்' (lord of the land), 'முயங்கல் இனிது' (embracing is sweet), and 'பசலை' (pallor of separation).","model":"gemini-3.5-flash"}}