rface":"மகளே","parts":[{"text":"மகள்","lemma":"makaḷ","gloss":"daughter/woman"},{"text":"ஏ","lemma":"ē","gloss":"vocative particle"}],"gloss":"O daughter!"}]},{"words":[{"surface":"மனவு","parts":[{"text":"மனவு","lemma":"maṉavu","gloss":"white conch bead"}],"gloss":"white conch bead"},{"surface":"கோப்பு","parts":[{"text":"கோப்பு","lemma":"kōppu","gloss":"stringing/strand"}],"gloss":"string"},{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"aṉṉa","gloss":"like/resembling"}],"gloss":"like"},{"surface":"நல்","parts":[{"text":"நல்","lemma":"nal","gloss":"good/beautiful"}],"gloss":"beautiful"},{"surface":"நெடும்","parts":[{"text":"நெடும்","lemma":"நெடும்","gloss":"long"}],"gloss":"long","split_unverified":true},{"surface":"கூந்தல்","parts":[{"text":"கூந்தல்","lemma":"kūntal","gloss":"tresses/hair"}],"gloss":"hair"}]},{"words":[{"surface":"அகவன்","parts":[{"text":"அகவன்","lemma":"akavaṉ","gloss":"soothsayer/singer"}],"gloss":"soothsayer"},{"surface":"மகளே","parts":[{"text":"மகள்","lemma":"makaḷ","gloss":"daughter/woman"},{"text":"ஏ","lemma":"ē","gloss":"vocative particle"}],"gloss":"O daughter!"},{"surface":"பாடுக","parts":[{"text":"பாடு","lemma":"pāṭu","gloss":"sing"},{"text":"க","lemma":"ka","gloss":"optative suffix"}],"gloss":"please sing"},{"surface":"பாட்டே","parts":[{"text":"பாட்டு","lemma":"pāṭṭu","gloss":"song"},{"text":"ஏ","lemma":"ē","gloss":"emphatic particle"}],"gloss":"the song"}]},{"words":[{"surface":"இன்னும்","parts":[{"text":"இன்னும்","lemma":"iṉṉum","gloss":"still/more"}],"gloss":"again"},{"surface":"பாடுக","parts":[{"text":"பாடு","lemma":"pāṭu","gloss":"sing"},{"text":"க","lemma":"ka","gloss":"optative suffix"}],"gloss":"please sing"},{"surface":"பாட்டே","parts":[{"text":"பாட்டு","lemma":"pāṭṭu","gloss":"song"},{"text":"ஏ","lemma":"ē","gloss":"emphatic particle"}],"gloss":"the song"},{"surface":"அவர்","parts":[{"text":"அவர்","lemma":"avar","gloss":"he/his (honorific)"}],"gloss":"his"}]},{"words":[{"surface":"நல்","parts":[{"text":"நல்","lemma":"nal","gloss":"good/beautiful"}],"gloss":"beautiful"},{"surface":"நெடும்","parts":[{"text":"நெடும்","lemma":"நெடும்","gloss":"long"}],"gloss":"long","split_unverified":true},{"surface":"குன்றம்","parts":[{"text":"குன்றம்","lemma":"kuṉṟam","gloss":"hill/mountain"}],"gloss":"mountain"},{"surface":"பாடிய","parts":[{"text":"பாடு","lemma":"pāṭu","gloss":"sing"},{"text":"இய","lemma":"iya","gloss":"past relative participle"}],"gloss":"that praised"},{"surface":"பாட்டே","parts":[{"text":"பாட்டு","lemma":"pāṭṭu","gloss":"song"},{"text":"ஏ","lemma":"ē","gloss":"emphatic particle"}],"gloss":"the song"}]}],"literal":"O fortune-telling woman! O fortune-telling woman! / with beautiful long hair like a string of white conch beads, / O fortune-telling woman, please sing a song! / Sing once more the song, his / good, lofty mountain praising song!","translation":"O fortune-telling woman! O fortune-telling woman! With beautiful, long, white hair like a string of conch-shell beads, O fortune-telling woman, sing a song! Sing yet again that song, the song that praises his good, lofty mountain!","modern":"சங்கு மணிகளின் கோவையைப் போன்ற அழகிய நீண்ட நரைமுடியைக் கொண்ட அகவன் மகளே! அகவன் மகளே! ஒரு பாட்டுப் பாடுவாயாக! அவருடைய நல்ல உயர்ந்த மலையைப் புகழ்ந்து பாடிய அந்தப் பாட்டையே மீண்டும் பாடுவாயாக!","explanation":"This poem is set in the kuriñci (mountainous) landscape and belongs to the clandestine love phase. The heroine is wasting away due to her separation from her lover, the lord of the mountain. Her mother, misinterpreting this physical decline as possession by the god Murukaṉ, calls an old fortune-teller (akavaṉ makaḷ) to diagnose the illness through ritual song. The heroine's close friend (tōḻi) addresses the fortune-teller, whose long white hair is beautifully compared to a string of white conch beads. The friend urges her to sing, but specifically requests the song that praises the hero's high mountain. By doing so, the friend subtly reveals the true cause of the heroine's illness to the family, guiding them toward arranging her marriage with the mountain lord rather than performing futile religious rituals.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,1.0],[1.0,1.1],[1.1,1.9],[1.9,3.62],[3.62,3.7],[3.7,4.2],[4.2,4.4],[4.4,6.0],[6.0,6.4],[6.4,6.5],[6.5,6.9],[6.9,8.5],[8.5,8.8],[8.8,9.5],[9.5,11.0],[11.0,11.2],[11.2,11.5],[11.5,11.9]],"female":[[0.0,0.6],[0.6,1.0],[1.0,1.1],[1.1,2.2],[2.2,2.2],[2.2,4.3],[4.3,4.7],[4.7,5.1],[5.1,6.7],[6.7,7.1],[7.1,7.2],[7.2,7.7],[7.7,9.3],[9.3,9.6],[9.6,10.2],[10.2,10.2],[10.2,12.3],[12.3,12.5],[12.5,12.7]]},"sync":[[["அகவன்","soothsayer"]],[["மகளே","O daughter!"]],[["அகவன்","soothsayer"]],[["மகளே","O daughter!"]],[["மனவு","white conch bead"],["கோப்பு","string"]],[["கோப்பு","string"],["அன்ன","like"]],[["நல்","beautiful"],["நெடும்","long"]],[["கூந்தல்","hair"]],[["அகவன்","soothsayer"]],[["மகளே","O daughter!"]],[["பாடுக","please sing"]],[["பாட்டே","the song"]],[["இன்னும்","again"]],[["பாடுக","please sing"]],[["பாட்டே","the song"],["அவர்","his"]],[["நல்","beautiful"],["நெடும்","long"]],[["குன்றம்","mountain"]],[["பாடிய","that praised"]],[["பாட்டே","the song"]]]}