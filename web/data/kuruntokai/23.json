{"text":"kuruntokai","n":23,"lines":["அகவன் மகளே அகவன் மகளே","மனவுக்கோப் பன்ன நன்னெடுங் கூந்தல்","அகவன் மகளே பாடுக பாட்டே","இன்னும் பாடுக பாட்டேஅவர்","நன்னெடுங் குன்றம் பாடிய பாட்டே"],"tr":["akavaṉ makaḷē akavaṉ makaḷē","maṉavukkōp paṉṉa naṉṉeṭuṅ kūntal","akavaṉ makaḷē pāṭuka pāṭṭē","iṉṉum pāṭuka pāṭṭēavar","naṉṉeṭuṅ kuṉṟam pāṭiya pāṭṭē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"ஔவையார்","speaker_en":"her friend (tōḻi)","poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 1, vañcicīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 12, āciriyattaḷai 5, oṉṟā vañcittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அகவன்","tr":"akavaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"அக","tr":"aka"},{"kind":"nēr","text":"வன்","tr":"vaṉ"}]},{"text":"மகளே","tr":"makaḷē","foot":"puḷimā","acai":[{"kind":"nirai","text":"மக","tr":"maka"},{"kind":"nēr","text":"ளே","tr":"ḷē"}]},{"text":"அகவன்","tr":"akavaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"அக","tr":"aka"},{"kind":"nēr","text":"வன்","tr":"vaṉ"}]},{"text":"மகளே","tr":"makaḷē","foot":"puḷimā","acai":[{"kind":"nirai","text":"மக","tr":"maka"},{"kind":"nēr","text":"ளே","tr":"ḷē"}]}],[{"text":"மனவுக்கோப்","tr":"maṉavukkōp","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"மன","tr":"maṉa"},{"kind":"nēr","text":"வுக்","tr":"vuk"},{"kind":"nēr","text":"கோப்","tr":"kōp"}]},{"text":"பன்ன","tr":"paṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"பன்","tr":"paṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"நன்னெடுங்","tr":"naṉṉeṭuṅ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நன்","tr":"naṉ"},{"kind":"nirai","text":"னெடுங்","tr":"ṉeṭuṅ"}]},{"text":"கூந்தல்","tr":"kūntal","foot":"tēmā","acai":[{"kind":"nēr","text":"கூந்","tr":"kūn"},{"kind"