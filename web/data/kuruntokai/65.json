,"foot":"puḷimā","acai":[{"kind":"nirai","text":"துக","tr":"tuka"},{"kind":"nēr","text":"ளத்","tr":"ḷat"}]}],[{"text":"தான்வந்","tr":"tāṉvan","foot":"tēmā","acai":[{"kind":"nēr","text":"தான்","tr":"tāṉ"},{"kind":"nēr","text":"வந்","tr":"van"}]},{"text":"தன்றே","tr":"taṉṟē","foot":"tēmā","acai":[{"kind":"nēr","text":"தன்","tr":"taṉ"},{"kind":"nēr","text":"றே","tr":"ṟē"}]},{"text":"தளிதரு","tr":"taḷitaru","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தளி","tr":"taḷi"},{"kind":"nirai","text":"தரு","tr":"taru"}]},{"text":"தண்கார்","tr":"taṇkār","foot":"tēmā","acai":[{"kind":"nēr","text":"தண்","tr":"taṇ"},{"kind":"nēr","text":"கார்","tr":"kār"}]}],[{"text":"வாரா","tr":"vārā","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ரா","tr":"rā"}]},{"text":"துறையுநர்","tr":"tuṟaiyunar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"துறை","tr":"tuṟai"},{"kind":"nirai","text":"யுநர்","tr":"yunar"}]},{"text":"வரனசைஇ","tr":"varaṉacaii","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"வர","tr":"vara"},{"kind":"nirai","text":"னசை","tr":"ṉacai"},{"kind":"nēr","text":"இ","tr":"i"}]}],[{"text":"வருந்திநொந்","tr":"varuntinon","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வருந்","tr":"varun"},{"kind":"nirai","text":"திநொந்","tr":"tinon"}]},{"text":"துறைய","tr":"tuṟaiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"துறை","tr":"tuṟai"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"இருந்திரோ","tr":"iruntirō","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இருந்","tr":"irun"},{"kind":"nirai","text":"திரோ","tr":"tirō"}]},{"text":"எனவே","tr":"eṉavē","foot":"puḷimā","acai":[{"kind":"nirai","text":"என","tr":"eṉa"},{"kind":"nēr","text":"வே","tr":"vē"}]}]]},"ai":{"lines":[{"words":[{"surface":"வன்பரல்","parts":[{"text":"வன்பரல்","lemma":"வன்பரல்","gloss":"hard pebbles"}],"gloss":"hard pebbles","split_unverified":true},{"surface":"தெள்ளறல்","parts":[{"text":"தெள்","lemma":"teḷ","gloss":"clear"},{"text":"அறல்","lemma":"aṟal","gloss":"water"}],"gloss":"clear water"},{"surface":"பருகிய","parts":[{"text":"பருகு","lemma":"paruku","gloss":"drink"},{"text":"இய","lemma":"iya","gloss":"past relative participle suffix"}],"gloss":"having drunk"},{"surface":"இரலை","parts":[{"text":"இரலை","lemma":"iralai","gloss":"stag"}],"gloss":"stag"},{"surface":"தன்","parts":[{"text":"தன்","lemma":"taṉ","gloss":"its"}],"gloss":"its"}]},{"words":[{"surface":"இன்புறு","parts":[{"text":"இன்பு","lemma":"iṉpu","gloss":"pleasure"},{"text":"உறு","lemma":"uṟu","gloss":"experience"}],"gloss":"pleasurable"},{"surface":"துணையொடு","parts":[{"text":"துணை","lemma":"tuṇai","gloss":"mate"},{"text":"ஒடு","lemma":"oṭu","gloss":"with"}],"gloss":"with its mate"},{"surface":"மறுவந்து","parts":[{"text":"மறு","lemma":"maṟu","gloss":"again"},{"text":"வந்து","lemma":"vantu","gloss":"having come"}],"gloss":"turning around"},{"surface":"உகள","parts":[{"text":"உகளு","lemma":"ukaḷu","gloss":"leap"},{"text":"அ","lemma":"a","gloss":"infinitive suffix"}],"gloss":"to frisk"}]},{"words":[{"surface":"தான்","parts":[{"text":"தான்","lemma":"tāṉ","gloss":"itself"}],"gloss":"itself"},{"surface":"வந்தன்றே","parts":[{"text":"வந்து","lemma":"vantu","gloss":"come"},{"text":"அன்று","lemma":"aṉṟu","gloss":"past tense neuter singular suffix"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"indeed came"},{"surface":"தளிதரு","parts":[{"text":"தளி","lemma":"taḷi","gloss":"raindrops"},{"text":"தரு","lemma":"taru","gloss":"give"}],"gloss":"rain-giving"},{"surface":"தண்கார்","parts":[{"text":"தண்","lemma":"taṇ","gloss":"cool"},{"text":"கார்","lemma":"kār","gloss":"rainy season"}],"gloss":"cool rainy season"}]},{"words":[{"surface":"வாராது","parts":[{"text":"வாரா","lemma":"vārā","gloss":"not coming"},{"text":"து","lemma":"tu","gloss":"adverbial suffix"}],"gloss":"without returning"},{"surface":"உறையுநர்","parts":[{"text":"உறை","lemma":"uṟai","gloss":"stay"},{"text":"உநர்","lemma":"uṉar","gloss":"he who"}],"gloss":"he who stays away"},{"surface":"வரன்","parts":[{"text":"வரன்","lemma":"வரன்","gloss":"coming"}],"gloss":"coming","split_unverified":true},{"surface":"நசைஇ","parts":[{"text":"நசை","lemma":"nacai","gloss":"desire"},{"text":"இ","lemma":"i","gloss":"verbal participle suffix"}],"gloss":"desiring"}]},{"words":[{"surface":"வருந்தி","parts":[{"text":"வருந்து","lemma":"varuntu","gloss":"suffer"},{"text":"இ","lemma":"i","gloss":"past participle suffix"}],"gloss":"suffering"},{"surface":"நொந்து","parts":[{"text":"நொந்து","lemma":"நொந்து","gloss":"aching"}],"gloss":"aching","split_unverified":true},{"surface":"உறைய","parts":[{"text":"உறை","lemma":"uṟai","gloss":"stay"},{"text":"அ","lemma":"a","gloss":"infinitive suffix"}],"gloss":"to remain"},{"surface":"இருந்திரோ","parts":[{"text":"இரு","lemma":"iru","gloss":"stay"},{"text":"ந்த்","lemma":"nt","gloss":"past tense marker"},{"text":"இர்","lemma":"ir","gloss":"second person plural suffix"},{"text":"ஓ","lemma":"ō","gloss":"interrogative suffix"}],"gloss":"did you remain?"},{"surface":"எனவே","parts":[{"text":"என","lemma":"eṉa","gloss":"to say"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"thus asking"}]}],"literal":"hard pebbles clear water having drunk stag its / sweet mate with turning around to frisk / itself came indeed rain-giving cool rainy season / without coming he who stays coming desiring / suffering aching to stay did you remain? thus asking","translation":"The cool, rain-giving winter has arrived, as if to ask: 'Are you still waiting here, suffering and aching, longing for the return of him who stays away without coming back?'—even as the forest stag, having drunk the clear water flowing over hard pebbles, leaps and frisks in joy with its sweet mate.","modern":"கடினமான பருக்கைக் கற்களின் மேல் ஓடும் தெளிந்த நீரைப் பருகிய ஆண் மான், தன் இனிய துணையோடு கூடித் துள்ளி விளையாட, மழை தரும் குளிர்ந்த கார்காலம் தானே வந்துவிட்டது. 'வராமல் பிரிந்து வாழும் தலைவனின் வருகையை விரும்பி, துன்புற்று மனவருத்தத்துடன் இன்னும் உயிரோடு இருக்கிறீர்களா?' என்று கேட்பது போல அது வந்துள்ளது.","explanation":"This poem is set in the Mullai landscape, which represents the theme of patient waiting during the rainy season. The heroine speaks to her companion, expressing her deep grief at the arrival of the cool winter rains. She personifies the season, imagining that it has arrived specifically to mock her, asking if she is still alive and suffering while waiting for her lover. In contrast to her lonely state, she observes a forest stag that has drunk clear water from the pebbled stream and is happily playing with its mate. This natural imagery of animal union intensifies the heroine's sense of isolation and longing.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.9],[0.9,1.3],[1.3,1.8],[1.8,2.3],[2.3,2.9],[2.9,3.0],[3.0,3.55],[3.55,3.99],[4.1,5.15],[5.15,5.4],[5.4,6.0],[6.0,6.3],[6.3,6.7],[6.9,7.1],[7.1,7.47],[7.47,9.5],[9.5,9.83],[9.9,10.28],[10.5,10.8]],"female":[[0.0,0.8],[1.0,1.3],[1.3,1.8],[1.8,2.3],[2.3,3.2],[3.2,3.3],[3.3,3.9],[3.9,4.5],[4.5,5.79],[5.79,6.1],[6.1,6.7],[6.7,7.1],[7.1,7.42],[7.42,7.42],[7.42,9.0],[9.0,10.42],[10.42,10.9],[10.9,11.24],[11.3,11.8]]},"sync":[[["வன்பரல்","hard pebbles"]],[["தெள்ளறல்","clear water"]],[["பருகிய","having drunk"]],[["இரலை","stag"],["தன்","its"]],[["இன்புறு","pleasurable"]],[["துணையொடு","with its mate"]],[["மறுவந்து","turning around"]],[["மறுவந்து","turning around"],["உகள","to frisk"]],[["தான்","itself"],["வந்தன்றே","indeed came"]],[["வந்தன்றே","indeed came"]],[["தளிதரு","rain-giving"]],[["தண்கார்","cool rainy season"]],[["வாராது","without returning"]],[["வாராது","without returning"],["உறையுநர்","he who stays away"]],[["வரன்","coming"],["நசைஇ","desiring"]],[["வருந்தி","suffering"],["நொந்து","aching"]],[["நொந்து","aching"],["உறைய","to remain"]],[["இருந்திரோ","did you remain?"]],[["எனவே","thus asking"]]]}