{"text":"kuruntokai","n":193,"lines":["மட்டம் பெய்த மணிக்கலத் தன்ன","இட்டுவாய்ச் சுனைய பகுவாய்த் தேரை","தட்டைப் பறையிற் கறங்கு நாடன்","தொல்லைத் திங்கள் நெடுவெண் ணிலவின்","மணந்தனன் மன்னெடுந் தோளே","இன்று முல்லை முகைநாறும்மே"],"tr":["maṭṭam peyta maṇikkalat taṉṉa","iṭṭuvāyc cuṉaiya pakuvāyt tērai","taṭṭaip paṟaiyiṟ kaṟaṅku nāṭaṉ","tollait tiṅkaḷ neṭuveṇ ṇilaviṉ","maṇantaṉaṉ maṉṉeṭun tōḷē","iṉṟu mullai mukaināṟummē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"அரிசில் கிழார்","speaker_en":"the heroine (talaivi)","poet_tr":"Aricil Kiḻār"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 2×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, other 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 11, āciriyattaḷai 10"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மட்டம்","tr":"maṭṭam","foot":"tēmā","acai":[{"kind":"nēr","text":"மட்","tr":"maṭ"},{"kind":"nēr","text":"டம்","tr":"ṭam"}]},{"text":"பெய்த","tr":"peyta","foot":"tēmā","acai":[{"kind":"nēr","text":"பெய்","tr":"pey"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"மணிக்கலத்","tr":"maṇikkalat","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மணிக்","tr":"maṇik"},{"kind":"nirai","text":"கலத்","tr":"kalat"}]},{"text":"தன்ன","tr":"taṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"தன்","tr":"taṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]}],[{"text":"இட்டுவாய்ச்","tr":"iṭṭuvāyc","foot":"kūviḷam","acai":[{"kind":"nēr","text":"இட்","tr":"iṭ"},{"kind":"nirai","text":"டுவாய்ச்","tr":"ṭuvāyc"}]},{"text":"சுனைய","tr":"cuṉaiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"சுனை","tr":"cuṉai"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"பகுவாய்த்","tr":"pakuvāyt","foot":"puḷimā","acai":[{"kind":"nirai","text":"பகு","tr":"paku"},{"kind":"nēr","text":"வாய்த்","tr":"vāyt"}]},{"text":"தேரை","tr":"tērai","foot":"tēmā","acai":[{"kind":"nēr","text":