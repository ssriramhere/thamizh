{"text":"kuruntokai","n":154,"lines":["யாங்கறிந் தனர்கொல் தோழி பாம்பின்","உரிநிமிர்ந் தன்ன உருப்பவி ரமையத்","திரைவேட் டெழுந்த சேவல் உள்ளிப்","பொறிமயிர் எருத்திற் குறுநடைப் பேடை","பொறிகாற் கள்ளி விரிகா யங்கவட்டுத்","தயங்க விருந்து புலம்பக் கூஉம்","அருஞ்சுர வைப்பிற் கானம்","பிரிந்துசே ணுறைதல் வல்லு வோரே"],"tr":["yāṅkaṟin taṉarkol tōḻi pāmpiṉ","urinimirn taṉṉa uruppavi ramaiyat","tiraivēṭ ṭeḻunta cēval uḷḷip","poṟimayir eruttiṟ kuṟunaṭaip pēṭai","poṟikāṟ kaḷḷi virikā yaṅkavaṭṭut","tayaṅka viruntu pulampak kūum","aruñcura vaippiṟ kāṉam","pirintucē ṇuṟaital vallu vōrē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"மதுரைச் சீத்தலைச் சாத்தனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Maturaic Cīttalaic Cāttaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 15, āciriyattaḷai 14, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"யாங்கறிந்","tr":"yāṅkaṟin","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யாங்","tr":"yāṅ"},{"kind":"nirai","text":"கறிந்","tr":"kaṟin"}]},{"text":"தனர்கொல்","tr":"taṉarkol","foot":"puḷimā","acai":[{"kind":"nirai","text":"தனர்","tr":"taṉar"},{"kind":"nēr","text":"கொல்","tr":"kol"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"பாம்பின்","tr":"pāmpiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"பாம்","tr":"pām"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]}],[{"text":"உரிநிமிர்ந்","tr":"urinimirn","foot":"karuviḷam","acai":[{"kind":"nirai","text":"உரி","tr":"uri"},{"kind":"nirai","text":"நிமிர்ந்","tr":"nimirn"}]},{"text":"தன்ன","tr":"taṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"தன்","tr":"taṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"உ