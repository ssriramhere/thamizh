{"text":"kuruntokai","n":274,"lines":["புறவுப் புறத்தன்ன புன்கா லுகாஅய்க்","காசினை யன்ன நளிகனி யுதிர","விடுகணை வில்லொடு பற்றிக் கோடிவர்பு","வருநர்ப் பார்க்கும் வன்கண் ஆடவர்","நீர்நசை வேட்கையி னார்மென்று தணியும்","இன்னாக் கானமும் இனிய பொன்னொடு","மணிமிடை யல்குல் மடந்தை","அணிமுலை யாக முயகினஞ் செலினே"],"tr":["puṟavup puṟattaṉṉa puṉkā lukāayk","kāciṉai yaṉṉa naḷikaṉi yutira","viṭukaṇai villoṭu paṟṟik kōṭivarpu","varunarp pārkkum vaṉkaṇ āṭavar","nīrnacai vēṭkaiyi ṉārmeṉṟu taṇiyum","iṉṉāk kāṉamum iṉiya poṉṉoṭu","maṇimiṭai yalkul maṭantai","aṇimulai yāka muyakiṉañ celiṉē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவன் கூற்று","poet_ta":"உருத்திரனார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Uruttiraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 16, āciriyattaḷai 12, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"புறவுப்","tr":"puṟavup","foot":"puḷimā","acai":[{"kind":"nirai","text":"புற","tr":"puṟa"},{"kind":"nēr","text":"வுப்","tr":"vup"}]},{"text":"புறத்தன்ன","tr":"puṟattaṉṉa","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"புறத்","tr":"puṟat"},{"kind":"nēr","text":"தன்","tr":"taṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"புன்கா","tr":"puṉkā","foot":"tēmā","acai":[{"kind":"nēr","text":"புன்","tr":"puṉ"},{"kind":"nēr","text":"கா","tr":"kā"}]},{"text":"லுகாஅய்க்","tr":"lukāayk","foot":"puḷimā","acai":[{"kind":"nirai","text":"லுகா","tr":"lukā"},{"kind":"nēr","text":"அய்க்","tr":"ayk"}]}],[{"text":"காசினை","tr":"kāciṉai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"சினை","tr":"ciṉai"}]},{"text":"யன்ன","tr":"yaṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"யன்","tr":"yaṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"ந