்","lemma":"நீர்","gloss":"water"}],"gloss":"water"},{"surface":"நசை","parts":[{"text":"நசை","lemma":"நசை","gloss":"desire"}],"gloss":"desire"},{"surface":"வேட்கையின்","parts":[{"text":"வேட்கை","lemma":"வேட்கை","gloss":"thirst"},{"text":"இன்","lemma":"இன்","gloss":"due to"}],"gloss":"due to thirst"},{"surface":"நார்","parts":[{"text":"நார்","lemma":"நார்","gloss":"bark fiber"}],"gloss":"bark fiber"},{"surface":"மென்று","parts":[{"text":"மென்று","lemma":"மென்று","gloss":"chewing"}],"gloss":"chewing","split_unverified":true},{"surface":"தணியும்","parts":[{"text":"தணியும்","lemma":"தணி","gloss":"quench"}],"gloss":"quenching"}]},{"words":[{"surface":"இன்னா","parts":[{"text":"இன்னா","lemma":"இன்னா","gloss":"unpleasant"}],"gloss":"unpleasant"},{"surface":"கானமும்","parts":[{"text":"கானம்","lemma":"கானம்","gloss":"forest"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"even the forest"},{"surface":"இனிய","parts":[{"text":"இனிய","lemma":"இனிது","gloss":"pleasant"}],"gloss":"pleasant"},{"surface":"பொன்னொடு","parts":[{"text":"பொன்","lemma":"பொன்","gloss":"gold"},{"text":"ஒடு","lemma":"ஒடு","gloss":"with"}],"gloss":"with gold"}]},{"words":[{"surface":"மணி","parts":[{"text":"மணி","lemma":"மணி","gloss":"gem"}],"gloss":"gem"},{"surface":"மிடை","parts":[{"text":"மிடை","lemma":"மிடை","gloss":"closely set"}],"gloss":"closely set"},{"surface":"அல்குல்","parts":[{"text":"அல்குல்","lemma":"அல்குல்","gloss":"waist"}],"gloss":"waist"},{"surface":"மடந்தை","parts":[{"text":"மடந்தை","lemma":"மடந்தை","gloss":"young woman"}],"gloss":"young woman"}]},{"words":[{"surface":"அணி","parts":[{"text":"அணி","lemma":"அணி","gloss":"beautiful"}],"gloss":"beautiful"},{"surface":"முலை","parts":[{"text":"முலை","lemma":"முலை","gloss":"breast"}],"gloss":"breast"},{"surface":"ஆகம்","parts":[{"text":"ஆகம்","lemma":"ஆகம்","gloss":"chest"}],"gloss":"chest"},{"surface":"முயகினம்","parts":[{"text":"முயகினம்","lemma":"முயகினம்","gloss":"we embraced"}],"gloss":"we embraced","split_unverified":true},{"surface":"செலின்","parts":[{"text":"செல்","lemma":"செல்","gloss":"go"},{"text":"இன்","lemma":"இன்","gloss":"if"}],"gloss":"if we go"},{"surface":"ஏ","parts":[{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"indeed"}]}],"literal":"Like the back of a dove, the pale-trunked ugā tree's / coin-like dense ripe fruits fall, / holding a bow with a released arrow, climbing the paths, / cruel-minded men who watch for travelers, / due to thirst for water, chew bark fiber to quench it; / even such an unpleasant forest becomes pleasant, if with gold- / and gem-interspersed waist young woman's / beautiful breasts and chest we embrace as we go.","translation":"Even the harsh forest—where cruel-minded men, holding bows with arrows ready, climb the high paths to watch for travelers, and chew dry bark fiber to quench their burning thirst for water under the pale-trunked ugā trees whose dense, coin-like ripe fruits fall like the grey backs of doves—will become sweet and pleasant, if only we go embracing the beautiful breasts and chest of the young woman whose waist is adorned with gold and closely set gems.","modern":"புறாவின் முதுகைப் போன்ற, வெளுத்த அடிமரத்தைக் கொண்ட உகா மரத்தின் காசு போன்ற அடர்ந்த பழங்கள் உதிர்கின்றன. அங்கே, தொடுத்த அம்போடு வில்லை ஏந்தி, உயரமான வழிகளில் ஏறி, வரும் வழியினரைக் கண்காணிக்கும் கொடிய நெஞ்சமுடைய மறவர்கள், தண்ணீரின் மீதான தாகத்தினால் மரப்பட்டையை மென்று தாகத்தைத் தணித்துக் கொள்கிறார்கள். அத்தகைய துன்பம் தரும் காடும் கூட, பொன்னும் மணியும் கலந்த மேகலையை அணிந்த அல்குலை உடைய இப்பெண்ணின் அழகிய முலைகளையும் மார்பையும் தழுவிக்கொண்டு சென்றால், மிகவும் இனியதாக மாறிவிடும்.","explanation":"The hero is speaking to himself as he contemplates a journey through the desert wasteland to earn wealth. He describes the terrifying desert path where ruthless bandits wait to rob travelers and chew dry bark to survive their extreme thirst. Yet, he declares that even this perilous and painful wilderness will feel sweet and pleasant if he can travel it while embracing his beloved. The harshness of the desert is vividly depicted through the falling ugā fruits resembling dove-backs, the predatory bandits, and their desperate chewing of bark. This extreme hostility of nature contrasts sharply with the comforting embrace of the heroine, highlighting the power of love to transform suffering into joy. Key words include 'இன்னாக் கானமும்' (even the unpleasant forest), 'இனிய' (pleasant), and 'முயகினஞ் செலினே' (if we go embracing).","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,1.1],[1.1,1.75],[1.75,2.4],[2.4,2.4],[2.4,2.4],[2.4,3.4],[3.55,4.0],[4.0,5.0],[5.0,5.1],[5.1,5.8],[5.87,6.4],[6.4,6.4],[6.4,7.8],[7.8,8.0],[8.0,8.2],[8.2,8.94],[9.31,9.5],[9.74,10.7],[10.7,11.0],[11.0,11.75],[12.0,12.5],[12.5,12.7],[12.7,13.2],[13.2,14.0],[14.06,14.4],[14.4,14.8],[14.8,15.5],[15.5,15.5],[15.5,16.07],[16.3,17.0]],"female":[[0.0,0.6],[0.6,1.2],[1.2,1.75],[1.75,2.17],[2.17,2.17],[2.17,2.17],[2.17,2.3],[2.72,4.0],[4.0,5.2],[5.2,5.3],[5.3,6.1],[6.2,7.09],[7.09,7.6],[7.6,8.4],[8.4,8.7],[8.7,8.9],[8.9,10.4],[10.4,10.88],[10.88,11.7],[11.7,12.1],[12.1,13.1],[13.1,13.7],[13.7,14.0],[14.0,14.7],[14.7,15.6],[15.7,16.0],[16.0,16.6],[16.6,17.9],[17.9,18.2],[18.2,18.41],[18.41,19.11]]},"sync":[[["புறவு","dove"],["புறத்து","back"]],[["புறத்து","back"],["அன்ன","like"]],[["புன்","pale"],["கால்","trunk"]],[["கால்","trunk"],["உகாஅய்","ugā tree"]],[["காசினை","coin (accusative)"]],[["அன்ன","like"]],[["நளி","dense"],["கனி","ripe fruit"]],[["உதிர","to fall"]],[["விடு","released"],["கணை","arrow"]],[["வில்லொடு","with bow"]],[["பற்றி","holding"],["கோடு","path"]],[["கோடு","path"],["இவர்பு","climbing"]],[["வருநர்","those who come"]],[["பார்க்கும்","watching"]],[["வன்கண்","cruel-minded"]],[["ஆடவர்","men"]],[["நீர்","water"],["நசை","desire"]],[["வேட்கையின்","due to thirst"]],[["வேட்கையின்","due to thirst"],["நார்","bark fiber"],["மென்று","chewing"]],[["தணியும்","quenching"]],[["இன்னா","unpleasant"]],[["கானமும்","even the forest"]],[["இனிய","pleasant"]],[["பொன்னொடு","with gold"]],[["மணி","gem"],["மிடை","closely set"]],[["அல்குல்","waist"]],[["மடந்தை","young woman"]],[["அணி","beautiful"],["முலை","breast"]],[["ஆகம்","chest"]],[["முயகினம்","we embraced"]],[["செலின்","if we go"]]]}