{"text":"kuruntokai","n":225,"lines":["கன்றுதன் பயமுலை மாந்த முன்றில்","தினைபிடி உண்ணும் பெருங்கல் நாட","கெட்டிடத் துவந்த உதவி கட்டில்","வீறுபெற்று மறந்த மன்னன் போல","நன்றிமறந் தமையா யாயின் மென்சீர்க்","கலிமயிற் கலாவத் தன்ன இவள்","ஒலிமென் கூந்தல் உரியவா நினக்கே"],"tr":["kaṉṟutaṉ payamulai mānta muṉṟil","tiṉaipiṭi uṇṇum peruṅkal nāṭa","keṭṭiṭat tuvanta utavi kaṭṭil","vīṟupeṟṟu maṟanta maṉṉaṉ pōla","naṉṟimaṟan tamaiyā yāyiṉ meṉcīrk","kalimayiṟ kalāvat taṉṉa ivaḷ","olimeṉ kūntal uriyavā niṉakkē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"கபிலர்","speaker_en":"her friend (tōḻi)","poet_tr":"Kapilar"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"7×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2, other 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 8, kalittaḷai 2, ? 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கன்றுதன்","tr":"kaṉṟutaṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கன்","tr":"kaṉ"},{"kind":"nirai","text":"றுதன்","tr":"ṟutaṉ"}]},{"text":"பயமுலை","tr":"payamulai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பய","tr":"paya"},{"kind":"nirai","text":"முலை","tr":"mulai"}]},{"text":"மாந்த","tr":"mānta","foot":"tēmā","acai":[{"kind":"nēr","text":"மாந்","tr":"mān"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"முன்றில்","tr":"muṉṟil","foot":"tēmā","acai":[{"kind":"nēr","text":"முன்","tr":"muṉ"},{"kind":"nēr","text":"றில்","tr":"ṟil"}]}],[{"text":"தினைபிடி","tr":"tiṉaipiṭi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தினை","tr":"tiṉai"},{"kind":"nirai","text":"பிடி","tr":"piṭi"}]},{"text":"உண்ணும்","tr":"uṇṇum","foot":"tēmā","acai":[{"kind":"nēr","text":"உண்","tr":"uṇ"},{"kind":"nēr","text":"ணும்","tr":"ṇum"}]},{"text":"பெருங்கல்","tr":"peruṅkal","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெருங்","tr":"peruṅ"}