{"text":"kuruntokai","n":203,"lines":["மலையிடை யிட்ட நாட்டரு மல்லர்","மரந்தலை தோன்றா ஊரரு மல்லர்","கண்ணிற் காண நண்ணுவழி யிருந்தும்","கடவுள் நண்ணிய பாலோர் போல","ஒரீஇ ஒழுகும் என்னைக்குப்","பரியலென் மன்யான் பண்டொரு காலே"],"tr":["malaiyiṭai yiṭṭa nāṭṭaru mallar","marantalai tōṉṟā ūraru mallar","kaṇṇiṟ kāṇa naṇṇuvaḻi yiruntum","kaṭavuḷ naṇṇiya pālōr pōla","orīi oḻukum eṉṉaikkup","pariyaleṉ maṉyāṉ paṇṭoru kālē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தலைவி கூற்று","poet_ta":"நெடும் பல்லியத்தனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Neṭum Palliyattaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 11, āciriyattaḷai 9, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மலையிடை","tr":"malaiyiṭai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மலை","tr":"malai"},{"kind":"nirai","text":"யிடை","tr":"yiṭai"}]},{"text":"யிட்ட","tr":"yiṭṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"யிட்","tr":"yiṭ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"நாட்டரு","tr":"nāṭṭaru","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நாட்","tr":"nāṭ"},{"kind":"nirai","text":"டரு","tr":"ṭaru"}]},{"text":"மல்லர்","tr":"mallar","foot":"tēmā","acai":[{"kind":"nēr","text":"மல்","tr":"mal"},{"kind":"nēr","text":"லர்","tr":"lar"}]}],[{"text":"மரந்தலை","tr":"marantalai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மரந்","tr":"maran"},{"kind":"nirai","text":"தலை","tr":"talai"}]},{"text":"தோன்றா","tr":"tōṉṟā","foot":"tēmā","acai":[{"kind":"nēr","text":"தோன்","tr":"tōṉ"},{"kind":"nēr","text":"றா","tr":"ṟā"}]},{"text":"ஊரரு","tr":"ūraru","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஊ","tr":"ū"},{"kind":"nirai","text":"ரரு","tr":"raru"}]},{"text":"மல்லர்","tr":"mallar","foot":"tēmā","acai":[