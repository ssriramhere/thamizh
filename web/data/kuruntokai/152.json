{"text":"kuruntokai","n":152,"lines":["யாவதும் அறிகிலர் கழறு வோரே","தாயின் முட்டை போலவுட் கிடந்து","சாயின் அல்லது பிறிதெவ னுடைத்தே","யாமைப் பார்ப்பி னன்ன","காமங் காதலர் கையற விடினே"],"tr":["yāvatum aṟikilar kaḻaṟu vōrē","tāyiṉ muṭṭai pōlavuṭ kiṭantu","cāyiṉ allatu piṟiteva ṉuṭaittē","yāmaip pārppi ṉaṉṉa","kāmaṅ kātalar kaiyaṟa viṭiṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"கிளிமங்கலங்கிழார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kiḷimaṅkalaṅkiḻār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"யாவதும்","tr":"yāvatum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nirai","text":"வதும்","tr":"vatum"}]},{"text":"அறிகிலர்","tr":"aṟikilar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அறி","tr":"aṟi"},{"kind":"nirai","text":"கிலர்","tr":"kilar"}]},{"text":"கழறு","tr":"kaḻaṟu","foot":"puḷimā","acai":[{"kind":"nirai","text":"கழ","tr":"kaḻa"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"வோரே","tr":"vōrē","foot":"tēmā","acai":[{"kind":"nēr","text":"வோ","tr":"vō"},{"kind":"nēr","text":"ரே","tr":"rē"}]}],[{"text":"தாயின்","tr":"tāyiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"யின்","tr":"yiṉ"}]},{"text":"முட்டை","tr":"muṭṭai","foot":"tēmā","acai":[{"kind":"nēr","text":"முட்","tr":"muṭ"},{"kind":"nēr","text":"டை","tr":"ṭai"}]},{"text":"போலவுட்","tr":"pōlavuṭ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"போ","tr":"pō"},{"kind":"nirai","text":"லவுட்","tr":"lavuṭ"}]},{"text":"கிடந்து","tr":"kiṭantu","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிடந்","tr":"kiṭan"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"சாயின்","tr":"c