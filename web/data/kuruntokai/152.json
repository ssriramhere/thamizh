rds":[{"surface":"தாயின்","parts":[{"text":"தாய்","lemma":"tāy","gloss":"mother"},{"text":"இன்","lemma":"iṉ","gloss":"of"}],"gloss":"mother's"},{"surface":"முட்டை","parts":[{"text":"முட்டை","lemma":"muṭṭai","gloss":"egg"}],"gloss":"egg"},{"surface":"போல","parts":[{"text":"போல","lemma":"pōl","gloss":"like"}],"gloss":"like"},{"surface":"உள்","parts":[{"text":"உள்","lemma":"uḷ","gloss":"inside"}],"gloss":"inside"},{"surface":"கிடந்து","parts":[{"text":"கிடந்து","lemma":"kiṭa","gloss":"lying"}],"gloss":"lying"}]},{"words":[{"surface":"சாயின்","parts":[{"text":"சாய்","lemma":"sāy","gloss":"waste away"},{"text":"இன்","lemma":"iṉ","gloss":"if"}],"gloss":"if it wastes away"},{"surface":"அல்லது","parts":[{"text":"அல்லது","lemma":"al","gloss":"other than"}],"gloss":"other than"},{"surface":"பிறிது","parts":[{"text":"பிறிது","lemma":"piṟitu","gloss":"other thing"}],"gloss":"other"},{"surface":"எவன்","parts":[{"text":"எவன்","lemma":"evaṉ","gloss":"what"}],"gloss":"what"},{"surface":"உடைத்தே","parts":[{"text":"உடைத்து","lemma":"uṭai","gloss":"it possesses"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"does it possess indeed"}]},{"words":[{"surface":"யாமை","parts":[{"text":"யாமை","lemma":"yāmai","gloss":"tortoise"}],"gloss":"tortoise"},{"surface":"பார்ப்பின்","parts":[{"text":"பார்ப்பு","lemma":"pārppu","gloss":"hatchling"},{"text":"இன்","lemma":"iṉ","gloss":"of"}],"gloss":"hatchling's"},{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"aṉṉa","gloss":"like"}],"gloss":"like"}]},{"words":[{"surface":"காமம்","parts":[{"text":"காமம்","lemma":"kāmam","gloss":"love"}],"gloss":"love"},{"surface":"காதலர்","parts":[{"text":"காதலர்","lemma":"kātalar","gloss":"lover"}],"gloss":"lover"},{"surface":"கையற","parts":[{"text":"கை","lemma":"kai","gloss":"means"},{"text":"அற","lemma":"aṟu","gloss":"to cease"}],"gloss":"helplessly"},{"surface":"விடினே","parts":[{"text":"விடின்","lemma":"viṭu","gloss":"if he leaves"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"if he leaves indeed"}]}],"literal":"Those who admonish know nothing at all. / Like an egg of its mother, lying inside, / if it wastes away, other than that what does it possess? / Like the hatchling of a tortoise / is this love, if the lover leaves me helpless.","translation":"Those who admonish me know nothing at all. My love is like the hatchling of a tortoise: just as its egg lies buried inside the sand and wastes away if deprived of its mother's presence, what else can my love do but perish if my lover leaves me helpless?","modern":"அறிவுரை கூறுபவர்கள் எதையும் அறியாதவர்கள். தாயின் முட்டைக்குள் கிடந்து, அது அழிந்து போவதைத் தவிர வேறு என்ன பெருமையைப் பெறும்? காதலர் என்னைத் தவிக்கவிட்டுச் சென்றால், என் காதலும் ஆமைக்குஞ்சு போன்றதுதான்; அது தானாகவே அழிந்துவிடும்.","explanation":"The heroine speaks to her close friend or to those onlookers who criticize her for her deep distress during her lover's absence. She defends the depth of her feelings by comparing her love to a tortoise's egg and hatchling. According to classical Tamil poetic convention, tortoise hatchlings survive and grow only through the constant gaze or thoughts of their mother. If the lover abandons her, leaving her helpless, her love will languish and perish just like a hatchling deprived of its mother's life-giving attention. Thus, she explains that her grief is not a choice, but a natural consequence of being separated from the one who sustains her life.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,1.0],[1.0,1.2],[1.2,1.6],[1.6,2.6],[2.6,2.9],[2.9,3.44],[3.44,3.8],[3.8,5.0],[5.0,5.4],[5.4,5.72],[5.72,6.2],[6.33,6.85],[6.85,7.5],[7.5,8.05],[8.05,8.6],[8.6,9.0],[9.0,9.3],[9.45,9.6]],"female":[[0.0,0.8],[0.8,1.0],[1.0,1.3],[1.3,1.7],[1.7,2.8],[2.8,3.1],[3.1,3.7],[3.7,4.1],[4.27,5.1],[5.1,5.5],[5.5,6.25],[6.25,6.4],[6.54,7.12],[7.12,7.41],[7.41,7.7],[8.0,8.9],[8.9,9.61],[9.61,9.73],[9.85,10.08]]},"sync":[[["யாவதும்","anything at all"]],[["அறிகிலர்","they do not know"]],[["கழறுவோரே","those who admonish indeed"]],[["கழறுவோரே","those who admonish indeed"]],[["தாயின்","mother's"]],[["முட்டை","egg"]],[["போல","like"],["உள்","inside"]],[["கிடந்து","lying"]],[["சாயின்","if it wastes away"]],[["அல்லது","other than"]],[["பிறிது","other"],["எவன்","what"]],[["எவன்","what"],["உடைத்தே","does it possess indeed"]],[["யாமை","tortoise"]],[["பார்ப்பின்","hatchling's"]],[["பார்ப்பின்","hatchling's"],["அன்ன","like"]],[["காமம்","love"]],[["காதலர்","lover"]],[["கையற","helplessly"]],[["விடினே","if he leaves indeed"]]]}