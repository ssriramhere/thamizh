{"text":"kuruntokai","n":26,"lines":["அரும்பற மலர்ந்த கருங்கால் வேங்கை","மேக்கெழு பெருஞ்சினை இருந்த தோகை","பூக்கொய் மகளிரிற் றோன்று நாடன்","தகாஅன் போலத் தான்றீது மொழியினும்","தன்கண் கண்டது பொய்க்குவ தன்றே","தேக்கொக் கருந்து முள்ளெயிற்றுத் துவர்வாய்","வரையாடு வன்பறழ்த் தந்தைக்","கடுவனும் அறியும்அக் கொடியோ னையே"],"tr":["arumpaṟa malarnta karuṅkāl vēṅkai","mēkkeḻu peruñciṉai irunta tōkai","pūkkoy makaḷiriṟ ṟōṉṟu nāṭaṉ","takāaṉ pōlat tāṉṟītu moḻiyiṉum","taṉkaṇ kaṇṭatu poykkuva taṉṟē","tēkkok karuntu muḷḷeyiṟṟut tuvarvāy","varaiyāṭu vaṉpaṟaḻt tantaik","kaṭuvaṉum aṟiyumak koṭiyō ṉaiyē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"கொல்லனழிசி","speaker_en":"her friend (tōḻi)","poet_tr":"Kollaṉaḻici"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 12, kalittaḷai 3"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அரும்பற","tr":"arumpaṟa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அரும்","tr":"arum"},{"kind":"nirai","text":"பற","tr":"paṟa"}]},{"text":"மலர்ந்த","tr":"malarnta","foot":"puḷimā","acai":[{"kind":"nirai","text":"மலர்ந்","tr":"malarn"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"கருங்கால்","tr":"karuṅkāl","foot":"puḷimā","acai":[{"kind":"nirai","text":"கருங்","tr":"karuṅ"},{"kind":"nēr","text":"கால்","tr":"kāl"}]},{"text":"வேங்கை","tr":"vēṅkai","foot":"tēmā","acai":[{"kind":"nēr","text":"வேங்","tr":"vēṅ"},{"kind":"nēr","text":"கை","tr":"kai"}]}],[{"text":"மேக்கெழு","tr":"mēkkeḻu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மேக்","tr":"mēk"},{"kind":"nirai","text":"கெழு","tr":"keḻu"}]},{"text":"பெருஞ்சினை","tr":"peruñciṉai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெருஞ்","tr":"peruñ"},{"kind":"nirai","text":"சினை","tr":"ciṉ