ோ","tr":"nō"},{"kind":"nēr","text":"கோ","tr":"kō"}]},{"text":"யானே","tr":"yāṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":null}