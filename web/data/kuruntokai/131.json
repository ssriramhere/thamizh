ோ","tr":"nō"},{"kind":"nēr","text":"கோ","tr":"kō"}]},{"text":"யானே","tr":"yāṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"ஆடு","parts":[{"text":"ஆடு","lemma":"ஆடு","gloss":"sway"}],"gloss":"swaying"},{"surface":"அமை","parts":[{"text":"அமை","lemma":"அமை","gloss":"bamboo"}],"gloss":"bamboo"},{"surface":"புரையும்","parts":[{"text":"புரை","lemma":"புரை","gloss":"resemble"},{"text":"உம்","lemma":"உம்","gloss":"adjectival suffix"}],"gloss":"resembling"},{"surface":"வனப்பின்","parts":[{"text":"வனப்பு","lemma":"வனப்பு","gloss":"beauty"},{"text":"இன்","lemma":"இன்","gloss":"oblique suffix"}],"gloss":"of beauty"},{"surface":"பணை","parts":[{"text":"பணை","lemma":"பணை","gloss":"bamboo-like"}],"gloss":"bamboo-like"},{"surface":"தோள்","parts":[{"text":"தோள்","lemma":"தோள்","gloss":"shoulder"}],"gloss":"shoulders"}]},{"words":[{"surface":"பேர்","parts":[{"text":"பேர்","lemma":"பேர்","gloss":"great"}],"gloss":"great","split_unverified":true},{"surface":"அமர்","parts":[{"text":"அமர்","lemma":"அமர்","gloss":"beautiful"}],"gloss":"beautiful"},{"surface":"கண்ணி","parts":[{"text":"கண்","lemma":"கண்","gloss":"eye"},{"text":"இ","lemma":"இ","gloss":"she who has"}],"gloss":"she of the eyes"},{"surface":"இருந்த","parts":[{"text":"இருந்த","lemma":"இருந்த","gloss":"where she resided"}],"gloss":"where she resided","split_unverified":true},{"surface":"ஊரே","parts":[{"text":"ஊர்","lemma":"ஊர்","gloss":"town"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"the town indeed"}]},{"words":[{"surface":"நெடும்","parts":[{"text":"நெடும்","lemma":"நெடும்","gloss":"long"}],"gloss":"long","split_unverified":true},{"surface":"சேண்","parts":[{"text":"சேண்","lemma":"சேண்","gloss":"distance"}],"gloss":"distance"},{"surface":"ஆர்","parts":[{"text":"ஆர்","lemma":"ஆர்","gloss":"difficult"}],"gloss":"difficult"},{"surface":"இடை","parts":[{"text":"இடை","lemma":"இடை","gloss":"path"}],"gloss":"path"},{"surface":"அதுவே","parts":[{"text":"அது","lemma":"அது","gloss":"it"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"is that indeed"},{"surface":"நெஞ்சே","parts":[{"text":"நெஞ்சு","lemma":"நெஞ்சு","gloss":"heart"},{"text":"ஏ","lemma":"ஏ","gloss":"vocative"}],"gloss":"O heart!"}]},{"words":[{"surface":"ஈரம்","parts":[{"text":"ஈரம்","lemma":"ஈரம்","gloss":"moisture"}],"gloss":"moisture"},{"surface":"பட்ட","parts":[{"text":"பட்ட","lemma":"பட்ட","gloss":"which received"}],"gloss":"which received","split_unverified":true},{"surface":"செவ்வி","parts":[{"text":"செவ்வி","lemma":"செவ்வி","gloss":"proper time"}],"gloss":"proper time"},{"surface":"பைம்","parts":[{"text":"பைம்","lemma":"பைம்","gloss":"fresh"}],"gloss":"fresh","split_unverified":true},{"surface":"புனத்து","parts":[{"text":"புனத்து","lemma":"புனத்து","gloss":"in the field"}],"gloss":"in the field","split_unverified":true}]},{"words":[{"surface":"ஓர்","parts":[{"text":"ஓர்","lemma":"ஓர்","gloss":"single"}],"gloss":"single","split_unverified":true},{"surface":"ஏர்","parts":[{"text":"ஏர்","lemma":"ஏர்","gloss":"plow"}],"gloss":"plow"},{"surface":"உழவன்","parts":[{"text":"உழு","lemma":"உழு","gloss":"plow"},{"text":"அவன்","lemma":"அவன்","gloss":"he who does"}],"gloss":"plowman"},{"surface":"போல","parts":[{"text":"போல்","lemma":"போல்","gloss":"resemble"},{"text":"அ","lemma":"அ","gloss":"infinitive suffix"}],"gloss":"like"}]},{"words":[{"surface":"பெரு","parts":[{"text":"பெரு","lemma":"பெரு","gloss":"great"}],"gloss":"great"},{"surface":"விதுப்பு","parts":[{"text":"விதுப்பு","lemma":"விதுப்பு","gloss":"haste/anxiety"}],"gloss":"distress"},{"surface":"உற்றன்றால்","parts":[{"text":"உற்றன்றால்","lemma":"உற்றன்றால்","gloss":"it has attained indeed"}],"gloss":"it has attained indeed","split_unverified":true},{"surface":"நோகோ","parts":[{"text":"நோ","lemma":"நோ","gloss":"suffer"},{"text":"கு","lemma":"கு","gloss":"first person singular suffix"},{"text":"ஓ","lemma":"ஓ","gloss":"interrogative/exclamatory"}],"gloss":"do I suffer?"},{"surface":"யானே","parts":[{"text":"யான்","lemma":"யான்","gloss":"I"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"I indeed"}]}],"literal":"Swaying bamboo resembling of-beauty bamboo-like-shoulders / great beautiful eyes-she-who-has resided town-indeed / long distance difficult path is-that-indeed, O heart! / moisture received proper-time fresh field-in / single plow plowman like / great-distress attained-indeed, do I suffer, I-indeed!","translation":"The town where she lives—she of the beautiful, wide eyes and shoulders as lovely as swaying bamboo—is far away, across a difficult path, O my heart! Yet, like a farmer with a single plow in a fresh field that has just received rain, you are in great haste and anxiety. How I suffer!","modern":"அசையும் மூங்கிலைப் போன்ற அழகுடைய பருத்த தோள்களையும், பெரிய அழகிய கண்களையும் உடைய என் தலைவி வாழும் ஊரோ, மிகத் தொலைவில் உள்ள அரிய வழியைக் கடந்து செல்ல வேண்டிய இடத்தில் இருக்கிறது, நெஞ்சே! மழை பெய்து ஈரம் பட்டு உழுவதற்கு ஏற்ற பக்குவமடைந்த புதிய புனத்தில், ஒரே ஒரு ஏரை மட்டும் உடைய உழவன் படும் பதற்றத்தைப் போல, நீ பெரும் பதற்றத்தை அடைந்துள்ளாய். நானோ வருந்துகிறேன்!","explanation":"In this poem of the wasteland (pālai) landscape, the hero speaks to his own heart while journeying away from his beloved. He laments that the town where his beautiful beloved resides is far away, separated by a long and difficult path. Yet, his heart is filled with intense haste and anxiety to return to her. He compares this inner turmoil to a farmer who has only a single plow to till a large, fresh field that has just received rain. Since the moisture in the soil will dry up quickly, the farmer is in extreme distress and hurry to complete the work with his limited means. This vivid agricultural metaphor perfectly captures the hero's feeling of urgency and helplessness in his separation.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.5],[0.5,0.9],[0.9,1.2],[1.2,1.9],[1.9,3.0],[3.0,3.2],[3.28,3.7],[3.77,3.9],[3.9,5.1],[5.1,5.6],[5.6,5.6],[5.6,6.0],[6.0,7.1],[7.1,7.4],[7.4,7.4],[7.4,8.2],[8.2,9.2],[9.2,9.5],[9.5,9.7],[9.7,10.4],[10.5,11.1],[11.1,11.6],[11.6,11.6]],"female":[[0.0,0.6],[0.6,0.7],[0.7,1.2],[1.2,2.0],[2.0,3.0],[3.0,3.3],[3.37,3.7],[3.7,3.9],[3.9,4.82],[4.82,4.82],[4.82,5.0],[5.0,6.3],[6.3,7.3],[7.3,7.6],[7.6,7.7],[7.7,8.5],[8.5,9.8],[9.8,10.2],[10.2,10.3],[10.3,10.56],[10.56,12.1],[12.1,12.5],[12.5,12.6]]}}