{"text":"kuruntokai","n":159,"lines":["தழையணி அல்குல் தாங்கல் செல்லா","நுழைசிறு நுசுப்பிற் கெவ்வ மாக","அம்மெல் ஆக நிறைய வீங்கிக்","கொம்மை வரிமுலை செப்புடன் எதிரின","யாங்கா குவள்கொல் பூங்குழை என்னும்","அவல நெஞ்சமொ டுசாவாக்","கவலை மாக்கட்டிப் பேதை யூரே"],"tr":["taḻaiyaṇi alkul tāṅkal cellā","nuḻaiciṟu nucuppiṟ kevva māka","ammel āka niṟaiya vīṅkik","kommai varimulai ceppuṭaṉ etiriṉa","yāṅkā kuvaḷkol pūṅkuḻai eṉṉum","avala neñcamo ṭucāvāk","kavalai mākkaṭṭip pētai yūrē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"வடம வண்ணக்கண் பேரிசாத்தனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Vaṭama Vaṇṇakkaṇ Pēricāttaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 11"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"தழையணி","tr":"taḻaiyaṇi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தழை","tr":"taḻai"},{"kind":"nirai","text":"யணி","tr":"yaṇi"}]},{"text":"அல்குல்","tr":"alkul","foot":"tēmā","acai":[{"kind":"nēr","text":"அல்","tr":"al"},{"kind":"nēr","text":"குல்","tr":"kul"}]},{"text":"தாங்கல்","tr":"tāṅkal","foot":"tēmā","acai":[{"kind":"nēr","text":"தாங்","tr":"tāṅ"},{"kind":"nēr","text":"கல்","tr":"kal"}]},{"text":"செல்லா","tr":"cellā","foot":"tēmā","acai":[{"kind":"nēr","text":"செல்","tr":"cel"},{"kind":"nēr","text":"லா","tr":"lā"}]}],[{"text":"நுழைசிறு","tr":"nuḻaiciṟu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நுழை","tr":"nuḻai"},{"kind":"nirai","text":"சிறு","tr":"ciṟu"}]},{"text":"நுசுப்பிற்","tr":"nucuppiṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"நுசுப்","tr":"nucup"},{"kind":"nēr","text":"பிற்","tr":"piṟ"}]},{"text":"கெவ்வ","tr":"kevva","foot":"tēmā","acai":[{"kind":"nēr","text":"கெவ்","tr":"kev"},{"kind":"nēr","text":