{"text":"kuruntokai","n":179,"lines":["கல்லென் கானத்துக் கடமா வாட்டி","எல்லும் எல்லின்று ஞமலியும் இளைத்தன","செல்லல் ஐஇய உதுவெம் மூரே","ஓங்குவரை யடுக்கத்துத் தீந்தேன் கிழித்த","குவையுடைப் பசுங்கழை தின்ற கயவாய்ப்","பேதை யானை சுவைத்த","கூழை மூங்கிற் குவட்டிடை யதுவே"],"tr":["kalleṉ kāṉattuk kaṭamā vāṭṭi","ellum elliṉṟu ñamaliyum iḷaittaṉa","cellal aiiya utuvem mūrē","ōṅkuvarai yaṭukkattut tīntēṉ kiḻitta","kuvaiyuṭaip pacuṅkaḻai tiṉṟa kayavāyp","pētai yāṉai cuvaitta","kūḻai mūṅkiṟ kuvaṭṭiṭai yatuvē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"குட்டுவன் கண்ணனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kuṭṭuvaṉ Kaṇṇaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 8, kalittaḷai 3"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கல்லென்","tr":"kalleṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"கல்","tr":"kal"},{"kind":"nēr","text":"லென்","tr":"leṉ"}]},{"text":"கானத்துக்","tr":"kāṉattuk","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"னத்","tr":"ṉat"},{"kind":"nēr","text":"துக்","tr":"tuk"}]},{"text":"கடமா","tr":"kaṭamā","foot":"puḷimā","acai":[{"kind":"nirai","text":"கட","tr":"kaṭa"},{"kind":"nēr","text":"மா","tr":"mā"}]},{"text":"வாட்டி","tr":"vāṭṭi","foot":"tēmā","acai":[{"kind":"nēr","text":"வாட்","tr":"vāṭ"},{"kind":"nēr","text":"டி","tr":"ṭi"}]}],[{"text":"எல்லும்","tr":"ellum","foot":"tēmā","acai":[{"kind":"nēr","text":"எல்","tr":"el"},{"kind":"nēr","text":"லும்","tr":"lum"}]},{"text":"எல்லின்று","tr":"elliṉṟu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"எல்","tr":"el"},{"kind":"nēr","text":"லின்","tr":"liṉ"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"ஞமலியும்","tr":"ñamaliyum","foot":"karuvi