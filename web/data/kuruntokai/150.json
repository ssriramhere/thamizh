{"text":"kuruntokai","n":150,"lines":["சேணோன் மாட்டிய நறும்புகை ஞெகிழி","வான மீனின் வயின்வயின் இமைக்கும்","ஓங்குமலை நாடன் சாந்துபுல ரகலம்","உள்ளின் உண்ணோய் மல்கும்","புல்லின் மாய்வ தெவன்கொல் அன்னாய்"],"tr":["cēṇōṉ māṭṭiya naṟumpukai ñekiḻi","vāṉa mīṉiṉ vayiṉvayiṉ imaikkum","ōṅkumalai nāṭaṉ cāntupula rakalam","uḷḷiṉ uṇṇōy malkum","pulliṉ māyva tevaṉkol aṉṉāy"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"மாடலூர் கிழார்","speaker_en":"the heroine (talaivi)","poet_tr":"Māṭalūr Kiḻār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 3, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஆய்"}],"ending":"ஆய்","lines":[[{"text":"சேணோன்","tr":"cēṇōṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"சே","tr":"cē"},{"kind":"nēr","text":"ணோன்","tr":"ṇōṉ"}]},{"text":"மாட்டிய","tr":"māṭṭiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மாட்","tr":"māṭ"},{"kind":"nirai","text":"டிய","tr":"ṭiya"}]},{"text":"நறும்புகை","tr":"naṟumpukai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நறும்","tr":"naṟum"},{"kind":"nirai","text":"புகை","tr":"pukai"}]},{"text":"ஞெகிழி","tr":"ñekiḻi","foot":"puḷimā","acai":[{"kind":"nirai","text":"ஞெகி","tr":"ñeki"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]}],[{"text":"வான","tr":"vāṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"மீனின்","tr":"mīṉiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"மீ","tr":"mī"},{"kind":"nēr","text":"னின்","tr":"ṉiṉ"}]},{"text":"வயின்வயின்","tr":"vayiṉvayiṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வயின்","tr":"vayiṉ"},{"kind":"nirai","text":"வயின்","tr":"vayiṉ"}]},{"text":"இமைக்கும்","tr":"imaikkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"இமைக்","tr":"ima