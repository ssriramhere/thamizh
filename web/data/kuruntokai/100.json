tr":"varaip"}]}],[{"text":"பாவையின்","tr":"pāvaiyiṉ","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"வை","tr":"vai"},{"kind":"nēr","text":"யின்","tr":"yiṉ"}]},{"text":"மடவந்","tr":"maṭavan","foot":"puḷimā","acai":[{"kind":"nirai","text":"மட","tr":"maṭa"},{"kind":"nēr","text":"வந்","tr":"van"}]},{"text":"தனளே","tr":"taṉaḷē","foot":"puḷimā","acai":[{"kind":"nirai","text":"தன","tr":"taṉa"},{"kind":"nēr","text":"ளே","tr":"ḷē"}]}],[{"text":"மணத்தற்","tr":"maṇattaṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மணத்","tr":"maṇat"},{"kind":"nēr","text":"தற்","tr":"taṟ"}]},{"text":"கரிய","tr":"kariya","foot":"puḷimā","acai":[{"kind":"nirai","text":"கரி","tr":"kari"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"பணைப்பெருந்","tr":"paṇaipperun","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பணைப்","tr":"paṇaip"},{"kind":"nirai","text":"பெருந்","tr":"perun"}]},{"text":"தோளே","tr":"tōḷē","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ளே","tr":"ḷē"}]}]]},"ai":{"lines":[{"words":[{"surface":"அருவி","parts":[{"text":"அருவி","lemma":"அருவி","gloss":"waterfall"}],"gloss":"waterfall"},{"surface":"பரப்பின்","parts":[{"text":"பரப்பு","lemma":"பரப்பு","gloss":"expanse"},{"text":"இன்","lemma":"இன்","gloss":"of"}],"gloss":"of the expanse"},{"surface":"ஐவனம்","parts":[{"text":"ஐவனம்","lemma":"ஐவனம்","gloss":"mountain rice"}],"gloss":"mountain rice"},{"surface":"வித்தி","parts":[{"text":"வித்தி","lemma":"வித்தி","gloss":"having sown"}],"gloss":"having sown"}]},{"words":[{"surface":"பரு","parts":[{"text":"பரு","lemma":"பரு","gloss":"large"}],"gloss":"large"},{"surface":"இலை","parts":[{"text":"இலை","lemma":"இலை","gloss":"leaf"}],"gloss":"leaf"},{"surface":"குளவியொடு","parts":[{"text":"குளவி","lemma":"குளவி","gloss":"wild jasmine"},{"text":"ஒடு","lemma":"ஒடு","gloss":"with"}],"gloss":"with wild jasmine"},{"surface":"பசு","parts":[{"text":"பசு","lemma":"பசு","gloss":"green"}],"gloss":"green"},{"surface":"மரல்","parts":[{"text":"மரல்","lemma":"மரல்","gloss":"bowstring hemp"}],"gloss":"bowstring hemp"},{"surface":"கட்கும்","parts":[{"text":"கள்","lemma":"கள்","gloss":"to weed"},{"text":"கும்","lemma":"கும்","gloss":"habitual suffix"}],"gloss":"weeding"}]},{"words":[{"surface":"காந்தள்","parts":[{"text":"காந்தள்","lemma":"காந்தள்","gloss":"Malabar glory lily"}],"gloss":"Malabar glory lily"},{"surface":"வேலி","parts":[{"text":"வேலி","lemma":"வேலி","gloss":"fence"}],"gloss":"fence"},{"surface":"சிறு","parts":[{"text":"சிறு","lemma":"சிறு","gloss":"small"}],"gloss":"small"},{"surface":"குடி","parts":[{"text":"குடி","lemma":"குடி","gloss":"settlement"}],"gloss":"hamlet"},{"surface":"பசிப்பின்","parts":[{"text":"பசி","lemma":"பசி","gloss":"hunger"},{"text":"ப்பு","lemma":"ப்பு","gloss":"noun derivative"},{"text":"இன்","lemma":"இன்","gloss":"if"}],"gloss":"if hungry"}]},{"words":[{"surface":"கடும்","parts":[{"text":"கடும்","lemma":"கடுமை","gloss":"fierce"}],"gloss":"fierce"},{"surface":"கண்","parts":[{"text":"கண்","lemma":"கண்","gloss":"eye"}],"gloss":"eye"},{"surface":"வேழத்து","parts":[{"text":"வேழத்து","lemma":"வேழத்து","gloss":"of the elephant"}],"gloss":"of the elephant","split_unverified":true},{"surface":"கோடு","parts":[{"text":"கோடு","lemma":"கோடு","gloss":"tusk"}],"gloss":"tusk"},{"surface":"நொடுத்து","parts":[{"text":"நொடுத்து","lemma":"நொடு","gloss":"having bartered"}],"gloss":"having bartered"},{"surface":"உண்ணும்","parts":[{"text":"உண்ணும்","lemma":"உண்","gloss":"eating"}],"gloss":"eating"}]},{"words":[{"surface":"வல்","parts":[{"text":"வல்","lemma":"வல்","gloss":"strong"}],"gloss":"strong"},{"surface":"வில்","parts":[{"text":"வில்","lemma":"வில்","gloss":"bow"}],"gloss":"bow"},{"surface":"ஓரி","parts":[{"text":"ஓரி","lemma":"ஓரி","gloss":"chieftain Ori"}],"gloss":"chieftain Ori"},{"surface":"கொல்லி","parts":[{"text":"கொல்லி","lemma":"கொல்லி","gloss":"Kolli hills"}],"gloss":"Kolli hills"},{"surface":"குட","parts":[{"text":"குட","lemma":"குட","gloss":"western"}],"gloss":"western"},{"surface":"வரை","parts":[{"text":"வரை","lemma":"வரை","gloss":"mountain"}],"gloss":"mountain slope"}]},{"words":[{"surface":"பாவையின்","parts":[{"text":"பாவை","lemma":"பாவை","gloss":"statue"},{"text":"இன்","lemma":"இன்","gloss":"like"}],"gloss":"like the statue"},{"surface":"மடவந்தனளே","parts":[{"text":"மடவந்தனளே","lemma":"மடவந்தனளே","gloss":"she is of gentle innocence indeed"}],"gloss":"she is of gentle innocence indeed","split_unverified":true}]},{"words":[{"surface":"மணத்தற்","parts":[{"text":"மணத்தற்","lemma":"மணத்தற்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"கரிய","parts":[{"text":"கரிய","lemma":"கரிய","gloss":""}],"gloss":"","split_unverified":true},{"surface":"பணைப்பெருந்","parts":[{"text":"பணைப்பெருந்","lemma":"பணைப்பெருந்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தோளே","parts":[{"text":"தோளே","lemma":"தோளே","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true}],"literal":"Sowing mountain rice in the expanse of waterfalls, / weeding green bowstring hemp along with large-leaved wild jasmine, / in the small settlement with a fence of Malabar glory lilies, if hungry, / they eat by bartering the tusks of fierce-eyed elephants. / On the western slopes of Kolli hills belonging to Ori of the strong bow, / like the statue there, she is of gentle innocence, / she who has bamboo-like large shoulders that are difficult to embrace.","translation":"In the small hamlet fenced with glory lilies, where mountain rice is sown in the expanse of waterfalls, and green bowstring hemp is weeded along with large-leaved wild jasmine, the people, when hungry, survive by bartering the tusks of fierce-eyed elephants. She, who has large, bamboo-like shoulders so difficult to embrace, is as gentle and innocent as the statue on the western slopes of the Kolli hills belonging to Ori of the strong bow.","modern":"அருவிப் பரப்பில் மலைநெல்லை விதைத்து, பெரிய இலைகளையுடைய காட்டு மல்லிகையோடு பசுமையான மரல் செடிகளையும் களையும், காந்தள் மலர்களை வேலியாகக் கொண்ட சிறுகுடியில் வாழ்பவர்கள், பசி எடுத்தால், சினங்கொண்ட கண்ணையுடைய யானையின் தந்தங்களை விற்று உண்பார்கள். வலிய வில்லையுடைய ஓரி என்பவனுக்குரிய கொல்லி மலையின் மேற்குச் சரிவில் உள்ள பாவை போன்ற மென்மையான இயல்புடையவள் அவள்; தழுவுவதற்கு அரிய மூங்கில் போன்ற பெரிய தோள்களை உடையவள் அவள்.","explanation":"This poem is spoken by the hero to himself, expressing his deep desire and the difficulty of attaining the heroine. He describes her mountain home in the Kuriñji landscape, where the inhabitants sow mountain rice and weed wild jasmine. When hungry, they do not suffer in poverty but barter precious elephant tusks for food, showing the wealth and pride of her clan. He compares the heroine's beauty and innocence to the famous, exquisite statue (Kolli Pāvai) on the western slopes of the Kolli hills ruled by the generous chieftain Valvil Ōri. The difficult terrain and the preciousness of the tusks mirror the difficulty of attaining the heroine, whose bamboo-like shoulders are described as hard to embrace.","model":"gemini-3.5-flash"}}