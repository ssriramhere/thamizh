{"text":"kuruntokai","n":100,"lines":["அருவிப் பரப்பின் ஐவனம் வித்திப்","பருவிலைக் குளவியொடு பசுமரல் கட்கும்","காந்தள் வேலிச் சிறுகுடி பசிப்பிற்","கடுங்கண் வேழத்துக் கோடுநொடுத் துண்ணும்","வல்வில் ஓரி கொல்லிக் குடவரைப்","பாவையின் மடவந் தனளே","மணத்தற் கரிய பணைப்பெருந் தோளே"],"tr":["aruvip parappiṉ aivaṉam vittip","paruvilaik kuḷaviyoṭu pacumaral kaṭkum","kāntaḷ vēlic ciṟukuṭi pacippiṟ","kaṭuṅkaṇ vēḻattuk kōṭunoṭut tuṇṇum","valvil ōri kollik kuṭavaraip","pāvaiyiṉ maṭavan taṉaḷē","maṇattaṟ kariya paṇaipperun tōḷē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"கபிலர்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 15, āciriyattaḷai 9, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அருவிப்","tr":"aruvip","foot":"puḷimā","acai":[{"kind":"nirai","text":"அரு","tr":"aru"},{"kind":"nēr","text":"விப்","tr":"vip"}]},{"text":"பரப்பின்","tr":"parappiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பரப்","tr":"parap"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]},{"text":"ஐவனம்","tr":"aivaṉam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஐ","tr":"ai"},{"kind":"nirai","text":"வனம்","tr":"vaṉam"}]},{"text":"வித்திப்","tr":"vittip","foot":"tēmā","acai":[{"kind":"nēr","text":"வித்","tr":"vit"},{"kind":"nēr","text":"திப்","tr":"tip"}]}],[{"text":"பருவிலைக்","tr":"paruvilaik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பரு","tr":"paru"},{"kind":"nirai","text":"விலைக்","tr":"vilaik"}]},{"text":"குளவியொடு","tr":"kuḷaviyoṭu","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"குள","tr":"kuḷa"},{"kind":"nirai","text":"வியொ","tr":"viyo"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"பசுமரல்","tr":"pacumaral",