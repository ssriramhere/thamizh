tr":"varaip"}]}],[{"text":"பாவையின்","tr":"pāvaiyiṉ","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"வை","tr":"vai"},{"kind":"nēr","text":"யின்","tr":"yiṉ"}]},{"text":"மடவந்","tr":"maṭavan","foot":"puḷimā","acai":[{"kind":"nirai","text":"மட","tr":"maṭa"},{"kind":"nēr","text":"வந்","tr":"van"}]},{"text":"தனளே","tr":"taṉaḷē","foot":"puḷimā","acai":[{"kind":"nirai","text":"தன","tr":"taṉa"},{"kind":"nēr","text":"ளே","tr":"ḷē"}]}],[{"text":"மணத்தற்","tr":"maṇattaṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மணத்","tr":"maṇat"},{"kind":"nēr","text":"தற்","tr":"taṟ"}]},{"text":"கரிய","tr":"kariya","foot":"puḷimā","acai":[{"kind":"nirai","text":"கரி","tr":"kari"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"பணைப்பெருந்","tr":"paṇaipperun","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பணைப்","tr":"paṇaip"},{"kind":"nirai","text":"பெருந்","tr":"perun"}]},{"text":"தோளே","tr":"tōḷē","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ளே","tr":"ḷē"}]}]]},"ai":{"lines":[{"words":[{"surface":"அருவி","parts":[{"text":"அருவி","lemma":"அருவி","gloss":"waterfall"}],"gloss":"waterfall"},{"surface":"பரப்பின்","parts":[{"text":"பரப்பு","lemma":"பரப்பு","gloss":"expanse"},{"text":"இன்","lemma":"இன்","gloss":"of"}],"gloss":"of the expanse"},{"surface":"ஐவனம்","parts":[{"text":"ஐவனம்","lemma":"ஐவனம்","gloss":"mountain rice"}],"gloss":"mountain rice"},{"surface":"வித்தி","parts":[{"text":"வித்தி","lemma":"வித்தி","gloss":"having sown"}],"gloss":"having sown"}]},{"words":[{"surface":"பரு","parts":[{"text":"பரு","lemma":"பரு","gloss":"thick"}],"gloss":"thick"},{"surface":"இலை","parts":[{"text":"இலை","lemma":"இலை","gloss":"leaf"}],"gloss":"leaf"},{"surface":"குளவியொடு","parts":[{"text":"குளவி","lemma":"குளவி","gloss":"wild jasmine"},{"text":"ஒடு","lemma":"ஒடு","gloss":"with"}],"gloss":"along with wild jasmine"},{"surface":"பசு","parts":[{"text":"பசு","lemma":"பசு","gloss":"green"}],"gloss":"green"},{"surface":"மரல்","parts":[{"text":"மரல்","lemma":"மரல்","gloss":"bowstring hemp"}],"gloss":"bowstring hemp"},{"surface":"கட்கும்","parts":[{"text":"கள்","lemma":"கள்","gloss":"weed"},{"text":"கும்","lemma":"கும்","gloss":"relative participle suffix"}],"gloss":"weeding"}]},{"words":[{"surface":"காந்தள்","parts":[{"text":"காந்தள்","lemma":"காந்தள்","gloss":"gloriosa lily"}],"gloss":"gloriosa lily"},{"surface":"வேலி","parts":[{"text":"வேலி","lemma":"வேலி","gloss":"fence"}],"gloss":"fence"},{"surface":"சிறுகுடி","parts":[{"text":"சிறு","lemma":"சிறு","gloss":"small"},{"text":"குடி","lemma":"குடி","gloss":"hamlet"}],"gloss":"small hamlet"},{"surface":"பசிப்பின்","parts":[{"text":"பசி","lemma":"பசி","gloss":"hunger"},{"text":"பு","lemma":"பு","gloss":"noun suffix"},{"text":"இன்","lemma":"இன்","gloss":"if"}],"gloss":"in times of hunger"}]},{"words":[{"surface":"கடுங்கண்","parts":[{"text":"கடும்","lemma":"கடும்","gloss":"fierce"},{"text":"கண்","lemma":"கண்","gloss":"eye"}],"gloss":"fierce-eyed"},{"surface":"வேழத்து","parts":[{"text":"வேழத்து","lemma":"வேழத்து","gloss":"of the elephant"}],"gloss":"of the elephant","split_unverified":true},{"surface":"கோடு","parts":[{"text":"கோடு","lemma":"கோடு","gloss":"tusk"}],"gloss":"tusk"},{"surface":"நொடுத்து","parts":[{"text":"நொடுத்து","lemma":"நொடு","gloss":"having bartered"}],"gloss":"having bartered"},{"surface":"உண்ணும்","parts":[{"text":"உண்","lemma":"உண்","gloss":"eat"},{"text":"உம்","lemma":"உம்","gloss":"relative participle suffix"}],"gloss":"eating"}]},{"words":[{"surface":"வல்வில்","parts":[{"text":"வல்","lemma":"வல்","gloss":"strong"},{"text":"வில்","lemma":"வில்","gloss":"bow"}],"gloss":"strong bow"},{"surface":"ஓரி","parts":[{"text":"ஓரி","lemma":"ஓரி","gloss":"Ōri"}],"gloss":"Ōri"},{"surface":"கொல்லி","parts":[{"text":"கொல்லி","lemma":"கொல்லி","gloss":"Kolli hills"}],"gloss":"Kolli hills"},{"surface":"குடவரை","parts":[{"text":"குட","lemma":"குட","gloss":"western"},{"text":"வரை","lemma":"வரை","gloss":"mountain"}],"gloss":"western mountain"}]},{"words":[{"surface":"பாவையின்","parts":[{"text":"பாவை","lemma":"பாவை","gloss":"statue"},{"text":"இன்","lemma":"இன்","gloss":"like"}],"gloss":"like the statue"},{"surface":"மடவந்தனளே","parts":[{"text":"மடவந்தனளே","lemma":"மடவந்தனளே","gloss":"she possesses innocence indeed"}],"gloss":"she possesses innocence indeed","split_unverified":true}]},{"words":[{"surface":"மணத்தற்கு","parts":[{"text":"மணத்தல்","lemma":"மணத்தல்","gloss":"embracing"},{"text":"கு","lemma":"கு","gloss":"to"}],"gloss":"to embrace"},{"surface":"அரிய","parts":[{"text":"அரிய","lemma":"அரிய","gloss":"difficult"}],"gloss":"difficult"},{"surface":"பணை","parts":[{"text":"பணை","lemma":"பணை","gloss":"bamboo-like"}],"gloss":"bamboo-like"},{"surface":"பெருந்","parts":[{"text":"பெருந்","lemma":"பெருந்","gloss":"large"}],"gloss":"large","split_unverified":true},{"surface":"தோளே","parts":[{"text":"தோள்","lemma":"தோள்","gloss":"shoulders"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"shoulders indeed"}]}],"literal":"Sowing mountain rice in the expanse of waterfalls, / weeding green bowstring hemp along with thick-leaved wild jasmine, / in the small hamlet with gloriosa lily fences, if hungry, / they survive by bartering the tusks of fierce-eyed elephants. / Like the statue on the western slopes of Kolli hills of Ōri of the strong bow, / she indeed possesses innocence, / she of the bamboo-like large shoulders that are difficult to embrace.","translation":"In the small hamlet fenced with gloriosa lilies, they sow mountain rice in the expanse of waterfalls, and weed out green bowstring hemp along with thick-leaved wild jasmine. In times of hunger, they survive by bartering the tusks of fierce-eyed elephants. She, who has bamboo-like large shoulders so difficult to embrace, is as innocent and beautiful as the statue on the western slopes of the Kolli hills belonging to Ōri of the strong bow.","modern":"அருவிகள் பாயும் பரப்பில் மலைநெல்லை விதைத்து, பருத்த இலைகளையுடைய காட்டு மல்லிகையோடு பசிய மரல் செடிகளையும் களையும், காந்தள் மலர்களை வேலியாகக் கொண்ட சிறுகுடியில் வாழ்பவர்கள், பசி ஏற்படும்போது சினங்கொண்ட கண்ணையுடைய யானையின் தந்தங்களை விற்று உண்பர். அத்தகைய மலைநாட்டை ஆண்ட வல்வில் ஓரியின் கொல்லி மலையின் மேற்குப் பக்கத்தில் உள்ள பாவை போன்ற மென்மையும் அழகும் உடையவள், தழுவுவதற்கு அரிய மூங்கில் போன்ற பெரிய தோள்களைக் கொண்ட என் தலைவி.","explanation":"The hero speaks of his longing for the heroine, describing her mountain home and her exquisite beauty. Her hamlet is in the Kuriñci region, where people sow mountain rice near waterfalls, weed wild jasmine and bowstring hemp, and barter elephant tusks for food during times of hunger. This shows the rugged, wealthy, yet challenging mountain life. He compares the heroine to the famous, exquisitely carved, or divine statue (Kollib-pāvai) on the western slopes of the Kolli hills, ruled by the generous chieftain Valvil Ōri. Her bamboo-like shoulders are incredibly beautiful but hard to embrace, reflecting both her high status and his intense longing.","model":"gemini-3.5-flash"}}