{"text":"kuruntokai","n":160,"lines":["நெருப்பி னன்ன செந்தலை யன்றில்","இறவி னன்ன கொடுவாய்ப் பேடையொடு","தடவின் ஓங்குசினைக் கட்சியிற் பிரிந்தோர்","கையற நரலு நள்ளென் யாமத்துப்","பெருந்தண் வாடையும் வாரார்","இஃதோ தோழிநங் காதலர் வரவே"],"tr":["neruppi ṉaṉṉa centalai yaṉṟil","iṟavi ṉaṉṉa koṭuvāyp pēṭaiyoṭu","taṭaviṉ ōṅkuciṉaik kaṭciyiṟ pirintōr","kaiyaṟa naralu naḷḷeṉ yāmattup","peruntaṇ vāṭaiyum vārār","iḵtō tōḻinaṅ kātalar varavē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"மதுரை மருதனிள நாகனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Maturai Marutaṉiḷa Nākaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19, veṇcīr 3, vañcicīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 6, oṉṟiya vañcittaḷai 1, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நெருப்பி","tr":"neruppi","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெருப்","tr":"nerup"},{"kind":"nēr","text":"பி","tr":"pi"}]},{"text":"னன்ன","tr":"ṉaṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"னன்","tr":"ṉaṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"செந்தலை","tr":"centalai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"செந்","tr":"cen"},{"kind":"nirai","text":"தலை","tr":"talai"}]},{"text":"யன்றில்","tr":"yaṉṟil","foot":"tēmā","acai":[{"kind":"nēr","text":"யன்","tr":"yaṉ"},{"kind":"nēr","text":"றில்","tr":"ṟil"}]}],[{"text":"இறவி","tr":"iṟavi","foot":"puḷimā","acai":[{"kind":"nirai","text":"இற","tr":"iṟa"},{"kind":"nēr","text":"வி","tr":"vi"}]},{"text":"னன்ன","tr":"ṉaṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"னன்","tr":"ṉaṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"கொடுவாய்ப்","tr":"koṭuvāyp","foot":"puḷimā","acai":[{"kind":"nirai","text":"கொடு","tr":"koṭu"},{"kind":"nēr","text":"வாய்ப்","tr":"vāyp"}]},{"te