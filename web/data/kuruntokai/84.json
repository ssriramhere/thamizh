{"text":"kuruntokai","n":84,"lines":["பெயர்த்தனென் முயங்கயான் வியர்த்தனென் என்றனள்","இனியறிந் தேனது துனியா குதலே","கழல்தொடி ஆஅய் மழைதவழ் பொதியில்","வேங்கையும் காந்தளும் நாறி","ஆம்பல் மலரினும் தான்தண் தணியளே"],"tr":["peyarttaṉeṉ muyaṅkayāṉ viyarttaṉeṉ eṉṟaṉaḷ","iṉiyaṟin tēṉatu tuṉiyā kutalē","kaḻaltoṭi āay maḻaitavaḻ potiyil","vēṅkaiyum kāntaḷum nāṟi","āmpal malariṉum tāṉtaṇ taṇiyaḷē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"செவிலி கூற்று","poet_ta":"மோசிகீரனார்","speaker_en":"the foster-mother (cevili)","poet_tr":"Mōcikīraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 11, āciriyattaḷai 7"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பெயர்த்தனென்","tr":"peyarttaṉeṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெயர்த்","tr":"peyart"},{"kind":"nirai","text":"தனென்","tr":"taṉeṉ"}]},{"text":"முயங்கயான்","tr":"muyaṅkayāṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"முயங்","tr":"muyaṅ"},{"kind":"nirai","text":"கயான்","tr":"kayāṉ"}]},{"text":"வியர்த்தனென்","tr":"viyarttaṉeṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வியர்த்","tr":"viyart"},{"kind":"nirai","text":"தனென்","tr":"taṉeṉ"}]},{"text":"என்றனள்","tr":"eṉṟaṉaḷ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nirai","text":"றனள்","tr":"ṟaṉaḷ"}]}],[{"text":"இனியறிந்","tr":"iṉiyaṟin","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இனி","tr":"iṉi"},{"kind":"nirai","text":"யறிந்","tr":"yaṟin"}]},{"text":"தேனது","tr":"tēṉatu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தே","tr":"tē"},{"kind":"nirai","text":"னது","tr":"ṉatu"}]},{"text":"துனியா","tr":"tuṉiyā","foot":"puḷimā","acai":[{"kind":"nirai","text":"துனி","tr":"tuṉi"},{"kind":"nēr","text":"யா","tr":"yā"}]},{"text":"குதலே","tr":"ku