s":[{"text":"முயங்க","lemma":"முயங்குதல்","gloss":"to embrace"}],"gloss":"to embrace"},{"surface":"யான்","parts":[{"text":"யான்","lemma":"யான்","gloss":"I"}],"gloss":"I"},{"surface":"வியர்த்தனென்","parts":[{"text":"வியர்த்து","lemma":"வியர்த்தல்","gloss":"sweated"},{"text":"அன்","lemma":"அன்","gloss":"empty particle"},{"text":"என்","lemma":"என்","gloss":"I (pronominal termination)"}],"gloss":"I sweated"},{"surface":"என்றனள்","parts":[{"text":"என்று","lemma":"என்றல்","gloss":"said"},{"text":"அன்","lemma":"அன்","gloss":"empty particle"},{"text":"அள்","lemma":"அள்","gloss":"she (pronominal termination)"}],"gloss":"she said"}]},{"words":[{"surface":"இனி","parts":[{"text":"இனி","lemma":"இனி","gloss":"now"}],"gloss":"now"},{"surface":"அறிந்தேன்","parts":[{"text":"அறிந்து","lemma":"அறிதல்","gloss":"known"},{"text":"ஏன்","lemma":"ஏன்","gloss":"I (pronominal termination)"}],"gloss":"I understood"},{"surface":"அது","parts":[{"text":"அது","lemma":"அது","gloss":"that"}],"gloss":"that"},{"surface":"துனி","parts":[{"text":"துனி","lemma":"துனி","gloss":"dislike/aversion"}],"gloss":"dislike/aversion"},{"surface":"ஆகுதலே","parts":[{"text":"ஆகுதல்","lemma":"ஆகுதல்","gloss":"becoming"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed (emphasis)"}],"gloss":"becoming indeed"}]},{"words":[{"surface":"கழல்","parts":[{"text":"கழல்","lemma":"கழல்","gloss":"hero's anklet"}],"gloss":"hero's anklet"},{"surface":"தொடி","parts":[{"text":"தொடி","lemma":"தொடி","gloss":"armlet/bracelet"}],"gloss":"armlet"},{"surface":"ஆஅய்","parts":[{"text":"ஆஅய்","lemma":"ஆஅய்","gloss":"Chieftain Ay"}],"gloss":"Chieftain Ay"},{"surface":"மழை","parts":[{"text":"மழை","lemma":"மழை","gloss":"cloud/rain"}],"gloss":"cloud"},{"surface":"தவழ்","parts":[{"text":"தவழ்","lemma":"தவழ்தல்","gloss":"crawling/creeping"}],"gloss":"crawling"},{"surface":"பொதியில்","parts":[{"text":"பொதியில்","lemma":"பொதியில்","gloss":"Potiyil mountain"}],"gloss":"Potiyil mountain"}]},{"words":[{"surface":"வேங்கையும்","parts":[{"text":"வேங்கை","lemma":"வேங்கை","gloss":"Kino tree flower"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and the Kino tree flower"},{"surface":"காந்தளும்","parts":[{"text":"காந்தள்","lemma":"காந்தள்","gloss":"gloriosa lily flower"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and the gloriosa lily"},{"surface":"நாறி","parts":[{"text":"நாறி","lemma":"நாறுதல்","gloss":"smelling of / fragrant with"}],"gloss":"fragrant with"}]},{"words":[{"surface":"ஆம்பல்","parts":[{"text":"ஆம்பல்","lemma":"ஆம்பல்","gloss":"water lily"}],"gloss":"water lily"},{"surface":"மலரினும்","parts":[{"text":"மலர்","lemma":"மலர்","gloss":"flower"},{"text":"இன்","lemma":"இன்","gloss":"than (comparative)"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"even more than the flower"},{"surface":"தான்","parts":[{"text":"தான்","lemma":"தான்","gloss":"she herself"}],"gloss":"she herself"},{"surface":"தண்","parts":[{"text":"தண்","lemma":"தண்மை","gloss":"coolness"}],"gloss":"cool"},{"surface":"தணியளே","parts":[{"text":"தணியள்","lemma":"தணியள்","gloss":"cool/gentle woman"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed (emphasis)"}],"gloss":"is of cool nature indeed"}]}],"literal":"I turned [her] to embrace, 'I sweated,' she said. / Now I knew that to be [her] aversion. / In the cloud-crawling Potiyil of Ay of the hero's anklet and armlet, / smelling of vēṅkai and kāntal, / she herself is cooler than even the water-lily flower.","translation":"When I turned her to embrace her, she said, 'I have sweated' [and drew back]. Only now do I understand that it was her aversion to my touch. She, who is fragrant with the vēṅkai and kāntal flowers of the cloud-crawling Potiyil mountain of the chieftain Āy who wears hero's anklets and armlets, is herself cooler and gentler than even the water-lily flower.","modern":"நான் அவளைத் தழுவுவதற்காகத் திருப்பியபோது, 'எனக்கு வேர்த்துவிட்டது' என்று அவள் கூறினாள். அது என் மீதான அவளது வெறுப்பு (விலகல்) என்பதை இப்போதுதான் நான் உணர்ந்துகொண்டேன். வீரக்கழலும் தோள்வளையும் அணிந்த ஆய் மன்னனின், மேகங்கள் தவழும் பொதிய மலையில் மலரும் வேங்கை மற்றும் காந்தள் மலர்களின் நறுமணத்தைக் கொண்டவளும், ஆம்பல் மலரை விடவும் குளுமையானவளுமாகிய என் மகள், இப்போது என்னிடமிருந்து விலகிவிட்டாள்.","explanation":"This poem is spoken by the foster-mother (cevili) after the heroine has eloped with her lover. She recalls a past incident when she tried to embrace her daughter, but the daughter shrank back, claiming she was sweating. The foster-mother now realizes that this was not mere physical sweating, but an expression of her daughter's growing aversion (tuṉi) to her touch, as her heart was already entirely devoted to her lover. The daughter is described as being fragrant with the vēṅkai and kāntal flowers of the Potiyil mountain of the chieftain Āy, and as being cooler and gentler than a water-lily. This contrast between her natural coolness and her sudden 'sweating' highlights the emotional turmoil and secrecy of her secret love before her elopement.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,1.4],[1.4,2.0],[2.15,2.6],[2.6,3.57],[3.57,3.9],[3.9,4.26],[4.41,4.72],[4.8,5.3],[5.3,5.6],[5.6,6.3],[6.3,6.6],[6.6,7.8],[7.8,8.1],[8.1,8.5],[8.5,9.6],[9.6,10.1],[10.1,10.53],[10.77,11.0]],"female":[[0.0,0.9],[0.9,1.6],[1.6,2.3],[2.3,3.0],[3.0,4.07],[4.07,4.7],[4.7,4.9],[4.9,5.58],[5.58,6.34],[6.34,6.8],[6.8,7.6],[7.6,8.0],[8.0,9.4],[9.4,9.6],[9.6,10.0],[10.0,11.1],[11.1,11.6],[11.6,12.3],[12.38,12.72]]},"sync":[[["பெயர்த்தனென்","I moved [her]"]],[["முயங்க","to embrace"],["யான்","I"]],[["வியர்த்தனென்","I sweated"]],[["என்றனள்","she said"]],[["இனி","now"],["அறிந்தேன்","I understood"]],[["அறிந்தேன்","I understood"],["அது","that"]],[["துனி","dislike/aversion"]],[["ஆகுதலே","becoming indeed"]],[["கழல்","hero's anklet"],["தொடி","armlet"]],[["ஆஅய்","Chieftain Ay"]],[["மழை","cloud"],["தவழ்","crawling"]],[["பொதியில்","Potiyil mountain"]],[["வேங்கையும்","and the Kino tree flower"]],[["காந்தளும்","and the gloriosa lily"]],[["நாறி","fragrant with"]],[["ஆம்பல்","water lily"]],[["மலரினும்","even more than the flower"]],[["தான்","she herself"],["தண்","cool"]],[["தணியளே","is of cool nature indeed"]]]}