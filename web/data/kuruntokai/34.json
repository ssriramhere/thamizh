வெருவு","gloss":"fearing"}],"gloss":"fearing"}]},{"words":[{"surface":"குட்டுவன்","parts":[{"text":"குட்டுவன்","lemma":"குட்டுவன்","gloss":"Kuttuvan"}],"gloss":"Kuttuvan"},{"surface":"மாந்தை","parts":[{"text":"மாந்தை","lemma":"மாந்தை","gloss":"Mantai"}],"gloss":"Mantai"},{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"அன்ன","gloss":"like"}],"gloss":"like"},{"surface":"எம்","parts":[{"text":"எம்","lemma":"எம்","gloss":"our"}],"gloss":"our"}]},{"words":[{"surface":"குழை","parts":[{"text":"குழை","lemma":"குழை","gloss":"ear-ornament"}],"gloss":"ear-ornament"},{"surface":"விளங்கு","parts":[{"text":"விளங்கு","lemma":"விளங்கு","gloss":"shining"}],"gloss":"shining"},{"surface":"ஆய்","parts":[{"text":"ஆய்","lemma":"ஆய்","gloss":"beautiful"}],"gloss":"beautiful"},{"surface":"நுதல்","parts":[{"text":"நுதல்","lemma":"நுதல்","gloss":"forehead"}],"gloss":"forehead"},{"surface":"கிழவனும்","parts":[{"text":"கிழவன்","lemma":"கிழவன்","gloss":"lord"},{"text":"உம்","lemma":"உம்","gloss":"also"}],"gloss":"lord also"},{"surface":"அவனே","parts":[{"text":"அவன்","lemma":"அவன்","gloss":"he"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"he indeed"}]}],"literal":"Even when punished they do not cease, even when forbidden they do not understand, / the gossip in which lonely people sleep having ceased to exist, / may this town rejoice having heard sweet news! / In front of the elephant, the beautiful seashore grove's large flock of herons, / fearing the shouting sound of the warriors who conquered, / like Mantai of Kuttuvan is our / lord of the beautiful forehead where ear-ornaments shine, he himself.","translation":"They do not stop even when punished; they do not understand even when forbidden. Now that the gossip, which kept lonely people awake, has ceased, let this town hear sweet news and rejoice! He is indeed the lord of her who has a beautiful forehead adorned with shining ear-ornaments—our lord, who is like the city of Māntai belonging to Kuttuvan, where large flocks of herons in the seashore grove, standing before elephants, are startled by the roaring shouts of victorious warriors.","modern":"கண்டித்தாலும் அவர்கள் நிறுத்தமாட்டார்கள்; தடுத்தாலும் அவர்கள் புரிந்து கொள்ளமாட்டார்கள். தனிமையில் வாடுவோர் தூக்கத்தைக் கெடுத்த அலர் இப்போது அடங்கிவிட்டதால், இவ்வூர் இனிமையான செய்தியைக் கேட்டு மகிழ்ச்சி அடையட்டும்! வெற்றிகொண்ட வீரர்களின் ஆரவார ஒலியைக் கேட்டு அஞ்சி, யானையின் முன்னால் கடற்கரைச் சோலையிலுள்ள பெரிய நாரைக் கூட்டங்கள் வெருண்டோடும் குட்டுவனின் மாந்தை நகரம் போன்றவள் எம் தலைவி. விளங்கும் குண்டலங்கள் அசைந்து ஒளிரும் அழகிய நெற்றியை உடைய அவளுக்குத் தலைவனும் அவனே ஆவான்.","explanation":"This poem is spoken by the heroine's friend (தோழி) to the townspeople or to herself, expressing relief that the public gossip (அலர்) regarding the lovers' secret meetings has finally ended. She notes that the gossiping townspeople never stopped their slander despite being discouraged, but now that the marriage is settled, the gossip has died down and the town can rejoice in the happy news. The heroine is compared to the prosperous city of Māntai belonging to the Chera king Kuttuvan. In Māntai, herons in the coastal groves are startled by the loud, victorious roars of warriors in front of elephants, mirroring how the heroine was startled and distressed by the loud public gossip in her coastal home. Now, with the hero arriving to marry her, peace is restored.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.65],[0.65,1.1],[1.1,1.7],[1.7,2.4],[2.4,3.1],[3.1,3.3],[3.3,3.6],[3.71,4.4],[4.4,5.7],[5.7,5.9],[5.9,6.38],[6.38,6.5],[6.5,6.88],[7.27,8.8],[8.8,9.2],[9.2,9.4],[9.4,10.04],[10.2,11.5],[11.5,11.9],[11.9,12.36],[12.55,12.8],[12.8,14.2],[14.2,14.4],[14.87,15.37],[15.37,15.86],[15.86,16.36],[16.36,16.76],[16.76,17.7]],"female":[[0.0,0.6],[0.6,1.1],[1.1,1.58],[1.58,1.74],[1.74,1.9],[1.9,3.26],[3.26,3.8],[3.9,4.5],[4.5,5.8],[5.8,6.24],[6.24,7.08],[7.08,7.41],[7.41,7.92],[7.92,8.76],[8.76,9.43],[9.43,10.1],[10.1,10.74],[11.13,11.83],[11.83,12.6],[12.6,13.17],[13.4,13.7],[13.7,14.7],[14.7,15.3],[15.48,15.82],[16.73,17.09],[17.09,17.69],[17.69,18.17],[18.17,19.2]]},"sync":[[["ஒறுப்ப","even when punished"]],[["ஓவலர்","they do not cease"]],[["மறுப்ப","even when forbidden"],["தேறலர்","they do not understand"]],[["தேறலர்","they do not understand"]],[["தமியர்","lonely people"]],[["உறங்கும்","sleeping"]],[["கௌவை","gossip"]],[["இன்றாய்","having ceased to exist"]],[["இனியது","sweet news"]],[["கேட்டு","having heard"],["இன்புறுக","may rejoice"]],[["இன்புறுக","may rejoice"],["இவ்","this"]],[["ஊரே","town indeed"]],[["முனாஅது","in front"]],[["முனாஅது","in front"],["யானையம்","elephant-like"]],[["குருகின்","of the heron"]],[["கானலம்","of the seaside grove"]],[["பெருந்தோடு","large flock"]],[["அட்ட","conquered"]],[["மள்ளர்","warriors"]],[["ஆர்ப்பு","shouting"],["இசை","sound"]],[["வெரூஉம்","fearing"]],[["குட்டுவன்","Kuttuvan"]],[["மாந்தை","Mantai"]],[["அன்ன","like"],["எம்","our"]],[["குழை","ear-ornament"],["விளங்கு","shining"]],[["விளங்கு","shining"],["ஆய்","beautiful"],["நுதல்","forehead"]],[["கிழவனும்","lord also"]],[["கிழவனும்","lord also"],["அவனே","he indeed"]]]}