{"text":"kuruntokai","n":34,"lines":["ஒறுப்ப வோவலர் மறுப்பத் தேறலர்","தமியர் உறங்கும் கௌவை யின்றாய்","இனியது கேட்டின் புறுகவிவ் வூரே","முனாஅ தியானையங் குருகின் கானலம் பெருந்தோடு","அட்ட மள்ளர் ஆர்ப்பிசை வெரூஉம்","குட்டுவன் மாந்தை யன்னவெம்","குழைவிளங் காய்நுதற் கிழவனு மவனே"],"tr":["oṟuppa vōvalar maṟuppat tēṟalar","tamiyar uṟaṅkum kauvai yiṉṟāy","iṉiyatu kēṭṭiṉ puṟukaviv vūrē","muṉāa tiyāṉaiyaṅ kurukiṉ kāṉalam peruntōṭu","aṭṭa maḷḷar ārppicai verūum","kuṭṭuvaṉ māntai yaṉṉavem","kuḻaiviḷaṅ kāynutaṟ kiḻavaṉu mavaṉē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தோழி கூற்று","poet_ta":"கொல்லிக் கண்ணனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kollik Kaṇṇaṉār"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"1×5, 5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 10, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"1 five-foot line (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"ஒறுப்ப","tr":"oṟuppa","foot":"puḷimā","acai":[{"kind":"nirai","text":"ஒறுப்","tr":"oṟup"},{"kind":"nēr","text":"ப","tr":"pa"}]},{"text":"வோவலர்","tr":"vōvalar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வோ","tr":"vō"},{"kind":"nirai","text":"வலர்","tr":"valar"}]},{"text":"மறுப்பத்","tr":"maṟuppat","foot":"puḷimā","acai":[{"kind":"nirai","text":"மறுப்","tr":"maṟup"},{"kind":"nēr","text":"பத்","tr":"pat"}]},{"text":"தேறலர்","tr":"tēṟalar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தே","tr":"tē"},{"kind":"nirai","text":"றலர்","tr":"ṟalar"}]}],[{"text":"தமியர்","tr":"tamiyar","foot":"puḷimā","acai":[{"kind":"nirai","text":"தமி","tr":"tami"},{"kind":"nēr","text":"யர்","tr":"yar"}]},{"text":"உறங்கும்","tr":"uṟaṅkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"உறங்","tr":"uṟaṅ"},{"kind":"nēr","text":"கும்","tr":"kum"}]},{"text":"கௌவை"