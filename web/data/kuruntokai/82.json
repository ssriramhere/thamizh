"},{"kind":"nirai","text":"சிரம்","tr":"ciram"}]},{"text":"வாரா","tr":"vārā","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ரா","tr":"rā"}]},{"text":"தோரே","tr":"tōrē","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ரே","tr":"rē"}]}]]},"ai":{"lines":[{"words":[{"surface":"வார்","parts":[{"text":"வார்","lemma":"vār","gloss":"be long/flowing"}],"gloss":"long/flowing"},{"surface":"உறு","parts":[{"text":"உறு","lemma":"uṟu","gloss":"have/attain"}],"gloss":"having"},{"surface":"வணர்","parts":[{"text":"வணர்","lemma":"vaṇar","gloss":"be wavy/curved"}],"gloss":"wavy"},{"surface":"கதுப்பு","parts":[{"text":"கதுப்பு","lemma":"katuppu","gloss":"tresses/hair"}],"gloss":"tresses of hair"},{"surface":"உளரி","parts":[{"text":"உளரி","lemma":"uḷari","gloss":"having stroked/combed with fingers"}],"gloss":"having stroked"},{"surface":"புறம்","parts":[{"text":"புறம்","lemma":"puṟam","gloss":"back"}],"gloss":"back"},{"surface":"சேர்பு","parts":[{"text":"சேர்பு","lemma":"cērpu","gloss":"joining/resting against"}],"gloss":"resting against"}]},{"words":[{"surface":"அழாஅல்","parts":[{"text":"அழாஅல்","lemma":"அழாஅல்","gloss":"do not weep"}],"gloss":"do not weep","split_unverified":true},{"surface":"என்று","parts":[{"text":"என்","lemma":"eṉ","gloss":"say"},{"text":"று","lemma":"tu","gloss":"past participle suffix"}],"gloss":"saying"},{"surface":"நம்","parts":[{"text":"நம்","lemma":"nam","gloss":"our"}],"gloss":"our"},{"surface":"அழுத","parts":[{"text":"அழு","lemma":"aḻu","gloss":"weep"},{"text":"த்","lemma":"t","gloss":"past tense infix"},{"text":"அ","lemma":"a","gloss":"adjectival participle suffix"}],"gloss":"wept/tearful"},{"surface":"கண்","parts":[{"text":"கண்","lemma":"kaṇ","gloss":"eye"}],"gloss":"eyes"},{"surface":"துடைப்பார்","parts":[{"text":"துடை","lemma":"tuṭai","gloss":"wipe"},{"text":"ப்","lemma":"p","gloss":"future/present tense marker"},{"text":"பார்","lemma":"pār","gloss":"he who does"}],"gloss":"he who wipes"}]},{"words":[{"surface":"யார்","parts":[{"text":"யார்","lemma":"yār","gloss":"who"}],"gloss":"who"},{"surface":"ஆகுவர்","parts":[{"text":"ஆகு","lemma":"āku","gloss":"become"},{"text":"வர்","lemma":"var","gloss":"third person plural/honorific suffix"}],"gloss":"will he become"},{"surface":"கொல்","parts":[{"text":"கொல்","lemma":"kol","gloss":"particle of doubt"}],"gloss":"particle of doubt"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"tōḻi","gloss":"friend"}],"gloss":"friend"},{"surface":"சாரல்","parts":[{"text":"சாரல்","lemma":"cāral","gloss":"mountain slope"}],"gloss":"mountain slope"}]},{"words":[{"surface":"பெரும்","parts":[{"text":"பெரும்","lemma":"பெரும்","gloss":"large"}],"gloss":"large","split_unverified":true},{"surface":"புன","parts":[{"text":"புன","lemma":"புன","gloss":"upland field's"}],"gloss":"upland field's","split_unverified":true},{"surface":"குறவன்","parts":[{"text":"குறவன்","lemma":"kuṟavaṉ","gloss":"hillman"}],"gloss":"hillman"},{"surface":"சிறு","parts":[{"text":"சிறு","lemma":"சிறு","gloss":"small"}],"gloss":"small","split_unverified":true},{"surface":"தினை","parts":[{"text":"தினை","lemma":"tiṉai","gloss":"millet"}],"gloss":"millet"},{"surface":"மறு","parts":[{"text":"மறு","lemma":"maṟu","gloss":"other/stubble"}],"gloss":"stubble"},{"surface":"கால்","parts":[{"text":"கால்","lemma":"kāl","gloss":"stalk/stem"}],"gloss":"stalk"}]},{"words":[{"surface":"கொழும்","parts":[{"text":"கொழும்","lemma":"கொழும்","gloss":"lush"}],"gloss":"lush","split_unverified":true},{"surface":"கொடி","parts":[{"text":"கொடி","lemma":"koṭi","gloss":"vine"}],"gloss":"vine"},{"surface":"அவரை","parts":[{"text":"அவரை","lemma":"avarai","gloss":"hyacinth bean"}],"gloss":"hyacinth bean"},{"surface":"பூக்கும்","parts":[{"text":"பூ","lemma":"pū","gloss":"flower/bloom"},{"text":"க்கும்","lemma":"kkum","gloss":"habitual relative participle suffix"}],"gloss":"blooming"}]},{"words":[{"surface":"அரும்","parts":[{"text":"அரும்","lemma":"அரும்","gloss":"harsh/difficult"}],"gloss":"harsh/difficult","split_unverified":true},{"surface":"பனி","parts":[{"text":"பனி","lemma":"paṉi","gloss":"dew/cold"}],"gloss":"dew"},{"surface":"அச்சிரம்","parts":[{"text":"அச்சிரம்","lemma":"acciram","gloss":"early winter season"}],"gloss":"early winter"},{"surface":"வாராதோரே","parts":[{"text":"வாராதோர்","lemma":"vārātōr","gloss":"he who did not return"},{"text":"ஏ","lemma":"ē","gloss":"clitic of emphasis"}],"gloss":"he who has not returned"}]}],"literal":"Long, flowing, wavy tresses stroking, resting them against my back, / saying \"do not weep\", our tearful eyes he who wipes, / who will he become, O friend? On the mountain slope, / in the large upland field of the hillman, on the stubble of the small millet, / the lush vines of the hyacinth bean bloom, / in this early winter of harsh dew, he who has not returned.","translation":"O friend! He who has not returned in this early winter of harsh dew—when the lush vines of the hyacinth bean bloom on the stubble of the small millet in the hillman's large upland field on the mountain slope—who will he become to us? He who used to stroke my long, flowing, wavy tresses, resting them against my back, and wipe my tearful eyes, saying, 'Do not weep!'","modern":"தோழி! மலைச்சாரலில் உள்ள பெரிய புனத்தில், குறவனுடைய சிறிய தினை அறுவடை செய்யப்பட்ட பிறகு எஞ்சிய தாள்களில், செழுமையான அவரைக்கொடிகள் பூக்கின்ற அரிய பனியைக் கொண்ட இந்த முன்பனிக் காலத்தில் இன்னும் திரும்பி வராதவர், என் நீண்ட அலை அலையான கூந்தலைக் கோதி முதுகின் பின்னே சேர்த்துவிட்டு, 'அழாதே' என்று கூறி என் அழுத கண்களைத் துடைக்கும் அன்புடையவராக இனி எவ்வாறு இருக்க முடியும்?","explanation":"The heroine is speaking to her close friend in a state of deep distress. The hero had promised to return before the onset of the early winter season, but he has not yet arrived. The landscape of the mountain slope, belonging to the kuriñci tiṇai, shows signs of the changing season: the millet crop has been harvested, and on its dry stubble, the lush hyacinth bean vines have begun to bloom. This visual transition of nature intensifies the heroine's grief as she remembers his tender gestures. She wonders how the very man who once lovingly stroked her hair and wiped her tears, promising comfort, can now remain away during this cold, difficult season.","model":"gemini-3.5-flash"}}