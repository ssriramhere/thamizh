{"text":"kuruntokai","n":82,"lines":["வாருறு வணர்கதுப் புளரிப் புறஞ்சேர்பு","அழாஅல் என்றுநம் அழுதகண் துடைப்பார்","யாரா குவர்கொல் தோழி சாரற்","பெரும்புனக் குறவன் சிறுதினை மறுகாற்","கொழுங்கொடி அவரை பூக்கும்","அரும்பனி அச்சிரம் வாரா தோரே"],"tr":["vāruṟu vaṇarkatup puḷarip puṟañcērpu","aḻāal eṉṟunam aḻutakaṇ tuṭaippār","yārā kuvarkol tōḻi cāraṟ","perumpuṉak kuṟavaṉ ciṟutiṉai maṟukāṟ","koḻuṅkoṭi avarai pūkkum","arumpaṉi acciram vārā tōrē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"கடுவன் மள்ளனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kaṭuvaṉ Maḷḷaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 8, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வாருறு","tr":"vāruṟu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nirai","text":"ருறு","tr":"ruṟu"}]},{"text":"வணர்கதுப்","tr":"vaṇarkatup","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வணர்","tr":"vaṇar"},{"kind":"nirai","text":"கதுப்","tr":"katup"}]},{"text":"புளரிப்","tr":"puḷarip","foot":"puḷimā","acai":[{"kind":"nirai","text":"புள","tr":"puḷa"},{"kind":"nēr","text":"ரிப்","tr":"rip"}]},{"text":"புறஞ்சேர்பு","tr":"puṟañcērpu","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"புறஞ்","tr":"puṟañ"},{"kind":"nēr","text":"சேர்","tr":"cēr"},{"kind":"nēr","text":"பு","tr":"pu"}]}],[{"text":"அழாஅல்","tr":"aḻāal","foot":"puḷimā","acai":[{"kind":"nirai","text":"அழா","tr":"aḻā"},{"kind":"nēr","text":"அல்","tr":"al"}]},{"text":"என்றுநம்","tr":"eṉṟunam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nirai","text":"றுநம்","tr":"ṟunam"}]},{"text":"அழுதகண்","tr":"aḻutakaṇ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அழு","tr":