":"they will not climb"}],"gloss":"they will not climb"}]},{"words":[{"surface":"விலங்கிரு","parts":[{"text":"விலங்கு","lemma":"விலங்கு","gloss":"lying across"},{"text":"இரு","lemma":"இரு","gloss":"vast"}],"gloss":"vast and lying across"},{"surface":"முந்நீர்","parts":[{"text":"முந்நீர்","lemma":"முந்நீர்","gloss":"ocean"}],"gloss":"ocean"},{"surface":"காலின்","parts":[{"text":"கால்","lemma":"கால்","gloss":"foot"},{"text":"இன்","lemma":"இன்","gloss":"by"}],"gloss":"by foot"},{"surface":"செல்லார்","parts":[{"text":"செல்லார்","lemma":"செல்","gloss":"they will not go"}],"gloss":"they will not go"}]},{"words":[{"surface":"நாட்டின்","parts":[{"text":"நாட்டின்","lemma":"நாட்டின்","gloss":"in the country"}],"gloss":"in the country","split_unverified":true},{"surface":"நாட்டின்","parts":[{"text":"நாட்டின்","lemma":"நாட்டின்","gloss":"in the country"}],"gloss":"in the country","split_unverified":true},{"surface":"ஊரின்","parts":[{"text":"ஊர்","lemma":"ஊர்","gloss":"village"},{"text":"இன்","lemma":"இன்","gloss":"in"}],"gloss":"in the village"},{"surface":"ஊரின்","parts":[{"text":"ஊர்","lemma":"ஊர்","gloss":"village"},{"text":"இன்","lemma":"இன்","gloss":"in"}],"gloss":"in the village"}]},{"words":[{"surface":"குடிமுறை","parts":[{"text":"குடி","lemma":"குடி","gloss":"house"},{"text":"முறை","lemma":"முறை","gloss":"order"}],"gloss":"house by house"},{"surface":"குடிமுறை","parts":[{"text":"குடி","lemma":"குடி","gloss":"house"},{"text":"முறை","lemma":"முறை","gloss":"order"}],"gloss":"house by house"},{"surface":"தேரின்","parts":[{"text":"தேரின்","lemma":"தேர்","gloss":"if searched"}],"gloss":"if searched"}]},{"words":[{"surface":"கெடுநரும்","parts":[{"text":"கெடுநர்","lemma":"கெடு","gloss":"those who are lost"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"even those who are lost"},{"surface":"உளரோநம்","parts":[{"text":"உளரோ","lemma":"உள்","gloss":"are they present"},{"text":"நம்","lemma":"நம்","gloss":"our"}],"gloss":"are they present, our"},{"surface":"காதலோரே","parts":[{"text":"காதலோர்","lemma":"காதலர்","gloss":"lover"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"lover indeed"}]}],"literal":"Digging the earth they will not enter, the sky they will not climb / The wide, dark ocean by foot they will not cross / Country by country, village by village / House by house, if we search / Are there those who can remain lost, our lovers?","translation":"They cannot dig into the earth and hide, nor can they climb up into the sky. They cannot walk across the wide, dark ocean. If we search country by country, village by village, house by house, can our lover really remain lost to us?","modern":"அவர்கள் பூமியைத் தோண்டி உள்ளே நுழைய மாட்டார்கள்; வானத்தில் ஏறிப் போக மாட்டார்கள்; குறுக்கே இருக்கும் கரிய கடலைக் காலால் நடந்து கடக்க மாட்டார்கள். நாட நாடாக, ஊர் ஊராக, ஒவ்வொரு குடிசையாகத் தேடிப் பார்த்தால், நம் காதலர் நம்மிடமிருந்து தப்பித்து மறைந்து வாழ முடியுமா? முடியாது.","explanation":"This poem is spoken by the heroine's companion to console the heroine, who is deeply distressed by her lover's long absence. The companion reassures her that the lover cannot have vanished completely from the world. She argues that he cannot escape by digging into the earth, ascending to the heavens, or walking across the vast ocean. By systematically searching every country, village, and household, they are bound to find him. This reassurance belongs to the Pālai landscape, where themes of separation and the anxiety of waiting are addressed with hope and determination.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.8],[0.8,0.9],[0.9,1.3],[1.3,1.5],[1.5,2.8],[2.8,2.9],[2.9,3.6],[3.6,3.6],[3.6,4.5],[4.5,4.9],[4.9,5.0],[5.0,5.3],[5.3,6.6],[6.6,6.7],[6.7,7.6],[7.87,8.4],[8.4,8.9],[8.9,9.47]],"female":[[0.0,1.0],[1.0,1.1],[1.1,1.6],[1.6,1.9],[1.9,3.4],[3.4,3.4],[3.4,4.2],[4.2,4.3],[4.3,5.5],[5.5,5.9],[5.9,6.0],[6.0,6.3],[6.3,7.7],[7.7,7.8],[7.8,8.8],[9.05,9.55],[9.8,10.3],[10.3,11.0]]},"sync":[[["நிலந்தொட்டு","digging the earth"]],[["புகாஅர்","they will not enter"]],[["வானம்","sky"]],[["ஏறார்","they will not climb"]],[["விலங்கிரு","vast and lying across"]],[["முந்நீர்","ocean"]],[["காலின்","by foot"]],[["செல்லார்","they will not go"]],[["நாட்டின்","in the country"]],[["நாட்டின்","in the country"]],[["ஊரின்","in the village"]],[["ஊரின்","in the village"]],[["குடிமுறை","house by house"]],[["குடிமுறை","house by house"]],[["தேரின்","if searched"]],[["கெடுநரும்","even those who are lost"]],[["உளரோநம்","are they present, our"]],[["காதலோரே","lover indeed"]]]}