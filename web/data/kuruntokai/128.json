{"text":"kuruntokai","n":128,"lines":["குணகடல் திரையது பறைதபு நாரை","திண்டேர்ப் பொறையன் தொண்டி முன்றுறை","அயிரை ஆரிரைக் கணவந் தாங்குச்","சேயல் அரியோட் படர்தி","நோயை நெஞ்சே நோய்ப்பா லோயே"],"tr":["kuṇakaṭal tiraiyatu paṟaitapu nārai","tiṇṭērp poṟaiyaṉ toṇṭi muṉṟuṟai","ayirai āriraik kaṇavan tāṅkuc","cēyal ariyōṭ paṭarti","nōyai neñcē nōyppā lōyē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவன் கூற்று","poet_ta":"பரணர்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Paraṇar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 4"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"குணகடல்","tr":"kuṇakaṭal","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குண","tr":"kuṇa"},{"kind":"nirai","text":"கடல்","tr":"kaṭal"}]},{"text":"திரையது","tr":"tiraiyatu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"திரை","tr":"tirai"},{"kind":"nirai","text":"யது","tr":"yatu"}]},{"text":"பறைதபு","tr":"paṟaitapu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பறை","tr":"paṟai"},{"kind":"nirai","text":"தபு","tr":"tapu"}]},{"text":"நாரை","tr":"nārai","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"ரை","tr":"rai"}]}],[{"text":"திண்டேர்ப்","tr":"tiṇṭērp","foot":"tēmā","acai":[{"kind":"nēr","text":"திண்","tr":"tiṇ"},{"kind":"nēr","text":"டேர்ப்","tr":"ṭērp"}]},{"text":"பொறையன்","tr":"poṟaiyaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பொறை","tr":"poṟai"},{"kind":"nēr","text":"யன்","tr":"yaṉ"}]},{"text":"தொண்டி","tr":"toṇṭi","foot":"tēmā","acai":[{"kind":"nēr","text":"தொண்","tr":"toṇ"},{"kind":"nēr","text":"டி","tr":"ṭi"}]},{"text":"முன்றுறை","tr":"muṉṟuṟai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"முன்","tr":"muṉ"},{"kind":"nirai","text":"றுறை","tr":"ṟuṟai"}]}]