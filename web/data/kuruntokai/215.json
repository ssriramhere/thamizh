{"text":"kuruntokai","n":215,"lines":["படரும் பைப்பயப் பெயருஞ் சுடரும்","என்றூழ் மாமலை மறையும் இன்றவர்","வருவர்கொல் வாழி தோழி நீரில்","வறுங்கயந் துழைஇய விலங்குமருப் பியானை","குறும்பொறை மருங்கின் அமர்துணை தழீஇக்","கொடுவரி இரும்புலி காக்கும்","நெடுவரை மருங்கிற் சுரனிறந் தோரே"],"tr":["paṭarum paippayap peyaruñ cuṭarum","eṉṟūḻ māmalai maṟaiyum iṉṟavar","varuvarkol vāḻi tōḻi nīril","vaṟuṅkayan tuḻaiiya vilaṅkumarup piyāṉai","kuṟumpoṟai maruṅkiṉ amartuṇai taḻīik","koṭuvari irumpuli kākkum","neṭuvarai maruṅkiṟ curaṉiṟan tōrē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"மதுரை அளக்கர்ஞாழார் மகனார் மள்ளனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Maturai Aḷakkarñāḻār Makaṉār Maḷḷaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 10, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"படரும்","tr":"paṭarum","foot":"puḷimā","acai":[{"kind":"nirai","text":"பட","tr":"paṭa"},{"kind":"nēr","text":"ரும்","tr":"rum"}]},{"text":"பைப்பயப்","tr":"paippayap","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பைப்","tr":"paip"},{"kind":"nirai","text":"பயப்","tr":"payap"}]},{"text":"பெயருஞ்","tr":"peyaruñ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெய","tr":"peya"},{"kind":"nēr","text":"ருஞ்","tr":"ruñ"}]},{"text":"சுடரும்","tr":"cuṭarum","foot":"puḷimā","acai":[{"kind":"nirai","text":"சுட","tr":"cuṭa"},{"kind":"nēr","text":"ரும்","tr":"rum"}]}],[{"text":"என்றூழ்","tr":"eṉṟūḻ","foot":"tēmā","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nēr","text":"றூழ்","tr":"ṟūḻ"}]},{"text":"மாமலை","tr":"māmalai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"மலை","tr":"malai"}]},{"text":"மறையும்","tr":"maṟaiyum","foot":"p