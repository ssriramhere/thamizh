{"text":"kuruntokai","n":342,"lines":["கலைகை தொட்ட கமழ்சுளைப் பெரும்பழம்","காவல் மறந்த கானவன் ஞாங்கர்க்","கடியுடை மரந்தொறும் படுவலை மாட்டும்","குன்ற நாட தகுமோ பைஞ்சுனைக்","குவளைத் தண்தழை யிவளீண்டு வருந்த","நயந்தோர் புன்கண் தீர்க்கும்","பயந்தலைப் படாஅப் பண்பினை எனினே"],"tr":["kalaikai toṭṭa kamaḻcuḷaip perumpaḻam","kāval maṟanta kāṉavaṉ ñāṅkark","kaṭiyuṭai marantoṟum paṭuvalai māṭṭum","kuṉṟa nāṭa takumō paiñcuṉaik","kuvaḷait taṇtaḻai yivaḷīṇṭu varunta","nayantōr puṉkaṇ tīrkkum","payantalaip paṭāap paṇpiṉai eṉiṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"காவிரிப்பூம்பட்டினத்துக் கந்தரத்தனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kāvirippūmpaṭṭiṉattuk Kantarattaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 9, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கலைகை","tr":"kalaikai","foot":"puḷimā","acai":[{"kind":"nirai","text":"கலை","tr":"kalai"},{"kind":"nēr","text":"கை","tr":"kai"}]},{"text":"தொட்ட","tr":"toṭṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"தொட்","tr":"toṭ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"கமழ்சுளைப்","tr":"kamaḻcuḷaip","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கமழ்","tr":"kamaḻ"},{"kind":"nirai","text":"சுளைப்","tr":"cuḷaip"}]},{"text":"பெரும்பழம்","tr":"perumpaḻam","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெரும்","tr":"perum"},{"kind":"nirai","text":"பழம்","tr":"paḻam"}]}],[{"text":"காவல்","tr":"kāval","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"வல்","tr":"val"}]},{"text":"மறந்த","tr":"maṟanta","foot":"puḷimā","acai":[{"kind":"nirai","text":"மறந்","tr":"maṟan"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"கானவன்","tr":"kāṉavaṉ","