{"text":"kuruntokai","n":135,"lines":["வினையே ஆடவர்க் குயிரே வாணுதல்","மனையுறை மகளிர்க் காடவர் உயிரென","நமக்குரைத் தோருந் தாமே","அழாஅல் தோழி அழுங்குவர் செலவே"],"tr":["viṉaiyē āṭavark kuyirē vāṇutal","maṉaiyuṟai makaḷirk kāṭavar uyireṉa","namakkurait tōrun tāmē","aḻāal tōḻi aḻuṅkuvar celavē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"பாலைபாடிய பெருங் கடுங்கோ","speaker_en":"her friend (tōḻi)","poet_tr":"Pālaipāṭiya Peruṅ Kaṭuṅkō"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 15"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 3"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வினையே","tr":"viṉaiyē","foot":"puḷimā","acai":[{"kind":"nirai","text":"வினை","tr":"viṉai"},{"kind":"nēr","text":"யே","tr":"yē"}]},{"text":"ஆடவர்க்","tr":"āṭavark","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nirai","text":"டவர்க்","tr":"ṭavark"}]},{"text":"குயிரே","tr":"kuyirē","foot":"puḷimā","acai":[{"kind":"nirai","text":"குயி","tr":"kuyi"},{"kind":"nēr","text":"ரே","tr":"rē"}]},{"text":"வாணுதல்","tr":"vāṇutal","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nirai","text":"ணுதல்","tr":"ṇutal"}]}],[{"text":"மனையுறை","tr":"maṉaiyuṟai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மனை","tr":"maṉai"},{"kind":"nirai","text":"யுறை","tr":"yuṟai"}]},{"text":"மகளிர்க்","tr":"makaḷirk","foot":"puḷimā","acai":[{"kind":"nirai","text":"மக","tr":"maka"},{"kind":"nēr","text":"ளிர்க்","tr":"ḷirk"}]},{"text":"காடவர்","tr":"kāṭavar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"டவர்","tr":"ṭavar"}]},{"text":"உயிரென","tr":"uyireṉa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"உயி","tr":"uyi"},{"kind":"nirai","text":"ரென","tr":"reṉa"}]}],[{"text":"நமக்குரைத்",