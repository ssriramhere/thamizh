:"piṇittaṟṟāl","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"பிணித்","tr":"piṇit"},{"kind":"nēr","text":"தற்","tr":"taṟ"},{"kind":"nēr","text":"றால்","tr":"ṟāl"}]},{"text":"எம்மே","tr":"emmē","foot":"tēmā","acai":[{"kind":"nēr","text":"எம்","tr":"em"},{"kind":"nēr","text":"மே","tr":"mē"}]}]]},"ai":{"lines":[{"words":[{"surface":"எலுவ","parts":[{"text":"எலுவ","lemma":"எலுவன்","gloss":"friend/companion (vocative)"}],"gloss":"O companion"},{"surface":"சிறாஅர்","parts":[{"text":"சிறாஅர்","lemma":"சிறார்","gloss":"youths"}],"gloss":"youths"},{"surface":"ஏமுறு","parts":[{"text":"ஏமுறு","lemma":"ஏமுறு","gloss":"delighted/bewildered"}],"gloss":"delighted"},{"surface":"நண்ப","parts":[{"text":"நண்பு","lemma":"நண்பு","gloss":"friendship"},{"text":"அ","lemma":"அ","gloss":"vocative suffix"}],"gloss":"O friend"}]},{"words":[{"surface":"புலவர்","parts":[{"text":"புலவர்","lemma":"புலவர்","gloss":"wise men/scholars"}],"gloss":"of wise men"},{"surface":"தோழ","parts":[{"text":"தோழ","lemma":"தோழன்","gloss":"friend (vocative)"}],"gloss":"O friend"},{"surface":"கேளாய்","parts":[{"text":"கேள்","lemma":"கேள்","gloss":"listen"},{"text":"ஆய்","lemma":"ஆய்","gloss":"singular imperative suffix"}],"gloss":"listen"},{"surface":"அத்தை","parts":[{"text":"அத்தை","lemma":"அத்தை","gloss":"particle of address"}],"gloss":"please"}]},{"words":[{"surface":"மா","parts":[{"text":"மா","lemma":"மா","gloss":"great/dark"}],"gloss":"great"},{"surface":"கடல்","parts":[{"text":"கடல்","lemma":"கடல்","gloss":"ocean"}],"gloss":"ocean"},{"surface":"நடுவண்","parts":[{"text":"நடுவு","lemma":"நடுவு","gloss":"middle"},{"text":"அண்","lemma":"அண்","gloss":"locative suffix"}],"gloss":"in the middle"},{"surface":"எண்","parts":[{"text":"எண்","lemma":"எண்","gloss":"eight"}],"gloss":"eighth"},{"surface":"நாள்","parts":[{"text":"நாள்","lemma":"நாள்","gloss":"day"}],"gloss":"day"},{"surface":"பக்கத்து","parts":[{"text":"பக்கத்து","lemma":"பக்கத்து","gloss":"of the fortnight"}],"gloss":"of the fortnight","split_unverified":true}]},{"words":[{"surface":"பசு","parts":[{"text":"பசு","lemma":"பசுமை","gloss":"fresh/bright"}],"gloss":"fresh"},{"surface":"வெண்","parts":[{"text":"வெண்","lemma":"வெண்மை","gloss":"white"}],"gloss":"white"},{"surface":"திங்கள்","parts":[{"text":"திங்கள்","lemma":"திங்கள்","gloss":"moon"}],"gloss":"moon"},{"surface":"தோன்றி","parts":[{"text":"தோன்று","lemma":"தோன்று","gloss":"appear"},{"text":"இ","lemma":"இ","gloss":"verbal participle suffix"}],"gloss":"having appeared"},{"surface":"யாங்கு","parts":[{"text":"யாங்கு","lemma":"யாங்கு","gloss":"how/like"}],"gloss":"just like"}]},{"words":[{"surface":"கதுப்பு","parts":[{"text":"கதுப்பு","lemma":"கதுப்பு","gloss":"hair/tresses"}],"gloss":"hair"},{"surface":"அயல்","parts":[{"text":"அயல்","lemma":"அயல்","gloss":"beside"}],"gloss":"beside"},{"surface":"விளங்கும்","parts":[{"text":"விளங்கு","lemma":"விளங்கு","gloss":"shine"},{"text":"உம்","lemma":"உம்","gloss":"adjectival participle suffix"}],"gloss":"shining"},{"surface":"சிறு","parts":[{"text":"சிறு","lemma":"சிறுமை","gloss":"small"}],"gloss":"small"},{"surface":"நுதல்","parts":[{"text":"நுதல்","lemma":"நுதல்","gloss":"forehead"}],"gloss":"forehead"}]},{"words":[{"surface":"புது","parts":[{"text":"புது","lemma":"புதுமை","gloss":"new"}],"gloss":"newly"},{"surface":"கோள்","parts":[{"text":"கோள்","lemma":"கோள்","gloss":"captured"}],"gloss":"captured","split_unverified":true},{"surface":"யானையின்","parts":[{"text":"யானை","lemma":"யானை","gloss":"elephant"},{"text":"இன்","lemma":"இன்","gloss":"comparative/oblique suffix"}],"gloss":"like an elephant"},{"surface":"பிணித்தற்றால்","parts":[{"text":"பிணித்தற்றால்","lemma":"பிணித்தற்றால்","gloss":"is like binding"}],"gloss":"is like binding","split_unverified":true},{"surface":"எம்மே","parts":[{"text":"எம்","lemma":"யாம்","gloss":"us/me"},{"text":"ஏ","lemma":"ஏ","gloss":"emphatic suffix"}],"gloss":"me indeed"}]}],"literal":"O companion, youth, bewildered friend! / O friend of wise men, listen please! / In the middle of the great ocean, on the eighth day of the fortnight, / like the fresh white moon appearing, / beside her tresses, her shining small forehead / has bound me, like a newly captured elephant.","translation":"O companion, my young and bewildered friend, companion of wise men, please listen! Like the fresh, white crescent moon of the eighth day appearing in the middle of the dark, vast ocean, her small forehead shining beside her dark tresses has bound me fast, like a newly captured wild elephant.","modern":"என் இளமையான, மயக்கமுற்ற நண்பனே! அறிஞர்களின் தோழனே! நான் சொல்வதைக் கேட்பாயாக. கரிய பெரிய கடலின் நடுவே, வளர்பிறையின் எட்டாம் நாளில் தோன்றும் புதிய வெண்மையான பிறை நிலவைப் போல, அவளுடைய கூந்தலின் அருகே விளங்கும் சிறிய நெற்றியானது, புதிதாகப் பிடிக்கப்பட்ட காட்டு யானையைக் கட்டுவது போல என்னை முழுமையாகக் கட்டிப்போட்டுவிட்டது.","explanation":"The hero is speaking to his close friend who has noticed his distracted state. Having met the heroine in the mountainous region, the hero explains how completely captivated he is by her beauty. He compares her small, bright forehead framed by her dark hair to the eighth-day crescent moon rising over the dark ocean. This striking visual contrast of light and dark emphasizes her radiant beauty. The metaphor of a newly captured wild elephant being bound represents the hero's sudden, powerful, and inescapable captivity by love.","model":"gemini-3.5-flash"}}