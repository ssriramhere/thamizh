{"text":"kuruntokai","n":129,"lines":["எலுவ சிறாஅர் ஏமுறு நண்ப","புலவர் தோழ கேளா யத்தை","மாக்கடல் நடுவண் எண்ணாட் பக்கத்துப்","பசுவெண் திங்கள் தோன்றி யாங்குக்","கதுப்பயல் விளங்கும் சிறுநுதல்","புதுக்கோள் யானையிற் பிணித்தற்றால் எம்மே"],"tr":["eluva ciṟāar ēmuṟu naṇpa","pulavar tōḻa kēḷā yattai","mākkaṭal naṭuvaṇ eṇṇāṭ pakkattup","pacuveṇ tiṅkaḷ tōṉṟi yāṅkuk","katuppayal viḷaṅkum ciṟunutal","putukkōḷ yāṉaiyiṟ piṇittaṟṟāl emmē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"கோப்பெருஞ்சோழன்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Kōpperuñcōḻaṉ"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 20, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 6, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"எலுவ","tr":"eluva","foot":"puḷimā","acai":[{"kind":"nirai","text":"எலு","tr":"elu"},{"kind":"nēr","text":"வ","tr":"va"}]},{"text":"சிறாஅர்","tr":"ciṟāar","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிறா","tr":"ciṟā"},{"kind":"nēr","text":"அர்","tr":"ar"}]},{"text":"ஏமுறு","tr":"ēmuṟu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஏ","tr":"ē"},{"kind":"nirai","text":"முறு","tr":"muṟu"}]},{"text":"நண்ப","tr":"naṇpa","foot":"tēmā","acai":[{"kind":"nēr","text":"நண்","tr":"naṇ"},{"kind":"nēr","text":"ப","tr":"pa"}]}],[{"text":"புலவர்","tr":"pulavar","foot":"puḷimā","acai":[{"kind":"nirai","text":"புல","tr":"pula"},{"kind":"nēr","text":"வர்","tr":"var"}]},{"text":"தோழ","tr":"tōḻa","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழ","tr":"ḻa"}]},{"text":"கேளா","tr":"kēḷā","foot":"tēmā","acai":[{"kind":"nēr","text":"கே","tr":"kē"},{"kind":"nēr","text":"ளா","tr":"ḷā"}]},{"text":"யத்தை","tr":"yattai","foot":"tēmā","acai":[{"kind":"nēr","text":"யத்","tr":"yat"},{"kind