{"text":"kuruntokai","n":199,"lines":["பெறுவ தியையா தாயினும் உறுவதொன்","றுண்டுமன் வாழிய நெஞ்சே திண்டேர்க்","கைவள் ளோரி கானந் தீண்டி","எறிவளி கமழு நெறிபடு கூந்தல்","மையீ ரோதி மாஅ யோள்வயின்","இன்றை யன்ன நட்பி னிந்நோய்","இறுமுறை எனவொன் றின்றி","மறுமை யுலகத்து மன்னுதல் பெறுமே"],"tr":["peṟuva tiyaiyā tāyiṉum uṟuvatoṉ","ṟuṇṭumaṉ vāḻiya neñcē tiṇṭērk","kaivaḷ ḷōri kāṉan tīṇṭi","eṟivaḷi kamaḻu neṟipaṭu kūntal","maiyī rōti māa yōḷvayiṉ","iṉṟai yaṉṉa naṭpi ṉinnōy","iṟumuṟai eṉavoṉ ṟiṉṟi","maṟumai yulakattu maṉṉutal peṟumē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"பரணர்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Paraṇar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 12"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பெறுவ","tr":"peṟuva","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெறு","tr":"peṟu"},{"kind":"nēr","text":"வ","tr":"va"}]},{"text":"தியையா","tr":"tiyaiyā","foot":"puḷimā","acai":[{"kind":"nirai","text":"தியை","tr":"tiyai"},{"kind":"nēr","text":"யா","tr":"yā"}]},{"text":"தாயினும்","tr":"tāyiṉum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nirai","text":"யினும்","tr":"yiṉum"}]},{"text":"உறுவதொன்","tr":"uṟuvatoṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"உறு","tr":"uṟu"},{"kind":"nirai","text":"வதொன்","tr":"vatoṉ"}]}],[{"text":"றுண்டுமன்","tr":"ṟuṇṭumaṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"றுண்","tr":"ṟuṇ"},{"kind":"nirai","text":"டுமன்","tr":"ṭumaṉ"}]},{"text":"வாழிய","tr":"vāḻiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nirai","text":"ழிய","tr":"ḻiya"}]},{"text":"நெஞ்சே","tr":"neñcē","foot":"tēmā","acai":[{"kind":"nēr","text":"நெஞ்","tr":"neñ"},{"kind":"