{"text":"kuruntokai","n":228,"lines":["வீழ்தாழ் தாழை யூழுறு கொழுமுகை","குருகுளர் இறகின் விரிபுதோ டவிழும்","கானல் நண்ணிய சிறுகுடி முன்றில்","திரைவந்து பெயரும் என்பநத் துறந்து","நெடுஞ்சே ணாட்டார் ஆயினும்","நெஞ்சிற் கணியர் தண்கட னாட்டே"],"tr":["vīḻtāḻ tāḻai yūḻuṟu koḻumukai","kurukuḷar iṟakiṉ viriputō ṭaviḻum","kāṉal naṇṇiya ciṟukuṭi muṉṟil","tiraivantu peyarum eṉpanat tuṟantu","neṭuñcē ṇāṭṭār āyiṉum","neñciṟ kaṇiyar taṇkaṭa ṉāṭṭē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"செய்தி வள்ளுவர் பெருஞ்சாத்தனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Ceyti Vaḷḷuvar Peruñcāttaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 7, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வீழ்தாழ்","tr":"vīḻtāḻ","foot":"tēmā","acai":[{"kind":"nēr","text":"வீழ்","tr":"vīḻ"},{"kind":"nēr","text":"தாழ்","tr":"tāḻ"}]},{"text":"தாழை","tr":"tāḻai","foot":"tēmā","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"ழை","tr":"ḻai"}]},{"text":"யூழுறு","tr":"yūḻuṟu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யூ","tr":"yū"},{"kind":"nirai","text":"ழுறு","tr":"ḻuṟu"}]},{"text":"கொழுமுகை","tr":"koḻumukai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கொழு","tr":"koḻu"},{"kind":"nirai","text":"முகை","tr":"mukai"}]}],[{"text":"குருகுளர்","tr":"kurukuḷar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குரு","tr":"kuru"},{"kind":"nirai","text":"குளர்","tr":"kuḷar"}]},{"text":"இறகின்","tr":"iṟakiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"இற","tr":"iṟa"},{"kind":"nēr","text":"கின்","tr":"kiṉ"}]},{"text":"விரிபுதோ","tr":"viriputō","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விரி","tr":"viri"},{"kind":"nirai","text":"புதோ",