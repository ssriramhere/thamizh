{"text":"kuruntokai","n":209,"lines":["அறந்தலைப் பட்ட நெல்லியம் பசுங்காய்","மறப்புலிக் குருளை கோளிடங் கறங்கும்","இறப்பருங் குன்ற மிறந்த யாமே","குறுநடை பலவுள் ளலமே நெறிமுதற்","கடற்றிற் கலித்த முடச்சினை வெட்சி","தளையவிழ் பல்போது கமழும்","மையிருங் கூந்தன் மடந்தை நட்பே"],"tr":["aṟantalaip paṭṭa nelliyam pacuṅkāy","maṟappulik kuruḷai kōḷiṭaṅ kaṟaṅkum","iṟapparuṅ kuṉṟa miṟanta yāmē","kuṟunaṭai palavuḷ ḷalamē neṟimutaṟ","kaṭaṟṟiṟ kalitta muṭacciṉai veṭci","taḷaiyaviḻ palpōtu kamaḻum","maiyiruṅ kūntaṉ maṭantai naṭpē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவன் கூற்று","poet_ta":"பாலைபாடிய பெருங்கடுங்கோ","speaker_en":"the hero (talaivaṉ)","poet_tr":"Pālaipāṭiya Peruṅkaṭuṅkō"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 15, āciriyattaḷai 10, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அறந்தலைப்","tr":"aṟantalaip","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அறந்","tr":"aṟan"},{"kind":"nirai","text":"தலைப்","tr":"talaip"}]},{"text":"பட்ட","tr":"paṭṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"பட்","tr":"paṭ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"நெல்லியம்","tr":"nelliyam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நெல்","tr":"nel"},{"kind":"nirai","text":"லியம்","tr":"liyam"}]},{"text":"பசுங்காய்","tr":"pacuṅkāy","foot":"puḷimā","acai":[{"kind":"nirai","text":"பசுங்","tr":"pacuṅ"},{"kind":"nēr","text":"காய்","tr":"kāy"}]}],[{"text":"மறப்புலிக்","tr":"maṟappulik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மறப்","tr":"maṟap"},{"kind":"nirai","text":"புலிக்","tr":"pulik"}]},{"text":"குருளை","tr":"kuruḷai","foot":"puḷimā","acai":[{"kind":"nirai","text":"குரு","tr":"kuru"},{"kind":"nēr","text":"ளை","tr":"ḷai"}]},{"text":"கோளிடங்","tr":"kōḷiṭaṅ","foot"