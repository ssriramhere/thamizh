ன்","gloss":"my"}],"gloss":"my"},{"surface":"தூய","parts":[{"text":"தூய","lemma":"தூய","gloss":"pure"}],"gloss":"pure"},{"surface":"நெஞ்சம்","parts":[{"text":"நெஞ்சம்","lemma":"நெஞ்சம்","gloss":"heart/mind"}],"gloss":"heart"}]},{"words":[{"surface":"தோடோய்","parts":[{"text":"தோடோய்","lemma":"தோடோய்","gloss":"shoulder-embracing"}],"gloss":"shoulder-embracing","split_unverified":true},{"surface":"காதலர்ப்","parts":[{"text":"காதலர்","lemma":"காதலர்","gloss":"lovers"},{"text":"ப்","lemma":"ப்","gloss":"sandhi consonant"}],"gloss":"lovers"},{"surface":"பிரிக்கும்","parts":[{"text":"பிரிக்கும்","lemma":"பிரி","gloss":"separating"}],"gloss":"separating"}]},{"words":[{"surface":"வாள்போல்","parts":[{"text":"வாள்","lemma":"வாள்","gloss":"sword"},{"text":"போல்","lemma":"போல்","gloss":"like"}],"gloss":"like a sword"},{"surface":"வைகறை","parts":[{"text":"வைகறை","lemma":"வைகறை","gloss":"dawn"}],"gloss":"dawn"},{"surface":"வந்தன்றால்","parts":[{"text":"வந்து","lemma":"வா","gloss":"having come"},{"text":"அன்று","lemma":"அன்று","gloss":"past tense marker"},{"text":"ஆல்","lemma":"ஆல்","gloss":"emphasis particle"}],"gloss":"has arrived indeed"},{"surface":"எனவே","parts":[{"text":"என","lemma":"என்","gloss":"saying/thinking so"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"thinking so"}]}],"literal":"\"Cuckoo\" sounded the rooster; in response to that / startled was my pure heart / separating the shoulder-embracing lovers / like a sword, dawn has arrived, indeed, thinking so.","translation":"\"Cuckoo,\" crowed the rooster. In response, my pure heart was startled, thinking, \"Like a sword that cuts apart lovers embracing shoulder-to-shoulder, dawn has arrived!\"","modern":"\"குக்கூ\" என்று சேவல் கூவியது. அதற்கு எதிரொலியாக, தோளோடு தோள் தழுவி இருக்கும் காதலர்களைப் பிரிக்கும் வாளைப் போல விடியற்காலை வந்துவிட்டது என்று எண்ணி, என் தூய்மையான நெஞ்சம் திடுக்கிட்டது.","explanation":"The heroine is speaking to her companion about her anxiety at the arrival of dawn. The poem belongs to the Marutam landscape, where the theme of separation and the transition from night to day brings emotional distress. The crowing of the rooster acts as a sudden alarm that disrupts the intimacy of the night. The heroine compares the dawn to a sharp sword because it cruelly cuts through the physical embrace of the lovers. Key words include 'kōḻi' (rooster), 'tuṭku' (startled), 'tōḷ-tōy' (shoulder-embracing), and 'vāḷ' (sword).","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.5],[0.57,0.9],[0.9,1.0],[1.0,1.8],[1.8,1.91],[1.91,3.0],[3.0,3.3],[3.3,3.73],[3.73,3.8],[3.8,5.2],[5.2,5.4],[5.4,5.9],[5.9,6.3],[6.3,6.7],[6.7,7.3]],"female":[[0.0,0.5],[0.57,0.9],[0.9,1.2],[1.2,2.0],[2.3,3.0],[3.0,3.4],[3.4,4.0],[4.0,4.43],[4.43,4.5],[4.5,6.1],[6.1,6.4],[6.4,7.2],[7.2,7.7],[7.7,8.3],[8.3,8.9]]}}