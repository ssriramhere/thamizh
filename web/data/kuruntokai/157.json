{"text":"kuruntokai","n":157,"lines":["குக்கூ வென்றது கோழி அதன்எதிர்","துட்கென் றன்றென் தூய நெஞ்சம்","தோடோய் காதலர்ப் பிரிக்கும்","வாள்போல் வைகறை வந்தன்றால் எனவே"],"tr":["kukkū veṉṟatu kōḻi ataṉetir","tuṭkeṉ ṟaṉṟeṉ tūya neñcam","tōṭōy kātalarp pirikkum","vāḷpōl vaikaṟai vantaṉṟāl eṉavē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தலைவி கூற்று","poet_ta":"அள்ளூர் நன்முல்லையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Aḷḷūr Naṉmullaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 14, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 9, veṇṭaḷai 4, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"குக்கூ","tr":"kukkū","foot":"tēmā","acai":[{"kind":"nēr","text":"குக்","tr":"kuk"},{"kind":"nēr","text":"கூ","tr":"kū"}]},{"text":"வென்றது","tr":"veṉṟatu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வென்","tr":"veṉ"},{"kind":"nirai","text":"றது","tr":"ṟatu"}]},{"text":"கோழி","tr":"kōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"கோ","tr":"kō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"அதன்எதிர்","tr":"ataṉetir","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அதன்","tr":"ataṉ"},{"kind":"nirai","text":"எதிர்","tr":"etir"}]}],[{"text":"துட்கென்","tr":"tuṭkeṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"துட்","tr":"tuṭ"},{"kind":"nēr","text":"கென்","tr":"keṉ"}]},{"text":"றன்றென்","tr":"ṟaṉṟeṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"றன்","tr":"ṟaṉ"},{"kind":"nēr","text":"றென்","tr":"ṟeṉ"}]},{"text":"தூய","tr":"tūya","foot":"tēmā","acai":[{"kind":"nēr","text":"தூ","tr":"tū"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"நெஞ்சம்","tr":"neñcam","foot":"tēmā","acai":[{"kind":"nēr","text":"நெஞ்","tr":"neñ"},{"kind":"nēr","text":"சம்","tr":"cam"}]}],[{"text":"தோடோய்","tr":"tōṭōy","foot":"tēmā","acai":[{"kind":"nēr