{"text":"kuruntokai","n":257,"lines":["வேரு முதலும் கோடு மோராங்குத்","தொடுத்த போலத் தூங்குபு தொடரிக்","கீழ்தாழ் வன்ன வீழ்கோட் பலவின்","ஆர்கலி வெற்பன் வருதொறும் வரூஉம்","அகலினும் அகலா தாகி","இகலுந் தோழிநங் காமத்துப் பகையே"],"tr":["vēru mutalum kōṭu mōrāṅkut","toṭutta pōlat tūṅkupu toṭarik","kīḻtāḻ vaṉṉa vīḻkōṭ palaviṉ","ārkali veṟpaṉ varutoṟum varūum","akaliṉum akalā tāki","ikalun tōḻinaṅ kāmattup pakaiyē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"உறையூர்ச் சிறுகந்தனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Uṟaiyūrc Ciṟukantaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 7, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வேரு","tr":"vēru","foot":"tēmā","acai":[{"kind":"nēr","text":"வே","tr":"vē"},{"kind":"nēr","text":"ரு","tr":"ru"}]},{"text":"முதலும்","tr":"mutalum","foot":"puḷimā","acai":[{"kind":"nirai","text":"முத","tr":"muta"},{"kind":"nēr","text":"லும்","tr":"lum"}]},{"text":"கோடு","tr":"kōṭu","foot":"tēmā","acai":[{"kind":"nēr","text":"கோ","tr":"kō"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"மோராங்குத்","tr":"mōrāṅkut","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"மோ","tr":"mō"},{"kind":"nēr","text":"ராங்","tr":"rāṅ"},{"kind":"nēr","text":"குத்","tr":"kut"}]}],[{"text":"தொடுத்த","tr":"toṭutta","foot":"puḷimā","acai":[{"kind":"nirai","text":"தொடுத்","tr":"toṭut"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"போலத்","tr":"pōlat","foot":"tēmā","acai":[{"kind":"nēr","text":"போ","tr":"pō"},{"kind":"nēr","text":"லத்","tr":"lat"}]},{"text":"தூங்குபு","tr":"tūṅkupu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தூங்","tr":"tūṅ"},{"kind":"nirai","text":"குபு","tr":"kupu"}]},{"text":"தொடரிக்","tr":"toṭarik