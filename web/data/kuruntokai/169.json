:"எம்","tr":"em"}]},{"text":"இறீஇயரெம்","tr":"iṟīiyarem","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"இறீ","tr":"iṟī"},{"kind":"nirai","text":"இய","tr":"iya"},{"kind":"nēr","text":"ரெம்","tr":"rem"}]},{"text":"முயிரே","tr":"muyirē","foot":"puḷimā","acai":[{"kind":"nirai","text":"முயி","tr":"muyi"},{"kind":"nēr","text":"ரே","tr":"rē"}]}]]},"ai":{"lines":[{"words":[{"surface":"சுரம்","parts":[{"text":"சுரம்","lemma":"curam","gloss":"desert"}],"gloss":"desert"},{"surface":"செல்","parts":[{"text":"செல்","lemma":"cel","gloss":"go"}],"gloss":"going"},{"surface":"யானை","parts":[{"text":"யானை","lemma":"yāṉai","gloss":"elephant"}],"gloss":"elephant"},{"surface":"கல்","parts":[{"text":"கல்","lemma":"kal","gloss":"stone"}],"gloss":"stone"},{"surface":"உறு","parts":[{"text":"உறு","lemma":"uṟu","gloss":"strike"}],"gloss":"striking"},{"surface":"கோட்டின்","parts":[{"text":"கோட்டின்","lemma":"kōṭu","gloss":"tusk"}],"gloss":"tusk"}]},{"words":[{"surface":"றெற்றென","parts":[{"text":"றெற்றென","lemma":"றெற்றென","gloss":""}],"gloss":"","split_unverified":true},{"surface":"இறீஇயரோ","parts":[{"text":"இறீஇயரோ","lemma":"இறீஇயரோ","gloss":""}],"gloss":"","split_unverified":true},{"surface":"ஐய","parts":[{"text":"ஐய","lemma":"ஐய","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மற்றியாம்","parts":[{"text":"மற்றியாம்","lemma":"மற்றியாம்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"நும்மொடு","parts":[{"text":"நும்","lemma":"num","gloss":"you"},{"text":"ஒடு","lemma":"oṭu","gloss":"with"}],"gloss":"with you"},{"surface":"நக்க","parts":[{"text":"நக்க","lemma":"naku","gloss":"that smiled"}],"gloss":"that smiled"},{"surface":"வால்","parts":[{"text":"வால்","lemma":"vāl","gloss":"pure"}],"gloss":"pure"},{"surface":"வெள்","parts":[{"text":"வெள்","lemma":"veḷ","gloss":"white"}],"gloss":"white"},{"surface":"எயிறே","parts":[{"text":"எயிறு","lemma":"eyiṟu","gloss":"teeth"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"indeed the teeth"}]},{"words":[{"surface":"பாணர்","parts":[{"text":"பாணர்","lemma":"pāṇar","gloss":"bards"}],"gloss":"bards"},{"surface":"பசு","parts":[{"text":"பசு","lemma":"pacu","gloss":"fresh"}],"gloss":"fresh"},{"surface":"மீன்","parts":[{"text":"மீன்","lemma":"mīṉ","gloss":"fish"}],"gloss":"fish"},{"surface":"சொரிந்த","parts":[{"text":"சொரிந்த","lemma":"cori","gloss":"poured"}],"gloss":"poured"},{"surface":"மண்டை","parts":[{"text":"மண்டை","lemma":"maṇṭai","gloss":"bowl"}],"gloss":"bowl"},{"surface":"போல","parts":[{"text":"போல","lemma":"pōla","gloss":"like"}],"gloss":"like"}]},{"words":[{"surface":"எமக்கும்","parts":[{"text":"எமக்கு","lemma":"emakku","gloss":"to us"},{"text":"உம்","lemma":"um","gloss":"also"}],"gloss":"to us also"},{"surface":"பெரும்புலவு","parts":[{"text":"பெரும்","lemma":"peru","gloss":"great"},{"text":"புலவு","lemma":"pulavu","gloss":"fish-stench"}],"gloss":"great fish-stench"},{"surface":"ஆகி","parts":[{"text":"ஆகி","lemma":"āku","gloss":"having become"}],"gloss":"having become"}]},{"words":[{"surface":"நும்மும்","parts":[{"text":"நும்","lemma":"num","gloss":"you"},{"text":"உம்","lemma":"um","gloss":"also"}],"gloss":"you also"},{"surface":"பெறேஎம்","parts":[{"text":"பெறேஎம்","lemma":"peṟu","gloss":"we will not obtain"}],"gloss":"we will not obtain"},{"surface":"இறீஇயர்","parts":[{"text":"இறீஇயர்","lemma":"iṟu","gloss":"may it end"}],"gloss":"may it end"},{"surface":"எம்","parts":[{"text":"எம்","lemma":"em","gloss":"our"}],"gloss":"our"},{"surface":"உயிர்","parts":[{"text":"உயிர்","lemma":"uyir","gloss":"life"}],"gloss":"life"},{"surface":"ஏ","parts":[{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"indeed"}]}],"literal":"Desert-going elephant's stone-striking tusk like / clearly may they break, O lord, and we / with you laughed, those pure white teeth! / Like the bowl in which bards poured fresh fish, / to us also having become a great fish-stench, / you also we will not obtain, may our life indeed end!","translation":"O Lord! May my pure white teeth, which once laughed in joy with you, snap and break clearly like the tusk of a desert-faring elephant that strikes against a rock! Having become a source of great stench to me, like a bowl in which bards have kept fresh fish, I can no longer have you. May my life end!","modern":"பாலைவனத்தில் செல்லும் யானையின் கல் மீது மோதிய தந்தத்தைப் போல, ஐயனே, உன்னோடு கூடி மகிழ்ந்து சிரித்த என் தூய வெண்மையான பற்கள் உடனே உடைந்து போகட்டும்! பாணர்கள் பச்ச மீன்களைப் போட்டு வைத்த பாத்திரத்தைப் போல, என் பற்கள் எனக்குப் பெரும் புலால் நாற்றமுடையதாக மாறிவிட்டன. உன்னையும் நான் பெறப்போவதில்லை; என் உயிரும் அழிந்து போகட்டும்!","explanation":"This poem is spoken by the heroine to the hero who has returned from his visits to courtesans. She expresses her deep grief and anger at his betrayal. She wishes that her teeth, which once smiled beautifully in his company, would break like an elephant's tusk striking a rock. Now, those same teeth feel like a smelly fish-bowl used by bards, representing her self-loathing and disgust at her past happiness. Since she cannot have his true love anymore, she wishes for her life to end. This poem belongs to the Marutam tiṇai (agricultural landscape), which deals with infidelity and lovers' tiffs (ūṭal).","model":"gemini-3.5-flash"},"timing":{"male":[[0.07,0.6],[0.6,1.07],[1.07,1.29],[1.5,1.8],[3.09,3.3],[3.3,3.3],[3.3,3.3],[3.3,3.41],[3.41,3.5],[3.7,3.8],[3.8,6.05],[6.21,6.38],[6.38,6.38],[6.38,6.7],[6.7,7.1],[7.1,7.5],[7.5,8.8],[8.8,9.43],[9.43,9.43],[9.43,10.1],[10.1,11.3],[11.3,11.36],[11.36,11.6]],"female":[[0.0,0.8],[0.8,1.5],[1.63,1.7],[1.7,3.23],[3.23,3.4],[3.4,3.4],[3.4,3.4],[3.4,4.1],[4.1,5.3],[5.3,5.8],[5.8,6.0],[6.0,6.0],[6.0,6.0],[6.0,8.3],[8.3,8.7],[8.7,9.2],[9.2,10.4],[10.4,10.87],[10.87,11.2],[11.42,12.1],[12.1,13.3],[13.3,13.38],[13.38,13.7]]},"sync":[[["சுரம்","desert"],["செல்","going"]],[["யானை","elephant"],["கல்","stone"]],[["கல்","stone"],["உறு","striking"]],[["கோட்டின்","tusk"]],[["றெற்றென",""]],[["இறீஇயரோ",""]],[["ஐய",""]],[["மற்றியாம்",""]],[["நும்மொடு","with you"]],[["நக்க","that smiled"]],[["வால்","pure"],["வெள்","white"]],[["எயிறே","indeed the teeth"]],[["பாணர்","bards"]],[["பசு","fresh"],["மீன்","fish"]],[["சொரிந்த","poured"]],[["மண்டை","bowl"],["போல","like"]],[["எமக்கும்","to us also"]],[["பெரும்புலவு","great fish-stench"]],[["பெரும்புலவு","great fish-stench"],["ஆகி","having become"]],[["நும்மும்","you also"]],[["பெறேஎம்","we will not obtain"]],[["இறீஇயர்","may it end"],["எம்","our"]],[["உயிர்","life"]]]}