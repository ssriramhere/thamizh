:"எம்","tr":"em"}]},{"text":"இறீஇயரெம்","tr":"iṟīiyarem","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"இறீ","tr":"iṟī"},{"kind":"nirai","text":"இய","tr":"iya"},{"kind":"nēr","text":"ரெம்","tr":"rem"}]},{"text":"முயிரே","tr":"muyirē","foot":"puḷimā","acai":[{"kind":"nirai","text":"முயி","tr":"muyi"},{"kind":"nēr","text":"ரே","tr":"rē"}]}]]},"ai":{"lines":[{"words":[{"surface":"சுரம்","parts":[{"text":"சுரம்","lemma":"curam","gloss":"desert/wasteland"}],"gloss":"desert"},{"surface":"செல்","parts":[{"text":"செல்","lemma":"cel","gloss":"go"}],"gloss":"going"},{"surface":"யானை","parts":[{"text":"யானை","lemma":"yāṉai","gloss":"elephant"}],"gloss":"elephant"},{"surface":"கல்","parts":[{"text":"கல்","lemma":"kal","gloss":"stone/rock"}],"gloss":"stone"},{"surface":"உறு","parts":[{"text":"உறு","lemma":"uṟu","gloss":"strike/dash"}],"gloss":"striking"},{"surface":"கோட்டின்","parts":[{"text":"கோட்டின்","lemma":"கோட்டின்","gloss":"of the tusk"}],"gloss":"of the tusk","split_unverified":true}]},{"words":[{"surface":"றெற்றென","parts":[{"text":"றெற்றென","lemma":"றெற்றென","gloss":""}],"gloss":"","split_unverified":true},{"surface":"இறீஇயரோ","parts":[{"text":"இறீஇயரோ","lemma":"இறீஇயரோ","gloss":""}],"gloss":"","split_unverified":true},{"surface":"ஐய","parts":[{"text":"ஐய","lemma":"ஐய","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மற்றியாம்","parts":[{"text":"மற்றியாம்","lemma":"மற்றியாம்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"நும்மொடு","parts":[{"text":"நும்","lemma":"num","gloss":"you"},{"text":"ஒடு","lemma":"oṭu","gloss":"with"}],"gloss":"with you"},{"surface":"நக்க","parts":[{"text":"நக்க","lemma":"naku","gloss":"that laughed/smiled"}],"gloss":"that laughed"},{"surface":"வால்","parts":[{"text":"வால்","lemma":"vāl","gloss":"pure/white"}],"gloss":"pure"},{"surface":"வெள்","parts":[{"text":"வெள்","lemma":"veḷ","gloss":"white"}],"gloss":"white"},{"surface":"எயிறே","parts":[{"text":"எயிறு","lemma":"eyiṟu","gloss":"tooth"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"teeth indeed"}]},{"words":[{"surface":"பாணர்","parts":[{"text":"பாணர்","lemma":"pāṇar","gloss":"bards"}],"gloss":"bards"},{"surface":"பசு","parts":[{"text":"பசு","lemma":"pacu","gloss":"fresh"}],"gloss":"fresh"},{"surface":"மீன்","parts":[{"text":"மீன்","lemma":"mīṉ","gloss":"fish"}],"gloss":"fish"},{"surface":"சொரிந்த","parts":[{"text":"சொரி","lemma":"cori","gloss":"pour"},{"text":"ந்த","lemma":"nta","gloss":"past relative participle suffix"}],"gloss":"poured"},{"surface":"மண்டை","parts":[{"text":"மண்டை","lemma":"maṇṭai","gloss":"bowl/vessel"}],"gloss":"bowl"},{"surface":"போல","parts":[{"text":"போல","lemma":"pōla","gloss":"like"}],"gloss":"like"}]},{"words":[{"surface":"எமக்கும்","parts":[{"text":"எமக்கும்","lemma":"எமக்கும்","gloss":"to us also"}],"gloss":"to us also","split_unverified":true},{"surface":"பெரும்","parts":[{"text":"பெரும்","lemma":"peru","gloss":"great"}],"gloss":"great"},{"surface":"புலவு","parts":[{"text":"புலவு","lemma":"pulavu","gloss":"stench of fish/flesh"}],"gloss":"stench of fish"},{"surface":"ஆகி","parts":[{"text":"ஆகு","lemma":"āku","gloss":"become"},{"text":"இ","lemma":"i","gloss":"verbal participle suffix"}],"gloss":"having become"}]},{"words":[{"surface":"நும்மும்","parts":[{"text":"நும்","lemma":"num","gloss":"you"},{"text":"உம்","lemma":"um","gloss":"also"}],"gloss":"you too"},{"surface":"பெறேஎம்","parts":[{"text":"பெறு","lemma":"peṟu","gloss":"obtain"},{"text":"ஏஎம்","lemma":"ēem","gloss":"first person plural negative suffix"}],"gloss":"we do not obtain"},{"surface":"இறீஇயர்","parts":[{"text":"இறு","lemma":"iṟu","gloss":"break"},{"text":"ஈஇயர்","lemma":"īiyar","gloss":"optative suffix"}],"gloss":"may it break!"},{"surface":"எம்","parts":[{"text":"எம்","lemma":"em","gloss":"our"}],"gloss":"our"},{"surface":"உயிரே","parts":[{"text":"உயிர்","lemma":"uyir","gloss":"life"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"life indeed"}]}],"literal":"Like the tusk of a desert-going elephant striking a rock / may they snap completely, O Lord! Then we, / our pure white teeth that laughed with you, / like the bowl in which bards poured fresh fish, / having become a source of great stench to us also, / and we do not obtain you, may our life perish!","translation":"O Lord! May my pure white teeth, which once smiled happily with you, snap completely like the tusk of a desert-traversing elephant that dashes against a rock! Having become a source of great stench to us, like a bowl in which bards have kept fresh fish, they are now useless. Since we cannot have you, let our life perish too!","modern":"பாலைநிலத்தில் செல்லும் யானையின் கல் மீது மோதிய தந்தத்தைப் போல, ஐயனே! உம்மோடு மகிழ்ந்து சிரித்த எம்முடைய தூய வெண்மையான பற்கள் முற்றிலும் உடைந்து போகட்டும்! பாணர்கள் பசிய மீன்களைச் சொரிந்து வைத்த பாத்திரத்தைப் போல, அவை எங்களுக்கும் பெரும் புலால் நாற்றமுடையதாக மாறிவிட்டன. உம்மையும் நாம் பெறப்போவதில்லை; ஆதலால் எமது உயிரும் அழிந்துபோகட்டும்!","explanation":"The heroine speaks to the hero who has returned from his visits to courtesans. She expresses her deep grief and anger at his infidelity. She compares her teeth, which once smiled beautifully in his company, to the tusk of a desert elephant that breaks upon hitting a rock, wishing they would break now. She also compares her mouth to a bard's bowl filled with raw fish, which has become smelly and repulsive to her because she no longer has any reason to smile. Since she cannot have his exclusive love, she wishes for her own life to end. The imagery of the fish-bowl highlights the domestic discord and sensory details of the Marutam landscape.","model":"gemini-3.5-flash"}}