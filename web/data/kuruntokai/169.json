{"text":"kuruntokai","n":169,"lines":["சுரஞ்செல் யானைக் கல்லுறு கோட்டிற்","றெற்றென இறீஇயரோ ஐய மற்றியாம்","நும்மொடு நக்க வால்வெள் ளெயிறே","பாணர் பசுமீன் சொரிந்த மண்டைபோல","எமக்கும் பெரும்புல வாகி","நும்மும் பெறேஎம் இறீஇயரெம் முயிரே"],"tr":["curañcel yāṉaik kalluṟu kōṭṭiṟ","ṟeṟṟeṉa iṟīiyarō aiya maṟṟiyām","nummoṭu nakka vālveḷ ḷeyiṟē","pāṇar pacumīṉ corinta maṇṭaipōla","emakkum perumpula vāki","nummum peṟēem iṟīiyarem muyirē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தலைவி கூற்று","poet_ta":"வெள்ளிவீதியார்","speaker_en":"the heroine (talaivi)","poet_tr":"Veḷḷivītiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 20, veṇcīr 2, other 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 11, āciriyattaḷai 9, ? 1, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"சுரஞ்செல்","tr":"curañcel","foot":"puḷimā","acai":[{"kind":"nirai","text":"சுரஞ்","tr":"curañ"},{"kind":"nēr","text":"செல்","tr":"cel"}]},{"text":"யானைக்","tr":"yāṉaik","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னைக்","tr":"ṉaik"}]},{"text":"கல்லுறு","tr":"kalluṟu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கல்","tr":"kal"},{"kind":"nirai","text":"லுறு","tr":"luṟu"}]},{"text":"கோட்டிற்","tr":"kōṭṭiṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"கோட்","tr":"kōṭ"},{"kind":"nēr","text":"டிற்","tr":"ṭiṟ"}]}],[{"text":"றெற்றென","tr":"ṟeṟṟeṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"றெற்","tr":"ṟeṟ"},{"kind":"nirai","text":"றென","tr":"ṟeṉa"}]},{"text":"இறீஇயரோ","tr":"iṟīiyarō","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"இறீ","tr":"iṟī"},{"kind":"nirai","text":"இய","tr":"iya"},{"kind":"nēr","text":"ரோ","tr":"rō"}]},{"text":"ஐய","tr":"aiya","foot":"tēmā","acai":[{"kind":"nēr","text":"ஐ","tr":"ai"},{"kind":"nēr","text":"ய","tr":"ya"}]