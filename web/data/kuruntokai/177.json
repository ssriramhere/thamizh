{"text":"kuruntokai","n":177,"lines":["கடல்பா டவிந்து கானல் மயங்கித்","துறைநீர் இருங்கழி புல்லென் றன்றே","மன்றவம் பெண்ணை மடல்சேர் வாழ்க்கை","அன்றிலும் பையென நரலும் இன்றவர்","வருவர்கொல் வாழி தோழி நாந்தப்","புலப்பினும் பிரிவாங் கஞ்சித்","தணப்பருங் காமம் தண்டி யோரே"],"tr":["kaṭalpā ṭavintu kāṉal mayaṅkit","tuṟainīr iruṅkaḻi pulleṉ ṟaṉṟē","maṉṟavam peṇṇai maṭalcēr vāḻkkai","aṉṟilum paiyeṉa naralum iṉṟavar","varuvarkol vāḻi tōḻi nāntap","pulappiṉum pirivāṅ kañcit","taṇapparuṅ kāmam taṇṭi yōrē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தோழி கூற்று","poet_ta":"உலோச்சனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Ulōccaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 12"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கடல்பா","tr":"kaṭalpā","foot":"puḷimā","acai":[{"kind":"nirai","text":"கடல்","tr":"kaṭal"},{"kind":"nēr","text":"பா","tr":"pā"}]},{"text":"டவிந்து","tr":"ṭavintu","foot":"puḷimā","acai":[{"kind":"nirai","text":"டவிந்","tr":"ṭavin"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"கானல்","tr":"kāṉal","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"னல்","tr":"ṉal"}]},{"text":"மயங்கித்","tr":"mayaṅkit","foot":"puḷimā","acai":[{"kind":"nirai","text":"மயங்","tr":"mayaṅ"},{"kind":"nēr","text":"கித்","tr":"kit"}]}],[{"text":"துறைநீர்","tr":"tuṟainīr","foot":"puḷimā","acai":[{"kind":"nirai","text":"துறை","tr":"tuṟai"},{"kind":"nēr","text":"நீர்","tr":"nīr"}]},{"text":"இருங்கழி","tr":"iruṅkaḻi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இருங்","tr":"iruṅ"},{"kind":"nirai","text":"கழி","tr":"kaḻi"}]},{"text":"புல்லென்","tr":"pulleṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"புல்","tr":"pul"},{"kind":"nēr","text":"லென்","tr":