{"text":"kuruntokai","n":400,"lines":["சேயாறு செல்வா மாயின் இடரின்று","களைகலம் காமம் பெருந்தோட் கென்று","நன்றுபுரிந் தெண்ணிய மனத்தை யாகி","முரம்புகண் உடைய வேகிக் கரம்பைப்","புதுவழிப் படுத்த மதியுடை வல்லோய்","இன்று தந்தனை தேரோ","நோயுழந் துறைவியை நல்க லானே"],"tr":["cēyāṟu celvā māyiṉ iṭariṉṟu","kaḷaikalam kāmam peruntōṭ keṉṟu","naṉṟupurin teṇṇiya maṉattai yāki","murampukaṇ uṭaiya vēkik karampaip","putuvaḻip paṭutta matiyuṭai vallōy","iṉṟu tantaṉai tērō","nōyuḻan tuṟaiviyai nalka lāṉē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவன் கூற்று","poet_ta":"பேயனார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Pēyaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 24, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 12, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"சேயாறு","tr":"cēyāṟu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"சே","tr":"cē"},{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"செல்வா","tr":"celvā","foot":"tēmā","acai":[{"kind":"nēr","text":"செல்","tr":"cel"},{"kind":"nēr","text":"வா","tr":"vā"}]},{"text":"மாயின்","tr":"māyiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"யின்","tr":"yiṉ"}]},{"text":"இடரின்று","tr":"iṭariṉṟu","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"இட","tr":"iṭa"},{"kind":"nēr","text":"ரின்","tr":"riṉ"},{"kind":"nēr","text":"று","tr":"ṟu"}]}],[{"text":"களைகலம்","tr":"kaḷaikalam","foot":"karuviḷam","acai":[{"kind":"nirai","text":"களை","tr":"kaḷai"},{"kind":"nirai","text":"கலம்","tr":"kalam"}]},{"text":"காமம்","tr":"kāmam","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"மம்","tr":"mam"}]},{"text":"பெருந்தோட்","tr":"peruntōṭ","foot":"puḷimā","acai":[{"kind":"nirai"