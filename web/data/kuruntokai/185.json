{"text":"kuruntokai","n":185,"lines":["நுதல்பசப் பிவர்ந்து திதலை வாடி","நெடுமென் பணைத்தோள் சாஅய்த் தொடி நெகிழ்ந்","தின்ன ளாகுத னும்மி னாகுமெனச்","சொல்லி னெவனாந் தோழி பல்வரிப்","பாம்புபை அவிழ்ந்தது போலக் கூம்பிக்","கொண்டலிற் றொலைந்த வொண்செங் காந்தள்","கன்மிசைக் கவியு நாடற்கென்","நன்மா மேனி யழிபடர் நிலையே"],"tr":["nutalpacap pivarntu titalai vāṭi","neṭumeṉ paṇaittōḷ cāayt toṭi nekiḻn","tiṉṉa ḷākuta ṉummi ṉākumeṉac","colli ṉevaṉān tōḻi palvarip","pāmpupai aviḻntatu pōlak kūmpik","koṇṭaliṟ ṟolainta voṇceṅ kāntaḷ","kaṉmicaik kaviyu nāṭaṟkeṉ","naṉmā mēṉi yaḻipaṭar nilaiyē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"மதுரை அறுவை வாணிகன் இளவேட்டனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Maturai Aṟuvai Vāṇikaṉ Iḷavēṭṭaṉār"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"1×5, 6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28, other 2, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 11, ? 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"1 five-foot line (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"நுதல்பசப்","tr":"nutalpacap","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நுதல்","tr":"nutal"},{"kind":"nirai","text":"பசப்","tr":"pacap"}]},{"text":"பிவர்ந்து","tr":"pivarntu","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிவர்ந்","tr":"pivarn"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"திதலை","tr":"titalai","foot":"puḷimā","acai":[{"kind":"nirai","text":"தித","tr":"tita"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"வாடி","tr":"vāṭi","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"டி","tr":"ṭi"}]}],[{"text":"நெடுமென்","tr":"neṭumeṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெடு","tr":"neṭu"},{"kind":"nēr","text":"மென்","tr":"meṉ"}]},{"text":"பணைத்தோள்","tr":"paṇaittōḷ","foot":"puḷimā","