{"text":"kuruntokai","n":101,"lines":["விரிதிரைப் பெருங்கடல் வளைஇய உலகமும்","அரிதுபெறு சிறப்பிற் புத்தேள் நாடும்","இரண்டும் தூக்கிற் சீர்சா லாவே","பூப்போல் உண்கண் பொன்போல் மேனி","மாண்வரி அல்குற் குறுமகள்","தோள்மாறு படூஉம் வைகலோ டெமக்கே"],"tr":["viritiraip peruṅkaṭal vaḷaiiya ulakamum","aritupeṟu ciṟappiṟ puttēḷ nāṭum","iraṇṭum tūkkiṟ cīrcā lāvē","pūppōl uṇkaṇ poṉpōl mēṉi","māṇvari alkuṟ kuṟumakaḷ","tōḷmāṟu paṭūum vaikalō ṭemakkē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"பரூஉ மோவாய்ப் பதுமனார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Parūu Mōvāyp Patumaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 4, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"விரிதிரைப்","tr":"viritiraip","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விரி","tr":"viri"},{"kind":"nirai","text":"திரைப்","tr":"tiraip"}]},{"text":"பெருங்கடல்","tr":"peruṅkaṭal","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெருங்","tr":"peruṅ"},{"kind":"nirai","text":"கடல்","tr":"kaṭal"}]},{"text":"வளைஇய","tr":"vaḷaiiya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வளை","tr":"vaḷai"},{"kind":"nirai","text":"இய","tr":"iya"}]},{"text":"உலகமும்","tr":"ulakamum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"உல","tr":"ula"},{"kind":"nirai","text":"கமும்","tr":"kamum"}]}],[{"text":"அரிதுபெறு","tr":"aritupeṟu","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"அரி","tr":"ari"},{"kind":"nirai","text":"துபெ","tr":"tupe"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"சிறப்பிற்","tr":"ciṟappiṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிறப்","tr":"ciṟap"},{"kind":"nēr","text":"பிற்","tr":"piṟ"}]},{"text":"புத்தேள்","tr":"puttēḷ","foot":"tēmā","