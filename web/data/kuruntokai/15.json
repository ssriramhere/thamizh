{"text":"kuruntokai","n":15,"lines":["பறைபடப் பணிலம் ஆர்ப்ப இறைகொள்பு","தொன்மூ தாலத்துப் பொதியிற் றோன்றிய","நாலூர்க் கோசர் நன்மொழி போல","வாயா கின்றே தோழி ஆய்கழற்","சேயிலை வெள்வேல் விடலையொடு","தொகுவளை முன்கை மடந்தை நட்பே"],"tr":["paṟaipaṭap paṇilam ārppa iṟaikoḷpu","toṉmū tālattup potiyiṟ ṟōṉṟiya","nālūrk kōcar naṉmoḻi pōla","vāyā kiṉṟē tōḻi āykaḻaṟ","cēyilai veḷvēl viṭalaiyoṭu","tokuvaḷai muṉkai maṭantai naṭpē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"செவிலி கூற்று","poet_ta":"ஔவையார்","speaker_en":"the foster-mother (cevili)","poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 20, veṇcīr 2, vañcicīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 9, kalittaḷai 1, oṉṟiya vañcittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பறைபடப்","tr":"paṟaipaṭap","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பறை","tr":"paṟai"},{"kind":"nirai","text":"படப்","tr":"paṭap"}]},{"text":"பணிலம்","tr":"paṇilam","foot":"puḷimā","acai":[{"kind":"nirai","text":"பணி","tr":"paṇi"},{"kind":"nēr","text":"லம்","tr":"lam"}]},{"text":"ஆர்ப்ப","tr":"ārppa","foot":"tēmā","acai":[{"kind":"nēr","text":"ஆர்ப்","tr":"ārp"},{"kind":"nēr","text":"ப","tr":"pa"}]},{"text":"இறைகொள்பு","tr":"iṟaikoḷpu","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"இறை","tr":"iṟai"},{"kind":"nēr","text":"கொள்","tr":"koḷ"},{"kind":"nēr","text":"பு","tr":"pu"}]}],[{"text":"தொன்மூ","tr":"toṉmū","foot":"tēmā","acai":[{"kind":"nēr","text":"தொன்","tr":"toṉ"},{"kind":"nēr","text":"மூ","tr":"mū"}]},{"text":"தாலத்துப்","tr":"tālattup","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"லத்","tr":"lat"},{"kind":"nēr","text":"துப்","tr":"tup"}]},{"text":"பொதியிற்","tr":"potiyiṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பொதி"