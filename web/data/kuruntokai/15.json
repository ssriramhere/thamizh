tr":"kai"}]},{"text":"மடந்தை","tr":"maṭantai","foot":"puḷimā","acai":[{"kind":"nirai","text":"மடந்","tr":"maṭan"},{"kind":"nēr","text":"தை","tr":"tai"}]},{"text":"நட்பே","tr":"naṭpē","foot":"tēmā","acai":[{"kind":"nēr","text":"நட்","tr":"naṭ"},{"kind":"nēr","text":"பே","tr":"pē"}]}]]},"ai":{"lines":[{"words":[{"surface":"பறை","parts":[{"text":"பறை","lemma":"பறை","gloss":"drum"}],"gloss":"drum"},{"surface":"பட","parts":[{"text":"பட","lemma":"படு","gloss":"to sound"}],"gloss":"to sound"},{"surface":"பணிலம்","parts":[{"text":"பணிலம்","lemma":"பணிலம்","gloss":"conch"}],"gloss":"conch"},{"surface":"ஆர்ப்ப","parts":[{"text":"ஆர்ப்ப","lemma":"ஆர்ப்ப","gloss":"to roar"}],"gloss":"to roar"},{"surface":"இறை","parts":[{"text":"இறை","lemma":"இறை","gloss":"resting"}],"gloss":"resting"},{"surface":"கொள்பு","parts":[{"text":"கொள்பு","lemma":"கொள்","gloss":"having taken"}],"gloss":"having taken"}]},{"words":[{"surface":"தொன்மூ","parts":[{"text":"தொன்மூ","lemma":"தொன்மூ","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தாலத்துப்","parts":[{"text":"தாலத்துப்","lemma":"தாலத்துப்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"பொதியிற்","parts":[{"text":"பொதியிற்","lemma":"பொதியிற்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"றோன்றிய","parts":[{"text":"றோன்றிய","lemma":"றோன்றிய","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"நாலூர்க்","parts":[{"text":"நாலூர்க்","lemma":"நாலூர்க்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"கோசர்","parts":[{"text":"கோசர்","lemma":"கோசர்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"நன்மொழி","parts":[{"text":"நன்மொழி","lemma":"நன்மொழி","gloss":""}],"gloss":"","split_unverified":true},{"surface":"போல","parts":[{"text":"போல","lemma":"போல","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"வாய்","parts":[{"text":"வாய்","lemma":"வாய்","gloss":"truth"}],"gloss":"truth"},{"surface":"ஆகின்றே","parts":[{"text":"ஆகின்றே","lemma":"ஆகு","gloss":"it has become"}],"gloss":"it has become"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"தோழி","gloss":"friend"}],"gloss":"O friend"},{"surface":"ஆய்","parts":[{"text":"ஆய்","lemma":"ஆய்","gloss":"select"}],"gloss":"select"},{"surface":"கழல்","parts":[{"text":"கழல்","lemma":"கழல்","gloss":"anklet"}],"gloss":"anklet"}]},{"words":[{"surface":"சே","parts":[{"text":"சே","lemma":"சே","gloss":"red"}],"gloss":"red"},{"surface":"இலை","parts":[{"text":"இலை","lemma":"இலை","gloss":"blade"}],"gloss":"blade"},{"surface":"வெள்","parts":[{"text":"வெள்","lemma":"வெள்","gloss":"bright"}],"gloss":"bright"},{"surface":"வேல்","parts":[{"text":"வேல்","lemma":"வேல்","gloss":"spear"}],"gloss":"spear"},{"surface":"விடலையொடு","parts":[{"text":"விடலை","lemma":"விடலை","gloss":"young hero"},{"text":"ஒடு","lemma":"ஒடு","gloss":"with"}],"gloss":"with the young hero"}]},{"words":[{"surface":"தொகு","parts":[{"text":"தொகு","lemma":"தொகு","gloss":"to gather"}],"gloss":"gathered"},{"surface":"வளை","parts":[{"text":"வளை","lemma":"வளை","gloss":"bangle"}],"gloss":"bangles"},{"surface":"முன்கை","parts":[{"text":"முன்","lemma":"முன்","gloss":"fore"},{"text":"கை","lemma":"கை","gloss":"arm"}],"gloss":"forearm"},{"surface":"மடந்தை","parts":[{"text":"மடந்தை","lemma":"மடந்தை","gloss":"young woman"}],"gloss":"young woman"},{"surface":"நட்பே","parts":[{"text":"நட்பு","lemma":"நட்பு","gloss":"union"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"union indeed"}]}],"literal":"As drums sound and conches roar, taking rest / in the assembly place of the ancient, old banyan tree, / like the truthful words of the Kōcar of Nālūr, / it has become true, O friend! With the select-anklet-wearing, / red-bladed, bright-speared young hero, / the union of the young woman with gathered bangles on her forearm.","translation":"O friend! Like the truthful words of the Kōcar of Nālūr, who appear at the assembly place under the ancient, old banyan tree where drums sound and conches roar as they take rest, the union of this young woman—whose forearms are adorned with gathered bangles—with the young hero who wears select anklets and carries a bright spear with a red blade, has indeed become a reality.","modern":"தோழியே! பறைகள் ஒலிக்க, சங்குகள் முழங்க, பறவைகள் தங்கி ஓய்வெடுக்கும் பழமையான பெரிய ஆலமரத்தின் பொதுமன்றத்தில் கூடிய நாலூர் கோசர்களின் வாய்மை தவறாத சொற்களைப் போல, அழகிய வீரக்கழலையும், சிவந்த இலையடி போன்ற கூர்மையான பிரகாசமான வேலையும் ஏந்திய காளையோடு, திரண்ட வளையல்களை அணிந்த முன்கையையுடைய இப்பெண்ணின் நட்பு உண்மையாகிவிட்டது.","explanation":"This poem is spoken by the foster-mother to the heroine's companion after the heroine has eloped with her lover. She expresses her relief and acceptance, noting that the couple's union has now become an undeniable, solemnized reality. She compares the truth of their marriage to the infallible, truthful words of the Kōcar clan, who gather for assembly under the ancient banyan tree of Nālūr. The imagery of the banyan tree, where birds rest amidst the sounding of drums and conches, evokes a sense of public witness and sacred authority. By comparing the elopement to this respected assembly's word, the foster-mother acknowledges that the relationship is now legitimate and permanent.","model":"gemini-3.5-flash"}}