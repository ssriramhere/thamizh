{"text":"kuruntokai","n":12,"lines":["எறும்பி யளையிற் குறும்பல் சுனைய","உலைக்கல் அன்ன பாறை ஏறிக்","கொடுவில் எயினர் பகழி மாய்க்கும்","கவலைத் தென்பவர் தேர் சென்ற ஆறே","அதுமற் றவலங் கொள்ளாது","நொதுமற் கழறுமிவ் வழுங்க லூரே"],"tr":["eṟumpi yaḷaiyiṟ kuṟumpal cuṉaiya","ulaikkal aṉṉa pāṟai ēṟik","koṭuvil eyiṉar pakaḻi māykkum","kavalait teṉpavar tēr ceṉṟa āṟē","atumaṟ ṟavalaṅ koḷḷātu","notumaṟ kaḻaṟumiv vaḻuṅka lūrē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"ஓதலாந்தையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Ōtalāntaiyār"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"1×5, 4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, other 1, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 12, āciriyattaḷai 9, ? 1, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"1 five-foot line (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"எறும்பி","tr":"eṟumpi","foot":"puḷimā","acai":[{"kind":"nirai","text":"எறும்","tr":"eṟum"},{"kind":"nēr","text":"பி","tr":"pi"}]},{"text":"யளையிற்","tr":"yaḷaiyiṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"யளை","tr":"yaḷai"},{"kind":"nēr","text":"யிற்","tr":"yiṟ"}]},{"text":"குறும்பல்","tr":"kuṟumpal","foot":"puḷimā","acai":[{"kind":"nirai","text":"குறும்","tr":"kuṟum"},{"kind":"nēr","text":"பல்","tr":"pal"}]},{"text":"சுனைய","tr":"cuṉaiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"சுனை","tr":"cuṉai"},{"kind":"nēr","text":"ய","tr":"ya"}]}],[{"text":"உலைக்கல்","tr":"ulaikkal","foot":"puḷimā","acai":[{"kind":"nirai","text":"உலைக்","tr":"ulaik"},{"kind":"nēr","text":"கல்","tr":"kal"}]},{"text":"அன்ன","tr":"aṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"அன்","tr":"aṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"பாறை","tr":"pāṟai","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"றை","tr":"ṟa