{"text":"kuruntokai","n":338,"lines":["திரிமருப் பிரலை யண்ணல் நல்லேறு","அரிமடப் பிணையோ டல்குநிழ லசைஇ","வீததை வியலரில் துஞ்சிப் பொழுதுசெலச்","செழும்பயறு கறிக்கும் புன்கண் மாலைப்","பின்பனிக் கடைநாள் தண்பனி அச்சிரம்","வந்தன்று பெருவிறல் தேரே பணைத்தோள்","விளங்குநக ரடங்கிய கற்பின்","நலங்கே ழரிவை புலம்பசா விடவே"],"tr":["tirimarup piralai yaṇṇal nallēṟu","arimaṭap piṇaiyō ṭalkuniḻa lacaii","vītatai viyalaril tuñcip poḻutucelac","ceḻumpayaṟu kaṟikkum puṉkaṇ mālaip","piṉpaṉik kaṭaināḷ taṇpaṉi acciram","vantaṉṟu peruviṟal tērē paṇaittōḷ","viḷaṅkunaka raṭaṅkiya kaṟpiṉ","nalaṅkē ḻarivai pulampacā viṭavē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"பெருங்குன்றூர்கிழார்","speaker_en":"her friend (tōḻi)","poet_tr":"Peruṅkuṉṟūrkiḻār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 6"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 11, kalittaḷai 6"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"திரிமருப்","tr":"tirimarup","foot":"karuviḷam","acai":[{"kind":"nirai","text":"திரி","tr":"tiri"},{"kind":"nirai","text":"மருப்","tr":"marup"}]},{"text":"பிரலை","tr":"piralai","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிர","tr":"pira"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"யண்ணல்","tr":"yaṇṇal","foot":"tēmā","acai":[{"kind":"nēr","text":"யண்","tr":"yaṇ"},{"kind":"nēr","text":"ணல்","tr":"ṇal"}]},{"text":"நல்லேறு","tr":"nallēṟu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"நல்","tr":"nal"},{"kind":"nēr","text":"லே","tr":"lē"},{"kind":"nēr","text":"று","tr":"ṟu"}]}],[{"text":"அரிமடப்","tr":"arimaṭap","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அரி","tr":"ari"},{"kind":"nirai","text":"மடப்","tr":"maṭap"}]},{"text":"பிணையோ","tr":"piṇaiyō","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிணை","tr":"piṇai"