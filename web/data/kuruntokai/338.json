twisted horn"},{"surface":"இரலை","parts":[{"text":"இரலை","lemma":"இரலை","gloss":"stag"}],"gloss":"stag"},{"surface":"அண்ணல்","parts":[{"text":"அண்ணல்","lemma":"அண்ணல்","gloss":"majestic one"}],"gloss":"majestic"},{"surface":"நல்லேறு","parts":[{"text":"நல்","lemma":"நல்","gloss":"good"},{"text":"ஏறு","lemma":"ஏறு","gloss":"male animal"}],"gloss":"fine male animal"}]},{"words":[{"surface":"அரிமட","parts":[{"text":"அரி","lemma":"அரி","gloss":"beautiful"},{"text":"மட","lemma":"மடம்","gloss":"innocent"}],"gloss":"beautiful and innocent"},{"surface":"பிணையோடு","parts":[{"text":"பிணை","lemma":"பிணை","gloss":"doe"},{"text":"ஓடு","lemma":"ஓடு","gloss":"with"}],"gloss":"with the doe"},{"surface":"அல்குநிழல்","parts":[{"text":"அல்கு","lemma":"அல்கு","gloss":"abiding"},{"text":"நிழல்","lemma":"நிழல்","gloss":"shade"}],"gloss":"abiding shade"},{"surface":"அசைஇ","parts":[{"text":"அசைஇ","lemma":"அசை","gloss":"having rested"}],"gloss":"having rested"}]},{"words":[{"surface":"வீததை","parts":[{"text":"வீ","lemma":"வீ","gloss":"flower"},{"text":"ததை","lemma":"ததை","gloss":"dense"}],"gloss":"dense with flowers"},{"surface":"வியலரில்","parts":[{"text":"வியல்","lemma":"வியல்","gloss":"wide"},{"text":"அரில்","lemma":"அரில்","gloss":"thicket"}],"gloss":"wide thicket"},{"surface":"துஞ்சி","parts":[{"text":"துஞ்சி","lemma":"துஞ்சு","gloss":"having slept"}],"gloss":"having slept"},{"surface":"பொழுதுசெல","parts":[{"text":"பொழுது","lemma":"பொழுது","gloss":"time"},{"text":"செல","lemma":"செல்","gloss":"to pass"}],"gloss":"as time passes"}]},{"words":[{"surface":"செழும்பயறு","parts":[{"text":"செழும்","lemma":"செழுமை","gloss":"rich"},{"text":"பயறு","lemma":"பயறு","gloss":"beans"}],"gloss":"rich beans"},{"surface":"கறிக்கும்","parts":[{"text":"கறிக்கும்","lemma":"கறி","gloss":"chewing"}],"gloss":"chewing"},{"surface":"புன்கண்","parts":[{"text":"புன்கண்","lemma":"புன்கண்","gloss":"sorrowful"}],"gloss":"sorrowful"},{"surface":"மாலை","parts":[{"text":"மாலை","lemma":"மாலை","gloss":"evening"}],"gloss":"evening"}]},{"words":[{"surface":"பின்பனி","parts":[{"text":"பின்பனி","lemma":"பின்பனி","gloss":"late dewy season"}],"gloss":"late dewy season"},{"surface":"கடைநாள்","parts":[{"text":"கடை","lemma":"கடை","gloss":"end"},{"text":"நாள்","lemma":"நாள்","gloss":"days"}],"gloss":"final days"},{"surface":"தண்பனி","parts":[{"text":"தண்","lemma":"தண்மை","gloss":"cool"},{"text":"பனி","lemma":"பனி","gloss":"dew"}],"gloss":"cool dew"},{"surface":"அச்சிரம்","parts":[{"text":"அச்சிரம்","lemma":"அச்சிரம்","gloss":"dewy season"}],"gloss":"dewy season"}]},{"words":[{"surface":"வந்தன்று","parts":[{"text":"வந்தன்று","lemma":"வா","gloss":"has arrived"}],"gloss":"has arrived"},{"surface":"பெருவிறல்","parts":[{"text":"பெரு","lemma":"பெருமை","gloss":"great"},{"text":"விறல்","lemma":"விறல்","gloss":"victory"}],"gloss":"great victory"},{"surface":"தேரே","parts":[{"text":"தேர்","lemma":"தேர்","gloss":"chariot"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"the chariot indeed"},{"surface":"பணைத்தோள்","parts":[{"text":"பணை","lemma":"பணை","gloss":"bamboo"},{"text":"தோள்","lemma":"தோள்","gloss":"shoulders"}],"gloss":"bamboo-like shoulders"}]},{"words":[{"surface":"விளங்குநகர்","parts":[{"text":"விளங்கு","lemma":"விளங்கு","gloss":"shining"},{"text":"நகர்","lemma":"நகர்","gloss":"house"}],"gloss":"bright house"},{"surface":"அடங்கிய","parts":[{"text":"அடங்கிய","lemma":"அடங்கு","gloss":"who stayed within"}],"gloss":"who stayed within"},{"surface":"கற்பின்","parts":[{"text":"கற்பின்","lemma":"கற்பு","gloss":"chastity"}],"gloss":"of chastity"}]},{"words":[{"surface":"நலங்கேழ்","parts":[{"text":"நலம்","lemma":"நலம்","gloss":"beauty"},{"text":"கேழ்","lemma":"கேழ்","gloss":"color"}],"gloss":"beautifully-hued"},{"surface":"அரிவை","parts":[{"text":"அரிவை","lemma":"அரிவை","gloss":"young woman"}],"gloss":"young woman"},{"surface":"புலம்பசா","parts":[{"text":"புலம்பு","lemma":"புலம்பு","gloss":"loneliness"},{"text":"அசா","lemma":"அசா","gloss":"distress"}],"gloss":"loneliness and distress"},{"surface":"விடவே","parts":[{"text":"விட","lemma":"விடு","gloss":"to leave"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"to be dispelled"}]}],"literal":"The majestic fine male stag with twisted horns, / resting in the abiding shade with his beautiful, innocent doe, / sleeping in the wide thicket dense with fallen flowers, as time passes / grazes on rich beans in the sorrowful evening. / In the late dewy season's final days, during the cold dewy winter, / has arrived the chariot of great victory, so that / for the one with bamboo-like shoulders, who stayed within the bright house with chastity, / the beautifully-hued young woman, her loneliness and distress may be dispelled.","translation":"The majestic stag with twisted horns rests in the lingering shade with his gentle, innocent doe. Sleeping in the wide, flower-strewn thicket as the day fades, he grazes on rich beans in the sorrowful evening. In these final days of the late dewy season, amidst the cold winter chill, the chariot of great victory has arrived! Now, the loneliness and deep distress of the beautiful young woman with bamboo-like shoulders, who waited patiently and chaste within her bright home, will be completely dispelled.","modern":"முறுக்கிய கொம்புகளையுடைய பெருமைமிக்க ஆண் மான், அழகிய இளமையான பெண் மானோடு தங்கும் நிழலில் இளைப்பாறி, பூக்கள் நிறைந்த அகன்ற தூறுகளில் தூங்கி, பொழுது போகுமாறு செழுமையான பயறுகளை மேய்கின்ற துன்பம் தரும் மாலைப் பொழுதில், பின்பனிக் காலத்தின் இறுதி நாட்களில், குளிர்ந்த பனி பெய்யும் முன்பனிக் காலத்தில், பெரிய வெற்றியையுடைய தலைவனின் தேர் வந்துவிட்டது. மூங்கில் போன்ற தோள்களையும், விளங்கும் இல்லத்தில் அடங்கிய கற்பினையும் உடைய, அழகு பொருந்திய தலைவியின் தனிமையும் வருத்தமும் நீங்குமாறு அது வந்துள்ளது.","explanation":"This poem is spoken by the heroine's friend to the heroine upon the return of the hero. The hero had gone away on a quest, leaving the heroine to wait anxiously through the cold winter months. The friend joyfully announces that the hero's victorious chariot has finally arrived in the cold, dewy evening of the late winter season. The image of the majestic stag resting peacefully with his innocent doe in the shade and grazing on beans mirrors the domestic union and comfort that the heroine is about to regain. This contrast between the cold, lonely evening and the warmth of the returning chariot highlights the theme of separation coming to an end. Key words like 'vantaṉṟu tērē' (the chariot has arrived) and 'pulampacā viṭavē' (to dispel loneliness and distress) emphasize the relief and joy of their reunion.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.54],[0.54,0.8],[0.88,1.3],[1.3,1.7],[1.7,2.02],[2.02,2.5],[2.5,3.3],[3.3,3.6],[3.6,4.03],[4.03,4.66],[5.09,5.57],[5.57,6.55],[6.7,6.85],[6.85,7.43],[7.43,7.9],[7.9,8.7],[8.7,9.42],[9.42,9.99],[9.99,10.57],[10.57,11.28],[11.28,12.0],[12.0,12.3],[12.3,12.8],[12.8,13.4],[13.4,14.1],[14.1,14.8],[14.8,15.2],[15.3,15.7],[15.7,16.19],[16.19,17.0],[17.0,17.4]],"female":[[0.0,0.57],[0.57,0.9],[0.98,1.4],[1.4,1.89],[2.13,2.25],[2.25,2.61],[2.74,3.58],[3.58,4.0],[4.0,4.31],[4.93,5.4],[5.4,5.58],[5.58,7.0],[7.0,8.23],[8.23,8.7],[8.7,9.2],[9.2,9.7],[9.7,10.3],[10.3,10.54],[10.54,11.28],[11.28,12.2],[12.2,13.4],[13.4,13.6],[13.6,14.2],[14.2,14.8],[14.8,15.8],[15.8,16.4],[16.4,16.9],[17.01,17.47],[17.9,18.1],[18.4,18.9],[18.9,19.4]]},"sync":[[["திரிமருப்பு","twisted horn"]],[["திரிமருப்பு","twisted horn"],["இரலை","stag"]],[["அண்ணல்","majestic"]],[["நல்லேறு","fine male animal"]],[["அரிமட","beautiful and innocent"]],[["பிணையோடு","with the doe"]],[["பிணையோடு","with the doe"],["அல்குநிழல்","abiding shade"]],[["அல்குநிழல்","abiding shade"],["அசைஇ","having rested"]],[["வீததை","dense with flowers"]],[["வியலரில்","wide thicket"]],[["துஞ்சி","having slept"],["பொழுதுசெல","as time passes"]],[["பொழுதுசெல","as time passes"]],[["செழும்பயறு","rich beans"]],[["கறிக்கும்","chewing"]],[["புன்கண்","sorrowful"]],[["மாலை","evening"]],[["பின்பனி","late dewy season"]],[["கடைநாள்","final days"]],[["தண்பனி","cool dew"]],[["அச்சிரம்","dewy season"]],[["வந்தன்று","has arrived"]],[["பெருவிறல்","great victory"]],[["தேரே","the chariot indeed"]],[["பணைத்தோள்","bamboo-like shoulders"]],[["விளங்குநகர்","bright house"]],[["விளங்குநகர்","bright house"],["அடங்கிய","who stayed within"]],[["கற்பின்","of chastity"]],[["நலங்கேழ்","beautifully-hued"]],[["நலங்கேழ்","beautifully-hued"],["அரிவை","young woman"]],[["புலம்பசா","loneliness and distress"]],[["விடவே","to be dispelled"]]]}