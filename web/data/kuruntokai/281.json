{"text":"kuruntokai","n":281,"lines":["வெண்மணற் பொதுளிய பைங்காற் கருக்கின்","கொம்மைப் போந்தைக் குடுமி வெண்தோட்","டத்த வேம்பி னமலை வான்பூச்","சுரியா ருளைத்தலை பொலியச் சூடிக்","குன்றுதலை மணந்த கானம்","சென்றனர் கொல்லோ சேயிழை நமரே"],"tr":["veṇmaṇaṟ potuḷiya paiṅkāṟ karukkiṉ","kommaip pōntaik kuṭumi veṇtōṭ","ṭatta vēmpi ṉamalai vāṉpūc","curiyā ruḷaittalai poliyac cūṭik","kuṉṟutalai maṇanta kāṉam","ceṉṟaṉar kollō cēyiḻai namarē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"குடவாயிற் கீரத்தனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kuṭavāyiṟ Kīrattaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 7, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வெண்மணற்","tr":"veṇmaṇaṟ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வெண்","tr":"veṇ"},{"kind":"nirai","text":"மணற்","tr":"maṇaṟ"}]},{"text":"பொதுளிய","tr":"potuḷiya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பொது","tr":"potu"},{"kind":"nirai","text":"ளிய","tr":"ḷiya"}]},{"text":"பைங்காற்","tr":"paiṅkāṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"பைங்","tr":"paiṅ"},{"kind":"nēr","text":"காற்","tr":"kāṟ"}]},{"text":"கருக்கின்","tr":"karukkiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கருக்","tr":"karuk"},{"kind":"nēr","text":"கின்","tr":"kiṉ"}]}],[{"text":"கொம்மைப்","tr":"kommaip","foot":"tēmā","acai":[{"kind":"nēr","text":"கொம்","tr":"kom"},{"kind":"nēr","text":"மைப்","tr":"maip"}]},{"text":"போந்தைக்","tr":"pōntaik","foot":"tēmā","acai":[{"kind":"nēr","text":"போந்","tr":"pōn"},{"kind":"nēr","text":"தைக்","tr":"taik"}]},{"text":"குடுமி","tr":"kuṭumi","foot":"puḷimā","acai":[{"kind":"nirai","text":"குடு","tr":"kuṭu"},{"kind":"nēr","text":"மி","tr":"mi"}]},{"text":"வெண்த