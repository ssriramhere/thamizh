{"text":"kuruntokai","n":120,"lines":["இல்லோன் இன்பங் காமுற் றாஅங்கு","அரிதுவேட் டனையால் நெஞ்சே காதலி","நல்லள் ஆகுதல் அறிந்தாங்கு","அரியள் ஆகுதல் அறியா தோயே"],"tr":["illōṉ iṉpaṅ kāmuṟ ṟāaṅku","arituvēṭ ṭaṉaiyāl neñcē kātali","nallaḷ ākutal aṟintāṅku","ariyaḷ ākutal aṟiyā tōyē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"பரணர்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Paraṇar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 13, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, kalittaḷai 2, veṇṭaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இல்லோன்","tr":"illōṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"இல்","tr":"il"},{"kind":"nēr","text":"லோன்","tr":"lōṉ"}]},{"text":"இன்பங்","tr":"iṉpaṅ","foot":"tēmā","acai":[{"kind":"nēr","text":"இன்","tr":"iṉ"},{"kind":"nēr","text":"பங்","tr":"paṅ"}]},{"text":"காமுற்","tr":"kāmuṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"முற்","tr":"muṟ"}]},{"text":"றாஅங்கு","tr":"ṟāaṅku","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"றா","tr":"ṟā"},{"kind":"nēr","text":"அங்","tr":"aṅ"},{"kind":"nēr","text":"கு","tr":"ku"}]}],[{"text":"அரிதுவேட்","tr":"arituvēṭ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அரி","tr":"ari"},{"kind":"nirai","text":"துவேட்","tr":"tuvēṭ"}]},{"text":"டனையால்","tr":"ṭaṉaiyāl","foot":"puḷimā","acai":[{"kind":"nirai","text":"டனை","tr":"ṭaṉai"},{"kind":"nēr","text":"யால்","tr":"yāl"}]},{"text":"நெஞ்சே","tr":"neñcē","foot":"tēmā","acai":[{"kind":"nēr","text":"நெஞ்","tr":"neñ"},{"kind":"nēr","text":"சே","tr":"cē"}]},{"text":"காதலி","tr":"kātali","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"தலி","tr":"tali"}]}],[{"text":"நல்லள்","tr":"nallaḷ","foot":"tēmā","acai