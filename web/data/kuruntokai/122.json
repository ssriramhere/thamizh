{"text":"kuruntokai","n":122,"lines":["பைங்காற் கொக்கின் புன்புறத் தன்ன","குண்டுநீர் ஆம்பலும் கூம்பின இனியே","வந்தன்று வாழியோ மாலை","ஒருதான் அன்றே கங்குலும் உடைத்தே"],"tr":["paiṅkāṟ kokkiṉ puṉpuṟat taṉṉa","kuṇṭunīr āmpalum kūmpiṉa iṉiyē","vantaṉṟu vāḻiyō mālai","orutāṉ aṉṟē kaṅkulum uṭaittē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"ஓரம் போகியார்","speaker_en":"the heroine (talaivi)","poet_tr":"Ōram Pōkiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 14, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 8, veṇṭaḷai 6"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பைங்காற்","tr":"paiṅkāṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"பைங்","tr":"paiṅ"},{"kind":"nēr","text":"காற்","tr":"kāṟ"}]},{"text":"கொக்கின்","tr":"kokkiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"கொக்","tr":"kok"},{"kind":"nēr","text":"கின்","tr":"kiṉ"}]},{"text":"புன்புறத்","tr":"puṉpuṟat","foot":"kūviḷam","acai":[{"kind":"nēr","text":"புன்","tr":"puṉ"},{"kind":"nirai","text":"புறத்","tr":"puṟat"}]},{"text":"தன்ன","tr":"taṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"தன்","tr":"taṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]}],[{"text":"குண்டுநீர்","tr":"kuṇṭunīr","foot":"kūviḷam","acai":[{"kind":"nēr","text":"குண்","tr":"kuṇ"},{"kind":"nirai","text":"டுநீர்","tr":"ṭunīr"}]},{"text":"ஆம்பலும்","tr":"āmpalum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஆம்","tr":"ām"},{"kind":"nirai","text":"பலும்","tr":"palum"}]},{"text":"கூம்பின","tr":"kūmpiṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கூம்","tr":"kūm"},{"kind":"nirai","text":"பின","tr":"piṉa"}]},{"text":"இனியே","tr":"iṉiyē","foot":"puḷimā","acai":[{"kind":"nirai","text":"இனி","tr":"iṉi"},{"kind":"nēr","text":"யே","tr":"yē"}]}],[{"text":"வந்தன்று","tr":"vantaṉṟu","foot":"tēmā