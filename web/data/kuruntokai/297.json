{"text":"kuruntokai","n":297,"lines":["அவ்விளிம் புரீஇய கொடுஞ்சிலை மறவர்","வைவார் வாளி விறற்பகை பேணார்","மாறுநின் றிறந்த ஆறுசெல் வம்பலர்","உவலிடு பதுக்கை ஊரின் தோன்றும்","கல்லுயர் நனந்தலை நல்ல கூறிப்","புணர்ந்துடன் போதல் பொருளென","உணர்ந்தேன் மன்றவவர் உணரா வூங்கே"],"tr":["avviḷim purīiya koṭuñcilai maṟavar","vaivār vāḷi viṟaṟpakai pēṇār","māṟuniṉ ṟiṟanta āṟucel vampalar","uvaliṭu patukkai ūriṉ tōṉṟum","kalluyar naṉantalai nalla kūṟip","puṇarntuṭaṉ pōtal poruḷeṉa","uṇarntēṉ maṉṟavavar uṇarā vūṅkē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"காவிரிப்பூம்பட்டினத்துக் காரிக்கண்ணனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kāvirippūmpaṭṭiṉattuk Kārikkaṇṇaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 7, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அவ்விளிம்","tr":"avviḷim","foot":"kūviḷam","acai":[{"kind":"nēr","text":"அவ்","tr":"av"},{"kind":"nirai","text":"விளிம்","tr":"viḷim"}]},{"text":"புரீஇய","tr":"purīiya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"புரீ","tr":"purī"},{"kind":"nirai","text":"இய","tr":"iya"}]},{"text":"கொடுஞ்சிலை","tr":"koṭuñcilai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கொடுஞ்","tr":"koṭuñ"},{"kind":"nirai","text":"சிலை","tr":"cilai"}]},{"text":"மறவர்","tr":"maṟavar","foot":"puḷimā","acai":[{"kind":"nirai","text":"மற","tr":"maṟa"},{"kind":"nēr","text":"வர்","tr":"var"}]}],[{"text":"வைவார்","tr":"vaivār","foot":"tēmā","acai":[{"kind":"nēr","text":"வை","tr":"vai"},{"kind":"nēr","text":"வார்","tr":"vār"}]},{"text":"வாளி","tr":"vāḷi","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ளி","tr":"ḷi"}]},{"text":"விறற்பகை","tr":"viṟaṟpakai","foot":"karuviḷam","