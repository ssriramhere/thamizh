"nēr","text":"ளே","tr":"ḷē"}]}]]},"ai":{"lines":[{"words":[{"surface":"மெய்யே","parts":[{"text":"மெய்","lemma":"mey","gloss":"truth"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"truly indeed"},{"surface":"வாழி","parts":[{"text":"வாழி","lemma":"vāḻi","gloss":"may you live"}],"gloss":"may you live"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"tōḻi","gloss":"friend"}],"gloss":"friend"},{"surface":"சாரல்","parts":[{"text":"சாரல்","lemma":"cāral","gloss":"mountain slope"}],"gloss":"mountain slope"}]},{"words":[{"surface":"மைபட்டன்ன","parts":[{"text":"மை","lemma":"mai","gloss":"blackness"},{"text":"பட்டு","lemma":"paṭu","gloss":"having applied"},{"text":"அன்ன","lemma":"aṉṉa","gloss":"like"}],"gloss":"like having applied blackness"},{"surface":"மாமுக","parts":[{"text":"மாமுக","lemma":"மாமுக","gloss":"dark-faced"}],"gloss":"dark-faced","split_unverified":true},{"surface":"முசுக்கலை","parts":[{"text":"முசு","lemma":"mucu","gloss":"langur monkey"},{"text":"கலை","lemma":"kalai","gloss":"male"}],"gloss":"male langur monkey"}]},{"words":[{"surface":"ஆற்ற","parts":[{"text":"ஆற்ற","lemma":"āṟṟa","gloss":"fully"}],"gloss":"fully"},{"surface":"பாயா","parts":[{"text":"பாயா","lemma":"pāyā","gloss":"not leaping"}],"gloss":"failing to leap"},{"surface":"தப்பல்","parts":[{"text":"தப்பல்","lemma":"tappal","gloss":"slip"}],"gloss":"slip"},{"surface":"ஏற்ற","parts":[{"text":"ஏற்ற","lemma":"ēl","gloss":"suffered"}],"gloss":"suffered"}]},{"words":[{"surface":"கோட்டொடு","parts":[{"text":"கோட்டொடு","lemma":"கோட்டொடு","gloss":"with the branch"}],"gloss":"with the branch","split_unverified":true},{"surface":"போகி","parts":[{"text":"போகி","lemma":"pō","gloss":"having gone"}],"gloss":"having fallen down"},{"surface":"யாங்கு","parts":[{"text":"யாங்கு","lemma":"yāṅku","gloss":"in that manner"}],"gloss":"just like that"},{"surface":"நாடன்","parts":[{"text":"நாடன்","lemma":"nāṭaṉ","gloss":"lord of the land"}],"gloss":"lord of the mountain land"}]},{"words":[{"surface":"தான்குறி","parts":[{"text":"தான்","lemma":"tāṉ","gloss":"he himself"},{"text":"குறி","lemma":"kuṟi","gloss":"tryst"}],"gloss":"his own tryst"},{"surface":"வாயா","parts":[{"text":"வாயா","lemma":"vāy","gloss":"not succeeding"}],"gloss":"failing to succeed"},{"surface":"தப்பற்குத்","parts":[{"text":"தப்பற்குத்","lemma":"தப்பற்குத்","gloss":"for the failure"}],"gloss":"for the failure","split_unverified":true}]},{"words":[{"surface":"தாம்பசந்தனஎன்","parts":[{"text":"தாம்","lemma":"tām","gloss":"themselves"},{"text":"பசந்தன","lemma":"paci","gloss":"became pale"},{"text":"என்","lemma":"eṉ","gloss":"my"}],"gloss":"themselves became pale, my"},{"surface":"தடமென்தோளே","parts":[{"text":"தடமென்தோளே","lemma":"தடமென்தோளே","gloss":"broad, soft shoulders indeed"}],"gloss":"broad, soft shoulders indeed","split_unverified":true}]}],"literal":"Truly indeed, may you live, friend! On the mountain slope, / like having applied blackness, the dark-faced male langur monkey, / suffering a slip from not leaping with enough strength, / just like falling down along with the branch, the lord of the land / for the failure of himself not succeeding in keeping the tryst, / my broad, soft shoulders themselves turned pale!","translation":"It is the absolute truth, my friend, may you live long! On the mountain slope, a dark-faced male langur monkey, looking as if smeared with black soot, fails to leap with enough strength, slips, and falls down along with the branch. Just like that, because the lord of the mountain land failed to keep his tryst, my broad, soft shoulders have turned pale with grief.","modern":"தோழியே, நீ வாழ்க! இது உண்மைதான். மலைச்சாரலில், மை பூசியது போன்ற கரிய முகத்தை உடைய ஆண் முசுக்குரங்கு, தன் முழு வலிமையோடு பாயாமல் தவறி, தான் பற்றியிருந்த கிளையோடு கீழே விழுவதைப் போல, நம் மலைநாடன் தான் குறித்த சந்திப்புக்கு வராமல் தவறியதற்காக, என்னுடைய பருத்த மென்மையான தோள்கள் தாமே பசலை நிறம் அடைந்துவிட்டன.","explanation":"The heroine is speaking to her close friend about her deep distress over the hero's absence. The hero has failed to keep his promise to meet her at their secret trysting place, causing her immense grief. This grief manifests physically as her broad, soft shoulders turn pale and lose their natural beauty. The poet Kapilar uses a vivid implied metaphor (ullurai) from the mountain landscape (Kuriñci tiṇai) to mirror this situation. The male langur monkey that fails to leap with enough strength and falls down along with the branch represents the hero, whose lack of sufficient effort to overcome obstacles leads to the downfall of the heroine's happiness and beauty.","model":"gemini-3.5-flash"}}