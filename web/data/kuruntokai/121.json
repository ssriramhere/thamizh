{"text":"kuruntokai","n":121,"lines":["மெய்யே வாழி தோழி சாரல்","மைபட் டன்ன மாமுக முசுக்கலை","ஆற்றப் பாயாத் தப்பல் ஏற்ற","கோட்டொடு போகி யாங்கு நாடன்","தான்குறி வாயாத் தப்பற்குத்","தாம்பசந் தனஎன் தடமென் தோளே"],"tr":["meyyē vāḻi tōḻi cāral","maipaṭ ṭaṉṉa māmuka mucukkalai","āṟṟap pāyāt tappal ēṟṟa","kōṭṭoṭu pōki yāṅku nāṭaṉ","tāṉkuṟi vāyāt tappaṟkut","tāmpacan taṉaeṉ taṭameṉ tōḷē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"கபிலர்","speaker_en":"the heroine (talaivi)","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 5"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மெய்யே","tr":"meyyē","foot":"tēmā","acai":[{"kind":"nēr","text":"மெய்","tr":"mey"},{"kind":"nēr","text":"யே","tr":"yē"}]},{"text":"வாழி","tr":"vāḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"சாரல்","tr":"cāral","foot":"tēmā","acai":[{"kind":"nēr","text":"சா","tr":"cā"},{"kind":"nēr","text":"ரல்","tr":"ral"}]}],[{"text":"மைபட்","tr":"maipaṭ","foot":"tēmā","acai":[{"kind":"nēr","text":"மை","tr":"mai"},{"kind":"nēr","text":"பட்","tr":"paṭ"}]},{"text":"டன்ன","tr":"ṭaṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"டன்","tr":"ṭaṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"மாமுக","tr":"māmuka","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"முக","tr":"muka"}]},{"text":"முசுக்கலை","tr":"mucukkalai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"முசுக்","tr":"mucuk"},{"kind":"nirai","text":"கலை","tr":"kalai"}]}],[{"text":"ஆற்றப்","tr":"āṟṟap