{"text":"kuruntokai","n":394,"lines":["முழந்தாள் இரும்பிடிக் கயந்தலைக் குழவி","நறவுமலி பாக்கத்துக் குறமகள் ஈன்ற","குறியிறைப் புதல்வரொடு மறுவந் தோடி","முன்னாள் இனிய தாகிப் பின்னாள்","அவர்தினைப் புனம் மேய்ந் தாங்குப்","பகையா கின்றவர் நகைவிளை யாட்டே"],"tr":["muḻantāḷ irumpiṭik kayantalaik kuḻavi","naṟavumali pākkattuk kuṟamakaḷ īṉṟa","kuṟiyiṟaip putalvaroṭu maṟuvan tōṭi","muṉṉāḷ iṉiya tākip piṉṉāḷ","avartiṉaip puṉam mēyn tāṅkup","pakaiyā kiṉṟavar nakaiviḷai yāṭṭē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"குறியிரையார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kuṟiyiraiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"6×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19, veṇcīr 3, other 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 9, kalittaḷai 2, ? 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"முழந்தாள்","tr":"muḻantāḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"முழந்","tr":"muḻan"},{"kind":"nēr","text":"தாள்","tr":"tāḷ"}]},{"text":"இரும்பிடிக்","tr":"irumpiṭik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இரும்","tr":"irum"},{"kind":"nirai","text":"பிடிக்","tr":"piṭik"}]},{"text":"கயந்தலைக்","tr":"kayantalaik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கயந்","tr":"kayan"},{"kind":"nirai","text":"தலைக்","tr":"talaik"}]},{"text":"குழவி","tr":"kuḻavi","foot":"puḷimā","acai":[{"kind":"nirai","text":"குழ","tr":"kuḻa"},{"kind":"nēr","text":"வி","tr":"vi"}]}],[{"text":"நறவுமலி","tr":"naṟavumali","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"நற","tr":"naṟa"},{"kind":"nirai","text":"வும","tr":"vuma"},{"kind":"nēr","text":"லி","tr":"li"}]},{"text":"பாக்கத்துக்","tr":"pākkattuk","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"பாக்","tr":"pāk"},{"kind":"nēr","text":"கத்","tr":"kat"},{"kind":"nēr","text":"துக்","tr":"tuk"}]}