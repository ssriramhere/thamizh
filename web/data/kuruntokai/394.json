ext":"பகை","tr":"pakai"},{"kind":"nēr","text":"யா","tr":"yā"}]},{"text":"கின்றவர்","tr":"kiṉṟavar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கின்","tr":"kiṉ"},{"kind":"nirai","text":"றவர்","tr":"ṟavar"}]},{"text":"நகைவிளை","tr":"nakaiviḷai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நகை","tr":"nakai"},{"kind":"nirai","text":"விளை","tr":"viḷai"}]},{"text":"யாட்டே","tr":"yāṭṭē","foot":"tēmā","acai":[{"kind":"nēr","text":"யாட்","tr":"yāṭ"},{"kind":"nēr","text":"டே","tr":"ṭē"}]}]]},"ai":{"lines":[{"words":[{"surface":"முழந்தாள்","parts":[{"text":"முழம்","lemma":"முழம்","gloss":"knee/joint"},{"text":"தாள்","lemma":"தாள்","gloss":"leg"}],"gloss":"knobby-kneed"},{"surface":"இரும்பிடி","parts":[{"text":"இரும்பிடி","lemma":"இரும்பிடி","gloss":"dark female elephant"}],"gloss":"dark female elephant","split_unverified":true},{"surface":"கயந்தலை","parts":[{"text":"கயம்","lemma":"கயம்","gloss":"soft/tender"},{"text":"தலை","lemma":"தலை","gloss":"head"}],"gloss":"soft-headed"},{"surface":"குழவி","parts":[{"text":"குழவி","lemma":"குழவி","gloss":"calf"}],"gloss":"calf"}]},{"words":[{"surface":"நறவுமலி","parts":[{"text":"நறவு","lemma":"நறவு","gloss":"toddy/honey"},{"text":"மலி","lemma":"மலி","gloss":"abundant"}],"gloss":"toddy-abundant"},{"surface":"பாக்கத்து","parts":[{"text":"பாக்கத்து","lemma":"பாக்கத்து","gloss":"of the hamlet"}],"gloss":"of the hamlet","split_unverified":true},{"surface":"குறமகள்","parts":[{"text":"குறமகள்","lemma":"குறமகள்","gloss":"Kurava woman"}],"gloss":"Kurava woman","split_unverified":true},{"surface":"ஈன்ற","parts":[{"text":"ஈன்","lemma":"ஈன்","gloss":"give birth"},{"text":"ற","lemma":"த","gloss":"past relative participle suffix"}],"gloss":"who gave birth to"}]},{"words":[{"surface":"குறியிறை","parts":[{"text":"குறியிறை","lemma":"குறியிறை","gloss":"short-forearmed"}],"gloss":"short-forearmed","split_unverified":true},{"surface":"புதல்வரொடு","parts":[{"text":"புதல்வர்","lemma":"புதல்வர்","gloss":"sons"},{"text":"ஒடு","lemma":"ஒடு","gloss":"with"}],"gloss":"with the sons"},{"surface":"மறுவந்து","parts":[{"text":"மறு","lemma":"மறு","gloss":"again"},{"text":"வந்து","lemma":"வந்து","gloss":"having come"}],"gloss":"returning"},{"surface":"ஓடி","parts":[{"text":"ஓடி","lemma":"ஓடு","gloss":"having run"}],"gloss":"running"}]},{"words":[{"surface":"முன்னாள்","parts":[{"text":"முன்","lemma":"முன்","gloss":"before"},{"text":"நாள்","lemma":"நாள்","gloss":"day"}],"gloss":"in the early days"},{"surface":"இனியதாகி","parts":[{"text":"இனியதாகி","lemma":"இனியதாகி","gloss":"having been sweet"}],"gloss":"having been sweet","split_unverified":true},{"surface":"பின்னாள்","parts":[{"text":"பின்","lemma":"பின்","gloss":"after"},{"text":"நாள்","lemma":"நாள்","gloss":"day"}],"gloss":"in the later days"}]},{"words":[{"surface":"அவர்","parts":[{"text":"அவர்","lemma":"அவர்","gloss":"their"}],"gloss":"their"},{"surface":"தினைப்புனம்","parts":[{"text":"தினை","lemma":"தினை","gloss":"millet"},{"text":"புனம்","lemma":"புனம்","gloss":"field"}],"gloss":"millet field"},{"surface":"மேய்ந்தாங்கு","parts":[{"text":"மேய்ந்து","lemma":"மேய்","gloss":"having grazed"},{"text":"ஆங்கு","lemma":"ஆங்கு","gloss":"like"}],"gloss":"just like grazing on"}]},{"words":[{"surface":"பகையாகின்றவர்","parts":[{"text":"பகை","lemma":"பகை","gloss":"enmity"},{"text":"ஆகின்றவர்","lemma":"ஆகு","gloss":"those who become"}],"gloss":"those who become hostile"},{"surface":"நகைவிளையாட்டே","parts":[{"text":"நகை","lemma":"நகை","gloss":"laughter/jest"},{"text":"விளையாட்டு","lemma":"விளையாட்டு","gloss":"play/sport"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"the playful jesting indeed"}]}],"literal":"The knobby-kneed dark female elephant's soft-headed calf, / with the short-forearmed sons born to the Kurava woman of the toddy-abundant hamlet, / running and returning together, / being sweet in the early days, and in the later days, / just like grazing on their millet field, / becomes hostile, his playful jesting!","translation":"The soft-headed calf of the knobby-kneed, dark female elephant runs and plays, turning back and forth, with the short-armed children born to the Kurava woman of the toddy-rich hill hamlet. In the early days, this play was sweet; but in later days, just like that elephant calf growing up to graze on and destroy their very millet field, his playful love has now turned to hostility.","modern":"முழந்தாள்களை உடைய கரிய பெண் யானையின் மென்மையான தலையைக் கொண்ட குட்டி, கள் நிறைந்த சிற்றூரைச் சேர்ந்த குறமகள் பெற்றெடுத்த குறிய கைகளை உடைய சிறுவர்களோடு கூடி விளையாடி ஓடித் திரியும். அது தொடக்கத்தில் அவர்களுக்கு இனியதாக இருந்தது. ஆனால், பின்னர் அது வளர்ந்து அவர்களுடைய தினைப்புனத்தையே மேய்ந்து அழிப்பது போல, நம் தலைவரின் விளையாட்டுத் தனமான அன்பு தொடக்கத்தில் இன்பமாக இருந்து, இப்போது நமக்குத் துன்பம் தரும் பகையாக மாறிவிட்டது.","explanation":"The friend (தோழி) speaks to the heroine (or to the hero within his hearing) about the pain caused by his delayed marriage. She uses a vivid metaphor from the mountainous Kuriñci landscape. An elephant calf initially plays harmlessly and sweetly with the local Kurava children. However, as it grows, it returns to graze upon and destroy the very millet fields that sustain those children's families. Similarly, the hero's playful courtship, which was once sweet and joyful, has now become a source of distress and hostility as he neglects his commitment.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.5],[0.5,1.2],[1.2,1.7],[1.7,2.0],[2.0,3.15],[3.15,3.45],[3.45,3.6],[3.8,4.4],[4.4,5.2],[5.36,5.68],[5.68,6.0],[6.47,6.6],[6.6,7.1],[7.1,7.6],[7.6,8.0],[8.0,8.0],[8.0,9.33],[9.33,9.6],[9.6,9.6],[9.6,10.72],[10.72,10.72],[10.72,11.2],[11.2,11.64],[11.64,12.0]],"female":[[0.0,0.5],[0.5,1.2],[1.2,1.8],[1.8,2.1],[2.1,3.3],[3.3,3.97],[3.97,4.4],[4.4,4.5],[4.5,4.82],[4.82,6.5],[6.5,6.7],[7.2,7.4],[7.4,8.1],[8.1,8.6],[8.6,9.1],[9.1,9.2],[9.2,10.74],[10.74,11.1],[11.1,11.1],[11.1,11.8],[11.8,12.5],[12.5,13.1],[13.1,13.74],[13.74,14.04]]},"sync":[[["முழந்தாள்","knobby-kneed"]],[["இரும்பிடி","dark female elephant"],["கயந்தலை","soft-headed"]],[["கயந்தலை","soft-headed"],["குழவி","calf"]],[["குழவி","calf"]],[["நறவுமலி","toddy-abundant"]],[["பாக்கத்து","of the hamlet"],["குறமகள்","Kurava woman"]],[["குறமகள்","Kurava woman"]],[["ஈன்ற","who gave birth to"]],[["குறியிறை","short-forearmed"]],[["புதல்வரொடு","with the sons"]],[["மறுவந்து","returning"]],[["மறுவந்து","returning"],["ஓடி","running"]],[["முன்னாள்","in the early days"]],[["இனியதாகி","having been sweet"]],[["இனியதாகி","having been sweet"],["பின்னாள்","in the later days"]],[["பின்னாள்","in the later days"]],[["அவர்","their"],["தினைப்புனம்","millet field"]],[["தினைப்புனம்","millet field"]],[["மேய்ந்தாங்கு","just like grazing on"]],[["மேய்ந்தாங்கு","just like grazing on"]],[["பகையாகின்றவர்","those who become hostile"]],[["பகையாகின்றவர்","those who become hostile"]],[["நகைவிளையாட்டே","the playful jesting indeed"]],[["நகைவிளையாட்டே","the playful jesting indeed"]]]}