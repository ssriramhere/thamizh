{"text":"kuruntokai","n":227,"lines":["பூண்வனைந் தன்ன பொலஞ்சூட்டு நேமி","வாண்முகந் துமிப்ப வள்ளிதழ் குறைந்த","கூழை நெய்தலு முடைத்திவண்","தேரோன் போகிய கான லானே"],"tr":["pūṇvaṉain taṉṉa polañcūṭṭu nēmi","vāṇmukan tumippa vaḷḷitaḻ kuṟainta","kūḻai neytalu muṭaittivaṇ","tērōṉ pōkiya kāṉa lāṉē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தோழி கூற்று","poet_ta":"ஓதஞானியார்","speaker_en":"her friend (tōḻi)","poet_tr":"Ōtañāṉiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 14, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 9, veṇṭaḷai 5"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பூண்வனைந்","tr":"pūṇvaṉain","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பூண்","tr":"pūṇ"},{"kind":"nirai","text":"வனைந்","tr":"vaṉain"}]},{"text":"தன்ன","tr":"taṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"தன்","tr":"taṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"பொலஞ்சூட்டு","tr":"polañcūṭṭu","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"பொலஞ்","tr":"polañ"},{"kind":"nēr","text":"சூட்","tr":"cūṭ"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"நேமி","tr":"nēmi","foot":"tēmā","acai":[{"kind":"nēr","text":"நே","tr":"nē"},{"kind":"nēr","text":"மி","tr":"mi"}]}],[{"text":"வாண்முகந்","tr":"vāṇmukan","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வாண்","tr":"vāṇ"},{"kind":"nirai","text":"முகந்","tr":"mukan"}]},{"text":"துமிப்ப","tr":"tumippa","foot":"puḷimā","acai":[{"kind":"nirai","text":"துமிப்","tr":"tumip"},{"kind":"nēr","text":"ப","tr":"pa"}]},{"text":"வள்ளிதழ்","tr":"vaḷḷitaḻ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வள்","tr":"vaḷ"},{"kind":"nirai","text":"ளிதழ்","tr":"ḷitaḻ"}]},{"text":"குறைந்த","tr":"kuṟainta","foot":"puḷimā","acai":[{"kind":"nirai","text":"குறைந்","tr":"kuṟain"},{"kind":"nēr","text":"த","tr":"ta"}]}],[{"text"