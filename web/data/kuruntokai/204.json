{"text":"kuruntokai","n":204,"lines":["காமம் காமம் என்ப காமம்","அணங்கும் பிணியும் அன்றே நினைப்பின்","முதைச்சுவற் கலித்த முற்றா இளம்புல்","மூதா தைவந் தாங்கு","விருந்தே காமம் பெருந்தோ ளோயே"],"tr":["kāmam kāmam eṉpa kāmam","aṇaṅkum piṇiyum aṉṟē niṉaippiṉ","mutaiccuvaṟ kalitta muṟṟā iḷampul","mūtā taivan tāṅku","viruntē kāmam peruntō ḷōyē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"பாங்கன் கூற்று","poet_ta":"மிளைப்பெருங் கந்தனார்","speaker_en":"the hero's companion (pāṅkaṉ)","poet_tr":"Miḷaipperuṅ Kantaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 7"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"காமம்","tr":"kāmam","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"மம்","tr":"mam"}]},{"text":"காமம்","tr":"kāmam","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"மம்","tr":"mam"}]},{"text":"என்ப","tr":"eṉpa","foot":"tēmā","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nēr","text":"ப","tr":"pa"}]},{"text":"காமம்","tr":"kāmam","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"மம்","tr":"mam"}]}],[{"text":"அணங்கும்","tr":"aṇaṅkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"அணங்","tr":"aṇaṅ"},{"kind":"nēr","text":"கும்","tr":"kum"}]},{"text":"பிணியும்","tr":"piṇiyum","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிணி","tr":"piṇi"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"அன்றே","tr":"aṉṟē","foot":"tēmā","acai":[{"kind":"nēr","text":"அன்","tr":"aṉ"},{"kind":"nēr","text":"றே","tr":"ṟē"}]},{"text":"நினைப்பின்","tr":"niṉaippiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"நினைப்","tr":"niṉaip"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]}],[{"text":"முதைச்சுவற்","tr":