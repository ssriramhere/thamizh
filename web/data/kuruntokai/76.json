"nēr","text":"அச்","tr":"ac"},{"kind":"nirai","text":"சிரம்","tr":"ciram"}]},{"text":"நடுங்கஞர்","tr":"naṭuṅkañar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நடுங்","tr":"naṭuṅ"},{"kind":"nirai","text":"கஞர்","tr":"kañar"}]},{"text":"உறவே","tr":"uṟavē","foot":"puḷimā","acai":[{"kind":"nirai","text":"உற","tr":"uṟa"},{"kind":"nēr","text":"வே","tr":"vē"}]}]]},"ai":{"lines":[{"words":[{"surface":"காந்தள்","parts":[{"text":"காந்தள்","lemma":"kāntal","gloss":"Malabar glory lily"}],"gloss":"Malabar glory lily"},{"surface":"வேலி","parts":[{"text":"வேலி","lemma":"vēli","gloss":"fence"}],"gloss":"fence"},{"surface":"ஓங்குமலை","parts":[{"text":"ஓங்கு","lemma":"ōṅku","gloss":"rise high"},{"text":"மலை","lemma":"malai","gloss":"mountain"}],"gloss":"high-rising mountain"},{"surface":"நல்நாட்டு","parts":[{"text":"நல்நாட்டு","lemma":"நல்நாட்டு","gloss":"of the good country"}],"gloss":"of the good country","split_unverified":true}]},{"words":[{"surface":"செல்ப","parts":[{"text":"செல்","lemma":"cel","gloss":"go"},{"text":"ப","lemma":"pa","gloss":"third person plural suffix"}],"gloss":"they will go"},{"surface":"என்பவோ","parts":[{"text":"என்ப","lemma":"eṉpa","gloss":"they say"},{"text":"ஓ","lemma":"ō","gloss":"interrogative particle"}],"gloss":"do they say?"},{"surface":"கல்வரை","parts":[{"text":"கல்","lemma":"kal","gloss":"stone"},{"text":"வரை","lemma":"varai","gloss":"mountain slope"}],"gloss":"rocky mountain"},{"surface":"மார்பர்","parts":[{"text":"மார்பு","lemma":"mārpu","gloss":"chest"},{"text":"அர்","lemma":"ar","gloss":"honorific suffix"}],"gloss":"he of the chest"}]},{"words":[{"surface":"சிலம்பின்","parts":[{"text":"சிலம்பு","lemma":"cilampu","gloss":"mountain side"},{"text":"இன்","lemma":"iṉ","gloss":"locative suffix"}],"gloss":"on the mountain side"},{"surface":"சேம்பின்","parts":[{"text":"சேம்பு","lemma":"cēmpu","gloss":"taro plant"},{"text":"இன்","lemma":"iṉ","gloss":"genitive suffix"}],"gloss":"of the taro plant"},{"surface":"அலங்கல்","parts":[{"text":"அலங்கல்","lemma":"alaṅkal","gloss":"swaying"}],"gloss":"swaying"},{"surface":"வள்ளிலை","parts":[{"text":"வள்","lemma":"vaḷ","gloss":"large"},{"text":"இலை","lemma":"ilai","gloss":"leaf"}],"gloss":"large leaf"}]},{"words":[{"surface":"பெருங்களிற்று","parts":[{"text":"பெருங்களிற்று","lemma":"பெருங்களிற்று","gloss":"of the great male elephant"}],"gloss":"of the great male elephant","split_unverified":true},{"surface":"செவியின்","parts":[{"text":"செவி","lemma":"cevi","gloss":"ear"},{"text":"இன்","lemma":"iṉ","gloss":"comparative suffix"}],"gloss":"like the ear"},{"surface":"மான","parts":[{"text":"மான","lemma":"māṉa","gloss":"to resemble"}],"gloss":"resembling"},{"surface":"தைஇ","parts":[{"text":"தை","lemma":"tai","gloss":"to strike"},{"text":"இ","lemma":"i","gloss":"verbal participle suffix"}],"gloss":"striking"}]},{"words":[{"surface":"தண்வரல்","parts":[{"text":"தண்","lemma":"taṇ","gloss":"cool"},{"text":"வரல்","lemma":"varal","gloss":"coming"}],"gloss":"cool-coming"},{"surface":"வாடை","parts":[{"text":"வாடை","lemma":"vāṭai","gloss":"north wind"}],"gloss":"north wind"},{"surface":"தூக்கும்","parts":[{"text":"தூக்கு","lemma":"tūkku","gloss":"to shake"},{"text":"உம்","lemma":"um","gloss":"adjectival participle suffix"}],"gloss":"that shakes"}]},{"words":[{"surface":"கடும்பனி","parts":[{"text":"கடும்பனி","lemma":"கடும்பனி","gloss":"severe cold"}],"gloss":"severe cold","split_unverified":true},{"surface":"அச்சிரம்","parts":[{"text":"அச்சிரம்","lemma":"acciram","gloss":"early winter season"}],"gloss":"early winter season"},{"surface":"நடுங்கு","parts":[{"text":"நடுங்கு","lemma":"naṭuṅku","gloss":"to tremble"}],"gloss":"trembling"},{"surface":"அஞர்","parts":[{"text":"அஞர்","lemma":"añar","gloss":"grief"}],"gloss":"grief"},{"surface":"உறவே","parts":[{"text":"உற","lemma":"uṟa","gloss":"to experience"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"to experience indeed"}]}],"literal":"Malabar glory lily [as] fence high-rising mountain good country's / will go, they say, is it so? he of the rocky mountain chest / on the mountain side, of the taro plant, the swaying large leaf, / resembling the ear of a great male elephant, striking, / the cool-coming north wind blows, / [in this] severe cold early winter season, causing trembling grief to be experienced indeed.","translation":"They say he will depart—he of the rocky mountain chest, whose good country has high mountains fenced with Malabar glory lilies. In this early winter of severe cold, the cool north wind blows, shaking the large, swaying leaves of the taro plant on the mountain slopes, which resemble the ears of a great male elephant, causing me to tremble and suffer deep grief.","modern":"காந்தள் மலர்களை வேலியாகக் கொண்ட, உயர்ந்த மலைகளையுடைய நல்ல நாட்டிற்கு உரியவர், பாறை போன்ற மார்பினை உடைய நம் தலைவர். அவர் நம்மைப் பிரிந்து செல்வார் என்று கூறுகிறார்களே, அது உண்மையோ? மலைச்சரிவிலே வளரும் சேம்புச் செடியின் அசைகின்ற பெரிய இலைகள், பெரிய ஆண் யானையின் காதுகளைப் போலத் தோன்றுமாறு அவற்றின் மீது மோதி, குளிர்ச்சியோடு வீசும் வாடைக் காற்று வீசுகின்றது. இத்தகைய கடுமையான பனிக்காலமாகிய முன்பனிக் காலத்தில், நாம் நடுங்கித் துயரத்தை அடையும்படியாக அவர் பிரிந்து செல்வாரோ?","explanation":"The speaker is the heroine, expressing her deep distress to her confidante upon hearing rumors that her lover, the lord of the mountain country, is planning to depart to earn wealth. The poem is set in the kuriñci (mountainous) landscape, characterized by the Malabar glory lily (kāntal) and taro plants (cēmpu) growing on the slopes. The season is acciram (early winter), when the cold north wind (vāṭai) blows fiercely. The poet uses a vivid image: the broad, swaying leaves of the taro plant resemble the flapping ears of a great male elephant as the cold wind strikes them. This visual and tactile imagery intensifies the heroine's loneliness and dread of separation during the freezing season, questioning how her lover, with his strong rocky chest, could leave her to suffer this trembling grief.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,1.0],[1.0,1.5],[1.5,2.22],[2.22,2.58],[2.7,3.21],[3.21,3.6],[3.6,4.1],[4.1,5.0],[5.0,5.1],[5.1,5.5],[5.5,6.2],[6.2,7.26],[7.26,7.7],[7.7,8.02],[8.02,8.15],[8.34,8.4],[8.4,9.2],[9.2,9.6],[9.6,9.9],[9.9,10.8],[11.4,12.0],[12.0,12.3]],"female":[[0.0,0.8],[0.8,1.1],[1.1,1.9],[1.9,2.6],[2.6,2.9],[3.2,3.71],[3.71,4.1],[4.1,4.7],[4.7,5.7],[5.7,5.9],[5.9,6.2],[6.2,7.28],[7.28,7.28],[7.28,7.28],[7.28,7.28],[7.28,7.28],[7.28,7.28],[7.28,10.5],[10.5,10.8],[10.8,12.1],[12.1,12.6],[12.6,12.6],[12.6,13.7]]},"sync":[[["காந்தள்","Malabar glory lily"]],[["வேலி","fence"]],[["ஓங்குமலை","high-rising mountain"]],[["நல்நாட்டு","of the good country"]],[["செல்ப","they will go"]],[["என்பவோ","do they say?"]],[["கல்வரை","rocky mountain"]],[["மார்பர்","he of the chest"]],[["சிலம்பின்","on the mountain side"]],[["சேம்பின்","of the taro plant"]],[["அலங்கல்","swaying"]],[["வள்ளிலை","large leaf"]],[["பெருங்களிற்று","of the great male elephant"],["செவியின்","like the ear"]],[["செவியின்","like the ear"]],[["மான","resembling"],["தைஇ","striking"]],[["தைஇ","striking"]],[["தண்வரல்","cool-coming"]],[["வாடை","north wind"]],[["தூக்கும்","that shakes"]],[["கடும்பனி","severe cold"]],[["அச்சிரம்","early winter season"]],[["நடுங்கு","trembling"],["அஞர்","grief"]],[["உறவே","to experience indeed"]]]}