{"text":"kuruntokai","n":76,"lines":["காந்தள் வேலி ஓங்குமலை நல்நாட்டுச்","செல்ப என்பவோ கல்வரை மார்பர்","சிலம்பிற் சேம்பின் அலங்கல் வள்ளிலை","பெருங்களிற்றுச் செவியின் மானத் தைஇத்","தண்வரல் வாடை தூக்கும்","கடும்பனி அச்சிரம் நடுங்கஞர் உறவே"],"tr":["kāntaḷ vēli ōṅkumalai nalnāṭṭuc","celpa eṉpavō kalvarai mārpar","cilampiṟ cēmpiṉ alaṅkal vaḷḷilai","peruṅkaḷiṟṟuc ceviyiṉ māṉat taiit","taṇvaral vāṭai tūkkum","kaṭumpaṉi acciram naṭuṅkañar uṟavē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"கிள்ளி மங்கலங்கிழார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kiḷḷi Maṅkalaṅkiḻār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 20, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 9, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"காந்தள்","tr":"kāntaḷ","foot":"tēmā","acai":[{"kind":"nēr","text":"காந்","tr":"kān"},{"kind":"nēr","text":"தள்","tr":"taḷ"}]},{"text":"வேலி","tr":"vēli","foot":"tēmā","acai":[{"kind":"nēr","text":"வே","tr":"vē"},{"kind":"nēr","text":"லி","tr":"li"}]},{"text":"ஓங்குமலை","tr":"ōṅkumalai","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"ஓங்","tr":"ōṅ"},{"kind":"nirai","text":"கும","tr":"kuma"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"நல்நாட்டுச்","tr":"nalnāṭṭuc","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"நல்","tr":"nal"},{"kind":"nēr","text":"நாட்","tr":"nāṭ"},{"kind":"nēr","text":"டுச்","tr":"ṭuc"}]}],[{"text":"செல்ப","tr":"celpa","foot":"tēmā","acai":[{"kind":"nēr","text":"செல்","tr":"cel"},{"kind":"nēr","text":"ப","tr":"pa"}]},{"text":"என்பவோ","tr":"eṉpavō","foot":"kūviḷam","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nirai","text":"பவோ","tr":"pavō"}]},{"text":"கல்வரை","tr":"kalvarai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கல்","tr":"k