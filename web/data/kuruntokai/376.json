{"text":"kuruntokai","n":376,"lines":["மன்னுயிர் அறியாத் துன்னரும் பொதியிற்","சூருடை அடுக்கத் தாரங் கடுப்ப","வேனி லானே தண்ணியள் பனியே","வாங்குகதிர் தொகுப்பக் கூம்பி ஐயென","அலங்குவெயிற் பொதிந்த தாமரை","உள்ளகத் தன்ன சிறுவெம் மையளே"],"tr":["maṉṉuyir aṟiyāt tuṉṉarum potiyiṟ","cūruṭai aṭukkat tāraṅ kaṭuppa","vēṉi lāṉē taṇṇiyaḷ paṉiyē","vāṅkukatir tokuppak kūmpi aiyeṉa","alaṅkuveyiṟ potinta tāmarai","uḷḷakat taṉṉa ciṟuvem maiyaḷē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவன் கூற்று","poet_ta":"படுமாத்து மோசிகொற்றனார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Paṭumāttu Mōcikoṟṟaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 4, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மன்னுயிர்","tr":"maṉṉuyir","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மன்","tr":"maṉ"},{"kind":"nirai","text":"னுயிர்","tr":"ṉuyir"}]},{"text":"அறியாத்","tr":"aṟiyāt","foot":"puḷimā","acai":[{"kind":"nirai","text":"அறி","tr":"aṟi"},{"kind":"nēr","text":"யாத்","tr":"yāt"}]},{"text":"துன்னரும்","tr":"tuṉṉarum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"துன்","tr":"tuṉ"},{"kind":"nirai","text":"னரும்","tr":"ṉarum"}]},{"text":"பொதியிற்","tr":"potiyiṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பொதி","tr":"poti"},{"kind":"nēr","text":"யிற்","tr":"yiṟ"}]}],[{"text":"சூருடை","tr":"cūruṭai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சூ","tr":"cū"},{"kind":"nirai","text":"ருடை","tr":"ruṭai"}]},{"text":"அடுக்கத்","tr":"aṭukkat","foot":"puḷimā","acai":[{"kind":"nirai","text":"அடுக்","tr":"aṭuk"},{"kind":"nēr","text":"கத்","tr":"kat"}]},{"text":"தாரங்","tr":"tāraṅ","foot":"tēmā","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"ரங்","tr":"raṅ"}]},{"text":"