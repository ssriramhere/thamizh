r":"kūn"},{"kind":"nēr","text":"தல்","tr":"tal"}]},{"text":"தைவரு","tr":"taivaru","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தை","tr":"tai"},{"kind":"nirai","text":"வரு","tr":"varu"}]},{"text":"வேனே","tr":"vēṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"வே","tr":"vē"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"ஈங்கே","parts":[{"text":"ஈங்கு","lemma":"ஈங்கு","gloss":"here"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"right here"},{"surface":"வருவர்","parts":[{"text":"வரு","lemma":"வருதல்","gloss":"come"},{"text":"வர்","lemma":"அவர்","gloss":"he (honorific)"}],"gloss":"he will come"},{"surface":"இனையல்","parts":[{"text":"இனை","lemma":"இனைதல்","gloss":"grieve"},{"text":"அல்","lemma":"அல்","gloss":"do not"}],"gloss":"do not grieve"},{"surface":"அவர்","parts":[{"text":"அவர்","lemma":"அவர்","gloss":"he"}],"gloss":"he"},{"surface":"என","parts":[{"text":"என","lemma":"என","gloss":"saying"}],"gloss":"saying"}]},{"words":[{"surface":"அழாஅற்கோ","parts":[{"text":"அழாஅல்","lemma":"அழுதல்","gloss":"refraining from weeping"},{"text":"கோ","lemma":"கோ","gloss":"interrogative particle"}],"gloss":"shall I stop weeping?"},{"surface":"இனியே","parts":[{"text":"இனி","lemma":"இனி","gloss":"now"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"now"},{"surface":"நோய்நொந்து","parts":[{"text":"நோய்","lemma":"நோய்","gloss":"pain"},{"text":"நொந்து","lemma":"நோதல்","gloss":"suffering"}],"gloss":"suffering from pain"},{"surface":"உறைவி","parts":[{"text":"உறை","lemma":"உறைதல்","gloss":"reside"},{"text":"வி","lemma":"இவள்","gloss":"I who"}],"gloss":"I who live"}]},{"words":[{"surface":"மின்னின்","parts":[{"text":"மின்","lemma":"மின்","gloss":"lightning"},{"text":"இன்","lemma":"இன்","gloss":"like"}],"gloss":"like lightning"},{"surface":"தூவி","parts":[{"text":"தூவி","lemma":"தூவி","gloss":"feather"}],"gloss":"feathers"},{"surface":"இருங்குயில்","parts":[{"text":"இரும்","lemma":"இரும்","gloss":"dark"},{"text":"குயில்","lemma":"குயில்","gloss":"koel"}],"gloss":"dark koel"},{"surface":"பொன்னின்","parts":[{"text":"பொன்","lemma":"பொன்","gloss":"gold"},{"text":"இன்","lemma":"இன்","gloss":"of"}],"gloss":"of gold"}]},{"words":[{"surface":"உரைதிகழ்","parts":[{"text":"உரை","lemma":"உரை","gloss":"streak"},{"text":"திகழ்","lemma":"திகழ்தல்","gloss":"shining"}],"gloss":"shining streak"},{"surface":"கட்டளை","parts":[{"text":"கட்டளை","lemma":"கட்டளை","gloss":"touchstone"}],"gloss":"touchstone"},{"surface":"கடுப்ப","parts":[{"text":"கடுப்ப","lemma":"கடுப்ப","gloss":"to resemble"}],"gloss":"resembling"},{"surface":"மாச்சினை","parts":[{"text":"மா","lemma":"மா","gloss":"mango"},{"text":"சினை","lemma":"சினை","gloss":"branch"}],"gloss":"mango branch"}]},{"words":[{"surface":"நறுந்தாது","parts":[{"text":"நறும்","lemma":"நறுமை","gloss":"fragrant"},{"text":"தாது","lemma":"தாது","gloss":"pollen"}],"gloss":"fragrant pollen"},{"surface":"கொழுதும்","parts":[{"text":"கொழுது","lemma":"கொழுதல்","gloss":"peck"},{"text":"உம்","lemma":"உம்","gloss":"which"}],"gloss":"pecking"},{"surface":"பொழுதும்","parts":[{"text":"பொழுது","lemma":"பொழுது","gloss":"time"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"even at the time"}]},{"words":[{"surface":"வறுங்குரல்","parts":[{"text":"வறும்","lemma":"வறுமை","gloss":"empty"},{"text":"குரல்","lemma":"குரல்","gloss":"lock of hair"}],"gloss":"empty locks"},{"surface":"கூந்தல்","parts":[{"text":"கூந்தல்","lemma":"கூந்தல்","gloss":"hair"}],"gloss":"hair"},{"surface":"தைவருவேனே","parts":[{"text":"தைவரு","lemma":"தைவருதல்","gloss":"stroke"},{"text":"வேன்","lemma":"ஏன்","gloss":"I"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"I stroke"}]}],"literal":"Right here he will come, do not grieve, he, saying / shall I stop weeping now, I who live suffering from pain, / when the dark koel with feathers like lightning, of gold / resembling a shining streak on a touchstone, on the mango branch / pecks at the fragrant pollen, even at this time, / as I stroke my empty-locked hair?","translation":"When they say, 'He will return right here, do not grieve,' should I stop weeping now—I who live suffering from this painful longing? Even at this hour, when the dark koel with feathers shining like lightning pecks at the fragrant pollen on the mango branch, looking like a streak of gold on a touchstone, I am left alone, merely stroking my empty, flowerless hair.","modern":"தோழி, 'அவர் இங்கேயே வந்துவிடுவார், வருந்தாதே' என்று கூறுவதால், இந்தத் துன்பத்தை அனுபவித்துக் கொண்டு வாழும் நான் இப்போது அழாமல் இருக்க முடியுமா? மின்னலைப் போன்ற இறகுகளைக் கொண்ட கரிய குயில், உரை கல்லில் தேய்த்த தங்கத்தின் மாற்று உரை போலத் தோன்றுமாறு, மாமரத்தின் கிளையிலுள்ள நறுமணமிக்க மகரந்தத்தைக் கோதி உண்ணும் இந்த வசந்த காலத்திலும், நான் பூக்கள் இல்லாத என் வறிய கூந்தலைத் தடவிக் கொண்டு தனியாக வருந்துகிறேனே!","explanation":"The heroine speaks to her friend who is trying to console her during the hero's absence. The friend assures her that the hero will return soon and asks her not to weep. However, the heroine points out that the spring season has already arrived, which was the promised time of his return. She describes a dark koel bird pecking at yellow mango pollen, comparing it beautifully to a streak of gold on a dark touchstone. This vivid image of nature's union highlights her own painful isolation. While the world rejoices in spring, she is left alone with no flowers to adorn her hair, able only to stroke her empty tresses.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.5],[0.5,0.9],[0.9,1.3],[1.3,2.0],[2.0,2.9],[2.9,3.3],[3.3,3.8],[3.8,4.1],[4.1,5.04],[5.41,5.6],[5.6,6.2],[6.2,6.96],[6.96,7.9],[7.9,8.3],[8.3,8.7],[8.7,9.32],[9.32,10.1],[10.1,10.5],[10.5,11.1],[11.1,12.0],[12.0,12.2],[12.2,12.7],[12.7,12.9]],"female":[[0.0,0.7],[0.7,1.2],[1.2,1.6],[1.6,2.3],[2.3,3.3],[3.3,3.59],[3.59,3.98],[3.98,4.28],[4.28,4.67],[4.67,4.8],[4.8,6.24],[6.24,7.2],[7.2,8.9],[8.9,9.4],[9.4,9.9],[9.9,10.45],[10.45,11.14],[11.14,11.9],[11.9,12.3],[12.3,14.0],[14.0,14.2],[14.2,14.7],[14.7,14.9]]},"sync":[[["ஈங்கே","right here"]],[["வருவர்","he will come"]],[["இனையல்","do not grieve"]],[["அவர்","he"],["என","saying"]],[["அழாஅற்கோ","shall I stop weeping?"]],[["இனியே","now"]],[["நோய்நொந்து","suffering from pain"]],[["நோய்நொந்து","suffering from pain"],["உறைவி","I who live"]],[["மின்னின்","like lightning"]],[["தூவி","feathers"]],[["இருங்குயில்","dark koel"]],[["பொன்னின்","of gold"]],[["உரைதிகழ்","shining streak"]],[["கட்டளை","touchstone"]],[["கடுப்ப","resembling"]],[["மாச்சினை","mango branch"]],[["நறுந்தாது","fragrant pollen"]],[["கொழுதும்","pecking"]],[["பொழுதும்","even at the time"]],[["வறுங்குரல்","empty locks"]],[["கூந்தல்","hair"]],[["தைவருவேனே","I stroke"]],[["தைவருவேனே","I stroke"]]]}