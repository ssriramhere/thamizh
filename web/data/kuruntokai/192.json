{"text":"kuruntokai","n":192,"lines":["ஈங்கே வருவர் இனையல் அவர்என","அழாஅற்கோ இனியே நோய்நொந் துறைவி","மின்னின் றூவி இருங்குயில் பொன்னின்","உரைதிகழ் கட்டளை கடுப்ப மாச்சினை","நறுந்தாது கொழுதும் பொழுதும்","வறுங்குரற் கூந்தல் தைவரு வேனே"],"tr":["īṅkē varuvar iṉaiyal avareṉa","aḻāaṟkō iṉiyē nōynon tuṟaivi","miṉṉiṉ ṟūvi iruṅkuyil poṉṉiṉ","uraitikaḻ kaṭṭaḷai kaṭuppa mācciṉai","naṟuntātu koḻutum poḻutum","vaṟuṅkuraṟ kūntal taivaru vēṉē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"கச்சிப்பேட்டு நன்னாகையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kaccippēṭṭu Naṉṉākaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 12, āciriyattaḷai 8, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஈங்கே","tr":"īṅkē","foot":"tēmā","acai":[{"kind":"nēr","text":"ஈங்","tr":"īṅ"},{"kind":"nēr","text":"கே","tr":"kē"}]},{"text":"வருவர்","tr":"varuvar","foot":"puḷimā","acai":[{"kind":"nirai","text":"வரு","tr":"varu"},{"kind":"nēr","text":"வர்","tr":"var"}]},{"text":"இனையல்","tr":"iṉaiyal","foot":"puḷimā","acai":[{"kind":"nirai","text":"இனை","tr":"iṉai"},{"kind":"nēr","text":"யல்","tr":"yal"}]},{"text":"அவர்என","tr":"avareṉa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அவர்","tr":"avar"},{"kind":"nirai","text":"என","tr":"eṉa"}]}],[{"text":"அழாஅற்கோ","tr":"aḻāaṟkō","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"அழா","tr":"aḻā"},{"kind":"nēr","text":"அற்","tr":"aṟ"},{"kind":"nēr","text":"கோ","tr":"kō"}]},{"text":"இனியே","tr":"iṉiyē","foot":"puḷimā","acai":[{"kind":"nirai","text":"இனி","tr":"iṉi"},{"kind":"nēr","text":"யே","tr":"yē"}]},{"text":"நோய்நொந்","tr":"nōynon","foot":"tēmā","acai":[{"kind":"nēr","text":"நோய்","tr":"nōy"},{"kind":"nēr","text":"நொந்","tr":"non"}