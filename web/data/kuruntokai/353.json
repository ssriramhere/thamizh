{"text":"kuruntokai","n":353,"lines":["ஆர்கலி வெற்பன் மார்புபுணை யாகக்","கோடுயர் நெடுவரைக் கவாஅற் பகலே","பாடின் அருவி ஆடுதல் இனிதே","நிரையிதழ் பொருந்தாக் கண்ணோ டிரவிற்","பஞ்சி வெண்திரிச் செஞ்சுடர் நல்லிற்","பின்னுவீழ் சிறுபுறந் தழீஇ","அன்னை முயங்கத் துயிலின் னாதே"],"tr":["ārkali veṟpaṉ mārpupuṇai yākak","kōṭuyar neṭuvaraik kavāaṟ pakalē","pāṭiṉ aruvi āṭutal iṉitē","niraiyitaḻ poruntāk kaṇṇō ṭiraviṟ","pañci veṇtiric ceñcuṭar nalliṟ","piṉṉuvīḻ ciṟupuṟan taḻīi","aṉṉai muyaṅkat tuyiliṉ ṉātē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"உறையூர் முதுகூற்றனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Uṟaiyūr Mutukūṟṟaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 10"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஆர்கலி","tr":"ārkali","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஆர்","tr":"ār"},{"kind":"nirai","text":"கலி","tr":"kali"}]},{"text":"வெற்பன்","tr":"veṟpaṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"வெற்","tr":"veṟ"},{"kind":"nēr","text":"பன்","tr":"paṉ"}]},{"text":"மார்புபுணை","tr":"mārpupuṇai","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"மார்","tr":"mār"},{"kind":"nirai","text":"புபு","tr":"pupu"},{"kind":"nēr","text":"ணை","tr":"ṇai"}]},{"text":"யாகக்","tr":"yākak","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"கக்","tr":"kak"}]}],[{"text":"கோடுயர்","tr":"kōṭuyar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கோ","tr":"kō"},{"kind":"nirai","text":"டுயர்","tr":"ṭuyar"}]},{"text":"நெடுவரைக்","tr":"neṭuvaraik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நெடு","tr":"neṭu"},{"kind":"nirai","text":"வரைக்","tr":"varaik"}]},{"text":"கவாஅற்","tr":"kavāaṟ","foot":"puḷimā","acai":[{"kind":"