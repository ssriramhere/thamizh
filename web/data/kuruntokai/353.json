ountain slope"}],"gloss":"mountain slope"},{"surface":"பகல்","parts":[{"text":"பகல்","lemma":"pakal","gloss":"daytime"}],"gloss":"daytime"},{"surface":"ஏ","parts":[{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"indeed"}]},{"words":[{"surface":"பாடு","parts":[{"text":"பாடு","lemma":"pāṭu","gloss":"sound"}],"gloss":"sound"},{"surface":"இன்","parts":[{"text":"இன்","lemma":"iṉ","gloss":"sweet"}],"gloss":"sweet"},{"surface":"அருவி","parts":[{"text":"அருவி","lemma":"aruvi","gloss":"waterfall"}],"gloss":"waterfall"},{"surface":"ஆடுதல்","parts":[{"text":"ஆடு","lemma":"āṭu","gloss":"to bathe"},{"text":"தல்","lemma":"tal","gloss":"verbal noun suffix"}],"gloss":"bathing"},{"surface":"இனிது","parts":[{"text":"இனி","lemma":"iṉi","gloss":"sweet"},{"text":"து","lemma":"tu","gloss":"pronominal suffix"}],"gloss":"is sweet"},{"surface":"ஏ","parts":[{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"indeed"}]},{"words":[{"surface":"நிரை","parts":[{"text":"நிரை","lemma":"nirai","gloss":"row"}],"gloss":"row"},{"surface":"இதழ்","parts":[{"text":"இதழ்","lemma":"itaḻ","gloss":"eyelid"}],"gloss":"eyelid"},{"surface":"பொருந்தா","parts":[{"text":"பொருந்து","lemma":"poruntu","gloss":"to close"},{"text":"ஆ","lemma":"ā","gloss":"negative relative participle"}],"gloss":"not closing"},{"surface":"கண்","parts":[{"text":"கண்","lemma":"kaṇ","gloss":"eye"}],"gloss":"eye"},{"surface":"ஓடு","parts":[{"text":"ஓடு","lemma":"ōṭu","gloss":"with"}],"gloss":"with"},{"surface":"இரவில்","parts":[{"text":"இரவு","lemma":"iravu","gloss":"night"},{"text":"இல்","lemma":"il","gloss":"locative suffix"}],"gloss":"at night"}]},{"words":[{"surface":"பஞ்சி","parts":[{"text":"பஞ்சி","lemma":"pañci","gloss":"cotton"}],"gloss":"cotton"},{"surface":"வெண்","parts":[{"text":"வெண்","lemma":"veṇ","gloss":"white"}],"gloss":"white"},{"surface":"திரி","parts":[{"text":"திரி","lemma":"tiri","gloss":"wick"}],"gloss":"wick"},{"surface":"செம்","parts":[{"text":"செம்","lemma":"cem","gloss":"red"}],"gloss":"red"},{"surface":"சுடர்","parts":[{"text":"சுடர்","lemma":"cuṭar","gloss":"flame"}],"gloss":"flame"},{"surface":"நல்","parts":[{"text":"நல்","lemma":"nal","gloss":"good"}],"gloss":"good"},{"surface":"இல்","parts":[{"text":"இல்","lemma":"il","gloss":"house"}],"gloss":"house"}]},{"words":[{"surface":"பின்னு","parts":[{"text":"பின்னு","lemma":"piṉṉu","gloss":"braid"}],"gloss":"braid"},{"surface":"வீழ்","parts":[{"text":"வீழ்","lemma":"vīḻ","gloss":"falling"}],"gloss":"falling"},{"surface":"சிறுபுறம்","parts":[{"text":"சிறு","lemma":"ciṟu","gloss":"small"},{"text":"புறம்","lemma":"puṟam","gloss":"back"}],"gloss":"small back"},{"surface":"தழீஇ","parts":[{"text":"தழீஇ","lemma":"தழீஇ","gloss":"embracing"}],"gloss":"embracing","split_unverified":true}]},{"words":[{"surface":"அன்னை","parts":[{"text":"அன்னை","lemma":"aṉṉai","gloss":"mother"}],"gloss":"mother"},{"surface":"முயங்க","parts":[{"text":"முயங்கு","lemma":"muyaṅku","gloss":"to embrace"},{"text":"அ","lemma":"a","gloss":"infinitive suffix"}],"gloss":"to embrace"},{"surface":"துயில்","parts":[{"text":"துயில்","lemma":"tuyil","gloss":"sleep"}],"gloss":"sleep"},{"surface":"இன்னாது","parts":[{"text":"இன்னாது","lemma":"iṉṉātu","gloss":"unpleasant"}],"gloss":"is unpleasant"},{"surface":"ஏ","parts":[{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"indeed"}]}],"literal":"Of the roaring-waterfall mountain lord, chest as a raft / on the high-peaked long mountain slope, in the daytime / bathing in the sweet-sounding waterfall is sweet. / With eyes whose rows of eyelids do not close, at night, / in the good house with red flames on white cotton wicks, / embracing the small back where the braided hair falls, / when mother embraces, sleep is unpleasant.","translation":"During the day, on the slopes of the high-peaked, towering mountain, it is sweet to bathe in the sweet-sounding waterfall, using the chest of the lord of the roaring-waterfall mountain as a raft. But at night, in the good house where red flames burn on white cotton wicks, with eyes whose eyelids do not close, sleep is bitter when mother embraces my small back where my braided hair falls.","modern":"ஒலிக்கும் அருவிகளையுடைய மலைநாட்டிற்குத் தலைவனுடைய மார்பினை மிதவையாகக் கொண்டு, உயர்ந்த சிகரங்களை உடைய நீண்ட மலையின் பக்கத்தே, பகல் பொழுதில், இனிய ஓசையையுடைய அருவியில் நீராடுவது இன்பமானது. ஆனால், இரவில், பருத்திப் பஞ்சினால் செய்த வெண்மையான திரியில் எரியும் சிவந்த சுடரையுடைய நல்ல இல்லத்தில், இமைகூடிப் பொருந்தாத கண்களோடு, பின்னப்பட்ட கூந்தல் தொங்கும் சிறிய முதுகினைத் தழுவிக்கொண்டு தாய் அணைத்துப் படுக்க, தூங்குவது துன்பமானதாகும்.","explanation":"This poem belongs to the Kuriñci tiṇai (mountain landscape) and is spoken by the heroine's friend (tōḻi) to the hero, who has been coming for secret night meetings. She contrasts the joy of their daytime encounters with the painful confinement of the night to urge him to marry the heroine soon. During the day, the lovers can freely bathe in the mountain waterfalls, with the hero's strong chest serving as a protective raft. At night, however, the heroine is kept inside her well-lit home, closely embraced by her mother. Her eyes remain wide open in sleepless longing for the hero, making her mother's loving embrace feel like a painful constraint. By highlighting this contrast, the friend subtly pressures the hero to end the clandestine meetings and seek a formal marriage.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,0.8],[0.8,1.3],[1.5,2.0],[2.0,2.3],[2.3,2.8],[2.8,3.0],[3.0,3.3],[3.3,4.6],[4.6,4.9],[4.9,5.0],[5.0,5.4],[5.4,6.48],[6.48,6.48],[6.48,6.48],[6.48,7.56],[7.83,8.1],[8.1,8.1],[8.1,9.9],[9.9,10.98],[10.98,11.1],[11.1,11.6],[11.6,11.86],[11.86,12.9],[12.9,13.3],[13.3,13.7],[13.7,13.8]],"female":[[0.0,0.6],[0.6,0.9],[0.9,1.76],[1.76,2.1],[2.1,2.7],[2.7,3.3],[3.76,3.87],[3.87,4.1],[4.1,5.2],[5.2,5.6],[5.6,5.6],[5.6,6.2],[6.2,6.2],[6.2,6.2],[6.2,6.2],[6.2,6.2],[6.2,6.2],[6.2,6.2],[6.2,6.2],[6.2,6.2],[6.2,12.2],[12.2,12.8],[12.8,12.9],[13.1,14.1],[14.1,14.53],[14.6,15.0],[15.0,15.1]]}}