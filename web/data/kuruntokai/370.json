{"text":"kuruntokai","n":370,"lines":["பொய்கை யாம்ப லணிநிறக் கொழுமுகை","வண்டுவாய் திறக்குந் தண்டுறை யூரனொடு","இருப்பி னிருமருங் கினமே கிடப்பின்","வில்லக விரலிற் பொருந்தியவன்","நல்லகஞ் சேரி னொருமருங் கினமே"],"tr":["poykai yāmpa laṇiniṟak koḻumukai","vaṇṭuvāy tiṟakkun taṇṭuṟai yūraṉoṭu","iruppi ṉirumaruṅ kiṉamē kiṭappiṉ","villaka viraliṟ poruntiyavaṉ","nallakañ cēri ṉorumaruṅ kiṉamē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"பரத்தை கூற்று","poet_ta":"வில்லகவிரலினார்","speaker_en":"the courtesan (parattai)","poet_tr":"Villakaviraliṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 9, āciriyattaḷai 8, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பொய்கை","tr":"poykai","foot":"tēmā","acai":[{"kind":"nēr","text":"பொய்","tr":"poy"},{"kind":"nēr","text":"கை","tr":"kai"}]},{"text":"யாம்ப","tr":"yāmpa","foot":"tēmā","acai":[{"kind":"nēr","text":"யாம்","tr":"yām"},{"kind":"nēr","text":"ப","tr":"pa"}]},{"text":"லணிநிறக்","tr":"laṇiniṟak","foot":"karuviḷam","acai":[{"kind":"nirai","text":"லணி","tr":"laṇi"},{"kind":"nirai","text":"நிறக்","tr":"niṟak"}]},{"text":"கொழுமுகை","tr":"koḻumukai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கொழு","tr":"koḻu"},{"kind":"nirai","text":"முகை","tr":"mukai"}]}],[{"text":"வண்டுவாய்","tr":"vaṇṭuvāy","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வண்","tr":"vaṇ"},{"kind":"nirai","text":"டுவாய்","tr":"ṭuvāy"}]},{"text":"திறக்குந்","tr":"tiṟakkun","foot":"puḷimā","acai":[{"kind":"nirai","text":"திறக்","tr":"tiṟak"},{"kind":"nēr","text":"குந்","tr":"kun"}]},{"text":"தண்டுறை","tr":"taṇṭuṟai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தண்","tr":"taṇ"},{"kind":"nirai","text":"டுறை","tr":"ṭuṟai"}]},{"text":"யூரனொடு","tr":"yūraṉoṭu","foot":"kūviḷa