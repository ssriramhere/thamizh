{"text":"kuruntokai","n":69,"lines":["கருங்கண் தாக்கலை பெரும்பிறி துற்றெனக்","கைம்மை உய்யாக் காமர் மந்தி","கல்லா வன்பறழ் கிளைமுதற் சேர்த்தி","ஓங்குவரை அடுக்கத்துப் பாய்ந்துயிர் செகுக்கும்","சாரல் நாட நடுநாள்","வாரல் வாழியோ வருந்துதும் யாமே"],"tr":["karuṅkaṇ tākkalai perumpiṟi tuṟṟeṉak","kaimmai uyyāk kāmar manti","kallā vaṉpaṟaḻ kiḷaimutaṟ cērtti","ōṅkuvarai aṭukkattup pāyntuyir cekukkum","cāral nāṭa naṭunāḷ","vāral vāḻiyō varuntutum yāmē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"கடுந்தோட் கரவீரனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kaṭuntōṭ Karavīraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 6, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கருங்கண்","tr":"karuṅkaṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கருங்","tr":"karuṅ"},{"kind":"nēr","text":"கண்","tr":"kaṇ"}]},{"text":"தாக்கலை","tr":"tākkalai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தாக்","tr":"tāk"},{"kind":"nirai","text":"கலை","tr":"kalai"}]},{"text":"பெரும்பிறி","tr":"perumpiṟi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெரும்","tr":"perum"},{"kind":"nirai","text":"பிறி","tr":"piṟi"}]},{"text":"துற்றெனக்","tr":"tuṟṟeṉak","foot":"kūviḷam","acai":[{"kind":"nēr","text":"துற்","tr":"tuṟ"},{"kind":"nirai","text":"றெனக்","tr":"ṟeṉak"}]}],[{"text":"கைம்மை","tr":"kaimmai","foot":"tēmā","acai":[{"kind":"nēr","text":"கைம்","tr":"kaim"},{"kind":"nēr","text":"மை","tr":"mai"}]},{"text":"உய்யாக்","tr":"uyyāk","foot":"tēmā","acai":[{"kind":"nēr","text":"உய்","tr":"uy"},{"kind":"nēr","text":"யாக்","tr":"yāk"}]},{"text":"காமர்","tr":"kāmar","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"மர்","tr":"mar"}]},{"