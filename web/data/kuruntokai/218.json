{"text":"kuruntokai","n":218,"lines":["விடர்முகை யடுக்கத்து விறல்கெழு சூலிக்குக்","கடனும் பூணாங் கைந்நூல் யாவாம்","புள்ளும் ஓராம் விரிச்சியு நில்லாம்","உள்ளலு முள்ளா மன்றே தோழி","உயிர்க்குயிர் அன்ன ராகலிற் றம்மின்","றிமைப்புவரை யமையா நம்வயின்","மறந்தாண் டமைதல் வல்லியோர் மாட்டே"],"tr":["viṭarmukai yaṭukkattu viṟalkeḻu cūlikkuk","kaṭaṉum pūṇāṅ kainnūl yāvām","puḷḷum ōrām viricciyu nillām","uḷḷalu muḷḷā maṉṟē tōḻi","uyirkkuyir aṉṉa rākaliṟ ṟammiṉ","ṟimaippuvarai yamaiyā namvayiṉ","maṟantāṇ ṭamaital valliyōr māṭṭē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"கொற்றனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Koṟṟaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 24, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 10, kalittaḷai 3"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"விடர்முகை","tr":"viṭarmukai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விடர்","tr":"viṭar"},{"kind":"nirai","text":"முகை","tr":"mukai"}]},{"text":"யடுக்கத்து","tr":"yaṭukkattu","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"யடுக்","tr":"yaṭuk"},{"kind":"nēr","text":"கத்","tr":"kat"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"விறல்கெழு","tr":"viṟalkeḻu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விறல்","tr":"viṟal"},{"kind":"nirai","text":"கெழு","tr":"keḻu"}]},{"text":"சூலிக்குக்","tr":"cūlikkuk","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"சூ","tr":"cū"},{"kind":"nēr","text":"லிக்","tr":"lik"},{"kind":"nēr","text":"குக்","tr":"kuk"}]}],[{"text":"கடனும்","tr":"kaṭaṉum","foot":"puḷimā","acai":[{"kind":"nirai","text":"கட","tr":"kaṭa"},{"kind":"nēr","text":"னும்","tr":"ṉum"}]},{"text":"பூணாங்","tr":"pūṇāṅ","foot":"tēmā","acai":[{"kind":"nēr","text":"பூ","tr":"pū"},{"kind":"nēr","text":"ணாங்","tr