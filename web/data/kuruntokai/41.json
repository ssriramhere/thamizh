{"text":"kuruntokai","n":41,"lines":["காதலர் உழைய ராகப் பெரிதுவந்து","சாறுகொ ளூரிற் புகல்வேன் மன்ற","அத்த நண்ணிய அங்குடிச் சீறூர்","மக்கள் போகிய அணிலாடு முன்றிற்","புலம்பில் போலப் புல்லென்று","அலப்பென் தோழியவர் அகன்ற ஞான்றே"],"tr":["kātalar uḻaiya rākap perituvantu","cāṟuko ḷūriṟ pukalvēṉ maṉṟa","atta naṇṇiya aṅkuṭic cīṟūr","makkaḷ pōkiya aṇilāṭu muṉṟiṟ","pulampil pōlap pulleṉṟu","alappeṉ tōḻiyavar akaṉṟa ñāṉṟē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"அணிலாடு முன்றிலார்","speaker_en":"the heroine (talaivi)","poet_tr":"Aṇilāṭu Muṉṟilār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 8, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"காதலர்","tr":"kātalar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"தலர்","tr":"talar"}]},{"text":"உழைய","tr":"uḻaiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"உழை","tr":"uḻai"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"ராகப்","tr":"rākap","foot":"tēmā","acai":[{"kind":"nēr","text":"ரா","tr":"rā"},{"kind":"nēr","text":"கப்","tr":"kap"}]},{"text":"பெரிதுவந்து","tr":"perituvantu","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"பெரி","tr":"peri"},{"kind":"nirai","text":"துவந்","tr":"tuvan"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"சாறுகொ","tr":"cāṟuko","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சா","tr":"cā"},{"kind":"nirai","text":"றுகொ","tr":"ṟuko"}]},{"text":"ளூரிற்","tr":"ḷūriṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"ளூ","tr":"ḷū"},{"kind":"nēr","text":"ரிற்","tr":"riṟ"}]},{"text":"புகல்வேன்","tr":"pukalvēṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"புகல்","tr":"pukal"},{"kind":"nēr","text":"வேன்","tr":"vēṉ"}]},{"text":"ம