d":"nēr","text":"வர்","tr":"var"}]},{"text":"அகன்ற","tr":"akaṉṟa","foot":"puḷimā","acai":[{"kind":"nirai","text":"அகன்","tr":"akaṉ"},{"kind":"nēr","text":"ற","tr":"ṟa"}]},{"text":"ஞான்றே","tr":"ñāṉṟē","foot":"tēmā","acai":[{"kind":"nēr","text":"ஞான்","tr":"ñāṉ"},{"kind":"nēr","text":"றே","tr":"ṟē"}]}]]},"ai":{"lines":[{"words":[{"surface":"காதலர்","parts":[{"text":"காதலர்","lemma":"காதலர்","gloss":"lover"}],"gloss":"lover"},{"surface":"உழையர்","parts":[{"text":"உழையர்","lemma":"உழையர்","gloss":"nearby"}],"gloss":"being nearby"},{"surface":"ஆக","parts":[{"text":"ஆக","lemma":"ஆகு","gloss":"to be"}],"gloss":"as they are"},{"surface":"பெரிது","parts":[{"text":"பெரிது","lemma":"பெரிது","gloss":"greatly"}],"gloss":"greatly"},{"surface":"உவந்து","parts":[{"text":"உவந்து","lemma":"உவ","gloss":"rejoiced"}],"gloss":"rejoicing"}]},{"words":[{"surface":"சாறு","parts":[{"text":"சாறு","lemma":"சாறு","gloss":"festival"}],"gloss":"festival"},{"surface":"கொள்","parts":[{"text":"கொள்","lemma":"கொள்","gloss":"having"}],"gloss":"celebrating"},{"surface":"ஊரில்","parts":[{"text":"ஊரில்","lemma":"ஊர்","gloss":"town"}],"gloss":"in the town"},{"surface":"புகல்வேன்","parts":[{"text":"புகல்வேன்","lemma":"புகல்","gloss":"I will rejoice"}],"gloss":"I will rejoice"},{"surface":"மன்ற","parts":[{"text":"மன்ற","lemma":"மன்ற","gloss":"surely"}],"gloss":"surely"}]},{"words":[{"surface":"அத்தம்","parts":[{"text":"அத்தம்","lemma":"அத்தம்","gloss":"desert path"}],"gloss":"desert path"},{"surface":"நண்ணிய","parts":[{"text":"நண்ணிய","lemma":"நண்ணு","gloss":"approached"}],"gloss":"near to"},{"surface":"அம்","parts":[{"text":"அம்","lemma":"அம்","gloss":"beautiful"}],"gloss":"beautiful"},{"surface":"குடி","parts":[{"text":"குடி","lemma":"குடி","gloss":"homes"}],"gloss":"homes"},{"surface":"சீறூர்","parts":[{"text":"சீறூர்","lemma":"சீறூர்","gloss":"small village"}],"gloss":"small village"}]},{"words":[{"surface":"மக்கள்","parts":[{"text":"மக்கள்","lemma":"மக்கள்","gloss":"people"}],"gloss":"people"},{"surface":"போகிய","parts":[{"text":"போகிய","lemma":"போ","gloss":"who went"}],"gloss":"who have left"},{"surface":"அணில்","parts":[{"text":"அணில்","lemma":"அணில்","gloss":"squirrel"}],"gloss":"squirrel"},{"surface":"ஆடு","parts":[{"text":"ஆடு","lemma":"ஆடு","gloss":"playing"}],"gloss":"playing"},{"surface":"முன்றில்","parts":[{"text":"முன்றில்","lemma":"முன்றில்","gloss":"front yard"}],"gloss":"front yard"}]},{"words":[{"surface":"புலம்பு","parts":[{"text":"புலம்பு","lemma":"புலம்பு","gloss":"loneliness"}],"gloss":"lonely"},{"surface":"இல்","parts":[{"text":"இல்","lemma":"இல்","gloss":"house"}],"gloss":"house"},{"surface":"போல","parts":[{"text":"போல","lemma":"போல","gloss":"like"}],"gloss":"like"},{"surface":"புல்லென்று","parts":[{"text":"புல்","lemma":"புல்","gloss":"bare"},{"text":"என்று","lemma":"என்","gloss":"being"}],"gloss":"being desolate"}]},{"words":[{"surface":"அலப்பென்","parts":[{"text":"அலப்பென்","lemma":"அலப்பு","gloss":"I will suffer"}],"gloss":"I will suffer"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"தோழி","gloss":"friend"}],"gloss":"friend"},{"surface":"அவர்","parts":[{"text":"அவர்","lemma":"அவர்","gloss":"he"}],"gloss":"he"},{"surface":"அகன்ற","parts":[{"text":"அகன்ற","lemma":"அகல்","gloss":"departed"}],"gloss":"departed"},{"surface":"ஞான்றே","parts":[{"text":"ஞான்றே","lemma":"ஞான்று","gloss":"day"}],"gloss":"on the very day"}]}],"literal":"Lover being nearby, greatly rejoicing / surely I will rejoice like a town celebrating a festival / in the small village of beautiful homes near the desert path / where people have left and squirrels play in the front yard / like that lonely house, becoming desolate / I will suffer, my friend, on the day he departed.","translation":"When my lover is by my side, I rejoice greatly, like a town celebrating a festival. But on the day he departs, my friend, I will suffer and become desolate, like a lonely house in a small, beautiful hamlet near the desert path, from which all the people have gone and only squirrels play in the front yard.","modern":"என் காதலர் என்னுடன் இருக்கும்போது, திருவிழா கொண்டாடும் ஊரைப் போல நான் மிகவும் மகிழ்ச்சி அடைவேன் என்பது உறுதி. ஆனால் தோழியே! அவர் என்னை விட்டுப் பிரிந்து சென்ற நாளில், பாலைவனப் பாதையை ஒட்டியுள்ள அழகான வீடுகளைக் கொண்ட அந்தச் சிறிய ஊரில், மக்கள் அனைவரும் வெளியேறிவிட்டதால், அணில்கள் மட்டுமே விளையாடும் முற்றம் கொண்ட தனிமையான வீட்டைப் போல, நான் வறுமையும் தனிமையும் அடைந்து வருந்துவேன்.","explanation":"The heroine is speaking to her close friend about her anxiety regarding the hero's impending departure. She explains that when her lover is with her, her heart is as joyful and lively as a town celebrating a grand festival. However, once he leaves to travel through the harsh desert path, her life will lose all its joy. She compares her future state of separation to a lonely, abandoned house in a small desert-bordering village where all the residents have migrated, leaving only squirrels to play in the empty front yard. This vivid image of the 'squirrel-played front yard' perfectly captures the desolation of the Pālai landscape and the heroine's profound loneliness.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.8],[0.8,0.93],[0.93,1.5],[1.5,2.0],[2.0,3.42],[3.42,3.8],[3.8,4.2],[4.2,4.4],[4.4,4.8],[4.8,5.33],[5.33,6.0],[6.0,7.0],[7.0,8.5],[8.5,8.8],[8.8,9.2],[9.2,9.65],[9.65,9.8],[9.8,11.5],[11.5,11.9],[11.9,12.72],[12.72,13.54],[13.54,14.2],[14.2,14.45]],"female":[[0.0,0.8],[0.8,0.93],[0.93,1.6],[1.6,2.2],[2.2,3.14],[3.83,4.1],[4.1,4.7],[4.7,4.9],[4.9,5.77],[5.77,6.2],[6.2,6.9],[7.13,7.6],[7.6,8.9],[8.9,9.2],[9.2,9.7],[9.7,10.15],[10.15,10.3],[10.3,12.3],[12.3,12.7],[12.7,14.3],[14.3,14.9],[14.94,15.4],[15.4,15.75]]},"sync":[[["காதலர்","lover"]],[["உழையர்","being nearby"]],[["உழையர்","being nearby"],["ஆக","as they are"]],[["பெரிது","greatly"],["உவந்து","rejoicing"]],[["சாறு","festival"],["கொள்","celebrating"]],[["கொள்","celebrating"],["ஊரில்","in the town"]],[["புகல்வேன்","I will rejoice"]],[["மன்ற","surely"]],[["அத்தம்","desert path"]],[["நண்ணிய","near to"]],[["அம்","beautiful"],["குடி","homes"],["சீறூர்","small village"]],[["சீறூர்","small village"]],[["மக்கள்","people"]],[["போகிய","who have left"]],[["அணில்","squirrel"],["ஆடு","playing"]],[["முன்றில்","front yard"]],[["புலம்பு","lonely"],["இல்","house"]],[["போல","like"]],[["புல்லென்று","being desolate"]],[["அலப்பென்","I will suffer"]],[["தோழி","friend"],["அவர்","he"]],[["அகன்ற","departed"]],[["ஞான்றே","on the very day"]]]}