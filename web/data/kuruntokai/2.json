{"text":"kuruntokai","n":2,"lines":["கொங்குதேர் வாழ்க்கை அஞ்சிறைத் தும்பி","காமம் செப்பாது கண்டது மொழிமோ","பயிலியது கெழீஇய நட்பின் மயிலியல்","செறியெயிற் றரிவை கூந்தலின்","நறியவும் உளவோ நீயறியும் பூவே"],"tr":["koṅkutēr vāḻkkai añciṟait tumpi","kāmam ceppātu kaṇṭatu moḻimō","payiliyatu keḻīiya naṭpiṉ mayiliyal","ceṟiyeyiṟ ṟarivai kūntaliṉ","naṟiyavum uḷavō nīyaṟiyum pūvē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"இறையனார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Iṟaiyaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 16, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 7, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கொங்குதேர்","tr":"koṅkutēr","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கொங்","tr":"koṅ"},{"kind":"nirai","text":"குதேர்","tr":"kutēr"}]},{"text":"வாழ்க்கை","tr":"vāḻkkai","foot":"tēmā","acai":[{"kind":"nēr","text":"வாழ்க்","tr":"vāḻk"},{"kind":"nēr","text":"கை","tr":"kai"}]},{"text":"அஞ்சிறைத்","tr":"añciṟait","foot":"kūviḷam","acai":[{"kind":"nēr","text":"அஞ்","tr":"añ"},{"kind":"nirai","text":"சிறைத்","tr":"ciṟait"}]},{"text":"தும்பி","tr":"tumpi","foot":"tēmā","acai":[{"kind":"nēr","text":"தும்","tr":"tum"},{"kind":"nēr","text":"பி","tr":"pi"}]}],[{"text":"காமம்","tr":"kāmam","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"மம்","tr":"mam"}]},{"text":"செப்பாது","tr":"ceppātu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"செப்","tr":"cep"},{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"கண்டது","tr":"kaṇṭatu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கண்","tr":"kaṇ"},{"kind":"nirai","text":"டது","tr":"ṭatu"}]},{"text":"மொழிமோ","tr":"moḻimō","foot":"puḷimā","acai":[{"kind":"nira