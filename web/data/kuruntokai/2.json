்கை","lemma":"வாழ்க்கை","gloss":"livelihood"}],"gloss":"livelihood"},{"surface":"அஞ்சிறை","parts":[{"text":"அம்","lemma":"அம்","gloss":"beautiful"},{"text":"சிறை","lemma":"சிறை","gloss":"wing"}],"gloss":"beautiful-winged"},{"surface":"தும்பி","parts":[{"text":"தும்பி","lemma":"தும்பி","gloss":"bee"}],"gloss":"bee"}]},{"words":[{"surface":"காமம்","parts":[{"text":"காமம்","lemma":"காமம்","gloss":"bias"}],"gloss":"bias"},{"surface":"செப்பாது","parts":[{"text":"செப்பாது","lemma":"செப்பு","gloss":"without speaking"}],"gloss":"without speaking"},{"surface":"கண்டது","parts":[{"text":"கண்டது","lemma":"காண்","gloss":"what was seen"}],"gloss":"what was seen"},{"surface":"மொழிமோ","parts":[{"text":"மொழி","lemma":"மொழி","gloss":"speak"},{"text":"மோ","lemma":"மோ","gloss":"request particle"}],"gloss":"please speak"}]},{"words":[{"surface":"பயிலியது","parts":[{"text":"பயிலியது","lemma":"பயில்","gloss":"long-standing"}],"gloss":"long-standing"},{"surface":"கெழீஇய","parts":[{"text":"கெழீஇய","lemma":"கெழுவு","gloss":"intimate"}],"gloss":"intimate"},{"surface":"நட்பின்","parts":[{"text":"நட்பு","lemma":"நட்பு","gloss":"friendship"},{"text":"இன்","lemma":"இன்","gloss":"of"}],"gloss":"of friendship"},{"surface":"மயில்","parts":[{"text":"மயில்","lemma":"மயில்","gloss":"peacock"}],"gloss":"peacock"},{"surface":"இயல்","parts":[{"text":"இயல்","lemma":"இயல்","gloss":"nature"}],"gloss":"nature"}]},{"words":[{"surface":"செறியெயிற்","parts":[{"text":"செறியெயிற்","lemma":"செறியெயிற்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"றரிவை","parts":[{"text":"றரிவை","lemma":"றரிவை","gloss":""}],"gloss":"","split_unverified":true},{"surface":"கூந்தலின்","parts":[{"text":"கூந்தலின்","lemma":"கூந்தலின்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"நறியவும்","parts":[{"text":"நறிய","lemma":"நறிது","gloss":"fragrant things"},{"text":"உம்","lemma":"உம்","gloss":"also"}],"gloss":"fragrant things also"},{"surface":"உளவோ","parts":[{"text":"உள","lemma":"உளது","gloss":"exist"},{"text":"ஓ","lemma":"ஓ","gloss":"question marker"}],"gloss":"do they exist?"},{"surface":"நீ","parts":[{"text":"நீ","lemma":"நீ","gloss":"you"}],"gloss":"you"},{"surface":"அறியும்","parts":[{"text":"அறியும்","lemma":"அறி","gloss":"knowing"}],"gloss":"that you know"},{"surface":"பூவே","parts":[{"text":"பூ","lemma":"பூ","gloss":"flower"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"among the flowers"}]}],"literal":"Pollen-seeking livelihood beautiful-winged bee! / Bias without-speaking what-was-seen please-tell! / Long-standing intimate of-friendship peacock nature / close-set teeth young-woman than-the-tresses / fragrant-things-also do-they-exist you-knowing among-flowers?","translation":"O bee with beautiful wings, whose life is spent seeking pollen! Do not speak out of partiality to me, but tell me only what you have truly seen. Among all the flowers you know, is there any that is more fragrant than the tresses of this young woman of peacock-like grace, with close-set teeth, with whom I share a deep, long-standing love?","modern":"தேன் தேடி வாழும் அழகிய சிறகுகளை உடைய வண்டே! என் மீதுள்ள விருப்பத்தால் பொய் கூறாமல், நீ கண்ட உண்மையை மட்டும் சொல்வாயாக. நீண்ட நாள் பழகிய நெருங்கிய அன்பையும், மயில் போன்ற மென்மையான இயல்பையும், நெருக்கமான பற்களையும் உடைய என் தலைவியின் கூந்தலை விட நறுமணம் மிக்க மலர்கள் நீ அறிந்த பூக்களுள் வேறு ஏதேனும் உண்டோ?","explanation":"This poem is set in the Kurinji (mountainous) landscape, belonging to the theme of union and love. The hero is addressing a bee in the presence of his beloved, who is standing nearby. He praises her beauty and the natural fragrance of her hair, asking the bee if any flower it knows is more fragrant than her tresses. By asking the bee to speak without bias, he playfully seeks confirmation of his beloved's unmatched beauty and sweetness. The imagery of the pollen-seeking bee and the peacock-like grace of the heroine perfectly evokes the lush, fertile mountain landscape of Kurinji, symbolizing the intimacy and natural beauty of their love. Key words include 'தும்பி' (bee), 'கூந்தல்' (tresses), and 'நட்பு' (love/friendship).","model":"gemini-3.5-flash"}}