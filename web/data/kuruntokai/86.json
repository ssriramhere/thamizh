":"nirai","text":"கொடு","tr":"koṭu"},{"kind":"nirai","text":"மணி","tr":"maṇi"}]},{"text":"நல்கூர்","tr":"nalkūr","foot":"tēmā","acai":[{"kind":"nēr","text":"நல்","tr":"nal"},{"kind":"nēr","text":"கூர்","tr":"kūr"}]},{"text":"குரலே","tr":"kuralē","foot":"puḷimā","acai":[{"kind":"nirai","text":"குர","tr":"kura"},{"kind":"nēr","text":"லே","tr":"lē"}]}]]},"ai":{"lines":[{"words":[{"surface":"சிறைபனி","parts":[{"text":"சிறை","lemma":"சிறை","gloss":"restraint"},{"text":"பனி","lemma":"பனி","gloss":"dew/tears"}],"gloss":"restrained tears"},{"surface":"உடைந்த","parts":[{"text":"உடை","lemma":"உடை","gloss":"break"},{"text":"ந்","lemma":"ந்","gloss":"past tense infix"},{"text":"த்","lemma":"த்","gloss":"past tense marker"},{"text":"அ","lemma":"அ","gloss":"adjectival participle suffix"}],"gloss":"broken"},{"surface":"சேயரி","parts":[{"text":"சேய்","lemma":"சேய்","gloss":"redness"},{"text":"அரி","lemma":"அரி","gloss":"streaks"}],"gloss":"red-streaked"},{"surface":"மழைக்கண்","parts":[{"text":"மழை","lemma":"மழை","gloss":"rain/coolness"},{"text":"கண்","lemma":"கண்","gloss":"eye"}],"gloss":"cool rain-like eyes"}]},{"words":[{"surface":"பொறையரு","parts":[{"text":"பொறை","lemma":"பொறை","gloss":"bearing/enduring"},{"text":"அரு","lemma":"அரு","gloss":"difficult"}],"gloss":"difficult to bear"},{"surface":"நோயொடு","parts":[{"text":"நோய்","lemma":"நோய்","gloss":"affliction"},{"text":"ஒடு","lemma":"ஒடு","gloss":"with"}],"gloss":"with the affliction"},{"surface":"புலம்பலை","parts":[{"text":"புலம்பல்","lemma":"புலம்பல்","gloss":"loneliness"},{"text":"ஐ","lemma":"ஐ","gloss":"accusative case marker"}],"gloss":"loneliness"},{"surface":"கலங்கி","parts":[{"text":"கலங்கு","lemma":"கலங்கு","gloss":"be distressed"},{"text":"இ","lemma":"இ","gloss":"verbal participle suffix"}],"gloss":"having been distressed"}]},{"words":[{"surface":"பிறரும்","parts":[{"text":"பிறர்","lemma":"பிறர்","gloss":"others"},{"text":"உம்","lemma":"உம்","gloss":"also"}],"gloss":"others also"},{"surface":"கேட்குநர்","parts":[{"tex