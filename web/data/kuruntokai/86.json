{"text":"kuruntokai","n":86,"lines":["சிறைபனி உடைந்த சேயரி மழைக்கண்","பொறையரு நோயொடு புலம்பலைக் கலங்கிப்","பிறருங் கேட்குநர் உளர்கொல் உறைசிறந்து","ஊதை தூற்றம் கூதிர் யாமத்து","ஆனுளம் புலம்புதொ றுளம்பும்","நாநவில் கொடுமணி நல்கூர் குரலே"],"tr":["ciṟaipaṉi uṭainta cēyari maḻaikkaṇ","poṟaiyaru nōyoṭu pulampalaik kalaṅkip","piṟaruṅ kēṭkunar uḷarkol uṟaiciṟantu","ūtai tūṟṟam kūtir yāmattu","āṉuḷam pulamputo ṟuḷampum","nānavil koṭumaṇi nalkūr kuralē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"வெண்கொற்றனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Veṇkoṟṟaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"சிறைபனி","tr":"ciṟaipaṉi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சிறை","tr":"ciṟai"},{"kind":"nirai","text":"பனி","tr":"paṉi"}]},{"text":"உடைந்த","tr":"uṭainta","foot":"puḷimā","acai":[{"kind":"nirai","text":"உடைந்","tr":"uṭain"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"சேயரி","tr":"cēyari","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சே","tr":"cē"},{"kind":"nirai","text":"யரி","tr":"yari"}]},{"text":"மழைக்கண்","tr":"maḻaikkaṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மழைக்","tr":"maḻaik"},{"kind":"nēr","text":"கண்","tr":"kaṇ"}]}],[{"text":"பொறையரு","tr":"poṟaiyaru","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பொறை","tr":"poṟai"},{"kind":"nirai","text":"யரு","tr":"yaru"}]},{"text":"நோயொடு","tr":"nōyoṭu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நோ","tr":"nō"},{"kind":"nirai","text":"யொடு","tr":"yoṭu"}]},{"text":"புலம்பலைக்","tr":"pulampalaik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"புலம்","tr":"pulam"},{"kind":"nirai","text":"பலைக்","tr":"pal