{"text":"kuruntokai","n":379,"lines":["இன்றியாண் டையனோ தோழி குன்றத்துப்","பழங்குழி அகழ்ந்த கானவன் கிழங்கினொடு","கண்ணகன் தூமணி பெறூஉம் நாடன்","அறிவுகாழ்க் கொள்ளும் அளவைச் செறிதொடி","எம்மில் வருகுவை நீயெனப்","பொம்மல் ஓதி நீவி யோனே"],"tr":["iṉṟiyāṇ ṭaiyaṉō tōḻi kuṉṟattup","paḻaṅkuḻi akaḻnta kāṉavaṉ kiḻaṅkiṉoṭu","kaṇṇakaṉ tūmaṇi peṟūum nāṭaṉ","aṟivukāḻk koḷḷum aḷavaic ceṟitoṭi","emmil varukuvai nīyeṉap","pommal ōti nīvi yōṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","speaker_en":"her friend (tōḻi)"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 12, āciriyattaḷai 9, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இன்றியாண்","tr":"iṉṟiyāṇ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"இன்","tr":"iṉ"},{"kind":"nirai","text":"றியாண்","tr":"ṟiyāṇ"}]},{"text":"டையனோ","tr":"ṭaiyaṉō","foot":"kūviḷam","acai":[{"kind":"nēr","text":"டை","tr":"ṭai"},{"kind":"nirai","text":"யனோ","tr":"yaṉō"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"குன்றத்துப்","tr":"kuṉṟattup","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"குன்","tr":"kuṉ"},{"kind":"nēr","text":"றத்","tr":"ṟat"},{"kind":"nēr","text":"துப்","tr":"tup"}]}],[{"text":"பழங்குழி","tr":"paḻaṅkuḻi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பழங்","tr":"paḻaṅ"},{"kind":"nirai","text":"குழி","tr":"kuḻi"}]},{"text":"அகழ்ந்த","tr":"akaḻnta","foot":"puḷimā","acai":[{"kind":"nirai","text":"அகழ்ந்","tr":"akaḻn"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"கானவன்","tr":"kāṉavaṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"னவன்","tr":"ṉavaṉ"}]},{"text":"கிழங்கினொடு","tr":"kiḻaṅkiṉoṭu","foot"