{"text":"kuruntokai","n":232,"lines":["உள்ளார் கொல்லோ தோழி உள்ளியும்","வாய்ப்புணர் வின்மையின் வாரார் கொல்லோ","மரற்புகா வருந்திய மாவெருத் திரலை","உரற்கா லியானை யொடித்துண் டெஞ்சிய","யாஅ வரிநிழல் துஞ்சும்","மாயிருஞ் சோலை மலையிறந் தோரே"],"tr":["uḷḷār kollō tōḻi uḷḷiyum","vāyppuṇar viṉmaiyiṉ vārār kollō","maraṟpukā varuntiya māverut tiralai","uraṟkā liyāṉai yoṭittuṇ ṭeñciya","yāa variniḻal tuñcum","māyiruñ cōlai malaiyiṟan tōrē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"ஊண் பித்தையார்","speaker_en":"her friend (tōḻi)","poet_tr":"Ūṇ Pittaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 14, āciriyattaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"உள்ளார்","tr":"uḷḷār","foot":"tēmā","acai":[{"kind":"nēr","text":"உள்","tr":"uḷ"},{"kind":"nēr","text":"ளார்","tr":"ḷār"}]},{"text":"கொல்லோ","tr":"kollō","foot":"tēmā","acai":[{"kind":"nēr","text":"கொல்","tr":"kol"},{"kind":"nēr","text":"லோ","tr":"lō"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"உள்ளியும்","tr":"uḷḷiyum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"உள்","tr":"uḷ"},{"kind":"nirai","text":"ளியும்","tr":"ḷiyum"}]}],[{"text":"வாய்ப்புணர்","tr":"vāyppuṇar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வாய்ப்","tr":"vāyp"},{"kind":"nirai","text":"புணர்","tr":"puṇar"}]},{"text":"வின்மையின்","tr":"viṉmaiyiṉ","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"வின்","tr":"viṉ"},{"kind":"nēr","text":"மை","tr":"mai"},{"kind":"nēr","text":"யின்","tr":"yiṉ"}]},{"text":"வாரார்","tr":"vārār","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ரார்","tr":"rār"}]},{"text":"கொல்லோ","tr":"kollō","foot":