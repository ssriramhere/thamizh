{"text":"kuruntokai","n":234,"lines":["சுடர்செல் வானஞ் சேப்பப் படர்கூர்ந்","தெல்லறு பொழுதின் முல்லை மலரும்","மாலை என்மனார் மயங்கி யோரே","குடுமிக் கோழி நெடுநக ரியம்பும்","பெரும்புலர் விடியலு மாலை","பகலும் மாலை துணையி லோர்க்கே"],"tr":["cuṭarcel vāṉañ cēppap paṭarkūrn","tellaṟu poḻutiṉ mullai malarum","mālai eṉmaṉār mayaṅki yōrē","kuṭumik kōḻi neṭunaka riyampum","perumpular viṭiyalu mālai","pakalum mālai tuṇaiyi lōrkkē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"மிளைப்பெருங் கந்தனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Miḷaipperuṅ Kantaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"சுடர்செல்","tr":"cuṭarcel","foot":"puḷimā","acai":[{"kind":"nirai","text":"சுடர்","tr":"cuṭar"},{"kind":"nēr","text":"செல்","tr":"cel"}]},{"text":"வானஞ்","tr":"vāṉañ","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"னஞ்","tr":"ṉañ"}]},{"text":"சேப்பப்","tr":"cēppap","foot":"tēmā","acai":[{"kind":"nēr","text":"சேப்","tr":"cēp"},{"kind":"nēr","text":"பப்","tr":"pap"}]},{"text":"படர்கூர்ந்","tr":"paṭarkūrn","foot":"puḷimā","acai":[{"kind":"nirai","text":"படர்","tr":"paṭar"},{"kind":"nēr","text":"கூர்ந்","tr":"kūrn"}]}],[{"text":"தெல்லறு","tr":"tellaṟu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தெல்","tr":"tel"},{"kind":"nirai","text":"லறு","tr":"laṟu"}]},{"text":"பொழுதின்","tr":"poḻutiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பொழு","tr":"poḻu"},{"kind":"nēr","text":"தின்","tr":"tiṉ"}]},{"text":"முல்லை","tr":"mullai","foot":"tēmā","acai":[{"kind":"nēr","text":"முல்","tr":"mul"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"மலரும்","tr":"malarum","foot":"puḷimā","acai":