text":"நோய்க்","tr":"nōyk"},{"kind":"nēr","text":"கே","tr":"kē"}]}]]},"ai":{"lines":[{"words":[{"surface":"கவலை","parts":[{"text":"கவலை","lemma":"kavalai","gloss":"forked paths"}],"gloss":"forked paths"},{"surface":"யாத்த","parts":[{"text":"யாத்த","lemma":"yātta","gloss":"bound"}],"gloss":"bound"},{"surface":"அவல","parts":[{"text":"அவல","lemma":"avala","gloss":"distressing"}],"gloss":"distressing"},{"surface":"நீள்","parts":[{"text":"நீள்","lemma":"nīḷ","gloss":"long"}],"gloss":"long"},{"surface":"இடை","parts":[{"text":"இடை","lemma":"iṭai","gloss":"path"}],"gloss":"path"}]},{"words":[{"surface":"சென்றோர்","parts":[{"text":"சென்றோர்","lemma":"ceṉṟōr","gloss":"he who went"}],"gloss":"he who went"},{"surface":"கொடுமை","parts":[{"text":"கொடுமை","lemma":"koṭumai","gloss":"cruelty"}],"gloss":"cruelty"},{"surface":"எற்றி","parts":[{"text":"எற்றி","lemma":"eṟṟi","gloss":"thinking of"}],"gloss":"thinking of"},{"surface":"துஞ்சா","parts":[{"text":"துஞ்சா","lemma":"tuñcā","gloss":"sleepless"}],"gloss":"sleepless"}]},{"words":[{"surface":"நோயினும்","parts":[{"text":"நோய்","lemma":"nōy","gloss":"pain"},{"text":"இன்","lemma":"iṉ","gloss":"than"},{"text":"உம்","lemma":"um","gloss":"even"}],"gloss":"even more than the pain"},{"surface":"நோய்","parts":[{"text":"நோய்","lemma":"nōy","gloss":"pain"}],"gloss":"painful"},{"surface":"ஆகின்றே","parts":[{"text":"ஆகு","lemma":"āku","gloss":"become"},{"text":"இன்று","lemma":"iṉṟu","gloss":"present tense marker"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"it becomes indeed"},{"surface":"கூவல்","parts":[{"text":"கூவல்","lemma":"kūval","gloss":"well"}],"gloss":"of the well"}]},{"words":[{"surface":"குராலான்","parts":[{"text":"குரால்","lemma":"kurāl","gloss":"brown owl"},{"text":"ஆன்","lemma":"āṉ","gloss":"by"}],"gloss":"by the brown owl"},{"surface":"படு","parts":[{"text":"படு","lemma":"paṭu","gloss":"suffer"}],"gloss":"suffered"},{"surface":"துயர்","parts":[{"text":"துயர்","lemma":"tuyar","gloss":"grief"}],"gloss":"grief"},{"surface":"இராவில்","parts":[{"text":"இராவில்","lemma":"இராவில்","gloss":"in the night"}],"gloss":"in the night","split_unverified":true},{"surface":"கண்ட","parts":[{"text":"கண்ட","lemma":"kaṇṭa","gloss":"seen"}],"gloss":"seen"}]},{"words":[{"surface":"உயர்திணை","parts":[{"text":"உயர்","lemma":"uyar","gloss":"high"},{"text":"திணை","lemma":"tiṇai","gloss":"class"}],"gloss":"noble class"},{"surface":"ஊமன்","parts":[{"text":"ஊமன்","lemma":"ūmaṉ","gloss":"mute person"}],"gloss":"mute person"},{"surface":"போல","parts":[{"text":"போல","lemma":"pōla","gloss":"like"}],"gloss":"like"}]},{"words":[{"surface":"துயர்","parts":[{"text":"துயர்","lemma":"tuyar","gloss":"grief"}],"gloss":"grief"},{"surface":"பொறுக்கல்லேன்","parts":[{"text":"பொறுக்கல்லேன்","lemma":"poṟukkallēṉ","gloss":"I cannot bear"}],"gloss":"I cannot bear"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"tōḻi","gloss":"friend"}],"gloss":"oh friend"},{"surface":"நோய்க்கே","parts":[{"text":"நோய்","lemma":"nōy","gloss":"pain"},{"text":"க்கு","lemma":"kku","gloss":"to"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"to this pain"}]}],"literal":"In the long path of distress bound with forked paths, / thinking of the cruelty of him who went, sleepless, / more than the pain, it becomes painful! Like the well's / brown owl's suffering seen in the night by a / noble mute person, / I cannot bear the grief, oh friend, of this pain!","translation":"Oh friend, this sleepless pain, born of thinking about the cruelty of him who went away through the long, distressing path of many forks, is more painful than any other pain! I cannot bear this grief, just like a noble mute person who witnesses the suffering of a brown owl trapped in a deep well during the night and is unable to tell anyone about it.","modern":"தோழி! பல கவர்பட்ட வழிகளைக் கொண்ட துன்பம் நிறைந்த நீண்ட வழியில் சென்ற நம் காதலரின் கொடுமையை நினைத்துத் தூங்காமல் வருந்தும் இந்த நோய், மற்ற எல்லா நோய்களைக் காட்டிலும் கொடிய நோயாக மாறுகிறது. கிணற்றின் உள்ளே விழுந்து பழுப்பு நிறக் கூகை படும் துன்பத்தை இரவில் கண்ட, பேச முடியாத உயர்ந்த மனிதனைப் போல, என்னால் இந்தத் துன்பத்தைத் தாங்கிக் கொள்ள முடியவில்லை.","explanation":"The heroine is speaking to her close friend during the difficult period of the hero's separation. The hero has gone on a long, arduous journey through the desert landscape, which is full of confusing, forked paths. The heroine is unable to sleep, constantly thinking about his cruelty in leaving her behind. She compares her helpless state to a noble mute person who witnesses a brown owl suffering inside a deep well at night. Just as the mute person feels intense compassion and distress but cannot speak or call for help, the heroine suffers silently from her unbearable grief, unable to express her pain to anyone.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,0.9],[0.9,1.3],[1.3,1.7],[1.9,2.4],[2.4,2.6],[2.7,3.1],[3.1,3.5],[3.5,4.33],[4.5,4.8],[4.96,5.3],[5.3,5.56],[5.56,6.18],[6.18,6.96],[7.05,7.6],[7.6,7.8],[7.8,8.49],[8.49,8.9],[8.9,9.3],[9.4,10.0],[10.2,10.4],[10.4,11.0],[11.0,11.2]],"female":[[0.0,0.6],[0.6,0.8],[0.8,1.3],[1.3,2.0],[2.0,2.8],[2.8,3.0],[3.12,3.6],[3.6,4.0],[4.0,4.68],[4.9,5.2],[5.36,5.7],[5.7,6.3],[6.3,7.1],[7.1,7.54],[7.54,8.03],[8.03,8.4],[8.4,9.21],[9.21,9.7],[9.7,10.1],[10.1,11.48],[11.48,11.8],[11.8,12.1],[12.1,12.3]]},"sync":[[["கவலை","forked paths"]],[["யாத்த","bound"]],[["அவல","distressing"]],[["நீள்","long"],["இடை","path"]],[["சென்றோர்","he who went"]],[["கொடுமை","cruelty"]],[["எற்றி","thinking of"]],[["துஞ்சா","sleepless"]],[["நோயினும்","even more than the pain"]],[["நோய்","painful"]],[["ஆகின்றே","it becomes indeed"]],[["கூவல்","of the well"]],[["குராலான்","by the brown owl"]],[["படு","suffered"],["துயர்","grief"]],[["இராவில்","in the night"]],[["கண்ட","seen"]],[["உயர்திணை","noble class"]],[["ஊமன்","mute person"]],[["போல","like"]],[["துயர்","grief"],["பொறுக்கல்லேன்","I cannot bear"]],[["பொறுக்கல்லேன்","I cannot bear"]],[["தோழி","oh friend"]],[["நோய்க்கே","to this pain"]]]}