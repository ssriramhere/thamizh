{"text":"kuruntokai","n":224,"lines":["கவலை யாத்த அவல நீளிடைச்","சென்றோர் கொடுமை யெற்றித் துஞ்சா","நோயினு நோயா கின்றே கூவற்","குராலான் படுதுயர் இராவிற் கண்ட","உயர்திணை ஊமன் போலத்","துயர்பொறுக் கல்லேன் தோழி நோய்க்கே"],"tr":["kavalai yātta avala nīḷiṭaic","ceṉṟōr koṭumai yeṟṟit tuñcā","nōyiṉu nōyā kiṉṟē kūvaṟ","kurālāṉ paṭutuyar irāviṟ kaṇṭa","uyartiṇai ūmaṉ pōlat","tuyarpoṟuk kallēṉ tōḻi nōykkē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"கூவன் மைந்தனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kūvaṉ Maintaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 10"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கவலை","tr":"kavalai","foot":"puḷimā","acai":[{"kind":"nirai","text":"கவ","tr":"kava"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"யாத்த","tr":"yātta","foot":"tēmā","acai":[{"kind":"nēr","text":"யாத்","tr":"yāt"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"அவல","tr":"avala","foot":"puḷimā","acai":[{"kind":"nirai","text":"அவ","tr":"ava"},{"kind":"nēr","text":"ல","tr":"la"}]},{"text":"நீளிடைச்","tr":"nīḷiṭaic","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nirai","text":"ளிடைச்","tr":"ḷiṭaic"}]}],[{"text":"சென்றோர்","tr":"ceṉṟōr","foot":"tēmā","acai":[{"kind":"nēr","text":"சென்","tr":"ceṉ"},{"kind":"nēr","text":"றோர்","tr":"ṟōr"}]},{"text":"கொடுமை","tr":"koṭumai","foot":"puḷimā","acai":[{"kind":"nirai","text":"கொடு","tr":"koṭu"},{"kind":"nēr","text":"மை","tr":"mai"}]},{"text":"யெற்றித்","tr":"yeṟṟit","foot":"tēmā","acai":[{"kind":"nēr","text":"யெற்","tr":"yeṟ"},{"kind":"nēr","text":"றித்","tr":"ṟit"}]},{"text":"துஞ்சா","tr":"tuñcā","foot":"tēmā","acai":[{"kind":"nēr","text":"துஞ்","tr":"tuñ"},{"kind":"nēr","text":"சா","