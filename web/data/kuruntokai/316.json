{"text":"kuruntokai","n":316,"lines":["ஆய்வளை ஞெகிழவு மயர்வுமெய் நிறுப்பவும்","நோய்மலி வருத்தம் அன்னை யறியின்","உளெனோ வாழி தோழி விளியா","துரவுக்கடல் பொருத விரவுமண லடைகரை","ஓரை மகளி ரோராங் காட்ட","வாய்ந்த லவன் துன்புறு துனைபரி","ஓங்குவரல் விரிதிரை களையும்","துறைவன் கொல்லோ பிறவா யினவே"],"tr":["āyvaḷai ñekiḻavu mayarvumey niṟuppavum","nōymali varuttam aṉṉai yaṟiyiṉ","uḷeṉō vāḻi tōḻi viḷiyā","turavukkaṭal poruta viravumaṇa laṭaikarai","ōrai makaḷi rōrāṅ kāṭṭa","vāynta lavaṉ tuṉpuṟu tuṉaipari","ōṅkuvaral viritirai kaḷaiyum","tuṟaivaṉ kollō piṟavā yiṉavē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"தும்பிசேர் கீரனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Tumpicēr Kīraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27, veṇcīr 2, vañcicīr 1, other 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 13, kalittaḷai 2, oṉṟiya vañcittaḷai 1, ? 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஆய்வளை","tr":"āyvaḷai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஆய்","tr":"āy"},{"kind":"nirai","text":"வளை","tr":"vaḷai"}]},{"text":"ஞெகிழவு","tr":"ñekiḻavu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"ஞெகி","tr":"ñeki"},{"kind":"nirai","text":"ழவு","tr":"ḻavu"}]},{"text":"மயர்வுமெய்","tr":"mayarvumey","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மயர்","tr":"mayar"},{"kind":"nirai","text":"வுமெய்","tr":"vumey"}]},{"text":"நிறுப்பவும்","tr":"niṟuppavum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நிறுப்","tr":"niṟup"},{"kind":"nirai","text":"பவும்","tr":"pavum"}]}],[{"text":"நோய்மலி","tr":"nōymali","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நோய்","tr":"nōy"},{"kind":"nirai","text":"மலி","tr":"mali"}]},{"text":"வருத்தம்","tr":"varuttam","foot":"puḷimā","acai":[{"kind":"nirai","text":"வருத்","tr":"varut"},{"kind":"nēr","text":"தம்","tr":"tam"}]},{"text":"அன்னை","tr":"aṉṉai","foot":"tēmā","acai":[{"kind":"nēr","text":"அன்","tr":"aṉ"},{"kind":"nēr","text":"னை","tr":"ṉai"}]},{"text":"யறியின்","tr":"yaṟiyiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"யறி","tr":"yaṟi"},{"kind":"nēr","text":"யின்","tr":"yiṉ"}]}],[{"text":"உளெனோ","tr":"uḷeṉō","foot":"puḷimā","acai":[{"kind":"nirai","text":"உளெ","tr":"uḷe"},{"kind":"nēr","text":"னோ","tr":"ṉō"}]},{"text":"வாழி","tr":"vāḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"விளியா","tr":"viḷiyā","foot":"puḷimā","acai":[{"kind":"nirai","text":"விளி","tr":"viḷi"},{"kind":"nēr","text":"யா","tr":"yā"}]}],[{"text":"துரவுக்கடல்","tr":"turavukkaṭal","foot":"puḷimāṅkaṉi","acai":[{"kind":"nirai","text":"துர","tr":"tura"},{"kind":"nēr","text":"வுக்","tr":"vuk"},{"kind":"nirai","text":"கடல்","tr":"kaṭal"}]},{"text":"பொருத","tr":"poruta","foot":"puḷimā","acai":[{"kind":"nirai","text":"பொரு","tr":"poru"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"விரவுமண","tr":"viravumaṇa","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"விர","tr":"vira"},{"kind":"nirai","text":"வும","tr":"vuma"},{"kind":"nēr","text":"ண","tr":"ṇa"}]},{"text":"லடைகரை","tr":"laṭaikarai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"லடை","tr":"laṭai"},{"kind":"nirai","text":"கரை","tr":"karai"}]}],[{"text":"ஓரை","tr":"ōrai","foot":"tēmā","acai":[{"kind":"nēr","text":"ஓ","tr":"ō"},{"kind":"nēr","text":"ரை","tr":"rai"}]},{"text":"மகளி","tr":"makaḷi","foot":"puḷimā","acai":[{"kind":"nirai","text":"மக","tr":"maka"},{"kind":"nēr","text":"ளி","tr":"ḷi"}]},{"text":"ரோராங்","tr":"rōrāṅ","foot":"tēmā","acai":[{"kind":"nēr","text":"ரோ","tr":"rō"},{"kind":"nēr","text":"ராங்","tr":"rāṅ"}]},{"text":"காட்ட","tr":"kāṭṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"காட்","tr":"