{"text":"kuruntokai","n":299,"lines":["இதுமற் றெவனோ தோழி முதுநீர்ப்","புணரி திளைக்கும் புள்ளிமிழ் கானல்","இணரவிழ் புன்னை யெக்கர் நீழற்","புணர்குறி வாய்த்த ஞான்றைக் கொண்கற்","கண்டன மன்னெங் கண்ணே யவன்சொற்","கேட்டன மன்னெஞ் செவியே மற்றவன்","மணப்பின் மாணல மெய்தித்","தணப்பின் நெகிழ்பவெந் தடமென் றோளே"],"tr":["itumaṟ ṟevaṉō tōḻi mutunīrp","puṇari tiḷaikkum puḷḷimiḻ kāṉal","iṇaraviḻ puṉṉai yekkar nīḻaṟ","puṇarkuṟi vāytta ñāṉṟaik koṇkaṟ","kaṇṭaṉa maṉṉeṅ kaṇṇē yavaṉcoṟ","kēṭṭaṉa maṉṉeñ ceviyē maṟṟavaṉ","maṇappiṉ māṇala meytit","taṇappiṉ nekiḻpaven taṭameṉ ṟōḷē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"வெண்மணிப்பூதியார்","speaker_en":"the heroine (talaivi)","poet_tr":"Veṇmaṇippūtiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 31"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 16, āciriyattaḷai 14"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இதுமற்","tr":"itumaṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"இது","tr":"itu"},{"kind":"nēr","text":"மற்","tr":"maṟ"}]},{"text":"றெவனோ","tr":"ṟevaṉō","foot":"puḷimā","acai":[{"kind":"nirai","text":"றெவ","tr":"ṟeva"},{"kind":"nēr","text":"னோ","tr":"ṉō"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"முதுநீர்ப்","tr":"mutunīrp","foot":"puḷimā","acai":[{"kind":"nirai","text":"முது","tr":"mutu"},{"kind":"nēr","text":"நீர்ப்","tr":"nīrp"}]}],[{"text":"புணரி","tr":"puṇari","foot":"puḷimā","acai":[{"kind":"nirai","text":"புண","tr":"puṇa"},{"kind":"nēr","text":"ரி","tr":"ri"}]},{"text":"திளைக்கும்","tr":"tiḷaikkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"திளைக்","tr":"tiḷaik"},{"kind":"nēr","text":"கும்","tr":"kum"}]},{"text":"புள்ளிமிழ்","tr":"puḷḷimiḻ","foot":"kūviḷam","acai":[{"kind":"nēr