{"text":"kuruntokai","n":106,"lines":["புல்வீழ் இற்றிக் கல்லிவர் வெள்வேர்","வரையிழி அருவியின் தோன்றும் நாடன்","தீதில் நெஞ்சத்துக் கிளவி நம்வயின்","வந்தன்று வாழி தோழி நாமும்","நெய்பெய் தீயின் எதிர்கொண்டு","தான்மணந் தனையமென விடுகந் தூதே"],"tr":["pulvīḻ iṟṟik kallivar veḷvēr","varaiyiḻi aruviyiṉ tōṉṟum nāṭaṉ","tītil neñcattuk kiḷavi namvayiṉ","vantaṉṟu vāḻi tōḻi nāmum","neypey tīyiṉ etirkoṇṭu","tāṉmaṇan taṉaiyameṉa viṭukan tūtē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"கபிலர்","speaker_en":"the heroine (talaivi)","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 7, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"புல்வீழ்","tr":"pulvīḻ","foot":"tēmā","acai":[{"kind":"nēr","text":"புல்","tr":"pul"},{"kind":"nēr","text":"வீழ்","tr":"vīḻ"}]},{"text":"இற்றிக்","tr":"iṟṟik","foot":"tēmā","acai":[{"kind":"nēr","text":"இற்","tr":"iṟ"},{"kind":"nēr","text":"றிக்","tr":"ṟik"}]},{"text":"கல்லிவர்","tr":"kallivar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கல்","tr":"kal"},{"kind":"nirai","text":"லிவர்","tr":"livar"}]},{"text":"வெள்வேர்","tr":"veḷvēr","foot":"tēmā","acai":[{"kind":"nēr","text":"வெள்","tr":"veḷ"},{"kind":"nēr","text":"வேர்","tr":"vēr"}]}],[{"text":"வரையிழி","tr":"varaiyiḻi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வரை","tr":"varai"},{"kind":"nirai","text":"யிழி","tr":"yiḻi"}]},{"text":"அருவியின்","tr":"aruviyiṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அரு","tr":"aru"},{"kind":"nirai","text":"வியின்","tr":"viyiṉ"}]},{"text":"தோன்றும்","tr":"tōṉṟum","foot":"tēmā","acai":[{"kind":"nēr","text":"தோன்","tr":"tōṉ"},{"kind":"nēr","text":"றும்","tr":"ṟum"}]},{"text":"நாடன்","tr":"nāṭaṉ","foot"