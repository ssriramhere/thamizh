","tr":"yame"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"விடுகந்","tr":"viṭukan","foot":"puḷimā","acai":[{"kind":"nirai","text":"விடு","tr":"viṭu"},{"kind":"nēr","text":"கந்","tr":"kan"}]},{"text":"தூதே","tr":"tūtē","foot":"tēmā","acai":[{"kind":"nēr","text":"தூ","tr":"tū"},{"kind":"nēr","text":"தே","tr":"tē"}]}]]},"ai":{"lines":[{"words":[{"surface":"புல்வீழ்","parts":[{"text":"புல்","lemma":"புல்","gloss":"slender"},{"text":"வீழ்","lemma":"வீழ்","gloss":"hanging root"}],"gloss":"slender hanging roots"},{"surface":"இற்றி","parts":[{"text":"இற்றி","lemma":"இற்றி","gloss":"fig tree"}],"gloss":"fig tree"},{"surface":"கல்லிவர்","parts":[{"text":"கல்","lemma":"கல்","gloss":"stone"},{"text":"இவர்","lemma":"இவர்","gloss":"climb"}],"gloss":"climbing on the rock"},{"surface":"வெள்வேர்","parts":[{"text":"வெள்","lemma":"வெள்","gloss":"white"},{"text":"வேர்","lemma":"வேர்","gloss":"root"}],"gloss":"white roots"}]},{"words":[{"surface":"வரையிழி","parts":[{"text":"வரை","lemma":"வரை","gloss":"mountain"},{"text":"இழி","lemma":"இழி","gloss":"descend"}],"gloss":"descending from the mountain"},{"surface":"அருவியின்","parts":[{"text":"அருவி","lemma":"அருவி","gloss":"waterfall"},{"text":"இன்","lemma":"இன்","gloss":"like"}],"gloss":"like a waterfall"},{"surface":"தோன்றும்","parts":[{"text":"தோன்று","lemma":"தோன்று","gloss":"appear"},{"text":"உம்","lemma":"உம்","gloss":"adjectival suffix"}],"gloss":"appearing"},{"surface":"நாடன்","parts":[{"text":"நாடு","lemma":"நாடு","gloss":"land"},{"text":"அன்","lemma":"அன்","gloss":"he"}],"gloss":"lord of the land"}]},{"words":[{"surface":"தீதில்","parts":[{"text":"தீது","lemma":"தீது","gloss":"evil"},{"text":"இல்","lemma":"இல்","gloss":"without"}],"gloss":"faultless"},{"surface":"நெஞ்சத்து","parts":[{"text":"நெஞ்சு","lemma":"நெஞ்சு","gloss":"heart"},{"text":"அத்து","lemma":"அத்து","gloss":"inflectional increment"}],"gloss":"of the heart"},{"surface":"கிளவி","parts":[{"text":"கிளவி","lemma":"கிளவி","gloss":"word"}],"gloss":"words"},{"surface":"நம்வயின்","parts":[{"text":"நம்","lemma":"நம்","gloss":"our"},{"text":"வயின்","lemma":"வயின்","gloss":"side"}],"gloss":"towards us"}]},{"words":[{"surface":"வந்தன்று","parts":[{"text":"வந்து","lemma":"வந்து","gloss":"come"},{"text":"அன்று","lemma":"அன்று","gloss":"it did"}],"gloss":"has arrived"},{"surface":"வாழி","parts":[{"text":"வாழி","lemma":"வாழி","gloss":"may you live"}],"gloss":"may you live"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"தோழி","gloss":"friend"}],"gloss":"friend"},{"surface":"நாமும்","parts":[{"text":"நாம்","lemma":"நாம்","gloss":"we"},{"text":"உம்","lemma":"உம்","gloss":"also"}],"gloss":"we also"}]},{"words":[{"surface":"நெய்பெய்","parts":[{"text":"நெய்","lemma":"நெய்","gloss":"ghee"},{"text":"பெய்","lemma":"பெய்","gloss":"pour"}],"gloss":"ghee-poured"},{"surface":"தீயின்","parts":[{"text":"தீ","lemma":"தீ","gloss":"fire"},{"text":"இன்","lemma":"இன்","gloss":"like"}],"gloss":"like fire"},{"surface":"எதிர்கொண்டு","parts":[{"text":"எதிர்","lemma":"எதிர்","gloss":"opposite"},{"text":"கொண்டு","lemma":"கொண்டு","gloss":"taking"}],"gloss":"welcoming"}]},{"words":[{"surface":"தான்மணந்து","parts":[{"text":"தான்","lemma":"தான்","gloss":"himself"},{"text":"மணந்து","lemma":"மணந்து","gloss":"marry"}],"gloss":"himself having married"},{"surface":"அனையமென","parts":[{"text":"அனையம்","lemma":"அனையம்","gloss":"we are like"},{"text":"என","lemma":"என","gloss":"that"}],"gloss":"saying we are as if married"},{"surface":"விடுகம்","parts":[{"text":"விடுகம்","lemma":"விடுகம்","gloss":"let us send"}],"gloss":"let us send"},{"surface":"தூதே","parts":[{"text":"தூது","lemma":"தூது","gloss":"messenger"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"a messenger"}]}],"literal":"Slender hanging roots of the fig tree climbing on the rock / like a waterfall descending from the mountain appear, the man of such a land / faultless heart's words towards us / has come, may you live, friend! We also / like fire with poured ghee, welcoming / 'we are as if married by him' let us send a messenger!","translation":"O friend, may you live long! A message from the faultless heart of the lord of the land—where the slender aerial roots of the rock-climbing fig tree look like a waterfall cascading down the mountain—has reached us. Let us also receive it like a fire fed with ghee, and send a messenger back to him, saying, 'We are as good as wedded to you.'","modern":"தோழியே, நீ வாழ்க! பாறையில் படர்ந்து வளரும் இற்றி மரத்தின் மெல்லிய விழுதுகள், மலையிலிருந்து இறங்கும் அருவியைப் போலத் தோன்றும் நாட்டின் தலைவனுடைய குற்றமில்லாத நெஞ்சத்திலிருந்து வந்த வார்த்தைகள் நம்மை வந்தடைந்துள்ளன. நாமும் நெய் ஊற்றப்பட்ட நெருப்பைப் போல அதனை எதிர்கொண்டு ஏற்றுக்கொண்டு, 'அவன் நம்மை மணந்து கொண்டது போன்ற மகிழ்ச்சியில் இருக்கிறோம்' என்று கூறி அவனிடம் தூது அனுப்புவோம்.","explanation":"The heroine is speaking to her close friend upon receiving a reassuring message of love from the hero. She describes the hero's mountainous land where the white roots of the rock-climbing fig tree hang down, resembling a beautiful waterfall. This imagery of the Kuriñci landscape reflects the strength and enduring nature of the hero's love. The heroine compares her joyful acceptance of his words to a fire that blazes up when ghee is poured into it. Overjoyed by his commitment, she eagerly suggests sending a messenger back to him to convey that they already feel united in marriage.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.42],[0.59,0.76],[0.93,1.36],[1.36,1.7],[1.7,2.7],[2.7,3.1],[3.1,3.3],[3.3,3.6],[3.6,4.7],[4.7,4.9],[4.9,5.3],[5.3,5.6],[5.6,6.6],[6.6,7.0],[7.0,7.28],[7.28,7.7],[7.7,8.6],[8.6,9.1],[9.1,9.81],[9.81,10.4],[10.6,11.13],[11.13,11.6],[11.6,11.9]],"female":[[0.0,0.5],[0.7,0.9],[1.1,1.6],[1.6,2.0],[2.0,3.0],[3.0,3.5],[3.5,3.8],[3.8,4.1],[4.1,5.4],[5.4,5.6],[5.6,6.1],[6.1,6.6],[6.6,7.9],[7.9,8.4],[8.4,8.6],[8.6,9.2],[9.34,10.03],[10.3,10.9],[10.9,11.76],[11.76,12.47],[12.61,13.4],[13.4,13.7],[13.7,14.0]]},"sync":[[["புல்வீழ்","slender hanging roots"]],[["இற்றி","fig tree"]],[["கல்லிவர்","climbing on the rock"]],[["வெள்வேர்","white roots"]],[["வரையிழி","descending from the mountain"]],[["அருவியின்","like a waterfall"]],[["தோன்றும்","appearing"]],[["நாடன்","lord of the land"]],[["தீதில்","faultless"]],[["நெஞ்சத்து","of the heart"],["கிளவி","words"]],[["கிளவி","words"]],[["நம்வயின்","towards us"]],[["வந்தன்று","has arrived"]],[["வாழி","may you live"]],[["தோழி","friend"]],[["நாமும்","we also"]],[["நெய்பெய்","ghee-poured"]],[["தீயின்","like fire"]],[["எதிர்கொண்டு","welcoming"]],[["தான்மணந்து","himself having married"]],[["தான்மணந்து","himself having married"],["அனையமென","saying we are as if married"]],[["விடுகம்","let us send"]],[["தூதே","a messenger"]]]}