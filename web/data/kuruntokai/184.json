]},{"text":"பரதவர்","tr":"paratavar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பர","tr":"para"},{"kind":"nirai","text":"தவர்","tr":"tavar"}]},{"text":"மடமகள்","tr":"maṭamakaḷ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மட","tr":"maṭa"},{"kind":"nirai","text":"மகள்","tr":"makaḷ"}]}],[{"text":"கண்வலைப்","tr":"kaṇvalaip","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கண்","tr":"kaṇ"},{"kind":"nirai","text":"வலைப்","tr":"valaip"}]},{"text":"படுஉம்","tr":"paṭuum","foot":"puḷimā","acai":[{"kind":"nirai","text":"படு","tr":"paṭu"},{"kind":"nēr","text":"உம்","tr":"um"}]},{"text":"கான","tr":"kāṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"லானே","tr":"lāṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"லா","tr":"lā"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"அறிகரி","parts":[{"text":"அறி","lemma":"அறி","gloss":"knowing"},{"text":"கரி","lemma":"கரி","gloss":"witness"}],"gloss":"knowing witness"},{"surface":"பொய்த்தல்","parts":[{"text":"பொய்த்தல்","lemma":"பொய்","gloss":"lying"}],"gloss":"bearing false witness"},{"surface":"ஆன்றோர்க்கு","parts":[{"text":"ஆன்றோர்","lemma":"ஆன்றோர்","gloss":"noble people"},{"text":"கு","lemma":"கு","gloss":"to"}],"gloss":"to noble people"},{"surface":"இல்லை","parts":[{"text":"இல்லை","lemma":"இல்லை","gloss":"is not"}],"gloss":"there is not"}]},{"words":[{"surface":"குறுகல்","parts":[{"text":"குறுகல்","lemma":"குறுகு","gloss":"approaching"}],"gloss":"approaching"},{"surface":"ஓம்புமின்","parts":[{"text":"ஓம்புமின்","lemma":"ஓம்பு","gloss":"avoid"}],"gloss":"avoid"},{"surface":"சிறுகுடிச்","parts":[{"text":"சிறுகுடிச்","lemma":"சிறுகுடிச்","gloss":"small hamlet"}],"gloss":"small hamlet","split_unverified":true},{"surface":"செலவே","parts":[{"text":"செலவு","lemma":"செலவு","gloss":"going"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"the going indeed"}]},{"words":[{"surface":"இதற்கிது","parts":[{"text":"இதற்கிது","lemma":"இதற்கிது","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மாண்ட","parts":[{"text":"மாண்ட","lemma":"மாண்ட","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தென்னா","parts":[{"text":"தென்னா","lemma":"தென்னா","gloss":""}],"gloss":"","split_unverified":true},{"surface":"ததற்பட்","parts":[{"text":"ததற்பட்","lemma":"ததற்பட்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"டாண்டொழிந்","parts":[{"text":"டாண்டொழிந்","lemma":"டாண்டொழிந்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தன்றே","parts":[{"text":"தன்றே","lemma":"தன்றே","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மாண்டகை","parts":[{"text":"மாண்டகை","lemma":"மாண்டகை","gloss":""}],"gloss":"","split_unverified":true},{"surface":"நெஞ்சம்","parts":[{"text":"நெஞ்சம்","lemma":"நெஞ்சம்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"மயிற்கண்","parts":[{"text":"மயில்","lemma":"மயில்","gloss":"peacock"},{"text":"கண்","lemma":"கண்","gloss":"eye"}],"gloss":"peacock's eye"},{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"அன்ன","gloss":"like"}],"gloss":"like"},{"surface":"மாண்முடிப்","parts":[{"text":"மாண்முடிப்","lemma":"மாண்முடிப்","gloss":"beautiful hair-knot"}],"gloss":"beautiful hair-knot","split_unverified":true},{"surface":"பாவை","parts":[{"text":"பாவை","lemma":"பாவை","gloss":"doll"}],"gloss":"doll-like maiden"}]},{"words":[{"surface":"நுண்வலைப்","parts":[{"text":"நுண்வலைப்","lemma":"நுண்வலைப்","gloss":"fine net"}],"gloss":"fine net","split_unverified":true},{"surface":"பரதவர்","parts":[{"text":"பரதவர்","lemma":"பரதவர்","gloss":"fisherfolk"}],"gloss":"of the fisherfolk"},{"surface":"மடமகள்","parts":[{"text":"மடம்","lemma":"மடம்","gloss":"innocence"},{"text":"மகள்","lemma":"மகள்","gloss":"daughter"}],"gloss":"innocent daughter"}]},{"words":[{"surface":"கண்வலைப்","parts":[{"text":"கண்வலைப்","lemma":"கண்வலைப்","gloss":"eye-net"}],"gloss":"eye-net","split_unverified":true},{"surface":"படுஉம்","parts":[{"text":"படுஉம்","lemma":"படுஉம்","gloss":"getting caught"}],"gloss":"getting caught","split_unverified":true},{"surface":"கானலானே","parts":[{"text":"கானல்","lemma":"கானல்","gloss":"seaside grove"},{"text":"ஆன்","lemma":"ஆன்","gloss":"in"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"in the seaside grove indeed"}]}],"literal":"To noble people, there is no bearing of false witness to what they know. / Avoid approaching, the going to the small hamlet! / Without considering 'is this worthy for this?', having fallen for that, / there it stayed behind indeed, my heart of noble quality, / like a doll with a beautiful hair-knot resembling a peacock's eye, / the innocent daughter of the fisherfolk with fine nets, / getting caught in her eye-net, in the seaside grove.","translation":"Noble people never deny what they know to be true. So, let me warn you: avoid going near that small coastal hamlet! Without even considering whether this is worthy of that, my noble heart fell for her and stayed behind right there, caught in the eye-net of the innocent daughter of the fisherfolk who cast fine nets—she who is like a doll with a beautiful hair-knot resembling the eye of a peacock's feather, in that seaside grove.","modern":"தான் அறிந்த உண்மையை மறைத்துப் பொய் கூறுதல் சான்றோர்க்கு அழகல்ல. அதனால் சொல்கிறேன், அந்தச் சிறிய நெய்தல் நிலக் குடியேற்றத்திற்குச் செல்வதைத் தவிர்த்துவிடுங்கள்! 'இதற்கு இது தகுதியானதுதானா?' என்று ஆராய்ந்து பார்க்காமல், என் பெருமைமிக்க நெஞ்சம் அவளிடம் மயங்கி அங்கேயே தங்கிவிட்டது. மயில்தோகையின் கண் போன்ற அழகான கொண்டையையுடைய பொம்மை போன்றவளும், நுண்ணிய வலைகளைக் கொண்ட பரதவர்களின் இளமகள் ஆகிய அவளுடைய கண் என்னும் வலையில் சிக்கி, அந்த கடற்கரைச் சோலையிலேயே என் நெஞ்சம் தங்கிவிட்டது.","explanation":"The hero is speaking to his companion or to himself after returning from the coastal hamlet where he met the heroine. He warns against going to the small hamlet of the fisherfolk, using a self-deprecating yet passionate tone. He states that noble people do not lie about what they know, and he must admit that his noble heart has completely surrendered to the heroine. Without weighing the social differences or suitability ('is this worthy of that?'), his heart was captured by the eye-net of the innocent fisher-girl in the seaside grove. The imagery of the fisherfolk's 'fine nets' catching fish is beautifully contrasted with the heroine's 'eye-net' catching the hero's heart, which is characteristic of the Neytal (coastal) landscape.","model":"gemini-3.5-flash"}}