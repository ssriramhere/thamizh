]},{"text":"பரதவர்","tr":"paratavar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பர","tr":"para"},{"kind":"nirai","text":"தவர்","tr":"tavar"}]},{"text":"மடமகள்","tr":"maṭamakaḷ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மட","tr":"maṭa"},{"kind":"nirai","text":"மகள்","tr":"makaḷ"}]}],[{"text":"கண்வலைப்","tr":"kaṇvalaip","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கண்","tr":"kaṇ"},{"kind":"nirai","text":"வலைப்","tr":"valaip"}]},{"text":"படுஉம்","tr":"paṭuum","foot":"puḷimā","acai":[{"kind":"nirai","text":"படு","tr":"paṭu"},{"kind":"nēr","text":"உம்","tr":"um"}]},{"text":"கான","tr":"kāṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"லானே","tr":"lāṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"லா","tr":"lā"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"அறிகரி","parts":[{"text":"அறி","lemma":"அறி","gloss":"knowing"},{"text":"கரி","lemma":"கரி","gloss":"witness"}],"gloss":"knowing witness"},{"surface":"பொய்த்தல்","parts":[{"text":"பொய்த்தல்","lemma":"பொய்த்தல்","gloss":"lying"}],"gloss":"bearing false witness"},{"surface":"ஆன்றோர்க்கு","parts":[{"text":"ஆன்றோர்","lemma":"ஆன்றோர்","gloss":"noble people"},{"text":"க்கு","lemma":"க்கு","gloss":"to"}],"gloss":"to the noble people"},{"surface":"இல்லை","parts":[{"text":"இல்லை","lemma":"இல்லை","gloss":"is not"}],"gloss":"there is not"}]},{"words":[{"surface":"குறுகல்","parts":[{"text":"குறுகல்","lemma":"குறுகல்","gloss":"approaching"}],"gloss":"approaching"},{"surface":"ஓம்புமின்","parts":[{"text":"ஓம்பு","lemma":"ஓம்பு","gloss":"avoid"},{"text":"மின்","lemma":"மின்","gloss":"you (plural/honorific)"}],"gloss":"avoid / guard against"},{"surface":"சிறுகுடிச்","parts":[{"text":"சிறுகுடிச்","lemma":"சிறுகுடிச்","gloss":"small hamlet"}],"gloss":"small hamlet","split_unverified":true},{"surface":"செலவே","parts":[{"text":"செலவு","lemma":"செலவு","gloss":"going"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"going indeed"}]},{"words":[{"surface":"இதற்கிது","parts":[{"text":"இதற்கிது","lemma":"இதற்கிது","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மாண்ட","parts":[{"text":"மாண்ட","lemma":"மாண்ட","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தென்னா","parts":[{"text":"தென்னா","lemma":"தென்னா","gloss":""}],"gloss":"","split_unverified":true},{"surface":"ததற்பட்","parts":[{"text":"ததற்பட்","lemma":"ததற்பட்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"டாண்டொழிந்","parts":[{"text":"டாண்டொழிந்","lemma":"டாண்டொழிந்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தன்றே","parts":[{"text":"தன்றே","lemma":"தன்றே","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மாண்டகை","parts":[{"text":"மாண்டகை","lemma":"மாண்டகை","gloss":""}],"gloss":"","split_unverified":true},{"surface":"நெஞ்சம்","parts":[{"text":"நெஞ்சம்","lemma":"நெஞ்சம்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"மயிற்கண்","parts":[{"text":"மயில்","lemma":"மயில்","gloss":"peacock"},{"text":"கண்","lemma":"கண்","gloss":"eye"}],"gloss":"peacock's eye"},{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"அன்ன","gloss":"like"}],"gloss":"like"},{"surface":"மாண்முடிப்","parts":[{"text":"மாண்முடிப்","lemma":"மாண்முடிப்","gloss":"beautiful hair-knot"}],"gloss":"beautiful hair-knot","split_unverified":true},{"surface":"பாவை","parts":[{"text":"பாவை","lemma":"பாவை","gloss":"doll"}],"gloss":"doll-like woman"}]},{"words":[{"surface":"நுண்வலைப்","parts":[{"text":"நுண்வலைப்","lemma":"நுண்வலைப்","gloss":"fine net"}],"gloss":"fine net","split_unverified":true},{"surface":"பரதவர்","parts":[{"text":"பரதவர்","lemma":"பரதவர்","gloss":"fisherfolk"}],"gloss":"fisherfolk"},{"surface":"மடமகள்","parts":[{"text":"மடம்","lemma":"மடம்","gloss":"innocence"},{"text":"மகள்","lemma":"மகள்","gloss":"daughter"}],"gloss":"innocent daughter"}]},{"words":[{"surface":"கண்வலைப்","parts":[{"text":"கண்வலைப்","lemma":"கண்வலைப்","gloss":"eye-net"}],"gloss":"eye-net","split_unverified":true},{"surface":"படுஉம்","parts":[{"text":"படுஉம்","lemma":"படு","gloss":"getting caught"}],"gloss":"getting caught"},{"surface":"கானலானே","parts":[{"text":"கானல்","lemma":"கானல்","gloss":"seaside grove"},{"text":"ஆன்","lemma":"ஆன்","gloss":"in"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"in the seaside grove indeed"}]}],"literal":"To those who are noble, there is no bearing of false witness to what they know. / Avoid approaching the small hamlet! / Without saying \"This is worthy of this,\" falling for that, / there it stayed behind indeed, my noble heart, / in the seaside grove where, like the eye of a peacock feather, with a beautiful knot of hair, / the innocent daughter of the fisherman with fine nets, / in her eye-net, it gets caught.","translation":"To bear false witness to what one knows is not the way of the noble. So, do not go near that small hamlet! Without considering whether she was worthy of it, my noble heart fell for her, and there it stayed behind, caught in the eye-net of the fisherman's innocent daughter with her beautiful hair-knot like a peacock's feather-eye, in that seaside grove.","modern":"தான் அறிந்த சாட்சியத்தைப் பொய் என்று கூறுவது சான்றோர்க்கு அழகல்ல. அதனால், அந்தச் பரதவர் வாழும் சிறுகுடிக்குச் செல்வதைத் தவிர். 'இவள் நமக்கு ஏற்றவளா' என்று ஆராயாமல், அவளிடத்தே மயங்கி, அங்கேயே தங்கிவிட்டது என் பெருமைமிக்க நெஞ்சம். மயில்தோகையின் கண் போன்ற அழகான கொண்டையையும், மெல்லிய வலையையும் உடைய பரதவரின் இளமகள் வீசிய கண்வலையிலே சிக்கிக்கொண்டு, அந்த நெய்தல் நிலக் கானலிலேயே என் நெஞ்சம் தங்கிவிட்டது.","explanation":"The hero is speaking to himself or his companion after meeting the heroine, a fisherwoman in the coastal grove. He tells himself that noble people do not lie to themselves about what they know to be true. He warns against going near her small hamlet, but confesses that his noble heart did not pause to think whether she was suitable for him; instead, it fell for her and stayed behind. His heart was caught in the 'eye-net' of the innocent daughter of the fisherman, whose beautiful hair-knot resembles the eye of a peacock feather. This metaphor of the eye-net beautifully contrasts with the actual fine fishing nets used by her community, fitting the coastal landscape of the neytal tiṇai. Key words include 'அறிகரி' (knowing witness), 'கண்வலை' (eye-net), and 'கானல்' (seaside grove).","model":"gemini-3.5-flash"}}