{"text":"kuruntokai","n":184,"lines":["அறிகரி பொய்த்தல் ஆன்றோர்க் கில்லை","குறுக லோம்புமின் சிறுகுடிச் செலவே","இதற்கிது மாண்ட தென்னா ததற்பட்","டாண்டொழிந் தன்றே மாண்டகை நெஞ்சம்","மயிற்கண் அன்ன மாண்முடிப் பாவை","நுண்வலைப் பரதவர் மடமகள்","கண்வலைப் படுஉம் கான லானே"],"tr":["aṟikari poyttal āṉṟōrk killai","kuṟuka lōmpumiṉ ciṟukuṭic celavē","itaṟkitu māṇṭa teṉṉā tataṟpaṭ","ṭāṇṭoḻin taṉṟē māṇṭakai neñcam","mayiṟkaṇ aṉṉa māṇmuṭip pāvai","nuṇvalaip paratavar maṭamakaḷ","kaṇvalaip paṭuum kāṉa lāṉē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவன் கூற்று","poet_ta":"ஆரிய வரசன் யாழ்ப்பிரமதத்தன்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Āriya Varacaṉ Yāḻppiramatattaṉ"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 10"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அறிகரி","tr":"aṟikari","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அறி","tr":"aṟi"},{"kind":"nirai","text":"கரி","tr":"kari"}]},{"text":"பொய்த்தல்","tr":"poyttal","foot":"tēmā","acai":[{"kind":"nēr","text":"பொய்த்","tr":"poyt"},{"kind":"nēr","text":"தல்","tr":"tal"}]},{"text":"ஆன்றோர்க்","tr":"āṉṟōrk","foot":"tēmā","acai":[{"kind":"nēr","text":"ஆன்","tr":"āṉ"},{"kind":"nēr","text":"றோர்க்","tr":"ṟōrk"}]},{"text":"கில்லை","tr":"killai","foot":"tēmā","acai":[{"kind":"nēr","text":"கில்","tr":"kil"},{"kind":"nēr","text":"லை","tr":"lai"}]}],[{"text":"குறுக","tr":"kuṟuka","foot":"puḷimā","acai":[{"kind":"nirai","text":"குறு","tr":"kuṟu"},{"kind":"nēr","text":"க","tr":"ka"}]},{"text":"லோம்புமின்","tr":"lōmpumiṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"லோம்","tr":"lōm"},{"kind":"nirai","text":"புமின்","tr":"pumiṉ"}]},{"text":"சிறுகுடிச்","tr":"ciṟukuṭic","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟ