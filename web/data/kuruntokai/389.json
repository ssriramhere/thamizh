{"text":"kuruntokai","n":389,"lines":["நெய்கனி குறும்பூழ் காய மாக","ஆர்பதம் பெறுக தோழி அத்தை","பெருங்கல் நாடன் வரைந்தென அவனெதிர்","நன்றோ மகனே யென்றனென்","நன்றே போலும் என்றுரைத் தோனே"],"tr":["neykaṉi kuṟumpūḻ kāya māka","ārpatam peṟuka tōḻi attai","peruṅkal nāṭaṉ varainteṉa avaṉetir","naṉṟō makaṉē yeṉṟaṉeṉ","naṉṟē pōlum eṉṟurait tōṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"வேட்டகண்ணனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Vēṭṭakaṇṇaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 6"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நெய்கனி","tr":"neykaṉi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நெய்","tr":"ney"},{"kind":"nirai","text":"கனி","tr":"kaṉi"}]},{"text":"குறும்பூழ்","tr":"kuṟumpūḻ","foot":"puḷimā","acai":[{"kind":"nirai","text":"குறும்","tr":"kuṟum"},{"kind":"nēr","text":"பூழ்","tr":"pūḻ"}]},{"text":"காய","tr":"kāya","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"மாக","tr":"māka","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"க","tr":"ka"}]}],[{"text":"ஆர்பதம்","tr":"ārpatam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஆர்","tr":"ār"},{"kind":"nirai","text":"பதம்","tr":"patam"}]},{"text":"பெறுக","tr":"peṟuka","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெறு","tr":"peṟu"},{"kind":"nēr","text":"க","tr":"ka"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"அத்தை","tr":"attai","foot":"tēmā","acai":[{"kind":"nēr","text":"அத்","tr":"at"},{"kind":"nēr","text":"தை","tr":"tai"}]}],[{"text":"பெருங்கல்","tr":"peruṅkal","foot":"puḷimā","acai":[{"kind"