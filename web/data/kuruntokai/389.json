:"nirai","text":"பெருங்","tr":"peruṅ"},{"kind":"nēr","text":"கல்","tr":"kal"}]},{"text":"நாடன்","tr":"nāṭaṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"டன்","tr":"ṭaṉ"}]},{"text":"வரைந்தென","tr":"varainteṉa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வரைந்","tr":"varain"},{"kind":"nirai","text":"தென","tr":"teṉa"}]},{"text":"அவனெதிர்","tr":"avaṉetir","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அவ","tr":"ava"},{"kind":"nirai","text":"னெதிர்","tr":"ṉetir"}]}],[{"text":"நன்றோ","tr":"naṉṟō","foot":"tēmā","acai":[{"kind":"nēr","text":"நன்","tr":"naṉ"},{"kind":"nēr","text":"றோ","tr":"ṟō"}]},{"text":"மகனே","tr":"makaṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"மக","tr":"maka"},{"kind":"nēr","text":"னே","tr":"ṉē"}]},{"text":"யென்றனென்","tr":"yeṉṟaṉeṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யென்","tr":"yeṉ"},{"kind":"nirai","text":"றனென்","tr":"ṟaṉeṉ"}]}],[{"text":"நன்றே","tr":"naṉṟē","foot":"tēmā","acai":[{"kind":"nēr","text":"நன்","tr":"naṉ"},{"kind":"nēr","text":"றே","tr":"ṟē"}]},{"text":"போலும்","tr":"pōlum","foot":"tēmā","acai":[{"kind":"nēr","text":"போ","tr":"pō"},{"kind":"nēr","text":"லும்","tr":"lum"}]},{"text":"என்றுரைத்","tr":"eṉṟurait","foot":"kūviḷam","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nirai","text":"றுரைத்","tr":"ṟurait"}]},{"text":"தோனே","tr":"tōṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"நெய்கனி","parts":[{"text":"நெய்","lemma":"ney","gloss":"fat/ghee"},{"text":"கனி","lemma":"kaṉi","gloss":"rich/ripe"}],"gloss":"fat-dripping"},{"surface":"குறும்பூழ்","parts":[{"text":"குறும்பூழ்","lemma":"kuṟumpūḻ","gloss":"quail"}],"gloss":"quail"},{"surface":"காய","parts":[{"text":"காய","lemma":"காய","gloss":"seasoned"}],"gloss":"seasoned","split_unverified":true},{"surface":"மாக","parts":[{"text":"மாக","lemma":"மாக","gloss":"as"}],"gloss":"as","split_unverified":true}]},{"words":[{"surface":"ஆர்பதம்","parts":[{"text":"ஆர்","lemma":"ār","gloss":"abundant/full"},{"text":"பதம்","lemma":"patam","gloss":"food/meal"}],"gloss":"abundant food"},{"surface":"பெறுக","parts":[{"text":"பெறு","lemma":"peṟu","gloss":"receive"},{"text":"க","lemma":"ka","gloss":"optative suffix"}],"gloss":"may they obtain"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"tōḻi","gloss":"O friend"}],"gloss":"O friend"},{"surface":"அத்தை","parts":[{"text":"அத்தை","lemma":"attai","gloss":"indeed (particle)"}],"gloss":"indeed"}]},{"words":[{"surface":"பெருங்கல்","parts":[{"text":"பெருங்கல்","lemma":"பெருங்கல்","gloss":"big mountain"}],"gloss":"big mountain","split_unverified":true},{"surface":"நாடன்","parts":[{"text":"நாடு","lemma":"nāṭu","gloss":"land/country"},{"text":"அன்","lemma":"aṉ","gloss":"masculine singular suffix"}],"gloss":"lord of the land"},{"surface":"வரைந்தென","parts":[{"text":"வரைந்து","lemma":"varai","gloss":"having agreed to marry"},{"text":"என","lemma":"eṉa","gloss":"as/because"}],"gloss":"because he agreed to marry"},{"surface":"அவனெதிர்","parts":[{"text":"அவன்","lemma":"avaṉ","gloss":"him"},{"text":"எதிர்","lemma":"etiṟ","gloss":"before/in front of"}],"gloss":"before him"}]},{"words":[{"surface":"நன்றோ","parts":[{"text":"நன்று","lemma":"naṉṟu","gloss":"good"},{"text":"ஓ","lemma":"ō","gloss":"interrogative particle"}],"gloss":"Is it good?"},{"surface":"மகனே","parts":[{"text":"மகன்","lemma":"makaṉ","gloss":"son/young man"},{"text":"ஏ","lemma":"ē","gloss":"vocative particle"}],"gloss":"O son!"},{"surface":"யென்றனென்","parts":[{"text":"யென்றனென்","lemma":"யென்றனென்","gloss":"I said"}],"gloss":"I said","split_unverified":true}]},{"words":[{"surface":"நன்றே","parts":[{"text":"நன்று","lemma":"naṉṟu","gloss":"good"},{"text":"ஏ","lemma":"ē","gloss":"emphatic particle"}],"gloss":"good indeed"},{"surface":"போலும்","parts":[{"text":"போலும்","lemma":"pōlum","gloss":"it seems"}],"gloss":"it seems"},{"surface":"என்றுரைத்","parts":[{"text":"என்றுரைத்","lemma":"என்றுரைத்","gloss":"having spoken"}],"gloss":"having spoken","split_unverified":true},{"surface":"தோனே","parts":[{"text":"தோன்","lemma":"tōṉ","gloss":"he who did"},{"text":"ஏ","lemma":"ē","gloss":"emphatic particle"}],"gloss":"he who spoke"}]}],"literal":"Fat-dripping quail as seasoned dish / may they obtain abundant food, O friend, indeed! / The lord of the big mountain country, because he agreed to marry, before him / 'Is it good, O son?' I asked. / 'It is good indeed, it seems,' he spoke.","translation":"O friend! May they receive a rich feast of fat-dripping quail seasoned with spices! When the lord of the great mountain country agreed to marry you, I asked the diviner in his presence, 'Is this good, O son?' and he replied, 'It seems very good indeed!'","modern":"தோழியே! கொழுப்பு நிறைந்த காடைப் பறவையை மசாலா சேர்த்துச் சமைத்த உணவை அவர்கள் பெருவிருந்தாகப் பெறட்டும்! பெரிய மலைநாட்டிற்குரிய தலைவன் உன்னைத் திருமணம் செய்ய உடன்பட்டபோது, அவனுக்கு முன்னால் நான் குறிசொல்லும் வேலனிடம், 'மகனே, இது நல்லதா?' என்று கேட்டேன். அதற்கு அவன், 'மிகவும் நல்லது போலிருக்கிறது!' என்று கூறினான்.","explanation":"This poem is spoken by the heroine's friend (tōḻi) to the heroine (talaivi) upon the successful settlement of their marriage. The hero, the lord of the great mountain country, has formally proposed, and the family has accepted. The friend joyfully wishes for a grand celebratory feast featuring fat-dripping quail seasoned with spices. She recalls how she asked the diviner (addressed affectionately as 'makaṉ' or son) in the hero's presence if this marriage was a good match. The diviner enthusiastically confirmed that it was indeed excellent, removing all anxieties. This happy resolution of secret love into marriage is a classic theme of the Kuriñci (mountain) landscape.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,1.3],[1.3,1.6],[1.6,1.9],[1.9,2.5],[2.5,2.8],[2.8,3.11],[3.19,3.5],[3.5,4.6],[4.6,4.9],[4.9,5.29],[5.29,5.4],[5.4,6.7],[6.7,6.8],[6.97,7.5],[7.5,8.5],[8.5,8.9],[8.9,9.2],[9.2,9.5]],"female":[[0.6,0.81],[0.9,1.2],[1.2,1.6],[1.6,2.0],[2.17,2.7],[2.7,3.0],[3.0,3.1],[3.1,3.8],[3.8,4.8],[4.8,5.1],[5.1,5.5],[5.5,5.98],[6.1,6.9],[6.9,7.0],[7.13,7.9],[7.9,7.9],[7.9,9.0],[9.0,9.6],[9.6,9.8]]},"sync":[[["நெய்கனி","fat-dripping"]],[["குறும்பூழ்","quail"]],[["காய","seasoned"]],[["மாக","as"]],[["ஆர்பதம்","abundant food"]],[["பெறுக","may they obtain"]],[["தோழி","O friend"]],[["அத்தை","indeed"]],[["பெருங்கல்","big mountain"]],[["நாடன்","lord of the land"]],[["வரைந்தென","because he agreed to marry"]],[["அவனெதிர்","before him"]],[["நன்றோ","Is it good?"]],[["மகனே","O son!"]],[["யென்றனென்","I said"]],[["நன்றே","good indeed"]],[["போலும்","it seems"]],[["என்றுரைத்","having spoken"]],[["தோனே","he who spoke"]]]}