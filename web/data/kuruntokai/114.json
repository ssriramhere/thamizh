{"text":"kuruntokai","n":114,"lines":["நெய்தற் பரப்பிற் பாவை கிடப்பி","நின்குறி வந்தனென் இயல்தேர்க் கொண்க","செல்கம் செலவியங் கொண்மோ அல்கலும்","ஆரல் அருந்த வயிற்ற","நாரை மிதிக்கும் என்மகள் நுதலே"],"tr":["neytaṟ parappiṟ pāvai kiṭappi","niṉkuṟi vantaṉeṉ iyaltērk koṇka","celkam celaviyaṅ koṇmō alkalum","āral arunta vayiṟṟa","nārai mitikkum eṉmakaḷ nutalē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தோழி கூற்று","poet_ta":"பொன்னாகனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Poṉṉākaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 9, āciriyattaḷai 9"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நெய்தற்","tr":"neytaṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"நெய்","tr":"ney"},{"kind":"nēr","text":"தற்","tr":"taṟ"}]},{"text":"பரப்பிற்","tr":"parappiṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பரப்","tr":"parap"},{"kind":"nēr","text":"பிற்","tr":"piṟ"}]},{"text":"பாவை","tr":"pāvai","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"வை","tr":"vai"}]},{"text":"கிடப்பி","tr":"kiṭappi","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிடப்","tr":"kiṭap"},{"kind":"nēr","text":"பி","tr":"pi"}]}],[{"text":"நின்குறி","tr":"niṉkuṟi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நின்","tr":"niṉ"},{"kind":"nirai","text":"குறி","tr":"kuṟi"}]},{"text":"வந்தனென்","tr":"vantaṉeṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வந்","tr":"van"},{"kind":"nirai","text":"தனென்","tr":"taṉeṉ"}]},{"text":"இயல்தேர்க்","tr":"iyaltērk","foot":"puḷimā","acai":[{"kind":"nirai","text":"இயல்","tr":"iyal"},{"kind":"nēr","text":"தேர்க்","tr":"tērk"}]},{"text":"கொண்க","tr":"koṇka","foot":"tēmā","acai":[{"kind":"nēr","text":"கொண்","tr":"koṇ"},{"kind":"nēr","text":"க","tr":"ka"}]}],[{"text":