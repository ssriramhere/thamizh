rds":[{"surface":"நின்","parts":[{"text":"நின்","lemma":"நீ","gloss":"your"}],"gloss":"your"},{"surface":"குறி","parts":[{"text":"குறி","lemma":"குறி","gloss":"tryst"}],"gloss":"tryst"},{"surface":"வந்தனென்","parts":[{"text":"வந்தனென்","lemma":"வா","gloss":"I came"}],"gloss":"I came"},{"surface":"இயல்","parts":[{"text":"இயல்","lemma":"இயல்","gloss":"moving"}],"gloss":"moving"},{"surface":"தேர்","parts":[{"text":"தேர்","lemma":"தேர்","gloss":"chariot"}],"gloss":"chariot"},{"surface":"கொண்க","parts":[{"text":"கொண்க","lemma":"கொண்கன்","gloss":"O lord of the maritime tract!"}],"gloss":"O lord of the maritime tract!"}]},{"words":[{"surface":"செல்கம்","parts":[{"text":"செல்","lemma":"cel","gloss":"go"},{"text":"கம்","lemma":"-kam","gloss":"we (hortative suffix)"}],"gloss":"let us go"},{"surface":"செலவு","parts":[{"text":"செலவு","lemma":"celavu","gloss":"departure"}],"gloss":"departure"},{"surface":"இயங்கு","parts":[{"text":"இயங்கு","lemma":"iyaṅku","gloss":"move / proceed"}],"gloss":"proceeding"},{"surface":"கொண்மோ","parts":[{"text":"கொள்","lemma":"koḷ","gloss":"take / undertake"},{"text":"மோ","lemma":"-mō","gloss":"imperative particle"}],"gloss":"please undertake"},{"surface":"அல்கலும்","parts":[{"text":"அல்கல்","lemma":"alkal","gloss":"day / night"},{"text":"உம்","lemma":"-um","gloss":"always / every"}],"gloss":"every day"}]},{"words":[{"surface":"ஆரல்","parts":[{"text":"ஆரல்","lemma":"ஆரல்","gloss":"eel fish"}],"gloss":"eel fish"},{"surface":"அருந்த","parts":[{"text":"அருந்த","lemma":"அருந்து","gloss":"to eat"}],"gloss":"having eaten"},{"surface":"வயிற்ற","parts":[{"text":"வயிற்ற","lemma":"வயிறு","gloss":"having bellies"}],"gloss":"having bellies"}]},{"words":[{"surface":"நாரை","parts":[{"text":"நாரை","lemma":"நாரை","gloss":"heron"}],"gloss":"heron"},{"surface":"மிதிக்கும்","parts":[{"text":"மிதிக்கும்","lemma":"மிதி","gloss":"will step on"}],"gloss":"will step on"},{"surface":"என்","parts":[{"text":"என்","lemma":"யான்","gloss":"my"}],"gloss":"my"},{"surface":"மகள்","parts":[{"text":"மகள்","lemma":"மகள்","gloss":"daughter"}],"gloss":"daughter"},{"surface":"நுதலே","parts":[{"text":"நுதலே","lemma":"நுதல்","gloss":"forehead indeed"}],"gloss":"forehead indeed"}]}],"literal":"Having laid down the doll in the expanse of blue water-lilies, / I came to your tryst, O lord of the moving chariot! / Let us go, please take to start the departure, always / having eaten eel fish, with full bellies, / the herons will step on my daughter's forehead.","translation":"Having left our sand doll in the expanse of blue water-lilies, I came to meet you at the tryst, O lord of the well-made chariot! Now let us return, prepare for our departure. For every day, the heavy herons, with bellies stuffed from eating eel fish, will trample the forehead of my dear companion's doll.","modern":"நெய்தல் மலர்கள் நிறைந்த பரப்பில் மணல் பாவையை கிடத்திவிட்டு, நல்ல தேரையுடைய கொண்கனே! உன்னுடைய குறிக்கோள் இடத்திற்கு வந்தேன். நாம் இனிச் செல்வோம், புறப்படுதலை மேற்கொள்வாயாக. நாள்தோறும் ஆரல் மீனைத் தின்ற வயிற்றையுடைய நாரைகள் என் மகளாகிய தலைவியின் மணல் பாவையின் நெற்றியை மிதிக்கும்.","explanation":"The friend of the heroine is speaking to the hero at their coastal trysting place. She explains that they have left a sand doll they made on the beach to come and meet him in secret. She urges him to let them return home and hints that he should seek a formal marriage. The image of the heavy, fish-gorged herons trampling the delicate forehead of the sand doll belongs to the Neytal (coastal) landscape. It serves as an implicit metaphor (uḷḷuṟai) warning the hero that his continued delays and secret visits will ruin the heroine's delicate beauty and reputation through public gossip.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,0.7],[0.7,1.1],[1.1,1.5],[1.5,1.94],[1.94,2.7],[2.7,3.36],[3.36,3.54],[3.6,4.7],[4.7,5.3],[5.3,5.4],[5.5,6.2],[6.2,6.9],[6.9,7.0],[7.0,7.4],[7.4,8.7],[8.7,8.9],[8.9,9.5],[9.5,9.6]],"female":[[0.0,0.6],[0.6,0.7],[0.7,1.2],[1.2,1.6],[1.71,2.14],[2.24,2.56],[2.78,3.95],[3.95,3.95],[3.95,3.95],[3.95,5.38],[5.38,5.66],[5.95,6.8],[6.8,7.5],[7.5,7.6],[7.6,8.0],[8.0,9.5],[9.5,9.7],[9.7,10.5],[10.5,10.6]]},"sync":[[["நெய்தல்","blue water-lily"]],[["பரப்பில்","in the expanse"]],[["பாவை","doll"]],[["கிடப்பி","having laid down"]],[["நின்","your"],["குறி","tryst"]],[["வந்தனென்","I came"]],[["இயல்","moving"],["தேர்","chariot"],["கொண்க","O lord of the maritime tract!"]],[["கொண்க","O lord of the maritime tract!"]],[["செல்கம்","let us go"]],[["செலவு","departure"],["இயங்கு","proceeding"]],[["கொண்மோ","please undertake"]],[["அல்கலும்","every day"]],[["ஆரல்","eel fish"]],[["அருந்த","having eaten"]],[["வயிற்ற","having bellies"]],[["நாரை","heron"]],[["மிதிக்கும்","will step on"]],[["என்","my"],["மகள்","daughter"]],[["நுதலே","forehead indeed"]]]}