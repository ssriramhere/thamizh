{"text":"kuruntokai","n":305,"lines":["கண்தர வந்த காம ஒள்ளெரி","என்புற நலியினும் அவரொடு பேணிச்","சென்றுநாம் முயங்கற் கருங்காட் சியமே","வந்தஞர் களைதலை அவராற் றலரே","உய்த்தனர் விடாஅர் பிரித்திடை களையார்","குப்பைக் கோழித் தனிப்போர் போல","விளிவாங்கு விளியி னல்லது","களைவோர் இலையா முற்ற நோயே"],"tr":["kaṇtara vanta kāma oḷḷeri","eṉpuṟa naliyiṉum avaroṭu pēṇic","ceṉṟunām muyaṅkaṟ karuṅkāṭ ciyamē","vantañar kaḷaitalai avarāṟ ṟalarē","uyttaṉar viṭāar pirittiṭai kaḷaiyār","kuppaik kōḻit taṉippōr pōla","viḷivāṅku viḷiyi ṉallatu","kaḷaivōr ilaiyā muṟṟa nōyē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தலைவி கூற்று","poet_ta":"குப்பைக்கோழியார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kuppaikkōḻiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 19, veṇṭaḷai 10, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கண்தர","tr":"kaṇtara","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கண்","tr":"kaṇ"},{"kind":"nirai","text":"தர","tr":"tara"}]},{"text":"வந்த","tr":"vanta","foot":"tēmā","acai":[{"kind":"nēr","text":"வந்","tr":"van"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"காம","tr":"kāma","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"ம","tr":"ma"}]},{"text":"ஒள்ளெரி","tr":"oḷḷeri","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஒள்","tr":"oḷ"},{"kind":"nirai","text":"ளெரி","tr":"ḷeri"}]}],[{"text":"என்புற","tr":"eṉpuṟa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nirai","text":"புற","tr":"puṟa"}]},{"text":"நலியினும்","tr":"naliyiṉum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நலி","tr":"nali"},{"kind":"nirai","text":"யினும்","tr":"yiṉum"}]},{"text":"அவரொடு","tr":"avaroṭu","foot":"karuviḷam","acai":[{"kind":"n