{"text":"kuruntokai","n":361,"lines":["அம்ம வாழி தோழி அன்னைக்","குயர்நிலை உலகமுஞ் சிறிதால் அவர்மலை","மாலைப் பெய்த மணங்கமழ் உந்தியொடு","காலை வந்த காந்தள் முழுமுதல்","மெல்லிலை குழைய முயங்கலும்","இல்லுய்த்து நடுதலுங் கடியா தோளே"],"tr":["amma vāḻi tōḻi aṉṉaik","kuyarnilai ulakamuñ ciṟitāl avarmalai","mālaip peyta maṇaṅkamaḻ untiyoṭu","kālai vanta kāntaḷ muḻumutal","mellilai kuḻaiya muyaṅkalum","illuyttu naṭutaluṅ kaṭiyā tōḷē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"கபிலர்","speaker_en":"the heroine (talaivi)","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 10, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அம்ம","tr":"amma","foot":"tēmā","acai":[{"kind":"nēr","text":"அம்","tr":"am"},{"kind":"nēr","text":"ம","tr":"ma"}]},{"text":"வாழி","tr":"vāḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"அன்னைக்","tr":"aṉṉaik","foot":"tēmā","acai":[{"kind":"nēr","text":"அன்","tr":"aṉ"},{"kind":"nēr","text":"னைக்","tr":"ṉaik"}]}],[{"text":"குயர்நிலை","tr":"kuyarnilai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குயர்","tr":"kuyar"},{"kind":"nirai","text":"நிலை","tr":"nilai"}]},{"text":"உலகமுஞ்","tr":"ulakamuñ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"உல","tr":"ula"},{"kind":"nirai","text":"கமுஞ்","tr":"kamuñ"}]},{"text":"சிறிதால்","tr":"ciṟitāl","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிறி","tr":"ciṟi"},{"kind":"nēr","text":"தால்","tr":"tāl"}]},{"text":"அவர்மலை","tr":"avarmalai","foot":"karuviḷam","acai":[{"kind":"ni