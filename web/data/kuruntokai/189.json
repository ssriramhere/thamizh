{"text":"kuruntokai","n":189,"lines":["இன்றே சென்று வருவது நாளைக்","குன்றிழி அருவியின் வெண்டேர் முடுக","இளம்பிறை யன்ன விளங்குசுடர் நேமி","விசும்புவீழ் கொள்ளியிற் பைம்பயிர் துமிப்பக்","காலியற் செலவின் மாலை எய்திச்","சின்னிரை வால்வளைக் குறுமகள்","பன்மா ணாக மணந்துவக் கும்மே"],"tr":["iṉṟē ceṉṟu varuvatu nāḷaik","kuṉṟiḻi aruviyiṉ veṇṭēr muṭuka","iḷampiṟai yaṉṉa viḷaṅkucuṭar nēmi","vicumpuvīḻ koḷḷiyiṟ paimpayir tumippak","kāliyaṟ celaviṉ mālai eytic","ciṉṉirai vālvaḷaik kuṟumakaḷ","paṉmā ṇāka maṇantuvak kummē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவன் கூற்று","poet_ta":"மதுரை ஈழத்துப் பூதன்தேவனார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Maturai Īḻattup Pūtaṉtēvaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 15, āciriyattaḷai 11"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இன்றே","tr":"iṉṟē","foot":"tēmā","acai":[{"kind":"nēr","text":"இன்","tr":"iṉ"},{"kind":"nēr","text":"றே","tr":"ṟē"}]},{"text":"சென்று","tr":"ceṉṟu","foot":"tēmā","acai":[{"kind":"nēr","text":"சென்","tr":"ceṉ"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"வருவது","tr":"varuvatu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வரு","tr":"varu"},{"kind":"nirai","text":"வது","tr":"vatu"}]},{"text":"நாளைக்","tr":"nāḷaik","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"ளைக்","tr":"ḷaik"}]}],[{"text":"குன்றிழி","tr":"kuṉṟiḻi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"குன்","tr":"kuṉ"},{"kind":"nirai","text":"றிழி","tr":"ṟiḻi"}]},{"text":"அருவியின்","tr":"aruviyiṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அரு","tr":"aru"},{"kind":"nirai","text":"வியின்","tr":"viyiṉ"}]},{"text":"வெண்டேர்","tr":"veṇṭēr","foot":"tēmā","acai":[{"kind":"nēr","text":"வெண்","tr":"veṇ