}]},{"words":[{"surface":"இளம்பிறை","parts":[{"text":"இளம்பிறை","lemma":"இளம்பிறை","gloss":"young crescent moon"}],"gloss":"young crescent moon","split_unverified":true},{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"aṉṉa","gloss":"like"}],"gloss":"like"},{"surface":"விளங்குசுடர்","parts":[{"text":"விளங்கு","lemma":"viḷaṅku","gloss":"shining"},{"text":"சுடர்","lemma":"cuṭar","gloss":"glow"}],"gloss":"shining glow"},{"surface":"நேமி","parts":[{"text":"நேமி","lemma":"nēmi","gloss":"wheel"}],"gloss":"wheel"}]},{"words":[{"surface":"விசும்புவீழ்","parts":[{"text":"விசும்பு","lemma":"vicumpu","gloss":"sky"},{"text":"வீழ்","lemma":"vīḻ","gloss":"falling"}],"gloss":"falling from the sky"},{"surface":"கொள்ளியின்","parts":[{"text":"கொள்ளி","lemma":"koḷḷi","gloss":"meteor"},{"text":"இன்","lemma":"iṉ","gloss":"like"}],"gloss":"like a meteor"},{"surface":"பைம்பயிர்","parts":[{"text":"பைம்பயிர்","lemma":"பைம்பயிர்","gloss":"green crops"}],"gloss":"green crops","split_unverified":true},{"surface":"துமிப்ப","parts":[{"text":"துமிப்ப","lemma":"tumi","gloss":"to slice"}],"gloss":"slicing through"}]},{"words":[{"surface":"காலியல்","parts":[{"text":"கால்","lemma":"kāl","gloss":"wind"},{"text":"இயல்","lemma":"iyal","gloss":"nature"}],"gloss":"wind-like speed"},{"surface":"செலவின்","parts":[{"text":"செலவு","lemma":"celavu","gloss":"journey"},{"text":"இன்","lemma":"iṉ","gloss":"with"}],"gloss":"with a journey"},{"surface":"மாலை","parts":[{"text":"மாலை","lemma":"mālai","gloss":"evening"}],"gloss":"evening"},{"surface":"எய்தி","parts":[{"text":"எய்தி","lemma":"eyti","gloss":"having reached"}],"gloss":"having reached"}]},{"words":[{"surface":"சின்னிரை","parts":[{"text":"சில்","lemma":"cil","gloss":"small"},{"text":"நிரை","lemma":"nirai","gloss":"row"}],"gloss":"small row of teeth"},{"surface":"வால்வளை","parts":[{"text":"வால்","lemma":"vāl","gloss":"white"},{"text":"வளை","lemma":"vaḷai","gloss":"bangle"}],"gloss":"white bangles"},{"surface":"குறுமகள்","parts":[{"text":"குறு","lemma":"kuṟu","gloss":"young"},{"text":"மகள்","lemma":"makaḷ","gloss":"woman"}],"gloss":"young woman"}]},{"words":[{"surface":"பன்மாணாக","parts":[{"text":"பன்மாணாக","lemma":"பன்மாணாக","gloss":"greatly"}],"gloss":"greatly","split_unverified":true},{"surface":"மணந்து","parts":[{"text":"மணந்து","lemma":"maṇ","gloss":"having embraced"}],"gloss":"having embraced"},{"surface":"உவக்கும்மே","parts":[{"text":"உவக்கும்","lemma":"uvakka","gloss":"will rejoice"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"she will rejoice"}]}],"literal":"Going today itself, returning tomorrow / as the white chariot hastens like a waterfall descending from a hill / its wheels of shining light resembling the young crescent moon / slicing through green crops like a meteor falling from the sky / reaching in the evening with a wind-swift journey / the young woman with a small row of teeth and white bangles / will rejoice greatly, embracing me.","translation":"If I set out today and return tomorrow, with my white chariot hastening like a waterfall descending a hill, its wheels of brilliant light resembling the young crescent moon, slicing through green crops like a meteor falling from the sky, reaching her in the evening with a wind-swift journey—the young woman with a small row of teeth and white bangles will rejoice greatly, embracing me.","modern":"இன்றே புறப்பட்டு நாளைக்கே திரும்பி வருவது சாத்தியம். குன்றிலிருந்து இறங்கும் அருவியைப் போல வெண்மையான தேர் வேகமாக ஓட, இளம்பிறை போன்ற விளங்கும் ஒளியையுடைய சக்கரங்கள், வானத்திலிருந்து விழும் கொள்ளிமீனைப் போலப் பசிய பயிர்களை அறுத்துக்கொண்டு செல்ல, காற்றின் வேகத்தைக் கொண்ட பயணத்தால் மாலைப் பொழுதில் அவளை அடைந்து, சிறிய வரிசையான பற்களையும் வெண்மையான வளையல்களையும் உடைய இளமகள் பலவாறாகத் தழுவி மகிழ்வாள்.","explanation":"The hero speaks to his charioteer, expressing his eager desire to return to his beloved immediately after completing his mission. He describes the incredible speed of his journey, comparing his white chariot to a rushing mountain waterfall and its glowing wheels to the crescent moon. The chariot's rapid movement through the green fields is likened to a meteor slicing through the sky, emphasizing his urgency. Upon reaching home by evening, he envisions his young wife, adorned with white bangles, embracing him with immense joy. This poem belongs to the Pālai tiṇai, where the pain of separation is resolved by the swift and passionate return of the lover.","model":"gemini-3.5-flash"},"timing":{"male":[[0.1,0.4],[0.5,0.9],[0.9,1.2],[1.2,1.65],[1.65,2.0],[2.0,2.4],[2.4,2.65],[2.78,3.1],[3.1,4.2],[4.25,4.4],[4.4,5.1],[5.1,5.2],[5.2,6.6],[6.6,7.37],[7.37,7.37],[7.37,8.9],[8.9,8.9],[8.9,9.3],[9.3,9.4],[9.4,9.4],[9.4,9.4],[9.4,9.4],[9.4,11.8],[11.8,12.61],[12.78,13.1],[13.1,13.61],[13.61,13.8]],"female":[[0.0,0.48],[0.6,1.0],[1.0,1.4],[1.4,1.92],[1.92,2.7],[2.7,3.1],[3.1,3.5],[3.5,3.9],[3.9,4.35],[4.35,4.8],[4.8,6.1],[6.1,6.2],[6.2,7.84],[7.84,7.84],[7.84,7.84],[7.84,8.86],[8.86,9.2],[9.2,10.7],[10.7,10.8],[10.8,11.87],[12.0,12.4],[12.4,13.03],[13.07,13.1],[13.1,13.1],[13.1,13.1],[13.1,13.1],[13.1,15.6]]},"sync":[[["இன்றே","today itself"]],[["சென்று","having gone"]],[["வருவது","returning"]],[["நாளை","tomorrow"]],[["குன்றிழி","descending from the hill"]],[["அருவியின்","like a waterfall"]],[["வெண்டேர்","white chariot"]],[["முடுக","to hasten"]],[["இளம்பிறை","young crescent moon"]],[["அன்ன","like"]],[["விளங்குசுடர்","shining glow"]],[["நேமி","wheel"]],[["விசும்புவீழ்","falling from the sky"]],[["கொள்ளியின்","like a meteor"]],[["பைம்பயிர்","green crops"]],[["துமிப்ப","slicing through"]],[["காலியல்","wind-like speed"]],[["செலவின்","with a journey"]],[["மாலை","evening"]],[["எய்தி","having reached"]],[["சின்னிரை","small row of teeth"]],[["வால்வளை","white bangles"],["குறுமகள்","young woman"]],[["குறுமகள்","young woman"]],[["பன்மாணாக","greatly"]],[["பன்மாணாக","greatly"]],[["மணந்து","having embraced"],["உவக்கும்மே","she will rejoice"]],[["உவக்கும்மே","she will rejoice"]]]}