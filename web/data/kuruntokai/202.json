{"text":"kuruntokai","n":202,"lines":["நோமென் னெஞ்சே நோமென் னெஞ்சே","புன்புலத் தமன்ற சிறியிலை நெருஞ்சிக்","கட்கின் புதுமலர் முட்பயந் தாஅங்","கினிய செய்தநங் காதலர்","இன்னா செய்தல் நோமென் னெஞ்சே"],"tr":["nōmeṉ ṉeñcē nōmeṉ ṉeñcē","puṉpulat tamaṉṟa ciṟiyilai neruñcik","kaṭkiṉ putumalar muṭpayan tāaṅ","kiṉiya ceytanaṅ kātalar","iṉṉā ceytal nōmeṉ ṉeñcē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தலைவி கூற்று","poet_ta":"அள்ளூர் நன்முல்லையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Aḷḷūr Naṉmullaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 7"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நோமென்","tr":"nōmeṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"நோ","tr":"nō"},{"kind":"nēr","text":"மென்","tr":"meṉ"}]},{"text":"னெஞ்சே","tr":"ṉeñcē","foot":"tēmā","acai":[{"kind":"nēr","text":"னெஞ்","tr":"ṉeñ"},{"kind":"nēr","text":"சே","tr":"cē"}]},{"text":"நோமென்","tr":"nōmeṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"நோ","tr":"nō"},{"kind":"nēr","text":"மென்","tr":"meṉ"}]},{"text":"னெஞ்சே","tr":"ṉeñcē","foot":"tēmā","acai":[{"kind":"nēr","text":"னெஞ்","tr":"ṉeñ"},{"kind":"nēr","text":"சே","tr":"cē"}]}],[{"text":"புன்புலத்","tr":"puṉpulat","foot":"kūviḷam","acai":[{"kind":"nēr","text":"புன்","tr":"puṉ"},{"kind":"nirai","text":"புலத்","tr":"pulat"}]},{"text":"தமன்ற","tr":"tamaṉṟa","foot":"puḷimā","acai":[{"kind":"nirai","text":"தமன்","tr":"tamaṉ"},{"kind":"nēr","text":"ற","tr":"ṟa"}]},{"text":"சிறியிலை","tr":"ciṟiyilai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சிறி","tr":"ciṟi"},{"kind":"nirai","text":"யிலை","tr":"yilai"}]},{"text":"நெருஞ்சிக்","tr":"neruñcik","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெருஞ்","tr":"neruñ"},{"kind":"nēr","text":"சிக்","tr":"cik"}