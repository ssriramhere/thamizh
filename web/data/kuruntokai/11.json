{"text":"kuruntokai","n":11,"lines":["கோடீர் இலங்குவளை ஞெகிழ நாடொறும்","பாடில கலிழும் கண்ணொடு புலம்பி","ஈங்கிவண் உறைதலும் உய்குவம் ஆங்கே","எழுவினி வாழியென் னெஞ்சே முனாஅது","குல்லைக் கண்ணி வடுகர் முனையது","வல்வேற் கட்டி நன்னாட் டும்பர்","மொழிபெயர் தேஎத்த ராயினும்","வழிபடல் சூழ்ந்திசின் அவருடை நாட்டே"],"tr":["kōṭīr ilaṅkuvaḷai ñekiḻa nāṭoṟum","pāṭila kaliḻum kaṇṇoṭu pulampi","īṅkivaṇ uṟaitalum uykuvam āṅkē","eḻuviṉi vāḻiyeṉ ṉeñcē muṉāatu","kullaik kaṇṇi vaṭukar muṉaiyatu","valvēṟ kaṭṭi naṉṉāṭ ṭumpar","moḻipeyar tēetta rāyiṉum","vaḻipaṭal cūḻnticiṉ avaruṭai nāṭṭē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"மாமூலனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Māmūlaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 29, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 17, āciriyattaḷai 12, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கோடீர்","tr":"kōṭīr","foot":"tēmā","acai":[{"kind":"nēr","text":"கோ","tr":"kō"},{"kind":"nēr","text":"டீர்","tr":"ṭīr"}]},{"text":"இலங்குவளை","tr":"ilaṅkuvaḷai","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"இலங்","tr":"ilaṅ"},{"kind":"nirai","text":"குவ","tr":"kuva"},{"kind":"nēr","text":"ளை","tr":"ḷai"}]},{"text":"ஞெகிழ","tr":"ñekiḻa","foot":"puḷimā","acai":[{"kind":"nirai","text":"ஞெகி","tr":"ñeki"},{"kind":"nēr","text":"ழ","tr":"ḻa"}]},{"text":"நாடொறும்","tr":"nāṭoṟum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nirai","text":"டொறும்","tr":"ṭoṟum"}]}],[{"text":"பாடில","tr":"pāṭila","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nirai","text":"டில","tr":"ṭila"}]},{"text":"கலிழும்","tr":"kaliḻum","foot":"puḷimā","acai":[{"kind":"nirai","text":"கலி","tr":"kali"},{"kind":"nēr","text":"ழும்","tr":"ḻum"}]},{"text":