{"text":"kuruntokai","n":141,"lines":["வளைவாய்ச் சிறுகிளி விளைதினைக் கடீஇயர்","செல்கென் றோளே அன்னை எனநீ","சொல்லின் எவனோ தோழி கொல்லை","நெடுங்கை வன்மான் கடும்பகை யுழந்த","குறுங்கை யிரும்புலிக் கொலைவல் ஏற்றை","பைங்கட் செந்நாய் படுபதம் பார்க்கும்","ஆரிரு ணடுநாள் வருதி","சாரல் நாட வாரலோ எனவே"],"tr":["vaḷaivāyc ciṟukiḷi viḷaitiṉaik kaṭīiyar","celkeṉ ṟōḷē aṉṉai eṉanī","colliṉ evaṉō tōḻi kollai","neṭuṅkai vaṉmāṉ kaṭumpakai yuḻanta","kuṟuṅkai yirumpulik kolaival ēṟṟai","paiṅkaṭ cennāy paṭupatam pārkkum","āriru ṇaṭunāḷ varuti","cāral nāṭa vāralō eṉavē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"மதுரைப் பெருங்கொல்லனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Maturaip Peruṅkollaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 31"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 19, veṇṭaḷai 11"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வளைவாய்ச்","tr":"vaḷaivāyc","foot":"puḷimā","acai":[{"kind":"nirai","text":"வளை","tr":"vaḷai"},{"kind":"nēr","text":"வாய்ச்","tr":"vāyc"}]},{"text":"சிறுகிளி","tr":"ciṟukiḷi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nirai","text":"கிளி","tr":"kiḷi"}]},{"text":"விளைதினைக்","tr":"viḷaitiṉaik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விளை","tr":"viḷai"},{"kind":"nirai","text":"தினைக்","tr":"tiṉaik"}]},{"text":"கடீஇயர்","tr":"kaṭīiyar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கடீ","tr":"kaṭī"},{"kind":"nirai","text":"இயர்","tr":"iyar"}]}],[{"text":"செல்கென்","tr":"celkeṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"செல்","tr":"cel"},{"kind":"nēr","text":"கென்","tr":"keṉ"}]},{"text":"றோளே","tr":"ṟōḷē","foot":"tēmā","acai":[{"kind":"nēr","text":"றோ","tr":"ṟō"},{"kind":"nēr","text":"ளே","tr":"ḷē"}]},{"text":"அன்னை","tr":"aṉṉai","