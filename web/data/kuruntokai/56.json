{"text":"kuruntokai","n":56,"lines":["வேட்டச் செந்நாய் கிளைத்தூண் மிச்சில்","குளவி மொய்த்த அழுகற் சின்னீர்","வளையுடைக் கைய ளெம்மோ டுணீஇயர்","வருகதில் அம்ம தானே","அளியளோ அளியளெந் நெஞ்சமர்ந் தோளே"],"tr":["vēṭṭac cennāy kiḷaittūṇ miccil","kuḷavi moytta aḻukaṟ ciṉṉīr","vaḷaiyuṭaik kaiya ḷemmō ṭuṇīiyar","varukatil amma tāṉē","aḷiyaḷō aḷiyaḷen neñcamarn tōḷē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவன் கூற்று","poet_ta":"சிறைக்குடி ஆந்தையார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Ciṟaikkuṭi Āntaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 10, āciriyattaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வேட்டச்","tr":"vēṭṭac","foot":"tēmā","acai":[{"kind":"nēr","text":"வேட்","tr":"vēṭ"},{"kind":"nēr","text":"டச்","tr":"ṭac"}]},{"text":"செந்நாய்","tr":"cennāy","foot":"tēmā","acai":[{"kind":"nēr","text":"செந்","tr":"cen"},{"kind":"nēr","text":"நாய்","tr":"nāy"}]},{"text":"கிளைத்தூண்","tr":"kiḷaittūṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிளைத்","tr":"kiḷait"},{"kind":"nēr","text":"தூண்","tr":"tūṇ"}]},{"text":"மிச்சில்","tr":"miccil","foot":"tēmā","acai":[{"kind":"nēr","text":"மிச்","tr":"mic"},{"kind":"nēr","text":"சில்","tr":"cil"}]}],[{"text":"குளவி","tr":"kuḷavi","foot":"puḷimā","acai":[{"kind":"nirai","text":"குள","tr":"kuḷa"},{"kind":"nēr","text":"வி","tr":"vi"}]},{"text":"மொய்த்த","tr":"moytta","foot":"tēmā","acai":[{"kind":"nēr","text":"மொய்த்","tr":"moyt"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"அழுகற்","tr":"aḻukaṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"அழு","tr":"aḻu"},{"kind":"nēr","text":"கற்","tr":"kaṟ"}]},{"text":"சின்னீர்","tr":"ciṉṉīr","foot":"tēmā","acai":[{"kind":"nēr","text":"சின்","tr":"ciṉ"},{"kind":"nēr","text":"னீர்","tr":"ṉīr"}]}],[