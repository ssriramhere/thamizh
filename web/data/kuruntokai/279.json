{"text":"kuruntokai","n":279,"lines":["திரிமருப் பெருமை யிருணிற மையான்","வரிமிடறு யாத்த பகுவாய்த் தெண்மணி","புலம்புகொள் யாமத் தியங்குதொ றிசைக்கும்","இதுபொழு தாகவும் வாரார் கொல்லோ","மழைகழூஉ மறந்த மாயிருந் துறுகல்","துகள்சூழ் யானையிற் பொலியத் தோன்றும்","இரும்பல் குன்றம் போகித்","திருந்திறைப் பணைத்தோள் உள்ளா தோரே"],"tr":["tirimarup perumai yiruṇiṟa maiyāṉ","varimiṭaṟu yātta pakuvāyt teṇmaṇi","pulampukoḷ yāmat tiyaṅkuto ṟicaikkum","itupoḻu tākavum vārār kollō","maḻaikaḻūu maṟanta māyirun tuṟukal","tukaḷcūḻ yāṉaiyiṟ poliyat tōṉṟum","irumpal kuṉṟam pōkit","tiruntiṟaip paṇaittōḷ uḷḷā tōrē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"மதுரை மருதனிளநாகனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Maturai Marutaṉiḷanākaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 14, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"திரிமருப்","tr":"tirimarup","foot":"karuviḷam","acai":[{"kind":"nirai","text":"திரி","tr":"tiri"},{"kind":"nirai","text":"மருப்","tr":"marup"}]},{"text":"பெருமை","tr":"perumai","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெரு","tr":"peru"},{"kind":"nēr","text":"மை","tr":"mai"}]},{"text":"யிருணிற","tr":"yiruṇiṟa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"யிரு","tr":"yiru"},{"kind":"nirai","text":"ணிற","tr":"ṇiṟa"}]},{"text":"மையான்","tr":"maiyāṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"மை","tr":"mai"},{"kind":"nēr","text":"யான்","tr":"yāṉ"}]}],[{"text":"வரிமிடறு","tr":"varimiṭaṟu","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"வரி","tr":"vari"},{"kind":"nirai","text":"மிட","tr":"miṭa"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"யாத்த","tr":"yātta","foot":"tēmā","acai":[{"kind":"nēr","text":"