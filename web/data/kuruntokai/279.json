mma":"யிருணிற","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மையான்","parts":[{"text":"மையான்","lemma":"மையான்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"வரி","parts":[{"text":"வரி","lemma":"vari","gloss":"stripe/line"}],"gloss":"lined"},{"surface":"மிடறு","parts":[{"text":"மிடறு","lemma":"miṭaṟu","gloss":"throat"}],"gloss":"throat"},{"surface":"யாத்த","parts":[{"text":"யா","lemma":"yā","gloss":"tie"},{"text":"த்","lemma":"t","gloss":"past tense marker"},{"text":"த்","lemma":"t","gloss":"past tense marker"},{"text":"அ","lemma":"a","gloss":"adjectival suffix"}],"gloss":"tied"},{"surface":"பகு","parts":[{"text":"பகு","lemma":"paku","gloss":"split/wide"}],"gloss":"wide-open"},{"surface":"வாய்","parts":[{"text":"வாய்","lemma":"vāy","gloss":"mouth"}],"gloss":"mouth"},{"surface":"தெண்மணி","parts":[{"text":"தெண்மணி","lemma":"தெண்மணி","gloss":"clear-sounding bell"}],"gloss":"clear-sounding bell","split_unverified":true}]},{"words":[{"surface":"புலம்பு","parts":[{"text":"புலம்பு","lemma":"pulampu","gloss":"loneliness"}],"gloss":"loneliness"},{"surface":"கொள்","parts":[{"text":"கொள்","lemma":"koḷ","gloss":"hold/have"}],"gloss":"having"},{"surface":"யாமத்து","parts":[{"text":"யாமத்து","lemma":"யாமத்து","gloss":"of midnight"}],"gloss":"of midnight","split_unverified":true},{"surface":"இயங்குதொறு","parts":[{"text":"இயங்கு","lemma":"iyaṅku","gloss":"move"},{"text":"தொறு","lemma":"toṟu","gloss":"every time"}],"gloss":"whenever moving"},{"surface":"இசைக்கும்","parts":[{"text":"இசை","lemma":"icai","gloss":"sound"},{"text":"க்கும்","lemma":"kkum","gloss":"habitual future suffix"}],"gloss":"will sound"}]},{"words":[{"surface":"இது","parts":[{"text":"இது","lemma":"itu","gloss":"this"}],"gloss":"this"},{"surface":"பொழுது","parts":[{"text":"பொழுது","lemma":"poḷutu","gloss":"time"}],"gloss":"time"},{"surface":"ஆகவும்","parts":[{"text":"ஆகு","lemma":"āku","gloss":"become"},{"text":"அ","lemma":"a","gloss":"infinitive suffix"},{"text":"உம்","lemma":"um","gloss":"even"}],"gloss":"even as it becomes"},{"surface":"வாரார்","parts":[{"text":"வாரார்","lemma":"வாரார்","gloss":"he does not return"}],"gloss":"he does not return","split_unverified":true},{"surface":"கொல்லோ","parts":[{"text":"கொல்","lemma":"kol","gloss":"particle of doubt"},{"text":"ஓ","lemma":"ō","gloss":"clitic of lament"}],"gloss":"alas, will he?"}]},{"words":[{"surface":"மழை","parts":[{"text":"மழை","lemma":"maḻai","gloss":"rain"}],"gloss":"rain"},{"surface":"கழூஉ","parts":[{"text":"கழூஉ","lemma":"கழூஉ","gloss":"having washed"}],"gloss":"having washed","split_unverified":true},{"surface":"மறந்த","parts":[{"text":"மற","lemma":"maṟa","gloss":"forget"},{"text":"ந்த்","lemma":"nt","gloss":"past tense marker"},{"text":"அ","lemma":"a","gloss":"adjectival participle suffix"}],"gloss":"forgotten"},{"surface":"மா","parts":[{"text":"மா","lemma":"mā","gloss":"great"}],"gloss":"great"},{"surface":"இரும்","parts":[{"text":"இரும்","lemma":"irum","gloss":"dark/huge"}],"gloss":"dark"},{"surface":"துறுகல்","parts":[{"text":"துறு","lemma":"tuṟu","gloss":"dense/close"},{"text":"கல்","lemma":"kal","gloss":"boulder"}],"gloss":"boulder"}]},{"words":[{"surface":"துகள்","parts":[{"text":"துகள்","lemma":"tukaḷ","gloss":"dust"}],"gloss":"dust"},{"surface":"சூழ்","parts":[{"text":"சூழ்","lemma":"cūḻ","gloss":"surround"}],"gloss":"surrounded"},{"surface":"யானையின்","parts":[{"text":"யானை","lemma":"yāṉai","gloss":"elephant"},{"text":"இன்","lemma":"iṉ","gloss":"like"}],"gloss":"like an elephant"},{"surface":"பொலிய","parts":[{"text":"பொலி","lemma":"poli","gloss":"shine/appear grand"},{"text":"அ","lemma":"a","gloss":"infinitive suffix"}],"gloss":"to appear grand"},{"surface":"தோன்றும்","parts":[{"text":"தோன்று","lemma":"tōṉṟu","gloss":"appear"},{"text":"உம்","lemma":"um","gloss":"habitual future suffix"}],"gloss":"will appear"}]},{"words":[{"surface":"இரும்","parts":[{"text":"இரும்","lemma":"irum","gloss":"dark/huge"}],"gloss":"dark"},{"surface":"பல்","parts":[{"text":"பல்","lemma":"pal","gloss":"many"}],"gloss":"many"},{"surface":"குன்றம்","parts":[{"text":"குன்றம்","lemma":"kuṉṟam","gloss":"hill"}],"gloss":"hills"},{"surface":"போகி","parts":[{"text":"போ","lemma":"pō","gloss":"go"},{"text":"கி","lemma":"ki","gloss":"verbal participle suffix"}],"gloss":"having gone through"}]},{"words":[{"surface":"திருந்திறை","parts":[{"text":"திருந்து","lemma":"tiruntu","gloss":"be perfect/well-formed"},{"text":"இறை","lemma":"iṟai","gloss":"joints/forearm"}],"gloss":"well-formed forearms"},{"surface":"பணை","parts":[{"text":"பணை","lemma":"paṇai","gloss":"bamboo"}],"gloss":"bamboo-like"},{"surface":"தோள்","parts":[{"text":"தோள்","lemma":"tōḷ","gloss":"shoulders"}],"gloss":"shoulders"},{"surface":"உள்ளாதோரே","parts":[{"text":"உள்ளு","lemma":"uḷḷu","gloss":"think of"},{"text":"ஆ","lemma":"ā","gloss":"not"},{"text":"த்","lemma":"t","gloss":"euphonic insert"},{"text":"ஓர்","lemma":"ōr","gloss":"they"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"he who does not think of"}]}],"literal":"Curved-horned buffalo, dark-colored dark one, / lined throat tied wide-mouthed clear bell, / in the loneliness-having midnight, whenever moving, sounds. / Even as this time becomes, he does not return, alas! / Rain washing forgotten great dark boulder, / dust-surrounded elephant-like grandly appearing, / dark many hills having gone through, / well-formed joints bamboo-like shoulders not thinking of, he.","translation":"The clear-sounding, wide-mouthed bell tied to the lined neck of the dark-colored, curved-horned buffalo rings whenever it moves in the lonely midnight. Even though this hour has arrived, he has not returned. He who went through the many dark hills, where huge dark boulders—forgotten by the washing rains—look like dust-covered elephants, does not think of my bamboo-like shoulders with well-formed joints.","modern":"வளைந்த கொம்புகளையுடைய, இருண்ட நிறமுடைய எருமைக்கடாவின் வரிகள் நிறைந்த கழுத்தில் கட்டப்பட்ட, அகன்ற வாயையுடைய தெளிந்த ஓசையெழுப்பும் மணி, தனிமை நிறைந்த நள்ளிரவில் அது அசையும்போதெல்லாம் ஒலிக்கிறது. இந்த மாலைப் பொழுது வந்த பிறகும் அவர் இன்னும் வரவில்லையே! மழை கழுவுதலை மறந்ததால் தூசு படிந்து, புழுதி சூழ்ந்த யானையைப் போலப் பொலிவுடன் தோன்றும் பெரிய கரிய பாறைகளைக் கொண்ட பல கரிய மலைகளைக் கடந்து சென்றவர், அழகிய மூட்டுகளையும் மூங்கில் போன்ற தோள்களையும் உடைய என்னை நினைக்காமல் இருக்கிறாரே!","explanation":"This poem belongs to the Mullai (forest) landscape, which is associated with the theme of patient waiting during the rainy season. The speaker is the heroine, lamenting to her companion about the hero's delay in returning from his journey. She describes the lonely midnight hour, made even more poignant by the sound of the bell tied to the buffalo's neck as it grazes. The image of the dark boulders, unwashed by rain and covered in dust so they resemble elephants, reflects the dry, harsh landscape the hero traversed, and perhaps his hardened heart. The key words are 'வாரார் கொல்லோ' (will he not return?) and 'உள்ளாதோரே' (he who does not think of me), emphasizing her grief and longing.","model":"gemini-3.5-flash"}}