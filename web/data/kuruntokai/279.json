{"text":"kuruntokai","n":279,"lines":["திரிமருப் பெருமை யிருணிற மையான்","வரிமிடறு யாத்த பகுவாய்த் தெண்மணி","புலம்புகொள் யாமத் தியங்குதொ றிசைக்கும்","இதுபொழு தாகவும் வாரார் கொல்லோ","மழைகழூஉ மறந்த மாயிருந் துறுகல்","துகள்சூழ் யானையிற் பொலியத் தோன்றும்","இரும்பல் குன்றம் போகித்","திருந்திறைப் பணைத்தோள் உள்ளா தோரே"],"tr":["tirimarup perumai yiruṇiṟa maiyāṉ","varimiṭaṟu yātta pakuvāyt teṇmaṇi","pulampukoḷ yāmat tiyaṅkuto ṟicaikkum","itupoḻu tākavum vārār kollō","maḻaikaḻūu maṟanta māyirun tuṟukal","tukaḷcūḻ yāṉaiyiṟ poliyat tōṉṟum","irumpal kuṉṟam pōkit","tiruntiṟaip paṇaittōḷ uḷḷā tōrē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"மதுரை மருதனிளநாகனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Maturai Marutaṉiḷanākaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 14, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"திரிமருப்","tr":"tirimarup","foot":"karuviḷam","acai":[{"kind":"nirai","text":"திரி","tr":"tiri"},{"kind":"nirai","text":"மருப்","tr":"marup"}]},{"text":"பெருமை","tr":"perumai","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெரு","tr":"peru"},{"kind":"nēr","text":"மை","tr":"mai"}]},{"text":"யிருணிற","tr":"yiruṇiṟa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"யிரு","tr":"yiru"},{"kind":"nirai","text":"ணிற","tr":"ṇiṟa"}]},{"text":"மையான்","tr":"maiyāṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"மை","tr":"mai"},{"kind":"nēr","text":"யான்","tr":"yāṉ"}]}],[{"text":"வரிமிடறு","tr":"varimiṭaṟu","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"வரி","tr":"vari"},{"kind":"nirai","text":"மிட","tr":"miṭa"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"யாத்த","tr":"yātta","foot":"tēmā","acai":[{"kind":"nēr","text":"யாத்","tr":"yāt"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"பகுவாய்த்","tr":"pakuvāyt","foot":"puḷimā","acai":[{"kind":"nirai","text":"பகு","tr":"paku"},{"kind":"nēr","text":"வாய்த்","tr":"vāyt"}]},{"text":"தெண்மணி","tr":"teṇmaṇi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தெண்","tr":"teṇ"},{"kind":"nirai","text":"மணி","tr":"maṇi"}]}],[{"text":"புலம்புகொள்","tr":"pulampukoḷ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"புலம்","tr":"pulam"},{"kind":"nirai","text":"புகொள்","tr":"pukoḷ"}]},{"text":"யாமத்","tr":"yāmat","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"மத்","tr":"mat"}]},{"text":"தியங்குதொ","tr":"tiyaṅkuto","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தியங்","tr":"tiyaṅ"},{"kind":"nirai","text":"குதொ","tr":"kuto"}]},{"text":"றிசைக்கும்","tr":"ṟicaikkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"றிசைக்","tr":"ṟicaik"},{"kind":"nēr","text":"கும்","tr":"kum"}]}],[{"text":"இதுபொழு","tr":"itupoḻu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இது","tr":"itu"},{"kind":"nirai","text":"பொழு","tr":"poḻu"}]},{"text":"தாகவும்","tr":"tākavum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nirai","text":"கவும்","tr":"kavum"}]},{"text":"வாரார்","tr":"vārār","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ரார்","tr":"rār"}]},{"text":"கொல்லோ","tr":"kollō","foot":"tēmā","acai":[{"kind":"nēr","text":"கொல்","tr":"kol"},{"kind":"nēr","text":"லோ","tr":"lō"}]}],[{"text":"மழைகழூஉ","tr":"maḻaikaḻūu","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"மழை","tr":"maḻai"},{"kind":"nirai","text":"கழூ","tr":"kaḻū"},{"kind":"nēr","text":"உ","tr":"u"}]},{"text":"மறந்த","tr":"maṟanta","foot":"puḷimā","acai":[{"kind":"nirai","text":"மறந்","tr":"maṟan"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"மாயிருந்","tr":"māyirun","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"யிருந்","tr":"yirun"}]},{"text":"துறுகல்","tr":"tuṟukal","fo