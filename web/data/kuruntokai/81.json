{"text":"kuruntokai","n":81,"lines":["இவளே நின்சொற் கொண்ட என்சொல் தேறிப்","பசுநனை ஞாழற் பல்சினை ஒருசிறைப்","புதுநலன் இழந்த புலம்புமார் உடையள்","உதுக்காண் தெய்ய உள்ளல் வேண்டும்","நிலவும் இருளும் போலப் புலவுத்திரைக்","கடலும் கானலுந் தோன்றும்","மடல்தாழ் பெண்ணையெம் சிறுநல் லூரே"],"tr":["ivaḷē niṉcoṟ koṇṭa eṉcol tēṟip","pacunaṉai ñāḻaṟ palciṉai oruciṟaip","putunalaṉ iḻanta pulampumār uṭaiyaḷ","utukkāṇ teyya uḷḷal vēṇṭum","nilavum iruḷum pōlap pulavuttiraik","kaṭalum kāṉalun tōṉṟum","maṭaltāḻ peṇṇaiyem ciṟunal lūrē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"வடம வண்ணக்கண் பேரிசாத்தனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Vaṭama Vaṇṇakkaṇ Pēricāttaṉār"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"1×5, 5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, vañcicīr 1, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 9, oṉṟiya vañcittaḷai 1, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"1 five-foot line (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"இவளே","tr":"ivaḷē","foot":"puḷimā","acai":[{"kind":"nirai","text":"இவ","tr":"iva"},{"kind":"nēr","text":"ளே","tr":"ḷē"}]},{"text":"நின்சொற்","tr":"niṉcoṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"நின்","tr":"niṉ"},{"kind":"nēr","text":"சொற்","tr":"coṟ"}]},{"text":"கொண்ட","tr":"koṇṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"கொண்","tr":"koṇ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"என்சொல்","tr":"eṉcol","foot":"tēmā","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nēr","text":"சொல்","tr":"col"}]},{"text":"தேறிப்","tr":"tēṟip","foot":"tēmā","acai":[{"kind":"nēr","text":"தே","tr":"tē"},{"kind":"nēr","text":"றிப்","tr":"ṟip"}]}],[{"text":"பசுநனை","tr":"pacunaṉai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பசு","tr":"pacu"},{"kind":"nirai","text":"நனை","tr":"na