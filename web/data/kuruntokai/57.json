{"text":"kuruntokai","n":57,"lines":["பூவிடைப் படினும் யாண்டு கழிந்தன்ன","நீருறை மகன்றிற் புணர்ச்சி போலப்","பிரிவரி தாகிய தண்டாக் காமமொடு","உடனுயிர் போகுக தில்ல கடனறிந்","திருவேம் ஆகிய வுலகத்","தொருவே மாகிய புன்மை நாம் உயற்கே"],"tr":["pūviṭaip paṭiṉum yāṇṭu kaḻintaṉṉa","nīruṟai makaṉṟiṟ puṇarcci pōlap","pirivari tākiya taṇṭāk kāmamoṭu","uṭaṉuyir pōkuka tilla kaṭaṉaṟin","tiruvēm ākiya vulakat","toruvē mākiya puṉmai nām uyaṟkē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"சிறைக்குடி ஆந்தையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Ciṟaikkuṭi Āntaiyār"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"1×5, 4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2, other 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 11, āciriyattaḷai 10, kalittaḷai 1, ? 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"1 five-foot line (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"பூவிடைப்","tr":"pūviṭaip","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பூ","tr":"pū"},{"kind":"nirai","text":"விடைப்","tr":"viṭaip"}]},{"text":"படினும்","tr":"paṭiṉum","foot":"puḷimā","acai":[{"kind":"nirai","text":"படி","tr":"paṭi"},{"kind":"nēr","text":"னும்","tr":"ṉum"}]},{"text":"யாண்டு","tr":"yāṇṭu","foot":"tēmā","acai":[{"kind":"nēr","text":"யாண்","tr":"yāṇ"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"கழிந்தன்ன","tr":"kaḻintaṉṉa","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"கழிந்","tr":"kaḻin"},{"kind":"nēr","text":"தன்","tr":"taṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]}],[{"text":"நீருறை","tr":"nīruṟai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nirai","text":"ருறை","tr":"ruṟai"}]},{"text":"மகன்றிற்","tr":"makaṉṟiṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மகன்","tr":"makaṉ"},{"kind":"nēr","text":"றிற்","tr":"ṟiṟ"}]},{"text":"புணர்ச்சி","tr":"puṇ