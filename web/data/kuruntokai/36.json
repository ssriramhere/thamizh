{"text":"kuruntokai","n":36,"lines":["துறுக லயலது மாணை மாக்கொடி","துஞ்சுகளி றிவரும் குன்ற நாடன்","நெஞ்சுகள னாக நீயலென் யானென","நற்றோள் மணந்த ஞான்றை மற்றவன்","தாவா வஞ்சின முரைத்தது","நோயோ தோழி நின்வயி னானே"],"tr":["tuṟuka layalatu māṇai mākkoṭi","tuñcukaḷi ṟivarum kuṉṟa nāṭaṉ","neñcukaḷa ṉāka nīyaleṉ yāṉeṉa","naṟṟōḷ maṇanta ñāṉṟai maṟṟavaṉ","tāvā vañciṉa muraittatu","nōyō tōḻi niṉvayi ṉāṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"பரணர்","speaker_en":"the heroine (talaivi)","poet_tr":"Paraṇar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 10, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"துறுக","tr":"tuṟuka","foot":"puḷimā","acai":[{"kind":"nirai","text":"துறு","tr":"tuṟu"},{"kind":"nēr","text":"க","tr":"ka"}]},{"text":"லயலது","tr":"layalatu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"லய","tr":"laya"},{"kind":"nirai","text":"லது","tr":"latu"}]},{"text":"மாணை","tr":"māṇai","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"ணை","tr":"ṇai"}]},{"text":"மாக்கொடி","tr":"mākkoṭi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மாக்","tr":"māk"},{"kind":"nirai","text":"கொடி","tr":"koṭi"}]}],[{"text":"துஞ்சுகளி","tr":"tuñcukaḷi","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"துஞ்","tr":"tuñ"},{"kind":"nirai","text":"சுக","tr":"cuka"},{"kind":"nēr","text":"ளி","tr":"ḷi"}]},{"text":"றிவரும்","tr":"ṟivarum","foot":"puḷimā","acai":[{"kind":"nirai","text":"றிவ","tr":"ṟiva"},{"kind":"nēr","text":"ரும்","tr":"rum"}]},{"text":"குன்ற","tr":"kuṉṟa","foot":"tēmā","acai":[{"kind":"nēr","text":"குன்","tr":"kuṉ"},{"kind":"nēr","text":"ற","tr":"ṟa"}]},{"text":"நாடன்","tr":"nāṭaṉ","foot":"tēmā","acai":[{"kind"