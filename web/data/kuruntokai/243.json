{"text":"kuruntokai","n":243,"lines":["மானடி யன்ன கவட்டிலை அடும்பின்","தார்மணி யன்ன ஒண்பூக் கொழுதி","ஒண்தொடி மகளிர் வண்ட லயரும்","புள்ளிமிழ் பெருங்கடற் சேர்ப்பனை","உள்ளேன் தோழி படீஇயர்என் கண்ணே"],"tr":["māṉaṭi yaṉṉa kavaṭṭilai aṭumpiṉ","tārmaṇi yaṉṉa oṇpūk koḻuti","oṇtoṭi makaḷir vaṇṭa layarum","puḷḷimiḻ peruṅkaṭaṟ cērppaṉai","uḷḷēṉ tōḻi paṭīiyareṉ kaṇṇē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"நம்பி குட்டுவனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Nampi Kuṭṭuvaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 9, āciriyattaḷai 9"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மானடி","tr":"māṉaṭi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"னடி","tr":"ṉaṭi"}]},{"text":"யன்ன","tr":"yaṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"யன்","tr":"yaṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"கவட்டிலை","tr":"kavaṭṭilai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கவட்","tr":"kavaṭ"},{"kind":"nirai","text":"டிலை","tr":"ṭilai"}]},{"text":"அடும்பின்","tr":"aṭumpiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"அடும்","tr":"aṭum"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]}],[{"text":"தார்மணி","tr":"tārmaṇi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தார்","tr":"tār"},{"kind":"nirai","text":"மணி","tr":"maṇi"}]},{"text":"யன்ன","tr":"yaṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"யன்","tr":"yaṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"ஒண்பூக்","tr":"oṇpūk","foot":"tēmā","acai":[{"kind":"nēr","text":"ஒண்","tr":"oṇ"},{"kind":"nēr","text":"பூக்","tr":"pūk"}]},{"text":"கொழுதி","tr":"koḻuti","foot":"puḷimā","acai":[{"kind":"nirai","text":"கொழு","tr":"koḻu"},{"kind":"nēr","text":"தி","tr":"ti