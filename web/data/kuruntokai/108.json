{"text":"kuruntokai","n":108,"lines":["மழைவிளை யாடுங் குன்றுசேர் சிறுகுடிக்","கறவை கன்றுவயிற் படரப் புறவிற்","பாசிலை முல்லை ஆசில் வான்பூச்","செவ்வான் செவ்வி கொண்டன்று","உய்யேன் போல்வல் தோழி யானே"],"tr":["maḻaiviḷai yāṭuṅ kuṉṟucēr ciṟukuṭik","kaṟavai kaṉṟuvayiṟ paṭarap puṟaviṟ","pācilai mullai ācil vāṉpūc","cevvāṉ cevvi koṇṭaṉṟu","uyyēṉ pōlval tōḻi yāṉē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"வாயிலான் தேவனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Vāyilāṉ Tēvaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 4, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மழைவிளை","tr":"maḻaiviḷai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மழை","tr":"maḻai"},{"kind":"nirai","text":"விளை","tr":"viḷai"}]},{"text":"யாடுங்","tr":"yāṭuṅ","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"டுங்","tr":"ṭuṅ"}]},{"text":"குன்றுசேர்","tr":"kuṉṟucēr","foot":"kūviḷam","acai":[{"kind":"nēr","text":"குன்","tr":"kuṉ"},{"kind":"nirai","text":"றுசேர்","tr":"ṟucēr"}]},{"text":"சிறுகுடிக்","tr":"ciṟukuṭik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nirai","text":"குடிக்","tr":"kuṭik"}]}],[{"text":"கறவை","tr":"kaṟavai","foot":"puḷimā","acai":[{"kind":"nirai","text":"கற","tr":"kaṟa"},{"kind":"nēr","text":"வை","tr":"vai"}]},{"text":"கன்றுவயிற்","tr":"kaṉṟuvayiṟ","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"கன்","tr":"kaṉ"},{"kind":"nirai","text":"றுவ","tr":"ṟuva"},{"kind":"nēr","text":"யிற்","tr":"yiṟ"}]},{"text":"படரப்","tr":"paṭarap","foot":"puḷimā","acai":[{"kind":"nirai","text":"பட","tr":"paṭa"},{"kind":"nēr","text":"ரப்","tr":"rap"}]},{"text":"புறவிற்","tr":"puṟaviṟ","f