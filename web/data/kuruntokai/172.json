{"text":"kuruntokai","n":172,"lines":["தாஅ வலஞ்சிறை நொப்பறை வாவல்","பழுமரம் படரும் பையுன் மாலை","எமிய மாக ஈங்குத் துறந்தோர்","தமிய ராக இனியர் கொல்லோ","ஏழூர்ப் பொதுவினைக் கோரூர் யாத்த","உலைவாங்கு மிதிதோல் போலத்","தலைவரம் பறியாது வருந்துமென் னெஞ்சே"],"tr":["tāa valañciṟai noppaṟai vāval","paḻumaram paṭarum paiyuṉ mālai","emiya māka īṅkut tuṟantōr","tamiya rāka iṉiyar kollō","ēḻūrp potuviṉaik kōrūr yātta","ulaivāṅku mititōl pōlat","talaivaram paṟiyātu varuntumeṉ ṉeñcē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"கச்சிப்பேட்டு நன்னாகையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kaccippēṭṭu Naṉṉākaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 13, āciriyattaḷai 11, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"தாஅ","tr":"tāa","foot":"tēmā","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"அ","tr":"a"}]},{"text":"வலஞ்சிறை","tr":"valañciṟai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வலஞ்","tr":"valañ"},{"kind":"nirai","text":"சிறை","tr":"ciṟai"}]},{"text":"நொப்பறை","tr":"noppaṟai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நொப்","tr":"nop"},{"kind":"nirai","text":"பறை","tr":"paṟai"}]},{"text":"வாவல்","tr":"vāval","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"வல்","tr":"val"}]}],[{"text":"பழுமரம்","tr":"paḻumaram","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பழு","tr":"paḻu"},{"kind":"nirai","text":"மரம்","tr":"maram"}]},{"text":"படரும்","tr":"paṭarum","foot":"puḷimā","acai":[{"kind":"nirai","text":"பட","tr":"paṭa"},{"kind":"nēr","text":"ரும்","tr":"rum"}]},{"text":"பையுன்","tr":"paiyuṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"பை","tr":"pai"},{"kind":"nēr","text":"யு