e"}],"gloss":"we who are lonely"},{"surface":"ஆக","parts":[{"text":"ஆ","lemma":"ஆ","gloss":"become"},{"text":"க","lemma":"க","gloss":"as"}],"gloss":"being"},{"surface":"ஈங்கு","parts":[{"text":"ஈங்கு","lemma":"ஈங்கு","gloss":"here"}],"gloss":"here"},{"surface":"துறந்தோர்","parts":[{"text":"துறந்தோர்","lemma":"துறந்தோர்","gloss":"he who abandoned"}],"gloss":"he who abandoned","split_unverified":true}]},{"words":[{"surface":"தமியர்","parts":[{"text":"தமி","lemma":"தமி","gloss":"solitude"},{"text":"அர்","lemma":"அர்","gloss":"he"}],"gloss":"he who is alone"},{"surface":"ஆக","parts":[{"text":"ஆ","lemma":"ஆ","gloss":"become"},{"text":"க","lemma":"க","gloss":"as"}],"gloss":"being"},{"surface":"இனியர்","parts":[{"text":"இனி","lemma":"இனி","gloss":"sweet"},{"text":"அர்","lemma":"அர்","gloss":"he"}],"gloss":"is he happy?"},{"surface":"கொல்லோ","parts":[{"text":"கொல்","lemma":"கொல்","gloss":"doubt particle"},{"text":"ஓ","lemma":"ஓ","gloss":"interrogative clitic"}],"gloss":"I wonder"}]},{"words":[{"surface":"ஏழூர்","parts":[{"text":"ஏழு","lemma":"ஏழு","gloss":"seven"},{"text":"ஊர்","lemma":"ஊர்","gloss":"village"}],"gloss":"of seven villages"},{"surface":"பொதுவினைக்கு","parts":[{"text":"பொது","lemma":"பொது","gloss":"common"},{"text":"வினை","lemma":"வினை","gloss":"work"},{"text":"கு","lemma":"கு","gloss":"dative suffix"}],"gloss":"for the common work"},{"surface":"ஓர்","parts":[{"text":"ஓர்","lemma":"ஓர்","gloss":"one"}],"gloss":"one"},{"surface":"ஊர்","parts":[{"text":"ஊர்","lemma":"ஊர்","gloss":"village"}],"gloss":"village"},{"surface":"யாத்த","parts":[{"text":"யாத்த","lemma":"யா","gloss":"bound"}],"gloss":"bound"}]},{"words":[{"surface":"உலைவாங்கு","parts":[{"text":"உலை","lemma":"உலை","gloss":"forge"},{"text":"வாங்கு","lemma":"வாங்கு","gloss":"draw"}],"gloss":"drawn in the forge"},{"surface":"மிதிதோல்","parts":[{"text":"மிதி","lemma":"மிதி","gloss":"step"},{"text":"தோல்","lemma":"தோல்","gloss":"leather"}],"gloss":"stepped-on bellows"},{"surface":"போல","parts":[{"text":"போல","lemma":"போல்","gloss":"like"}],"gloss":"like"}]},{"words":[{"surface":"தலைவரம்பு","parts":[{"text":"தலை","lemma":"தலை","gloss":"head/limit"},{"text":"வரம்பு","lemma":"வரம்பு","gloss":"boundary"}],"gloss":"ultimate limit"},{"surface":"அறியாது","parts":[{"text":"அறி","lemma":"அறி","gloss":"know"},{"text":"ஆது","lemma":"ஆது","gloss":"without"}],"gloss":"not knowing"},{"surface":"வருந்தும்","parts":[{"text":"வருந்து","lemma":"வருந்து","gloss":"suffer"},{"text":"உம்","lemma":"உம்","gloss":"relative participle suffix"}],"gloss":"suffering"},{"surface":"என்","parts":[{"text":"என்","lemma":"என்","gloss":"my"}],"gloss":"my"},{"surface":"நெஞ்சே","parts":[{"text":"நெஞ்சு","lemma":"நெஞ்சு","gloss":"heart"},{"text":"ஏ","lemma":"ஏ","gloss":"vocative/emphasis"}],"gloss":"O heart!"}]}],"literal":"Spreading strong wings, swift-flying bats / seek fruit-bearing trees in the sorrowful evening. / Leaving us lonely, he who abandoned us here, / being alone, is he happy, I wonder? / Bound to one village for the common work of seven villages, / like the bellows drawn and stepped on in a forge, / without knowing any ultimate limit, suffers my heart!","translation":"In the sorrowful evening, swift-flying bats with wide, strong wings spread out to seek fruit-bearing trees. He who abandoned me here to be lonely—is he happy, I wonder, in his own solitude? Like the leather bellows tied to a single village forge but worked constantly for the common needs of seven villages, my heart suffers, knowing no limit to its pain.","modern":"பரந்த வலிமையான சிறகுகளைக் கொண்ட, வேகமாகப் பறக்கும் வௌவால்கள் பழங்கள் நிறைந்த மரங்களைத் தேடிச் செல்லும் இந்தத் துன்பம் நிறைந்த மாலைப் பொழுதில், நம்மைத் தனியாகத் தவிக்கவிட்டுச் சென்ற தலைவர், தாமும் தனியாக இருந்து அங்கே மகிழ்ச்சியாக இருக்கிறாரா? ஏழு ஊர்களின் பொதுவான வேலைக்காக ஒரே ஊரில் கட்டப்பட்டு, உலையில் மிதித்து இயக்கப்படும் துருத்தியைப் போல, எல்லையே இல்லாமல் என் நெஞ்சம் வருந்துகிறதே!","explanation":"This poem is spoken by the heroine to her companion (or to herself) during the painful evening hours when her lover is away. She watches the bats spreading their strong wings to seek out fruit-bearing trees, a movement that highlights her own confinement and isolation. She wonders if her lover, who left her to be lonely, is finding any happiness in his own solitude. She compares her aching heart to a blacksmith's leather bellows (மிதிதோல்) that is tied to a single village forge but is continuously pumped and squeezed to serve the common metalworking needs of seven surrounding villages. Just like those bellows, her heart is bound to one place but is relentlessly compressed and stretched by endless waves of grief, knowing no boundary or relief.","model":"gemini-3.5-flash"}}