{"text":"kuruntokai","n":117,"lines":["மாரி ஆம்ப லன்ன கொக்கின்","பார்வல் அஞ்சிய பருவரல் ஈர்ஞெண்டு","கண்டல் வேரளைச் செலீஇயர் அண்டர்","கயிறரி யெருத்திற் கதழுந் துறைவன்","வாரா தமையினும் அமைக","சிறியவும் உளவீண்டு விலைஞர்கை வளையே"],"tr":["māri āmpa laṉṉa kokkiṉ","pārval añciya paruvaral īrñeṇṭu","kaṇṭal vēraḷaic celīiyar aṇṭar","kayiṟari yeruttiṟ kataḻun tuṟaivaṉ","vārā tamaiyiṉum amaika","ciṟiyavum uḷavīṇṭu vilaiñarkai vaḷaiyē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தோழி கூற்று","poet_ta":"குன்றியனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kuṉṟiyaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 20, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 8, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மாரி","tr":"māri","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"ரி","tr":"ri"}]},{"text":"ஆம்ப","tr":"āmpa","foot":"tēmā","acai":[{"kind":"nēr","text":"ஆம்","tr":"ām"},{"kind":"nēr","text":"ப","tr":"pa"}]},{"text":"லன்ன","tr":"laṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"லன்","tr":"laṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"கொக்கின்","tr":"kokkiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"கொக்","tr":"kok"},{"kind":"nēr","text":"கின்","tr":"kiṉ"}]}],[{"text":"பார்வல்","tr":"pārval","foot":"tēmā","acai":[{"kind":"nēr","text":"பார்","tr":"pār"},{"kind":"nēr","text":"வல்","tr":"val"}]},{"text":"அஞ்சிய","tr":"añciya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"அஞ்","tr":"añ"},{"kind":"nirai","text":"சிய","tr":"ciya"}]},{"text":"பருவரல்","tr":"paruvaral","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பரு","tr":"paru"},{"kind":"nirai","text":"வரல்","tr":"varal"}]},{"text":"ஈர்ஞெண்டு","tr":"īrñeṇṭu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"ஈர்","tr