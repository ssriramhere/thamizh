cai":[{"kind":"nirai","text":"நிலங்","tr":"nilaṅ"},{"kind":"nēr","text":"கொள்","tr":"koḷ"}]},{"text":"பாம்பின்","tr":"pāmpiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"பாம்","tr":"pām"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]},{"text":"இழிதரும்","tr":"iḻitarum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இழி","tr":"iḻi"},{"kind":"nirai","text":"தரும்","tr":"tarum"}]}],[{"text":"விலங்குமலை","tr":"vilaṅkumalai","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"விலங்","tr":"vilaṅ"},{"kind":"nirai","text":"கும","tr":"kuma"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"நாடனொடு","tr":"nāṭaṉoṭu","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nirai","text":"டனொ","tr":"ṭaṉo"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"கலந்த","tr":"kalanta","foot":"puḷimā","acai":[{"kind":"nirai","text":"கலந்","tr":"kalan"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"நட்பே","tr":"naṭpē","foot":"tēmā","acai":[{"kind":"nēr","text":"நட்","tr":"naṭ"},{"kind":"nēr","text":"பே","tr":"pē"}]}]]},"ai":{"lines":[{"words":[{"surface":"அம்ம","parts":[{"text":"அம்ம","lemma":"amma","gloss":"listen (particle of address)"}],"gloss":"listen"},{"surface":"வாழி","parts":[{"text":"வாழி","lemma":"vāḻi","gloss":"may you live long"}],"gloss":"may you live long"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"tōḻi","gloss":"friend"}],"gloss":"friend"},{"surface":"நம்மொடு","parts":[{"text":"நம்","lemma":"nām","gloss":"us"},{"text":"ஒடு","lemma":"oṭu","gloss":"with"}],"gloss":"with us"}]},{"words":[{"surface":"பிரிவு","parts":[{"text":"பிரிவு","lemma":"pirivu","gloss":"separation"}],"gloss":"separation"},{"surface":"இன்றாயின்","parts":[{"text":"இன்று","lemma":"iṉṟu","gloss":"without"},{"text":"ஆயின்","lemma":"āyiṉ","gloss":"if"}],"gloss":"if there is no"},{"surface":"நன்று","parts":[{"text":"நன்று","lemma":"naṉṟu","gloss":"good"}],"gloss":"good"},{"surface":"மற்று","parts":[{"text":"மற்று","lemma":"maṟṟu","gloss":"indeed (particle)"}],"gloss":"indeed"},{"surface":"இல்ல","parts":[{"text":"இல்ல","lemma":"illa","gloss":"alas (particle of regret)"}],"gloss":"alas"}]},{"words":[{"surface":"குறும்பொறை","parts":[{"text":"குறும்பொறை","lemma":"குறும்பொறை","gloss":"small hill"}],"gloss":"small hill","split_unverified":true},{"surface":"தடைஇய","parts":[{"text":"தடைஇய","lemma":"taṭai","gloss":"thick/broad"}],"gloss":"thick-trunked"},{"surface":"நெடுந்தாள்","parts":[{"text":"நெடுந்தாள்","lemma":"நெடுந்தாள்","gloss":"tall-trunked"}],"gloss":"tall-trunked","split_unverified":true},{"surface":"வேங்கை","parts":[{"text":"வேங்கை","lemma":"vēṅkai","gloss":"Vengai tree"}],"gloss":"Vengai tree"}]},{"words":[{"surface":"பூவுடை","parts":[{"text":"பூ","lemma":"pū","gloss":"flower"},{"text":"உடை","lemma":"uṭai","gloss":"having"}],"gloss":"flowering"},{"surface":"அலங்குசினை","parts":[{"text":"அலங்கு","lemma":"alaṅku","gloss":"swaying"},{"text":"சினை","lemma":"ciṉai","gloss":"branch"}],"gloss":"swaying branches"},{"surface":"புலம்ப","parts":[{"text":"புலம்ப","lemma":"pulampu","gloss":"to suffer loneliness / to be stripped"}],"gloss":"to be left desolate"},{"surface":"தாக்கி","parts":[{"text":"தாக்கி","lemma":"tākku","gloss":"striking"}],"gloss":"striking"}]},{"words":[{"surface":"கல்","parts":[{"text":"கல்","lemma":"kal","gloss":"stone/rock"}],"gloss":"rock"},{"surface":"பொருது","parts":[{"text":"பொருது","lemma":"poru","gloss":"dashing against"}],"gloss":"dashing against"},{"surface":"இரங்கும்","parts":[{"text":"இரங்கும்","lemma":"iraṅku","gloss":"roaring/sounding"}],"gloss":"roaring"},{"surface":"கதழ்","parts":[{"text":"கதழ்","lemma":"kataḻ","gloss":"swift"}],"gloss":"swift"},{"surface":"வீழ்","parts":[{"text":"வீழ்","lemma":"vīḻ","gloss":"falling"}],"gloss":"falling"},{"surface":"அருவி","parts":[{"text":"அருவி","lemma":"aruvi","gloss":"waterfall"}],"gloss":"waterfall"}]},{"words":[{"surface":"நிலங்கொள்","parts":[{"text":"நிலம்","lemma":"nilam","gloss":"ground"},{"text":"கொள்","lemma":"koḷ","gloss":"taking/crawling"}],"gloss":"crawling on the ground"},{"surface":"பாம்பின்","parts":[{"text":"பாம்பு","lemma":"pāmpu","gloss":"snake"},{"text":"இன்","lemma":"iṉ","gloss":"like (comparative suffix)"}],"gloss":"like a snake"},{"surface":"இழிதரும்","parts":[{"text":"இழி","lemma":"iḻi","gloss":"descend"},{"text":"தரும்","lemma":"taru","gloss":"giving (auxiliary verb)"}],"gloss":"descending"}]},{"words":[{"surface":"விலங்குமலை","parts":[{"text":"விலங்கு","lemma":"vilaṅku","gloss":"lying across"},{"text":"மலை","lemma":"malai","gloss":"mountain"}],"gloss":"cross-lying mountains"},{"surface":"நாடனொடு","parts":[{"text":"நாடன்","lemma":"nāṭaṉ","gloss":"lord of the land"},{"text":"ஒடு","lemma":"oṭu","gloss":"with"}],"gloss":"with the lord of the land"},{"surface":"கலந்த","parts":[{"text":"கலந்த","lemma":"kala","gloss":"mingled/united"}],"gloss":"united"},{"surface":"நட்பே","parts":[{"text":"நட்பு","lemma":"naṭpu","gloss":"friendship/love"},{"text":"ஏ","lemma":"ē","gloss":"indeed (emphasis)"}],"gloss":"indeed the love"}]}],"literal":"Listen, may you live long, friend! With us / if there is no separation, it would indeed be good, alas! / On the small hill, the thick, tall-trunked Vengai tree's / flowering, swaying branches, striking them to be left desolate, / dashing against rocks and roaring, the swiftly falling waterfall, / like a snake crawling on the ground, descends / from the land of the lord of cross-lying mountains, with whom I share this united love.","translation":"Listen, my friend, may you live long! If only there were no separation from us, how good it would be! The love I share with the lord of the mountains—where the swiftly falling waterfall dashes against rocks, roaring, striking the flowering, swaying branches of the tall, thick Vengai tree on the small hill and leaving them desolate, before descending like a snake crawling upon the ground.","modern":"தோழியே! கேள், நீ டூழி வாழ்க! குறு மலைகளில் உள்ள பருத்த, நீண்ட அடிமரத்தைக் கொண்ட வேங்கை மரத்தின் பூக்கள் நிறைந்த அசையும் கிளைகளைத் தாக்கி, அவற்றை வறிதாக்கிவிட்டு, பாறைகளில் மோதி முழக்கமிட்டு, வேகமாக வீழும் அருவியானது, தரையில் செல்லும் பாம்பைப் போல இறங்கி வரும் குறுக்கு மலைகளைக் கொண்ட நாட்டின் தலைவனுடன் நான் கொண்ட நட்பு, பிரிவில்லாமல் இருக்குமானால் அது மிகவும் நல்லது.","explanation":"The heroine is speaking to her close friend about her deep love for the hero and her anxiety over impending separation. She describes the hero's mountain country, where a powerful waterfall strikes the flowering branches of a tall Vengai tree, stripping them of their blossoms, before flowing down the slopes like a crawling snake. This vivid mountain imagery contains an implied metaphor (uḷḷuṟai) for their relationship. Just as the forceful waterfall violently shakes and desolates the delicate Vengai branches, the hero's passionate but secretive visits and his delays cause distress and loneliness to the delicate heroine. Yet, like the water that continues to flow down to the earth, her love for him remains deep and inescapable, making her wish desperately that they will never have to part.","model":"gemini-3.5-flash"}}