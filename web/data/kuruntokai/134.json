{"text":"kuruntokai","n":134,"lines":["அம்ம வாழி தோழி நம்மொடு","பிரிவின் றாயின் நன்றுமற் றில்ல","குறும்பொறைத் தடைஇய நெடுந்தாள் வேங்கைப்","பூவுடை அலங்குசினை புலம்பத் தாக்கிக்","கல்பொரு திரங்கும் கதழ்வீழ் அருவி","நிலங்கொள் பாம்பின் இழிதரும்","விலங்குமலை நாடனொடு கலந்த நட்பே"],"tr":["amma vāḻi tōḻi nammoṭu","piriviṉ ṟāyiṉ naṉṟumaṟ ṟilla","kuṟumpoṟait taṭaiiya neṭuntāḷ vēṅkaip","pūvuṭai alaṅkuciṉai pulampat tākkik","kalporu tiraṅkum kataḻvīḻ aruvi","nilaṅkoḷ pāmpiṉ iḻitarum","vilaṅkumalai nāṭaṉoṭu kalanta naṭpē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"கோவேங்கைப் பெருங்கதவனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kōvēṅkaip Peruṅkatavaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 24, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 7, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அம்ம","tr":"amma","foot":"tēmā","acai":[{"kind":"nēr","text":"அம்","tr":"am"},{"kind":"nēr","text":"ம","tr":"ma"}]},{"text":"வாழி","tr":"vāḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"நம்மொடு","tr":"nammoṭu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நம்","tr":"nam"},{"kind":"nirai","text":"மொடு","tr":"moṭu"}]}],[{"text":"பிரிவின்","tr":"piriviṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிரி","tr":"piri"},{"kind":"nēr","text":"வின்","tr":"viṉ"}]},{"text":"றாயின்","tr":"ṟāyiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"றா","tr":"ṟā"},{"kind":"nēr","text":"யின்","tr":"yiṉ"}]},{"text":"நன்றுமற்","tr":"naṉṟumaṟ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நன்","tr":"naṉ"},{"kind":"nirai","te