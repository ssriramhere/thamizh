{"text":"kuruntokai","n":293,"lines":["கள்ளிற் கேளிர் ஆத்திரை யுள்ளூர்ப்","பாளை தந்த பஞ்சியங் குறுங்காய்","ஓங்கிரும் பெண்ணை நுங்கொடு பெயரும்","ஆதி யருமன் மூதூ ரன்ன","அயவெள் ளாம்பல் அம்பகை நெறித்தழை","தித்திக் குறங்கின் ஊழ்மா றலைப்ப","வருமே சேயிழை யந்திற்","கொழுநற் காணிய அளியேன் மன்னே"],"tr":["kaḷḷiṟ kēḷir āttirai yuḷḷūrp","pāḷai tanta pañciyaṅ kuṟuṅkāy","ōṅkirum peṇṇai nuṅkoṭu peyarum","āti yarumaṉ mūtū raṉṉa","ayaveḷ ḷāmpal ampakai neṟittaḻai","tittik kuṟaṅkiṉ ūḻmā ṟalaippa","varumē cēyiḻai yantiṟ","koḻunaṟ kāṇiya aḷiyēṉ maṉṉē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தலைவி கூற்று","poet_ta":"கள்ளில் ஆத்திரையனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kaḷḷil Āttiraiyaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 31"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 20, veṇṭaḷai 10"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கள்ளிற்","tr":"kaḷḷiṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"கள்","tr":"kaḷ"},{"kind":"nēr","text":"ளிற்","tr":"ḷiṟ"}]},{"text":"கேளிர்","tr":"kēḷir","foot":"tēmā","acai":[{"kind":"nēr","text":"கே","tr":"kē"},{"kind":"nēr","text":"ளிர்","tr":"ḷir"}]},{"text":"ஆத்திரை","tr":"āttirai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஆத்","tr":"āt"},{"kind":"nirai","text":"திரை","tr":"tirai"}]},{"text":"யுள்ளூர்ப்","tr":"yuḷḷūrp","foot":"tēmā","acai":[{"kind":"nēr","text":"யுள்","tr":"yuḷ"},{"kind":"nēr","text":"ளூர்ப்","tr":"ḷūrp"}]}],[{"text":"பாளை","tr":"pāḷai","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"ளை","tr":"ḷai"}]},{"text":"தந்த","tr":"tanta","foot":"tēmā","acai":[{"kind":"nēr","text":"தந்","tr":"tan"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"பஞ்சியங்","tr":"pañciyaṅ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பஞ்","tr":"pañ"},{"kind":"nirai","