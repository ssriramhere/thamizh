{"text":"kuruntokai","n":210,"lines":["திண்டேர் நள்ளி கானத் தண்டர்","பல்லாப் பயந்த நெய்யிற் றொண்டி","முழுதுடன் விளைந்த வெண்ணெல் வெஞ்சோ","றெழுகலத் தேந்தினுஞ் சிறிதென் றோழி","பெருந்தோ ணெகிழ்த்த செல்லற்கு","விருந்துவரக் கரைந்த காக்கையது பலியே"],"tr":["tiṇṭēr naḷḷi kāṉat taṇṭar","pallāp payanta neyyiṟ ṟoṇṭi","muḻutuṭaṉ viḷainta veṇṇel veñcō","ṟeḻukalat tēntiṉuñ ciṟiteṉ ṟōḻi","peruntō ṇekiḻtta cellaṟku","viruntuvarak karainta kākkaiyatu paliyē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தோழி கூற்று","poet_ta":"காக்கை பாடினியார் நச்செள்ளையார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kākkai Pāṭiṉiyār Nacceḷḷaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 20, veṇcīr 2, vañcicīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 6, kalittaḷai 2, oṉṟiya vañcittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"திண்டேர்","tr":"tiṇṭēr","foot":"tēmā","acai":[{"kind":"nēr","text":"திண்","tr":"tiṇ"},{"kind":"nēr","text":"டேர்","tr":"ṭēr"}]},{"text":"நள்ளி","tr":"naḷḷi","foot":"tēmā","acai":[{"kind":"nēr","text":"நள்","tr":"naḷ"},{"kind":"nēr","text":"ளி","tr":"ḷi"}]},{"text":"கானத்","tr":"kāṉat","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"னத்","tr":"ṉat"}]},{"text":"தண்டர்","tr":"taṇṭar","foot":"tēmā","acai":[{"kind":"nēr","text":"தண்","tr":"taṇ"},{"kind":"nēr","text":"டர்","tr":"ṭar"}]}],[{"text":"பல்லாப்","tr":"pallāp","foot":"tēmā","acai":[{"kind":"nēr","text":"பல்","tr":"pal"},{"kind":"nēr","text":"லாப்","tr":"lāp"}]},{"text":"பயந்த","tr":"payanta","foot":"puḷimā","acai":[{"kind":"nirai","text":"பயந்","tr":"payan"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"நெய்யிற்","tr":"neyyiṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"நெய்","tr":"ney"},{"kind":"nēr","text":"யிற்","tr":"yiṟ"}]},{"t