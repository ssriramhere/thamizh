xt":"ஆ","tr":"ā"},{"kind":"nēr","text":"ரம்","tr":"ram"}]},{"text":"நாறு","tr":"nāṟu","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"மார்பினன்","tr":"mārpiṉaṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மார்","tr":"mār"},{"kind":"nirai","text":"பினன்","tr":"piṉaṉ"}]}],[{"text":"மாரி","tr":"māri","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"ரி","tr":"ri"}]},{"text":"யானையின்","tr":"yāṉaiyiṉ","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னை","tr":"ṉai"},{"kind":"nēr","text":"யின்","tr":"yiṉ"}]},{"text":"வந்துநின்","tr":"vantuniṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வந்","tr":"van"},{"kind":"nirai","text":"துநின்","tr":"tuniṉ"}]},{"text":"றனனே","tr":"ṟaṉaṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"றன","tr":"ṟaṉa"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"பொழுதும்","parts":[{"text":"பொழுது","lemma":"poḻutu","gloss":"daytime"},{"text":"உம்","lemma":"um","gloss":"also"}],"gloss":"the day also"},{"surface":"எல்லின்று","parts":[{"text":"எல்","lemma":"el","gloss":"sunlight"},{"text":"இன்று","lemma":"iṉṟu","gloss":"is not"}],"gloss":"has become night"},{"surface":"பெயலும்","parts":[{"text":"பெயல்","lemma":"peyal","gloss":"rain"},{"text":"உம்","lemma":"um","gloss":"also"}],"gloss":"the rain also"},{"surface":"ஓவாது","parts":[{"text":"ஓவாது","lemma":"ōvātu","gloss":"without ceasing"}],"gloss":"ceases not"}]},{"words":[{"surface":"கழுது","parts":[{"text":"கழுது","lemma":"kaḻutu","gloss":"ghoul"}],"gloss":"ghouls"},{"surface":"கண்","parts":[{"text":"கண்","lemma":"kaṇ","gloss":"eye"}],"gloss":"eyes"},{"surface":"பனிப்ப","parts":[{"text":"பனிப்ப","lemma":"pani","gloss":"to shiver"}],"gloss":"to shiver"},{"surface":"வீசும்","parts":[{"text":"வீசும்","lemma":"vīcu","gloss":"blowing"}],"gloss":"blowing"},{"surface":"அதன்","parts":[{"text":"அதன்","lemma":"atu","gloss":"that"}],"gloss":"of that"},{"surface":"தலை","parts":[{"text":"தலை","lemma":"talai","gloss":"upon"}],"gloss":"on top"}]},{"words":[{"surface":"புலி","parts":[{"text":"புலி","lemma":"puli","gloss":"tiger"}],"gloss":"tiger"},{"surface":"பல்","parts":[{"text":"பல்","lemma":"pal","gloss":"tooth"}],"gloss":"tooth"},{"surface":"தாலி","parts":[{"text":"தாலி","lemma":"tāli","gloss":"talisman"}],"gloss":"talisman"},{"surface":"புதல்வர்","parts":[{"text":"புதல்வர்","lemma":"putalvar","gloss":"children"}],"gloss":"children"},{"surface":"புல்லி","parts":[{"text":"புல்லி","lemma":"pul","gloss":"embracing"}],"gloss":"embracing"}]},{"words":[{"surface":"அன்னா","parts":[{"text":"அன்னா","lemma":"annā","gloss":"look there"}],"gloss":"look there!"},{"surface":"என்னும்","parts":[{"text":"என்னும்","lemma":"eṉ","gloss":"saying"}],"gloss":"saying"},{"surface":"அன்னையும்","parts":[{"text":"அன்னை","lemma":"annai","gloss":"mother"},{"text":"உம்","lemma":"um","gloss":"also"}],"gloss":"mother too"},{"surface":"மன்னோ","parts":[{"text":"மன்","lemma":"maṉ","gloss":"emphasis"},{"text":"ஓ","lemma":"ō","gloss":"lament"}],"gloss":"alas"}]},{"words":[{"surface":"என்","parts":[{"text":"என்","lemma":"eṉ","gloss":"what"}],"gloss":"what"},{"surface":"மலைந்தனன்கொல்","parts":[{"text":"மலைந்தனன்","lemma":"malai","gloss":"he wore"},{"text":"கொல்","lemma":"kol","gloss":"doubt"}],"gloss":"did he wear?"},{"surface":"தானே","parts":[{"text":"தான்","lemma":"tāṉ","gloss":"himself"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"himself indeed"},{"surface":"தன்","parts":[{"text":"தன்","lemma":"taṉ","gloss":"his"}],"gloss":"his"},{"surface":"மலை","parts":[{"text":"மலை","lemma":"malai","gloss":"mountain"}],"gloss":"mountain"}]},{"words":[{"surface":"ஆரம்","parts":[{"text":"ஆரம்","lemma":"āram","gloss":"sandalwood"}],"gloss":"sandalwood"},{"surface":"நாறு","parts":[{"text":"நாறு","lemma":"nāṟu","gloss":"fragrant"}],"gloss":"fragrant"},{"surface":"மார்பினன்","parts":[{"text":"மார்பு","lemma":"mārpu","gloss":"chest"},{"text":"இனன்","lemma":"iṉaṉ","gloss":"he who has"}],"gloss":"he of the chest"}]},{"words":[{"surface":"மாரி","parts":[{"text":"மாரி","lemma":"māri","gloss":"rain"}],"gloss":"rain"},{"surface":"யானையின்","parts":[{"text":"யானை","lemma":"yāṉai","gloss":"elephant"},{"text":"இன்","lemma":"iṉ","gloss":"like"}],"gloss":"like an elephant"},{"surface":"வந்து","parts":[{"text":"வந்து","lemma":"vā","gloss":"having come"}],"gloss":"having come"},{"surface":"நின்றனனே","parts":[{"text":"நின்றனன்","lemma":"nil","gloss":"he stood"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"he stood indeed"}]}],"literal":"The day also has become night, the rain also ceases not / so that even the eyes of ghouls shiver, it blows; on top of that, / embracing her children who wear tiger-tooth talismans, / saying 'Look there!', mother also is awake, alas! / What did he wear to protect himself, he of his mountain / fragrant with sandalwood chest, / having come like a rain-elephant, he stood!","translation":"The day has turned to night, and the rain pours without ceasing. The wind blows so cold that even the eyes of ghouls shiver. On top of that, mother is awake, embracing her little children who wear tiger-tooth amulets, crying out in fear, 'Look there!' Yet, what did he wear to protect himself, he whose chest smells of sandalwood from his own mountain, as he came through the dark and stood there like a rain-elephant?","modern":"பகற்பொழுதும் கழிந்து இரவாகிவிட்டது; மழையும் ஓயாமல் பெய்கிறது. பேய்களின் கண்களும் குளிரால் நடுங்கும்படி காற்று வீசுகிறது. அதோடு, புலிப்பல் தாலி அணிந்த தன் குழந்தைகளை அணைத்துக்கொண்டு, 'அங்கே பார்!' என்று அஞ்சிக் கூறும் தாயும் தூங்காமல் விழித்திருக்கிறாள். இத்தகைய நள்ளிரவில், தன் மலையின் சந்தனம் கமழும் மார்பை உடைய தலைவன், மழைக் காலத்து யானையைப் போல வந்து நின்றுவிட்டானே! அவன் தன் பாதுகாப்பிற்கு எதனைச் சூடி வந்தானோ?","explanation":"The heroine speaks to her confidante in the context of a night-tryst (iravukkuṟi). The hero has arrived at their meeting place in the dead of a stormy night, braving many dangers. The heroine expresses her deep anxiety and love, noting that the night is terrifyingly cold and dark, so much so that even ghouls shiver, and her mother is awake and fearful, clutching her young children. Despite these obstacles and the perilous path, the hero stands outside like a majestic, rain-drenched elephant, his chest fragrant with sandalwood from his own mountain. The heroine wonders what protective garland or courage he wore to survive the journey, highlighting both her fear for his safety and her admiration for his love.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,0.8],[0.8,1.3],[1.3,1.6],[1.6,3.2],[3.2,3.5],[3.5,3.6],[3.6,4.4],[4.4,5.4],[5.4,5.8],[5.8,6.8],[6.85,6.9],[6.9,7.16],[7.16,7.42],[7.42,7.94],[7.94,8.07],[8.07,8.2],[8.2,10.2],[10.2,10.4],[10.4,11.0],[11.0,11.8],[11.8,12.2],[12.2,12.7],[12.7,13.7],[13.7,13.9],[13.9,14.5],[14.5,15.0]],"female":[[0.0,0.6],[0.6,0.9],[0.9,1.3],[1.3,1.7],[1.7,3.3],[3.3,3.8],[3.8,3.9],[3.9,4.8],[4.8,5.8],[5.8,6.3],[6.3,7.0],[7.05,7.1],[7.1,8.0],[8.0,8.4],[8.4,8.87],[8.87,9.0],[9.4,10.4],[10.4,11.1],[11.1,11.3],[11.3,12.0],[12.0,12.8],[12.8,13.2],[13.2,13.6],[13.6,14.7],[14.7,14.9],[14.9,15.7],[15.7,16.3]]}}