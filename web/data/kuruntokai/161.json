{"text":"kuruntokai","n":161,"lines":["பொழுதும் எல்லின்று பெயலும் ஓவாது","கழுதுகண் பனிப்ப வீசும் அதன்றலைப்","புலிப்பல் தாலிப் புதல்வர்ப் புல்லி","அன்னா வென்னும் அன்னையு மன்னோ","என்மலைந் தனன்கொல் தானே தன்மலை","ஆரம் நாறு மார்பினன்","மாரி யானையின் வந்துநின் றனனே"],"tr":["poḻutum elliṉṟu peyalum ōvātu","kaḻutukaṇ paṉippa vīcum ataṉṟalaip","pulippal tālip putalvarp pulli","aṉṉā veṉṉum aṉṉaiyu maṉṉō","eṉmalain taṉaṉkol tāṉē taṉmalai","āram nāṟu mārpiṉaṉ","māri yāṉaiyiṉ vantuniṉ ṟaṉaṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"நக்கீரனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Nakkīraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 6, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பொழுதும்","tr":"poḻutum","foot":"puḷimā","acai":[{"kind":"nirai","text":"பொழு","tr":"poḻu"},{"kind":"nēr","text":"தும்","tr":"tum"}]},{"text":"எல்லின்று","tr":"elliṉṟu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"எல்","tr":"el"},{"kind":"nēr","text":"லின்","tr":"liṉ"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"பெயலும்","tr":"peyalum","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெய","tr":"peya"},{"kind":"nēr","text":"லும்","tr":"lum"}]},{"text":"ஓவாது","tr":"ōvātu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"ஓ","tr":"ō"},{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"கழுதுகண்","tr":"kaḻutukaṇ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கழு","tr":"kaḻu"},{"kind":"nirai","text":"துகண்","tr":"tukaṇ"}]},{"text":"பனிப்ப","tr":"paṉippa","foot":"puḷimā","acai":[{"kind":"nirai","text":"பனிப்","tr":"paṉip"},{"kind":"nēr","text":"ப","tr":"pa"}]},{"text":"வீசும்","tr":"vīcum","foot":"tēmā","a