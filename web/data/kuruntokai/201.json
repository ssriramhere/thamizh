{"text":"kuruntokai","n":201,"lines":["அமிழ்த முண்கநம் அயலி லாட்டி","பால்கலப் பன்ன தேக்கொக் கருந்துபு","நீல மென்சிறை வள்ளுகிர்ப் பறவை","நெல்லி யம்புளி மாந்தி யயலது","முள்ளி லம்பணை மூங்கிற் றூங்கும்","கழைநிவந் தோங்கிய சோலை","மலைகெழு நாடனை வருமென் றாளே"],"tr":["amiḻta muṇkanam ayali lāṭṭi","pālkalap paṉṉa tēkkok karuntupu","nīla meṉciṟai vaḷḷukirp paṟavai","nelli yampuḷi mānti yayalatu","muḷḷi lampaṇai mūṅkiṟ ṟūṅkum","kaḻainivan tōṅkiya cōlai","malaikeḻu nāṭaṉai varumeṉ ṟāḷē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","speaker_en":"the heroine (talaivi)"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 13"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அமிழ்த","tr":"amiḻta","foot":"puḷimā","acai":[{"kind":"nirai","text":"அமிழ்","tr":"amiḻ"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"முண்கநம்","tr":"muṇkanam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"முண்","tr":"muṇ"},{"kind":"nirai","text":"கநம்","tr":"kanam"}]},{"text":"அயலி","tr":"ayali","foot":"puḷimā","acai":[{"kind":"nirai","text":"அய","tr":"aya"},{"kind":"nēr","text":"லி","tr":"li"}]},{"text":"லாட்டி","tr":"lāṭṭi","foot":"tēmā","acai":[{"kind":"nēr","text":"லாட்","tr":"lāṭ"},{"kind":"nēr","text":"டி","tr":"ṭi"}]}],[{"text":"பால்கலப்","tr":"pālkalap","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பால்","tr":"pāl"},{"kind":"nirai","text":"கலப்","tr":"kalap"}]},{"text":"பன்ன","tr":"paṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"பன்","tr":"paṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"தேக்கொக்","tr":"tēkkok","foot":"tēmā","acai":[{"kind":"nēr","text":"தேக்","tr":"tēk"},{"kind":"nēr","text":"கொக்","tr":"kok"}]},{"text":"கருந்துபு","tr":"karuntupu","foot":"karuviḷam","acai":[{"kind":"nirai","text