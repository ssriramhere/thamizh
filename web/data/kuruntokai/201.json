text":"நீலம்","lemma":"nīlam","gloss":"blue"}],"gloss":"blue"},{"surface":"மென்","parts":[{"text":"மென்","lemma":"meṉ","gloss":"soft"}],"gloss":"soft"},{"surface":"சிறை","parts":[{"text":"சிறை","lemma":"ciṟai","gloss":"wing"}],"gloss":"wing"},{"surface":"வள்","parts":[{"text":"வள்","lemma":"vaḷ","gloss":"sharp"}],"gloss":"sharp"},{"surface":"உகிர்","parts":[{"text":"உகிர்","lemma":"ukir","gloss":"claw"}],"gloss":"claw"},{"surface":"பறவை","parts":[{"text":"பறவை","lemma":"paṟavai","gloss":"bird"}],"gloss":"bird"}]},{"words":[{"surface":"நெல்லி","parts":[{"text":"நெல்லி","lemma":"nelli","gloss":"gooseberry"}],"gloss":"gooseberry"},{"surface":"அம்","parts":[{"text":"அம்","lemma":"am","gloss":"beautiful"}],"gloss":"beautiful"},{"surface":"புளி","parts":[{"text":"புளி","lemma":"puḷi","gloss":"sour fruit"}],"gloss":"sour fruit"},{"surface":"மாந்தி","parts":[{"text":"மாந்து","lemma":"māntu","gloss":"gorge"},{"text":"இ","lemma":"-i","gloss":"past participle suffix"}],"gloss":"having gorged on"},{"surface":"அயலது","parts":[{"text":"அயல்","lemma":"ayal","gloss":"neighborhood"},{"text":"அது","lemma":"-atu","gloss":"pronominal suffix"}],"gloss":"of the nearby place"}]},{"words":[{"surface":"முள்","parts":[{"text":"முள்","lemma":"muḷ","gloss":"thorn"}],"gloss":"thorn"},{"surface":"இல்","parts":[{"text":"இல்","lemma":"il","gloss":"without"}],"gloss":"without"},{"surface":"அம்","parts":[{"text":"அம்","lemma":"am","gloss":"beautiful"}],"gloss":"beautiful"},{"surface":"பணை","parts":[{"text":"பணை","lemma":"paṇai","gloss":"thick branch"}],"gloss":"thick branch"},{"surface":"மூங்கில்","parts":[{"text":"மூங்கில்","lemma":"mūṅkil","gloss":"bamboo"}],"gloss":"bamboo"},{"surface":"தூங்கும்","parts":[{"text":"தூங்கு","lemma":"tūṅku","gloss":"sleep"},{"text":"உம்","lemma":"-um","gloss":"adjectival participle suffix"}],"gloss":"sleeping"}]},{"words":[{"surface":"கழை","parts":[{"text":"கழை","lemma":"kaḻai","gloss":"bamboo"}],"gloss":"bamboo"},{"surface":"நிவந்து","parts":[{"text":"நிவந்து","lemma":"நிவந்து","gloss":"having risen high"}],"gloss":"having risen high","split_unverified":true},{"surface":"ஓங்கிய","parts":[{"text":"ஓங்கு","lemma":"ōṅku","gloss":"rise high"},{"text":"இய","lemma":"-iya","gloss":"adjectival participle suffix"}],"gloss":"which rose high"},{"surface":"சோலை","parts":[{"text":"சோலை","lemma":"cōlai","gloss":"grove"}],"gloss":"grove"}]},{"words":[{"surface":"மலை","parts":[{"text":"மலை","lemma":"malai","gloss":"mountain"}],"gloss":"mountain"},{"surface":"கெழு","parts":[{"text":"கெழு","lemma":"keḻu","gloss":"possessing"}],"gloss":"possessing"},{"surface":"நாடனை","parts":[{"text":"நாடு","lemma":"nāṭu","gloss":"country"},{"text":"அன்","lemma":"-aṉ","gloss":"masculine singular suffix"},{"text":"ஐ","lemma":"-ai","gloss":"accusative case marker"}],"gloss":"the lord of the country"},{"surface":"வரும்","parts":[{"text":"வரு","lemma":"varu","gloss":"come"},{"text":"உம்","lemma":"-um","gloss":"future suffix"}],"gloss":"will come"},{"surface":"என்றாளே","parts":[{"text":"என்","lemma":"eṉ","gloss":"say"},{"text":"றாள்","lemma":"-ṟāḷ","gloss":"she (past tense)"},{"text":"ஏ","lemma":"-ē","gloss":"emphasis particle"}],"gloss":"she said"}]}],"literal":"May she eat nectar, our neighbor woman! / Having eaten sweet mango fruit like a mixture of milk, / the blue, soft-winged, sharp-clawed bird, / having gorged on the beautiful sour gooseberry, / sleeps on the nearby thornless, beautiful, thick bamboo branch / in the grove where bamboo rises high, / she said that the lord of the mountain country will come.","translation":"May our neighbor woman eat nectar! She said that the lord of the mountain country will come—the land where a blue, soft-winged, sharp-clawed bird eats sweet mangoes that taste like milk mixed together, then gorges on beautiful sour gooseberries, and falls asleep on a nearby thornless, beautiful, thick bamboo branch in a grove where bamboo rises high.","modern":"நம் பக்கத்து வீட்டுப் பெண் அமிழ்தத்தை உண்ணட்டும்! பாலில் கலந்தது போன்ற இனிமையான மாம்பழத்தை உண்டு, நீல நிற மென்மையான சிறகுகளையும் கூர்மையான நகங்களையும் உடைய பறவை, அழகிய புளிப்பான நெல்லிக்காயையும் தின்றுவிட்டு, அருகில் உள்ள முள்ளில்லாத அழகிய பருத்த மூங்கில் கிளையில் தூங்கும். அத்தகைய மூங்கில்கள் உயர்ந்து வளர்ந்த சோலைகள் நிறைந்த மலைநாட்டை உடைய தலைவன் வருவான் என்று அவள் கூறினாள்.","explanation":"The heroine is speaking to her close friend, expressing her immense joy and gratitude. A neighbor woman has brought the happy news that the hero is returning to marry the heroine. Overjoyed, the heroine blesses her, saying she deserves to eat nectar for delivering such wonderful news. The description of the mountain country contains an inner meaning (uḷḷurai) where the bird represents the hero. Just as the bird enjoys the sweet mangoes and the sour gooseberries before resting peacefully on the bamboo, the hero, after experiencing various pleasures, returns to find ultimate peace and domestic happiness with the heroine.","model":"gemini-3.5-flash"}}