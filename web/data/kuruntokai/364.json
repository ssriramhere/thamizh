{"text":"kuruntokai","n":364,"lines":["அரிற்பவர்ப் பிரம்பின் வரிப்புற நீர்நாய்","வாளை நாளிரை பெறூஉம் ஊரன்","பொற்கோல் அவிர்தொடித் தற்கெழு தகுவி","எற்புறங் கூறும் என்ப தெற்றென","வணங்கிறைப் பணைத்தோள் எல்வளை மகளிர்","துணங்கை நாளும் வந்தன அவ்வரைக்","கண்பொர மற்றதன் கண்ணவர்","மணங்கொளற் கிவரும் மள்ளர் போரே"],"tr":["ariṟpavarp pirampiṉ varippuṟa nīrnāy","vāḷai nāḷirai peṟūum ūraṉ","poṟkōl avirtoṭit taṟkeḻu takuvi","eṟpuṟaṅ kūṟum eṉpa teṟṟeṉa","vaṇaṅkiṟaip paṇaittōḷ elvaḷai makaḷir","tuṇaṅkai nāḷum vantaṉa avvaraik","kaṇpora maṟṟataṉ kaṇṇavar","maṇaṅkoḷaṟ kivarum maḷḷar pōrē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"இற்பரத்தை கூற்று","poet_ta":"ஔவையார்","speaker_en":null,"poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 31"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 20, veṇṭaḷai 10"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அரிற்பவர்ப்","tr":"ariṟpavarp","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அரிற்","tr":"ariṟ"},{"kind":"nirai","text":"பவர்ப்","tr":"pavarp"}]},{"text":"பிரம்பின்","tr":"pirampiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிரம்","tr":"piram"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]},{"text":"வரிப்புற","tr":"varippuṟa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வரிப்","tr":"varip"},{"kind":"nirai","text":"புற","tr":"puṟa"}]},{"text":"நீர்நாய்","tr":"nīrnāy","foot":"tēmā","acai":[{"kind":"nēr","text":"நீர்","tr":"nīr"},{"kind":"nēr","text":"நாய்","tr":"nāy"}]}],[{"text":"வாளை","tr":"vāḷai","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ளை","tr":"ḷai"}]},{"text":"நாளிரை","tr":"nāḷirai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nirai","text":"ளிரை","tr":"ḷirai"}]},{"text":"பெறூஉம்","tr":"peṟūum","foot":"puḷimā","acai":[{"k