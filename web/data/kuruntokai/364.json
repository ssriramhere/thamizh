{"text":"kuruntokai","n":364,"lines":["அரிற்பவர்ப் பிரம்பின் வரிப்புற நீர்நாய்","வாளை நாளிரை பெறூஉம் ஊரன்","பொற்கோல் அவிர்தொடித் தற்கெழு தகுவி","எற்புறங் கூறும் என்ப தெற்றென","வணங்கிறைப் பணைத்தோள் எல்வளை மகளிர்","துணங்கை நாளும் வந்தன அவ்வரைக்","கண்பொர மற்றதன் கண்ணவர்","மணங்கொளற் கிவரும் மள்ளர் போரே"],"tr":["ariṟpavarp pirampiṉ varippuṟa nīrnāy","vāḷai nāḷirai peṟūum ūraṉ","poṟkōl avirtoṭit taṟkeḻu takuvi","eṟpuṟaṅ kūṟum eṉpa teṟṟeṉa","vaṇaṅkiṟaip paṇaittōḷ elvaḷai makaḷir","tuṇaṅkai nāḷum vantaṉa avvaraik","kaṇpora maṟṟataṉ kaṇṇavar","maṇaṅkoḷaṟ kivarum maḷḷar pōrē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"இற்பரத்தை கூற்று","poet_ta":"ஔவையார்","speaker_en":null,"poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 31"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 20, veṇṭaḷai 10"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அரிற்பவர்ப்","tr":"ariṟpavarp","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அரிற்","tr":"ariṟ"},{"kind":"nirai","text":"பவர்ப்","tr":"pavarp"}]},{"text":"பிரம்பின்","tr":"pirampiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிரம்","tr":"piram"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]},{"text":"வரிப்புற","tr":"varippuṟa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வரிப்","tr":"varip"},{"kind":"nirai","text":"புற","tr":"puṟa"}]},{"text":"நீர்நாய்","tr":"nīrnāy","foot":"tēmā","acai":[{"kind":"nēr","text":"நீர்","tr":"nīr"},{"kind":"nēr","text":"நாய்","tr":"nāy"}]}],[{"text":"வாளை","tr":"vāḷai","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ளை","tr":"ḷai"}]},{"text":"நாளிரை","tr":"nāḷirai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nirai","text":"ளிரை","tr":"ḷirai"}]},{"text":"பெறூஉம்","tr":"peṟūum","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெறூ","tr":"peṟū"},{"kind":"nēr","text":"உம்","tr":"um"}]},{"text":"ஊரன்","tr":"ūraṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"ஊ","tr":"ū"},{"kind":"nēr","text":"ரன்","tr":"raṉ"}]}],[{"text":"பொற்கோல்","tr":"poṟkōl","foot":"tēmā","acai":[{"kind":"nēr","text":"பொற்","tr":"poṟ"},{"kind":"nēr","text":"கோல்","tr":"kōl"}]},{"text":"அவிர்தொடித்","tr":"avirtoṭit","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அவிர்","tr":"avir"},{"kind":"nirai","text":"தொடித்","tr":"toṭit"}]},{"text":"தற்கெழு","tr":"taṟkeḻu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தற்","tr":"taṟ"},{"kind":"nirai","text":"கெழு","tr":"keḻu"}]},{"text":"தகுவி","tr":"takuvi","foot":"puḷimā","acai":[{"kind":"nirai","text":"தகு","tr":"taku"},{"kind":"nēr","text":"வி","tr":"vi"}]}],[{"text":"எற்புறங்","tr":"eṟpuṟaṅ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"எற்","tr":"eṟ"},{"kind":"nirai","text":"புறங்","tr":"puṟaṅ"}]},{"text":"கூறும்","tr":"kūṟum","foot":"tēmā","acai":[{"kind":"nēr","text":"கூ","tr":"kū"},{"kind":"nēr","text":"றும்","tr":"ṟum"}]},{"text":"என்ப","tr":"eṉpa","foot":"tēmā","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nēr","text":"ப","tr":"pa"}]},{"text":"தெற்றென","tr":"teṟṟeṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தெற்","tr":"teṟ"},{"kind":"nirai","text":"றென","tr":"ṟeṉa"}]}],[{"text":"வணங்கிறைப்","tr":"vaṇaṅkiṟaip","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வணங்","tr":"vaṇaṅ"},{"kind":"nirai","text":"கிறைப்","tr":"kiṟaip"}]},{"text":"பணைத்தோள்","tr":"paṇaittōḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பணைத்","tr":"paṇait"},{"kind":"nēr","text":"தோள்","tr":"tōḷ"}]},{"text":"எல்வளை","tr":"elvaḷai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"எல்","tr":"el"},{"kind":"nirai","text":"வளை","tr":"vaḷai"}]},{"text":"மகளிர்","tr":"makaḷir","foot":"puḷimā","acai":[{"kind":"nirai","text":"மக","tr":"maka"},{"kind":"nēr","text":"ளிர்","tr":"ḷir"}]}],[{"text":"துணங்கை","tr":"tuṇaṅkai","foot":"puḷimā","acai":[{"kind":"nirai","text":"துண