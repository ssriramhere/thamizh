{"text":"kuruntokai","n":260,"lines":["குருகும் இருவிசும் பிவரும் புதலும்","வரிவண் டூத வாய்நெகிழ்ந் தனவே","சுரிவளைப் பொலிந்த தோளுஞ் செற்றும்","வருவர்கொல் வாழி தோழி பொருவார்","மண்ணெடுத் துண்ணும் அண்ணல் யானை","வண்தேர்த் தொண்டையர் வழையம லடுக்கத்துக்","கன்றி லோரா விலங்கிய","புன்றா ளோமைய சுரனிறந் தோரே"],"tr":["kurukum iruvicum pivarum putalum","varivaṇ ṭūta vāynekiḻn taṉavē","curivaḷaip polinta tōḷuñ ceṟṟum","varuvarkol vāḻi tōḻi poruvār","maṇṇeṭut tuṇṇum aṇṇal yāṉai","vaṇtērt toṇṭaiyar vaḻaiyama laṭukkattuk","kaṉṟi lōrā vilaṅkiya","puṉṟā ḷōmaiya curaṉiṟan tōrē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"கல்லாடனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kallāṭaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 12, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"குருகும்","tr":"kurukum","foot":"puḷimā","acai":[{"kind":"nirai","text":"குரு","tr":"kuru"},{"kind":"nēr","text":"கும்","tr":"kum"}]},{"text":"இருவிசும்","tr":"iruvicum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இரு","tr":"iru"},{"kind":"nirai","text":"விசும்","tr":"vicum"}]},{"text":"பிவரும்","tr":"pivarum","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிவ","tr":"piva"},{"kind":"nēr","text":"ரும்","tr":"rum"}]},{"text":"புதலும்","tr":"putalum","foot":"puḷimā","acai":[{"kind":"nirai","text":"புத","tr":"puta"},{"kind":"nēr","text":"லும்","tr":"lum"}]}],[{"text":"வரிவண்","tr":"varivaṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"வரி","tr":"vari"},{"kind":"nēr","text":"வண்","tr":"vaṇ"}]},{"text":"டூத","tr":"ṭūta","foot":"tēmā","acai":[{"kind":"nēr","text":"டூ","tr":"ṭū"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"வாய்நெகிழ்ந்","tr":"vāynekiḻn","foot":"kūviḷam",