{"text":"kuruntokai","n":182,"lines":["விழுத்தலைப் பெண்ணை விளையன் மாமடல்","மணியணி பெருந்தார் மரபிற் பூட்டி","வெள்ளென் பணிந்துபிறர் எள்ளத் தோன்றி","ஒருநாண் மருங்கிற் பெருநா ணீக்கித்","தெருவின் இயலவும் தருவது கொல்லோ","கலிந்தவிர் அசைநடைப் பேதை","மெலிந்தில ணாம்விடற் கமைந்த தூதே"],"tr":["viḻuttalaip peṇṇai viḷaiyaṉ māmaṭal","maṇiyaṇi peruntār marapiṟ pūṭṭi","veḷḷeṉ paṇintupiṟar eḷḷat tōṉṟi","orunāṇ maruṅkiṟ perunā ṇīkkit","teruviṉ iyalavum taruvatu kollō","kalintavir acainaṭaip pētai","melintila ṇāmviṭaṟ kamainta tūtē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"மடல் பாடிய மாதங்கீரனார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Maṭal Pāṭiya Mātaṅkīraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 15, āciriyattaḷai 11"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"விழுத்தலைப்","tr":"viḻuttalaip","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விழுத்","tr":"viḻut"},{"kind":"nirai","text":"தலைப்","tr":"talaip"}]},{"text":"பெண்ணை","tr":"peṇṇai","foot":"tēmā","acai":[{"kind":"nēr","text":"பெண்","tr":"peṇ"},{"kind":"nēr","text":"ணை","tr":"ṇai"}]},{"text":"விளையன்","tr":"viḷaiyaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"விளை","tr":"viḷai"},{"kind":"nēr","text":"யன்","tr":"yaṉ"}]},{"text":"மாமடல்","tr":"māmaṭal","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"மடல்","tr":"maṭal"}]}],[{"text":"மணியணி","tr":"maṇiyaṇi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மணி","tr":"maṇi"},{"kind":"nirai","text":"யணி","tr":"yaṇi"}]},{"text":"பெருந்தார்","tr":"peruntār","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெருந்","tr":"perun"},{"kind":"nēr","text":"தார்","tr":"tār"}]},{"text":"மரபிற்","tr":"marapiṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மர","tr":"mara"},{"kind":"nēr","text":"பிற்","tr":"piṟ"}]},{"text":"பூட்டி","tr":"pūṭṭi","foot":"tēmā","acai":[{"kind":"nēr","text":"பூட்","tr":"pūṭ"},{"kind":"nēr","text":"டி","tr":"ṭi"}]}],[{"text":"வெள்ளென்","tr":"veḷḷeṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"வெள்","tr":"veḷ"},{"kind":"nēr","text":"ளென்","tr":"ḷeṉ"}]},{"text":"பணிந்துபிறர்","tr":"paṇintupiṟar","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"பணிந்","tr":"paṇin"},{"kind":"nirai","text":"துபி","tr":"tupi"},{"kind":"nēr","text":"றர்","tr":"ṟar"}]},{"text":"எள்ளத்","tr":"eḷḷat","foot":"tēmā","acai":[{"kind":"nēr","text":"எள்","tr":"eḷ"},{"kind":"nēr","text":"ளத்","tr":"ḷat"}]},{"text":"தோன்றி","tr":"tōṉṟi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோன்","tr":"tōṉ"},{"kind":"nēr","text":"றி","tr":"ṟi"}]}],[{"text":"ஒருநாண்","tr":"orunāṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"ஒரு","tr":"oru"},{"kind":"nēr","text":"நாண்","tr":"nāṇ"}]},{"text":"மருங்கிற்","tr":"maruṅkiṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மருங்","tr":"maruṅ"},{"kind":"nēr","text":"கிற்","tr":"kiṟ"}]},{"text":"பெருநா","tr":"perunā","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெரு","tr":"peru"},{"kind":"nēr","text":"நா","tr":"nā"}]},{"text":"ணீக்கித்","tr":"ṇīkkit","foot":"tēmā","acai":[{"kind":"nēr","text":"ணீக்","tr":"ṇīk"},{"kind":"nēr","text":"கித்","tr":"kit"}]}],[{"text":"தெருவின்","tr":"teruviṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"தெரு","tr":"teru"},{"kind":"nēr","text":"வின்","tr":"viṉ"}]},{"text":"இயலவும்","tr":"iyalavum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இய","tr":"iya"},{"kind":"nirai","text":"லவும்","tr":"lavum"}]},{"text":"தருவது","tr":"taruvatu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தரு","tr":"taru"},{"kind":"nirai","text":"வது","tr":"vatu"}]},{"text":"கொல்லோ","tr":"kollō","foot":"tēmā","acai":[{"kind":"nēr","text":"கொல்","tr":"kol"},{"kind":"nēr","text":"லோ","tr":"lō"}]}],[{"text":"கலிந்தவிர்","tr":"kalintavi