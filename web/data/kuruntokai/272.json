{"text":"kuruntokai","n":272,"lines":["தீண்டலும் இயைவது கொல்லோ மாண்ட","வில்லுடை வீளையர் கல்லிடு பெடுத்த","நனந்தலைக் கானத் தினந்தலைப் பிரிந்த","புன்கண் மடமா னேர்படத் தன்னையர்","சிலைமாண் கடுவிசைக் கலைநிறத் தழுத்திக்","குருதியொடு பறித்த செங்கோல் வாளி","மாறுகொண் டன்ன வுண்கண்","நாறிருங் கூந்தற் கொடிச்சி தோளே"],"tr":["tīṇṭalum iyaivatu kollō māṇṭa","villuṭai vīḷaiyar kalliṭu peṭutta","naṉantalaik kāṉat tiṉantalaip pirinta","puṉkaṇ maṭamā ṉērpaṭat taṉṉaiyar","cilaimāṇ kaṭuvicaik kalainiṟat taḻuttik","kurutiyoṭu paṟitta ceṅkōl vāḷi","māṟukoṇ ṭaṉṉa vuṇkaṇ","nāṟiruṅ kūntaṟ koṭicci tōḷē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"ஒருசிறைப் பெரியனார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Oruciṟaip Periyaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 13, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"தீண்டலும்","tr":"tīṇṭalum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தீண்","tr":"tīṇ"},{"kind":"nirai","text":"டலும்","tr":"ṭalum"}]},{"text":"இயைவது","tr":"iyaivatu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இயை","tr":"iyai"},{"kind":"nirai","text":"வது","tr":"vatu"}]},{"text":"கொல்லோ","tr":"kollō","foot":"tēmā","acai":[{"kind":"nēr","text":"கொல்","tr":"kol"},{"kind":"nēr","text":"லோ","tr":"lō"}]},{"text":"மாண்ட","tr":"māṇṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"மாண்","tr":"māṇ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]}],[{"text":"வில்லுடை","tr":"villuṭai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வில்","tr":"vil"},{"kind":"nirai","text":"லுடை","tr":"luṭai"}]},{"text":"வீளையர்","tr":"vīḷaiyar","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"வீ","tr":"vī"},{"kind":"nēr","text":"ளை","tr":"ḷai"},{"kind":"nēr"