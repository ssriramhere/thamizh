{"text":"kuruntokai","n":287,"lines":["அம்ம வாழி தோழி காதலர்","இன்னே கண்டுந் துறக்குவர் கொல்லோ","முந்நாற் றிங்க ணிறைபொறுத் தசைஇ","ஒதுங்கல் செல்லாப் பசும்புளி வேட்கைக்","கடுஞ்சூல் மகளிர் போலநீர் கொண்டு","விசும்பிவர் கல்லாது தாங்குபு புணரிச்","செழும்பல் குன்றம் நோக்கிப்","பெருங்கலி வான மேர்தரும் பொழுதே"],"tr":["amma vāḻi tōḻi kātalar","iṉṉē kaṇṭun tuṟakkuvar kollō","munnāṟ ṟiṅka ṇiṟaipoṟut tacaii","otuṅkal cellāp pacumpuḷi vēṭkaik","kaṭuñcūl makaḷir pōlanīr koṇṭu","vicumpivar kallātu tāṅkupu puṇaric","ceḻumpal kuṉṟam nōkkip","peruṅkali vāṉa mērtarum poḻutē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தோழி கூற்று","poet_ta":"கச்சிப்பேட்டு நன்னாகையார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kaccippēṭṭu Naṉṉākaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 16, āciriyattaḷai 14"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அம்ம","tr":"amma","foot":"tēmā","acai":[{"kind":"nēr","text":"அம்","tr":"am"},{"kind":"nēr","text":"ம","tr":"ma"}]},{"text":"வாழி","tr":"vāḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"காதலர்","tr":"kātalar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"தலர்","tr":"talar"}]}],[{"text":"இன்னே","tr":"iṉṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"இன்","tr":"iṉ"},{"kind":"nēr","text":"னே","tr":"ṉē"}]},{"text":"கண்டுந்","tr":"kaṇṭun","foot":"tēmā","acai":[{"kind":"nēr","text":"கண்","tr":"kaṇ"},{"kind":"nēr","text":"டுந்","tr":"ṭun"}]},{"text":"துறக்குவர்","tr":"tuṟakkuvar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"துறக்","tr":"t