"horn"}],"gloss":"two horns"},{"surface":"எருமை","parts":[{"text":"எருமை","lemma":"எருமை","gloss":"female buffalo"}],"gloss":"female buffalo"},{"surface":"ஈன்றணி","parts":[{"text":"ஈன்று","lemma":"ஈனு","gloss":"having given birth"},{"text":"அணி","lemma":"அணி","gloss":"recently"}],"gloss":"recently given birth"},{"surface":"காரான்","parts":[{"text":"கார்","lemma":"கார்","gloss":"dark"},{"text":"ஆன்","lemma":"ஆன்","gloss":"cow/buffalo"}],"gloss":"dark female buffalo"}]},{"words":[{"surface":"உழவன்","parts":[{"text":"உழவன்","lemma":"உழவன்","gloss":"plowman"}],"gloss":"plowman"},{"surface":"யாத்த","parts":[{"text":"யாத்த","lemma":"யா","gloss":"tied"}],"gloss":"tied"},{"surface":"குழவியின்","parts":[{"text":"குழவி","lemma":"குழவி","gloss":"calf"},{"text":"இன்","lemma":"இன்","gloss":"from"}],"gloss":"from the calf"},{"surface":"அகலாது","parts":[{"text":"அகலாது","lemma":"அகல்","gloss":"without moving away"}],"gloss":"without moving away"}]},{"words":[{"surface":"பாஅல்","parts":[{"text":"பாஅல்","lemma":"பால்","gloss":"milk/sap"}],"gloss":"milky/sap-filled"},{"surface":"பைம்பயிர்","parts":[{"text":"பைம்","lemma":"பசுமை","gloss":"green"},{"text":"பயிர்","lemma":"பயிர்","gloss":"crop"}],"gloss":"green crops"},{"surface":"ஆரும்","parts":[{"text":"ஆரும்","lemma":"ஆர்","gloss":"feeding on"}],"gloss":"feeding on"},{"surface":"ஊரன்","parts":[{"text":"ஊரன்","lemma":"ஊரன்","gloss":"chief of the town"}],"gloss":"chief of the town"}]},{"words":[{"surface":"திருமனை","parts":[{"text":"திரு","lemma":"திரு","gloss":"beautiful"},{"text":"மனை","lemma":"மனை","gloss":"house"}],"gloss":"beautiful house"},{"surface":"பலகடம்","parts":[{"text":"பல","lemma":"பல","gloss":"many"},{"text":"கடம்","lemma":"கடம்","gloss":"duties"}],"gloss":"many duties"},{"surface":"பூண்ட","parts":[{"text":"பூண்ட","lemma":"பூண்","gloss":"undertaken"}],"gloss":"who have undertaken"}]},{"words":[{"surface":"பெருமுது","parts":[{"text":"பெரு","lemma":"பெருமை","gloss":"great"},{"text":"முது","lemma":"முதுமை","gloss":"old"}],"gloss":"very old"},{"surface":"பெண்டிரேம்","parts":[{"text":"பெண்டிர்","lemma":"பெண்டிர்","gloss":"women"},{"text":"ஏம்","lemma":"ஏம்","gloss":"we"}],"gloss":"women we are"},{"surface":"ஆகிய","parts":[{"text":"ஆகி","lemma":"ஆகு","gloss":"having become"},{"text":"அ","lemma":"அ","gloss":"adjectival suffix"}],"gloss":"who have become"},{"surface":"நமக்கே","parts":[{"text":"நமக்கு","lemma":"நமக்கு","gloss":"to us"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"to us indeed"}]}],"literal":"What is this, O friend, during our sulking, / the unpleasant word saying 'he is of such bad nature'? / The dark female buffalo with two horns, having recently given birth, / without moving away from her calf tied by the plowman, / feeds on the milky green crops in the town of the chief. / For us, who have undertaken many duties of the beautiful household, / and have become very old women!","translation":"O friend, what is the use of these unpleasant words, spoken in the midst of our sulking, saying, 'He is like this'? He is the chief of the town where a dark, two-horned buffalo, having recently given birth, does not stray from her calf tied up by the plowman, but grazes on the milky, fresh green crops. For us, who have undertaken the many duties of this beautiful home, and have now become very old women, what does it matter?","modern":"தோழியே! 'அவர் இப்படிப்பட்டவர்' என்று நாம் ஊடல் கொள்ளும் காலத்தில் பேசும் இந்தத் துன்பம் தரும் சொற்கள் எதற்கு? உழவன் கட்டிய கன்றை விட்டு நீங்காமல், அண்மையில் ஈன்ற இரு கொம்புகளையுடைய கரிய எருமை மாடு, பால் நிறைந்த பசிய பயிர்களை மேயும் ஊருக்குத் தலைவன் அவன். அழகிய இல்லறத்தின் பல கடமைகளை ஏற்றுக்கொண்டு, இப்போது மிகவும் முதிர்ந்த பெண்களாகிவிட்ட நமக்கு இதனால் என்ன பயன்?","explanation":"The heroine (தலைவி) is speaking to her friend (தோழி) in the Marutam (agricultural) landscape. The hero has returned from his visits to courtesans, and the friend is criticizing him, saying he is a bad man. The heroine, however, feels that sulking or complaining is pointless now that they have grown old and are fully occupied with the many responsibilities of running a household. She uses an implicit metaphor (uḷḷuṟai): the buffalo stays close to its calf but still grazes on the lush green crops nearby. This represents the hero, who remains bound to his home because of his love for his child, yet still indulges in relationships with courtesans. The key words are 'துனியிடை' (during sulking), 'காரான்' (dark buffalo), and 'பெருமுது பெண்டிரேம்' (very old women).","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.68,0.9],[0.9,1.2],[1.2,2.06],[2.06,2.7],[2.7,3.0],[3.0,3.3],[3.3,3.7],[3.7,4.79],[4.79,5.1],[5.1,5.1],[5.1,5.1],[5.1,6.6],[6.6,6.7],[6.7,7.32],[7.32,8.0],[8.0,8.6],[8.6,9.8],[9.8,9.8],[9.8,9.8],[9.8,9.8],[9.8,11.3],[11.3,11.7],[11.7,12.7],[12.7,12.8],[12.8,13.6],[13.6,13.8]],"female":[[0.0,0.6],[0.8,0.93],[1.0,1.4],[1.4,2.0],[2.0,2.6],[2.7,3.0],[3.0,3.6],[3.6,4.0],[4.0,4.79],[5.1,5.4],[5.5,6.0],[6.0,6.5],[6.5,7.2],[7.2,7.3],[7.3,7.84],[7.84,8.7],[8.7,9.15],[9.38,10.3],[10.3,10.56],[10.56,10.91],[10.91,11.0],[11.0,12.4],[12.4,12.8],[12.8,14.0],[14.0,14.0],[14.0,15.1],[15.1,15.4]]}}