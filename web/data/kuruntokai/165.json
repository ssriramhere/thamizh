:"தலையும்","lemma":"talai","gloss":"upon / and also"}],"gloss":"upon / and also"},{"surface":"நறவு","parts":[{"text":"நறவு","lemma":"naṟavu","gloss":"toddy"}],"gloss":"toddy"},{"surface":"உண்டு","parts":[{"text":"உண்டு","lemma":"uṇ","gloss":"having drunk"}],"gloss":"having drunk"},{"surface":"ஆங்கு","parts":[{"text":"ஆங்கு","lemma":"āṅku","gloss":"like"}],"gloss":"like"}]},{"words":[{"surface":"விழைந்தது","parts":[{"text":"விழைந்தது","lemma":"viḻai","gloss":"that which was desired"}],"gloss":"that which was desired"},{"surface":"அன்","parts":[{"text":"அன்","lemma":"aṉ","gloss":"inflectional increment"}],"gloss":"inflectional increment"},{"surface":"தலையும்","parts":[{"text":"தலையும்","lemma":"talai","gloss":"upon / and also"}],"gloss":"upon / and also"},{"surface":"நீ","parts":[{"text":"நீ","lemma":"nī","gloss":"you"}],"gloss":"you"},{"surface":"வெய்து","parts":[{"text":"வெய்து","lemma":"veytu","gloss":"hotly / intensely"}],"gloss":"hotly / intensely"},{"surface":"உற்றனை","parts":[{"text":"உற்றனை","lemma":"uṟu","gloss":"you experienced"}],"gloss":"you experienced"}]},{"words":[{"surface":"அரும்","parts":[{"text":"அரும்","lemma":"aru","gloss":"difficult"}],"gloss":"difficult"},{"surface":"கரை","parts":[{"text":"கரை","lemma":"karai","gloss":"slope"}],"gloss":"slope"},{"surface":"நின்ற","parts":[{"text":"நின்ற","lemma":"nil","gloss":"that stood"}],"gloss":"that stood"},{"surface":"உப்பு","parts":[{"text":"உப்பு","lemma":"uppu","gloss":"salt"}],"gloss":"salt"},{"surface":"ஒய்","parts":[{"text":"ஒய்","lemma":"oy","gloss":"carrying"}],"gloss":"carrying"},{"surface":"சகடம்","parts":[{"text":"சகடம்","lemma":"cakaṭam","gloss":"cart"}],"gloss":"cart"}]},{"words":[{"surface":"பெரும்பெய","parts":[{"text":"பெரும்பெய","lemma":"பெரும்பெய","gloss":""}],"gloss":"","split_unverified":true},{"surface":"றலையவீந்","parts":[{"text":"றலையவீந்","lemma":"றலையவீந்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தாங்கியவள்","parts":[{"text":"தாங்கியவள்","lemma":"தாங்கியவள்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"இரும்","parts":[{"text":"இரும்","lemma":"iru","gloss":"dark"}],"gloss":"dark"},{"surface":"பல்","parts":[{"text":"பல்","lemma":"pal","gloss":"abundant"}],"gloss":"abundant"},{"surface":"கூந்தல்","parts":[{"text":"கூந்தல்","lemma":"kūntal","gloss":"hair"}],"gloss":"hair"},{"surface":"இயல்","parts":[{"text":"இயல்","lemma":"iyal","gloss":"natural"}],"gloss":"natural"},{"surface":"அணி","parts":[{"text":"அணி","lemma":"aṇi","gloss":"beauty"}],"gloss":"beauty"},{"surface":"கண்டே","parts":[{"text":"கண்டே","lemma":"kaṇ","gloss":"having seen indeed"}],"gloss":"having seen indeed"}]}],"literal":"Upon that which rejoiced, like drinking toddy, / upon that which was desired, you experienced hotly, / the salt-carrying cart that stood on the difficult slope, / like dissolving when heavy rain poured down, she, / seeing the natural beauty of her dark, abundant hair.","translation":"As if drinking toddy on top of already being happy, you have fallen passionately in love on top of your desire, upon seeing the natural beauty of her dark, abundant hair—she who is like a salt-carrying cart standing on a difficult slope, dissolving when a heavy rain pours down.","modern":"ஏற்கனவே மகிழ்ச்சியாக இருந்தபோது கள் குடித்தது போலவும், ஏற்கனவே ஆசைப்பட்டதன் மேல் மேலும் தீவிரமாக ஆசைப்பட்டது போலவும் நீ அவளைக் கண்டு உருகுகிறாய். அரிய சரிவில் நின்ற உப்பு ஏற்றிய வண்டி, பெருமழை பெய்தவுடன் கரைந்து போவது போல, அவளுடைய கரிய அடர்ந்த கூந்தலின் இயற்கை அழகைக் கண்டு நீ உருகிப் போயிருக்கிறாய்.","explanation":"The hero is speaking to his own heart after seeing the heroine. He describes how his desire has intensified to an overwhelming degree, comparing it to drinking toddy when already happy. He feels completely dissolved and helpless, like a salt cart on a steep slope that melts away when a heavy rain pours down, all because of the natural beauty of her dark, abundant hair. The image of the salt cart dissolving in the rain beautifully conveys the vulnerability and complete loss of self-control of the lover. This belongs to the Kuriñci tiṇai, where steep slopes and heavy rains are characteristic.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.78],[0.78,1.1],[1.1,1.7],[1.76,2.0],[2.0,3.22],[3.22,3.5],[3.63,3.77],[3.9,4.3],[4.3,5.3],[5.3,5.4],[5.4,5.8],[5.9,6.3],[6.3,7.58],[7.58,7.7],[7.7,8.6],[8.6,9.4],[9.4,9.5],[9.63,9.9],[9.9,10.5]],"female":[[0.0,1.08],[1.08,1.4],[1.4,1.87],[1.87,1.93],[1.93,1.93],[1.93,2.0],[2.83,3.67],[4.5,5.0],[5.0,6.1],[6.1,6.2],[6.2,6.68],[6.8,7.4],[7.4,8.13],[8.13,8.31],[8.31,9.7],[9.7,9.8],[9.8,11.4],[11.4,11.52],[11.52,11.88]]},"sync":[[["மகிழ்ந்தது","that which rejoiced"],["அன்","inflectional increment"]],[["தலையும்","upon / and also"]],[["நறவு","toddy"],["உண்டு","having drunk"]],[["உண்டு","having drunk"],["ஆங்கு","like"]],[["விழைந்தது","that which was desired"],["அன்","inflectional increment"]],[["தலையும்","upon / and also"]],[["நீ","you"],["வெய்து","hotly / intensely"]],[["வெய்து","hotly / intensely"],["உற்றனை","you experienced"]],[["அரும்","difficult"],["கரை","slope"]],[["நின்ற","that stood"]],[["உப்பு","salt"],["ஒய்","carrying"]],[["சகடம்","cart"]],[["பெரும்பெய",""]],[["றலையவீந்",""]],[["தாங்கியவள்",""]],[["இரும்","dark"],["பல்","abundant"]],[["கூந்தல்","hair"]],[["இயல்","natural"],["அணி","beauty"]],[["கண்டே","having seen indeed"]]]}