{"text":"kuruntokai","n":165,"lines":["மகிழ்ந்ததன் றலையும் நறவுண் டாங்கு","விழைந்ததன் றலையும் நீவெய் துற்றனை","அருங்கரை நின்ற உப்பொய் சகடம்","பெரும்பெய றலையவீந் தாங்கியவள்","இரும்பல் கூந்தல் இயலணி கண்டே"],"tr":["makiḻntataṉ ṟalaiyum naṟavuṇ ṭāṅku","viḻaintataṉ ṟalaiyum nīvey tuṟṟaṉai","aruṅkarai niṉṟa uppoy cakaṭam","perumpeya ṟalaiyavīn tāṅkiyavaḷ","irumpal kūntal iyalaṇi kaṇṭē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"பரணர்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Paraṇar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 9, veṇṭaḷai 8, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மகிழ்ந்ததன்","tr":"makiḻntataṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மகிழ்ந்","tr":"makiḻn"},{"kind":"nirai","text":"ததன்","tr":"tataṉ"}]},{"text":"றலையும்","tr":"ṟalaiyum","foot":"puḷimā","acai":[{"kind":"nirai","text":"றலை","tr":"ṟalai"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"நறவுண்","tr":"naṟavuṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"நற","tr":"naṟa"},{"kind":"nēr","text":"வுண்","tr":"vuṇ"}]},{"text":"டாங்கு","tr":"ṭāṅku","foot":"tēmā","acai":[{"kind":"nēr","text":"டாங்","tr":"ṭāṅ"},{"kind":"nēr","text":"கு","tr":"ku"}]}],[{"text":"விழைந்ததன்","tr":"viḻaintataṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விழைந்","tr":"viḻain"},{"kind":"nirai","text":"ததன்","tr":"tataṉ"}]},{"text":"றலையும்","tr":"ṟalaiyum","foot":"puḷimā","acai":[{"kind":"nirai","text":"றலை","tr":"ṟalai"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"நீவெய்","tr":"nīvey","foot":"tēmā","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nēr","text":"வெய்","tr":"vey"}]},{"text":"துற்றனை","tr":"tuṟṟaṉai","foot":"kūviḷam","acai":[{"kind":"