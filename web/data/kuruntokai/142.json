{"text":"kuruntokai","n":142,"lines":["சுனைப்பூக் குற்றுத் தொடலை தைஇப்","புனக்கிளி கடியும் பூங்கட் பேதை","தானறிந் தனளோ இலளோ பானாட்","பள்ளி யானையி னுயிர்த்தென்","உள்ளம் பின்னுந் தன்னுழை யதுவே"],"tr":["cuṉaippūk kuṟṟut toṭalai taiip","puṉakkiḷi kaṭiyum pūṅkaṭ pētai","tāṉaṟin taṉaḷō ilaḷō pāṉāṭ","paḷḷi yāṉaiyi ṉuyirtteṉ","uḷḷam piṉṉun taṉṉuḻai yatuvē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"கபிலர்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 3, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"சுனைப்பூக்","tr":"cuṉaippūk","foot":"puḷimā","acai":[{"kind":"nirai","text":"சுனைப்","tr":"cuṉaip"},{"kind":"nēr","text":"பூக்","tr":"pūk"}]},{"text":"குற்றுத்","tr":"kuṟṟut","foot":"tēmā","acai":[{"kind":"nēr","text":"குற்","tr":"kuṟ"},{"kind":"nēr","text":"றுத்","tr":"ṟut"}]},{"text":"தொடலை","tr":"toṭalai","foot":"puḷimā","acai":[{"kind":"nirai","text":"தொட","tr":"toṭa"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"தைஇப்","tr":"taiip","foot":"tēmā","acai":[{"kind":"nēr","text":"தை","tr":"tai"},{"kind":"nēr","text":"இப்","tr":"ip"}]}],[{"text":"புனக்கிளி","tr":"puṉakkiḷi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"புனக்","tr":"puṉak"},{"kind":"nirai","text":"கிளி","tr":"kiḷi"}]},{"text":"கடியும்","tr":"kaṭiyum","foot":"puḷimā","acai":[{"kind":"nirai","text":"கடி","tr":"kaṭi"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"பூங்கட்","tr":"pūṅkaṭ","foot":"tēmā","acai":[{"kind":"nēr","text":"பூங்","tr":"pūṅ"},{"kind":"nēr","text":"கட்","tr":"kaṭ"}]},{"text":"பேதை","tr":"pētai","foot":"tēmā","acai":[{"kind":"nēr","text":"பே","tr":"pē"},{"kind":"nēr","text":"தை","tr":"tai"