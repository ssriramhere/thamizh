{"text":"kuruntokai","n":327,"lines":["நல்கின் வாழும் நல்கூர்ந் தோர்வயின்","நயனில ராகுதல் நன்றென உணர்ந்த","குன்ற நாடன் தன்னினும் நன்றும்","நின்னிலை கொடிதால் தீய கலுழி","நம்மனை மடமகள் இன்ன மென்மைச்","சாயலள் அளியள் என்னாய்","வாழைதந் தனையாற் சிலம்புபுல் லெனவே"],"tr":["nalkiṉ vāḻum nalkūrn tōrvayiṉ","nayaṉila rākutal naṉṟeṉa uṇarnta","kuṉṟa nāṭaṉ taṉṉiṉum naṉṟum","niṉṉilai koṭitāl tīya kaluḻi","nammaṉai maṭamakaḷ iṉṉa meṉmaic","cāyalaḷ aḷiyaḷ eṉṉāy","vāḻaitan taṉaiyāṟ cilampupul leṉavē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"அம்மூவனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Ammūvaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 19, veṇṭaḷai 6, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நல்கின்","tr":"nalkiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"நல்","tr":"nal"},{"kind":"nēr","text":"கின்","tr":"kiṉ"}]},{"text":"வாழும்","tr":"vāḻum","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ழும்","tr":"ḻum"}]},{"text":"நல்கூர்ந்","tr":"nalkūrn","foot":"tēmā","acai":[{"kind":"nēr","text":"நல்","tr":"nal"},{"kind":"nēr","text":"கூர்ந்","tr":"kūrn"}]},{"text":"தோர்வயின்","tr":"tōrvayiṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தோர்","tr":"tōr"},{"kind":"nirai","text":"வயின்","tr":"vayiṉ"}]}],[{"text":"நயனில","tr":"nayaṉila","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நய","tr":"naya"},{"kind":"nirai","text":"னில","tr":"ṉila"}]},{"text":"ராகுதல்","tr":"rākutal","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ரா","tr":"rā"},{"kind":"nirai","text":"குதல்","tr":"kutal"}]},{"text":"நன்றென","tr":"naṉṟeṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நன்","tr":"naṉ"},{"kind":"nirai","text":"றெ