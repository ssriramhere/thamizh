i":[{"kind":"nirai","text":"அளி","tr":"aḷi"},{"kind":"nēr","text":"யள்","tr":"yaḷ"}]},{"text":"என்னாய்","tr":"eṉṉāy","foot":"tēmā","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nēr","text":"னாய்","tr":"ṉāy"}]}],[{"text":"வாழைதந்","tr":"vāḻaitan","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ழை","tr":"ḻai"},{"kind":"nēr","text":"தந்","tr":"tan"}]},{"text":"தனையாற்","tr":"taṉaiyāṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"தனை","tr":"taṉai"},{"kind":"nēr","text":"யாற்","tr":"yāṟ"}]},{"text":"சிலம்புபுல்","tr":"cilampupul","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சிலம்","tr":"cilam"},{"kind":"nirai","text":"புபுல்","tr":"pupul"}]},{"text":"லெனவே","tr":"leṉavē","foot":"puḷimā","acai":[{"kind":"nirai","text":"லென","tr":"leṉa"},{"kind":"nēr","text":"வே","tr":"vē"}]}]]},"ai":{"lines":[{"words":[{"surface":"நல்கின்","parts":[{"text":"நல்கு","lemma":"நல்கு","gloss":"to grant favor"},{"text":"இன்","lemma":"இன்","gloss":"if"}],"gloss":"if [one] grants favor"},{"surface":"வாழும்","parts":[{"text":"வாழ்","lemma":"வாழ்","gloss":"to live"},{"text":"உம்","lemma":"உம்","gloss":"relative participle suffix"}],"gloss":"living"},{"surface":"நல்கூர்ந்தோர்","parts":[{"text":"நல்கூர்ந்தோர்","lemma":"நல்கூர்ந்தோர்","gloss":"those who are poor"}],"gloss":"those who are poor","split_unverified":true},{"surface":"வயின்","parts":[{"text":"வயின்","lemma":"வயின்","gloss":"towards / place"}],"gloss":"towards"}]},{"words":[{"surface":"நயனிலர்","parts":[{"text":"நயன்","lemma":"நயம்","gloss":"affection/goodness"},{"text":"இலர்","lemma":"இலர்","gloss":"they who do not have"}],"gloss":"those without affection"},{"surface":"ஆகுதல்","parts":[{"text":"ஆகு","lemma":"ஆகு","gloss":"to become"},{"text":"தல்","lemma":"தல்","gloss":"verbal noun suffix"}],"gloss":"becoming"},{"surface":"நன்றென","parts":[{"text":"நன்று","lemma":"நன்று","gloss":"good thing"},{"text":"என","lemma":"என","gloss":"as / that"}],"gloss":"as good"},{"surface":"உணர்ந்த","parts":[{"text":"உணர்","lemma":"உணர்","gloss":"to realize"},{"text":"ந்த","lemma":"த்த","gloss":"past relative participle suffix"}],"gloss":"who realized"}]},{"words":[{"surface":"குன்ற","parts":[{"text":"குன்ற","lemma":"குன்ற","gloss":"of the hill"}],"gloss":"of the hill","split_unverified":true},{"surface":"நாடன்","parts":[{"text":"நாடு","lemma":"நாடு","gloss":"land"},{"text":"அன்","lemma":"அன்","gloss":"he (masculine singular suffix)"}],"gloss":"lord of the land"},{"surface":"தன்னினும்","parts":[{"text":"தன்னினும்","lemma":"தன்னினும்","gloss":"even more than him"}],"gloss":"even more than him","split_unverified":true},{"surface":"நன்றும்","parts":[{"text":"நன்று","lemma":"நன்று","gloss":"greatly"},{"text":"உம்","lemma":"உம்","gloss":"indeed (intensive)"}],"gloss":"greatly"}]},{"words":[{"surface":"நின்னிலை","parts":[{"text":"நின்","lemma":"நீ","gloss":"your"},{"text":"நிலை","lemma":"நிலை","gloss":"state/behavior"}],"gloss":"your behavior"},{"surface":"கொடிதால்","parts":[{"text":"கொடிது","lemma":"கொடிது","gloss":"cruel thing"},{"text":"ஆல்","lemma":"ஆல்","gloss":"indeed (assertion)"}],"gloss":"is cruel indeed"},{"surface":"தீய","parts":[{"text":"தீ","lemma":"தீ","gloss":"evil/bad"},{"text":"அ","lemma":"அ","gloss":"adjectival suffix"}],"gloss":"evil"},{"surface":"கலுழி","parts":[{"text":"கலுழி","lemma":"கலுழி","gloss":"muddy torrent"}],"gloss":"muddy torrent"}]},{"words":[{"surface":"நம்மனை","parts":[{"text":"நம்","lemma":"நாம்","gloss":"our"},{"text":"மனை","lemma":"மனை","gloss":"house"}],"gloss":"our house"},{"surface":"மடமகள்","parts":[{"text":"மடம்","lemma":"மடம்","gloss":"innocence/youth"},{"text":"மகள்","lemma":"மகள்","gloss":"daughter"}],"gloss":"innocent daughter"},{"surface":"இன்ன","parts":[{"text":"இன்ன","lemma":"இன்ன","gloss":"of such / like this"}],"gloss":"of such"},{"surface":"மென்மை","parts":[{"text":"மென்மை","lemma":"மென்மை","gloss":"softness/gentleness"}],"gloss":"softness"}]},{"words":[{"surface":"சாயலள்","parts":[{"text":"சாயல்","lemma":"சாயல்","gloss":"graceful beauty"},{"text":"அள்","lemma":"அள்","gloss":"she (feminine singular suffix)"}],"gloss":"she of graceful beauty"},{"surface":"அளியள்","parts":[{"text":"அளி","lemma":"அளி","gloss":"pity/grace"},{"text":"அள்","lemma":"அள்","gloss":"she (feminine singular suffix)"}],"gloss":"she who is pitiable"},{"surface":"என்னாய்","parts":[{"text":"என்","lemma":"என்","gloss":"to say/think"},{"text":"ஆய்","lemma":"ஆய்","gloss":"without doing (negative participle)"}],"gloss":"without thinking"}]},{"words":[{"surface":"வாழை","parts":[{"text":"வாழை","lemma":"வாழை","gloss":"plantain trees"}],"gloss":"plantain trees"},{"surface":"தந்தனையால்","parts":[{"text":"தந்தனையால்","lemma":"தந்தனையால்","gloss":"you brought down indeed"}],"gloss":"you brought down indeed","split_unverified":true},{"surface":"சிலம்பு","parts":[{"text":"சிலம்பு","lemma":"சிலம்பு","gloss":"mountain slope"}],"gloss":"mountain slope"},{"surface":"புல்லெனவே","parts":[{"text":"புல்","lemma":"புல்","gloss":"bareness/desolation"},{"text":"என","lemma":"என","gloss":"to become"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"to become bare indeed"}]}],"literal":"Towards those who are poor and live only if others grant favor, / becoming devoid of affection is good, so thought / the lord of the hills; even more than him, greatly / your behavior is cruel indeed, O evil muddy torrent! / Without thinking, 'The innocent daughter of our house is of such soft / graceful beauty, she is pitiable,' / you brought down the plantain trees, making the mountain slope look bare indeed.","translation":"The lord of the hills thought it best to show no affection to those poor souls who survive only on the grace of others. But O evil, muddy torrent, your behavior is far more cruel than his! Without even considering that the innocent daughter of our house is of such soft beauty and deserves pity, you have swept away the plantain trees, leaving the mountain slope completely bare.","modern":"பிறர் கொடுத்தால் மட்டுமே வாழக்கூடிய வறியவர்களிடம் அன்பு இல்லாமல் இருப்பது நல்லது என்று நினைத்த மலைநாட்டைச் சேர்ந்த தலைவனைக் காட்டிலும், தீய கலுழி நீரே! உன்னுடைய செயல் மிகவும் கொடியது. 'நம்முடைய வீட்டின் இளமகள் இத்தகைய மென்மையான அழகை உடையவள், இரங்கத்தக்கவள்' என்று சிறிதும் நினையாமல், மலைச்சரிவு பொலிவிழந்து வறிதாகத் தோன்றுமாறு அங்கிருந்த வாழை மரங்களை அடித்துக்கொண்டு வந்து சேர்த்துவிட்டாயே!","explanation":"In this Kuriñci poem, the heroine addresses the wild mountain torrent (kaluḻi) in her distress. She compares the torrent's destructive nature to the cold indifference of the hero, the lord of the hills, who has delayed their marriage. The hero believes it is better to remain unfeeling toward those who depend entirely on his grace, but the torrent is even more cruel. Without any regard for the heroine's fragile, soft beauty, the torrent has violently swept away the plantain trees, leaving the mountain slope bare and desolate. This image of the uprooted plantain trees and the bare slope beautifully mirrors the heroine's own ruined youth and desolate heart.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,0.7],[0.7,1.5],[1.5,2.1],[2.3,2.5],[2.5,2.8],[3.2,3.6],[3.6,4.0],[4.0,4.0],[4.0,4.7],[4.7,4.7],[4.7,4.7],[4.7,6.8],[6.8,7.3],[7.3,7.7],[7.7,7.9],[7.9,9.2],[9.2,9.2],[9.2,9.8],[9.8,10.6],[10.6,11.2],[11.2,11.8],[11.8,12.3],[12.3,13.2],[13.2,13.8],[13.8,14.4],[14.47,14.7]],"female":[[0.0,0.8],[0.8,0.9],[0.9,1.7],[1.7,2.3],[2.3,3.25],[3.25,3.7],[3.7,4.5],[4.5,4.9],[4.9,5.9],[5.9,6.3],[6.3,6.8],[6.8,7.3],[7.3,8.3],[8.3,8.8],[8.8,9.2],[9.2,9.4],[9.4,10.7],[10.7,10.8],[10.8,11.5],[11.5,12.36],[12.36,13.3],[13.3,13.8],[13.8,14.2],[14.2,15.4],[15.4,15.9],[15.9,16.7],[16.8,17.1]]}}