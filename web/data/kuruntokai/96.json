{"text":"kuruntokai","n":96,"lines":["அருவி வேங்கைப் பெருமலை நாடற்கு","யானெவன் செய்கோ என்றி யானது","நகையென உணரேன் ஆயின்","என்னா குவைகொல் நன்னுதல் நீயே"],"tr":["aruvi vēṅkaip perumalai nāṭaṟku","yāṉevaṉ ceykō eṉṟi yāṉatu","nakaiyeṉa uṇarēṉ āyiṉ","eṉṉā kuvaikol naṉṉutal nīyē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"அள்ளூர் நன்முல்லையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Aḷḷūr Naṉmullaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 14, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 8, veṇṭaḷai 6"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அருவி","tr":"aruvi","foot":"puḷimā","acai":[{"kind":"nirai","text":"அரு","tr":"aru"},{"kind":"nēr","text":"வி","tr":"vi"}]},{"text":"வேங்கைப்","tr":"vēṅkaip","foot":"tēmā","acai":[{"kind":"nēr","text":"வேங்","tr":"vēṅ"},{"kind":"nēr","text":"கைப்","tr":"kaip"}]},{"text":"பெருமலை","tr":"perumalai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெரு","tr":"peru"},{"kind":"nirai","text":"மலை","tr":"malai"}]},{"text":"நாடற்கு","tr":"nāṭaṟku","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"டற்","tr":"ṭaṟ"},{"kind":"nēr","text":"கு","tr":"ku"}]}],[{"text":"யானெவன்","tr":"yāṉevaṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nirai","text":"னெவன்","tr":"ṉevaṉ"}]},{"text":"செய்கோ","tr":"ceykō","foot":"tēmā","acai":[{"kind":"nēr","text":"செய்","tr":"cey"},{"kind":"nēr","text":"கோ","tr":"kō"}]},{"text":"என்றி","tr":"eṉṟi","foot":"tēmā","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nēr","text":"றி","tr":"ṟi"}]},{"text":"யானது","tr":"yāṉatu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nirai","text":"னது","tr":"ṉatu"}]}],[{"text":"நகையென","tr":"nakaiyeṉa","fo