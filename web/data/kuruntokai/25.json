{"text":"kuruntokai","n":25,"lines":["யாரும் இல்லைத் தானே கள்வன்","தானது பொய்ப்பின் யானெவன் செய்கோ","தினைத்தாள் அன்ன சிறுபசுங் கால","ஒழுகுநீர் ஆரல் பார்க்கும்","குருகும் உண்டுதான் மணந்த ஞான்றே"],"tr":["yārum illait tāṉē kaḷvaṉ","tāṉatu poyppiṉ yāṉevaṉ ceykō","tiṉaittāḷ aṉṉa ciṟupacuṅ kāla","oḻukunīr āral pārkkum","kurukum uṇṭutāṉ maṇanta ñāṉṟē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"கபிலர்","speaker_en":"the heroine (talaivi)","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"யாரும்","tr":"yārum","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"ரும்","tr":"rum"}]},{"text":"இல்லைத்","tr":"illait","foot":"tēmā","acai":[{"kind":"nēr","text":"இல்","tr":"il"},{"kind":"nēr","text":"லைத்","tr":"lait"}]},{"text":"தானே","tr":"tāṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"னே","tr":"ṉē"}]},{"text":"கள்வன்","tr":"kaḷvaṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"கள்","tr":"kaḷ"},{"kind":"nēr","text":"வன்","tr":"vaṉ"}]}],[{"text":"தானது","tr":"tāṉatu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nirai","text":"னது","tr":"ṉatu"}]},{"text":"பொய்ப்பின்","tr":"poyppiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"பொய்ப்","tr":"poyp"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]},{"text":"யானெவன்","tr":"yāṉevaṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nirai","text":"னெவன்","tr":"ṉevaṉ"}]},{"text":"செய்கோ","tr":"ceykō","foot":"tēmā","acai":[{"kind":"nēr","text":"செய்","tr":"cey"},{"kind":"nēr","text":"கோ","tr":"kō"}]}],[{"text":"தினைத்தாள்","tr":"tiṉaittāḷ","foot":"puḷimā","a