{"text":"kuruntokai","n":145,"lines":["உறைபதி யன்றித் துறைகெழு சிறுகுடி","கானலஞ் சேர்ப்பன் கொடுமை ஏற்றி","ஆனாத் துயரமொடு வருந்திப் பானாள்","துஞ்சா துறைநரொ டுசாவாத்","துயிற்கண் மாக்களொடு நெட்டிரா வுடைத்தே"],"tr":["uṟaipati yaṉṟit tuṟaikeḻu ciṟukuṭi","kāṉalañ cērppaṉ koṭumai ēṟṟi","āṉāt tuyaramoṭu varuntip pāṉāḷ","tuñcā tuṟainaro ṭucāvāt","tuyiṟkaṇ mākkaḷoṭu neṭṭirā vuṭaittē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"கொல்லனழிசியார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kollaṉaḻiciyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 9, āciriyattaḷai 8, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"உறைபதி","tr":"uṟaipati","foot":"karuviḷam","acai":[{"kind":"nirai","text":"உறை","tr":"uṟai"},{"kind":"nirai","text":"பதி","tr":"pati"}]},{"text":"யன்றித்","tr":"yaṉṟit","foot":"tēmā","acai":[{"kind":"nēr","text":"யன்","tr":"yaṉ"},{"kind":"nēr","text":"றித்","tr":"ṟit"}]},{"text":"துறைகெழு","tr":"tuṟaikeḻu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"துறை","tr":"tuṟai"},{"kind":"nirai","text":"கெழு","tr":"keḻu"}]},{"text":"சிறுகுடி","tr":"ciṟukuṭi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nirai","text":"குடி","tr":"kuṭi"}]}],[{"text":"கானலஞ்","tr":"kāṉalañ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"னலஞ்","tr":"ṉalañ"}]},{"text":"சேர்ப்பன்","tr":"cērppaṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"சேர்ப்","tr":"cērp"},{"kind":"nēr","text":"பன்","tr":"paṉ"}]},{"text":"கொடுமை","tr":"koṭumai","foot":"puḷimā","acai":[{"kind":"nirai","text":"கொடு","tr":"koṭu"},{"kind":"nēr","text":"மை","tr":"mai"}]},{"text":"ஏற்றி","tr":"ēṟṟi","foot":"tēmā","acai":[{"kind":"nēr","