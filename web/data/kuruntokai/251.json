{"text":"kuruntokai","n":251,"lines":["மடவ வாழி மஞ்ஞை மாயினம்","கால மாரி பெய்தென அதனெதிர்","ஆலலு மாலின பிடவும் பூத்தன","காரன் றிகுளை தீர்கநின் படரே","கழிந்த மாரிக் கொழிந்த பழநீர்","புதுநீர் கொளீஇய வுகுத்தரும்","நொதுமல் வானத்து முழங்குகுரல் கேட்டே"],"tr":["maṭava vāḻi maññai māyiṉam","kāla māri peyteṉa ataṉetir","ālalu māliṉa piṭavum pūttaṉa","kāraṉ ṟikuḷai tīrkaniṉ paṭarē","kaḻinta mārik koḻinta paḻanīr","putunīr koḷīiya vukuttarum","notumal vāṉattu muḻaṅkukural kēṭṭē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தோழி கூற்று","poet_ta":"இடைக்காடனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Iṭaikkāṭaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 11, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மடவ","tr":"maṭava","foot":"puḷimā","acai":[{"kind":"nirai","text":"மட","tr":"maṭa"},{"kind":"nēr","text":"வ","tr":"va"}]},{"text":"வாழி","tr":"vāḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"மஞ்ஞை","tr":"maññai","foot":"tēmā","acai":[{"kind":"nēr","text":"மஞ்","tr":"mañ"},{"kind":"nēr","text":"ஞை","tr":"ñai"}]},{"text":"மாயினம்","tr":"māyiṉam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"யினம்","tr":"yiṉam"}]}],[{"text":"கால","tr":"kāla","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"ல","tr":"la"}]},{"text":"மாரி","tr":"māri","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"ரி","tr":"ri"}]},{"text":"பெய்தென","tr":"peyteṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பெய்","tr":"pey"},{"kind":"nirai","text":"தென","tr":"teṉa"}]},{"text":"அதனெதிர்","tr":"ataṉetir","foot":"karuviḷam","acai"