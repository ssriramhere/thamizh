nirai","text":"இய","tr":"iya"}]},{"text":"வுகுத்தரும்","tr":"vukuttarum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வுகுத்","tr":"vukut"},{"kind":"nirai","text":"தரும்","tr":"tarum"}]}],[{"text":"நொதுமல்","tr":"notumal","foot":"puḷimā","acai":[{"kind":"nirai","text":"நொது","tr":"notu"},{"kind":"nēr","text":"மல்","tr":"mal"}]},{"text":"வானத்து","tr":"vāṉattu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"னத்","tr":"ṉat"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"முழங்குகுரல்","tr":"muḻaṅkukural","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"முழங்","tr":"muḻaṅ"},{"kind":"nirai","text":"குகு","tr":"kuku"},{"kind":"nēr","text":"ரல்","tr":"ral"}]},{"text":"கேட்டே","tr":"kēṭṭē","foot":"tēmā","acai":[{"kind":"nēr","text":"கேட்","tr":"kēṭ"},{"kind":"nēr","text":"டே","tr":"ṭē"}]}]]},"ai":{"lines":[{"words":[{"surface":"மடவ","parts":[{"text":"மடவ","lemma":"மடவ","gloss":"foolish-they"}],"gloss":"they are foolish"},{"surface":"வாழி","parts":[{"text":"வாழி","lemma":"வாழ்","gloss":"may-you-live"}],"gloss":"may you live"},{"surface":"மஞ்ஞை","parts":[{"text":"மஞ்ஞை","lemma":"மஞ்ஞை","gloss":"peacock"}],"gloss":"peacock"},{"surface":"மாயினம்","parts":[{"text":"மா","lemma":"மா","gloss":"dark"},{"text":"இனம்","lemma":"இனம்","gloss":"flock"}],"gloss":"dark flock"}]},{"words":[{"surface":"கால","parts":[{"text":"கால","lemma":"கால","gloss":"seasonal"}],"gloss":"seasonal","split_unverified":true},{"surface":"மாரி","parts":[{"text":"மாரி","lemma":"மாரி","gloss":"rain"}],"gloss":"rain"},{"surface":"பெய்தென","parts":[{"text":"பெய்து","lemma":"பெய்","gloss":"having-rained"},{"text":"என","lemma":"என","gloss":"because"}],"gloss":"because it rained"},{"surface":"அதனெதிர்","parts":[{"text":"அதன்","lemma":"அது","gloss":"its"},{"text":"எதிர்","lemma":"எதிர்","gloss":"opposite"}],"gloss":"in response to that"}]},{"words":[{"surface":"ஆலலும்","parts":[{"text":"ஆலல்","lemma":"ஆலல்","gloss":"dancing"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"dancing also"},{"surface":"ஆலின","parts":[{"text":"ஆலின","lemma":"ஆலு","gloss":"they-danced"}],"gloss":"they danced"},{"surface":"பிடவும்","parts":[{"text":"பிடவு","lemma":"பிடவு","gloss":"piṭavu shrub"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and the piṭavu shrubs"},{"surface":"பூத்தன","parts":[{"text":"பூத்தன","lemma":"பூ","gloss":"they-blossomed"}],"gloss":"they blossomed"}]},{"words":[{"surface":"கார்","parts":[{"text":"கார்","lemma":"கார்","gloss":"rainy season"}],"gloss":"rainy season"},{"surface":"அன்று","parts":[{"text":"அன்று","lemma":"அல்","gloss":"not-it"}],"gloss":"it is not"},{"surface":"இகுளை","parts":[{"text":"இகுளை","lemma":"இகுளை","gloss":"friend"}],"gloss":"O friend"},{"surface":"தீர்க","parts":[{"text":"தீர்க","lemma":"தீர்","gloss":"may-it-end"}],"gloss":"may it end"},{"surface":"நின்","parts":[{"text":"நின்","lemma":"நீ","gloss":"your"}],"gloss":"your"},{"surface":"படரே","parts":[{"text":"படர்","lemma":"படர்","gloss":"affliction"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"affliction indeed"}]},{"words":[{"surface":"கழிந்த","parts":[{"text":"கழிந்த","lemma":"கழி","gloss":"passed"}],"gloss":"passed"},{"surface":"மாரிக்","parts":[{"text":"மாரி","lemma":"மாரி","gloss":"rain"},{"text":"க்","lemma":"க்","gloss":"sandhi"}],"gloss":"of the rain"},{"surface":"கொழிந்த","parts":[{"text":"கொழிந்த","lemma":"கொழி","gloss":"left behind"}],"gloss":"left behind"},{"surface":"பழநீர்","parts":[{"text":"பழ","lemma":"பழைய","gloss":"old"},{"text":"நீர்","lemma":"நீர்","gloss":"water"}],"gloss":"old water"}]},{"words":[{"surface":"புதுநீர்","parts":[{"text":"புது","lemma":"புதிய","gloss":"new"},{"text":"நீர்","lemma":"நீர்","gloss":"water"}],"gloss":"new water"},{"surface":"கொளீஇய","parts":[{"text":"கொளீஇய","lemma":"கொள்","gloss":"to take"}],"gloss":"to take"},{"surface":"உகுத்தரும்","parts":[{"text":"உகுத்தரும்","lemma":"உகுத்தரும்","gloss":"shedding and bringing down"}],"gloss":"shedding and bringing down","split_unverified":true}]},{"words":[{"surface":"நொதுமல்","parts":[{"text":"நொதுமல்","lemma":"நொதுமல்","gloss":"indifferent"}],"gloss":"indifferent"},{"surface":"வானத்து","parts":[{"text":"வானத்து","lemma":"வானத்து","gloss":"of the sky"}],"gloss":"of the sky","split_unverified":true},{"surface":"முழங்குகுரல்","parts":[{"text":"முழங்கு","lemma":"முழங்கு","gloss":"thundering"},{"text":"குரல்","lemma":"குரல்","gloss":"sound"}],"gloss":"thundering sound"},{"surface":"கேட்டே","parts":[{"text":"கேட்டு","lemma":"கேள்","gloss":"having heard"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"having heard"}]}],"literal":"They are foolish, may you live, the peacocks' dark flock! / Because seasonal rain poured, in response to that, / dancing they danced, and the piṭavu shrubs blossomed. / It is not the rainy season, O friend, let your affliction end! / The old water left behind by the passed rain, / in order to take in new water, shedding and bringing down, / having heard the thundering sound of the indifferent sky.","translation":"May you live, my friend! The dark flock of peacocks are truly foolish. Mistaking an unseasonal shower for the onset of the monsoon, they have danced in response, and the piṭavu shrubs have burst into bloom. This is not the actual rainy season. Let your suffering end! They did this merely upon hearing the thundering voice of the indifferent sky, which is only shedding the old water left behind by past rains so that it can take in new water.","modern":"தோழியே, நீ வாழ்க! மயில்களின் கரிய கூட்டம் அறிவில்லாதவை. பருவமழை பெய்துவிட்டது என்று எண்ணி, அதற்கு மாறாக அவை ஆடவும் ஆடின; பிடவ மரங்களும் மலர்ந்தன. தோழியே! இது கார் காலம் அன்று; உன்னுடைய துன்பம் நீங்குவதாக. கழிந்துபோன மழையினால் எஞ்சிய பழைய நீரை உதிர்த்துவிட்டுப் புதிய நீரைத் தம்மகத்தே கொள்வதற்காக, நமக்குத் தொடர்பில்லாத மேகம் இடிக்கும் இடிமுழக்கத்தைக் கேட்டுத்தான் இவை இவ்வாறு செய்கின்றன.","explanation":"The speaker is the heroine's friend, addressing the heroine who is anxious about her husband's return. The husband had promised to return at the onset of the rainy season, which is the characteristic season of the Mullai landscape. Seeing the peacocks dance and the piṭavu shrubs bloom after a sudden shower, the heroine fears that the rainy season has arrived and her husband has failed to keep his word. The friend consoles her by explaining that this is not the true rainy season, but merely an unseasonal shower from an indifferent sky shedding its old water. She calls the peacocks and shrubs foolish for being deceived by the false alarm, thereby reassuring the heroine and easing her grief. The key words are 'kār aṉṟu' (it is not the rainy season) and 'maṭava' (foolish ones).","model":"gemini-3.5-flash"}}