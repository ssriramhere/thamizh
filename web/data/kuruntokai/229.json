oss":"sandhi consonant"},{"text":"அம்ம","lemma":"amma","gloss":"behold"}],"gloss":"behold"},{"surface":"பாலே","parts":[{"text":"பால்","lemma":"pāl","gloss":"fate"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"O Fate"},{"surface":"மெல்லியல்","parts":[{"text":"மெல்","lemma":"mel","gloss":"soft"},{"text":"இயல்","lemma":"iyal","gloss":"nature"}],"gloss":"soft-natured"}]},{"words":[{"surface":"துணைமலர்ப்","parts":[{"text":"துணை","lemma":"tuṇai","gloss":"pair"},{"text":"மலர்","lemma":"malar","gloss":"flower"},{"text":"ப்","lemma":"p","gloss":"sandhi consonant"}],"gloss":"pair of flowers"},{"surface":"பிணைய","parts":[{"text":"பிணைய","lemma":"பிணைய","gloss":"garland"}],"gloss":"garland","split_unverified":true},{"surface":"லன்ன","parts":[{"text":"ல்","lemma":"l","gloss":"sandhi consonant"},{"text":"அன்ன","lemma":"anna","gloss":"like"}],"gloss":"like"},{"surface":"விவர்","parts":[{"text":"வ்","lemma":"v","gloss":"glide"},{"text":"இவர்","lemma":"ivar","gloss":"these two"}],"gloss":"these two"}]},{"words":[{"surface":"மணமகிழ்","parts":[{"text":"மணம்","lemma":"maṇam","gloss":"marriage"},{"text":"மகிழ்","lemma":"makiḻ","gloss":"joy"}],"gloss":"wedding joy"},{"surface":"இயற்கை","parts":[{"text":"இயல்","lemma":"iyal","gloss":"nature"},{"text":"கை","lemma":"kai","gloss":"noun suffix"}],"gloss":"state"},{"surface":"காட்டி","parts":[{"text":"காட்டு","lemma":"kāṭṭu","gloss":"show"},{"text":"இ","lemma":"i","gloss":"past participle suffix"}],"gloss":"having shown"},{"surface":"யோயே","parts":[{"text":"ய்","lemma":"y","gloss":"glide"},{"text":"ஓய்","lemma":"ōy","gloss":"you who did"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"you who did"}]}],"literal":"He, her five-part braid to grasp, and she, his / sparse-haired single lock to pull and tear, / loving foster-mothers though they try to stop, not stopping, / causeless little fight they engage in, indeed! / You are good indeed, O Fate, soft-natured / like a pair of flower garlands, these two's / wedding-joy state you have shown!","translation":"He would grab her five-part braid, and she would pull and tear his sparse-haired lock. Though their loving foster-mothers tried to stop them, they would not stop, but engaged in endless, causeless little fights. O Fate! You are truly good, for you have now shown these two, who are like a pair of matching flower garlands, in the joyful state of marriage!","modern":"அவன் இவளுடைய ஐந்து வகையாகப் பின்னப்பட்ட கூந்தலைப் பற்றவும், இவள் அவனுடைய மெல்லிய தலைமுடியைப் பிடித்து இழுத்துத் துண்டிக்கவும், அன்பான செவிலித்தாயர் தடுத்தும் தடுக்க முடியாமல், காரணமில்லாத சிறு சண்டைகளைச் செய்துகொண்டே இருப்பார்கள். மென்மையான இயல்புடைய, இணை மலர் மாலைகளைப் போன்ற இவர்களுடைய திருமண மகிழ்ச்சி நிறைந்த வாழ்க்கையை எங்களுக்குக் காட்டிய விதியே! நீ மிகவும் நல்லவன்!","explanation":"This poem is spoken by the onlookers who witness the elopement and subsequent marriage of the young lovers. They recall how the boy and girl used to fight constantly during their childhood play, pulling each other's hair despite their foster-mothers' attempts to stop them. Now, they have grown up and are united in marriage. The onlookers marvel at how Fate has beautifully transformed their childhood squabbles into the deep, inseparable bond of marriage. They compare the couple to a pair of matching flower garlands, highlighting the harmonious union that has blossomed from their playful conflicts.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,1.1],[1.1,1.3],[1.3,2.0],[2.0,2.7],[2.7,2.8],[2.8,3.45],[3.45,3.84],[3.97,4.1],[4.1,5.4],[5.4,5.7],[5.7,5.92],[5.92,6.8],[6.8,7.4],[7.4,7.47],[7.47,7.6],[8.0,8.35],[8.35,9.4],[9.4,9.63],[9.63,10.2],[10.2,11.2],[11.2,11.34],[11.34,12.1],[12.1,13.2],[13.2,13.5],[13.5,13.95],[13.95,13.97]],"female":[[0.0,0.8],[0.8,1.4],[1.4,1.5],[1.5,2.5],[2.5,3.4],[3.4,3.5],[3.5,4.1],[4.1,4.46],[4.58,4.7],[4.7,6.3],[6.3,7.2],[7.2,7.2],[7.2,7.2],[7.2,8.55],[8.6,9.2],[9.2,9.2],[9.2,9.2],[9.2,9.2],[9.2,9.7],[9.7,12.2],[12.2,13.3],[13.3,13.44],[13.44,14.1],[14.1,14.2],[14.2,15.8],[15.8,16.2],[16.2,16.5]]},"sync":[[["இவன்","this man"],["இவ","this woman"]],[["ளைம்பால்","five-part braid"]],[["பற்றவும்","to grasp"]],[["இவள்","she"],["இவன்","he"]],[["புன்றலை","sparse-haired head"]],[["யோரி","lock of hair"]],[["வாங்குநள்","she who pulls"]],[["பரியவும்","to break"]],[["காதற்","loving"]],[["செவிலியர்","foster-mothers"]],[["தவிர்ப்பவுந்","though they restrain"]],[["தவிரா","not stopping"]],[["தேதில்","causeless"]],[["சிறுசெரு","little fight"]],[["வுறுப","they engage in"]],[["மன்னோ","indeed"]],[["நல்லை","you are good"],["மன்","indeed"]],[["றம்ம","behold"]],[["பாலே","O Fate"]],[["மெல்லியல்","soft-natured"]],[["துணைமலர்ப்","pair of flowers"]],[["பிணைய","garland"]],[["லன்ன","like"],["விவர்","these two"]],[["மணமகிழ்","wedding joy"]],[["இயற்கை","state"]],[["காட்டி","having shown"]],[["யோயே","you who did"]]]}