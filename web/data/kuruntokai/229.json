{"text":"kuruntokai","n":229,"lines":["இவனிவ ளைம்பால் பற்றவும் இவளிவன்","புன்றலை யோரி வாங்குநள் பரியவும்","காதற் செவிலியர் தவிர்ப்பவுந் தவிரா","தேதில் சிறுசெரு வுறுப மன்னோ","நல்லைமன் றம்ம பாலே மெல்லியல்","துணைமலர்ப் பிணைய லன்னவிவர்","மணமகிழ் இயற்கை காட்டி யோயே"],"tr":["ivaṉiva ḷaimpāl paṟṟavum ivaḷivaṉ","puṉṟalai yōri vāṅkunaḷ pariyavum","kātaṟ ceviliyar tavirppavun tavirā","tētil ciṟuceru vuṟupa maṉṉō","nallaimaṉ ṟamma pālē melliyal","tuṇaimalarp piṇaiya laṉṉavivar","maṇamakiḻ iyaṟkai kāṭṭi yōyē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"கண்டோர் கூற்று","poet_ta":"மோதாசானார்","speaker_en":"onlookers (kaṇṭōr)","poet_tr":"Mōtācāṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 7, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இவனிவ","tr":"ivaṉiva","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இவ","tr":"iva"},{"kind":"nirai","text":"னிவ","tr":"ṉiva"}]},{"text":"ளைம்பால்","tr":"ḷaimpāl","foot":"tēmā","acai":[{"kind":"nēr","text":"ளைம்","tr":"ḷaim"},{"kind":"nēr","text":"பால்","tr":"pāl"}]},{"text":"பற்றவும்","tr":"paṟṟavum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பற்","tr":"paṟ"},{"kind":"nirai","text":"றவும்","tr":"ṟavum"}]},{"text":"இவளிவன்","tr":"ivaḷivaṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இவ","tr":"iva"},{"kind":"nirai","text":"ளிவன்","tr":"ḷivaṉ"}]}],[{"text":"புன்றலை","tr":"puṉṟalai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"புன்","tr":"puṉ"},{"kind":"nirai","text":"றலை","tr":"ṟalai"}]},{"text":"யோரி","tr":"yōri","foot":"tēmā","acai":[{"kind":"nēr","text":"யோ","tr":"yō"},{"kind":"nēr","text":"ரி","tr":"ri"}]},{"text":"வாங்குநள்","tr":"vāṅkunaḷ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வாங்","tr":"vāṅ"},{"kind":"n