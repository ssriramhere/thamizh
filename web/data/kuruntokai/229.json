,"tr":"tuṇai"},{"kind":"nirai","text":"மலர்ப்","tr":"malarp"}]},{"text":"பிணைய","tr":"piṇaiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிணை","tr":"piṇai"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"லன்னவிவர்","tr":"laṉṉavivar","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"லன்","tr":"laṉ"},{"kind":"nirai","text":"னவி","tr":"ṉavi"},{"kind":"nēr","text":"வர்","tr":"var"}]}],[{"text":"மணமகிழ்","tr":"maṇamakiḻ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மண","tr":"maṇa"},{"kind":"nirai","text":"மகிழ்","tr":"makiḻ"}]},{"text":"இயற்கை","tr":"iyaṟkai","foot":"puḷimā","acai":[{"kind":"nirai","text":"இயற்","tr":"iyaṟ"},{"kind":"nēr","text":"கை","tr":"kai"}]},{"text":"காட்டி","tr":"kāṭṭi","foot":"tēmā","acai":[{"kind":"nēr","text":"காட்","tr":"kāṭ"},{"kind":"nēr","text":"டி","tr":"ṭi"}]},{"text":"யோயே","tr":"yōyē","foot":"tēmā","acai":[{"kind":"nēr","text":"யோ","tr":"yō"},{"kind":"nēr","text":"யே","tr":"yē"}]}]]},"ai":{"lines":[{"words":[{"surface":"இவன்","parts":[{"text":"இவன்","lemma":"ivan","gloss":"this boy"}],"gloss":"this boy"},{"surface":"இவள்","parts":[{"text":"இவள்","lemma":"ivaḷ","gloss":"this girl"}],"gloss":"this girl"},{"surface":"ஐம்பால்","parts":[{"text":"ஐம்","lemma":"ai","gloss":"five"},{"text":"பால்","lemma":"pāl","gloss":"part"}],"gloss":"five-part hair"},{"surface":"பற்றவும்","parts":[{"text":"பற்றவும்","lemma":"பற்றவும்","gloss":"to grasp also"}],"gloss":"to grasp also","split_unverified":true},{"surface":"இவள்","parts":[{"text":"இவள்","lemma":"ivaḷ","gloss":"this girl"}],"gloss":"this girl"},{"surface":"இவன்","parts":[{"text":"இவன்","lemma":"ivan","gloss":"this boy"}],"gloss":"this boy"}]},{"words":[{"surface":"புன்றலை","parts":[{"text":"புன்","lemma":"puṉ","gloss":"sparse"},{"text":"தலை","lemma":"talai","gloss":"head"}],"gloss":"sparse-haired head"},{"surface":"ஓரி","parts":[{"text":"ஓரி","lemma":"ōri","gloss":"single lock of hair"}],"gloss":"single lock of hair"},{"surface":"வாங்குநள்","parts":[{"text":"வாங்கு","lemma":"vāṅku","gloss":"pull"},{"text":"நள்","lemma":"naḷ","gloss":"she who does"}],"gloss":"she who pulls"},{"surface":"பரியவும்","parts":[{"text":"பரியவும்","lemma":"பரியவும்","gloss":"to snap also"}],"gloss":"to snap also","split_unverified":true}]},{"words":[{"surface":"காதல்","parts":[{"text":"காதல்","lemma":"kātal","gloss":"love"}],"gloss":"loving"},{"surface":"செவிலியர்","parts":[{"text":"செவிலியர்","lemma":"ceviliyar","gloss":"foster-mothers"}],"gloss":"foster-mothers"},{"surface":"தவிர்ப்பவும்","parts":[{"text":"தவிர்ப்பவும்","lemma":"தவிர்ப்பவும்","gloss":"even when restraining"}],"gloss":"even when restraining","split_unverified":true},{"surface":"தவிரா","parts":[{"text":"தவிரா","lemma":"தவிரா","gloss":"without stopping"}],"gloss":"without stopping","split_unverified":true}]},{"words":[{"surface":"தேதில்","parts":[{"text":"த்","lemma":"t","gloss":"sandhi consonant"},{"text":"ஏதில்","lemma":"ētil","gloss":"causeless"}],"gloss":"causeless"},{"surface":"சிறு","parts":[{"text":"சிறு","lemma":"siṟu","gloss":"little"}],"gloss":"little"},{"surface":"செரு","parts":[{"text":"செரு","lemma":"ceru","gloss":"fight"}],"gloss":"fight"},{"surface":"உறுப","parts":[{"text":"உறு","lemma":"uṟu","gloss":"engage"},{"text":"ப","lemma":"pa","gloss":"they"}],"gloss":"they engage in"},{"surface":"மன்னோ","parts":[{"text":"மன்","lemma":"maṉ","gloss":"indeed"},{"text":"ஓ","lemma":"ō","gloss":"expletive"}],"gloss":"indeed"}]},{"words":[{"surface":"நல்லைமன்","parts":[{"text":"நல்லைமன்","lemma":"நல்லைமன்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"றம்ம","parts":[{"text":"றம்ம","lemma":"றம்ம","gloss":""}],"gloss":"","split_unverified":true},{"surface":"பாலே","parts":[{"text":"பாலே","lemma":"பாலே","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மெல்லியல்","parts":[{"text":"மெல்லியல்","lemma":"மெல்லியல்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"துணை","parts":[{"text":"துணை","lemma":"tuṇai","gloss":"matching"}],"gloss":"matching"},{"surface":"மலர்","parts":[{"text":"மலர்","lemma":"malar","gloss":"flower"}],"gloss":"flower"},{"surface":"பிணையல்","parts":[{"text":"பிணை","lemma":"piṇai","gloss":"tie"},{"text":"அல்","lemma":"al","gloss":"noun suffix"}],"gloss":"garland"},{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"anna","gloss":"like"}],"gloss":"like"},{"surface":"இவர்","parts":[{"text":"இவர்","lemma":"ivar","gloss":"these two"}],"gloss":"these two"}]},{"words":[{"surface":"மணமகிழ்","parts":[{"text":"மணம்","lemma":"maṇam","gloss":"marriage"},{"text":"மகிழ்","lemma":"makiḻ","gloss":"joy"}],"gloss":"joy of marriage"},{"surface":"இயற்கை","parts":[{"text":"இயல்","lemma":"iyal","gloss":"nature"},{"text":"கை","lemma":"kai","gloss":"suffix"}],"gloss":"state"},{"surface":"காட்டியோயே","parts":[{"text":"காட்டியோயே","lemma":"காட்டியோயே","gloss":"you who showed"}],"gloss":"you who showed","split_unverified":true}]}],"literal":"This boy, her five-part hair, to grasp also, and this girl, his / sparse-haired head's single lock, she who pulls, to snap also, / loving foster-mothers, even when restraining, without stopping, / causeless little fights, they engage in indeed! / You are good indeed, oh fate! She of gentle nature, / and him, like a matching flower garland, these two, / their joy-of-marriage nature, you who showed!","translation":"When this boy grabbed her five-part hair, and she pulled and snapped the single lock of hair on his sparse-haired head, their loving foster-mothers tried to restrain them, but without stopping, they engaged in causeless little fights. Oh fate, you are truly good! For you have now shown these two—she of gentle nature and him—united like a matching garland of flowers, in the joyful state of marriage.","modern":"இந்தச் சிறுவன் இவளுடைய ஐந்து வகையாகப் பின்னப்பட்ட கூந்தலைப் பற்றவும், இவள் அவனுடைய மெல்லிய தலையிலுள்ள ஒற்றைக் குடுமியை இழுத்து அறுக்கவும், அன்புடைய செவிலித்தாயர் தடுத்தும் நில்லாமல், அவர்கள் காரணமில்லாத சிறு சண்டைகளைச் செய்து கொண்டிருப்பார்கள். விதியே! நீ மிகவும் நல்லவன். மென்மையான இயல்புடைய இவளையும் அவனையும், ஒன்றுக்கொன்று பொருத்தமான மலர்மாலை போல இணைத்து, அவர்கள் திருமண இன்பத்தில் மகிழ்ந்திருக்கும் இயற்கையான நிலையை எங்களுக்குக் காட்டியுள்ளாயே!","explanation":"This poem is set in the Pālai (wasteland) landscape and is spoken by bystanders who witness a young couple who have eloped and are now happily married. The speakers recall the childhood of the boy and the girl, who used to fight constantly, grabbing each other's hair despite their foster-mothers' attempts to restrain them. These harmless, causeless childhood squabbles have now transformed into a deep, loving marital union. The bystanders praise fate (pāl) for its benevolence in bringing them together. The image of a matching flower garland (tuṇaimalarp piṇaiyal) beautifully illustrates their perfect compatibility and inseparable bond in marriage.","model":"gemini-3.5-flash"}}