{"text":"kuruntokai","n":133,"lines":["புனவன் துடவைப் பொன்போற் சிறுதினை","கிளிகுறைத் துண்ட கூழை யிருவி","பெரும்பெய லுண்மையி னிலையொலித் தாங்கென்","உரஞ் செத்தும் உளெனே தோழியென்","நலம்புதி துண்ட புலம்பி னானே"],"tr":["puṉavaṉ tuṭavaip poṉpōṟ ciṟutiṉai","kiḷikuṟait tuṇṭa kūḻai yiruvi","perumpeya luṇmaiyi ṉilaiyolit tāṅkeṉ","urañ cettum uḷeṉē tōḻiyeṉ","nalamputi tuṇṭa pulampi ṉāṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"உறையூர் முதுகண்ணன் சாத்தனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Uṟaiyūr Mutukaṇṇaṉ Cāttaṉār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"5×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1, other 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 11, āciriyattaḷai 6, kalittaḷai 1, ? 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"புனவன்","tr":"puṉavaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"புன","tr":"puṉa"},{"kind":"nēr","text":"வன்","tr":"vaṉ"}]},{"text":"துடவைப்","tr":"tuṭavaip","foot":"puḷimā","acai":[{"kind":"nirai","text":"துட","tr":"tuṭa"},{"kind":"nēr","text":"வைப்","tr":"vaip"}]},{"text":"பொன்போற்","tr":"poṉpōṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"பொன்","tr":"poṉ"},{"kind":"nēr","text":"போற்","tr":"pōṟ"}]},{"text":"சிறுதினை","tr":"ciṟutiṉai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nirai","text":"தினை","tr":"tiṉai"}]}],[{"text":"கிளிகுறைத்","tr":"kiḷikuṟait","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கிளி","tr":"kiḷi"},{"kind":"nirai","text":"குறைத்","tr":"kuṟait"}]},{"text":"துண்ட","tr":"tuṇṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"துண்","tr":"tuṇ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"கூழை","tr":"kūḻai","foot":"tēmā","acai":[{"kind":"nēr","text":"கூ","tr":"kū"},{"kind":"nēr","text":"ழை","tr":"ḻai"}]},{"text":"யிருவி","tr":"yiruvi","foot"