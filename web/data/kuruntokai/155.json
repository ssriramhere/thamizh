பு","gloss":"descending"}],"gloss":"descending"}]},{"words":[{"surface":"மாலை","parts":[{"text":"மாலை","lemma":"மாலை","gloss":"evening"}],"gloss":"evening"},{"surface":"நனி","parts":[{"text":"நனி","lemma":"நனி","gloss":"abundant/much"}],"gloss":"abundant/much"},{"surface":"விருந்து","parts":[{"text":"விருந்து","lemma":"விருந்து","gloss":"guest/feast"}],"gloss":"guest/feast"},{"surface":"அயர்மார்","parts":[{"text":"அயர்","lemma":"அயர்","gloss":"to perform/receive"},{"text":"மார்","lemma":"மார்","gloss":"infinitival/purposive suffix"}],"gloss":"to receive/perform"}]},{"words":[{"surface":"தேர்","parts":[{"text":"தேர்","lemma":"தேர்","gloss":"chariot"}],"gloss":"chariot"},{"surface":"வரும்","parts":[{"text":"வரு","lemma":"வா","gloss":"come"},{"text":"உம்","lemma":"உம்","gloss":"future relative participle suffix"}],"gloss":"will come"},{"surface":"என்னும்","parts":[{"text":"என்","lemma":"என்","gloss":"say"},{"text":"உம்","lemma":"உம்","gloss":"relative participle suffix"}],"gloss":"saying"},{"surface":"உரை","parts":[{"text":"உரை","lemma":"உரை","gloss":"word/message"}],"gloss":"word/message"},{"surface":"வாராதே","parts":[{"text":"வாராது","lemma":"வாராது","gloss":"does not come"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"does not come indeed"}]}],"literal":"Cleared forest-field plowing loud-roaring farmers / seed-short basket with buds to be crowded / time indeed has come, like wax / in blowing-furnace poured wide-mouthed clear bell / in tree-dense forest to sound, descending the desert path / in the evening, to receive abundant guests / 'the chariot will come' saying, the word does not come!","translation":"The loud-roaring farmers who cleared the old forest-fields now have their small seed-baskets crowded with fresh buds. The evening time has indeed arrived! But the word that says, 'He will descend the desert path and his chariot will come to receive abundant guests in the evening, while the wide-mouthed clear bells, like wax poured into a blowing furnace, ring out in the tree-dense forest,' has not come.","modern":"பழைய காட்டை அழித்து உழுத ஆரவாரம் மிக்க உழவர்களின் சிறிய விதைக்கூடைகள் மலர் அரும்புகளால் நிறைந்துள்ளன. மாலைப் பொழுதும் வந்துவிட்டது. ஆனால், 'ஊது உலையில் ஊற்றிய மெழுகு போல, அகன்ற வாயைக் கொண்ட தெளிவான ஓசையுடைய மணிகள் மரங்கள் நிறைந்த காட்டில் ஒலிக்க, பாலை நிலத்தில் இறங்கி, மாலைப் பொழுதில் விருந்தினரை உபசரிப்பதற்காக அவருடைய தேர் வரும்' என்று சொல்லும் செய்தி இன்னும் வரவில்லையே!","explanation":"The heroine is speaking to her friend during the onset of the evening in the Mullai (forest) season. The rainy season has arrived, marked by farmers carrying baskets filled with fresh jasmine buds instead of seeds, and the evening is drawing in. She anxiously awaits the return of her lover, who promised to return before the rains. She laments that while the time of his promised return has arrived, there is no sound or word of his chariot approaching. The image of the clear bells ringing in the dense forest, sounding like wax melting in a furnace, intensifies her grief and longing. The key words are 'பொழுது' (time/evening), 'தேர் வரும்' (chariot will come), and 'உரை வாராதே' (the word does not come).","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.8],[0.8,1.1],[1.1,1.4],[1.4,1.8],[1.8,2.84],[2.84,2.96],[3.07,3.4],[3.4,4.1],[4.1,4.6],[4.7,5.09],[5.09,5.4],[5.4,5.9],[6.1,6.3],[6.3,6.7],[6.7,7.37],[7.37,7.9],[7.9,8.9],[8.9,9.37],[9.37,10.25],[10.25,10.4],[10.4,10.9],[11.05,11.41],[11.41,11.7],[11.7,12.8],[12.8,13.0],[13.1,13.43],[13.5,13.7]],"female":[[0.0,0.8],[0.8,1.2],[1.2,1.5],[1.5,1.9],[1.9,2.94],[2.94,3.06],[3.17,3.5],[3.5,4.2],[4.2,4.7],[4.8,5.74],[5.74,6.01],[6.01,6.56],[6.83,7.27],[7.27,7.53],[7.53,7.96],[7.96,8.3],[8.3,9.5],[9.5,9.89],[9.89,10.83],[10.83,11.0],[11.0,11.8],[11.8,12.3],[12.3,13.4],[13.4,13.8],[13.8,14.33],[14.33,14.73],[14.73,15.0]]},"sync":[[["முதை","old/ancient"],["புனம்","forest-field"]],[["கொன்ற","cleared/plowed"]],[["ஆர்கலி","loud-roaring"]],[["உழவர்","farmers"]],[["விதை","seed"],["குறு","small"]],[["வட்டி","basket"]],[["போது","bud/flower"],["ஒடு","with"]],[["பொதுள","to crowd/be full"]],[["பொழுதோ","the time indeed"]],[["தான்","indeed"],["வந்தன்றே","it has indeed come"]],[["வந்தன்றே","it has indeed come"]],[["மெழுகான்","with wax"]],[["றூதுலைப்",""]],[["பெய்த",""]],[["பகுவாய்த்",""]],[["தெண்மணி",""]],[["மரம்","tree"],["பயில்","dense/crowded"]],[["இறும்பு","forest/thicket"]],[["இன்","in/of"],["ஆர்ப்ப","to sound"],["சுரன்","desert path"]],[["சுரன்","desert path"],["இழிபு","descending"]],[["மாலை","evening"]],[["நனி","abundant/much"],["விருந்து","guest/feast"]],[["விருந்து","guest/feast"],["அயர்மார்","to receive/perform"]],[["தேர்","chariot"],["வரும்","will come"]],[["என்னும்","saying"]],[["உரை","word/message"],["வாராதே","does not come indeed"]],[["வாராதே","does not come indeed"]]]}