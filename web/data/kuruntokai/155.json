{"text":"kuruntokai","n":155,"lines":["முதைப்புனங் கொன்ற ஆர்கலி உழவர்","விதைக்குறு வட்டி போதொடு பொதுளப்","பொழுதோ தான்வந் தன்றே மெழுகான்","றூதுலைப் பெய்த பகுவாய்த் தெண்மணி","மரம்பயில் இறும்பி னார்ப்பச் சுரனிழிபு","மாலை நனிவிருந் தயர்மார்","தேர்வரும் என்னும் உரைவா ராதே"],"tr":["mutaippuṉaṅ koṉṟa ārkali uḻavar","vitaikkuṟu vaṭṭi pōtoṭu potuḷap","poḻutō tāṉvan taṉṟē meḻukāṉ","ṟūtulaip peyta pakuvāyt teṇmaṇi","marampayil iṟumpi ṉārppac curaṉiḻipu","mālai naṉivirun tayarmār","tērvarum eṉṉum uraivā rātē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"உரோடகத்துக் காரத்தனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Urōṭakattuk Kārattaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 12"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"முதைப்புனங்","tr":"mutaippuṉaṅ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"முதைப்","tr":"mutaip"},{"kind":"nirai","text":"புனங்","tr":"puṉaṅ"}]},{"text":"கொன்ற","tr":"koṉṟa","foot":"tēmā","acai":[{"kind":"nēr","text":"கொன்","tr":"koṉ"},{"kind":"nēr","text":"ற","tr":"ṟa"}]},{"text":"ஆர்கலி","tr":"ārkali","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஆர்","tr":"ār"},{"kind":"nirai","text":"கலி","tr":"kali"}]},{"text":"உழவர்","tr":"uḻavar","foot":"puḷimā","acai":[{"kind":"nirai","text":"உழ","tr":"uḻa"},{"kind":"nēr","text":"வர்","tr":"var"}]}],[{"text":"விதைக்குறு","tr":"vitaikkuṟu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விதைக்","tr":"vitaik"},{"kind":"nirai","text":"குறு","tr":"kuṟu"}]},{"text":"வட்டி","tr":"vaṭṭi","foot":"tēmā","acai":[{"kind":"nēr","text":"வட்","tr":"vaṭ"},{"kind":"nēr","text":"டி","tr":"ṭi"}]},{"text":"போதொடு","tr":"pōtoṭu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"போ","tr":"