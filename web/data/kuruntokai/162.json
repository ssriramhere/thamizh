்லை","lemma":"முல்லை","gloss":"jasmine"}],"gloss":"jasmine"},{"surface":"நீ","parts":[{"text":"நீ","lemma":"நீ","gloss":"you"}],"gloss":"you"},{"surface":"நின்","parts":[{"text":"நின்","lemma":"நின்","gloss":"your"}],"gloss":"your"}]},{"words":[{"surface":"சிறு","parts":[{"text":"சிறு","lemma":"சிறு","gloss":"small"}],"gloss":"small"},{"surface":"வெண்","parts":[{"text":"வெண்","lemma":"வெண்","gloss":"white"}],"gloss":"white","split_unverified":true},{"surface":"முகையின்","parts":[{"text":"முகை","lemma":"முகை","gloss":"bud"},{"text":"இன்","lemma":"இன்","gloss":"oblique suffix"}],"gloss":"of the buds"},{"surface":"முறுவல்","parts":[{"text":"முறுவல்","lemma":"முறுவல்","gloss":"smile"}],"gloss":"smile"},{"surface":"கொண்டனை","parts":[{"text":"கொண்டனை","lemma":"கொண்டனை","gloss":"you have taken"}],"gloss":"you have taken","split_unverified":true}]},{"words":[{"surface":"நகுவை","parts":[{"text":"நகு","lemma":"நகு","gloss":"laugh"},{"text":"வை","lemma":"ஐ","gloss":"second person singular future suffix"}],"gloss":"you laugh"},{"surface":"போல","parts":[{"text":"போல","lemma":"போல","gloss":"like"}],"gloss":"like"},{"surface":"காட்டல்","parts":[{"text":"காட்டு","lemma":"காட்டு","gloss":"show"},{"text":"அல்","lemma":"அல்","gloss":"verbal noun suffix"}],"gloss":"showing"}]},{"words":[{"surface":"தகுமோ","parts":[{"text":"தகு","lemma":"தகு","gloss":"be proper"},{"text":"உம்","lemma":"உம்","gloss":"habitual suffix"},{"text":"ஓ","lemma":"ஓ","gloss":"interrogative particle"}],"gloss":"is it proper?"},{"surface":"மற்று","parts":[{"text":"மற்று","lemma":"மற்று","gloss":"indeed"}],"gloss":"indeed"},{"surface":"இது","parts":[{"text":"இது","lemma":"இது","gloss":"this"}],"gloss":"this"},{"surface":"தமியோர்","parts":[{"text":"தமியோர்","lemma":"தமியோர்","gloss":"lonely people"}],"gloss":"lonely people","split_unverified":true},{"surface":"மாட்டே","parts":[{"text":"மாட்டே","lemma":"மாட்டே","gloss":"towards"}],"gloss":"towards","split_unverified":true}]}],"literal":"In the wide land having water given by the rainy season, / in the dim evening that brings many entering, / O Mullai, may you live, Mullai! You, with your / small white buds, having taken a smile, / appearing as if you are laughing, / is this proper indeed towards those who are alone?","translation":"In the vast land blessed with water by the rainy season, during the dim evening when everyone returns home, may you live long, O Mullai jasmine! Is it fair for you to wear a smile with your tiny white buds and mock those of us who are traveling all alone?","modern":"மழைக்காலம் தந்த நீரையுடைய அகன்ற நிலத்தில், பலர் தம் வீடுகளுக்குள் நுழையும் மங்கலான மாலைப் பொழுதில், முல்லை மலரே! நீ வாழ்க! உன்னுடைய சிறிய வெண்மையான மொட்டுகளால் புன்னகை கொண்டு, என்னைப்பார்த்துச் சிரிப்பது போலக் காட்டுவது, தனியாக இருக்கும் என்னிடத்துத் தகுதியானதா?","explanation":"The hero is returning home to his beloved during the rainy season, which is the characteristic time of the Mullai (forest) landscape. As evening falls—a time when families reunite and travelers return home—he notices the Mullai (wild jasmine) buds beginning to bloom. To his lonely eyes, the opening white buds look like a mocking smile, laughing at his solitary state and his delay. He addresses the jasmine plant, wishing it well but gently asking if it is fair to mock a lonely traveler. The imagery of the blooming jasmine in the evening perfectly evokes the Mullai theme of patient waiting and the pain of separation.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,1.0],[1.0,1.3],[1.3,2.0],[2.0,2.61],[2.61,3.1],[3.1,3.7],[3.7,4.2],[4.2,4.7],[4.7,5.0],[5.0,5.4],[5.4,6.0],[6.0,6.8],[6.8,7.2],[7.2,7.65],[7.65,8.1],[8.28,9.0],[9.0,9.4],[9.4,9.7],[9.7,10.13],[10.13,10.7],[10.7,11.6],[11.6,11.9]],"female":[[0.0,0.78],[0.78,1.02],[1.1,1.5],[1.5,2.3],[2.3,2.97],[2.97,3.5],[3.5,4.1],[4.1,4.7],[4.7,5.5],[5.5,5.8],[5.8,6.2],[6.2,6.9],[6.9,7.45],[7.45,8.0],[8.0,8.4],[8.4,9.3],[9.3,10.0],[10.0,10.6],[10.6,11.0],[11.0,11.51],[11.51,12.2],[12.2,13.2],[13.2,13.5]]},"sync":[[["கார்","rainy season"],["புறத்து","on the outside"]],[["புறத்து","on the outside"],["தந்த","that brought"]],[["நீர்","water"],["உடை","possessing"]],[["வியன்","vast"],["புலத்து","of the field"]],[["பலர்","many people"],["புகு","entering"]],[["தரூஉம்","bringing"]],[["புல்","dim"],["என்","called"]],[["மாலை","evening"]],[["முல்லை","jasmine"]],[["வாழியோ","may you live!"]],[["முல்லை","jasmine"]],[["நீ","you"],["நின்","your"]],[["சிறு","small"],["வெண்","white"]],[["முகையின்","of the buds"]],[["முறுவல்","smile"]],[["கொண்டனை","you have taken"]],[["நகுவை","you laugh"]],[["போல","like"],["காட்டல்","showing"]],[["காட்டல்","showing"]],[["தகுமோ","is it proper?"]],[["மற்று","indeed"],["இது","this"]],[["தமியோர்","lonely people"]],[["மாட்டே","towards"]]]}