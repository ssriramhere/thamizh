{"text":"kuruntokai","n":162,"lines":["கார்புறத் தந்த நீருடை வியன்புலத்துப்","பலர்புகு தரூஉம் புல்லென் மாலை","முல்லை வாழியோ முல்லை நீநின்","சிறுவெண் முகையின் முறுவல் கொண்டனை","நகுவை போலக் காட்டல்","தகுமோ மற்றிது தமியோர் மாட்டே"],"tr":["kārpuṟat tanta nīruṭai viyaṉpulattup","palarpuku tarūum pulleṉ mālai","mullai vāḻiyō mullai nīniṉ","ciṟuveṇ mukaiyiṉ muṟuval koṇṭaṉai","nakuvai pōlak kāṭṭal","takumō maṟṟitu tamiyōr māṭṭē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவன் கூற்று","poet_ta":"கருவூர்ப் பவுத்திரனார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Karuvūrp Pavuttiraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 6, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கார்புறத்","tr":"kārpuṟat","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கார்","tr":"kār"},{"kind":"nirai","text":"புறத்","tr":"puṟat"}]},{"text":"தந்த","tr":"tanta","foot":"tēmā","acai":[{"kind":"nēr","text":"தந்","tr":"tan"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"நீருடை","tr":"nīruṭai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nirai","text":"ருடை","tr":"ruṭai"}]},{"text":"வியன்புலத்துப்","tr":"viyaṉpulattup","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"வியன்","tr":"viyaṉ"},{"kind":"nirai","text":"புலத்","tr":"pulat"},{"kind":"nēr","text":"துப்","tr":"tup"}]}],[{"text":"பலர்புகு","tr":"palarpuku","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பலர்","tr":"palar"},{"kind":"nirai","text":"புகு","tr":"puku"}]},{"text":"தரூஉம்","tr":"tarūum","foot":"puḷimā","acai":[{"kind":"nirai","text":"தரூ","tr":"tarū"},{"kind":"nēr","text":"உம்","tr":"um"}]},{"text":"புல்லென்","tr":"pulleṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"புல்","tr":"pul"}