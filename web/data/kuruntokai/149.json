{"text":"kuruntokai","n":149,"lines":["அளிதோ தானே நாணே நம்மொடு","நனிநீ டுழந்தன்று மன்னே இனியே","வான்பூங் கரும்பின் ஓங்குமணற் சிறுசிறை","தீம்புனல் நெரிதர வீய்ந்துக் காஅங்குத்","தாங்கு மளவைத் தாங்கிக்","காம நெரிதரக் கைந்நில் லாவே"],"tr":["aḷitō tāṉē nāṇē nammoṭu","naṉinī ṭuḻantaṉṟu maṉṉē iṉiyē","vāṉpūṅ karumpiṉ ōṅkumaṇaṟ ciṟuciṟai","tīmpuṉal neritara vīyntuk kāaṅkut","tāṅku maḷavait tāṅkik","kāma neritarak kainnil lāvē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"வெள்ளி வீதியார்","speaker_en":"the heroine (talaivi)","poet_tr":"Veḷḷi Vītiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 20, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 10, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அளிதோ","tr":"aḷitō","foot":"puḷimā","acai":[{"kind":"nirai","text":"அளி","tr":"aḷi"},{"kind":"nēr","text":"தோ","tr":"tō"}]},{"text":"தானே","tr":"tāṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"னே","tr":"ṉē"}]},{"text":"நாணே","tr":"nāṇē","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"ணே","tr":"ṇē"}]},{"text":"நம்மொடு","tr":"nammoṭu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நம்","tr":"nam"},{"kind":"nirai","text":"மொடு","tr":"moṭu"}]}],[{"text":"நனிநீ","tr":"naṉinī","foot":"puḷimā","acai":[{"kind":"nirai","text":"நனி","tr":"naṉi"},{"kind":"nēr","text":"நீ","tr":"nī"}]},{"text":"டுழந்தன்று","tr":"ṭuḻantaṉṟu","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"டுழந்","tr":"ṭuḻan"},{"kind":"nēr","text":"தன்","tr":"taṉ"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"மன்னே","tr":"maṉṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"மன்","tr":"maṉ"},{"kind":"nēr","text":"னே","tr":"ṉē"}]},{"text":"இனியே","tr":"iṉiyē","foot":"puḷimā","