{"text":"kuruntokai","n":282,"lines":["செவ்விகொள் வரகின் செஞ்சுவற் கலித்த","கௌவை நாற்றின் காரிரு ளோரிலை","நவ்வி நாண்மறி கவ்விக் கடன்கழிக்கும்","காரெதிர் தண்புனங் காணிற் கைவளை","நீர்திகழ் சிலம்பின் ஓராங் கவிழ்ந்த","வெண்கூ தாளத் தந்தூம்பு புதுமலர்","ஆர்கழல் புகுவ போலச்","சோர்குவ வல்ல என்பர்கொல் நமரே"],"tr":["cevvikoḷ varakiṉ ceñcuvaṟ kalitta","kauvai nāṟṟiṉ kāriru ḷōrilai","navvi nāṇmaṟi kavvik kaṭaṉkaḻikkum","kāretir taṇpuṉaṅ kāṇiṟ kaivaḷai","nīrtikaḻ cilampiṉ ōrāṅ kaviḻnta","veṇkū tāḷat tantūmpu putumalar","ārkaḻal pukuva pōlac","cōrkuva valla eṉparkol namarē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"நாகம் போத்தனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Nākam Pōttaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 11, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"செவ்விகொள்","tr":"cevvikoḷ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"செவ்","tr":"cev"},{"kind":"nirai","text":"விகொள்","tr":"vikoḷ"}]},{"text":"வரகின்","tr":"varakiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"வர","tr":"vara"},{"kind":"nēr","text":"கின்","tr":"kiṉ"}]},{"text":"செஞ்சுவற்","tr":"ceñcuvaṟ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"செஞ்","tr":"ceñ"},{"kind":"nirai","text":"சுவற்","tr":"cuvaṟ"}]},{"text":"கலித்த","tr":"kalitta","foot":"puḷimā","acai":[{"kind":"nirai","text":"கலித்","tr":"kalit"},{"kind":"nēr","text":"த","tr":"ta"}]}],[{"text":"கௌவை","tr":"kauvai","foot":"tēmā","acai":[{"kind":"nēr","text":"கௌ","tr":"kau"},{"kind":"nēr","text":"வை","tr":"vai"}]},{"text":"நாற்றின்","tr":"nāṟṟiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"நாற்","tr":"nāṟ"},{"kind":"nēr","text":"றின்","tr":"ṟiṉ"}]},{"text":"காரிரு","tr":"kāriru","foot":"kūv