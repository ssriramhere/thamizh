{"text":"kuruntokai","n":78,"lines":["பெருவரை மிசையது நெடுவெள் ளருவி","முதுவாய்க் கோடியர் முழவின் ததும்பிச்","சிலம்பின் இழிதரும் இலங்குமலை வெற்ப","நோதக் கன்றே காமம் யாவதும்","நன்றென உணரார் மாட்டும்","சென்றே நிற்கும் பெரும்பே தைமைத்தே"],"tr":["peruvarai micaiyatu neṭuveḷ ḷaruvi","mutuvāyk kōṭiyar muḻaviṉ tatumpic","cilampiṉ iḻitarum ilaṅkumalai veṟpa","nōtak kaṉṟē kāmam yāvatum","naṉṟeṉa uṇarār māṭṭum","ceṉṟē niṟkum perumpē taimaittē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"பாங்கன் கூற்று","poet_ta":"நக்கீரனார்","speaker_en":"the hero's companion (pāṅkaṉ)","poet_tr":"Nakkīraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பெருவரை","tr":"peruvarai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெரு","tr":"peru"},{"kind":"nirai","text":"வரை","tr":"varai"}]},{"text":"மிசையது","tr":"micaiyatu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மிசை","tr":"micai"},{"kind":"nirai","text":"யது","tr":"yatu"}]},{"text":"நெடுவெள்","tr":"neṭuveḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெடு","tr":"neṭu"},{"kind":"nēr","text":"வெள்","tr":"veḷ"}]},{"text":"ளருவி","tr":"ḷaruvi","foot":"puḷimā","acai":[{"kind":"nirai","text":"ளரு","tr":"ḷaru"},{"kind":"nēr","text":"வி","tr":"vi"}]}],[{"text":"முதுவாய்க்","tr":"mutuvāyk","foot":"puḷimā","acai":[{"kind":"nirai","text":"முது","tr":"mutu"},{"kind":"nēr","text":"வாய்க்","tr":"vāyk"}]},{"text":"கோடியர்","tr":"kōṭiyar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கோ","tr":"kō"},{"kind":"nirai","text":"டியர்","tr":"ṭiyar"}]},{"text":"முழவின்","tr":"muḻaviṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"முழ","tr":"muḻa"},{"kind":"nēr","text":"வின்","tr":"viṉ"}]},{"text