t":"போல்","lemma":"போலுதல்","gloss":"resemble"},{"text":"வன்","lemma":"வன்","gloss":"I (pronominal suffix)"}],"gloss":"I am like"},{"surface":"முள்","parts":[{"text":"முள்","lemma":"முள்","gloss":"thorn"}],"gloss":"thorn"},{"surface":"எயிற்","parts":[{"text":"எயிற்","lemma":"எயிற்","gloss":"teeth"}],"gloss":"teeth","split_unverified":true}]},{"words":[{"surface":"றமிழ்த","parts":[{"text":"றமிழ்த","lemma":"றமிழ்த","gloss":"nectar"}],"gloss":"nectar","split_unverified":true},{"surface":"மூறும்","parts":[{"text":"ம்","lemma":"ம்","gloss":"consonant"},{"text":"ஊறும்","lemma":"ஊறுதல்","gloss":"oozing"}],"gloss":"that oozes"},{"surface":"அஞ்","parts":[{"text":"அஞ்","lemma":"அஞ்","gloss":"beautiful"}],"gloss":"beautiful","split_unverified":true},{"surface":"செவ்வாய்","parts":[{"text":"செவ்வாய்","lemma":"செவ்வாய்","gloss":"red mouth"}],"gloss":"red mouth","split_unverified":true},{"surface":"கமழ்","parts":[{"text":"கமழ்","lemma":"கமழ்தல்","gloss":"fragrant"}],"gloss":"fragrant"},{"surface":"அகில்","parts":[{"text":"அகில்","lemma":"அகில்","gloss":"eaglewood"}],"gloss":"eaglewood"}]},{"words":[{"surface":"ஆர","parts":[{"text":"ஆர","lemma":"ஆர","gloss":"sandalwood"}],"gloss":"sandalwood","split_unverified":true},{"surface":"நாறும்","parts":[{"text":"நாறும்","lemma":"நாறுதல்","gloss":"fragrant"}],"gloss":"fragrant"},{"surface":"அறல்","parts":[{"text":"அறல்","lemma":"அறல்","gloss":"black sand"}],"gloss":"black sand"},{"surface":"போல்","parts":[{"text":"போல்","lemma":"போலுதல்","gloss":"resembling"}],"gloss":"resembling"},{"surface":"கூந்தல்","parts":[{"text":"கூந்தல்","lemma":"கூந்தல்","gloss":"hair"}],"gloss":"hair"}]},{"words":[{"surface":"பேர்","parts":[{"text":"பேர்","lemma":"பேர்","gloss":"great"}],"gloss":"great","split_unverified":true},{"surface":"அமர்","parts":[{"text":"அமர்","lemma":"அமர்","gloss":"beautiful"}],"gloss":"beautiful"},{"surface":"மழை","parts":[{"text":"மழை","lemma":"மழை","gloss":"cool"}],"gloss":"cool"},{"surface":"கண்","parts":[{"text":"கண்","lemma":"கண்","gloss":"eye"}],"gloss":"eye"},{"surface":"கொடிச்சி","parts":[{"text":"கொடிச்சி","lemma":"கொடிச்சி","gloss":"mountain girl"}],"gloss":"mountain girl"}]},{"words":[{"surface":"மூரல்","parts":[{"text":"மூரல்","lemma":"மூரல்","gloss":"smile"}],"gloss":"smile"},{"surface":"முறுவலொடு","parts":[{"text":"முறுவல்","lemma":"முறுவல்","gloss":"smile"},{"text":"ஒடு","lemma":"ஒடு","gloss":"with"}],"gloss":"with a smile"},{"surface":"மதைஇய","parts":[{"text":"மதை","lemma":"மதைத்தல்","gloss":"to be exuberant"},{"text":"இய","lemma":"இய","gloss":"adjectival participle suffix"}],"gloss":"exuberant"},{"surface":"நோக்கே","parts":[{"text":"நோக்கு","lemma":"நோக்கு","gloss":"look"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"the look indeed"}]}],"literal":"Thinking of her, I will see, I am like, her thorn-sharp teeth / and nectar-oozing beautiful red mouth, fragrant eaglewood / and sandalwood smelling, black-sand-like hair, / great, beautiful, cool-eyed mountain girl's / gentle smile with a laugh, and exuberant look.","translation":"Whenever I think of her, I seem to see her right before me: the mountain girl with thorn-sharp teeth, a beautiful red mouth oozing nectar, hair like black river-sand smelling of fragrant eaglewood and sandalwood, and great, beautiful, cool eyes. I see her gentle smile and her exuberant look.","modern":"நினைத்துப் பார்க்கும்போதெல்லாம் அவளை நேரில் காண்பது போல உணர்கிறேன்; முள் போன்ற பற்களையும், அமிழ்தம் சுரக்கும் அழகான சிவந்த வாயையும், அகிலும் சந்தனமும் கமழும் ஆற்று மணல் போன்ற கூந்தலையும், பெரிய குளிர்ந்த கண்களையும் உடைய அந்தக் குறிஞ்சி நிலப் பெண்ணின் புன்னகையையும், அவளது செருக்குமிக்க பார்வையையும் நான் காண்கிறேன்.","explanation":"In this poem, the hero speaks about his beloved, a mountain girl, expressing how deeply she is etched in his mind. He says that whenever he thinks of her, she appears vividly before his eyes as if she were physically present. He describes her sharp, thorn-like teeth, her sweet red mouth that seems to ooze nectar, and her dark hair that smells of fragrant eaglewood and sandalwood, resembling the black sand of a riverbed. Her large, cool eyes and her gentle, proud smile are unforgettable to him. This poem belongs to the Kuriñci (mountainous) landscape, as indicated by the word 'koṭicci' (mountain girl) and the fragrant forest trees like akil and sandalwood.","model":"gemini-3.5-flash"}}