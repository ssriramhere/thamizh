{"text":"kuruntokai","n":286,"lines":["உள்ளிக் காண்பென் போல்வன் முள்ளெயிற்","றமிழ்த மூறும்அஞ் செவ்வாய்க் கமழகில்","ஆர நாறும் அறல்போற் கூந்தல்","பேரமர் மழைக்கட் கொடிச்சி","மூரல் முறுவலொடு மதைஇய நோக்கே"],"tr":["uḷḷik kāṇpeṉ pōlvaṉ muḷḷeyiṟ","ṟamiḻta mūṟumañ cevvāyk kamaḻakil","āra nāṟum aṟalpōṟ kūntal","pēramar maḻaikkaṭ koṭicci","mūral muṟuvaloṭu mataiiya nōkkē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"எயிற்றியனார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Eyiṟṟiyaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 7, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"உள்ளிக்","tr":"uḷḷik","foot":"tēmā","acai":[{"kind":"nēr","text":"உள்","tr":"uḷ"},{"kind":"nēr","text":"ளிக்","tr":"ḷik"}]},{"text":"காண்பென்","tr":"kāṇpeṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"காண்","tr":"kāṇ"},{"kind":"nēr","text":"பென்","tr":"peṉ"}]},{"text":"போல்வன்","tr":"pōlvaṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"போல்","tr":"pōl"},{"kind":"nēr","text":"வன்","tr":"vaṉ"}]},{"text":"முள்ளெயிற்","tr":"muḷḷeyiṟ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"முள்","tr":"muḷ"},{"kind":"nirai","text":"ளெயிற்","tr":"ḷeyiṟ"}]}],[{"text":"றமிழ்த","tr":"ṟamiḻta","foot":"puḷimā","acai":[{"kind":"nirai","text":"றமிழ்","tr":"ṟamiḻ"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"மூறும்அஞ்","tr":"mūṟumañ","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"மூ","tr":"mū"},{"kind":"nēr","text":"றும்","tr":"ṟum"},{"kind":"nēr","text":"அஞ்","tr":"añ"}]},{"text":"செவ்வாய்க்","tr":"cevvāyk","foot":"tēmā","acai":[{"kind":"nēr","text":"செவ்","tr":"cev"},{"kind":"nēr","text":"வாய்க்","tr":"vāyk"}]},{"text":"கமழகில்","tr":"kamaḻakil","foot":"karuviḷam","acai":[{"kind"