{"text":"kuruntokai","n":139,"lines":["மனையுறை கோழிக் குறுங்காற் பேடை","வேலி வெருகின மாலை யுற்றெனப்","புகுமிட னறியாது தொகுபுடன் குழீஇய","பைதற் பிள்ளைக் கிளைபயிர்ந் தாஅங்","கின்னா திசைக்கும் அம்பலொடு","வாரல் வாழிய ரையவெந் தெருவே"],"tr":["maṉaiyuṟai kōḻik kuṟuṅkāṟ pēṭai","vēli verukiṉa mālai yuṟṟeṉap","pukumiṭa ṉaṟiyātu tokupuṭaṉ kuḻīiya","paitaṟ piḷḷaik kiḷaipayirn tāaṅ","kiṉṉā ticaikkum ampaloṭu","vāral vāḻiya raiyaven teruvē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தோழி கூற்று","poet_ta":"ஒக்கூர் மாசாத்தியார்","speaker_en":"her friend (tōḻi)","poet_tr":"Okkūr Mācāttiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 10, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மனையுறை","tr":"maṉaiyuṟai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மனை","tr":"maṉai"},{"kind":"nirai","text":"யுறை","tr":"yuṟai"}]},{"text":"கோழிக்","tr":"kōḻik","foot":"tēmā","acai":[{"kind":"nēr","text":"கோ","tr":"kō"},{"kind":"nēr","text":"ழிக்","tr":"ḻik"}]},{"text":"குறுங்காற்","tr":"kuṟuṅkāṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"குறுங்","tr":"kuṟuṅ"},{"kind":"nēr","text":"காற்","tr":"kāṟ"}]},{"text":"பேடை","tr":"pēṭai","foot":"tēmā","acai":[{"kind":"nēr","text":"பே","tr":"pē"},{"kind":"nēr","text":"டை","tr":"ṭai"}]}],[{"text":"வேலி","tr":"vēli","foot":"tēmā","acai":[{"kind":"nēr","text":"வே","tr":"vē"},{"kind":"nēr","text":"லி","tr":"li"}]},{"text":"வெருகின","tr":"verukiṉa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வெரு","tr":"veru"},{"kind":"nirai","text":"கின","tr":"kiṉa"}]},{"text":"மாலை","tr":"mālai","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"யுற்றெனப்","tr":"yuṟṟeṉap","foot":"kūviḷa