{"text":"kuruntokai","n":294,"lines":["கடலுட னாடியும் கான லல்கியும்","தொடலை யாயமொடு தழுவணி யயர்ந்தும்","நொதுமலர் போலக் கதுமென வந்து","முயங்கினன் செலினே யலர்ந்தன்று மன்னே","தித்தி பரந்த பைத்தக லல்குல்","திருந்திழை துயல்வுக்கோட் டசைத்த பசுங்குழைத்","தழையினும் உழையிற் போகான்","தான்தந் தனன்யாய் காத்தோம் பல்லே"],"tr":["kaṭaluṭa ṉāṭiyum kāṉa lalkiyum","toṭalai yāyamoṭu taḻuvaṇi yayarntum","notumalar pōlak katumeṉa vantu","muyaṅkiṉaṉ celiṉē yalarntaṉṟu maṉṉē","titti paranta paittaka lalkul","tiruntiḻai tuyalvukkōṭ ṭacaitta pacuṅkuḻait","taḻaiyiṉum uḻaiyiṟ pōkāṉ","tāṉtan taṉaṉyāy kāttōm pallē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தோழி கூற்று","poet_ta":"அஞ்சிலாந்தையார்","speaker_en":"her friend (tōḻi)","poet_tr":"Añcilāntaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 14, āciriyattaḷai 14, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கடலுட","tr":"kaṭaluṭa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கட","tr":"kaṭa"},{"kind":"nirai","text":"லுட","tr":"luṭa"}]},{"text":"னாடியும்","tr":"ṉāṭiyum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"னா","tr":"ṉā"},{"kind":"nirai","text":"டியும்","tr":"ṭiyum"}]},{"text":"கான","tr":"kāṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"லல்கியும்","tr":"lalkiyum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"லல்","tr":"lal"},{"kind":"nirai","text":"கியும்","tr":"kiyum"}]}],[{"text":"தொடலை","tr":"toṭalai","foot":"puḷimā","acai":[{"kind":"nirai","text":"தொட","tr":"toṭa"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"யாயமொடு","tr":"yāyamoṭu","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nirai","text":"யமொ","tr":"yamo"},{"kind":"nēr","tex