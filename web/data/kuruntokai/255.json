{"text":"kuruntokai","n":255,"lines":["பொத்தில் காழ அத்த யாஅத்துப்","பொரியரை முழுமுதல் உருவக் குத்தி","மறங்கெழு தடக்கையின் வாங்கி உயங்குநடைச்","சிறுகண் பெருநிரை உறுபசி தீர்க்கும்","தடமருப் பியானை கண்டனர் தோழி","தங்கட னிறீஇய ரெண்ணி யிடந்தொறும்","காமர் பொருட்பிணிப் போகிய","நாம்வெங் காதலர் சென்ற வாறே"],"tr":["pottil kāḻa atta yāattup","poriyarai muḻumutal uruvak kutti","maṟaṅkeḻu taṭakkaiyiṉ vāṅki uyaṅkunaṭaic","ciṟukaṇ perunirai uṟupaci tīrkkum","taṭamarup piyāṉai kaṇṭaṉar tōḻi","taṅkaṭa ṉiṟīiya reṇṇi yiṭantoṟum","kāmar poruṭpiṇip pōkiya","nāmveṅ kātalar ceṉṟa vāṟē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"கடுகு பெருந்தேவனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kaṭuku Peruntēvaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 14, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பொத்தில்","tr":"pottil","foot":"tēmā","acai":[{"kind":"nēr","text":"பொத்","tr":"pot"},{"kind":"nēr","text":"தில்","tr":"til"}]},{"text":"காழ","tr":"kāḻa","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"ழ","tr":"ḻa"}]},{"text":"அத்த","tr":"atta","foot":"tēmā","acai":[{"kind":"nēr","text":"அத்","tr":"at"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"யாஅத்துப்","tr":"yāattup","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"அத்","tr":"at"},{"kind":"nēr","text":"துப்","tr":"tup"}]}],[{"text":"பொரியரை","tr":"poriyarai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பொரி","tr":"pori"},{"kind":"nirai","text":"யரை","tr":"yarai"}]},{"text":"முழுமுதல்","tr":"muḻumutal","foot":"karuviḷam","acai":[{"kind":"nirai","text":"முழு","tr":"muḻu"},{"kind":"nirai","text":"முதல்","tr":"mutal"}]},{"te