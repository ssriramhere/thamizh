{"text":"kuruntokai","n":230,"lines":["அம்ம வாழி தோழி கொண்கன்","தானது துணிகுவ னல்லன் யானென்","பேதை மையாற் பெருந்தகை கெழுமி","நோதகச் செய்ததொன் றுடையேன் கொல்லோ","வயச்சுறா வழங்குநீர் அத்தம்","சின்னாள் அன்ன வரவறி யானே"],"tr":["amma vāḻi tōḻi koṇkaṉ","tāṉatu tuṇikuva ṉallaṉ yāṉeṉ","pētai maiyāṟ peruntakai keḻumi","nōtakac ceytatoṉ ṟuṭaiyēṉ kollō","vayaccuṟā vaḻaṅkunīr attam","ciṉṉāḷ aṉṉa varavaṟi yāṉē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தோழி கூற்று","poet_ta":"அறிவுடை நம்பியார்","speaker_en":"her friend (tōḻi)","poet_tr":"Aṟivuṭai Nampiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 7"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அம்ம","tr":"amma","foot":"tēmā","acai":[{"kind":"nēr","text":"அம்","tr":"am"},{"kind":"nēr","text":"ம","tr":"ma"}]},{"text":"வாழி","tr":"vāḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"கொண்கன்","tr":"koṇkaṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"கொண்","tr":"koṇ"},{"kind":"nēr","text":"கன்","tr":"kaṉ"}]}],[{"text":"தானது","tr":"tāṉatu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nirai","text":"னது","tr":"ṉatu"}]},{"text":"துணிகுவ","tr":"tuṇikuva","foot":"karuviḷam","acai":[{"kind":"nirai","text":"துணி","tr":"tuṇi"},{"kind":"nirai","text":"குவ","tr":"kuva"}]},{"text":"னல்லன்","tr":"ṉallaṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"னல்","tr":"ṉal"},{"kind":"nēr","text":"லன்","tr":"laṉ"}]},{"text":"யானென்","tr":"yāṉeṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னென்","tr":"ṉeṉ"}]}],[{"text