{"text":"kuruntokai","n":212,"lines":["கொண்கன் ஊர்ந்த கொடுஞ்சி நெடுந்தேர்","தெண்கட லடைகரைத் தௌிமணி யொலிப்பக்","காண வந்து நாணப் பெயரும்","அளிதோ தானே காமம்","விளிவது மன்ற நோகோ யானே"],"tr":["koṇkaṉ ūrnta koṭuñci neṭuntēr","teṇkaṭa laṭaikarait taumaṇi yolippak","kāṇa vantu nāṇap peyarum","aḷitō tāṉē kāmam","viḷivatu maṉṟa nōkō yāṉē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தோழி கூற்று","poet_ta":"நெய்தற் கார்க்கியன்","speaker_en":"her friend (tōḻi)","poet_tr":"Neytaṟ Kārkkiyaṉ"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 7"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கொண்கன்","tr":"koṇkaṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"கொண்","tr":"koṇ"},{"kind":"nēr","text":"கன்","tr":"kaṉ"}]},{"text":"ஊர்ந்த","tr":"ūrnta","foot":"tēmā","acai":[{"kind":"nēr","text":"ஊர்ந்","tr":"ūrn"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"கொடுஞ்சி","tr":"koṭuñci","foot":"puḷimā","acai":[{"kind":"nirai","text":"கொடுஞ்","tr":"koṭuñ"},{"kind":"nēr","text":"சி","tr":"ci"}]},{"text":"நெடுந்தேர்","tr":"neṭuntēr","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெடுந்","tr":"neṭun"},{"kind":"nēr","text":"தேர்","tr":"tēr"}]}],[{"text":"தெண்கட","tr":"teṇkaṭa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தெண்","tr":"teṇ"},{"kind":"nirai","text":"கட","tr":"kaṭa"}]},{"text":"லடைகரைத்","tr":"laṭaikarait","foot":"karuviḷam","acai":[{"kind":"nirai","text":"லடை","tr":"laṭai"},{"kind":"nirai","text":"கரைத்","tr":"karait"}]},{"text":"தௌமணி","tr":"taumaṇi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தௌ","tr":"tau"},{"kind":"nirai","text":"மணி","tr":"maṇi"}]},{"text":"யொலிப்பக்","tr":"yolippak","foot":"puḷimā","acai":[{"kind":"nirai","text":"யொலிப்","tr":"yolip"},{"kind":"nēr","text":"பக்","tr":"pak"