,"text":"வலி","tr":"vali"},{"kind":"nēr","text":"யா","tr":"yā"}]},{"text":"நெஞ்சம்","tr":"neñcam","foot":"tēmā","acai":[{"kind":"nēr","text":"நெஞ்","tr":"neñ"},{"kind":"nēr","text":"சம்","tr":"cam"}]},{"text":"வலிப்ப","tr":"valippa","foot":"puḷimā","acai":[{"kind":"nirai","text":"வலிப்","tr":"valip"},{"kind":"nēr","text":"ப","tr":"pa"}]}],[{"text":"வாழ்வேன்","tr":"vāḻvēṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"வாழ்","tr":"vāḻ"},{"kind":"nēr","text":"வேன்","tr":"vēṉ"}]},{"text":"தோழியென்","tr":"tōḻiyeṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nirai","text":"ழியென்","tr":"ḻiyeṉ"}]},{"text":"வன்க","tr":"vaṉka","foot":"tēmā","acai":[{"kind":"nēr","text":"வன்","tr":"vaṉ"},{"kind":"nēr","text":"க","tr":"ka"}]},{"text":"ணானே","tr":"ṇāṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"ணா","tr":"ṇā"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"பல்வீ","parts":[{"text":"பல்","lemma":"pal","gloss":"many"},{"text":"வீ","lemma":"vī","gloss":"blossom"}],"gloss":"many blossoms"},{"surface":"பட்ட","parts":[{"text":"பட்ட","lemma":"paṭu","gloss":"having bloomed"}],"gloss":"having bloomed"},{"surface":"பசுநனைக்","parts":[{"text":"பசு","lemma":"pacu","gloss":"fresh/green"},{"text":"நனை","lemma":"naṉai","gloss":"bud"},{"text":"க்","lemma":"k","gloss":"sandhi consonant"}],"gloss":"fresh buds"},{"surface":"குரவம்","parts":[{"text":"குரவம்","lemma":"kuravam","gloss":"bottle-flower tree"}],"gloss":"kuravam tree"}]},{"words":[{"surface":"பொரிப்பூம்","parts":[{"text":"பொரிப்பூம்","lemma":"பொரிப்பூம்","gloss":"flowers like parched grain"}],"gloss":"flowers like parched grain","split_unverified":true},{"surface":"புன்கொடு","parts":[{"text":"புன்கு","lemma":"puṉku","gloss":"Indian beech tree"},{"text":"ஒடு","lemma":"oṭu","gloss":"with"}],"gloss":"with the puṅku tree"},{"surface":"பொழிலணிக்","parts":[{"text":"பொழில்","lemma":"poḻil","gloss":"grove"},{"text":"அணி","lemma":"aṇi","gloss":"beauty/adornment"},{"text":"க்","lemma":"k","gloss":"sandhi consonant"}],"gloss":"adornment of the grove"},{"surface":"கொளாஅச்","parts":[{"text":"கொள்","lemma":"koḷ","gloss":"to take"},{"text":"ஆஅ","lemma":"āa","gloss":"having taken (alapeṭai)"},{"text":"ச்","lemma":"c","gloss":"sandhi consonant"}],"gloss":"having taken"}]},{"words":[{"surface":"சினையினி","parts":[{"text":"சினையினி","lemma":"சினையினி","gloss":"sweet branches"}],"gloss":"sweet branches","split_unverified":true},{"surface":"தாகிய","parts":[{"text":"தாகிய","lemma":"tākiya","gloss":"having become"}],"gloss":"having become"},{"surface":"காலையுங்","parts":[{"text":"காலை","lemma":"kālai","gloss":"season/time"},{"text":"உம்","lemma":"um","gloss":"even/also"},{"text":"ங்","lemma":"ṅ","gloss":"sandhi consonant"}],"gloss":"even in the season"},{"surface":"காதலர்","parts":[{"text":"காதலர்","lemma":"kātalar","gloss":"lover"}],"gloss":"the lover"}]},{"words":[{"surface":"பேணா","parts":[{"text":"பேண்","lemma":"pēṇ","gloss":"to cherish"},{"text":"ஆ","lemma":"ā","gloss":"negative suffix"}],"gloss":"not cherishing"},{"surface":"ராயினும்","parts":[{"text":"ராயினும்","lemma":"ராயினும்","gloss":"even though he does not cherish"}],"gloss":"even though he does not cherish","split_unverified":true},{"surface":"பெரியோர்","parts":[{"text":"பெரியோர்","lemma":"periyōr","gloss":"great people"}],"gloss":"of great people"},{"surface":"நெஞ்சத்துக்","parts":[{"text":"நெஞ்சத்துக்","lemma":"நெஞ்சத்துக்","gloss":"in the heart"}],"gloss":"in the heart","split_unverified":true}]},{"words":[{"surface":"கண்ணிய","parts":[{"text":"கண்ணிய","lemma":"kaṇṇu","gloss":"considered/intended"}],"gloss":"considered"},{"surface":"ஆண்மை","parts":[{"text":"ஆண்மை","lemma":"āṇmai","gloss":"manliness/duty"}],"gloss":"manliness"},{"surface":"கடவ","parts":[{"text":"கடவ","lemma":"kaṭatu","gloss":"duty"}],"gloss":"duty"},{"surface":"தன்றென","parts":[{"text":"தன்றென","lemma":"taṉreṉa","gloss":"not being so, saying"}],"gloss":"saying it is not proper"}]},{"words":[{"surface":"வலியா","parts":[{"text":"வலி","lemma":"vali","gloss":"to be strong"},{"text":"ஆ","lemma":"ā","gloss":"negative relative participle"}],"gloss":"unyielding/not softening"},{"surface":"நெஞ்சம்","parts":[{"text":"நெஞ்சம்","lemma":"neñcam","gloss":"heart/mind"}],"gloss":"heart"},{"surface":"வலிப்ப","parts":[{"text":"வலிப்ப","lemma":"vali","gloss":"to become strong/firm"}],"gloss":"to become firm"}]},{"words":[{"surface":"வாழ்வேன்","parts":[{"text":"வாழ்வேன்","lemma":"vāḻ","gloss":"I will live"}],"gloss":"I will live"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"tōḻi","gloss":"friend"}],"gloss":"O friend"},{"surface":"என்","parts":[{"text":"என்","lemma":"eṉ","gloss":"my"}],"gloss":"my"},{"surface":"வன்க","parts":[{"text":"வன்க","lemma":"வன்க","gloss":"firmness (part 1)"}],"gloss":"firmness (part 1)","split_unverified":true},{"surface":"ணானே","parts":[{"text":"ணானே","lemma":"ணானே","gloss":"by/with indeed (part 2)"}],"gloss":"by/with indeed (part 2)","split_unverified":true}]}],"literal":"Many blossoms bloomed, fresh-budded kuravam tree, / with the parched-grain-flowered puṅku tree, taking on the beauty of the grove, / even in the season when branches have become sweet, the lover / even though he does not cherish me, in the heart of great people / the intended manliness is not a duty to be abandoned, saying so, / my unyielding heart becoming firm, / I will live, O friend, by my own strength of mind.","translation":"The kuravam tree with its many fresh-budded blossoms, along with the puṅku tree bearing flowers like parched grain, have adorned the grove with beauty. Even in this spring season when the branches have become sweet, my lover does not cherish me. Yet, saying to myself that the strength of character intended in the hearts of great men is not something to be abandoned, my unyielding heart grows firm. O friend, I shall survive through my own strength of mind.","modern":"பல மலர்கள் மலர்ந்த புதிய அரும்புகளைக் கொண்ட குரா மரமும், பொரி போன்ற மலர்களைக் கொண்ட புன்க மரமும் சோலைக்கு அழகைத் தந்து கிளைகள் இனிமையாக மாறியுள்ள இந்த இளவேனில்காலத்திலும் காதலர் என்னை நினைக்கவில்லை என்றாலும், பெரியோர்களின் நெஞ்சத்தில் எண்ணிய ஆண்மைத் தன்மை கடமையிலிருந்து தவறுவது அன்று என்று கூறி, தளராத என் நெஞ்சம் வலிமை பெற, தோழியே! என் மன உறுதியினாலேயே நான் உயிர் வாழ்வேன்.","explanation":"The heroine is speaking to her confidante during the spring season, when the hero has not returned as promised. She observes the blooming of the kuravam and puṅku trees, which marks the arrival of spring—a time traditionally meant for union. Although her lover has failed to return and cherish her, she resolves to stay strong. She reasons that noble people do not abandon their duties or strength of character, and inspired by this ideal of 'manliness' or 'strength of character', she hardens her otherwise soft, grieving heart. This poem belongs to the Neytal (coastal) landscape, where themes of waiting and endurance are prominent. The key words are 'வன்கண்' (strength of mind) and 'நெஞ்சம் வலிப்ப' (heart becoming firm).","model":"gemini-3.5-flash"}}