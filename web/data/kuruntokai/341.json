{"text":"kuruntokai","n":341,"lines":["பல்வீ பட்ட பசுநனைக் குரவம்","பொரிப்பூம் புன்கொடு பொழிலணிக் கொளாஅச்","சினையினி தாகிய காலையுங் காதலர்","பேணா ராயினும் பெரியோர் நெஞ்சத்துக்","கண்ணிய ஆண்மை கடவ தன்றென","வலியா நெஞ்சம் வலிப்ப","வாழ்வேன் தோழியென் வன்க ணானே"],"tr":["palvī paṭṭa pacunaṉaik kuravam","porippūm puṉkoṭu poḻilaṇik koḷāac","ciṉaiyiṉi tākiya kālaiyuṅ kātalar","pēṇā rāyiṉum periyōr neñcattuk","kaṇṇiya āṇmai kaṭava taṉṟeṉa","valiyā neñcam valippa","vāḻvēṉ tōḻiyeṉ vaṉka ṇāṉē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"மிளைகிழார் நல்வேட்டனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Miḷaikiḻār Nalvēṭṭaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 12"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பல்வீ","tr":"palvī","foot":"tēmā","acai":[{"kind":"nēr","text":"பல்","tr":"pal"},{"kind":"nēr","text":"வீ","tr":"vī"}]},{"text":"பட்ட","tr":"paṭṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"பட்","tr":"paṭ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"பசுநனைக்","tr":"pacunaṉaik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பசு","tr":"pacu"},{"kind":"nirai","text":"நனைக்","tr":"naṉaik"}]},{"text":"குரவம்","tr":"kuravam","foot":"puḷimā","acai":[{"kind":"nirai","text":"குர","tr":"kura"},{"kind":"nēr","text":"வம்","tr":"vam"}]}],[{"text":"பொரிப்பூம்","tr":"porippūm","foot":"puḷimā","acai":[{"kind":"nirai","text":"பொரிப்","tr":"porip"},{"kind":"nēr","text":"பூம்","tr":"pūm"}]},{"text":"புன்கொடு","tr":"puṉkoṭu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"புன்","tr":"puṉ"},{"kind":"nirai","text":"கொடு","tr":"koṭu"}]},{"text":"பொழிலணிக்","tr":"poḻilaṇik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பொழி","tr":"poḻi"},{"kind"