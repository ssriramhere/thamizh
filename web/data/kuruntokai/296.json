{"text":"kuruntokai","n":296,"lines":["அம்ம வாழி தோழி புன்னை","அலங்குசினை யிருந்த அஞ்சிறை நாரை","உறுகழிச் சிறுமீன் முனையிற் செறுவிற்","கள்நாறு நெய்தல் கதிரொடு நயக்கும்","தண்ணந் துறைவற் காணின் முன்னின்று","கடிய கழறல் ஓம்புமதி தொடியோள்","இன்ன ளாகத் துறத்தல்","நும்மின் தகுமோ என்றனை துணிந்தே"],"tr":["amma vāḻi tōḻi puṉṉai","alaṅkuciṉai yirunta añciṟai nārai","uṟukaḻic ciṟumīṉ muṉaiyiṟ ceṟuviṟ","kaḷnāṟu neytal katiroṭu nayakkum","taṇṇan tuṟaivaṟ kāṇiṉ muṉṉiṉṟu","kaṭiya kaḻaṟal ōmpumati toṭiyōḷ","iṉṉa ḷākat tuṟattal","nummiṉ takumō eṉṟaṉai tuṇintē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"பெரும்பாக்கனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Perumpākkaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 11, kalittaḷai 3"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அம்ம","tr":"amma","foot":"tēmā","acai":[{"kind":"nēr","text":"அம்","tr":"am"},{"kind":"nēr","text":"ம","tr":"ma"}]},{"text":"வாழி","tr":"vāḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"புன்னை","tr":"puṉṉai","foot":"tēmā","acai":[{"kind":"nēr","text":"புன்","tr":"puṉ"},{"kind":"nēr","text":"னை","tr":"ṉai"}]}],[{"text":"அலங்குசினை","tr":"alaṅkuciṉai","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"அலங்","tr":"alaṅ"},{"kind":"nirai","text":"குசி","tr":"kuci"},{"kind":"nēr","text":"னை","tr":"ṉai"}]},{"text":"யிருந்த","tr":"yirunta","foot":"puḷimā","acai":[{"kind":"nirai","text":"யிருந்","tr":"yirun"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"அஞ்சிறை","tr":"añciṟai","foot":"kūviḷam"