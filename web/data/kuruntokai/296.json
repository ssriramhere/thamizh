s":[{"surface":"அலங்குசினை","parts":[{"text":"அலங்கு","lemma":"அலங்குதல்","gloss":"swaying"},{"text":"சினை","lemma":"சினை","gloss":"branch"}],"gloss":"swaying branch"},{"surface":"இருந்த","parts":[{"text":"இருந்த","lemma":"இருத்தல்","gloss":"that sat"}],"gloss":"that sat"},{"surface":"அஞ்சிறை","parts":[{"text":"அம்","lemma":"அம்","gloss":"beautiful"},{"text":"சிறை","lemma":"சிறை","gloss":"wing"}],"gloss":"beautiful wing"},{"surface":"நாரை","parts":[{"text":"நாரை","lemma":"நாரை","gloss":"heron"}],"gloss":"heron"}]},{"words":[{"surface":"உறுகழி","parts":[{"text":"உறு","lemma":"உறு","gloss":"deep"},{"text":"கழி","lemma":"கழி","gloss":"backwater"}],"gloss":"deep backwater"},{"surface":"சிறுமீன்","parts":[{"text":"சிறு","lemma":"சிறு","gloss":"small"},{"text":"மீன்","lemma":"மீன்","gloss":"fish"}],"gloss":"small fish"},{"surface":"முனையின்","parts":[{"text":"முனை","lemma":"முனைதல்","gloss":"disliking"},{"text":"இன்","lemma":"இன்","gloss":"having"}],"gloss":"having grown tired of"},{"surface":"செறுவின்","parts":[{"text":"செறு","lemma":"செறு","gloss":"field"},{"text":"இன்","lemma":"இன்","gloss":"in"}],"gloss":"in the field"}]},{"words":[{"surface":"கள்நாறு","parts":[{"text":"கள்","lemma":"கள்","gloss":"honey"},{"text":"நாறு","lemma":"நாறுதல்","gloss":"smelling"}],"gloss":"honey-scented"},{"surface":"நெய்தல்","parts":[{"text":"நெய்தல்","lemma":"நெய்தல்","gloss":"blue water lily"}],"gloss":"blue water lily"},{"surface":"கதிரொடு","parts":[{"text":"கதிர்","lemma":"கதிர்","gloss":"ear of grain"},{"text":"ஒடு","lemma":"ஒடு","gloss":"with"}],"gloss":"with the ear of grain"},{"surface":"நயக்கும்","parts":[{"text":"நயக்கும்","lemma":"நயத்தல்","gloss":"desires"}],"gloss":"desires"}]},{"words":[{"surface":"தண்ணம்","parts":[{"text":"தண்","lemma":"தண்","gloss":"cool"},{"text":"அம்","lemma":"அம்","gloss":"beautiful"}],"gloss":"cool and beautiful"},{"surface":"துறைவன்","parts":[{"text":"துறை","lemma":"துறை","gloss":"shore"},{"text":"அன்","lemma":"அன்","gloss":"he of"}],"gloss":"lord of the shore"},{"surface":"காணின்","parts":[{"text":"காண்","lemma":"காணல்","gloss":"see"},{"text":"இன்","lemma":"இன்","gloss":"if"}],"gloss":"if you see"},{"surface":"முன்னின்று","parts":[{"text":"முன்","lemma":"முன்","gloss":"before"},{"text":"நின்று","lemma":"நில்","gloss":"standing"}],"gloss":"standing in front"}]},{"words":[{"surface":"கடிய","parts":[{"text":"கடி","lemma":"கடி","gloss":"harsh"},{"text":"அ","lemma":"அ","gloss":"words"}],"gloss":"harsh words"},{"surface":"கழறல்","parts":[{"text":"கழறல்","lemma":"கழறல்","gloss":"rebuking"}],"gloss":"rebuking"},{"surface":"ஓம்புமதி","parts":[{"text":"ஓம்பு","lemma":"ஓம்புதல்","gloss":"avoid"},{"text":"மதி","lemma":"மதி","gloss":"please"}],"gloss":"please avoid"},{"surface":"தொடியோள்","parts":[{"text":"தொடி","lemma":"தொடி","gloss":"bangle"},{"text":"ஓள்","lemma":"ஓள்","gloss":"she who wears"}],"gloss":"she who wears bangles"}]},{"words":[{"surface":"இன்னள்","parts":[{"text":"இன்னள்","lemma":"இன்னள்","gloss":"in this state"}],"gloss":"in this state"},{"surface":"ஆக","parts":[{"text":"ஆக","lemma":"ஆதல்","gloss":"to become"}],"gloss":"to become"},{"surface":"துறத்தல்","parts":[{"text":"துறத்தல்","lemma":"துறத்தல்","gloss":"abandoning"}],"gloss":"abandoning"}]},{"words":[{"surface":"நும்மின்","parts":[{"text":"நும்","lemma":"நீயிர்","gloss":"you"},{"text":"இன்","lemma":"இன்","gloss":"for"}],"gloss":"for you"},{"surface":"தகுமோ","parts":[{"text":"தகுமோ","lemma":"தகுமோ","gloss":"is it fitting?"}],"gloss":"is it fitting?","split_unverified":true},{"surface":"என்றனை","parts":[{"text":"என்று","lemma":"என்று","gloss":"saying"},{"text":"அனை","lemma":"அனை","gloss":"thus"}],"gloss":"saying thus"},{"surface":"துணிந்தே","parts":[{"text":"துணிந்து","lemma":"துணிதல்","gloss":"boldly"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"boldly indeed"}]}],"literal":"Listen, may you live, friend! / On the swaying branch of the mastwood tree, the beautiful-winged heron, / getting sated with the small fish of the deep backwater, in the field / desires the honey-scented blue water lily along with the ears of grain, / if you see the lord of such a cool shore, standing in front of him, / please avoid rebuking him harshly, / 'to abandon the bangled girl so that she becomes like this, / is it fitting for you?' saying thus boldly.","translation":"Listen, my friend, may you live long! If you happen to see the lord of the cool shore—where the beautiful-winged heron, perched on a swaying branch of the mastwood tree, grows tired of the small fish in the deep backwater and instead longs for the honey-scented blue water lily along with the ears of grain in the field—please do not stand before him and rebuke him harshly, boldly asking, 'Is it fitting for you to abandon this bangled girl, leaving her in such a wasted state?'","modern":"தோழியே, நீ வாழ்க! அசைக்கின்ற கிளையையுடைய புன்னை மரத்தில் அமர்ந்திருக்கும் அழகிய சிறகுகளைக் கொண்ட நாரையானது, ஆழமான உப்பங்கழியில் உள்ள சிறிய மீன்களை வெறுத்து, வயலில் உள்ள கதிர் அறுவடையோடு தேன் மணக்கும் நெய்தல் மலரையும் விரும்பும் குளிர்ச்சியான கடற்கரைத் தலைவனைக் கண்டால், அவன் முன்னால் நின்று, 'வளையல் அணிந்த இவள் இவ்வாறு மெலியும்படி கைவிடுவது உமக்குத் தகுமா?' என்று துணிச்சலுடன் கடுமையான சொற்களைக் கூறி அவனைக் கடிந்து பேசுவதைத் தவிர்ப்பாயாக.","explanation":"The heroine is speaking to her close friend in this coastal (neytal) landscape poem. The hero has been away, causing the heroine to waste away in grief, and the friend intends to confront and rebuke him harshly upon his return. The heroine, out of her deep love and concern for the hero's feelings, begs her friend to avoid such harsh rebukes. The poem uses an implied metaphor (uḷḷuṟai uvamam) describing a heron that gets tired of the small fish in the backwater and seeks the sweet-scented blue lily in the fields. This suggests that the hero, though having easy access to other pleasures, sought the heroine's love, yet now neglects her. Key words include 'tuṟaivaṉ' (lord of the shore), 'kaḻaṟal ōmpumati' (please avoid rebuking), and 'toṭiyōḷ' (she of the bangles).","model":"gemini-3.5-flash"}}