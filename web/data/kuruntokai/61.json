{"text":"kuruntokai","n":61,"lines":["தச்சன் செய்த சிறுமா வையம்","ஊர்ந்தின் புறாஅர் ஆயினுங் கையின்","ஈர்த்தின் புறூஉம் இளையோர் போல","உற்றின் புறேஎம் ஆயினும் நற்றேர்ப்","பொய்கை யூரன் கேண்மை","செய்தின் புற்றனெஞ் செறிந்தன வளையே"],"tr":["taccaṉ ceyta ciṟumā vaiyam","ūrntiṉ puṟāar āyiṉuṅ kaiyiṉ","īrttiṉ puṟūum iḷaiyōr pōla","uṟṟiṉ puṟēem āyiṉum naṟṟērp","poykai yūraṉ kēṇmai","ceytiṉ puṟṟaṉeñ ceṟintaṉa vaḷaiyē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தோழி கூற்று","poet_ta":"தும்பிசேர் கீரனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Tumpicēr Kīraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 7"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"தச்சன்","tr":"taccaṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"தச்","tr":"tac"},{"kind":"nēr","text":"சன்","tr":"caṉ"}]},{"text":"செய்த","tr":"ceyta","foot":"tēmā","acai":[{"kind":"nēr","text":"செய்","tr":"cey"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"சிறுமா","tr":"ciṟumā","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nēr","text":"மா","tr":"mā"}]},{"text":"வையம்","tr":"vaiyam","foot":"tēmā","acai":[{"kind":"nēr","text":"வை","tr":"vai"},{"kind":"nēr","text":"யம்","tr":"yam"}]}],[{"text":"ஊர்ந்தின்","tr":"ūrntiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"ஊர்ந்","tr":"ūrn"},{"kind":"nēr","text":"தின்","tr":"tiṉ"}]},{"text":"புறாஅர்","tr":"puṟāar","foot":"puḷimā","acai":[{"kind":"nirai","text":"புறா","tr":"puṟā"},{"kind":"nēr","text":"அர்","tr":"ar"}]},{"text":"ஆயினுங்","tr":"āyiṉuṅ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nirai","text":"யினுங்","tr":"yiṉuṅ"}]},{"text":"கையின்","tr":"kaiyiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"கை","tr":"kai"},{"kind":"nēr","text