்","tr":"neṭuntēr","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெடுந்","tr":"neṭun"},{"kind":"nēr","text":"தேர்","tr":"tēr"}]}],[{"text":"வாரா","tr":"vārā","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ரா","tr":"rā"}]},{"text":"தாயினும்","tr":"tāyiṉum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nirai","text":"யினும்","tr":"yiṉum"}]},{"text":"வருவது","tr":"varuvatu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வரு","tr":"varu"},{"kind":"nirai","text":"வது","tr":"vatu"}]},{"text":"போலச்","tr":"pōlac","foot":"tēmā","acai":[{"kind":"nēr","text":"போ","tr":"pō"},{"kind":"nēr","text":"லச்","tr":"lac"}]}],[{"text":"செவிமுத","tr":"cevimuta","foot":"karuviḷam","acai":[{"kind":"nirai","text":"செவி","tr":"cevi"},{"kind":"nirai","text":"முத","tr":"muta"}]},{"text":"லிசைக்கு","tr":"licaikku","foot":"puḷimā","acai":[{"kind":"nirai","text":"லிசைக்","tr":"licaik"},{"kind":"nēr","text":"கு","tr":"ku"}]},{"text":"மரவமொடு","tr":"maravamoṭu","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"மர","tr":"mara"},{"kind":"nirai","text":"வமொ","tr":"vamo"},{"kind":"nēr","text":"டு","tr":"ṭu"}]}],[{"text":"துயில்துறந்","tr":"tuyiltuṟan","foot":"karuviḷam","acai":[{"kind":"nirai","text":"துயில்","tr":"tuyil"},{"kind":"nirai","text":"துறந்","tr":"tuṟan"}]},{"text":"தனவால்","tr":"taṉavāl","foot":"puḷimā","acai":[{"kind":"nirai","text":"தன","tr":"taṉa"},{"kind":"nēr","text":"வால்","tr":"vāl"}]},{"text":"தோழியென்","tr":"tōḻiyeṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nirai","text":"ழியென்","tr":"ḻiyeṉ"}]},{"text":"கண்ணே","tr":"kaṇṇē","foot":"tēmā","acai":[{"kind":"nēr","text":"கண்","tr":"kaṇ"},{"kind":"nēr","text":"ணே","tr":"ṇē"}]}]]},"ai":null}