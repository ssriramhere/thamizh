{"text":"kuruntokai","n":301,"lines":["முழவுமுத லரைய தடவுநிலைப் பெண்ணைக்","கொழுமட லிழைத்த சிறுகோற் குடம்பைக்","கருங்கா லன்றிற் காமர் கடுஞ்சூல்","வயவுப்பெடை யகவும் பானாட் கங்குல்","மன்றம் போழும் இனமணி நெடுந்தேர்","வாரா தாயினும் வருவது போலச்","செவிமுத லிசைக்கு மரவமொடு","துயில்துறந் தனவால் தோழியென் கண்ணே"],"tr":["muḻavumuta laraiya taṭavunilaip peṇṇaik","koḻumaṭa liḻaitta ciṟukōṟ kuṭampaik","karuṅkā laṉṟiṟ kāmar kaṭuñcūl","vayavuppeṭai yakavum pāṉāṭ kaṅkul","maṉṟam pōḻum iṉamaṇi neṭuntēr","vārā tāyiṉum varuvatu pōlac","cevimuta licaikku maravamoṭu","tuyiltuṟan taṉavāl tōḻiyeṉ kaṇṇē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"குன்றியனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kuṉṟiyaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27, veṇcīr 3, vañcicīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 13, kalittaḷai 2, oṉṟiya vañcittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"முழவுமுத","tr":"muḻavumuta","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"முழ","tr":"muḻa"},{"kind":"nirai","text":"வுமு","tr":"vumu"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"லரைய","tr":"laraiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"லரை","tr":"larai"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"தடவுநிலைப்","tr":"taṭavunilaip","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"தட","tr":"taṭa"},{"kind":"nirai","text":"வுநி","tr":"vuni"},{"kind":"nēr","text":"லைப்","tr":"laip"}]},{"text":"பெண்ணைக்","tr":"peṇṇaik","foot":"tēmā","acai":[{"kind":"nēr","text":"பெண்","tr":"peṇ"},{"kind":"nēr","text":"ணைக்","tr":"ṇaik"}]}],[{"text":"கொழுமட","tr":"koḻumaṭa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கொழு","tr":"koḻu"},{"kind":"nirai","text":"மட","tr":"maṭa"}]},{"text":"லிழைத்த","