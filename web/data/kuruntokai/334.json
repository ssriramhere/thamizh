{"text":"kuruntokai","n":334,"lines":["சிறுவெண் காக்கைச் செவ்வாய்ப் பெருந்தோ","டெறிதிரைத் திவலை யீர்ம்புற நனைப்பப்","பனிபுலந் துறையும் பல்பூங் கானல்","விரிநீர்ச் சேர்ப்பன் நீப்பி னொருநம்","இன்னுயி ரல்லது பிறிதொன்","றெவனோ தோழி நாமிழப் பதுவே"],"tr":["ciṟuveṇ kākkaic cevvāyp peruntō","ṭeṟitirait tivalai yīrmpuṟa naṉaippap","paṉipulan tuṟaiyum palpūṅ kāṉal","virinīrc cērppaṉ nīppi ṉorunam","iṉṉuyi rallatu piṟitoṉ","ṟevaṉō tōḻi nāmiḻap patuvē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"இளம்பூதனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Iḷampūtaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 7"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"சிறுவெண்","tr":"ciṟuveṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nēr","text":"வெண்","tr":"veṇ"}]},{"text":"காக்கைச்","tr":"kākkaic","foot":"tēmā","acai":[{"kind":"nēr","text":"காக்","tr":"kāk"},{"kind":"nēr","text":"கைச்","tr":"kaic"}]},{"text":"செவ்வாய்ப்","tr":"cevvāyp","foot":"tēmā","acai":[{"kind":"nēr","text":"செவ்","tr":"cev"},{"kind":"nēr","text":"வாய்ப்","tr":"vāyp"}]},{"text":"பெருந்தோ","tr":"peruntō","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெருந்","tr":"perun"},{"kind":"nēr","text":"தோ","tr":"tō"}]}],[{"text":"டெறிதிரைத்","tr":"ṭeṟitirait","foot":"karuviḷam","acai":[{"kind":"nirai","text":"டெறி","tr":"ṭeṟi"},{"kind":"nirai","text":"திரைத்","tr":"tirait"}]},{"text":"திவலை","tr":"tivalai","foot":"puḷimā","acai":[{"kind":"nirai","text":"திவ","tr":"tiva"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"யீர்ம்புற","tr":"yīrmpuṟa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யீர்ம்","tr":"yīrm"},{"kind":"nirai","text":"புற","tr":"puṟa"}]},{"text":"நனைப்பப்","