"having obtained"}],"gloss":"having obtained"},{"surface":"ஆங்","parts":[{"text":"ஆங்","lemma":"ஆங்கு","gloss":"thus"}],"gloss":"thus"}]},{"words":[{"surface":"கறிக","parts":[{"text":"கறிக","lemma":"அறிக","gloss":"may know"}],"gloss":"may know"},{"surface":"தில்","parts":[{"text":"தில்","lemma":"தில்","gloss":"particle of desire"}],"gloss":"particle of desire"},{"surface":"அம்ம","parts":[{"text":"அம்ம","lemma":"அம்ம","gloss":"particle of emphasis"}],"gloss":"particle of emphasis"},{"surface":"இவ்வூரே","parts":[{"text":"இவ்வூரே","lemma":"இவ்வூர்","gloss":"this town"}],"gloss":"this town"},{"surface":"மறுகில்","parts":[{"text":"மறுகில்","lemma":"மறுகு","gloss":"in the street"}],"gloss":"in the street"}]},{"words":[{"surface":"நல்லோள்","parts":[{"text":"நல்லோள்","lemma":"நல்லோள்","gloss":"good woman"}],"gloss":"good woman"},{"surface":"கணவன்","parts":[{"text":"கணவன்","lemma":"கணவன்","gloss":"husband"}],"gloss":"husband"},{"surface":"இவனெனப்","parts":[{"text":"இவனெனப்","lemma":"இவன்","gloss":"that he is this man"}],"gloss":"that he is this man"}]},{"words":[{"surface":"பல்லோர்","parts":[{"text":"பல்லோர்","lemma":"பல்லோர்","gloss":"many people"}],"gloss":"many people"},{"surface":"கூற","parts":[{"text":"கூற","lemma":"கூறு","gloss":"to say"}],"gloss":"to say"},{"surface":"யாம்","parts":[{"text":"யாம்","lemma":"யாம்","gloss":"we"}],"gloss":"we"},{"surface":"நாணுகஞ்","parts":[{"text":"நாணுகஞ்","lemma":"நாணு","gloss":"we will feel shy"}],"gloss":"we will feel shy"},{"surface":"சிறிதே","parts":[{"text":"சிறிதே","lemma":"சிறிது","gloss":"a little"}],"gloss":"a little"}]}],"literal":"Nectar-filled red tongue fearing to come / long, shining, sharp teeth, few-worded young woman / may I obtain, indeed, oh! I, having obtained / may they know, indeed, oh! this town in the street / 'the good woman's husband is this man' thus / many people when they say, we will feel shy a little.","translation":"May I indeed win this young woman of few words, with long, shining, sharp teeth, whose beauty makes even the nectar-filled red tongue fear to speak! Once I have won her, let the people of this town know of it in the streets, saying, 'This man is the husband of that excellent woman,' while we feel just a little shy.","modern":"அமிழ்தம் போன்ற செந்நா அஞ்சும்படி வந்த, நீண்ட விளங்கும் கூர்மையான பற்களையும் சில சொற்களையும் உடைய இளம்பெண்ணை நான் அடைவேனாக! அவ்வாறு அடைந்த பின், இந்த ஊரார் தெருக்களில் 'இவள் நல்லவளின் கணவன் இவன்' என்று பலரும் கூற, அதைக் கேட்டு நாம் சிறிதே நாணமடைவோமாக!","explanation":"The hero is speaking to himself about his intense desire to marry the heroine. He describes her exquisite beauty, noting her long, shining, sharp teeth and her soft, sparse words that could make even a sweet, nectar-filled tongue falter in awe. He wishes to marry her openly so that the entire town will gossip in the streets, pointing him out as the fortunate husband of such an excellent woman. Although this public attention will make them feel a little shy, it is a sweet embarrassment that he eagerly anticipates. This poem belongs to the Kuriñci landscape, reflecting the theme of union and the desire for public, lawful marriage rather than keeping their love a secret.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.9],[0.9,1.3],[1.3,1.3],[1.3,1.7],[1.7,3.3],[3.3,4.1],[4.21,4.5],[4.5,5.1],[5.1,6.3],[6.3,7.2],[7.2,7.2],[7.2,7.5],[7.5,9.3],[9.3,9.44],[9.44,9.59],[9.59,10.3],[10.3,11.6],[11.6,12.1],[12.1,12.5],[12.5,13.1],[13.5,13.7],[13.9,14.9],[14.9,15.2]],"female":[[0.0,0.9],[0.9,1.4],[1.4,1.4],[1.4,1.9],[1.9,3.9],[3.9,4.5],[4.5,5.0],[5.0,5.4],[5.4,7.32],[7.44,7.55],[7.66,8.0],[8.0,10.47],[10.47,10.78],[10.78,11.09],[11.09,11.09],[11.09,11.4],[11.4,12.8],[12.8,13.3],[13.3,13.6],[13.6,15.1],[15.1,15.4],[15.4,15.9],[15.9,16.7]]}}