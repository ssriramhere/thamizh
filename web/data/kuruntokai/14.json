{"text":"kuruntokai","n":14,"lines":["அமிழ்துபொதி செந்நா அஞ்ச வந்த","வார்ந்திலங்கு வையெயிற்றுச் சின்மொழி அரிவையைப்","பெறுகதில் அம்ம யானே பெற்றாங்","கறிகதில் அம்மவிவ் வூரே மறுகில்","நல்லோள் கணவன் இவனெனப்","பல்லோர் கூறயாம் நாணுகஞ் சிறிதே"],"tr":["amiḻtupoti cennā añca vanta","vārntilaṅku vaiyeyiṟṟuc ciṉmoḻi arivaiyaip","peṟukatil amma yāṉē peṟṟāṅ","kaṟikatil ammaviv vūrē maṟukil","nallōḷ kaṇavaṉ ivaṉeṉap","pallōr kūṟayām nāṇukañ ciṟitē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"தொல்கபிலர்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Tolkapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 12, āciriyattaḷai 9, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அமிழ்துபொதி","tr":"amiḻtupoti","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"அமிழ்","tr":"amiḻ"},{"kind":"nirai","text":"துபொ","tr":"tupo"},{"kind":"nēr","text":"தி","tr":"ti"}]},{"text":"செந்நா","tr":"cennā","foot":"tēmā","acai":[{"kind":"nēr","text":"செந்","tr":"cen"},{"kind":"nēr","text":"நா","tr":"nā"}]},{"text":"அஞ்ச","tr":"añca","foot":"tēmā","acai":[{"kind":"nēr","text":"அஞ்","tr":"añ"},{"kind":"nēr","text":"ச","tr":"ca"}]},{"text":"வந்த","tr":"vanta","foot":"tēmā","acai":[{"kind":"nēr","text":"வந்","tr":"van"},{"kind":"nēr","text":"த","tr":"ta"}]}],[{"text":"வார்ந்திலங்கு","tr":"vārntilaṅku","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"வார்ந்","tr":"vārn"},{"kind":"nirai","text":"திலங்","tr":"tilaṅ"},{"kind":"nēr","text":"கு","tr":"ku"}]},{"text":"வையெயிற்றுச்","tr":"vaiyeyiṟṟuc","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"வை","tr":"vai"},{"kind":"nirai","text":"யெயிற்","tr":"yeyiṟ"},{"kind":"nēr","text":"றுச்","tr":"ṟuc"}]},{"text":"சின்மொழி","tr":"ciṉmoḻi","foot