{"text":"kuruntokai","n":349,"lines":["அடும்பவிழ் அணிமலர் சிதைஇமீன் அருந்தும்","தடந்தாள் நாரை இருக்கும் எக்கர்த்","தண்ணந் துறைவற் றொடுத்து நந்நலம்","கொள்வாம் என்றி தோழி கொள்வாம்","இடுக்கண் அஞ்சி இரந்தோர் வேண்டிய","கொடுத்தவை தாவென் சொல்லினும்","இன்னா தோநம் இன்னுயிர் இழப்பே"],"tr":["aṭumpaviḻ aṇimalar citaiimīṉ aruntum","taṭantāḷ nārai irukkum ekkart","taṇṇan tuṟaivaṟ ṟoṭuttu nannalam","koḷvām eṉṟi tōḻi koḷvām","iṭukkaṇ añci irantōr vēṇṭiya","koṭuttavai tāveṉ colliṉum","iṉṉā tōnam iṉṉuyir iḻappē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"சாத்தனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Cāttaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 9"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அடும்பவிழ்","tr":"aṭumpaviḻ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அடும்","tr":"aṭum"},{"kind":"nirai","text":"பவிழ்","tr":"paviḻ"}]},{"text":"அணிமலர்","tr":"aṇimalar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அணி","tr":"aṇi"},{"kind":"nirai","text":"மலர்","tr":"malar"}]},{"text":"சிதைஇமீன்","tr":"citaiimīṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சிதை","tr":"citai"},{"kind":"nirai","text":"இமீன்","tr":"imīṉ"}]},{"text":"அருந்தும்","tr":"aruntum","foot":"puḷimā","acai":[{"kind":"nirai","text":"அருந்","tr":"arun"},{"kind":"nēr","text":"தும்","tr":"tum"}]}],[{"text":"தடந்தாள்","tr":"taṭantāḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"தடந்","tr":"taṭan"},{"kind":"nēr","text":"தாள்","tr":"tāḷ"}]},{"text":"நாரை","tr":"nārai","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"ரை","tr":"rai"}]},{"text":"இருக்கும்","tr":"irukkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"இருக்","tr":"iruk"},{