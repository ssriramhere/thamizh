{"text":"kuruntokai","n":205,"lines":["மின்னுச்செய் கருவிய பெயன்மழை தூங்க","விசும்பா டன்னம் பறைநிவந் தாங்குப்","பொலம்படைப் பொலிந்த வெண்டேர் ஏறிக்","கலங்குகடல் துவலை ஆழி நனைப்ப","இனிச்சென் றனனே இடுமணற் சேர்ப்பன்","யாங்கறிந் தன்றுகொல் தோழியென்","தேங்கமழ் திருநுதல் ஊர்தரும் பசப்பே"],"tr":["miṉṉuccey karuviya peyaṉmaḻai tūṅka","vicumpā ṭaṉṉam paṟainivan tāṅkup","polampaṭaip polinta veṇṭēr ēṟik","kalaṅkukaṭal tuvalai āḻi naṉaippa","iṉicceṉ ṟaṉaṉē iṭumaṇaṟ cērppaṉ","yāṅkaṟin taṉṟukol tōḻiyeṉ","tēṅkamaḻ tirunutal ūrtarum pacappē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"உலோச்சனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Ulōccaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 15, āciriyattaḷai 9, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மின்னுச்செய்","tr":"miṉṉuccey","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"மின்","tr":"miṉ"},{"kind":"nēr","text":"னுச்","tr":"ṉuc"},{"kind":"nēr","text":"செய்","tr":"cey"}]},{"text":"கருவிய","tr":"karuviya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கரு","tr":"karu"},{"kind":"nirai","text":"விய","tr":"viya"}]},{"text":"பெயன்மழை","tr":"peyaṉmaḻai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெயன்","tr":"peyaṉ"},{"kind":"nirai","text":"மழை","tr":"maḻai"}]},{"text":"தூங்க","tr":"tūṅka","foot":"tēmā","acai":[{"kind":"nēr","text":"தூங்","tr":"tūṅ"},{"kind":"nēr","text":"க","tr":"ka"}]}],[{"text":"விசும்பா","tr":"vicumpā","foot":"puḷimā","acai":[{"kind":"nirai","text":"விசும்","tr":"vicum"},{"kind":"nēr","text":"பா","tr":"pā"}]},{"text":"டன்னம்","tr":"ṭaṉṉam","foot":"tēmā","acai":[{"kind":"nēr","text":"டன்","tr":"ṭaṉ"},{"kind":"nēr","text":"னம்","tr":"ṉam"}]},{"text":"பறைநிவந்","tr":"paṟain