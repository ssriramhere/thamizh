்","lemma":"annam","gloss":"swan"}],"gloss":"swan"},{"surface":"பறை","parts":[{"text":"பறை","lemma":"paṟai","gloss":"flight"}],"gloss":"flight"},{"surface":"நிவந்து","parts":[{"text":"நிவ","lemma":"niva","gloss":"rise"},{"text":"ந்து","lemma":"ntu","gloss":"past participle suffix"}],"gloss":"having risen"},{"surface":"ஆங்கு","parts":[{"text":"ஆங்கு","lemma":"āṅku","gloss":"like"}],"gloss":"like"}]},{"words":[{"surface":"பொலம்","parts":[{"text":"பொலம்","lemma":"பொலம்","gloss":"gold"}],"gloss":"gold"},{"surface":"படை","parts":[{"text":"படை","lemma":"படை","gloss":"harness"}],"gloss":"harness","split_unverified":true},{"surface":"பொலிந்த","parts":[{"text":"பொலி","lemma":"பொலி","gloss":"shine"},{"text":"ந்","lemma":"த்","gloss":"euphonic glide"},{"text":"த்","lemma":"த்","gloss":"past tense marker"},{"text":"அ","lemma":"அ","gloss":"adjectival participle suffix"}],"gloss":"that shone"},{"surface":"வெண்","parts":[{"text":"வெண்","lemma":"வெண்மை","gloss":"white"}],"gloss":"white"},{"surface":"தேர்","parts":[{"text":"தேர்","lemma":"தேர்","gloss":"chariot"}],"gloss":"chariot"},{"surface":"ஏறி","parts":[{"text":"ஏறி","lemma":"ஏறி","gloss":"having mounted"}],"gloss":"having mounted","split_unverified":true}]},{"words":[{"surface":"கலங்கு","parts":[{"text":"கலங்கு","lemma":"kalaṅku","gloss":"churn"}],"gloss":"churning"},{"surface":"கடல்","parts":[{"text":"கடல்","lemma":"kaṭal","gloss":"sea"}],"gloss":"sea"},{"surface":"துவலை","parts":[{"text":"துவலை","lemma":"tuvalai","gloss":"spray"}],"gloss":"spray"},{"surface":"ஆழி","parts":[{"text":"ஆழி","lemma":"āḻi","gloss":"wheel"}],"gloss":"wheel"},{"surface":"நனைப்ப","parts":[{"text":"நனை","lemma":"nanai","gloss":"wet"},{"text":"ப்ப","lemma":"ppa","gloss":"infinitive suffix"}],"gloss":"to wet"}]},{"words":[{"surface":"இனி","parts":[{"text":"இனி","lemma":"ini","gloss":"now"}],"gloss":"now"},{"surface":"சென்றனன்","parts":[{"text":"சென்றனன்","lemma":"cel","gloss":"he went"}],"gloss":"he went"},{"surface":"ஏ","parts":[{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"indeed"},{"surface":"இடு","parts":[{"text":"இடு","lemma":"iṭu","gloss":"heap"}],"gloss":"heaped"},{"surface":"மணல்","parts":[{"text":"மணல்","lemma":"maṇal","gloss":"sand"}],"gloss":"sand"},{"surface":"சேர்ப்பன்","parts":[{"text":"சேர்ப்பு","lemma":"cērppu","gloss":"coast"},{"text":"அன்","lemma":"an","gloss":"he of"}],"gloss":"lord of the shore"}]},{"words":[{"surface":"யாங்கு","parts":[{"text":"யாங்கு","lemma":"yāṅku","gloss":"how"}],"gloss":"how"},{"surface":"அறிந்தன்று","parts":[{"text":"அறி","lemma":"aṟi","gloss":"know"},{"text":"ந்த்","lemma":"nt","gloss":"past marker"},{"text":"அன்று","lemma":"anṟu","gloss":"neuter singular past suffix"}],"gloss":"did it know"},{"surface":"கொல்","parts":[{"text":"கொல்","lemma":"kol","gloss":"particle of doubt"}],"gloss":"indeed"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"tōḻi","gloss":"friend"}],"gloss":"O friend"},{"surface":"என்","parts":[{"text":"என்","lemma":"en","gloss":"my"}],"gloss":"my"}]},{"words":[{"surface":"தேம்","parts":[{"text":"தேம்","lemma":"tēm","gloss":"fragrance"}],"gloss":"fragrance"},{"surface":"கமழ்","parts":[{"text":"கமழ்","lemma":"kamaḻ","gloss":"emit fragrance"}],"gloss":"emitting"},{"surface":"திரு","parts":[{"text":"திரு","lemma":"tiru","gloss":"beautiful"}],"gloss":"beautiful"},{"surface":"நுதல்","parts":[{"text":"நுதல்","lemma":"nutal","gloss":"forehead"}],"gloss":"forehead"},{"surface":"ஊர்தரும்","parts":[{"text":"ஊர்","lemma":"ūr","gloss":"spread"},{"text":"தரும்","lemma":"tarum","gloss":"bringing"}],"gloss":"spreading"},{"surface":"பசப்பு","parts":[{"text":"பசப்பு","lemma":"pacappu","gloss":"pallor"}],"gloss":"pallor"},{"surface":"ஏ","parts":[{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"indeed"}]}],"literal":"Lightning-making clouds having as instruments raining clouds to hang / sky-moving swan flight rising like / gold-harnessed shining white chariot having mounted / churning sea spray wheel to wet / now he went indeed, the lord of the heaped sand shore / how did it know indeed, O friend, my / fragrance-emitting beautiful forehead spreading pallor indeed?","translation":"As the rain-bearing clouds, armed with lightning, hung low, he mounted his white chariot adorned with golden harnesses, which shone like a swan rising in flight through the sky. As the spray of the churning sea wet the wheels, the lord of the sandy shore departed just now. O friend, how did the pallor that spreads over my sweet-scented, beautiful forehead know of his departure beforehand?","modern":"மின்னலை உண்டாக்கும் மேகங்கள் மழையைப் பொழிந்து கொண்டிருக்க, வானத்தில் பறந்து செல்லும் அன்னப் பறவையைப் போல, பொன்னால் ஆன அணிகலன்களால் விளங்கும் வெண்மையான தேரில் ஏறி, ஆரவாரிக்கும் கடலின் அலைத்துளிகள் தேரின் சக்கரங்களை நனைக்க, மணல் நிறைந்த கடற்கரைத் தலைவன் இப்பொழுதுதான் சென்றான். தோழியே, என் நறுமணம் வீசும் அழகிய நெற்றியில் படரும் பசலை நோய், அவன் பிரிந்து செல்வதை எவ்வாறுதான் அறிந்து கொண்டதோ?","explanation":"The heroine is speaking to her confidante after the hero departs back to his land. She describes his departure: he mounted his white chariot, which looked like a swan flying high in the sky, and rode away along the shore as the sea spray wet the chariot wheels. The moment he leaves, the pallor of separation (pacappu) immediately begins to spread across her beautiful, fragrant forehead. She wonders in amazement how this pallor could know of his departure so instantly, appearing even as his chariot disappears from view. The imagery of the swan-like chariot and the sea spray belongs to the Neytal (coastal) landscape, reflecting the themes of waiting and the grief of separation.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.61],[0.7,1.2],[1.2,1.7],[1.7,2.1],[2.1,3.44],[3.44,3.56],[3.68,4.0],[4.0,4.0],[4.0,5.5],[5.5,5.6],[5.6,5.93],[6.13,6.2],[6.2,7.3],[7.3,7.7],[7.7,7.8],[7.8,8.3],[8.3,9.85],[9.85,10.12],[10.26,10.4],[10.4,10.9],[10.9,11.14],[11.14,12.2],[12.2,12.67],[12.67,12.67],[12.67,12.8],[12.8,14.96],[14.96,15.3]],"female":[[0.0,0.8],[0.8,