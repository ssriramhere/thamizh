{"text":"kuruntokai","n":380,"lines":["விசும்புகண் புதையப் பாஅய் வேந்தர்","வென்றெறி முரசின் நன்பல முழங்கிப்","பெயலா னாதே வானம் காதலர்","நனிசேய் நாட்டர் நம்முன் னலரே","யாங்குச்செய் வாங்கொல் தோழி யீங்கைய","வண்ணத் துய்ம்மலர் உதிர","முன்னர்த் தோன்றும் பனிக்கடு நாளே"],"tr":["vicumpukaṇ putaiyap pāay vēntar","veṉṟeṟi muraciṉ naṉpala muḻaṅkip","peyalā ṉātē vāṉam kātalar","naṉicēy nāṭṭar nammuṉ ṉalarē","yāṅkuccey vāṅkol tōḻi yīṅkaiya","vaṇṇat tuymmalar utira","muṉṉart tōṉṟum paṉikkaṭu nāḷē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"கருவூர்க் கதப்பிள்ளை","speaker_en":"her friend (tōḻi)","poet_tr":"Karuvūrk Katappiḷḷai"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 20, veṇṭaḷai 6"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"விசும்புகண்","tr":"vicumpukaṇ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விசும்","tr":"vicum"},{"kind":"nirai","text":"புகண்","tr":"pukaṇ"}]},{"text":"புதையப்","tr":"putaiyap","foot":"puḷimā","acai":[{"kind":"nirai","text":"புதை","tr":"putai"},{"kind":"nēr","text":"யப்","tr":"yap"}]},{"text":"பாஅய்","tr":"pāay","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"அய்","tr":"ay"}]},{"text":"வேந்தர்","tr":"vēntar","foot":"tēmā","acai":[{"kind":"nēr","text":"வேந்","tr":"vēn"},{"kind":"nēr","text":"தர்","tr":"tar"}]}],[{"text":"வென்றெறி","tr":"veṉṟeṟi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வென்","tr":"veṉ"},{"kind":"nirai","text":"றெறி","tr":"ṟeṟi"}]},{"text":"முரசின்","tr":"muraciṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"முர","tr":"mura"},{"kind":"nēr","text":"சின்","tr":"ciṉ"}]},{"text":"நன்பல","tr":"naṉpala","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நன்","tr":"naṉ"},{"kind":"nirai","text"