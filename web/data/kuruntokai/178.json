{"text":"kuruntokai","n":178,"lines":["அயிரை பரந்த அந்தண் பழனத்","தேந்தெழின் மலர தூம்புடைத் திரள்கால்","ஆம்பல் குறுநர் நீர்வேட் டாங்கிவள்","இடைமுலைக் கிடந்து நடுங்க லானீர்","தொழுதுகாண் பிறையிற் றோன்றி யாநுமக்","கரிய மாகிய காலைப்","பெரிய தோன்றினிர் நோகோ யானே"],"tr":["ayirai paranta antaṇ paḻaṉat","tēnteḻiṉ malara tūmpuṭait tiraḷkāl","āmpal kuṟunar nīrvēṭ ṭāṅkivaḷ","iṭaimulaik kiṭantu naṭuṅka lāṉīr","toḻutukāṇ piṟaiyiṟ ṟōṉṟi yānumak","kariya mākiya kālaip","periya tōṉṟiṉir nōkō yāṉē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தோழி கூற்று","poet_ta":"நெடும்பல்லியத்தையார்","speaker_en":"her friend (tōḻi)","poet_tr":"Neṭumpalliyattaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அயிரை","tr":"ayirai","foot":"puḷimā","acai":[{"kind":"nirai","text":"அயி","tr":"ayi"},{"kind":"nēr","text":"ரை","tr":"rai"}]},{"text":"பரந்த","tr":"paranta","foot":"puḷimā","acai":[{"kind":"nirai","text":"பரந்","tr":"paran"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"அந்தண்","tr":"antaṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"அந்","tr":"an"},{"kind":"nēr","text":"தண்","tr":"taṇ"}]},{"text":"பழனத்","tr":"paḻaṉat","foot":"puḷimā","acai":[{"kind":"nirai","text":"பழ","tr":"paḻa"},{"kind":"nēr","text":"னத்","tr":"ṉat"}]}],[{"text":"தேந்தெழின்","tr":"tēnteḻiṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தேந்","tr":"tēn"},{"kind":"nirai","text":"தெழின்","tr":"teḻiṉ"}]},{"text":"மலர","tr":"malara","foot":"puḷimā","acai":[{"kind":"nirai","text":"மல","tr":"mala"},{"kind":"nēr","text":"ர","tr":"ra"}]},{"text":"தூம்புடைத்","tr":"tūmpuṭait","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தூம்","tr":"tūm"},{"kind":"nirai","text":"புடைத்","tr":"puṭait"}]},{"