{"text":"kuruntokai","n":59,"lines":["பதலைப் பாணிப் பரிசிலர் கோமான்","அதலைக் குன்றத் தகல்வாய்க் குண்டுசுனைக்","குவளையொடு பொதிந்த குளவி நாறுநின்","நறுநுதன் மறப்பரோ மற்றே முயலவும்","சுரம்பல விலங்கிய அரும்பொருள்","நிரம்பா ஆகலின் நீடலோ இன்றே"],"tr":["patalaip pāṇip paricilar kōmāṉ","atalaik kuṉṟat takalvāyk kuṇṭucuṉaik","kuvaḷaiyoṭu potinta kuḷavi nāṟuniṉ","naṟunutaṉ maṟapparō maṟṟē muyalavum","curampala vilaṅkiya arumporuḷ","nirampā ākaliṉ nīṭalō iṉṟē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"மோசி கீரனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Mōci Kīraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 1, vañcicīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 9, kalittaḷai 1, oṉṟiya vañcittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பதலைப்","tr":"patalaip","foot":"puḷimā","acai":[{"kind":"nirai","text":"பத","tr":"pata"},{"kind":"nēr","text":"லைப்","tr":"laip"}]},{"text":"பாணிப்","tr":"pāṇip","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"ணிப்","tr":"ṇip"}]},{"text":"பரிசிலர்","tr":"paricilar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பரி","tr":"pari"},{"kind":"nirai","text":"சிலர்","tr":"cilar"}]},{"text":"கோமான்","tr":"kōmāṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"கோ","tr":"kō"},{"kind":"nēr","text":"மான்","tr":"māṉ"}]}],[{"text":"அதலைக்","tr":"atalaik","foot":"puḷimā","acai":[{"kind":"nirai","text":"அத","tr":"ata"},{"kind":"nēr","text":"லைக்","tr":"laik"}]},{"text":"குன்றத்","tr":"kuṉṟat","foot":"tēmā","acai":[{"kind":"nēr","text":"குன்","tr":"kuṉ"},{"kind":"nēr","text":"றத்","tr":"ṟat"}]},{"text":"தகல்வாய்க்","tr":"takalvāyk","foot":"puḷimā","acai":[{"kind":"nirai","text":"தகல்","tr":"takal"},{"kind":"nēr","text":"வாய்க்","tr"