tr":"pā"}]},{"text":"ஆகலின்","tr":"ākaliṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nirai","text":"கலின்","tr":"kaliṉ"}]},{"text":"நீடலோ","tr":"nīṭalō","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nirai","text":"டலோ","tr":"ṭalō"}]},{"text":"இன்றே","tr":"iṉṟē","foot":"tēmā","acai":[{"kind":"nēr","text":"இன்","tr":"iṉ"},{"kind":"nēr","text":"றே","tr":"ṟē"}]}]]},"ai":{"lines":[{"words":[{"surface":"பதலை","parts":[{"text":"பதலை","lemma":"patalai","gloss":"pot-drum"}],"gloss":"pot-drum"},{"surface":"பாணி","parts":[{"text":"பாணி","lemma":"pāṇi","gloss":"beat/melody"}],"gloss":"beat/melody"},{"surface":"பரிசிலர்","parts":[{"text":"பரிசில்","lemma":"paricil","gloss":"gift"},{"text":"அர்","lemma":"ar","gloss":"plural/honorific suffix"}],"gloss":"bards/recipients of gifts"},{"surface":"கோமான்","parts":[{"text":"கோமான்","lemma":"kōmāṉ","gloss":"chief/king"}],"gloss":"chief"}]},{"words":[{"surface":"அதலை","parts":[{"text":"அதலை","lemma":"atalai","gloss":"Atalai hill"}],"gloss":"Atalai hill"},{"surface":"குன்றத்து","parts":[{"text":"குன்று","lemma":"kuṉṟu","gloss":"hill"},{"text":"அத்து","lemma":"attu","gloss":"inflectional increment"}],"gloss":"of the hill"},{"surface":"அகல்வாய்","parts":[{"text":"அகல்","lemma":"akal","gloss":"wide"},{"text":"வாய்","lemma":"vāy","gloss":"mouth/opening"}],"gloss":"wide-mouthed"},{"surface":"குண்டுசுனை","parts":[{"text":"குண்டு","lemma":"kuṇṭu","gloss":"deep"},{"text":"சுனை","lemma":"cuṉai","gloss":"mountain pool"}],"gloss":"deep mountain pool"}]},{"words":[{"surface":"குவளையொடு","parts":[{"text":"குவளை","lemma":"kuvaḷai","gloss":"blue water-lily"},{"text":"ஒடு","lemma":"oṭu","gloss":"with (sociative case)"}],"gloss":"with blue water-lilies"},{"surface":"பொதிந்த","parts":[{"text":"பொதிந்த","lemma":"பொதிந்த","gloss":"enfolded/wrapped"}],"gloss":"enfolded/wrapped","split_unverified":true},{"surface":"குளவி","parts":[{"text":"குளவி","lemma":"kuḷavi","gloss":"wild jasmine"}],"gloss":"wild jasmine"},{"surface":"நாறும்","parts":[{"text":"நாறு","lemma":"nāṟu","gloss":"smell"},{"text":"உம்","lemma":"um","gloss":"adjectival participle suffix"}],"gloss":"smelling of"},{"surface":"நின்","parts":[{"text":"நின்","lemma":"niṉ","gloss":"your"}],"gloss":"your"}]},{"words":[{"surface":"நறுநுதல்","parts":[{"text":"நறு","lemma":"நறு","gloss":"fragrant"},{"text":"நுதல்","lemma":"நுதல்","gloss":"forehead"}],"gloss":"fragrant forehead"},{"surface":"மறப்பரோ","parts":[{"text":"மற","lemma":"மற","gloss":"forget"},{"text":"ப்ப்","lemma":"ப்ப்","gloss":"future tense marker"},{"text":"அர்","lemma":"அர்","gloss":"they"},{"text":"ஓ","lemma":"ஓ","gloss":"interrogative particle"}],"gloss":"will they forget?"},{"surface":"மற்றே","parts":[{"text":"மற்று","lemma":"மற்று","gloss":"expletive particle"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"indeed"},{"surface":"முயலவும்","parts":[{"text":"முயல்","lemma":"முயல்","gloss":"strive"},{"text":"அ","lemma":"அ","gloss":"infinitive suffix"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"even while striving"}]},{"words":[{"surface":"சுரம்பல","parts":[{"text":"சுரம்","lemma":"curam","gloss":"desert path"},{"text":"பல","lemma":"pala","gloss":"many"}],"gloss":"many desert paths"},{"surface":"விலங்கிய","parts":[{"text":"விலங்கு","lemma":"vilaṅku","gloss":"lie across/intervene"},{"text":"இய","lemma":"iya","gloss":"past adjectival participle suffix"}],"gloss":"lying across/intervening"},{"surface":"அரும்பொருள்","parts":[{"text":"அருமை","lemma":"arumai","gloss":"rare/difficult"},{"text":"பொருள்","lemma":"poruḷ","gloss":"wealth"}],"gloss":"rare wealth"}]},{"words":[{"surface":"நிரம்பா","parts":[{"text":"நிரம்பு","lemma":"nirampu","gloss":"fill/complete"},{"text":"ஆ","lemma":"ā","gloss":"negative adjectival participle suffix"}],"gloss":"not being filled/incomplete"},{"surface":"ஆகலின்","parts":[{"text":"ஆகலின்","lemma":"ஆகலின்","gloss":"because"}],"gloss":"because","split_unverified":true},{"surface":"நீடலோ","parts":[{"text":"நீடல்","lemma":"nīṭal","gloss":"delaying"},{"text":"ஓ","lemma":"ō","gloss":"emphatic particle"}],"gloss":"delaying"},{"surface":"இன்றே","parts":[{"text":"இன்று","lemma":"iṉṟu","gloss":"not/today"},{"text":"ஏ","lemma":"ē","gloss":"emphatic particle"}],"gloss":"is not there today"}]}],"literal":"Of the bards with pot-drums, the chief, / on Atalai hill, in the wide-mouthed deep pool, / along with water-lilies, enfolded wild jasmine, smelling of, your / fragrant forehead, will he forget? Indeed, even though he strives, / many deserts lying across, the rare wealth / is not filled, therefore, delaying is not there today.","translation":"Will he ever forget your fragrant forehead, which smells of wild jasmine enfolded with blue water-lilies from the wide, deep pool on Atalai hill belonging to the chief of bards who play the pot-drum? Even though he strives, the rare wealth he seeks is not yet fully gathered, and many difficult desert paths lie in between; therefore, his delay will not last today.","modern":"பதலை என்னும் வாத்தியத்தை வாசிக்கும் பரிசிலர்களின் தலைவனுடைய அதலை மலையிலுள்ள அகன்ற வாயையுடைய ஆழமான சுனையில் பூத்த குவளைப் பூக்களோடு சேர்த்துத் தொடுத்த காட்டு மல்லிகை மலரின் மணம் வீசும் உன்னுடைய நறிய நெற்றியைத் தலைவன் மறந்துவிடுவானோ? அவன் முயன்றாலும், பல பாலைவனக் கடந்து தேடும் அரிய செல்வம் இன்னும் முழுமையாகக் கிடைக்கவில்லை. அதனால் தான் அவன் தாமதிக்கிறானே தவிர, அவன் உன்னை மறக்கவில்லை; அவன் விரைவில் வந்துவிடுவான்.","explanation":"The friend (thōḻi) is consoling the heroine (thalaivi) who is anxious about the hero's (thalaivaṉ) delay in returning from his quest for wealth. She reassures her that the hero has not forgotten her beautiful, fragrant forehead, which smells of the fresh wild jasmine and water-lilies of the deep pools on Atalai hill. The hill belongs to a generous chief of bards, symbolizing the hero's own noble and loving nature. The friend explains that the only reason for his delay is that the difficult wealth he set out to acquire through arduous desert paths is not yet fully gathered. This poem belongs to the pālai (wasteland) landscape, where the theme of separation and the hardships of the journey to earn wealth are central. Key words like 'naṟunutal' (fragrant forehead) and 'arumporuḷ' (rare wealth) highlight the contrast between the sweet domestic love he left behind and the harsh material duties he must fulfill.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.5],[0.5,0.9],[0.9,1.1],[1.1,1.5],[1.5,2.6],[2.6,2.65],[2.65,2.7],[2.7,4.0],[4.0,5.0],[5.0,5.2],[5.2,5.7],[5.7,6.37],[6.37,7.6],[7.6,7.6],[7.6,8.6],[8.6,9.0],[9.0,10.0],[10.0,10.1],[10.1,11.0],[11.0,11.8],[11.8,11.8],[11.8,12.6],[12.66,12.84]],"female":[[0.0,0.6],[0.6,1.1],[1.1,1.3],[1.3,1.8],[1.8,3.2],[3.2,3.2],[3.2,3.2],[3.2,4.6],[4.6,5.7],[5.7,6.0],[6.0,6.4],[6.4,7.37],[7.37,8.4],[8.4,8.4],[8.4,9.3],[9.3,9.8],[9.8,10.8],[10.8,11.0],[11.0,12.0],[12.0,12.8],[12.8,12.9],[12.9,13.9],[14.0,14.4]]},"sync":[[["பதலை","pot-drum"],["பாணி","beat/melody"]],[["பாணி","beat/melody"]],[["பரிசிலர்","bards/recipients of gifts"]],[["கோமான்","chief"]],[["அதலை","Atalai hill"]],[["குன்றத்து","of the hill"]],[["குன்றத்து","of the hill"],["அகல்வாய்","wide-mouthed"]],[["குண்டுசுனை","deep mountain pool"]],[["குவளையொடு","with blue water-lilies"]],[["பொதிந்த","enfolded/wrapped"]],[["குளவி","wild jasmine"]],[["நாறும்","smelling of"],["நின்","your"]],[["நறுநுதல்","fragrant forehead"]],[["மறப்பரோ","will they forget?"]],[["மற்றே","indeed"]],[["முயலவும்","even while striving"]],[["சுரம்பல","many desert paths"]],[["விலங்கிய","lying across/intervening"]],[["அரும்பொருள்","rare wealth"]],[["நிரம்பா","not being filled/incomplete"]],[["ஆகலின்","because"]],[["நீடலோ","delaying"]],[["இன்றே","is not there today"]]]}