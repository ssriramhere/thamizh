kind":"nēr","text":"யே","tr":"yē"}]},{"text":"மகிழ்நற்கியா","tr":"makiḻnaṟkiyā","foot":"puḷimāṅkaṉi","acai":[{"kind":"nirai","text":"மகிழ்","tr":"makiḻ"},{"kind":"nēr","text":"நற்","tr":"naṟ"},{"kind":"nirai","text":"கியா","tr":"kiyā"}]},{"text":"மாயினம்","tr":"māyiṉam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"யினம்","tr":"yiṉam"}]},{"text":"எனினே","tr":"eṉiṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"எனி","tr":"eṉi"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"கணைக்கோட்டு","parts":[{"text":"கணைக்கோட்டு","lemma":"கணைக்கோட்டு","gloss":"thick-finned"}],"gloss":"thick-finned","split_unverified":true},{"surface":"வாளை","parts":[{"text":"வாளை","lemma":"வாளை","gloss":"scabbard-fish"}],"gloss":"scabbard-fish"},{"surface":"கமஞ்சூல்","parts":[{"text":"கமஞ்சூல்","lemma":"கமஞ்சூல்","gloss":"fully pregnant"}],"gloss":"fully pregnant","split_unverified":true},{"surface":"மடநாகு","parts":[{"text":"மடம்","lemma":"மடம்","gloss":"tender/youthful"},{"text":"நாகு","lemma":"நாகு","gloss":"young female buffalo"}],"gloss":"tender young female buffalo"}]},{"words":[{"surface":"துணர்த்தேக்","parts":[{"text":"துணர்த்தேக்","lemma":"துணர்த்தேக்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"கொக்கின்","parts":[{"text":"கொக்கின்","lemma":"கொக்கின்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தீம்பழம்","parts":[{"text":"தீம்பழம்","lemma":"தீம்பழம்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"கதூஉம்","parts":[{"text":"கதூஉம்","lemma":"கதூஉம்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"தொன்றுமுதிர்","parts":[{"text":"தொன்று","lemma":"தொன்று","gloss":"ancient"},{"text":"முதிர்","lemma":"முதிர்","gloss":"mature/old"}],"gloss":"ancient and mature"},{"surface":"வேளிர்","parts":[{"text":"வேளிர்","lemma":"வேளிர்","gloss":"Velir chieftains"}],"gloss":"Velir chieftains"},{"surface":"குன்றூர்","parts":[{"text":"குன்றூர்","lemma":"குன்றூர்","gloss":"Kunrur (a town)"}],"gloss":"of Kunrur"},{"surface":"குணாது","parts":[{"text":"குணாது","lemma":"குணாது","gloss":"east"}],"gloss":"to the east"}]},{"words":[{"surface":"தண்பெரும்","parts":[{"text":"தண்","lemma":"தண்","gloss":"cool"},{"text":"பெரும்","lemma":"பெரும்","gloss":"great"}],"gloss":"cool and great"},{"surface":"பவ்வம்","parts":[{"text":"பவ்வம்","lemma":"பவ்வம்","gloss":"ocean"}],"gloss":"ocean"},{"surface":"அணங்குக","parts":[{"text":"அணங்கு","lemma":"அணங்கு","gloss":"to afflict/torment"},{"text":"க","lemma":"க","gloss":"optative suffix"}],"gloss":"may it afflict"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"தோழி","gloss":"friend"}],"gloss":"O friend"}]},{"words":[{"surface":"மனையோள்","parts":[{"text":"மனை","lemma":"மனை","gloss":"house"},{"text":"ஓள்","lemma":"ஓள்","gloss":"she who belongs to"}],"gloss":"wife (she of the house)"},{"surface":"மடமையின்","parts":[{"text":"மடமை","lemma":"மடமை","gloss":"ignorance/foolishness"},{"text":"இன்","lemma":"இன்","gloss":"because of"}],"gloss":"due to ignorance"},{"surface":"புலக்கும்","parts":[{"text":"புலக்கும்","lemma":"புலக்கும்","gloss":"she will sulk"}],"gloss":"she will sulk","split_unverified":true}]},{"words":[{"surface":"அனையே","parts":[{"text":"அனையே","lemma":"அனையே","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மகிழ்நற்கியா","parts":[{"text":"மகிழ்நற்கியா","lemma":"மகிழ்நற்கியா","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மாயினம்","parts":[{"text":"மாயினம்","lemma":"மாயினம்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"எனினே","parts":[{"text":"எனினே","lemma":"எனினே","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true}],"literal":"Thick-finned vaalai fish, like a fully pregnant tender young female buffalo, / sweet cluster of mango tree's sweet fruit that which seizes, / ancient mature Velir's Kunrur's east / cool great ocean may it afflict, O friend! / The wife, due to her ignorance, will sulk / like that indeed, to the lord, if we became.","translation":"O friend! May the cool, great ocean to the east of Kunrūr, belonging to the ancient, noble Veḷir, afflict us! In that place, a thick-finned vāḷai fish, like a fully pregnant, tender young female buffalo, leaps to snatch the sweet fruit from a cluster on the mango tree. If we become like that to the lord, his wife will sulk out of her ignorance.","modern":"தோழியே! பழமையான வேளிர் குலத்தாரின் குன்றூருக்குக் கிழக்கே உள்ள குளிர்ந்த பெரிய கடல் நம்மை வருத்தட்டும். அங்கே, நிறைந்த சூலையுடைய இளமையான எருமைக்கடா போன்ற தடித்த முட்களையுடைய வாளை மீனானது, கொத்தாக உள்ள மாமரத்தின் இனிய பழத்தைக் கவ்வி உண்ணும். நாம் அந்தத் தலைவனுக்கு அத்தகையவராக ஆகிவிட்டால், அவனுடைய மனைவி தன் அறியாமையினால் ஊடல் கொள்வாள்.","explanation":"This poem is spoken by the courtesan (kātarparattai) to her friend. She mocks the hero's wife, who is sulking because of the hero's visits to the courtesan. The courtesan describes the fertile Marutam landscape of Kunrūr, where a thick-finned vāḷai fish, resembling a pregnant young buffalo, leaps to snatch sweet mangoes. This image serves as an ullurai (implied metaphor): the courtesan is like the active fish easily enjoying the sweet fruit (the hero's love), while the wife is like the passive tree or buffalo. She proudly asserts that if she merely exists as the object of the lord's affection, the wife foolishly sulks out of ignorance, unable to retain her husband.","model":"gemini-3.5-flash"}}