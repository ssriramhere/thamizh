{"text":"kuruntokai","n":332,"lines":["வந்த வாடைச் சில்பெயற் கடைநாள்","நோய்நீந் தரும்படர் தீரநீ நயந்து","கூறின் எவனோ தோழி நாறுயிர்","மடப்பிடி தழீஇத் தடக்கை யானை","குன்றச் சிறுகுடி யிழிதரு","மன்ற நண்ணிய மலைகிழ வோற்கே"],"tr":["vanta vāṭaic cilpeyaṟ kaṭaināḷ","nōynīn tarumpaṭar tīranī nayantu","kūṟiṉ evaṉō tōḻi nāṟuyir","maṭappiṭi taḻīit taṭakkai yāṉai","kuṉṟac ciṟukuṭi yiḻitaru","maṉṟa naṇṇiya malaikiḻa vōṟkē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"மதுரை மருதங்கிழார் மகனார் இளம்போத்தனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Maturai Marutaṅkiḻār Makaṉār Iḷampōttaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 7"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வந்த","tr":"vanta","foot":"tēmā","acai":[{"kind":"nēr","text":"வந்","tr":"van"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"வாடைச்","tr":"vāṭaic","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"டைச்","tr":"ṭaic"}]},{"text":"சில்பெயற்","tr":"cilpeyaṟ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சில்","tr":"cil"},{"kind":"nirai","text":"பெயற்","tr":"peyaṟ"}]},{"text":"கடைநாள்","tr":"kaṭaināḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கடை","tr":"kaṭai"},{"kind":"nēr","text":"நாள்","tr":"nāḷ"}]}],[{"text":"நோய்நீந்","tr":"nōynīn","foot":"tēmā","acai":[{"kind":"nēr","text":"நோய்","tr":"nōy"},{"kind":"nēr","text":"நீந்","tr":"nīn"}]},{"text":"தரும்படர்","tr":"tarumpaṭar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தரும்","tr":"tarum"},{"kind":"nirai","text":"படர்","tr":"paṭar"}]},{"text":"தீரநீ","tr":"tīranī","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தீ","tr":"tī"},{"kind":"nirai","text":"ரநீ","tr":"ranī"}]},{"text":"நயந்து","tr":"nayantu","