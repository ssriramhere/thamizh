is particle"}],"gloss":"he"}]},{"words":[{"surface":"அன்பின்மையின்","parts":[{"text":"அன்பு","lemma":"aṉpu","gloss":"love"},{"text":"இன்மை","lemma":"iṉmai","gloss":"absence"},{"text":"இன்","lemma":"iṉ","gloss":"causal suffix"}],"gloss":"due to lack of love"},{"surface":"அருள்","parts":[{"text":"அருள்","lemma":"aruḷ","gloss":"grace/compassion"}],"gloss":"grace"},{"surface":"பொருள்","parts":[{"text":"பொருள்","lemma":"poruḷ","gloss":"wealth/value"}],"gloss":"wealth"},{"surface":"என்னார்","parts":[{"text":"என்","lemma":"eṉ","gloss":"say/consider"},{"text":"ஆர்","lemma":"ār","gloss":"negative third person plural suffix"}],"gloss":"they do not consider"}]},{"words":[{"surface":"வன்கண்","parts":[{"text":"வன்மை","lemma":"vaṉmai","gloss":"hardness"},{"text":"கண்","lemma":"kaṇ","gloss":"quality"}],"gloss":"hard-heartedness"},{"surface":"கொண்டு","parts":[{"text":"கொண்டு","lemma":"koḷ","gloss":"having taken"}],"gloss":"having taken"},{"surface":"வலித்து","parts":[{"text":"வலித்து","lemma":"vali","gloss":"having hardened"}],"gloss":"having hardened"},{"surface":"வல்லுநரே","parts":[{"text":"வல்லுநர்","lemma":"valluṉar","gloss":"those who are capable"},{"text":"ஏ","lemma":"ē","gloss":"emphasis particle"}],"gloss":"those who are capable"}]},{"words":[{"surface":"அரவு","parts":[{"text":"அரவு","lemma":"aravu","gloss":"snake"}],"gloss":"snake"},{"surface":"நுங்கும்","parts":[{"text":"நுங்கு","lemma":"nuṅku","gloss":"swallow"},{"text":"உம்","lemma":"um","gloss":"adjectival participle suffix"}],"gloss":"swallowing"},{"surface":"மதியினுக்கு","parts":[{"text":"மதி","lemma":"mati","gloss":"moon"},{"text":"இன்","lemma":"iṉ","gloss":"inflectional increment"},{"text":"உக்கு","lemma":"ukku","gloss":"dative case suffix"}],"gloss":"to the moon"},{"surface":"இவணோர்","parts":[{"text":"இவண்","lemma":"ivaṇ","gloss":"here"},{"text":"ஓர்","lemma":"ōr","gloss":"people"}],"gloss":"people of this place"},{"surface":"போல","parts":[{"text":"போல","lemma":"pōla","gloss":"like"}],"gloss":"like"}]},{"words":[{"surface":"களையார்","parts":[{"text":"களை","lemma":"kaḷai","gloss":"remove"},{"text":"ஆர்","lemma":"ār","gloss":"negative third person plural suffix"}],"gloss":"they will not remove"},{"surface":"ஆயினும்","parts":[{"text":"ஆயினும்","lemma":"āyiṉum","gloss":"even though"}],"gloss":"even though"},{"surface":"கண்","parts":[{"text":"கண்","lemma":"kaṇ","gloss":"eye"}],"gloss":"eye"},{"surface":"இனிது","parts":[{"text":"இனிது","lemma":"iṉitu","gloss":"sweetly"}],"gloss":"sweetly"},{"surface":"படீஇயர்","parts":[{"text":"படீஇயர்","lemma":"படீஇயர்","gloss":"may they close"}],"gloss":"may they close","split_unverified":true}]},{"words":[{"surface":"அஞ்சல்","parts":[{"text":"அஞ்சு","lemma":"añcu","gloss":"fear"},{"text":"அல்","lemma":"al","gloss":"negative imperative suffix"}],"gloss":"do not fear"},{"surface":"என்மரும்","parts":[{"text":"என்மர்","lemma":"eṉmar","gloss":"those who say"},{"text":"உம்","lemma":"um","gloss":"and/also"}],"gloss":"those who say so too"},{"surface":"இல்லை","parts":[{"text":"இல்லை","lemma":"illai","gloss":"are not there"}],"gloss":"are not there"},{"surface":"அந்தில்","parts":[{"text":"அந்தில்","lemma":"antil","gloss":"there/particle of distress"}],"gloss":"there"}]},{"words":[{"surface":"அளிதோ","parts":[{"text":"அளிது","lemma":"aḷitu","gloss":"pitiable thing"},{"text":"ஓ","lemma":"ō","gloss":"exclamatory particle"}],"gloss":"is pitiable indeed"},{"surface":"தானே","parts":[{"text":"தான்","lemma":"tāṉ","gloss":"itself"},{"text":"ஏ","lemma":"ē","gloss":"emphasis particle"}],"gloss":"itself"},{"surface":"நாணே","parts":[{"text":"நாண்","lemma":"nāṇ","gloss":"shame/modesty"},{"text":"ஏ","lemma":"ē","gloss":"emphasis particle"}],"gloss":"modesty"}]},{"words":[{"surface":"ஆங்கு","parts":[{"text":"ஆங்கு","lemma":"āṅku","gloss":"there"}],"gloss":"there"},{"surface":"அவர்","parts":[{"text":"அவர்","lemma":"avar","gloss":"he"}],"gloss":"he"},{"surface":"வதிவயின்","parts":[{"text":"வதி","lemma":"vati","gloss":"stay/reside"},{"text":"வயின்","lemma":"vayiṉ","gloss":"place"}],"gloss":"place of stay"},{"surface":"நீங்க","parts":[{"text":"நீங்கு","lemma":"nīṅku","gloss":"leave/depart"},{"text":"அ","lemma":"a","gloss":"infinitive suffix"}],"gloss":"to depart"},{"surface":"படினே","parts":[{"text":"படு","lemma":"paṭu","gloss":"happen/occur"},{"text":"இன்","lemma":"iṉ","gloss":"conditional suffix"},{"text":"ஏ","lemma":"ē","gloss":"emphasis particle"}],"gloss":"if it goes"}]}],"literal":"O heart! Self-control is not possible, and he, / due to lack of love, does not consider compassion as wealth, / having taken hard-heartedness, hardening himself, is capable of leaving. / Like the people of this place to the moon swallowed by a snake, / even though they cannot remove the distress, may their eyes close sweetly in sleep, / there are none here to say \"do not fear\" either. / Pitiable indeed is my modesty itself, / if it departs to go to the place where he stays there.","translation":"O heart, self-control is no longer possible. He, lacking love, does not value compassion as wealth; with a hard heart, hardening himself, he is capable of staying away. Like the people of this town who, when the moon is swallowed by the snake, cannot remove its distress but still close their eyes in sweet sleep, there is no one here to say to me, 'Do not fear.' How pitiable is my modesty itself, if it leaves me to go to the place where he dwells!","modern":"நெஞ்சே! என்னால் என் அடக்கத்தைக் காக்க முடியவில்லை. அவரோ, அன்பில்லாததால் அருளை ஒரு பொருட்டாக மதிக்கவில்லை. நெஞ்சை வன்மை ஆக்கிக்கொண்டு பிரிந்து வாழும் வலிமை உடையவராக இருக்கிறார். பாம்பினால் விழுங்கப்படும் சந்திரனைப் பார்த்து, அந்தத் துன்பத்தைத் தீர்க்க முடியாவிட்டாலும், இவ்வூர் மக்கள் நிம்மதியாகக் கண்மூடி உறங்குவது போல, எனக்கு 'அஞ்சாதே' என்று ஆறுதல் சொல்லவும் யாரும் இல்லை. அவர் வாழும் இடத்திற்கு என் நாணம் என்னை விட்டு நீங்கிச் செல்லுமானால், அந்த நாணம் மிகவும் பரிதாபத்திற்குரியது ஆகும்.","explanation":"The heroine speaks to her own heart in this Pālai (separation) poem, expressing her deep distress over the hero's departure. The hero has left her to seek wealth, hardening his heart and showing no compassion. She compares her helpless state to the moon during an eclipse, swallowed by a snake. Just as the townspeople cannot save the moon but still sleep peacefully, the people around her sleep soundly, indifferent to her agony, with no one offering words of comfort. Finally, she laments that her own modesty (naṇ) is so pitiable because it threatens to abandon her and fly to where he resides.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.5],[0.6,0.8],[0.8,1.7],[1.8,2.1],[2.1,2.8],[2.8,2.9],[2.9,3.7],[5.56,7.84],[7.84,7.84],[7.84,8.3],[8.3,8.3],[8.3,8.3],[8.3,8.3],[8.3,8.3],[8.3,8.3],[8.3,8.7],[8.7,9.5],[9.5,9.6],[9.6,10.4],[10.4,10.4],[10.4,10.72],[10.72,12.0],[12.0,12.3],[12.3,12.7],[12.7,13.6],[13.6,13.7],[13.7,14.0],[14.0,14.3],[14.3,14.6],[14.6,14.9],[14.9,15.2]],"female":[[0.0,0.5],[0.6,1.04],[1.1,1.6],[1.7,2.0],[2.0,2.8],[2.8,3.0],[3.0,3.9],[3.9,4.2],[4.2,4.2],[4.2,4.2],[4.2,5.6],[5.6,6.4],[6.6,7.7],[7.7,8.0],[8.17,8.51],[8.69,9.03],[9.03,9.2],[9.2,10.8],[10.8,11.5],[11.5,11.6],[11.6,12.47],[12.47,13.4],[13.4,13.7],[13.7,14.0],[14.0,14.0],[14.0,15.3],[15.3,15.7],[15.84,16.26],[16.47,17.0],[17.0,17.5],[17.5,17.6]]}}