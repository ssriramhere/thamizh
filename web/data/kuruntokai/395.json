{"text":"kuruntokai","n":395,"lines":["நெஞ்சே நிறையொல் லாதே யவரே","அன்பின் மையின் அருள்பொருள் என்னார்","வன்கண் கொண்டு வலித்துவல் லுநரே","அரவுநுங்கு மதியினுக் கிவணோர் போலக்","களையார் ஆயினுங் கண்ணினிது படீஇயர்","அஞ்ச லென்மரும் இல்லை அந்தில்","அளிதோ தானே நாணே","ஆங்கவர் வதிவயின் நீங்கப் படினே"],"tr":["neñcē niṟaiyol lātē yavarē","aṉpiṉ maiyiṉ aruḷporuḷ eṉṉār","vaṉkaṇ koṇṭu valittuval lunarē","aravunuṅku matiyiṉuk kivaṇōr pōlak","kaḷaiyār āyiṉuṅ kaṇṇiṉitu paṭīiyar","añca leṉmarum illai antil","aḷitō tāṉē nāṇē","āṅkavar vativayiṉ nīṅkap paṭiṉē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","speaker_en":"the heroine (talaivi)"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 29, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 13, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நெஞ்சே","tr":"neñcē","foot":"tēmā","acai":[{"kind":"nēr","text":"நெஞ்","tr":"neñ"},{"kind":"nēr","text":"சே","tr":"cē"}]},{"text":"நிறையொல்","tr":"niṟaiyol","foot":"puḷimā","acai":[{"kind":"nirai","text":"நிறை","tr":"niṟai"},{"kind":"nēr","text":"யொல்","tr":"yol"}]},{"text":"லாதே","tr":"lātē","foot":"tēmā","acai":[{"kind":"nēr","text":"லா","tr":"lā"},{"kind":"nēr","text":"தே","tr":"tē"}]},{"text":"யவரே","tr":"yavarē","foot":"puḷimā","acai":[{"kind":"nirai","text":"யவ","tr":"yava"},{"kind":"nēr","text":"ரே","tr":"rē"}]}],[{"text":"அன்பின்","tr":"aṉpiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"அன்","tr":"aṉ"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]},{"text":"மையின்","tr":"maiyiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"மை","tr":"mai"},{"kind":"nēr","text":"யின்","tr":"yiṉ"}]},{"text":"அருள்பொருள்","tr":"aruḷporuḷ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அருள்","tr":"aruḷ"},{"kind":"nirai","text":"பொருள்","tr":"poruḷ"}]