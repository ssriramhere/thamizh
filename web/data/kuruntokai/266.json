{"text":"kuruntokai","n":266,"lines":["நமக்கொன் றுரையா ராயினுந் தமக்கொன்","றின்னா இரவின் இன்றுணை யாகிய","படப்பை வேங்கைக்கு மறந்தனர் கொல்லோ","மறப்புரும் பணைத்தோள் மரீஇத்","துறத்தல் வல்லியோர் புள்வாய்த் தூதே"],"tr":["namakkoṉ ṟuraiyā rāyiṉun tamakkoṉ","ṟiṉṉā iraviṉ iṉṟuṇai yākiya","paṭappai vēṅkaikku maṟantaṉar kollō","maṟappurum paṇaittōḷ marīit","tuṟattal valliyōr puḷvāyt tūtē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"நக்கீரனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Nakkīraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 9, veṇṭaḷai 8, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நமக்கொன்","tr":"namakkoṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"நமக்","tr":"namak"},{"kind":"nēr","text":"கொன்","tr":"koṉ"}]},{"text":"றுரையா","tr":"ṟuraiyā","foot":"puḷimā","acai":[{"kind":"nirai","text":"றுரை","tr":"ṟurai"},{"kind":"nēr","text":"யா","tr":"yā"}]},{"text":"ராயினுந்","tr":"rāyiṉun","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ரா","tr":"rā"},{"kind":"nirai","text":"யினுந்","tr":"yiṉun"}]},{"text":"தமக்கொன்","tr":"tamakkoṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"தமக்","tr":"tamak"},{"kind":"nēr","text":"கொன்","tr":"koṉ"}]}],[{"text":"றின்னா","tr":"ṟiṉṉā","foot":"tēmā","acai":[{"kind":"nēr","text":"றின்","tr":"ṟiṉ"},{"kind":"nēr","text":"னா","tr":"ṉā"}]},{"text":"இரவின்","tr":"iraviṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"இர","tr":"ira"},{"kind":"nēr","text":"வின்","tr":"viṉ"}]},{"text":"இன்றுணை","tr":"iṉṟuṇai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"இன்","tr":"iṉ"},{"kind":"nirai","text":"றுணை","tr":"ṟuṇai"}]},{"text":"யாகிய","tr":"yākiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{