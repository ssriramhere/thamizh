s":[{"text":"வலன்","lemma":"வலன்","gloss":"right side"}],"gloss":"right side"},{"surface":"ஏர்பு","parts":[{"text":"ஏர்","lemma":"எழுதல்","gloss":"rise"},{"text":"பு","lemma":"பு","gloss":"verbal participle suffix"}],"gloss":"rising"}]},{"words":[{"surface":"கோட்புலி","parts":[{"text":"கோள்","lemma":"கோள்","gloss":"killing"},{"text":"புலி","lemma":"புலி","gloss":"tiger"}],"gloss":"killer tiger"},{"surface":"வழங்கும்","parts":[{"text":"வழங்கு","lemma":"வழங்குதல்","gloss":"roam"},{"text":"உம்","lemma":"உம்","gloss":"adjectival participle suffix"}],"gloss":"roaming"},{"surface":"சோலை","parts":[{"text":"சோலை","lemma":"சோலை","gloss":"grove"}],"gloss":"grove"}]},{"words":[{"surface":"எனைத்து","parts":[{"text":"எனைத்து","lemma":"எனைத்து","gloss":"how much"}],"gloss":"how much"},{"surface":"என்று","parts":[{"text":"என்","lemma":"என்றல்","gloss":"say"},{"text":"து","lemma":"து","gloss":"verbal participle suffix"}],"gloss":"thus"},{"surface":"எண்ணுகோ","parts":[{"text":"எண்ணு","lemma":"எண்ணுதல்","gloss":"think"},{"text":"கோ","lemma":"கோ","gloss":"first person singular future suffix"}],"gloss":"shall I think?"},{"surface":"முயக்கு","parts":[{"text":"முயக்கு","lemma":"முயக்கு","gloss":"embrace"}],"gloss":"embrace"},{"surface":"இடை","parts":[{"text":"இடை","lemma":"இடை","gloss":"middle"}],"gloss":"during"},{"surface":"மலைவே","parts":[{"text":"மலைவு","lemma":"மலைவு","gloss":"conflict"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"the distress"}]}],"literal":"Embracing the beloved companion, not knowing fear, / even though my heart has escaped and separated, the remaining / if the hand's clasp relaxes, what is the use of that? Very much / distant, look!, is the space between us two. / Roaring like the waves of the great ocean, rising to the right, / the killer tiger roams the groves. / How shall I think of the distress during our embrace?","translation":"Even though my heart has escaped and gone to her, embracing my beloved companion who knows no fear, what is the use if the clasp of my remaining hands relaxes? Look! The distance between us two is vast, where killer tigers roam the groves, roaring like the waves of the great ocean as they rise to the right. How then shall I think of the distress during our embrace?","modern":"அச்சம் அறியாத என் அன்பான துணையைத் தழுவிக்கொண்டு, என் நெஞ்சு என்னை விட்டுத் தப்பி அவளிடம் சென்றுவிட்ட போதிலும், மீதமுள்ள என் கைகளின் பிடி தளர்ந்தால் அதனால் என்ன பயன்? நமக்கிடையே உள்ள தூரம் மிகவும் அதிகம். பெரிய கடலின் அலைகளைப் போல முழங்கி, வலப்பக்கமாக எழுந்து, கொலை செய்யும் புலிகள் நடமாடும் சோலைகள் நிறைந்த வழி அது. அப்படியிருக்க, எங்களது தழுவலுக்கு இடையே ஏற்படும் இந்தத் துன்பத்தை நான் எவ்வாறு எண்ணுவேன்?","explanation":"The hero is speaking to himself while traveling through the harsh desert landscape (Pālai) away from his beloved. He notes that although his mind and heart have already escaped his body to be with his fearless beloved, his physical hands are unable to hold her. The physical distance between them is immense and filled with danger, characterized by killer tigers roaming the groves and roaring like ocean waves. This terrifying landscape reflects the inner torment and conflict he feels during this separation. The key words are 'நெஞ்சு தப்புப் பிரிந்தன்றாயினும்' (even though my heart escaped and separated) and 'முயக்கிடை மலைவு' (the distress during the embrace).","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,0.9],[0.9,1.55],[1.6,2.1],[2.1,2.8],[2.9,3.2],[3.2,3.65],[3.65,4.1],[4.1,5.1],[5.1,5.6],[5.6,5.76],[5.76,6.7],[6.7,6.91],[6.91,7.33],[7.33,7.96],[7.96,8.6],[8.6,9.38],[9.38,10.0],[10.0,10.5],[10.5,11.0],[11.0,11.9],[11.9,12.3],[12.3,12.63],[12.63,13.45],[13.45,14.0],[14.1,14.8],[14.8,15.12]],"female":[[0.0,0.6],[0.6,0.9],[0.9,1.6],[2.08,2.2],[2.2,2.67],[2.8,3.3],[3.37,3.8],[3.8,4.3],[4.3,5.4],[5.4,6.2],[6.2,6.34],[6.34,7.2],[7.2,7.37],[7.37,7.88],[7.88,8.39],[8.39,8.9],[8.9,9.73],[9.73,10.4],[10.4,11.0],[11.0,11.7],[11.7,12.8],[12.8,13.3],[13.3,13.67],[13.67,14.6],[14.6,15.63],[15.63,15.87],[16.1,16.8]]},"sync":[[["அஞ்சுவது","that which is feared"]],[["அஞ்சுவது","that which is feared"],["அறியாது","not knowing"]],[["அறியாது","not knowing"],["அமர்","beloved"],["துணை","companion"]],[["தழீஇய","embraced"]],[["நெஞ்சுதப்",""]],[["பிரிந்தன்",""]],[["றாயினும்",""]],[["எஞ்சிய",""]],[["கை","hand"],["பிணி","clasp"]],[["நெகிழின்","if it loosens"],["அஃது","that"]],[["அஃது","that"],["எவனோ","what use is it?"]],[["நன்றும்","very much"]],[["சேய","they are distant"]],[["அம்ம","look!"]],[["இருவாம்","we two"]],[["இருவாம்","we two"],["இடையே","between"]],[["மா","great"],["கடல்","ocean"]],[["திரையின்","like a wave"]],[["முழங்கி","roaring"]],[["வலன்","right side"],["ஏர்பு","rising"]],[["கோட்புலி","killer tiger"]],[["வழங்கும்","roaming"]],[["சோலை","grove"]],[["எனைத்து","how much"],["என்று","thus"]],[["என்று","thus"],["எண்ணுகோ","shall I think?"]],[["முயக்கு","embrace"],["இடை","during"]],[["மலைவே","the distress"]]]}