{"text":"kuruntokai","n":237,"lines":["அஞ்சுவ தறியா தமர்துணை தழீஇய","நெஞ்சுதப் பிரிந்தன் றாயினும் எஞ்சிய","கைபிணி நெகிழின்அஃ தெவனோ நன்றும்","சேய வம்ம இருவா மிடையே","மாக்கடல் திரையின் முழங்கி வலனேர்பு","கோட்புலி வழங்குஞ் சோலை","எனைத்தென் றெண்ணுகோ முயக்கிடை மலைவே"],"tr":["añcuva taṟiyā tamartuṇai taḻīiya","neñcutap pirintaṉ ṟāyiṉum eñciya","kaipiṇi nekiḻiṉaḵ tevaṉō naṉṟum","cēya vamma iruvā miṭaiyē","mākkaṭal tiraiyiṉ muḻaṅki valaṉērpu","kōṭpuli vaḻaṅkuñ cōlai","eṉaitteṉ ṟeṇṇukō muyakkiṭai malaivē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவன் கூற்று","poet_ta":"அள்ளூர் நன்முல்லையார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Aḷḷūr Naṉmullaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 10, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அஞ்சுவ","tr":"añcuva","foot":"kūviḷam","acai":[{"kind":"nēr","text":"அஞ்","tr":"añ"},{"kind":"nirai","text":"சுவ","tr":"cuva"}]},{"text":"தறியா","tr":"taṟiyā","foot":"puḷimā","acai":[{"kind":"nirai","text":"தறி","tr":"taṟi"},{"kind":"nēr","text":"யா","tr":"yā"}]},{"text":"தமர்துணை","tr":"tamartuṇai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தமர்","tr":"tamar"},{"kind":"nirai","text":"துணை","tr":"tuṇai"}]},{"text":"தழீஇய","tr":"taḻīiya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தழீ","tr":"taḻī"},{"kind":"nirai","text":"இய","tr":"iya"}]}],[{"text":"நெஞ்சுதப்","tr":"neñcutap","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நெஞ்","tr":"neñ"},{"kind":"nirai","text":"சுதப்","tr":"cutap"}]},{"text":"பிரிந்தன்","tr":"pirintaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிரிந்","tr":"pirin"},{"kind":"nēr","text":"தன்","tr":"taṉ"}]},{"text":"றாயினும்","tr":"ṟāyiṉum","foot":"kūviḷam","acai":[{"kind":"nēr