{"text":"kuruntokai","n":304,"lines":["கொல்வினைப் பொலிந்த கூர்வா யெறியுளி","முகம்பட மடுத்த முளிவெதிர் நோன்காழ்","தாங்கரு நீர்ச்சுரத் தெறிந்து வாங்குவிசைக்","கொடுந்திமிற் பரதவர் கோட்டுமீ னெறிய","நெடுங்கரை யிருந்த குறுங்கா லன்னத்து","வெண்டோ டிரியும் வீததை கானற்","கைதையந் தண்புனற் சேர்ப்பனொடு","செய்தனெ மன்றவோர் பகைதரு நட்பே"],"tr":["kolviṉaip polinta kūrvā yeṟiyuḷi","mukampaṭa maṭutta muḷivetir nōṉkāḻ","tāṅkaru nīrccurat teṟintu vāṅkuvicaik","koṭuntimiṟ paratavar kōṭṭumī ṉeṟiya","neṭuṅkarai yirunta kuṟuṅkā laṉṉattu","veṇṭō ṭiriyum vītatai kāṉaṟ","kaitaiyan taṇpuṉaṟ cērppaṉoṭu","ceytaṉe maṉṟavōr pakaitaru naṭpē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"கணக்காயர் தத்தனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kaṇakkāyar Tattaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 15, āciriyattaḷai 14, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கொல்வினைப்","tr":"kolviṉaip","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கொல்","tr":"kol"},{"kind":"nirai","text":"வினைப்","tr":"viṉaip"}]},{"text":"பொலிந்த","tr":"polinta","foot":"puḷimā","acai":[{"kind":"nirai","text":"பொலிந்","tr":"polin"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"கூர்வா","tr":"kūrvā","foot":"tēmā","acai":[{"kind":"nēr","text":"கூர்","tr":"kūr"},{"kind":"nēr","text":"வா","tr":"vā"}]},{"text":"யெறியுளி","tr":"yeṟiyuḷi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"யெறி","tr":"yeṟi"},{"kind":"nirai","text":"யுளி","tr":"yuḷi"}]}],[{"text":"முகம்பட","tr":"mukampaṭa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"முகம்","tr":"mukam"},{"kind":"nirai","text":"பட","tr":"paṭa"}]},{"text":"மடுத்த","tr":"maṭutta","foot":"puḷimā","acai":[{"kind":"nirai","text":"மடுத்","tr":"m