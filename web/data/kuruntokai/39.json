{"text":"kuruntokai","n":39,"lines":["வெந்திறற் கடுவளி பொங்காப் போந்தென","நெற்றுவிளை உழிஞ்சில் வற்றல் ஆர்க்கும்","மலையுடை அருஞ்சுரம் என்பநம்","முலையிடை முனிநர் சென்ற ஆறே"],"tr":["ventiṟaṟ kaṭuvaḷi poṅkāp pōnteṉa","neṟṟuviḷai uḻiñcil vaṟṟal ārkkum","malaiyuṭai aruñcuram eṉpanam","mulaiyiṭai muṉinar ceṉṟa āṟē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"ஔவையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 14, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 9, veṇṭaḷai 4, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வெந்திறற்","tr":"ventiṟaṟ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வெந்","tr":"ven"},{"kind":"nirai","text":"திறற்","tr":"tiṟaṟ"}]},{"text":"கடுவளி","tr":"kaṭuvaḷi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கடு","tr":"kaṭu"},{"kind":"nirai","text":"வளி","tr":"vaḷi"}]},{"text":"பொங்காப்","tr":"poṅkāp","foot":"tēmā","acai":[{"kind":"nēr","text":"பொங்","tr":"poṅ"},{"kind":"nēr","text":"காப்","tr":"kāp"}]},{"text":"போந்தென","tr":"pōnteṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"போந்","tr":"pōn"},{"kind":"nirai","text":"தென","tr":"teṉa"}]}],[{"text":"நெற்றுவிளை","tr":"neṟṟuviḷai","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"நெற்","tr":"neṟ"},{"kind":"nirai","text":"றுவி","tr":"ṟuvi"},{"kind":"nēr","text":"ளை","tr":"ḷai"}]},{"text":"உழிஞ்சில்","tr":"uḻiñcil","foot":"puḷimā","acai":[{"kind":"nirai","text":"உழிஞ்","tr":"uḻiñ"},{"kind":"nēr","text":"சில்","tr":"cil"}]},{"text":"வற்றல்","tr":"vaṟṟal","foot":"tēmā","acai":[{"kind":"nēr","text":"வற்","tr":"vaṟ"},{"kind":"nēr","text":"றல்","tr":"ṟal"}]},{"text":"ஆர்க்கும்","tr":"ārkkum","foot":"tēmā","acai":[{"kind":"nēr","text":"ஆர்க்","tr":"ārk"},{"kind":"nēr","text":"கும்","tr":"kum"}]}],[{"text":"மலையுடை","tr":"malaiyuṭai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மலை","tr":"malai"},{"kind":"nirai","text":"யுடை","tr":"yuṭai"}]},{"text":"அருஞ்சுரம்","tr":"aruñcuram","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அருஞ்","tr":"aruñ"},{"kind":"nirai","text":"சுரம்","tr":"curam"}]},{"text":"என்பநம்","tr":"eṉpanam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nirai","text":"பநம்","tr":"panam"}]}],[{"text":"முலையிடை","tr":"mulaiyiṭai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"முலை","tr":"mulai"},{"kind":"nirai","text":"யிடை","tr":"yiṭai"}]},{"text":"முனிநர்","tr":"muṉinar","foot":"puḷimā","acai":[{"kind":"nirai","text":"முனி","tr":"muṉi"},{"kind":"nēr","text":"நர்","tr":"nar"}]},{"text":"சென்ற","tr":"ceṉṟa","foot":"tēmā","acai":[{"kind":"nēr","text":"சென்","tr":"ceṉ"},{"kind":"nēr","text":"ற","tr":"ṟa"}]},{"text":"ஆறே","tr":"āṟē","foot":"tēmā","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nēr","text":"றே","tr":"ṟē"}]}]]},"ai":{"lines":[{"words":[{"surface":"வெந்திறல்","parts":[{"text":"வெம்","lemma":"வெம்மை","gloss":"fierce"},{"text":"திறல்","lemma":"திறல்","gloss":"strength"}],"gloss":"fierce strength"},{"surface":"கடுவளி","parts":[{"text":"கடு","lemma":"கடுமை","gloss":"harsh"},{"text":"வளி","lemma":"வளி","gloss":"wind"}],"gloss":"harsh wind"},{"surface":"பொங்கா","parts":[{"text":"பொங்கா","lemma":"பொங்குதல்","gloss":"surging"}],"gloss":"surging"},{"surface":"போந்து","parts":[{"text":"போந்து","lemma":"போதல்","gloss":"having come"}],"gloss":"having come"},{"surface":"என","parts":[{"text":"என","lemma":"என","gloss":"as"}],"gloss":"as"}]},{"words":[{"surface":"நெற்று","parts":[{"text":"நெற்று","lemma":"நெற்று","gloss":"dry pod"}],"gloss":"dry pod"},{"surface":"விளை","parts":[{"text":"விளை","lemma":"விளைதல்","gloss":"matured"}],"gloss":"matured"},{"surface":"உழிஞ்சில்","parts":[{"text":"உழிஞ்சில்","lemma":"உழிஞ்சில்","gloss":"siris tree"}],"gloss":"siris tree"},{"surface":"வற்ற