{"text":"kuruntokai","n":58,"lines":["இடிக்குங் கேளிர் நுங்குறை ஆக","நிறுக்க லாற்றினோ நன்றுமற் றில்ல","ஞாயிறு காயும் வெவ்வறை மருங்கிற்","கையில் ஊமன் கண்ணிற் காக்கும்","வெண்ணெய் உணங்கல் போலப்","பரந்தன் றிந்நோய் நோன்றுகொளற் கரிதே"],"tr":["iṭikkuṅ kēḷir nuṅkuṟai āka","niṟukka lāṟṟiṉō naṉṟumaṟ ṟilla","ñāyiṟu kāyum vevvaṟai maruṅkiṟ","kaiyil ūmaṉ kaṇṇiṟ kākkum","veṇṇey uṇaṅkal pōlap","parantaṉ ṟinnōy nōṉṟukoḷaṟ karitē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"வெள்ளி வீதியார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Veḷḷi Vītiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 7, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இடிக்குங்","tr":"iṭikkuṅ","foot":"puḷimā","acai":[{"kind":"nirai","text":"இடிக்","tr":"iṭik"},{"kind":"nēr","text":"குங்","tr":"kuṅ"}]},{"text":"கேளிர்","tr":"kēḷir","foot":"tēmā","acai":[{"kind":"nēr","text":"கே","tr":"kē"},{"kind":"nēr","text":"ளிர்","tr":"ḷir"}]},{"text":"நுங்குறை","tr":"nuṅkuṟai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நுங்","tr":"nuṅ"},{"kind":"nirai","text":"குறை","tr":"kuṟai"}]},{"text":"ஆக","tr":"āka","foot":"tēmā","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nēr","text":"க","tr":"ka"}]}],[{"text":"நிறுக்க","tr":"niṟukka","foot":"puḷimā","acai":[{"kind":"nirai","text":"நிறுக்","tr":"niṟuk"},{"kind":"nēr","text":"க","tr":"ka"}]},{"text":"லாற்றினோ","tr":"lāṟṟiṉō","foot":"kūviḷam","acai":[{"kind":"nēr","text":"லாற்","tr":"lāṟ"},{"kind":"nirai","text":"றினோ","tr":"ṟiṉō"}]},{"text":"நன்றுமற்","tr":"naṉṟumaṟ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நன்","tr":"naṉ"},{"kind":"nirai","text":"றுமற்","tr":"ṟumaṟ"}]},{"text":"றில்ல","tr":"ṟilla","foot":"tēmā","acai":[{"