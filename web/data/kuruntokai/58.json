ide"},{"text":"இன்","lemma":"இன்","gloss":"locative suffix"}],"gloss":"on the side"}]},{"words":[{"surface":"கையில்","parts":[{"text":"கை","lemma":"கை","gloss":"hand"},{"text":"இல்","lemma":"இல்","gloss":"locative suffix"}],"gloss":"in hand"},{"surface":"ஊமன்","parts":[{"text":"ஊமன்","lemma":"ஊமன்","gloss":"mute person"}],"gloss":"mute person"},{"surface":"கண்ணில்","parts":[{"text":"கண்","lemma":"கண்","gloss":"eye"},{"text":"இல்","lemma":"இல்","gloss":"locative suffix"}],"gloss":"with eyes"},{"surface":"காக்கும்","parts":[{"text":"கா","lemma":"கா","gloss":"to protect"},{"text":"க்கும்","lemma":"க்கும்","gloss":"relative participle suffix"}],"gloss":"protecting"}]},{"words":[{"surface":"வெண்ணெய்","parts":[{"text":"வெண்ணெய்","lemma":"வெண்ணெய்","gloss":"butter"}],"gloss":"butter"},{"surface":"உணங்கல்","parts":[{"text":"உணங்கு","lemma":"உணங்கு","gloss":"to dry"},{"text":"அல்","lemma":"அல்","gloss":"verbal noun suffix"}],"gloss":"drying"},{"surface":"போல","parts":[{"text":"போல்","lemma":"போல்","gloss":"to resemble"},{"text":"அ","lemma":"அ","gloss":"infinitive suffix"}],"gloss":"like"}]},{"words":[{"surface":"பரந்தன்று","parts":[{"text":"பரந்தன்று","lemma":"பரந்தன்று","gloss":"it spread"}],"gloss":"it has spread"},{"surface":"இந்நோய்","parts":[{"text":"இந்நோய்","lemma":"இந்நோய்","gloss":"this pain"}],"gloss":"this pain","split_unverified":true},{"surface":"நோன்றுகொளற்கு","parts":[{"text":"நோன்றுகொளற்கு","lemma":"நோன்றுகொளற்கு","gloss":"to endure"}],"gloss":"to endure"},{"surface":"அரிதே","parts":[{"text":"அரிது","lemma":"அரிது","gloss":"difficult"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"is difficult indeed"}]}],"literal":"Reproving friends! Let your concern be. / If I were able to restrain [it], it would be good indeed, but alas! / On the side of a hot rock where the sun burns, / like butter drying, which a handless mute person protects only with his eyes, / this pain has spread, and to endure it is difficult indeed.","translation":"O friends who reprove me! Let your concern be. If I were able to restrain this passion, it would be good indeed, but I cannot. Like butter melting on a hot rock under the burning sun, watched only by the eyes of a handless mute who cannot save it, this pain of mine has spread, and to endure it is difficult indeed.","modern":"என்னை இடித்துரைக்கும் நண்பர்களே! உங்கள் கவலை அப்படியே இருக்கட்டும். என்னால் இந்தத் துயரத்தைத் தடுத்து நிறுத்த முடிந்தால் அது மிகவும் நல்லதுதான், ஆனால் என்னால் இயலவில்லை. சூரியன் காய்கின்ற வெப்பமான பாறையின் பக்கத்திலே, கைகள் இல்லாத ஊமை ஒருவன் தன் கண்களால் மட்டுமே பார்த்துக் காப்பாற்ற முயலும் வெண்ணெய் உருகுவது போல, இந்த நோய் என்னுள் பரவிவிட்டது. இதனைப் பொறுத்துக் கொள்வது மிகவும் அரிதானது.","explanation":"The hero is speaking to his friends who are rebuking him for losing his self-control due to his love for the heroine. He tells them that their advice is well-meaning, but he is powerless to stop his passion. He compares his helpless state to butter melting on a hot rock under the scorching sun, watched by a handless mute who can only look on in distress but cannot save it. The hot rock represents the burning desire, the melting butter is his fading strength, and the handless mute represents his own helpless mind that can only witness the ruin without being able to prevent it. This vivid imagery from the Kurinji landscape perfectly captures the overwhelming nature of love-sickness and the agony of helplessness.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,0.8],[0.88,1.45],[1.62,1.7],[1.7,2.56],[2.7,3.0],[3.0,3.8],[3.85,4.0],[4.0,5.1],[5.1,5.4],[5.4,5.6],[5.6,6.4],[6.4,7.0],[7.0,7.3],[7.3,7.8],[7.8,8.0],[8.0,9.0],[9.0,9.3],[9.3,9.87],[9.87,10.27],[10.27,10.5],[10.5,11.01],[11.01,11.5]],"female":[[0.0,0.7],[0.7,0.8],[0.88,1.45],[1.62,1.7],[1.7,2.06],[2.23,3.3],[3.3,3.7],[3.72,3.8],[3.8,5.3],[5.3,5.6],[5.6,5.8],[5.8,6.6],[6.6,7.3],[7.3,7.6],[7.6,8.2],[8.2,8.5],[8.5,9.6],[9.6,10.1],[10.1,10.7],[10.7,11.4],[11.4,11.6],[11.6,12.49],[12.49,13.0]]},"sync":[[["இடி