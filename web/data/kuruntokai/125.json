s":"foliage"}],"gloss":"foliage"},{"surface":"அணி","parts":[{"text":"அணி","lemma":"aṇi","gloss":"wear/adorn"}],"gloss":"wearing"},{"surface":"அல்குல்","parts":[{"text":"அல்குல்","lemma":"alkul","gloss":"waist/loins"}],"gloss":"waist"},{"surface":"மகளிர்","parts":[{"text":"மகளிர்","lemma":"makaḷir","gloss":"women"}],"gloss":"women"},{"surface":"உள்ளும்","parts":[{"text":"உள்","lemma":"uḷ","gloss":"among/inside"},{"text":"உம்","lemma":"um","gloss":"even/and"}],"gloss":"even among"}]},{"words":[{"surface":"விழவு","parts":[{"text":"விழவு","lemma":"viḻavu","gloss":"festival"}],"gloss":"festival"},{"surface":"மேம்பட்ட","parts":[{"text":"மேம்பட்ட","lemma":"மேம்பட்ட","gloss":"excelled"}],"gloss":"excelled","split_unverified":true},{"surface":"என்","parts":[{"text":"என்","lemma":"eṉ","gloss":"my"}],"gloss":"my"},{"surface":"நலனே","parts":[{"text":"நலன்","lemma":"nalaṉ","gloss":"beauty/goodness"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"beauty indeed"},{"surface":"பழ","parts":[{"text":"பழ","lemma":"paḻa","gloss":"old/ancient"}],"gloss":"ancient"},{"surface":"விறல்","parts":[{"text":"விறல்","lemma":"viṟal","gloss":"strength/victory"}],"gloss":"strength"}]},{"words":[{"surface":"பறை","parts":[{"text":"பறை","lemma":"paṟai","gloss":"flight/wing"}],"gloss":"flight"},{"surface":"வலம்","parts":[{"text":"வலம்","lemma":"valam","gloss":"ability/strength"}],"gloss":"ability"},{"surface":"தப்பிய","parts":[{"text":"தப்பிய","lemma":"tappi","gloss":"lost/failed"}],"gloss":"lost"},{"surface":"பைதல்","parts":[{"text":"பைதல்","lemma":"paital","gloss":"distress/suffering"}],"gloss":"distressed"},{"surface":"நாரை","parts":[{"text":"நாரை","lemma":"nārai","gloss":"heron"}],"gloss":"heron"}]},{"words":[{"surface":"திரை","parts":[{"text":"திரை","lemma":"tirai","gloss":"wave"}],"gloss":"wave"},{"surface":"தோய்","parts":[{"text":"தோய்","lemma":"tōy","gloss":"touch/dip"}],"gloss":"touching"},{"surface":"வாங்கு","parts":[{"text":"வாங்கு","lemma":"vāṅku","gloss":"bend"}],"gloss":"bent"},{"surface":"சினை","parts":[{"text":"சினை","lemma":"ciṉai","gloss":"branch"}],"gloss":"branch"},{"surface":"இருக்கும்","parts":[{"text":"இருக்கும்","lemma":"iru","gloss":"stay/sit"}],"gloss":"sitting"}]},{"words":[{"surface":"தண்","parts":[{"text":"தண்","lemma":"taṇ","gloss":"cool"}],"gloss":"cool"},{"surface":"அம்","parts":[{"text":"அம்","lemma":"am","gloss":"beautiful"}],"gloss":"beautiful"},{"surface":"துறைவனொடு","parts":[{"text":"துறைவன்","lemma":"tuṟaivaṉ","gloss":"lord of the shore"},{"text":"ஒடு","lemma":"oṭu","gloss":"with"}],"gloss":"with the lord of the shore"},{"surface":"கண்","parts":[{"text":"கண்","lemma":"kaṇ","gloss":"eye/gaze"}],"gloss":"gaze"},{"surface":"மாறின்று","parts":[{"text":"மாறு","lemma":"māṟu","gloss":"change/turn away"},{"text":"இன்று","lemma":"iṉṟu","gloss":"past tense marker"}],"gloss":"has turned away"},{"surface":"ஏ","parts":[{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"indeed"}]}],"literal":"Shining bangles slipping, wasting away, I / am I alive? May you live, O friend! On the slope / among the women wearing foliage on their waists, / my beauty which excelled in festivals, / [like] a distressed heron that has lost its ancient strength of flight / sitting on a bent branch touched by the waves, / with the lord of the cool, beautiful shore, eyes have turned away today.","translation":"My shining bangles slip and I waste away. Am I still alive, my friend? May you live! My beauty, which once excelled at festivals among all the women wearing foliage garments on the slopes, is now gone. For today, the gaze of the lord of the cool, beautiful shore has turned away from me—he who rules the shore where a distressed heron, having lost its ancient strength of flight, sits on a bent branch that dips into the waves.","modern":"தோழியே, நீ வாழ்க! என் ஒளிரும் வளையல்கள் கழன்று விழும்படி நான் மெலிந்து தேய்கிறேன். நான் இன்னும் உயிரோடுதான் இருக்கிறேனா? மலைச்சாரலில் தழையாடை அணிந்த பெண்களுள், விழாக்களில் சிறந்து விளங்கிய எனது அழகு இன்று அழிந்துவிட்டது. ஏனெனில், பழமையான பறக்கும் வலிமையை இழந்த வருத்தமுற்ற நாரையானது, அலைகள் தொடும் வளைந்த கிளையில் அமர்ந்திருக்கும் குளிர்ந்த அழகிய கடற்கரைத் தலைவனுடன் எனக்கு இருந்த நட்பு இன்று மாறிவிட்டது.","explanation":"The heroine is speaking to her close friend in a state of deep distress due to separation from her lover. She laments that her body has wasted away so much that her shining bangles are slipping off, and she wonders if she is even alive. She recalls how her beauty once stood out during festivals among all the women wearing foliage garments on the slopes. Now, that beauty is lost because her relationship with the lord of the shore has become estranged, and his gaze has turned away from her. The poem employs a poignant metaphor (uḷḷuṟai) from the coastal (neytal) landscape: the distressed heron that has lost its strength to fly and sits on a branch dipped in waves represents the heroine herself, helpless and overwhelmed by the waves of sorrow.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,1.2],[1.2,1.4],[1.4,1.5],[1.5,2.2],[2.2,2.5],[2.5,2.7],[2.7,3.0],[3.0,3.0],[3.0,3.0],[3.0,4.33],[4.33,5.0],[5.0,5.95],[5.95,6.3],[6.3,6.3],[6.3,6.6],[6.6,7.5],[7.5,8.7],[8.7,9.2],[9.2,9.2],[9.2,9.7],[9.7,10.7],[10.74,11.1],[11.1,11.9],[11.9,12.5],[12.5,12.7],[12.81,13.27]],"female":[[0.0,0.8],[0.8,1.6],[1.6,1.9],[1.9,2.1],[2.1,2.82],[3.0,3.6],[3.6,3.8],[3.8,4.1],[4.1,5.5],[5.5,5.6],[5.6,6.07],[6.07,6.3],[6.3,7.75],[7.75,7.8],[7.8,8.8],[8.8,9.18],[9.18,9.3],[9.3,11.0],[11.0,11.1],[11.1,11.5],[11.5,12.5],[12.5,13.2],[13.24,13.6],[13.6,14.4],[14.4,15.1],[15.1,15.3],[15.57,16.1]]}}