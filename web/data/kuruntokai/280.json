{"text":"kuruntokai","n":280,"lines":["கேளிர் வாழியோ கேளிர் நாளுமென்","நெஞ்சுபிணிக் கொண்ட அஞ்சி லோதிப்","பெருந்தோட் குறுமகள் சிறுமெல் லாகம்","ஒருநாள் புணரப் புணரின்","அரைநாள் வாழ்க்கையும் வேண்டலென் யானே"],"tr":["kēḷir vāḻiyō kēḷir nāḷumeṉ","neñcupiṇik koṇṭa añci lōtip","peruntōṭ kuṟumakaḷ ciṟumel lākam","orunāḷ puṇarap puṇariṉ","araināḷ vāḻkkaiyum vēṇṭaleṉ yāṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"நக்கீரனார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Nakkīraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 11, āciriyattaḷai 7"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கேளிர்","tr":"kēḷir","foot":"tēmā","acai":[{"kind":"nēr","text":"கே","tr":"kē"},{"kind":"nēr","text":"ளிர்","tr":"ḷir"}]},{"text":"வாழியோ","tr":"vāḻiyō","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nirai","text":"ழியோ","tr":"ḻiyō"}]},{"text":"கேளிர்","tr":"kēḷir","foot":"tēmā","acai":[{"kind":"nēr","text":"கே","tr":"kē"},{"kind":"nēr","text":"ளிர்","tr":"ḷir"}]},{"text":"நாளுமென்","tr":"nāḷumeṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nirai","text":"ளுமென்","tr":"ḷumeṉ"}]}],[{"text":"நெஞ்சுபிணிக்","tr":"neñcupiṇik","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"நெஞ்","tr":"neñ"},{"kind":"nirai","text":"சுபி","tr":"cupi"},{"kind":"nēr","text":"ணிக்","tr":"ṇik"}]},{"text":"கொண்ட","tr":"koṇṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"கொண்","tr":"koṇ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"அஞ்சி","tr":"añci","foot":"tēmā","acai":[{"kind":"nēr","text":"அஞ்","tr":"añ"},{"kind":"nēr","text":"சி","tr":"ci"}]},{"text":"லோதிப்","tr":"lōtip","foot":"tēmā","acai":[{"kind":"nēr","text":"லோ","tr":"lō"},{"kind":"nēr","te