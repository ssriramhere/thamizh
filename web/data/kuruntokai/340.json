{"text":"kuruntokai","n":340,"lines":["காமங் கடையிற் காதலர்ப் படர்ந்து","நாமவர்ப் புலம்பி னம்மோ டாகி","ஒருபாற் படுதல் செல்லா தாயிடை","அழுவ நின்ற அலர்வேய் கண்டல்","கழிபெயர் மருங்கி னொல்கி யோதம்","பெயர்தரப் பெயர்தந் தாங்கு","வருந்துந் தோழியவ ரிருந்தவென் நெஞ்சே"],"tr":["kāmaṅ kaṭaiyiṟ kātalarp paṭarntu","nāmavarp pulampi ṉammō ṭāki","orupāṟ paṭutal cellā tāyiṭai","aḻuva niṉṟa alarvēy kaṇṭal","kaḻipeyar maruṅki ṉolki yōtam","peyartarap peyartan tāṅku","varuntun tōḻiyava riruntaveṉ neñcē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"அம்மூவனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Ammūvaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 8, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"காமங்","tr":"kāmaṅ","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"மங்","tr":"maṅ"}]},{"text":"கடையிற்","tr":"kaṭaiyiṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கடை","tr":"kaṭai"},{"kind":"nēr","text":"யிற்","tr":"yiṟ"}]},{"text":"காதலர்ப்","tr":"kātalarp","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"தலர்ப்","tr":"talarp"}]},{"text":"படர்ந்து","tr":"paṭarntu","foot":"puḷimā","acai":[{"kind":"nirai","text":"படர்ந்","tr":"paṭarn"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"நாமவர்ப்","tr":"nāmavarp","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nirai","text":"மவர்ப்","tr":"mavarp"}]},{"text":"புலம்பி","tr":"pulampi","foot":"puḷimā","acai":[{"kind":"nirai","text":"புலம்","tr":"pulam"},{"kind":"nēr","text":"பி","tr":"pi"}]},{"text":"னம்மோ","tr":"ṉammō","foot":"tēmā","acai":[{"kind":"nēr","text":"னம்","tr":"ṉam"},{"kind":"nēr","text":"மோ