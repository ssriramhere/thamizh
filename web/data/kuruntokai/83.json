{"text":"kuruntokai","n":83,"lines":["அரும்பெறல் அமிழ்தம் ஆர்பதம் ஆகப்","பெரும்பெயர் உலகம் பெறீஇயரோ அன்னை","தம்மில் தமதுண் டன்ன சினைதொறும்","தீம்பழந் தூங்கும் பலவின்","ஓங்குமலை நாடனை வரும்என் றாளே"],"tr":["arumpeṟal amiḻtam ārpatam ākap","perumpeyar ulakam peṟīiyarō aṉṉai","tammil tamatuṇ ṭaṉṉa ciṉaitoṟum","tīmpaḻan tūṅkum palaviṉ","ōṅkumalai nāṭaṉai varumeṉ ṟāḷē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"வெண்பூதனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Veṇpūtaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 10, āciriyattaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அரும்பெறல்","tr":"arumpeṟal","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அரும்","tr":"arum"},{"kind":"nirai","text":"பெறல்","tr":"peṟal"}]},{"text":"அமிழ்தம்","tr":"amiḻtam","foot":"puḷimā","acai":[{"kind":"nirai","text":"அமிழ்","tr":"amiḻ"},{"kind":"nēr","text":"தம்","tr":"tam"}]},{"text":"ஆர்பதம்","tr":"ārpatam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஆர்","tr":"ār"},{"kind":"nirai","text":"பதம்","tr":"patam"}]},{"text":"ஆகப்","tr":"ākap","foot":"tēmā","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nēr","text":"கப்","tr":"kap"}]}],[{"text":"பெரும்பெயர்","tr":"perumpeyar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெரும்","tr":"perum"},{"kind":"nirai","text":"பெயர்","tr":"peyar"}]},{"text":"உலகம்","tr":"ulakam","foot":"puḷimā","acai":[{"kind":"nirai","text":"உல","tr":"ula"},{"kind":"nēr","text":"கம்","tr":"kam"}]},{"text":"பெறீஇயரோ","tr":"peṟīiyarō","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"பெறீ","tr":"peṟī"},{"kind":"nirai","text":"இய","tr":"iya"},{"kind":"nēr","text":"ரோ","tr":"rō"}]},{"text":"அன்னை","tr":"aṉṉai","foot":"tēmā","acai":[{