{"text":"kuruntokai","n":194,"lines":["என்னெனப் படுங்கொல் தோழி மின்னுவர","வானோர் பிரங்கும் ஒன்றோ அதனெதிர்","கான மஞ்ஞை கடிய ஏங்கும்","ஏதில கலந்த இரண்டற்கென்","பேதை நெஞ்சம் பெருமலக் குறுமே"],"tr":["eṉṉeṉap paṭuṅkol tōḻi miṉṉuvara","vāṉōr piraṅkum oṉṟō ataṉetir","kāṉa maññai kaṭiya ēṅkum","ētila kalanta iraṇṭaṟkeṉ","pētai neñcam perumalak kuṟumē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"கோவர்த்தனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kōvarttaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"என்னெனப்","tr":"eṉṉeṉap","foot":"kūviḷam","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nirai","text":"னெனப்","tr":"ṉeṉap"}]},{"text":"படுங்கொல்","tr":"paṭuṅkol","foot":"puḷimā","acai":[{"kind":"nirai","text":"படுங்","tr":"paṭuṅ"},{"kind":"nēr","text":"கொல்","tr":"kol"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"மின்னுவர","tr":"miṉṉuvara","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"மின்","tr":"miṉ"},{"kind":"nirai","text":"னுவ","tr":"ṉuva"},{"kind":"nēr","text":"ர","tr":"ra"}]}],[{"text":"வானோர்","tr":"vāṉōr","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"னோர்","tr":"ṉōr"}]},{"text":"பிரங்கும்","tr":"piraṅkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிரங்","tr":"piraṅ"},{"kind":"nēr","text":"கும்","tr":"kum"}]},{"text":"ஒன்றோ","tr":"oṉṟō","foot":"tēmā","acai":[{"kind":"nēr","text":"ஒன்","tr":"oṉ"},{"kind":"nēr","text":"றோ","tr":"ṟō"}]},{"text":"அதனெதிர்","tr":"ataṉetir","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அத","tr":"ata"},{"kind":"ni