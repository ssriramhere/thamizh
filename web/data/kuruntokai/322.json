{"text":"kuruntokai","n":322,"lines":["அமர்க்க ணாமான் அஞ்செவிக் குழவி","கானவ ரெடுப்ப வெரீஇ யினந்தீர்ந்து","கான நண்ணிய சிறுகுடிப் பட்டென","இளைய ரோம்ப மரீஇயவ ணயந்து","மனையுறை வாழ்க்கை வல்லி யாங்கு","மருவின் இனியவு முளவோ","செல்வாந் தோழி யொல்வாங்கு நடந்தே"],"tr":["amarkka ṇāmāṉ añcevik kuḻavi","kāṉava reṭuppa verīi yiṉantīrntu","kāṉa naṇṇiya ciṟukuṭip paṭṭeṉa","iḷaiya rōmpa marīiyava ṇayantu","maṉaiyuṟai vāḻkkai valli yāṅku","maruviṉ iṉiyavu muḷavō","celvān tōḻi yolvāṅku naṭantē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"ஐயூர் முடவனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Aiyūr Muṭavaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 24, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 9, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அமர்க்க","tr":"amarkka","foot":"puḷimā","acai":[{"kind":"nirai","text":"அமர்க்","tr":"amark"},{"kind":"nēr","text":"க","tr":"ka"}]},{"text":"ணாமான்","tr":"ṇāmāṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"ணா","tr":"ṇā"},{"kind":"nēr","text":"மான்","tr":"māṉ"}]},{"text":"அஞ்செவிக்","tr":"añcevik","foot":"kūviḷam","acai":[{"kind":"nēr","text":"அஞ்","tr":"añ"},{"kind":"nirai","text":"செவிக்","tr":"cevik"}]},{"text":"குழவி","tr":"kuḻavi","foot":"puḷimā","acai":[{"kind":"nirai","text":"குழ","tr":"kuḻa"},{"kind":"nēr","text":"வி","tr":"vi"}]}],[{"text":"கானவ","tr":"kāṉava","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"னவ","tr":"ṉava"}]},{"text":"ரெடுப்ப","tr":"reṭuppa","foot":"puḷimā","acai":[{"kind":"nirai","text":"ரெடுப்","tr":"reṭup"},{"kind":"nēr","text":"ப","tr":"pa"}]},{"text":"வெரீஇ","tr":"verīi","foot":"puḷimā","acai":[{"kind":"nirai","text":"வெரீ","tr":"verī"},{"kind":"nēr","text":"இ","tr":"i"}]}