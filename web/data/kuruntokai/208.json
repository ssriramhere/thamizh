{"text":"kuruntokai","n":208,"lines":["ஒன்றே னல்லேன் ஒன்றுவென் குன்றத்துப்","பொருகளிறு மிதித்த நெரிதாள் வேங்கை","குறவர் மகளிர் கூந்தற் பெய்ம்மார்","நின்றுகொய மலரும் நாடனொ","டொன்றேன் றோழி ஒன்றினானே"],"tr":["oṉṟē ṉallēṉ oṉṟuveṉ kuṉṟattup","porukaḷiṟu mititta neritāḷ vēṅkai","kuṟavar makaḷir kūntaṟ peymmār","niṉṟukoya malarum nāṭaṉo","ṭoṉṟēṉ ṟōḻi oṉṟiṉāṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"கபிலர்","speaker_en":"the heroine (talaivi)","poet_tr":"Kapilar"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 2×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 14, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 9, veṇṭaḷai 5, kalittaḷai 3"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஒன்றே","tr":"oṉṟē","foot":"tēmā","acai":[{"kind":"nēr","text":"ஒன்","tr":"oṉ"},{"kind":"nēr","text":"றே","tr":"ṟē"}]},{"text":"னல்லேன்","tr":"ṉallēṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"னல்","tr":"ṉal"},{"kind":"nēr","text":"லேன்","tr":"lēṉ"}]},{"text":"ஒன்றுவென்","tr":"oṉṟuveṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஒன்","tr":"oṉ"},{"kind":"nirai","text":"றுவென்","tr":"ṟuveṉ"}]},{"text":"குன்றத்துப்","tr":"kuṉṟattup","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"குன்","tr":"kuṉ"},{"kind":"nēr","text":"றத்","tr":"ṟat"},{"kind":"nēr","text":"துப்","tr":"tup"}]}],[{"text":"பொருகளிறு","tr":"porukaḷiṟu","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"பொரு","tr":"poru"},{"kind":"nirai","text":"களி","tr":"kaḷi"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"மிதித்த","tr":"mititta","foot":"puḷimā","acai":[{"kind":"nirai","text":"மிதித்","tr":"mitit"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"நெரிதாள்","tr":"neritāḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெரி","tr":"neri"},{"kind":"nēr","text":"தாள்","tr":"tāḷ"}]},{"text":"வேங்கை","tr":"vēṅkai","foot":"t