[{"kind":"nirai","text":"பழி","tr":"paḻi"},{"kind":"nēr","text":"யே","tr":"yē"}]},{"text":"பிரிவுதலை","tr":"pirivutalai","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"பிரி","tr":"piri"},{"kind":"nirai","text":"வுத","tr":"vuta"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"வரினே","tr":"variṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"வரி","tr":"vari"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"காலையும்","parts":[{"text":"காலை","lemma":"காலை","gloss":"morning"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"morning and"},{"surface":"பகலும்","parts":[{"text":"பகல்","lemma":"பகல்","gloss":"daytime"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"daytime and"},{"surface":"கையறு","parts":[{"text":"கை","lemma":"கை","gloss":"hand/means"},{"text":"அறு","lemma":"அறு","gloss":"without"}],"gloss":"helpless/despairing"},{"surface":"மாலையும்","parts":[{"text":"மாலை","lemma":"மாலை","gloss":"evening"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"evening and"}]},{"words":[{"surface":"ஊர்","parts":[{"text":"ஊர்","lemma":"ஊர்","gloss":"town"}],"gloss":"town"},{"surface":"துஞ்சு","parts":[{"text":"துஞ்சு","lemma":"துஞ்சு","gloss":"sleep"}],"gloss":"sleeping"},{"surface":"யாமமும்","parts":[{"text":"யாமம்","lemma":"யாமம்","gloss":"midnight"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and midnight"},{"surface":"விடியலும்","parts":[{"text":"விடியல்","lemma":"விடியல்","gloss":"dawn"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and dawn"},{"surface":"என்று","parts":[{"text":"என்று","lemma":"என்","gloss":"saying"}],"gloss":"saying"},{"surface":"இ","parts":[{"text":"இ","lemma":"இ","gloss":"this"}],"gloss":"this"}]},{"words":[{"surface":"பொழுது","parts":[{"text":"பொழுது","lemma":"பொழுது","gloss":"time"}],"gloss":"time"},{"surface":"இடை","parts":[{"text":"இடை","lemma":"இடை","gloss":"interval"}],"gloss":"interval"},{"surface":"தெரியின்","parts":[{"text":"தெரியின்","lemma":"தெரி","gloss":"if distinguished"}],"gloss":"if distinguished"},{"surface":"பொய்யே","parts":[{"text":"பொய்","lemma":"பொய்","gloss":"falsehood"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"indeed a lie"},{"surface":"காமம்","parts":[{"text":"காமம்","lemma":"காமம்","gloss":"love"}],"gloss":"love"}]},{"words":[{"surface":"மா","parts":[{"text":"மா","lemma":"மா","gloss":"horse"}],"gloss":"horse"},{"surface":"என","parts":[{"text":"என","lemma":"என","gloss":"as"}],"gloss":"as"},{"surface":"மடலோடு","parts":[{"text":"மடல்","lemma":"மடல்","gloss":"palmyra stem"},{"text":"ஓடு","lemma":"ஓடு","gloss":"with"}],"gloss":"with a palmyra-stem horse"},{"surface":"மறுகில்","parts":[{"text":"மறுகு","lemma":"மறுகு","gloss":"street"},{"text":"இல்","lemma":"இல்","gloss":"in"}],"gloss":"in the street"},{"surface":"தோன்றி","parts":[{"text":"தோன்றி","lemma":"தோன்று","gloss":"appearing"}],"gloss":"appearing"}]},{"words":[{"surface":"தெற்றென","parts":[{"text":"தெற்றென","lemma":"தெற்றென","gloss":"clearly/publicly"}],"gloss":"clearly"},{"surface":"தூற்றலும்","parts":[{"text":"தூற்றல்","lemma":"தூற்று","gloss":"slandering/revealing"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and slandering"},{"surface":"பழியே","parts":[{"text":"பழி","lemma":"பழி","gloss":"blame/shame"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"indeed a shame"}]},{"words":[{"surface":"வாழ்தலும்","parts":[{"text":"வாழ்தல்","lemma":"வாழ்தல்","gloss":"living"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and living"},{"surface":"பழியே","parts":[{"text":"பழி","lemma":"பழி","gloss":"blame/shame"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"indeed a shame"},{"surface":"பிரிவு","parts":[{"text":"பிரிவு","lemma":"பிரிவு","gloss":"separation"}],"gloss":"separation"},{"surface":"தலைவரினே","parts":[{"text":"தலை","lemma":"தலை","gloss":"upon"},{"text":"வரின்","lemma":"வரு","gloss":"if comes"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"if it comes upon us"}]}],"literal":"Morning and, daytime and, helpless evening and, / sleeping town's midnight and, dawn and, saying thus, / if these intervals of time are distinguished, love is indeed a lie. / Appearing in the street with a palmyra-stem horse, / and being publicly slandered is indeed a shame. / And living is indeed a shame, if separation comes upon us.","translation":"Morning, daytime, helpless evening, midnight when the town sleeps, and dawn—if one can distinguish between these times, then love is a lie. To appear in the street riding a palmyra-stem horse, being publicly slandered, is a shame. But to go on living, if separation comes upon us, is a greater shame.","modern":"காலை, பகல், செயலற்ற மாலை, ஊர் உறங்கும் நள்ளிரவு, விடியல் என்று இந்த பொழுதுகளுக்கு இடையே வேறுபாடு தெரிந்தால் காதல் என்பது பொய்யானதே ஆகும். பனை மடலால் செய்த குதிரையின் மேல் ஏறி தெருவில் தோன்றி, எல்லாரும் அறியும்படி பழிதூற்றப் படுவதும் அவமானமே. ஆனால், நம்மிடையே பிரிவு வந்துவிட்டால், அதன் பின்னும் உயிர் வாழ்வது அதைவிடப் பெரிய அவமானமே ஆகும்.","explanation":"The hero speaks to himself about the intensity of his love and the pain of separation. He declares that if a lover can distinguish between different times of the day—such as morning, noon, evening, midnight, and dawn—then their love is not true, because for a true lover, every moment is filled with the same constant, agonizing thought of the beloved. He mentions 'maṭal' (riding a palmyra-stem horse), a traditional practice where a desperate lover publicly proclaims his love to win his lady, accepting the public shame ('paḻi') it brings. However, he concludes that while such public slander is shameful, continuing to live after being separated from the beloved is an even greater shame. The poem belongs to the Kuriñci tiṇai, reflecting the deep union and the dread of separation.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,0.8],[0.8,1.2],[1.2,1.6],[1.6,3.5],[3.5,3.9],[3.9,4.06],[4.06,4.7],[4.7,6.2],[6.2,6.6],[6.6,6.6],[6.6,7.2],[7.2,8.9],[8.9,8.9],[8.9,9.7],[9.7,10.1],[10.1,11.6],[11.6,11.6],[11.6,12.1],[1