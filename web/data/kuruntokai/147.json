{"text":"kuruntokai","n":147,"lines":["வேனிற் பாதிரிக் கூன்மல ரன்ன","மயிரேர் பொழுகிய வங்கலுழ் மாமை","நுண்பூண் மடந்தையைத் தந்தோய் போல","இன்றுயில் எடுப்புதி கனவே","எள்ளார் அம்ம துணைப்பிரிந் தோரே"],"tr":["vēṉiṟ pātirik kūṉmala raṉṉa","mayirēr poḻukiya vaṅkaluḻ māmai","nuṇpūṇ maṭantaiyait tantōy pōla","iṉṟuyil eṭupputi kaṉavē","eḷḷār amma tuṇaippirin tōrē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவன் கூற்று","poet_ta":"கோப்பெருஞ் சோழன்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Kōpperuñ Cōḻaṉ"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 10, āciriyattaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வேனிற்","tr":"vēṉiṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"வே","tr":"vē"},{"kind":"nēr","text":"னிற்","tr":"ṉiṟ"}]},{"text":"பாதிரிக்","tr":"pātirik","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nirai","text":"திரிக்","tr":"tirik"}]},{"text":"கூன்மல","tr":"kūṉmala","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கூன்","tr":"kūṉ"},{"kind":"nirai","text":"மல","tr":"mala"}]},{"text":"ரன்ன","tr":"raṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"ரன்","tr":"raṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]}],[{"text":"மயிரேர்","tr":"mayirēr","foot":"puḷimā","acai":[{"kind":"nirai","text":"மயி","tr":"mayi"},{"kind":"nēr","text":"ரேர்","tr":"rēr"}]},{"text":"பொழுகிய","tr":"poḻukiya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பொழு","tr":"poḻu"},{"kind":"nirai","text":"கிய","tr":"kiya"}]},{"text":"வங்கலுழ்","tr":"vaṅkaluḻ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வங்","tr":"vaṅ"},{"kind":"nirai","text":"கலுழ்","tr":"kaluḻ"}]},{"text":"மாமை","tr":"māmai","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"மை","tr":"mai"}]}],[{"text":"நுண்பூண்","tr":"nuṇpūṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"நுண்","tr":"nuṇ"},{"kind":"nēr","text":"பூண்","tr":"pūṇ"}]},{"text":"மடந்தையைத்","tr":"maṭantaiyait","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"மடந்","tr":"maṭan"},{"kind":"nēr","text":"தை","tr":"tai"},{"kind":"nēr","text":"யைத்","tr":"yait"}]},{"text":"தந்தோய்","tr":"tantōy","foot":"tēmā","acai":[{"kind":"nēr","text":"தந்","tr":"tan"},{"kind":"nēr","text":"தோய்","tr":"tōy"}]},{"text":"போல","tr":"pōla","foot":"tēmā","acai":[{"kind":"nēr","text":"போ","tr":"pō"},{"kind":"nēr","text":"ல","tr":"la"}]}],[{"text":"இன்றுயில்","tr":"iṉṟuyil","foot":"kūviḷam","acai":[{"kind":"nēr","text":"இன்","tr":"iṉ"},{"kind":"nirai","text":"றுயில்","tr":"ṟuyil"}]},{"text":"எடுப்புதி","tr":"eṭupputi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"எடுப்","tr":"eṭup"},{"kind":"nirai","text":"புதி","tr":"puti"}]},{"text":"கனவே","tr":"kaṉavē","foot":"puḷimā","acai":[{"kind":"nirai","text":"கன","tr":"kaṉa"},{"kind":"nēr","text":"வே","tr":"vē"}]}],[{"text":"எள்ளார்","tr":"eḷḷār","foot":"tēmā","acai":[{"kind":"nēr","text":"எள்","tr":"eḷ"},{"kind":"nēr","text":"ளார்","tr":"ḷār"}]},{"text":"அம்ம","tr":"amma","foot":"tēmā","acai":[{"kind":"nēr","text":"அம்","tr":"am"},{"kind":"nēr","text":"ம","tr":"ma"}]},{"text":"துணைப்பிரிந்","tr":"tuṇaippirin","foot":"karuviḷam","acai":[{"kind":"nirai","text":"துணைப்","tr":"tuṇaip"},{"kind":"nirai","text":"பிரிந்","tr":"pirin"}]},{"text":"தோரே","tr":"tōrē","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ரே","tr":"rē"}]}]]},"ai":{"lines":[{"words":[{"surface":"வேனில்","parts":[{"text":"வேனில்","lemma":"வேனில்","gloss":"summer"}],"gloss":"summer"},{"surface":"பாதிரி","parts":[{"text":"பாதிரி","lemma":"பாதிரி","gloss":"trumpet flower tree"}],"gloss":"trumpet flower tree"},{"surface":"கூன்மலர்","parts":[{"text":"கூன்","lemma":"கூன்","gloss":"curved"},{"text":"மலர்","lemma":"மலர்","gloss":"flower"}],"gloss":"curved flower"},{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"அன்ன","gloss":"like"}],"gloss":"like"}]},{"words":[{"surface":"மயிர்","parts":[{"text":"மயிர்","lemma":"மயிர்","gloss":"hair"}],"gloss":"hair"},{"surface":"ஏர்","parts":[{"text":"ஏர்","lemma":"ஏர்","gloss":"beauty"}],"gloss":"beauty"},{"surface":"பொழுகிய","parts":[{"text":"பொழுகு","lemma":"பொழுகு","gloss":"flow"},{"text":"இய","lemma":"இய","gloss":"adjectival participle suffix"}],"gloss":"flowing"},{"surface":"வங்கலுழ்","parts":[{"text":"வங்கலுழ்","lemma":"வங்கலுழ்","gloss":"dark and abundant"}],"gloss":"dark and abundant","split_unverified":true},{"surface":"மாமை","parts":[{"text":"மாமை","lemma":"மாமை","gloss":"dark beauty"}],"gloss":"dark beauty"}]},{"words":[{"surface":"நுண்பூண்","parts":[{"text":"நுண்","lemma":"நுண்","gloss":"fine"},{"text":"பூண்","lemma":"பூண்","gloss":"ornaments"}],"gloss":"fine ornaments"},{"surface":"மடந்தையை","parts":[{"text":"மடந்தை","lemma":"மடந்தை","gloss":"young woman"},{"text":"ஐ","lemma":"ஐ","gloss":"accusative case marker"}],"gloss":"the young woman"},{"surface":"தந்தோய்","parts":[{"text":"தந்து","lemma":"தா","gloss":"having given"},{"text":"ஓய்","lemma":"ஓய்","gloss":"you (second person singular suffix)"}],"gloss":"you who gave"},{"surface":"போல","parts":[{"text":"போல","lemma":"போல","gloss":"like"}],"gloss":"as if"}]},{"words":[{"surface":"இன்றுயில்","parts":[{"text":"இன்","lemma":"இனிமை","gloss":"sweet"},{"text":"துயில்","lemma":"துயில்","gloss":"sleep"}],"gloss":"sweet sleep"},{"surface":"எடுப்புதி","parts":[{"text":"எடுப்பு","lemma":"எடுப்பு","gloss":"wake up"},{"text":"தி","lemma":"தி","gloss":"second person singular suffix"}],"gloss":"you wake me up"},{"surface":"கனவே","parts":[{"text":"கனவு","lemma":"கனவு","gloss":"dream"},{"text":"ஏ","lemma":"ஏ","gloss":"vocative emphasis"}],"gloss":"O dream!"}]},{"words":[{"surface":"எள்ளார்","parts":[{"text":"எள்","lemma":"எள்ளு","gloss":"despise"},{"text":"ஆர்","lemma":"ஆர்","gloss":"they (negative suffix)"}],"gloss":"they will not despise"},{"surface":"அம்ம","parts":[{"text":"அம்ம","lemma":"அம்ம","gloss":"listen / indeed"}],"gloss":"indeed"},{"surface":"துணைப்பிரிந்தோரே","parts":[{"text":"துணை","lemma":"துணை","gloss":"partner"},{"text":"பிரிந்து","lemma":"பிரி","gloss":"having separated"},{"text":"ஓர்","lemma":"ஓர்","gloss":"those who"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"those who have separated from their partners"}]}],"literal":"Like the curved flower of the summer trumpet-flower tree / with beautiful hair flowing, and dark, abundant beauty, / as if you brought that young woman wearing fine ornaments, / you wake me from my sweet sleep, O dream! / They will not mock, indeed, those who have separated from their partners.","translation":"O dream! You wake me from my sweet sleep, appearing as if you have brought back my young woman adorned with fine jewels, whose dark beauty is like the curved flower of the summer trumpet-flower tree and whose beautiful hair flows. Those who have separated from their beloved partners will surely not mock you for this.","modern":"கோடைகாலத்துப் பாதிரி மரத்தின் வளைந்த மலரைப் போன்ற, அழகிய கூந்தல் ஒழுகும், கரிய அழகைக் கொண்ட, நுட்பமான அணிகலன்களை அணிந்த என் தலைவியைக் கொண்டுவந்து தருவது போல, என் இனிய தூக்கத்தைக் கலைக்கிறாய், கனவே! தம் துணையைப் பிரிந்து வாழ்பவர்கள் உன்னை இகழ மாட்டார்கள்.","explanation":"The hero is traveling through the arid desert path (pālai) on a mission, separated from his beloved. During his journey, he falls into a sweet sleep and dreams of his beloved, whose dark beauty and flowing hair resemble the curved, beautiful trumpet-flower of the summer. The dream is so vivid that it feels as if the dream itself has brought her to him, but then he suddenly wakes up to find himself alone. Instead of being angry at the dream for waking him and shattering the illusion, he feels grateful for the brief, sweet reunion. He addresses the dream, saying that those who suffer the pain of separation from their partners will never mock or blame the dream, because even a fleeting moment of her presence in a dream is a precious comfort.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,0.9],[0.9,1.45],[1.45,1.6],[1.8,2.12],[2.12,2.3],[2.3,2.96],[2.96,3.4],[3.4,4.3],[4.3,4.88],[4.88,5.12],[5.2,5.6],[5.6,6.5],[6.5,6.85],[6.95,7.1],[7.1,7.1],[7.1,7.1],[7.1,8.92],[8.92,8.98]],"female":[[0.0,0.7],[0.7,0.9],[0.9,1.65],[1.65,2.0],[2.0,2.36],[2.68,3.1],[3.1,3.6],[3.6,4.1],[4.1,5.1],[5.1,5.77],[5.77,6.2],[6.2,6.6],[6.83,7.6],[7.6,8.1],[8.1,8.5],[8.5,8.8],[8.8,9.1],[9.1,9.4],[9.4,9.7]]},"sync":[[["வேனில்","summer"]],[["பாதிரி","trumpet flower tree"],["கூன்மலர்","curved flower"]],[["கூன்மலர்","curved flower"]],[["கூன்மலர்","curved flower"],["அன்ன","like"]],[["மயிர்","hair"],["ஏர்","beauty"]],[["பொழுகிய","flowing"]],[["வங்கலுழ்","dark and abundant"]],[["மாமை","dark beauty"]],[["நுண்பூண்","fine ornaments"]],[["மடந்தையை","the young woman"],["தந்தோய்","you who gave"]],[["தந்தோய்","you who gave"]],[["போல","as if"]],[["இன்றுயில்","sweet sleep"]],[["எடுப்புதி","you wake me up"]],[["கனவே","O dream!"]],[["எள்ளார்","they will not despise"]],[["அம்ம","indeed"]],[["துணைப்பிரிந்தோரே","those who have separated from their partners"]],[["துணைப்பிரிந்தோரே","those who have separated from their partners"]]]}