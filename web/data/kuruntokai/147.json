{"text":"kuruntokai","n":147,"lines":["வேனிற் பாதிரிக் கூன்மல ரன்ன","மயிரேர் பொழுகிய வங்கலுழ் மாமை","நுண்பூண் மடந்தையைத் தந்தோய் போல","இன்றுயில் எடுப்புதி கனவே","எள்ளார் அம்ம துணைப்பிரிந் தோரே"],"tr":["vēṉiṟ pātirik kūṉmala raṉṉa","mayirēr poḻukiya vaṅkaluḻ māmai","nuṇpūṇ maṭantaiyait tantōy pōla","iṉṟuyil eṭupputi kaṉavē","eḷḷār amma tuṇaippirin tōrē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவன் கூற்று","poet_ta":"கோப்பெருஞ் சோழன்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Kōpperuñ Cōḻaṉ"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 10, āciriyattaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வேனிற்","tr":"vēṉiṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"வே","tr":"vē"},{"kind":"nēr","text":"னிற்","tr":"ṉiṟ"}]},{"text":"பாதிரிக்","tr":"pātirik","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nirai","text":"திரிக்","tr":"tirik"}]},{"text":"கூன்மல","tr":"kūṉmala","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கூன்","tr":"kūṉ"},{"kind":"nirai","text":"மல","tr":"mala"}]},{"text":"ரன்ன","tr":"raṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"ரன்","tr":"raṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]}],[{"text":"மயிரேர்","tr":"mayirēr","foot":"puḷimā","acai":[{"kind":"nirai","text":"மயி","tr":"mayi"},{"kind":"nēr","text":"ரேர்","tr":"rēr"}]},{"text":"பொழுகிய","tr":"poḻukiya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பொழு","tr":"poḻu"},{"kind":"nirai","text":"கிய","tr":"kiya"}]},{"text":"வங்கலுழ்","tr":"vaṅkaluḻ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வங்","tr":"vaṅ"},{"kind":"nirai","text":"கலுழ்","tr":"kaluḻ"}]},{"text":"மாமை","tr":"māmai","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"மை","tr":"mai"}]}],[