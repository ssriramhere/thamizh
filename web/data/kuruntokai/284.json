"text":"கடுப்ப","lemma":"கடுப்ப","gloss":"to resemble"}],"gloss":"resembling"}]},{"words":[{"surface":"மன்றத்து","parts":[{"text":"மன்றத்து","lemma":"மன்றத்து","gloss":"of the common ground"}],"gloss":"of the common ground","split_unverified":true},{"surface":"உறுகல்","parts":[{"text":"உறு","lemma":"உறு","gloss":"large"},{"text":"கல்","lemma":"கல்","gloss":"stone"}],"gloss":"large rock"},{"surface":"மீமிசை","parts":[{"text":"மீ","lemma":"மீ","gloss":"top"},{"text":"மிசை","lemma":"மிசை","gloss":"top"}],"gloss":"upon the very top"},{"surface":"பலவுடன்","parts":[{"text":"பல","lemma":"பல","gloss":"many"},{"text":"உடன்","lemma":"உடன்","gloss":"together"}],"gloss":"many together"}]},{"words":[{"surface":"ஒண்","parts":[{"text":"ஒண்","lemma":"ஒண்","gloss":"bright"}],"gloss":"bright","split_unverified":true},{"surface":"செம்","parts":[{"text":"செம்","lemma":"செம்மை","gloss":"red"}],"gloss":"red"},{"surface":"காந்தள்","parts":[{"text":"காந்தள்","lemma":"காந்தள்","gloss":"glory lily"}],"gloss":"glory lily"},{"surface":"அவிழும்","parts":[{"text":"அவிழ்","lemma":"அவிழ்","gloss":"blossom"},{"text":"உம்","lemma":"உம்","gloss":"relative participle suffix"}],"gloss":"blossoming"},{"surface":"நாடன்","parts":[{"text":"நாடு","lemma":"நாடு","gloss":"land"},{"text":"அன்","lemma":"அன்","gloss":"he"}],"gloss":"man of the land"}]},{"words":[{"surface":"அறவன்","parts":[{"text":"அறவன்","lemma":"அறவன்","gloss":"virtuous man"}],"gloss":"virtuous man","split_unverified":true},{"surface":"ஆயினும்","parts":[{"text":"ஆயின்","lemma":"ஆயின்","gloss":"if it is"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"even if he is"},{"surface":"அல்லன்","parts":[{"text":"அல்","lemma":"அல்","gloss":"not"},{"text":"அன்","lemma":"அன்","gloss":"masculine suffix"}],"gloss":"not so"},{"surface":"ஆயினும்","parts":[{"text":"ஆயின்","lemma":"ஆயின்","gloss":"if it is"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"even if he is"}]},{"words":[{"surface":"நம்மே","parts":[{"text":"நம்","lemma":"நம்","gloss":"us"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"us indeed"},{"surface":"சுவரோ","parts":[{"text":"சுவர்","lemma":"சுவர்","gloss":"wall/support"},{"text":"ஓ","lemma":"ஓ","gloss":"interrogative"}],"gloss":"are we the wall/support?"},{"surface":"தம்மிலர்","parts":[{"text":"தம்","lemma":"தம்","gloss":"their"},{"text":"இல்","lemma":"இல்","gloss":"house/home"},{"text":"அர்","lemma":"அர்","gloss":"pronominal suffix"}],"gloss":"those without their own home"},{"surface":"கொல்லோ","parts":[{"text":"கொல்","lemma":"கொல்","gloss":"particle of doubt"},{"text":"ஓ","lemma":"ஓ","gloss":"clitic"}],"gloss":"I wonder"}]},{"words":[{"surface":"வரையிற்","parts":[{"text":"வரையிற்","lemma":"வரையிற்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"றாழ்ந்த","parts":[{"text":"றாழ்ந்த","lemma":"றாழ்ந்த","gloss":""}],"gloss":"","split_unverified":true},{"surface":"வால்வெள்","parts":[{"text":"வால்வெள்","lemma":"வால்வெள்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"ளருவி","parts":[{"text":"ளருவி","lemma":"ளருவி","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"கொல்","parts":[{"text":"கொல்","lemma":"கொல்","gloss":"useless/fearsome"}],"gloss":"useless"},{"surface":"நிலை","parts":[{"text":"நிலை","lemma":"நிலை","gloss":"state/standing"}],"gloss":"standing"},{"surface":"குரம்பையின்","parts":[{"text":"குரம்பை","lemma":"குரம்பை","gloss":"hut"},{"text":"இன்","lemma":"இன்","gloss":"locative/ablative case suffix"}],"gloss":"by the hut"},{"surface":"இழிதரும்","parts":[{"text":"இழி","lemma":"இழி","gloss":"descend"},{"text":"தரும்","lemma":"தரும்","gloss":"auxiliary verb indicating direction"}],"gloss":"flowing down"}]},{"words":[{"surface":"இன்னாது","parts":[{"text":"இன்னா","lemma":"இன்னா","gloss":"unpleasant/painful"},{"text":"து","lemma":"து","gloss":"pronominal suffix"}],"gloss":"painfully"},{"surface":"இருந்த","parts":[{"text":"இரு","lemma":"இரு","gloss":"be/stay"},{"text":"ந்த","lemma":"ந்த","gloss":"past relative participle suffix"}],"gloss":"staying"},{"surface":"இ","parts":[{"text":"இ","lemma":"இ","gloss":"this"}],"gloss":"this"},{"surface":"சிறு","parts":[{"text":"சிறு","lemma":"சிறு","gloss":"small"}],"gloss":"small"},{"surface":"குடி","parts":[{"text":"குடி","lemma":"குடி","gloss":"hamlet"}],"gloss":"hamlet"},{"surface":"ஓரே","parts":[{"text":"ஓர்","lemma":"ஓர்","gloss":"people"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"people indeed"}]}],"literal":"Resembling the spotted face of a battle-fought elephant, / upon the very top of the large rock in the common ground, many together / bright red glory lilies bloom in the land of the lord. / Whether he is a virtuous man or not, / are we indeed his wall? Do they not have their own home, I wonder, / the people of this small hamlet who stay painfully, / where the pure white waterfall descending from the mountain / flows down by the useless huts?","translation":"In the lord's land, many bright red glory lilies bloom together on the very top of the large rock in the common ground, resembling the spotted face of an elephant that has fought in battle. Whether he is a man of virtue or not, are we his only support? Do they not have a home of their own, I wonder—the people of this small hamlet who live in distress, where the pure white waterfall descending from the mountain flows past their useless huts?","modern":"போரிட்ட யானையின் புள்ளிகள் நிறைந்த முகத்தைப் போல, பொதுமன்றத்தில் உள்ள பெரிய பாறையின் மேல் பலவாகச் சேர்ந்து பிரகாசமான செங்காந்தள் மலர்கள் மலரும் நாட்டை உடையவன் தலைவன். அவன் அறநெறி உடையவனோ அல்லது இல்லாதவனோ, நாம் மட்டும்தான் அவனுக்குப் பற்றுக்கோடா? மலைமேலிருந்து வீழ்ந்து, வீணான குடிசைகளின் வழியே பாயும் தூய வெள்ளருவி கொண்ட இந்தச் சிறிய குடியில் துன்பத்துடன் வாழும் மக்களுக்குத் சொந்தமாக வீடு இல்லையோ?","explanation":"The speaker is the heroine's confidante (tōḻi) speaking to the heroine in a tone of frustration about the hero's delay in formalizing their marriage. She describes the hero's mountain land (Kuriñci), where bright red glory lilies bloom on a large rock, looking like the scarred, spotted face of a battle-hardened elephant. The confidante questions whether the hero is truly virtuous, as he leaves them in anxiety while the villagers of the small hamlet suffer from the loud, rushing waterfall flowing past their humble huts. The image of the glory lily blooming on the rock represents the heroine's love which is visible to everyone, yet the hero remains unmoving. The \"useless huts\" (koṉṉilaik kurampai) and the \"painful stay\" (iṉṉātu irunta) reflect the distress of the heroine and her companions due to the hero's prolonged absence and the gossip of the village.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,1.0],[1.0,1.6],[1.6,2.2],[2.2,2.8],[2.8,3.0],[3.0,3.6],[3.6,4.0],[4.0,4.21],[4.21,4.42],[4.42,5.7],[5.7,6.55],[6.55,6.8],[6.8,7.14],[7.14,7.4],[7.41,7.93],[7.93,8.31],[8.31,8.7],[8.7,9.6],[9.6,9.85],[10.04,10.48],[10.48,10.93],[10.93,11.37],[11.37,11.7],[11.7,12.95],[12.95,13.26],[13.26,13.4],[14.0,14.42],[14.42,15.0],[15.0,15.6],[15.6,15.8]],"female":[[0.0,0.6],[0.6,1.1],[1.1,1.7],[1.7,2.35],[2.35,3.0],[3.0,3.2],[3.2,3.9],[3.9,4.4],[4.4,5.1],[5.1,5.8],[5.8,6.5],[6.5,7.03],[7.03,7.49],[7.49,8.1],[8.1,8.62],[8.62,9.3],[9.3,9.82],[9.82,10.34],[10.34,11.2],[11.2,11.71],[11.71,12.4],[12.46,12.8],[12.8,13.3],[13.3,13.58],[13.58,14.05],[14.05,14.38],[14.38,16.0],[16.0,16.18],[16.18,17.22],[17.4,17.9],[17.9,18.1]]},"sync":[[["பொருத","fought"]],[["யானை","elephant"],["புகர்","spotted"]],[["புகர்","spotted"],["முகம்","face"]],[["கடுப்ப","resembling"]],[["மன்றத்து","of the common ground"]],[["மன்றத்து","of the common ground"],["உறுகல்","large rock"]],[["மீமிசை","upon the very top"],["பலவுடன்","many together"]],[["பலவுடன்","many together"]],[["ஒண்","bright"],["செம்","red"]],[["காந்தள்","glory lily"]],[["அவிழும்","blossoming"]],[["நாடன்","man of the land"]],[["அறவன்","virtuous man"]],[["அறவன்","virtuous man"],["ஆயினும்","even if he is"]],[["அல்லன்","not so"]],[["அல்லன்","not so"],["ஆயினும்","even if he is"]],[["நம்மே","us indeed"]],[["சுவரோ","are we the wall/support?"]],[["தம்மிலர்","those without their own home"]],[["கொல்லோ","I wonder"]],[["வரையிற்",""]],[["றாழ்ந்த",""]],[["வால்வெள்",""]],[["ளருவி",""]],[["கொல்","useless"],["நிலை","standing"]],[["குரம்பையின்","by the hut"]],[["குரம்பையின்","by the hut"],["இழிதரும்","flowing down"]],[["இன்னாது","painfully"]],[["இன்னாது","painfully"],["இருந்த","staying"]],[["சிறு","small"],["குடி","hamlet"]],[["ஓரே","people indeed"]]]}