{"text":"kuruntokai","n":284,"lines":["பொருத யானைப் புகர்முகங் கடுப்ப","மன்றத் துறுகல் மீமிசைப் பலவுடன்","ஒண்செங் காந்தள் அவிழும் நாடன்","அறவ னாயினும் அல்ல னாயினும்","நம்மே சுவரோ தம்மிலர் கொல்லோ","வரையிற் றாழ்ந்த வால்வெள் ளருவி","கொன்னிலைக் குரம்பையி னிழிதரும்","இன்னா திருந்தவிச் சிறுகுடி யோரே"],"tr":["poruta yāṉaip pukarmukaṅ kaṭuppa","maṉṟat tuṟukal mīmicaip palavuṭaṉ","oṇceṅ kāntaḷ aviḻum nāṭaṉ","aṟava ṉāyiṉum alla ṉāyiṉum","nammē cuvarō tammilar kollō","varaiyiṟ ṟāḻnta vālveḷ ḷaruvi","koṉṉilaik kurampaiyi ṉiḻitarum","iṉṉā tiruntavic ciṟukuṭi yōrē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"மிளைவேள் தித்தனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Miḷaivēḷ Tittaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 14, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பொருத","tr":"poruta","foot":"puḷimā","acai":[{"kind":"nirai","text":"பொரு","tr":"poru"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"யானைப்","tr":"yāṉaip","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னைப்","tr":"ṉaip"}]},{"text":"புகர்முகங்","tr":"pukarmukaṅ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"புகர்","tr":"pukar"},{"kind":"nirai","text":"முகங்","tr":"mukaṅ"}]},{"text":"கடுப்ப","tr":"kaṭuppa","foot":"puḷimā","acai":[{"kind":"nirai","text":"கடுப்","tr":"kaṭup"},{"kind":"nēr","text":"ப","tr":"pa"}]}],[{"text":"மன்றத்","tr":"maṉṟat","foot":"tēmā","acai":[{"kind":"nēr","text":"மன்","tr":"maṉ"},{"kind":"nēr","text":"றத்","tr":"ṟat"}]},{"text":"துறுகல்","tr":"tuṟukal","foot":"puḷimā","acai":[{"kind":"nirai","text":"துறு","tr":"tuṟu"},{"kind":"nēr","text":"கல்","tr":"kal"}]},{"text":"மீமிசைப்","tr":"mīmicaip","foot":