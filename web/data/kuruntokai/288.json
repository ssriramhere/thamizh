{"text":"kuruntokai","n":288,"lines":["கறிவளர் அடுக்கத் தாங்கண் முறியருந்து","குரங்கொருங் கிருக்கும் பெருங்க னாடன்","இனிய னாகலி னினத்தி னியன்ற","இன்னா மையினு மினிதோ","இனிதெனப் படூஉம் புத்தே ணாடே"],"tr":["kaṟivaḷar aṭukkat tāṅkaṇ muṟiyaruntu","kuraṅkoruṅ kirukkum peruṅka ṉāṭaṉ","iṉiya ṉākali ṉiṉatti ṉiyaṉṟa","iṉṉā maiyiṉu miṉitō","iṉiteṉap paṭūum puttē ṇāṭē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"கபிலர்","speaker_en":"the heroine (talaivi)","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 5, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கறிவளர்","tr":"kaṟivaḷar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கறி","tr":"kaṟi"},{"kind":"nirai","text":"வளர்","tr":"vaḷar"}]},{"text":"அடுக்கத்","tr":"aṭukkat","foot":"puḷimā","acai":[{"kind":"nirai","text":"அடுக்","tr":"aṭuk"},{"kind":"nēr","text":"கத்","tr":"kat"}]},{"text":"தாங்கண்","tr":"tāṅkaṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"தாங்","tr":"tāṅ"},{"kind":"nēr","text":"கண்","tr":"kaṇ"}]},{"text":"முறியருந்து","tr":"muṟiyaruntu","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"முறி","tr":"muṟi"},{"kind":"nirai","text":"யருந்","tr":"yarun"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"குரங்கொருங்","tr":"kuraṅkoruṅ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குரங்","tr":"kuraṅ"},{"kind":"nirai","text":"கொருங்","tr":"koruṅ"}]},{"text":"கிருக்கும்","tr":"kirukkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிருக்","tr":"kiruk"},{"kind":"nēr","text":"கும்","tr":"kum"}]},{"text":"பெருங்க","tr":"peruṅka","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெருங்","tr":"peruṅ"},{"kind":"nēr","text":"க","tr":"ka"}]},{"text":"னாடன்","tr":