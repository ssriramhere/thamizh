{"text":"kuruntokai","n":392,"lines":["அம்ம வாழியோ அணிச்சிறைத் தும்பி","நன்மொழிக் கச்ச மில்லை யவர்நாட்","டண்ணல் நெடுவரைச் சேறி யாயிற்","கடமை மிடைந்த துடவையஞ் சிறுதினைத்","துளரெறி நுண்டுகட் களைஞர் தங்கை","தமரின் தீராள் என்மோ அரசர்","நிரைசெல னுண்டோல் போலப்","பிரசந் தூங்கு மலைகிழ வோர்க்கே"],"tr":["amma vāḻiyō aṇicciṟait tumpi","naṉmoḻik kacca millai yavarnāṭ","ṭaṇṇal neṭuvaraic cēṟi yāyiṟ","kaṭamai miṭainta tuṭavaiyañ ciṟutiṉait","tuḷareṟi nuṇṭukaṭ kaḷaiñar taṅkai","tamariṉ tīrāḷ eṉmō aracar","niraicela ṉuṇṭōl pōlap","piracan tūṅku malaikiḻa vōrkkē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"தும்பிசேர் கீரனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Tumpicēr Kīraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 16, āciriyattaḷai 13, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அம்ம","tr":"amma","foot":"tēmā","acai":[{"kind":"nēr","text":"அம்","tr":"am"},{"kind":"nēr","text":"ம","tr":"ma"}]},{"text":"வாழியோ","tr":"vāḻiyō","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nirai","text":"ழியோ","tr":"ḻiyō"}]},{"text":"அணிச்சிறைத்","tr":"aṇicciṟait","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அணிச்","tr":"aṇic"},{"kind":"nirai","text":"சிறைத்","tr":"ciṟait"}]},{"text":"தும்பி","tr":"tumpi","foot":"tēmā","acai":[{"kind":"nēr","text":"தும்","tr":"tum"},{"kind":"nēr","text":"பி","tr":"pi"}]}],[{"text":"நன்மொழிக்","tr":"naṉmoḻik","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நன்","tr":"naṉ"},{"kind":"nirai","text":"மொழிக்","tr":"moḻik"}]},{"text":"கச்ச","tr":"kacca","foot":"tēmā","acai":[{"kind":"nēr","text":"கச்","tr":"kac"},{"kind":"nēr","text":"ச","tr":"ca"}]},{"text":"மில்லை","tr":"millai","foot":"tēmā","acai":[{"kin