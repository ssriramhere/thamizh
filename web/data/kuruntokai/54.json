{"text":"kuruntokai","n":54,"lines":["யானே யீண்டை யேனே யென்னலனே","ஏனல் காவலர் கவணொலி வெரீஇக்","கான யானை கைவிடு பசுங்கழை","மீனெறி தூண்டிலி னிவக்கும்","கானக நாடனொ டாண்டொழிந் தன்றே"],"tr":["yāṉē yīṇṭai yēṉē yeṉṉalaṉē","ēṉal kāvalar kavaṇoli verīik","kāṉa yāṉai kaiviṭu pacuṅkaḻai","mīṉeṟi tūṇṭili ṉivakkum","kāṉaka nāṭaṉo ṭāṇṭoḻin taṉṟē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"மீனெறிதூண்டிலார்","speaker_en":"the heroine (talaivi)","poet_tr":"Mīṉeṟitūṇṭilār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 6"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"யானே","tr":"yāṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னே","tr":"ṉē"}]},{"text":"யீண்டை","tr":"yīṇṭai","foot":"tēmā","acai":[{"kind":"nēr","text":"யீண்","tr":"yīṇ"},{"kind":"nēr","text":"டை","tr":"ṭai"}]},{"text":"யேனே","tr":"yēṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"யே","tr":"yē"},{"kind":"nēr","text":"னே","tr":"ṉē"}]},{"text":"யென்னலனே","tr":"yeṉṉalaṉē","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"யென்","tr":"yeṉ"},{"kind":"nirai","text":"னல","tr":"ṉala"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}],[{"text":"ஏனல்","tr":"ēṉal","foot":"tēmā","acai":[{"kind":"nēr","text":"ஏ","tr":"ē"},{"kind":"nēr","text":"னல்","tr":"ṉal"}]},{"text":"காவலர்","tr":"kāvalar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"வலர்","tr":"valar"}]},{"text":"கவணொலி","tr":"kavaṇoli","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கவ","tr":"kava"},{"kind":"nirai","text":"ணொலி","tr":"ṇoli"}]},{"text":"வெரீஇக்","tr":"verīik","foot":"puḷimā","acai":[{"kind":"nirai","text":"வெரீ","tr":"verī"},{"kind":"nēr","text":"இக்","tr":"ik"}]}],[