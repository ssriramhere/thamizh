{"text":"kuruntokai","n":244,"lines":["பல்லோர் துஞ்சு நள்ளென் யாமத்","துரவுக்களிறு போல்வந் திரவுக்கதவு முயறல்","கேளே மல்லேங் கேட்டனெம் பெரும","ஓரி முருங்கப் பீலி சாய","நன்மயில் வலைப்பட் டாங்கியாம்","உயங்குதொறு முயங்கும் அறனில் யாயே"],"tr":["pallōr tuñcu naḷḷeṉ yāmat","turavukkaḷiṟu pōlvan tiravukkatavu muyaṟal","kēḷē mallēṅ kēṭṭaṉem peruma","ōri muruṅkap pīli cāya","naṉmayil valaippaṭ ṭāṅkiyām","uyaṅkutoṟu muyaṅkum aṟaṉil yāyē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"கண்ணனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kaṇṇaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 20, other 2, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 4, ? 2, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பல்லோர்","tr":"pallōr","foot":"tēmā","acai":[{"kind":"nēr","text":"பல்","tr":"pal"},{"kind":"nēr","text":"லோர்","tr":"lōr"}]},{"text":"துஞ்சு","tr":"tuñcu","foot":"tēmā","acai":[{"kind":"nēr","text":"துஞ்","tr":"tuñ"},{"kind":"nēr","text":"சு","tr":"cu"}]},{"text":"நள்ளென்","tr":"naḷḷeṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"நள்","tr":"naḷ"},{"kind":"nēr","text":"ளென்","tr":"ḷeṉ"}]},{"text":"யாமத்","tr":"yāmat","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"மத்","tr":"mat"}]}],[{"text":"துரவுக்களிறு","tr":"turavukkaḷiṟu","foot":"?","acai":[{"kind":"nirai","text":"துர","tr":"tura"},{"kind":"nēr","text":"வுக்","tr":"vuk"},{"kind":"nirai","text":"களி","tr":"kaḷi"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"போல்வந்","tr":"pōlvan","foot":"tēmā","acai":[{"kind":"nēr","text":"போல்","tr":"pōl"},{"kind":"nēr","text":"வந்","tr":"van"}]},{"text":"திரவுக்கதவு","tr":"tiravukkatavu","foot":"?","acai":[{"kind":"nirai","text":"திர","tr":"tira"},{"kind":"nēr","tex