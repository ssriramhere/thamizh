ai":[{"kind":"nirai","text":"முயங்","tr":"muyaṅ"},{"kind":"nēr","text":"கும்","tr":"kum"}]},{"text":"அறனில்","tr":"aṟaṉil","foot":"puḷimā","acai":[{"kind":"nirai","text":"அற","tr":"aṟa"},{"kind":"nēr","text":"னில்","tr":"ṉil"}]},{"text":"யாயே","tr":"yāyē","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"யே","tr":"yē"}]}]]},"ai":{"lines":[{"words":[{"surface":"பல்லோர்","parts":[{"text":"பல்லோர்","lemma":"பல்லோர்","gloss":"many people"}],"gloss":"many people"},{"surface":"துஞ்சு","parts":[{"text":"துஞ்சு","lemma":"துஞ்சு","gloss":"sleep"}],"gloss":"sleeping"},{"surface":"நள்","parts":[{"text":"நள்","lemma":"நள்","gloss":"middle"}],"gloss":"middle"},{"surface":"என்","parts":[{"text":"என்","lemma":"என்","gloss":"say/sound"}],"gloss":"sounding"},{"surface":"யாமத்","parts":[{"text":"யாமத்","lemma":"யாமம்","gloss":"midnight"}],"gloss":"at midnight"}]},{"words":[{"surface":"துரவுக்களிறு","parts":[{"text":"துரவுக்களிறு","lemma":"உரவுக்களிறு","gloss":"strong male elephant"}],"gloss":"like a strong male elephant"},{"surface":"போல்","parts":[{"text":"போல்","lemma":"போல்","gloss":"like"}],"gloss":"like"},{"surface":"வந்து","parts":[{"text":"வந்து","lemma":"வா","gloss":"come"}],"gloss":"having come"},{"surface":"இரவு","parts":[{"text":"இரவு","lemma":"இரவு","gloss":"night"}],"gloss":"at night"},{"surface":"கதவு","parts":[{"text":"கதவு","lemma":"கதவு","gloss":"door"}],"gloss":"the door"},{"surface":"முயறல்","parts":[{"text":"முயறல்","lemma":"முயல்","gloss":"try/effort"}],"gloss":"trying to open"}]},{"words":[{"surface":"கேளேம்","parts":[{"text":"கேளேம்","lemma":"கேள்","gloss":"we did not hear"}],"gloss":"we did not hear"},{"surface":"அல்லேம்","parts":[{"text":"அல்லேம்","lemma":"அல்","gloss":"we are not"}],"gloss":"we are not those who did not (i.e., we did hear)"},{"surface":"கேட்டனெம்","parts":[{"text":"கேட்டனெம்","lemma":"கேள்","gloss":"we heard"}],"gloss":"we heard indeed"},{"surface":"பெரும","parts":[{"text":"பெரும","lemma":"பெருமன்","gloss":"lord/great one"}],"gloss":"O Lord"}]},{"words":[{"surface":"ஓரி","parts":[{"text":"ஓரி","lemma":"ஓரி","gloss":"hair/crest"}],"gloss":"the crest"},{"surface":"முருங்க","parts":[{"text":"முருங்க","lemma":"முருங்கு","gloss":"to break/be ruined"}],"gloss":"to break"},{"surface":"பீலி","parts":[{"text":"பீலி","lemma":"பீலி","gloss":"peacock feather"}],"gloss":"the feathers"},{"surface":"சாய","parts":[{"text":"சாய","lemma":"சாய்","gloss":"to droop/wilt"}],"gloss":"to droop"}]},{"words":[{"surface":"நன்மயில்","parts":[{"text":"நன்மயில்","lemma":"நன்மயில்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"வலைப்பட்","parts":[{"text":"வலைப்பட்","lemma":"வலைப்பட்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"டாங்கியாம்","parts":[{"text":"டாங்கியாம்","lemma":"டாங்கியாம்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"உயங்குதொறும்","parts":[{"text":"உயங்கு","lemma":"உயங்கு","gloss":"languish/suffer"},{"text":"தொறும்","lemma":"தொறும்","gloss":"every time"}],"gloss":"whenever we languish"},{"surface":"முயங்கும்","parts":[{"text":"முயங்கும்","lemma":"முயங்கு","gloss":"embracing/holding close"}],"gloss":"who holds us close"},{"surface":"அறன்","parts":[{"text":"அறன்","lemma":"அறம்","gloss":"virtue"}],"gloss":"virtue"},{"surface":"இல்","parts":[{"text":"இல்","lemma":"இல்","gloss":"without"}],"gloss":"without"},{"surface":"யாயே","parts":[{"text":"யாய்","lemma":"யாய்","gloss":"my mother"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"our mother indeed"}]}],"literal":"Many people sleeping in the dark sounding midnight / like a strong male elephant coming and trying the night-door / we did not fail to hear, we heard, O Lord! / As the crest breaks and the feathers droop / like a beautiful peacock caught in a net, we / whenever we languish, she also languishes, our mother who is without virtue.","translation":"At the dead of night when many are asleep, you come like a strong male elephant and shake our door. We did not fail to hear it, O Lord, we heard it indeed! But like a beautiful peacock caught in a net, its crest broken and its feathers drooping, whenever we languish, she also languishes—our mother, who has no virtue.","modern":"பலரும் தூங்குகின்ற நள்ளிரவில், வலிமையான ஆண் யானையைப் போல நீ வந்து இரவில் கதவைத் தட்டும் ஓசையை நாங்கள் கேட்காமல் இல்லை; கேட்டோம் தலைவனே! ஆனால், கொண்டை சிதையவும் தோகைகள் சோரவும் வலைக்குள் அகப்பட்டுக் கொண்ட நல்ல மயிலைப் போல, நாங்கள் வருந்தும் போதெல்லாம் எங்களோடு சேர்ந்து வருந்துகிறாள், அறநெறி இல்லாத எங்கள் தாய்.","explanation":"The friend (தோழி) speaks to the hero (தலைவன்) who has arrived for a secret night-meeting (இரவுக்குறி). She tells him that they heard him trying to open the door in the middle of the night, sounding like a powerful elephant. However, they cannot come out to meet him because of the mother's constant vigilance. The mother is described as 'virtueless' (அறனில் யாய்) because she does not understand their love, yet she is so closely attached to the heroine that whenever the heroine suffers, the mother suffers too, keeping her constantly close like a peacock trapped in a net. This Kuriñci poem beautifully uses the image of the trapped peacock to convey the heroine's confinement and the impossibility of their secret meetings, urging the hero to seek a formal marriage.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,1.1],[1.1,1.2],[1.2,1.8],[1.95,2.8],[2.8,3.48],[3.48,4.1],[4.1,4.5],[4.5,5.22],[5.22,5.22],[5.22,6.3],[6.3,6.3],[6.3,6.3],[6.3,6.3],[6.3,8.4],[8.4,8.6],[8.6,9.9],[9.9,10.04],[10.19,11.01],[11.13,11.77],[11.8,12.4],[12.4,12.5],[12.5,13.0]],"female":[[0.0,0.6],[0.6,1.0],[1.0,1.1],[1.1,2.53],[2.53,3.1],[3.1,3.64],[3.64,4.4],[4.4,4.8],[4.8,5.2],[5.2,5.4],[5.4,6.6],[6.6,6.93],[6.93,7.0],[7.0,7.0],[7.0,7.0],[7.0,7.0],[7.0,9.8],[9.8,10.08],[10.35,10.9],[10.9,11.9],[11.9,12.3],[12.3,12.4],[12.4,12.9]]}}