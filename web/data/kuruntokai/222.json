{"text":"kuruntokai","n":222,"lines":["தலைப்புணைக் கொளினே தலைப்புணைக் கொள்ளும்","கடைப்புணைக் கொளினே கடைப்புணைக் கொள்ளும்","புணைகை விட்டுப் புனலோ டொழுகின்","ஆண்டும் வருகுவள் போலு மாண்ட","மாரிப் பித்திகத்து நீர்வார் கொழுமுகைச்","செவ்வெரி நுறழும் கொழுங்கடை மழைக்கட்","டுளிதலைத் தலைஇய தளிரன் னோளே"],"tr":["talaippuṇaik koḷiṉē talaippuṇaik koḷḷum","kaṭaippuṇaik koḷiṉē kaṭaippuṇaik koḷḷum","puṇaikai viṭṭup puṉalō ṭoḻukiṉ","āṇṭum varukuvaḷ pōlu māṇṭa","mārip pittikattu nīrvār koḻumukaic","cevveri nuṟaḻum koḻuṅkaṭai maḻaikkaṭ","ṭuḷitalait talaiiya taḷiraṉ ṉōḷē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"சிறைக்குடி யாந்தையார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Ciṟaikkuṭi Yāntaiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"7×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 15, āciriyattaḷai 12"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"தலைப்புணைக்","tr":"talaippuṇaik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தலைப்","tr":"talaip"},{"kind":"nirai","text":"புணைக்","tr":"puṇaik"}]},{"text":"கொளினே","tr":"koḷiṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"கொளி","tr":"koḷi"},{"kind":"nēr","text":"னே","tr":"ṉē"}]},{"text":"தலைப்புணைக்","tr":"talaippuṇaik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தலைப்","tr":"talaip"},{"kind":"nirai","text":"புணைக்","tr":"puṇaik"}]},{"text":"கொள்ளும்","tr":"koḷḷum","foot":"tēmā","acai":[{"kind":"nēr","text":"கொள்","tr":"koḷ"},{"kind":"nēr","text":"ளும்","tr":"ḷum"}]}],[{"text":"கடைப்புணைக்","tr":"kaṭaippuṇaik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கடைப்","tr":"kaṭaip"},{"kind":"nirai","text":"புணைக்","tr":"puṇaik"}]},{"text":"கொளினே","tr":"koḷiṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"கொளி","tr":"koḷi"},{"kind":"nēr","text":