{"text":"kuruntokai","n":311,"lines":["அலர்யாங் கொழிவ தோழி பெருங்கடற்","புலவுநா றகன்றுறை வலவன் தாங்கவும்","நில்லாது கழிந்த கல்லென் கடுந்தேர்","யான்கண் டனனோ இலனோ பானாள்","ஓங்கல் வெண்மணல் தாழ்ந்த புன்னைத்","தாதுசேர் நிகர்மலர் கொய்யும்","ஆயம் எல்லாம் உடன்கண் டன்றே"],"tr":["alaryāṅ koḻiva tōḻi peruṅkaṭaṟ","pulavunā ṟakaṉṟuṟai valavaṉ tāṅkavum","nillātu kaḻinta kalleṉ kaṭuntēr","yāṉkaṇ ṭaṉaṉō ilaṉō pāṉāḷ","ōṅkal veṇmaṇal tāḻnta puṉṉait","tātucēr nikarmalar koyyum","āyam ellām uṭaṉkaṇ ṭaṉṟē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"சேந்தன் கீரனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Cēntaṉ Kīraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 9, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அலர்யாங்","tr":"alaryāṅ","foot":"puḷimā","acai":[{"kind":"nirai","text":"அலர்","tr":"alar"},{"kind":"nēr","text":"யாங்","tr":"yāṅ"}]},{"text":"கொழிவ","tr":"koḻiva","foot":"puḷimā","acai":[{"kind":"nirai","text":"கொழி","tr":"koḻi"},{"kind":"nēr","text":"வ","tr":"va"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"பெருங்கடற்","tr":"peruṅkaṭaṟ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெருங்","tr":"peruṅ"},{"kind":"nirai","text":"கடற்","tr":"kaṭaṟ"}]}],[{"text":"புலவுநா","tr":"pulavunā","foot":"karuviḷam","acai":[{"kind":"nirai","text":"புல","tr":"pula"},{"kind":"nirai","text":"வுநா","tr":"vunā"}]},{"text":"றகன்றுறை","tr":"ṟakaṉṟuṟai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"றகன்","tr":"ṟakaṉ"},{"kind":"nirai","text":"றுறை","tr":"ṟuṟai"}]},{"text":"வலவன்","tr":"valavaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"வல","tr":"