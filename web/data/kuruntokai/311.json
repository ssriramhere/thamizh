:"துசேர்","tr":"tucēr"}]},{"text":"நிகர்மலர்","tr":"nikarmalar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நிகர்","tr":"nikar"},{"kind":"nirai","text":"மலர்","tr":"malar"}]},{"text":"கொய்யும்","tr":"koyyum","foot":"tēmā","acai":[{"kind":"nēr","text":"கொய்","tr":"koy"},{"kind":"nēr","text":"யும்","tr":"yum"}]}],[{"text":"ஆயம்","tr":"āyam","foot":"tēmā","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nēr","text":"யம்","tr":"yam"}]},{"text":"எல்லாம்","tr":"ellām","foot":"tēmā","acai":[{"kind":"nēr","text":"எல்","tr":"el"},{"kind":"nēr","text":"லாம்","tr":"lām"}]},{"text":"உடன்கண்","tr":"uṭaṉkaṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"உடன்","tr":"uṭaṉ"},{"kind":"nēr","text":"கண்","tr":"kaṇ"}]},{"text":"டன்றே","tr":"ṭaṉṟē","foot":"tēmā","acai":[{"kind":"nēr","text":"டன்","tr":"ṭaṉ"},{"kind":"nēr","text":"றே","tr":"ṟē"}]}]]},"ai":{"lines":[{"words":[{"surface":"அலர்","parts":[{"text":"அலர்","lemma":"alar","gloss":"gossip"}],"gloss":"gossip"},{"surface":"யாங்கு","parts":[{"text":"யாங்கு","lemma":"yāṅku","gloss":"how"}],"gloss":"how"},{"surface":"ஒழிவ","parts":[{"text":"ஒழி","lemma":"oḻi","gloss":"cease"},{"text":"வ","lemma":"va","gloss":"neuter plural future suffix"}],"gloss":"will cease"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"tōḻi","gloss":"female friend"}],"gloss":"friend"},{"surface":"பெருங்கடல்","parts":[{"text":"பெருமை","lemma":"perumai","gloss":"greatness"},{"text":"கடல்","lemma":"kaṭal","gloss":"ocean"}],"gloss":"great ocean"}]},{"words":[{"surface":"புலவுநா","parts":[{"text":"புலவுநா","lemma":"புலவுநா","gloss":""}],"gloss":"","split_unverified":true},{"surface":"றகன்றுறை","parts":[{"text":"றகன்றுறை","lemma":"றகன்றுறை","gloss":""}],"gloss":"","split_unverified":true},{"surface":"வலவன்","parts":[{"text":"வலவன்","lemma":"வலவன்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தாங்கவும்","parts":[{"text":"தாங்கவும்","lemma":"தாங்கவும்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"நில்லாது","parts":[{"text":"நில்","lemma":"nil","gloss":"stop"},{"text":"ஆது","lemma":"ātu","gloss":"without"}],"gloss":"without stopping"},{"surface":"கழிந்த","parts":[{"text":"கழி","lemma":"kaḻi","gloss":"pass by"},{"text":"ந்த","lemma":"nta","gloss":"past adjectival suffix"}],"gloss":"passed by"},{"surface":"கல்","parts":[{"text":"கல்","lemma":"kal","gloss":"sound"}],"gloss":"sound"},{"surface":"என்","parts":[{"text":"என்","lemma":"eṉ","gloss":"making"}],"gloss":"making sound"},{"surface":"கடுந்தேர்","parts":[{"text":"கடுமை","lemma":"kaṭumai","gloss":"swiftness"},{"text":"தேர்","lemma":"tēr","gloss":"chariot"}],"gloss":"swift chariot"}]},{"words":[{"surface":"யான்","parts":[{"text":"யான்","lemma":"yāṉ","gloss":"I"}],"gloss":"I"},{"surface":"கண்டனனோ","parts":[{"text":"கண்டனனோ","lemma":"கண்டனனோ","gloss":"did I see?"}],"gloss":"did I see?","split_unverified":true},{"surface":"இலனோ","parts":[{"text":"இலனோ","lemma":"இலனோ","gloss":"or did I not?"}],"gloss":"or did I not?","split_unverified":true},{"surface":"பானாள்","parts":[{"text":"பானாள்","lemma":"பானாள்","gloss":"midnight"}],"gloss":"midnight","split_unverified":true}]},{"words":[{"surface":"ஓங்கல்","parts":[{"text":"ஓங்கு","lemma":"ōṅku","gloss":"rise"},{"text":"அல்","lemma":"al","gloss":"verbal noun suffix"}],"gloss":"rising"},{"surface":"வெண்மணல்","parts":[{"text":"வெண்மை","lemma":"veṇmai","gloss":"whiteness"},{"text":"மணல்","lemma":"maṇal","gloss":"sand"}],"gloss":"white sand"},{"surface":"தாழ்ந்த","parts":[{"text":"தாழ்","lemma":"tāḻ","gloss":"bow down"},{"text":"ந்த","lemma":"nta","gloss":"past adjectival suffix"}],"gloss":"low-hanging"},{"surface":"புன்னைத்","parts":[{"text":"புன்னைத்","lemma":"புன்னைத்","gloss":"mastwood tree"}],"gloss":"mastwood tree","split_unverified":true}]},{"words":[{"surface":"தாது","parts":[{"text":"தாது","lemma":"tātu","gloss":"pollen"}],"gloss":"pollen"},{"surface":"சேர்","parts":[{"text":"சேர்","lemma":"cēr","gloss":"join"}],"gloss":"filled"},{"surface":"நிகர்","parts":[{"text":"நிகர்","lemma":"nikar","gloss":"match"}],"gloss":"matching"},{"surface":"மலர்","parts":[{"text":"மலர்","lemma":"malar","gloss":"flower"}],"gloss":"flowers"},{"surface":"கொய்யும்","parts":[{"text":"கொய்","lemma":"koy","gloss":"pluck"},{"text":"உம்","lemma":"um","gloss":"adjectival participle suffix"}],"gloss":"gathering"}]},{"words":[{"surface":"ஆயம்","parts":[{"text":"ஆயம்","lemma":"āyam","gloss":"group of female friends"}],"gloss":"playmates"},{"surface":"எல்லாம்","parts":[{"text":"எல்லாம்","lemma":"ellām","gloss":"all"}],"gloss":"all"},{"surface":"உடன்","parts":[{"text":"உடன்","lemma":"uṭaṉ","gloss":"together"}],"gloss":"together"},{"surface":"கண்டன்றே","parts":[{"text":"கண்டன்றே","lemma":"கண்டன்றே","gloss":"saw indeed"}],"gloss":"saw indeed","split_unverified":true}]}],"literal":"How will the gossip cease, my friend? The great ocean's / fish-smelling wide shore, even though the charioteer restrained [them], / without stopping, passed by, the noisy swift chariot, / did I see [it] or did I not see [it] at midnight? / On the rising white sand, of the low-hanging punnai tree, / pollen-filled, matching flowers gathering / my playmates all together saw [it]!","translation":"How will the gossip ever cease, my friend? Even though the charioteer tried to restrain them, the horses of his noisy, swift chariot did not stop but sped past the wide, fish-smelling shore of the great ocean. Did I see it or did I not, in the middle of the night? But my playmates, who were gathering the pollen-rich, bright flowers of the low-hanging punnai tree on the high white sand dunes, all saw it together!","modern":"தோழியே! அலர் (வதந்தி) எவ்வாறு அடங்கும்? பெரிய கடலின் புலால் நாற்றமுடைய அகன்ற துறையில், பாகன் தடுத்து நிறுத்த முயன்றபோதிலும், நில்லாமல் விரைந்து சென்ற அந்த ஒலியெழுப்பும் கடிய தேர்ச் சக்கரங்களை நள்ளிரவில் நான் கண்டேனா இல்லையா? ஆனால், உயர்ந்த வெண்மணல் பரப்பில் தாழ்ந்த புன்னை மரத்தின் தாதுக்கள் நிறைந்த மலர்களைக் கொய்து கொண்டிருந்த என் தோழியர் கூட்டம் முழுவதும் அதனை ஒருசேரக் கண்டுவிட்டதே!","explanation":"This poem is set in the neytal (coastal) landscape, where the heroine speaks to her confidante about the growing gossip in the village. The hero has been visiting her secretly at night in his swift chariot, but now his visits have become known. Even though the charioteer tried to restrain the horses, the loud chariot sped along the shore, making its presence obvious. The heroine wonders if she herself actually witnessed the chariot in the dark of the night, but she is certain that her playmates, who were gathering flowers from the low-hanging punnai trees on the sand dunes, saw it clearly. This collective sighting by her friends means the secret of their love is now out, and the resulting gossip cannot be stopped unless the hero marries her.","model":"gemini-3.5-flash"}}