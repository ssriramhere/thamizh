{"text":"kuruntokai","n":213,"lines":["நசைநன் குடையர் தோழி ஞெரேரெனக்","கவைத்தலை முதுகலை காலின் ஒற்றிப்","பசிப்பிணிக் கிறைஞ்சிய பரூஉம்பெருந் ததரல்","ஒழியின் உண்டு வழுவி னெஞ்சிற்","றெறித்துநடை மரபிற்றன் மறிக்குநிழ லாகி","நின்றுவெயில் கழிக்கு மென்பநம்","இன்றுயில் முனிநர் சென்ற வாறே"],"tr":["nacainaṉ kuṭaiyar tōḻi ñerēreṉak","kavaittalai mutukalai kāliṉ oṟṟip","pacippiṇik kiṟaiñciya parūumperun tataral","oḻiyiṉ uṇṭu vaḻuvi ṉeñciṟ","ṟeṟittunaṭai marapiṟṟaṉ maṟikkuniḻa lāki","niṉṟuveyil kaḻikku meṉpanam","iṉṟuyil muṉinar ceṉṟa vāṟē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"கச்சிப்பேட்டுக் காஞ்சிக் கொற்றனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kaccippēṭṭuk Kāñcik Koṟṟaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 4, vañcicīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 9, kalittaḷai 3, oṉṟiya vañcittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நசைநன்","tr":"nacainaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"நசை","tr":"nacai"},{"kind":"nēr","text":"நன்","tr":"naṉ"}]},{"text":"குடையர்","tr":"kuṭaiyar","foot":"puḷimā","acai":[{"kind":"nirai","text":"குடை","tr":"kuṭai"},{"kind":"nēr","text":"யர்","tr":"yar"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"ஞெரேரெனக்","tr":"ñerēreṉak","foot":"karuviḷam","acai":[{"kind":"nirai","text":"ஞெரே","tr":"ñerē"},{"kind":"nirai","text":"ரெனக்","tr":"reṉak"}]}],[{"text":"கவைத்தலை","tr":"kavaittalai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கவைத்","tr":"kavait"},{"kind":"nirai","text":"தலை","tr":"talai"}]},{"text":"முதுகலை","tr":"mutukalai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"முது","tr":"mutu"},{"kind":"nirai","text":"கலை"