"தலை","lemma":"தலை","gloss":"head"}],"gloss":"head"},{"surface":"முது","parts":[{"text":"முது","lemma":"முதுமை","gloss":"old"}],"gloss":"old"},{"surface":"கலை","parts":[{"text":"கலை","lemma":"கலை","gloss":"buck/male deer"}],"gloss":"male deer"},{"surface":"காலின்","parts":[{"text":"கால்","lemma":"கால்","gloss":"leg/foot"},{"text":"இன்","lemma":"இன்","gloss":"instrumental suffix"}],"gloss":"with the foot"},{"surface":"ஒற்றி","parts":[{"text":"ஒற்று","lemma":"ஒற்று","gloss":"press/scrape"},{"text":"இ","lemma":"இ","gloss":"past participle suffix"}],"gloss":"having scraped"}]},{"words":[{"surface":"பசி","parts":[{"text":"பசி","lemma":"பசி","gloss":"hunger"}],"gloss":"hunger"},{"surface":"பிணிக்கு","parts":[{"text":"பிணி","lemma":"பிணி","gloss":"disease/affliction"},{"text":"க்கு","lemma":"கு","gloss":"dative suffix"}],"gloss":"to the affliction"},{"surface":"இறைஞ்சிய","parts":[{"text":"இறைஞ்சு","lemma":"இறைஞ்சு","gloss":"droop/bend"},{"text":"இ","lemma":"இ","gloss":"past tense marker"},{"text":"அ","lemma":"அ","gloss":"relative participle suffix"}],"gloss":"that drooped"},{"surface":"பரூஉம்","parts":[{"text":"பரூஉம்","lemma":"பருமை","gloss":"thick"}],"gloss":"thick"},{"surface":"பெரும்","parts":[{"text":"பெரும்","lemma":"பெரும்","gloss":"big"}],"gloss":"big","split_unverified":true},{"surface":"ததரல்","parts":[{"text":"ததரல்","lemma":"ததரல்","gloss":"shrub/bush"}],"gloss":"shrub"}]},{"words":[{"surface":"ஒழியின்","parts":[{"text":"ஒழி","lemma":"ஒழி","gloss":"remain/be left"},{"text":"இன்","lemma":"இன்","gloss":"conditional suffix"}],"gloss":"if it remains"},{"surface":"உண்டு","parts":[{"text":"உண்","lemma":"உண்","gloss":"eat"},{"text":"து","lemma":"து","gloss":"past participle suffix"}],"gloss":"having eaten"},{"surface":"வழுவின்","parts":[{"text":"வழுவு","lemma":"வழுவு","gloss":"fail/be lacking"},{"text":"இன்","lemma":"இன்","gloss":"conditional suffix"}],"gloss":"if it is lacking"},{"surface":"நெஞ்சின்","parts":[{"text":"நெஞ்சு","lemma":"நெஞ்சு","gloss":"heart/mind"},{"text":"இன்","lemma":"இன்","gloss":"instrumental suffix"}],"gloss":"with a pitying heart"}]},{"words":[{"surface":"றெறித்துநடை","parts":[{"text":"றெறித்துநடை","lemma":"றெறித்துநடை","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மரபிற்றன்","parts":[{"text":"மரபிற்றன்","lemma":"மரபிற்றன்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மறிக்குநிழ","parts":[{"text":"மறிக்குநிழ","lemma":"மறிக்குநிழ","gloss":""}],"gloss":"","split_unverified":true},{"surface":"லாகி","parts":[{"text":"லாகி","lemma":"லாகி","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"நின்று","parts":[{"text":"நின்று","lemma":"நின்று","gloss":"having stood"}],"gloss":"having stood","split_unverified":true},{"surface":"வெயில்","parts":[{"text":"வெயில்","lemma":"வெயில்","gloss":"heat of the sun"}],"gloss":"sun's heat"},{"surface":"கழிக்கும்","parts":[{"text":"கழி","lemma":"கழி","gloss":"pass/spend"},{"text":"க்","lemma":"க்","gloss":"increment"},{"text":"உம்","lemma":"உம்","gloss":"habitual relative participle suffix"}],"gloss":"which passes/spends"},{"surface":"என்ப","parts":[{"text":"என்","lemma":"என்","gloss":"say"},{"text":"ப","lemma":"ப","gloss":"they"}],"gloss":"they say"},{"surface":"நம்","parts":[{"text":"நம்","lemma":"நாம்","gloss":"our"}],"gloss":"our"}]},{"words":[{"surface":"இன்றுயில்","parts":[{"text":"இன்","lemma":"இனிமை","gloss":"sweet"},{"text":"துயில்","lemma":"துயில்","gloss":"sleep"}],"gloss":"sweet sleep"},{"surface":"முனிநர்","parts":[{"text":"முனி","lemma":"முனி","gloss":"dislike/reject"},{"text":"நர்","lemma":"நர்","gloss":"they who"}],"gloss":"those who reject"},{"surface":"சென்ற","parts":[{"text":"சென்ற","lemma":"சென்ற","gloss":"that went"}],"gloss":"that went","split_unverified":true},{"surface":"ஆறே","parts":[{"text":"ஆறு","lemma":"ஆறு","gloss":"path/way"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"the path indeed"}]}],"literal":"He has great love, O friend! Swiftly / with the foot scraping the withered head of the old male deer, / the thick, big tataral shrub that drooped due to the affliction of hunger, / if it remains, having eaten, and if it is lacking, with a pitying heart, / becoming the shade for its young one which has the nature of leaping gait, / standing, they say he will pass the sun's heat, our / he who rejected sweet sleep, the path he went.","translation":"O friend, he has great love for you! They say that on the path taken by our lover, who rejected sweet sleep to earn wealth, an old stag scrapes with its hoof the thick, large tataral bush that has withered and drooped from the affliction of hunger. If any green shoot remains, the stag eats it; if nothing is left, with a pitying heart, it stands in the scorching sun, acting as a shade for its young fawn whose nature is to leap and run, thus passing the heat of the day.","modern":"தோழி! அவர் உன் மீது மிகுந்த அன்பு உடையவர். இனிய தூக்கத்தைத் துறந்து பொருள் தேடச் சென்ற நம் தலைவர் கடந்து செல்லும் வழியில், பசியால் வாடி வதங்கிய பருத்த பெரிய ததரல் புதரைக் கிழட்டு ஆண் மான் தன் காலால் கீறிப் பார்க்கும். அதில் ஏதேனும் உண்ணக் கிடைத்தால் உண்டுவிட்டு, ஒன்றும் இல்லாதபோது, துள்ளிக் குதிக்கும் இயல்புடைய தன் குட்டிக்குத் தன் உடலையே நிழலாக்கி வெயிலில் நின்று தவிக்கும் என்று கூறுவர்.","explanation":"The friend (tōḻi) is speaking to the heroine (talaivi) to comfort her during the hero's absence. The hero has gone to the dry desert path (pālai) to earn wealth, leaving the heroine in grief. The friend reassures her that the hero will return soon because the sights of the desert will remind him of love and compassion. The poem describes an old stag in the dry desert scraping a withered tataral bush for food. If it finds any, it eats; if not, it stands in the blazing sun to provide shade with its own body for its leaping fawn. This image of parental love and sacrifice in the harsh desert landscape is a subtle hint (uḷḷuṟai) that the hero, witnessing such deep love and care among animals, will be reminded of his love for the heroine and will hasten back to her.","model":"gemini-3.5-flash"}}