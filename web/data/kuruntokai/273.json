ts":[{"text":"தயங்கு","lemma":"tayaṅku","gloss":"to sway/shine"},{"text":"அ","lemma":"a","gloss":"infinitive suffix"}],"gloss":"to sway"}]},{"words":[{"surface":"பெருங்காட்டு","parts":[{"text":"பெருங்காட்டு","lemma":"பெருங்காட்டு","gloss":"of the great forest"}],"gloss":"of the great forest","split_unverified":true},{"surface":"உளரும்","parts":[{"text":"உளர்","lemma":"உளருதல்","gloss":"stir"},{"text":"உம்","lemma":"உம்","gloss":"relative participle suffix"}],"gloss":"that stirs"},{"surface":"அசைவளி","parts":[{"text":"அசை","lemma":"அசைதல்","gloss":"move"},{"text":"வளி","lemma":"வளி","gloss":"wind"}],"gloss":"moving wind"},{"surface":"போல","parts":[{"text":"போல்","lemma":"போலுதல்","gloss":"resemble"},{"text":"அ","lemma":"அ","gloss":"infinitive suffix"}],"gloss":"like"}]},{"words":[{"surface":"தண்ணிய","parts":[{"text":"தண்","lemma":"taṇ","gloss":"cool"},{"text":"இய","lemma":"iya","gloss":"adjectival suffix"}],"gloss":"cool/fragrant"},{"surface":"கமழும்","parts":[{"text":"கமழ்","lemma":"kamaḻ","gloss":"to emit fragrance"},{"text":"உம்","lemma":"um","gloss":"adjectival participle suffix"}],"gloss":"fragrant"},{"surface":"ஒண்ணுதலோயே","parts":[{"text":"ஒள்","lemma":"oḷ","gloss":"bright/beautiful"},{"text":"நுதல்","lemma":"nutal","gloss":"forehead"},{"text":"ஓய்","lemma":"ōy","gloss":"you who have"},{"text":"ஏ","lemma":"ē","gloss":"vocative particle"}],"gloss":"O you with the bright forehead!"}]},{"words":[{"surface":"நொந்தனையாயின்","parts":[{"text":"நொந்தனை","lemma":"nontaṉai","gloss":"you suffered"},{"text":"ஆயின்","lemma":"āyiṉ","gloss":"if"}],"gloss":"if you are in pain"},{"surface":"கண்டது","parts":[{"text":"கண்டது","lemma":"கண்டது","gloss":"that which was seen/truth"}],"gloss":"that which was seen/truth","split_unverified":true},{"surface":"மொழிவல்","parts":[{"text":"மொழி","lemma":"moḻi","gloss":"to speak"},{"text":"வ்","lemma":"v","gloss":"future tense marker"},{"text":"அல்","lemma":"al","gloss":"first person singular suffix"}],"gloss":"I shall speak"}]},{"words":[{"surface":"பெருந்தேன்","parts":[{"text":"பெருந்தேன்","lemma":"பெருந்தேன்","gloss":"large beehive"}],"gloss":"large beehive","split_unverified":true},{"surface":"கண்படு","parts":[{"text":"கண்","lemma":"kaṇ","gloss":"place/joint"},{"text":"படு","lemma":"paṭu","gloss":"to occur/form"}],"gloss":"formed/situated"},{"surface":"வரையின்","parts":[{"text":"வரை","lemma":"varai","gloss":"mountain/slope"},{"text":"இன்","lemma":"iṉ","gloss":"oblique/locative suffix"}],"gloss":"on the mountain slope"},{"surface":"முதுமால்","parts":[{"text":"முது","lemma":"mutu","gloss":"old/ancient"},{"text":"மால்","lemma":"māl","gloss":"delusion/desire"}],"gloss":"great delusion/desire"}]},{"words":[{"surface":"பறியாது","parts":[{"text":"பறி","lemma":"paṟi","gloss":"to pluck/know"},{"text":"ஆது","lemma":"ātu","gloss":"negative participle suffix"}],"gloss":"without knowing/plucking"},{"surface":"ஏறிய","parts":[{"text":"ஏறு","lemma":"ēṟu","gloss":"to climb"},{"text":"இய","lemma":"iya","gloss":"past adjectival suffix"}],"gloss":"who climbed"},{"surface":"மடவோன்","parts":[{"text":"மட","lemma":"maṭa","gloss":"foolishness/ignorance"},{"text":"ஓன்","lemma":"ōṉ","gloss":"masculine singular suffix"}],"gloss":"foolish man"},{"surface":"போல","parts":[{"text":"போல்","lemma":"pōl","gloss":"to resemble"},{"text":"அ","lemma":"a","gloss":"infinitive suffix"}],"gloss":"like/resembling"}]},{"words":[{"surface":"ஏமாந்து","parts":[{"text":"ஏமா","lemma":"ēmā","gloss":"to be bewildered/deluded"},{"text":"ந்து","lemma":"ntu","gloss":"verbal participle suffix"}],"gloss":"having been bewildered"},{"surface":"அன்று","parts":[{"text":"அன்று","lemma":"அன்று","gloss":"it is not"}],"gloss":"it is not","split_unverified":true},{"surface":"இவ்வுலகம்","parts":[{"text":"இவ்வுலகம்","lemma":"இவ்வுலகம்","gloss":"this world"}],"gloss":"this world","split_unverified":true}]},{"words":[{"surface":"நாம்","parts":[{"text":"நாம்","lemma":"நாம்","gloss":"we"}],"gloss":"we"},{"surface":"உளேமாக","parts":[{"text":"உள்","lemma":"உள்","gloss":"exist"},{"text":"ஏம்","lemma":"ஏம்","gloss":"we"},{"text":"ஆக","lemma":"ஆ","gloss":"while"}],"gloss":"while we are here"},{"surface":"பிரியலன்","parts":[{"text":"பிரி","lemma":"பிரி","gloss":"separate"},{"text":"அல்","lemma":"அல்","gloss":"not"},{"text":"அன்","lemma":"அன்","gloss":"he"}],"gloss":"he will not separate"},{"surface":"தௌிமே","parts":[{"text":"தௌி","lemma":"தெளி","gloss":"be clear"},{"text":"மே","lemma":"மே","gloss":"particle"}],"gloss":"be clear!"}]}],"literal":"At the time of evening, when pollen-filled buds sway / like the gentle breeze that stirs the great forest, / O you with the bright forehead who smells cool and fragrant! / If you are in pain, I shall speak of what I have seen. / Like a foolish man who climbed, without knowing, / the great delusion of the mountain slope where large beehives sleep, / this world is not bewildered. / While we are here, he will not separate from us, be assured!","translation":"O girl with the bright forehead, smelling as cool and fragrant as the gentle breeze that stirs the great forest at evening, making the pollen-filled buds sway! If you are in pain, I will tell you what I see. This world is not so foolish as a simpleton who climbs a steep mountain slope where massive beehives hang, without knowing how to get down. He will not leave us while we are here; be assured of this!","modern":"மாலை நேரத்தில், மகரந்தம் நிறைந்த மொட்டுகள் அசையும்படி பெருங்காட்டில் வீசுகின்ற மெல்லிய காற்றைப் போல, குளுமையான நறுமணம் வீசும் ஒளி பொருந்திய நெற்றியை உடையவளே! நீ வருத்தமுற்றால் நான் கண்ட உண்மையைச் சொல்கிறேன். பெரிய தேன்கூடுகள் நிறைந்த மலைச்சரிவில், இறங்கும் வழி அறியாமல் ஏறிய அறிவிலியைப் போல இவ்வுலகம் ஏமாந்து போகாது. நாம் உயிருடன் இருக்கும்போது அவன் நம்மைப் பிரிந்து செல்ல மாட்டான், இதனை உறுதியாக நம்புவாயாக.","explanation":"In this poem, the friend (தோழி) is speaking to the heroine (தலைவி) to comfort her. The hero is planning to depart for wealth through the harsh desert path (பாலை), and the heroine is deeply distressed and anxious about the impending separation. The friend reassures her that the hero will not leave her. She compares the world (or the hero's potential mistake) to a foolish person who climbs a high mountain slope to reach a beehive without knowing how to descend safely. This belongs to the Pālai (desert/separation) landscape, where the dangerous and difficult path represents the risk of losing his beloved. The key words are 'ஒண்ணுதலோயே' (O bright-foreheaded one), 'பிரியலன்' (he will not separate), and 'தெளிமே' (be assured).","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,1.0],[1.0,1.7],[1.7,2.25],[2.25,2.4],[2.4,3.0],[3.0,4.1],[4.1,4.47],[4.47,4.8],[4.8,5.0],[5.2,5.33],[5.73,5.95],[5.95,6.38],[6.38,6.7],[6.7,7.6],[7.6,8.0],[8.0,8.65],[8.65,9.17],[9.17,9.7],[9.7,10.22],[10.22,10.61],[10.61,11.0],[11.0,11.4],[11.4,11.9],[11.9,12.4],[12.4,12.97],[12.97,13.3],[13.47,13.81],[13.99,14.56],[14.62,15.11],[15.11,15.3]],"female":[[0.0,0.45],[0.81,1.15],[1.22,1.8],[1.8,2.58],[2.58,3.37],[3.37,3.5],[3.5,4.4],[4.4,4.53],[4.6,5.6],[5.6,5.8],[5.9,6.4],[6.4,6.78],[6.78,7.53],[7.53,8.0],[8.0,8.9],[8.9,9.2],[9.2,10.3],[11.12,11.6],[11.6,11.8],[11.8,12.21],[12.21,12.52],[12.52,12.83],[12.91,13.3],[13.3,13.7],[13.7,14.53],[14.53,14.7],[14.84,15.4],[15.4,16.3],[16.3,16.6],[16.6,16.9],[16.9,17.2]]},"sync":[[["அல்குறு","diminishing/evening"]],[["பொழுதில்","at the time"]],[["தாதுமுகை","pollen-filled buds"]],[["தயங்க","to sway"]],[["பெருங்காட்டு","of the great forest"]],[["பெருங்காட்டு","of the great forest"],["உளரும்","that stirs"]],[["அசைவளி","moving wind"]],[["போல","like"]],[["தண்ணிய","cool/fragrant"]],[["கமழும்","fragrant"]],[["ஒண்ணுதலோயே","O you with the bright forehead!"]],[["ஒண்ணுதலோயே","O you with the bright forehead!"]],[["நொந்தனையாயின்","if you are in pain"]],[["நொந்தனையாயின்","if you are in pain"]],[["கண்டது","that which was seen/truth"]],[["மொழிவல்","I shall speak"]],[["பெருந்தேன்","large beehive"]],[["கண்படு","formed/situated"]],[["வரையின்","on the mountain slope"]],[["முதுமால்","great delusion/desire"]],[["பறியாது","without knowing/plucking"]],[["பறியாது","without knowing/plucking"],["ஏறிய","who climbed"]],[["மடவோன்","foolish man"]],[["போல","like/resembling"]],[["ஏமாந்து","having been bewildered"]],[["ஏமாந்து","having been bewildered"],["அன்று","it is not"],["இவ்வுலகம்","this world"]],[["இவ்வுலகம்","this world"]],[["நாம்","we"],["உளேமாக","while we are here"]],[["உளேமாக","while we are here"]],[["பிரியலன்","he will not separate"]],[["தௌிமே","be clear!"]]]}