{"text":"kuruntokai","n":273,"lines":["அல்குறு பொழுதில் தாதுமுகை தயங்கப்","பெருங்காட் டுளரும் அசைவளி போலத்","தண்ணிய கமழும் ஒண்ணுத லோயே","நொந்தனை யாயிற் கண்டது மொழிவல்","பெருந்தேன் கண்படு வரையின் முதுமால்","பறியா தேறிய மடவோன் போல","ஏமாந் தன்றிவ் வுலகம்","நாமுளே மாகப் பிரியலன் தௌிமே"],"tr":["alkuṟu poḻutil tātumukai tayaṅkap","peruṅkāṭ ṭuḷarum acaivaḷi pōlat","taṇṇiya kamaḻum oṇṇuta lōyē","nontaṉai yāyiṟ kaṇṭatu moḻival","peruntēṉ kaṇpaṭu varaiyiṉ mutumāl","paṟiyā tēṟiya maṭavōṉ pōla","ēmān taṉṟiv vulakam","nāmuḷē mākap piriyalaṉ taumē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"சிறைக்குடி யாந்தையார்","speaker_en":"her friend (tōḻi)","poet_tr":"Ciṟaikkuṭi Yāntaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 13, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அல்குறு","tr":"alkuṟu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"அல்","tr":"al"},{"kind":"nirai","text":"குறு","tr":"kuṟu"}]},{"text":"பொழுதில்","tr":"poḻutil","foot":"puḷimā","acai":[{"kind":"nirai","text":"பொழு","tr":"poḻu"},{"kind":"nēr","text":"தில்","tr":"til"}]},{"text":"தாதுமுகை","tr":"tātumukai","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nirai","text":"துமு","tr":"tumu"},{"kind":"nēr","text":"கை","tr":"kai"}]},{"text":"தயங்கப்","tr":"tayaṅkap","foot":"puḷimā","acai":[{"kind":"nirai","text":"தயங்","tr":"tayaṅ"},{"kind":"nēr","text":"கப்","tr":"kap"}]}],[{"text":"பெருங்காட்","tr":"peruṅkāṭ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெருங்","tr":"peruṅ"},{"kind":"nēr","text":"காட்","tr":"kāṭ"}]},{"text":"டுளரும்","tr":"ṭuḷarum","foot":"puḷimā","acai":[{"kind":"nirai","text":"டுள","tr":"ṭuḷa"},{"kind":"nēr","text":"ரும்","tr":"rum"}]