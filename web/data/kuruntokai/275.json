{"text":"kuruntokai","n":275,"lines":["முல்லை யூர்ந்த கல்லுய ரேறிக்","கண்டனம் வருகஞ் சென்மோ தோழி","எல்லூர்ச் சேர்தரும் ஏறுடை யினத்துப்","புல்லார் நல்லான் பூண்மணி கொல்லோ","செய்வினை முடித்த செம்ம லுள்ளமொடு","வல்வில் இளையர் பக்கம் போற்ற","ஈர்மணற் காட்டாறு வரூஉம்","தேர்மணி கொல்லாண் டியம்பிய வுளவே"],"tr":["mullai yūrnta kalluya rēṟik","kaṇṭaṉam varukañ ceṉmō tōḻi","ellūrc cērtarum ēṟuṭai yiṉattup","pullār nallāṉ pūṇmaṇi kollō","ceyviṉai muṭitta cemma luḷḷamoṭu","valvil iḷaiyar pakkam pōṟṟa","īrmaṇaṟ kāṭṭāṟu varūum","tērmaṇi kollāṇ ṭiyampiya vuḷavē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தோழி கூற்று","poet_ta":"ஒக்கூர் மாசாத்தியார்","speaker_en":"her friend (tōḻi)","poet_tr":"Okkūr Mācāttiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 29, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 21, veṇṭaḷai 8, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"முல்லை","tr":"mullai","foot":"tēmā","acai":[{"kind":"nēr","text":"முல்","tr":"mul"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"யூர்ந்த","tr":"yūrnta","foot":"tēmā","acai":[{"kind":"nēr","text":"யூர்ந்","tr":"yūrn"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"கல்லுய","tr":"kalluya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கல்","tr":"kal"},{"kind":"nirai","text":"லுய","tr":"luya"}]},{"text":"ரேறிக்","tr":"rēṟik","foot":"tēmā","acai":[{"kind":"nēr","text":"ரே","tr":"rē"},{"kind":"nēr","text":"றிக்","tr":"ṟik"}]}],[{"text":"கண்டனம்","tr":"kaṇṭaṉam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கண்","tr":"kaṇ"},{"kind":"nirai","text":"டனம்","tr":"ṭaṉam"}]},{"text":"வருகஞ்","tr":"varukañ","foot":"puḷimā","acai":[{"kind":"nirai","text":"வரு","tr":"varu"},{"kind":"nēr","text":"கஞ்","tr":"kañ"}]},{"text":"சென்மோ","tr":"ceṉmō","foot":"tēmā","acai":[{"kind":"nēr","tex