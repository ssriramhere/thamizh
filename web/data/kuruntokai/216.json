{"text":"kuruntokai","n":216,"lines":["அவரே கேடில் விழுப்பொருள் தருமார் பாசிலை","வாடா வள்ளியங் காடிறந் தோரே","யானே தோடார் எல்வளை ஞெகிழ ஏங்கிப்","பாடமை சேக்கையிற் படர்கூர்ந் திசினே","அன்னள் அளியள் என்னாது மாமழை","இன்னும் பெய்ய முழங்கி","மின்னுந் தோழியென் இன்னுயிர் குறித்தே"],"tr":["avarē kēṭil viḻupporuḷ tarumār pācilai","vāṭā vaḷḷiyaṅ kāṭiṟan tōrē","yāṉē tōṭār elvaḷai ñekiḻa ēṅkip","pāṭamai cēkkaiyiṟ paṭarkūrn ticiṉē","aṉṉaḷ aḷiyaḷ eṉṉātu māmaḻai","iṉṉum peyya muḻaṅki","miṉṉun tōḻiyeṉ iṉṉuyir kuṟittē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"கச்சிப்பேட்டுக் காஞ்சிக் கொற்றனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kaccippēṭṭuk Kāñcik Koṟṟaṉār"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"2×5, 4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 11, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"2 five-foot lines (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"அவரே","tr":"avarē","foot":"puḷimā","acai":[{"kind":"nirai","text":"அவ","tr":"ava"},{"kind":"nēr","text":"ரே","tr":"rē"}]},{"text":"கேடில்","tr":"kēṭil","foot":"tēmā","acai":[{"kind":"nēr","text":"கே","tr":"kē"},{"kind":"nēr","text":"டில்","tr":"ṭil"}]},{"text":"விழுப்பொருள்","tr":"viḻupporuḷ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விழுப்","tr":"viḻup"},{"kind":"nirai","text":"பொருள்","tr":"poruḷ"}]},{"text":"தருமார்","tr":"tarumār","foot":"puḷimā","acai":[{"kind":"nirai","text":"தரு","tr":"taru"},{"kind":"nēr","text":"மார்","tr":"mār"}]},{"text":"பாசிலை","tr":"pācilai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nirai","text":"சிலை","tr":"cilai"}]}],[{"text":"வாடா","tr":"vāṭā","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"டா","tr":"ṭā"}]},{"text"