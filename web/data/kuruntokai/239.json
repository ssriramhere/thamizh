{"text":"kuruntokai","n":239,"lines":["தொடிநெகிழ்ந் தனவே தோள்சா யினவே","விடுநாண் உண்டோ தோழி விடர்முகைச்","சிலம்புடன் கமழு மலங்குகுலைக் காந்தள்","நறுந்தா தூதுங் குறுஞ்சிறைத் தும்பி","பாம்புமிழ் மணியின் தோன்றும்","முந்தூழ் வேலிய மலைகிழ வோற்கே"],"tr":["toṭinekiḻn taṉavē tōḷcā yiṉavē","viṭunāṇ uṇṭō tōḻi viṭarmukaic","cilampuṭaṉ kamaḻu malaṅkukulaik kāntaḷ","naṟuntā tūtuṅ kuṟuñciṟait tumpi","pāmpumiḻ maṇiyiṉ tōṉṟum","muntūḻ vēliya malaikiḻa vōṟkē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"ஆசிரியர் பெருங்கண்ணனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Āciriyar Peruṅkaṇṇaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 9"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"தொடிநெகிழ்ந்","tr":"toṭinekiḻn","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தொடி","tr":"toṭi"},{"kind":"nirai","text":"நெகிழ்ந்","tr":"nekiḻn"}]},{"text":"தனவே","tr":"taṉavē","foot":"puḷimā","acai":[{"kind":"nirai","text":"தன","tr":"taṉa"},{"kind":"nēr","text":"வே","tr":"vē"}]},{"text":"தோள்சா","tr":"tōḷcā","foot":"tēmā","acai":[{"kind":"nēr","text":"தோள்","tr":"tōḷ"},{"kind":"nēr","text":"சா","tr":"cā"}]},{"text":"யினவே","tr":"yiṉavē","foot":"puḷimā","acai":[{"kind":"nirai","text":"யின","tr":"yiṉa"},{"kind":"nēr","text":"வே","tr":"vē"}]}],[{"text":"விடுநாண்","tr":"viṭunāṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"விடு","tr":"viṭu"},{"kind":"nēr","text":"நாண்","tr":"nāṇ"}]},{"text":"உண்டோ","tr":"uṇṭō","foot":"tēmā","acai":[{"kind":"nēr","text":"உண்","tr":"uṇ"},{"kind":"nēr","text":"டோ","tr":"ṭō"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"விடர்முகைச்","tr":"viṭarmuk