":"nēr","text":"ரல்","tr":"ral"}]}],[{"text":"கருங்கோற்","tr":"karuṅkōṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கருங்","tr":"karuṅ"},{"kind":"nēr","text":"கோற்","tr":"kōṟ"}]},{"text":"குறிஞ்சிப்","tr":"kuṟiñcip","foot":"puḷimā","acai":[{"kind":"nirai","text":"குறிஞ்","tr":"kuṟiñ"},{"kind":"nēr","text":"சிப்","tr":"cip"}]},{"text":"பூக்கொண்டு","tr":"pūkkoṇṭu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"பூக்","tr":"pūk"},{"kind":"nēr","text":"கொண்","tr":"koṇ"},{"kind":"nēr","text":"டு","tr":"ṭu"}]}],[{"text":"பெருந்தேன்","tr":"peruntēṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெருந்","tr":"perun"},{"kind":"nēr","text":"தேன்","tr":"tēṉ"}]},{"text":"இழைக்கும்","tr":"iḻaikkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"இழைக்","tr":"iḻaik"},{"kind":"nēr","text":"கும்","tr":"kum"}]},{"text":"நாடனொடு","tr":"nāṭaṉoṭu","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nirai","text":"டனொ","tr":"ṭaṉo"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"நட்பே","tr":"naṭpē","foot":"tēmā","acai":[{"kind":"nēr","text":"நட்","tr":"naṭ"},{"kind":"nēr","text":"பே","tr":"pē"}]}]]},"ai":{"lines":[{"words":[{"surface":"நிலத்தினும்","parts":[{"text":"நிலத்தினும்","lemma":"நிலத்தினும்","gloss":"than the earth"}],"gloss":"than the earth","split_unverified":true},{"surface":"பெரிதே","parts":[{"text":"பெரிது","lemma":"பெரிது","gloss":"big"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"is bigger indeed"},{"surface":"வானினும்","parts":[{"text":"வான்","lemma":"வான்","gloss":"sky"},{"text":"இன்","lemma":"இன்","gloss":"than"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"than the sky"},{"surface":"உயர்ந்தன்று","parts":[{"text":"உயர்ந்தன்று","lemma":"உயர்ந்தன்று","gloss":"is higher"}],"gloss":"is higher","split_unverified":true}]},{"words":[{"surface":"நீரினும்","parts":[{"text":"நீர்","lemma":"நீர்","gloss":"water"},{"text":"இன்","lemma":"இன்","gloss":"than"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"than the water"},{"surface":"ஆரளவின்றே","parts":[{"text":"ஆர்","lemma":"ஆர்","gloss":"rare/deep"},{"text":"அளவு","lemma":"அளவு","gloss":"measure"},{"text":"இன்று","lemma":"இன்று","gloss":"is not"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"is of unfathomable depth indeed"},{"surface":"சாரல்","parts":[{"text":"சாரல்","lemma":"சாரல்","gloss":"mountain slope"}],"gloss":"mountain slope"}]},{"words":[{"surface":"கருங்கோல்","parts":[{"text":"கருங்கோல்","lemma":"கருங்கோல்","gloss":"black-stemmed"}],"gloss":"black-stemmed","split_unverified":true},{"surface":"குறிஞ்சி","parts":[{"text":"குறிஞ்சி","lemma":"குறிஞ்சி","gloss":"Kurinji flower"}],"gloss":"Kurinji"},{"surface":"பூக்கொண்டு","parts":[{"text":"பூ","lemma":"பூ","gloss":"flower"},{"text":"கொண்டு","lemma":"கொள்","gloss":"having taken"}],"gloss":"taking flowers"}]},{"words":[{"surface":"பெருந்தேன்","parts":[{"text":"பெருந்தேன்","lemma":"பெருந்தேன்","gloss":"rich honey"}],"gloss":"rich honey","split_unverified":true},{"surface":"இழைக்கும்","parts":[{"text":"இழை","lemma":"இழை","gloss":"make/build"},{"text":"க்கும்","lemma":"க்கும்","gloss":"future/habitual relative participle suffix"}],"gloss":"that builds"},{"surface":"நாடனொடு","parts":[{"text":"நாடன்","lemma":"நாடன்","gloss":"man of the land"},{"text":"ஒடு","lemma":"ஒடு","gloss":"with"}],"gloss":"with the man of the land"},{"surface":"நட்பே","parts":[{"text":"நட்பு","lemma":"நட்பு","gloss":"friendship/love"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"friendship indeed"}]}],"literal":"Bigger than the earth indeed, higher than the sky / deeper than the water indeed, on the mountain slopes / taking flowers of the black-stemmed Kurinji / rich honey is made, with the man of the land, my friendship!","translation":"Bigger than the earth, higher than the sky, and far deeper than the waters is my love for the man of the mountain slopes, where bees build rich honeycombs from the blossoms of the black-stemmed Kurinji.","modern":"நிலத்தை விடப் பெரியது; வானத்தை விட உயர்ந்தது; கடலை விட ஆழமானது; கருமையான கொம்புகளை உடைய குறிஞ்சிப் பூக்களைக் கொண்டு தேனீக்கள் பெரிய தேன்கூட்டைக் கட்டும் மலைநாட்டைச் சேர்ந்த தலைவனுடன் எனக்கு இருக்கும் நட்பு.","explanation":"In this famous Kurinci poem, the heroine (talaivi) speaks to her close friend (toḻi) about the immense depth of her love for the hero. She compares her love to the vastness of the earth, the height of the sky, and the unfathomable depth of the ocean. The imagery of the mountain slopes where bees make rich honey from the black-stemmed Kurinji flowers represents the rare and precious nature of their union. Just as the Kurinji blooms once in many years to yield the finest honey, their love is a rare, slow-growing, and sweet treasure. The key words are 'nilattinum peritu' (bigger than the earth) and 'naṭpu' (friendship/love), which establish the cosmic scale of her affection.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,0.9],[0.9,1.3],[1.3,2.2],[2.2,3.8],[3.8,4.2],[4.2,4.3],[4.3,5.0],[5.0,6.5],[6.5,6.9],[6.9,6.9],[6.9,8.7],[8.7,9.1],[9.1,9.1],[9.1,9.6]],"female":[[0.0,0.9],[0.9,1.0],[1.0,1.5],[1.5,2.4],[2.4,4.1],[4.1,4.4],[4.4,4.6],[4.6,5.3],[5.3,6.7],[6.7,7.1],[7.1,7.2],[7.2,9.1],[9.1,9.5],[9.5,9.6],[9.6,10.2]]},"sync":[[["நிலத்தினும்","than the earth"]],[["பெரிதே","is bigger indeed"]],[["வானினும்","than the sky"]],[["உயர்ந்தன்று","is higher"]],[["நீரினும்","than the water"]],[["ஆரளவின்றே","is of unfathomable depth indeed"]],[["ஆரளவின்றே","is of unfathomable depth indeed"]],[["சாரல்","mountain slope"]],[["கருங்கோல்","black-stemmed"]],[["குறிஞ்சி","Kurinji"],["பூக்கொண்டு","taking flowers"]],[["பூக்கொண்டு","taking flowers"]],[["பெருந்தேன்","rich honey"]],[["இழைக்கும்","that builds"]],[["நாடனொடு","with the man of the land"]],[["நட்பே","friendship indeed"]]]}