{"text":"kuruntokai","n":167,"lines":["முளிதயிர் பிசைந்த காந்தண் மெல்விரல்","கழுவுறு கலிங்கங் கழாஅ துடீஇக்","குவளை யுண்கண் குய்ப்புகை கழுமத்","தான்றுழந் தட்ட தீம்புளிப் பாகர்","இனிதெனக் கணவ னுண்டலின்","நுண்ணிதின் மகிழ்ந்தன் றொண்ணுதல் முகனே"],"tr":["muḷitayir picainta kāntaṇ melviral","kaḻuvuṟu kaliṅkaṅ kaḻāa tuṭīik","kuvaḷai yuṇkaṇ kuyppukai kaḻumat","tāṉṟuḻan taṭṭa tīmpuḷip pākar","iṉiteṉak kaṇava ṉuṇṭaliṉ","nuṇṇitiṉ makiḻntaṉ ṟoṇṇutal mukaṉē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"செவிலித்தாய் கூற்று","poet_ta":"கூடலூர் கிழார்","speaker_en":"the foster-mother (cevili)","poet_tr":"Kūṭalūr Kiḻār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 7"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"முளிதயிர்","tr":"muḷitayir","foot":"karuviḷam","acai":[{"kind":"nirai","text":"முளி","tr":"muḷi"},{"kind":"nirai","text":"தயிர்","tr":"tayir"}]},{"text":"பிசைந்த","tr":"picainta","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிசைந்","tr":"picain"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"காந்தண்","tr":"kāntaṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"காந்","tr":"kān"},{"kind":"nēr","text":"தண்","tr":"taṇ"}]},{"text":"மெல்விரல்","tr":"melviral","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மெல்","tr":"mel"},{"kind":"nirai","text":"விரல்","tr":"viral"}]}],[{"text":"கழுவுறு","tr":"kaḻuvuṟu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கழு","tr":"kaḻu"},{"kind":"nirai","text":"வுறு","tr":"vuṟu"}]},{"text":"கலிங்கங்","tr":"kaliṅkaṅ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கலிங்","tr":"kaliṅ"},{"kind":"nēr","text":"கங்","tr":"kaṅ"}]},{"text":"கழாஅ","tr":"kaḻāa","foot":"puḷimā","acai":[{"kind":"nirai","text":"கழா","tr":"kaḻā"},{"kind":"nēr","text":"அ","tr":"a"}]},{"tex