pphire-like flowers"}],"gloss":"sapphire-like flowers","split_unverified":true},{"surface":"கூம்பத்","parts":[{"text":"கூம்பத்","lemma":"கூம்பத்","gloss":"to close"}],"gloss":"to close","split_unverified":true},{"surface":"தூத்திரைப்","parts":[{"text":"தூத்திரைப்","lemma":"தூத்திரைப்","gloss":"pure waves"}],"gloss":"pure waves","split_unverified":true}]},{"words":[{"surface":"பொங்குபிதிர்த்","parts":[{"text":"பொங்குபிதிர்த்","lemma":"பொங்குபிதிர்த்","gloss":"swelling spray"}],"gloss":"swelling spray","split_unverified":true},{"surface":"துவலையொடு","parts":[{"text":"துவலை","lemma":"துவலை","gloss":"mist/drizzle"},{"text":"ஒடு","lemma":"ஒடு","gloss":"with"}],"gloss":"with the mist"},{"surface":"மங்குல்","parts":[{"text":"மங்குல்","lemma":"மங்குல்","gloss":"darkness/cloud"}],"gloss":"darkness/cloud"},{"surface":"தைஇக்","parts":[{"text":"தைஇக்","lemma":"தைஇக்","gloss":"spreading"}],"gloss":"spreading","split_unverified":true}]},{"words":[{"surface":"கையற","parts":[{"text":"கை","lemma":"கை","gloss":"means/action"},{"text":"அற","lemma":"அறு","gloss":"to cease/be lost"}],"gloss":"helplessly"},{"surface":"வந்த","parts":[{"text":"வந்த","lemma":"வா","gloss":"that came"}],"gloss":"that came"},{"surface":"தைவரல்","parts":[{"text":"தைவரல்","lemma":"தைவரல்","gloss":"gentle touch/blowing"}],"gloss":"gentle touch"},{"surface":"ஊதையொடு","parts":[{"text":"ஊதை","lemma":"ஊதை","gloss":"cold wind"},{"text":"ஒடு","lemma":"ஒடு","gloss":"with"}],"gloss":"with the cold wind"}]},{"words":[{"surface":"இன்னா","parts":[{"text":"இன்னா","lemma":"இன்னா","gloss":"painful/unpleasant"}],"gloss":"painful"},{"surface":"உறையுட்டு","parts":[{"text":"உறையுட்டு","lemma":"உறையுள்","gloss":"dwelling (oblique)"}],"gloss":"dwelling"},{"surface":"ஆகும்","parts":[{"text":"ஆகும்","lemma":"ஆகு","gloss":"will become"}],"gloss":"will become"}]},{"words":[{"surface":"சின்னாட்டு","parts":[{"text":"சின்னாட்டு","lemma":"சின்னாள்","gloss":"few days (oblique)"}],"gloss":"of few days"},{"surface":"அம்ம","parts":[{"text":"அம்ம","lemma":"அம்ம","gloss":"alas/particle of address"}],"gloss":"alas"},{"surface":"இ","parts":[{"text":"இ","lemma":"இ","gloss":"this"}],"gloss":"this"},{"surface":"சிறு","parts":[{"text":"சிறு","lemma":"சிறு","gloss":"small"}],"gloss":"small"},{"surface":"நல்","parts":[{"text":"நல்","lemma":"நல்","gloss":"good"}],"gloss":"good"},{"surface":"ஊரே","parts":[{"text":"ஊரே","lemma":"ஊர்","gloss":"town indeed"}],"gloss":"town indeed"}]}],"literal":"Great dark backwater sapphire-like flowers to close, pure waves / swelling spray mist-with darkness spreading, / helplessly that came gentle touch cold wind-with, / painful dwelling will become / few days, alas, this small good town indeed.","translation":"As the sapphire-like flowers of the dark backwater close, and the darkness of the mist spreads with the swelling spray of pure waves, this small, good town, alas, will become a painful place to dwell for a few days, along with the gently touching cold wind that brings helplessness.","modern":"கரிய கழியின் நீலமணி போன்ற மலர்கள் குவியுமாறு, தூய அலைகளின் பொங்குகின்ற நீர்த்துளிகளோடு கூடிய பனிமூட்டம் பரவி, செயலற்றுப் போகும்படி வீசுகின்ற குளிர்ந்த காற்றோடு சேர்ந்து, இந்தச் சிறிய நல்ல ஊரானது, சில நாட்களுக்குத் தங்குவதற்கு மிகவும் துன்பம் தருவதாக மாறிவிடும்.","explanation":"In this Neytal (coastal) poem, the friend (tōḻi) speaks of the heroine's distress during the evening in the absence of the hero. As night falls, the sapphire-like water-lilies in the dark backwater close their petals. The cold wind (ūtai) blows from the sea, carrying the salty spray of the waves and spreading a dark, chilly mist. This cold wind gently touches the pining heroine, making her feel completely helpless. The friend laments that this small, otherwise pleasant coastal town will now become an unbearable, painful place to live, even if it is only for a few days until the hero returns.","model":"gemini-3.5-flash"}}