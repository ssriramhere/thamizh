{"text":"kuruntokai","n":55,"lines":["மாக்கழி மணிப்பூக் கூம்பத் தூத்திரைப்","பொங்குபிதிர்த் துவலையொடு மங்குல் தைஇக்","கையற வந்த தைவரல் ஊதையொடு","இன்னா உறையுட் டாகும்","சின்னாட் டம்மவிச் சிறுநல் லூரே"],"tr":["mākkaḻi maṇippūk kūmpat tūttiraip","poṅkupitirt tuvalaiyoṭu maṅkul taiik","kaiyaṟa vanta taivaral ūtaiyoṭu","iṉṉā uṟaiyuṭ ṭākum","ciṉṉāṭ ṭammavic ciṟunal lūrē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தோழி கூற்று","poet_ta":"நெய்தற் கார்க்கியர்","speaker_en":"her friend (tōḻi)","poet_tr":"Neytaṟ Kārkkiyar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 16, vañcicīr 2, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 4, oṉṟā vañcittaḷai 2, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மாக்கழி","tr":"mākkaḻi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மாக்","tr":"māk"},{"kind":"nirai","text":"கழி","tr":"kaḻi"}]},{"text":"மணிப்பூக்","tr":"maṇippūk","foot":"puḷimā","acai":[{"kind":"nirai","text":"மணிப்","tr":"maṇip"},{"kind":"nēr","text":"பூக்","tr":"pūk"}]},{"text":"கூம்பத்","tr":"kūmpat","foot":"tēmā","acai":[{"kind":"nēr","text":"கூம்","tr":"kūm"},{"kind":"nēr","text":"பத்","tr":"pat"}]},{"text":"தூத்திரைப்","tr":"tūttiraip","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தூத்","tr":"tūt"},{"kind":"nirai","text":"திரைப்","tr":"tiraip"}]}],[{"text":"பொங்குபிதிர்த்","tr":"poṅkupitirt","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"பொங்","tr":"poṅ"},{"kind":"nirai","text":"குபி","tr":"kupi"},{"kind":"nēr","text":"திர்த்","tr":"tirt"}]},{"text":"துவலையொடு","tr":"tuvalaiyoṭu","foot":"puḷimāṅkaṉi","acai":[{"kind":"nirai","text":"துவ","tr":"tuva"},{"kind":"nēr","text":"லை","tr":"lai"},{"kind":"nirai","text":"யொடு","tr":"yoṭu"}]},{"text":"மங்குல்","tr":"maṅkul","foot":"tēmā","acai":[{"kind":"nēr","text