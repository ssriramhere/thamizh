":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"மழை","tr":"maḻai"}]}],[{"text":"பொன்னேர்","tr":"poṉṉēr","foot":"tēmā","acai":[{"kind":"nēr","text":"பொன்","tr":"poṉ"},{"kind":"nēr","text":"னேர்","tr":"ṉēr"}]},{"text":"மேனி","tr":"mēṉi","foot":"tēmā","acai":[{"kind":"nēr","text":"மே","tr":"mē"},{"kind":"nēr","text":"னி","tr":"ṉi"}]},{"text":"நன்னலஞ்","tr":"naṉṉalañ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நன்","tr":"naṉ"},{"kind":"nirai","text":"னலஞ்","tr":"ṉalañ"}]},{"text":"சிதைத்தோர்","tr":"citaittōr","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிதைத்","tr":"citait"},{"kind":"nēr","text":"தோர்","tr":"tōr"}]}],[{"text":"இன்னும்","tr":"iṉṉum","foot":"tēmā","acai":[{"kind":"nēr","text":"இன்","tr":"iṉ"},{"kind":"nēr","text":"னும்","tr":"ṉum"}]},{"text":"வாரார்","tr":"vārār","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ரார்","tr":"rār"}]},{"text":"ஆயின்","tr":"āyiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nēr","text":"யின்","tr":"yiṉ"}]}],[{"text":"என்னாந்","tr":"eṉṉān","foot":"tēmā","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nēr","text":"னாந்","tr":"ṉān"}]},{"text":"தோழிநம்","tr":"tōḻinam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nirai","text":"ழிநம்","tr":"ḻinam"}]},{"text":"இன்னுயிர்","tr":"iṉṉuyir","foot":"kūviḷam","acai":[{"kind":"nēr","text":"இன்","tr":"iṉ"},{"kind":"nirai","text":"னுயிர்","tr":"ṉuyir"}]},{"text":"நிலையே","tr":"nilaiyē","foot":"puḷimā","acai":[{"kind":"nirai","text":"நிலை","tr":"nilai"},{"kind":"nēr","text":"யே","tr":"yē"}]}]]},"ai":{"lines":[{"words":[{"surface":"மானேறு","parts":[{"text":"மான்","lemma":"māṉ","gloss":"deer"},{"text":"ஏறு","lemma":"ēṟu","gloss":"male"}],"gloss":"male deer / stag"},{"surface":"மடப்பிணை","parts":[{"text":"மடப்பிணை","lemma":"மடப்பிணை","gloss":"gentle female deer"}],"gloss":"gentle female deer","split_unverified":true},{"surface":"தழீஇ","parts":[{"text":"தழீஇ","lemma":"தழீஇ","gloss":"embrac