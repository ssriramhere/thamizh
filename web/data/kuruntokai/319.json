{"text":"kuruntokai","n":319,"lines":["மானேறு மடப்பிணை தழீஇ மருள்கூர்ந்து","கான நண்ணிய புதன்மறைந் தொடுங்கவும்","கையுடை நன்மாப் பிடியொடு பொருந்தி","மையணி மருங்கின் மலையகஞ் சேரவும்","மாலைவந் தன்று மாரி மாமழை","பொன்னேர் மேனி நன்னலஞ் சிதைத்தோர்","இன்னும் வாரார் ஆயின்","என்னாந் தோழிநம் இன்னுயிர் நிலையே"],"tr":["māṉēṟu maṭappiṇai taḻīi maruḷkūrntu","kāṉa naṇṇiya putaṉmaṟain toṭuṅkavum","kaiyuṭai naṉmāp piṭiyoṭu porunti","maiyaṇi maruṅkiṉ malaiyakañ cēravum","mālaivan taṉṟu māri māmaḻai","poṉṉēr mēṉi naṉṉalañ citaittōr","iṉṉum vārār āyiṉ","eṉṉān tōḻinam iṉṉuyir nilaiyē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"தாயங் கண்ணனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Tāyaṅ Kaṇṇaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 11, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மானேறு","tr":"māṉēṟu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"னே","tr":"ṉē"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"மடப்பிணை","tr":"maṭappiṇai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மடப்","tr":"maṭap"},{"kind":"nirai","text":"பிணை","tr":"piṇai"}]},{"text":"தழீஇ","tr":"taḻīi","foot":"puḷimā","acai":[{"kind":"nirai","text":"தழீ","tr":"taḻī"},{"kind":"nēr","text":"இ","tr":"i"}]},{"text":"மருள்கூர்ந்து","tr":"maruḷkūrntu","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"மருள்","tr":"maruḷ"},{"kind":"nēr","text":"கூர்ந்","tr":"kūrn"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"கான","tr":"kāṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"நண்ணிய","tr":"naṇṇiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நண்","tr":"naṇ"},{"