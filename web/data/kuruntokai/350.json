{"text":"kuruntokai","n":350,"lines":["அம்ம வாழி தோழி முன்னின்று","பனிக்கடுங் குரையஞ் செல்லா தீமெனச்","சொல்லின மாயிற் செல்வர் கொல்லோ","ஆற்றய லிருந்த இருந்தோட் டஞ்சிறை","நெடுங்காற் கணந்துள் ஆளறி வுறீஇ","ஆறுசெல் வம்பலர் படைதலை பெயர்க்கும்","மலையுடைக் கான நீந்தி","நிலையாப் பொருட்பிணிப் பிரிந்திசி னோரே"],"tr":["amma vāḻi tōḻi muṉṉiṉṟu","paṉikkaṭuṅ kuraiyañ cellā tīmeṉac","colliṉa māyiṟ celvar kollō","āṟṟaya lirunta iruntōṭ ṭañciṟai","neṭuṅkāṟ kaṇantuḷ āḷaṟi vuṟīi","āṟucel vampalar paṭaitalai peyarkkum","malaiyuṭaik kāṉa nīnti","nilaiyāp poruṭpiṇip pirintici ṉōrē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"ஆலத்தூர் கிழார்","speaker_en":"her friend (tōḻi)","poet_tr":"Ālattūr Kiḻār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 19, veṇṭaḷai 10, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அம்ம","tr":"amma","foot":"tēmā","acai":[{"kind":"nēr","text":"அம்","tr":"am"},{"kind":"nēr","text":"ம","tr":"ma"}]},{"text":"வாழி","tr":"vāḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"முன்னின்று","tr":"muṉṉiṉṟu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"முன்","tr":"muṉ"},{"kind":"nēr","text":"னின்","tr":"ṉiṉ"},{"kind":"nēr","text":"று","tr":"ṟu"}]}],[{"text":"பனிக்கடுங்","tr":"paṉikkaṭuṅ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பனிக்","tr":"paṉik"},{"kind":"nirai","text":"கடுங்","tr":"kaṭuṅ"}]},{"text":"குரையஞ்","tr":"kuraiyañ","foot":"puḷimā","acai":[{"kind":"nirai","text":"குரை","tr":"kurai"},{"kind":"nēr","text":"யஞ்","tr":"yañ"}]},{"text":"செல்லா","tr":"cellā