{"text":"kuruntokai","n":186,"lines":["ஆர்கலி யேற்றொடு கார்தலை மணந்த","கொல்லைப் புனத்த முல்லை மென்கொடி","எயிறென முகையும் நாடற்குத்","துயிறுறந் தனவால் தோழியென் கண்ணே"],"tr":["ārkali yēṟṟoṭu kārtalai maṇanta","kollaip puṉatta mullai meṉkoṭi","eyiṟeṉa mukaiyum nāṭaṟkut","tuyiṟuṟan taṉavāl tōḻiyeṉ kaṇṇē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"ஒக்கூர் மாசாத்தியார்","speaker_en":"the heroine (talaivi)","poet_tr":"Okkūr Mācāttiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 14, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 9, veṇṭaḷai 4, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஆர்கலி","tr":"ārkali","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஆர்","tr":"ār"},{"kind":"nirai","text":"கலி","tr":"kali"}]},{"text":"யேற்றொடு","tr":"yēṟṟoṭu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யேற்","tr":"yēṟ"},{"kind":"nirai","text":"றொடு","tr":"ṟoṭu"}]},{"text":"கார்தலை","tr":"kārtalai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கார்","tr":"kār"},{"kind":"nirai","text":"தலை","tr":"talai"}]},{"text":"மணந்த","tr":"maṇanta","foot":"puḷimā","acai":[{"kind":"nirai","text":"மணந்","tr":"maṇan"},{"kind":"nēr","text":"த","tr":"ta"}]}],[{"text":"கொல்லைப்","tr":"kollaip","foot":"tēmā","acai":[{"kind":"nēr","text":"கொல்","tr":"kol"},{"kind":"nēr","text":"லைப்","tr":"laip"}]},{"text":"புனத்த","tr":"puṉatta","foot":"puḷimā","acai":[{"kind":"nirai","text":"புனத்","tr":"puṉat"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"முல்லை","tr":"mullai","foot":"tēmā","acai":[{"kind":"nēr","text":"முல்","tr":"mul"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"மென்கொடி","tr":"meṉkoṭi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மென்","tr":"meṉ"},{"kind":"nirai","text":"கொடி","tr":"koṭi"}]}],[{"text":"எயிறென"