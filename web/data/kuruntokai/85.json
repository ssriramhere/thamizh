":"pā"},{"kind":"nēr","text":"ணன்","tr":"ṇaṉ"}]},{"text":"வாயே","tr":"vāyē","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"யே","tr":"yē"}]}]]},"ai":{"lines":[{"words":[{"surface":"யாரினும்","parts":[{"text":"யார்","lemma":"yār","gloss":"who"},{"text":"இன்","lemma":"iṉ","gloss":"than"},{"text":"உம்","lemma":"um","gloss":"even"}],"gloss":"than anyone"},{"surface":"இனியன்","parts":[{"text":"இனியன்","lemma":"iṉiyaṉ","gloss":"sweet man"}],"gloss":"he is sweet"},{"surface":"பேரன்பினனே","parts":[{"text":"பேர்","lemma":"pēr","gloss":"great"},{"text":"அன்பு","lemma":"aṉpu","gloss":"love"},{"text":"இனன்","lemma":"iṉaṉ","gloss":"he who has"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"he is of great love indeed"}]},{"words":[{"surface":"உள்ளூர்","parts":[{"text":"உள்","lemma":"uḷ","gloss":"inside"},{"text":"ஊர்","lemma":"ūr","gloss":"village"}],"gloss":"of the inner village"},{"surface":"குரீஇ","parts":[{"text":"குரீஇ","lemma":"kurīi","gloss":"sparrow"}],"gloss":"sparrow"},{"surface":"துள்ளுநடை","parts":[{"text":"துள்ளு","lemma":"tuḷḷu","gloss":"hopping"},{"text":"நடை","lemma":"naṭai","gloss":"gait"}],"gloss":"with a hopping gait"},{"surface":"சேவல்","parts":[{"text":"சேவல்","lemma":"cēval","gloss":"male bird"}],"gloss":"the male sparrow"}]},{"words":[{"surface":"சூன்முதிர்","parts":[{"text":"சூன்முதிர்","lemma":"சூன்முதிர்","gloss":"fully pregnant"}],"gloss":"fully pregnant","split_unverified":true},{"surface":"பேடைக்கு","parts":[{"text":"பேடை","lemma":"pēṭai","gloss":"female bird"},{"text":"கு","lemma":"ku","gloss":"for"}],"gloss":"for the female bird"},{"surface":"ஈனில்","parts":[{"text":"ஈன்","lemma":"īṉ","gloss":"giving birth"},{"text":"இல்","lemma":"il","gloss":"house"}],"gloss":"the birthing nest"},{"surface":"இழைஇயர்","parts":[{"text":"இழை","lemma":"iḸai","gloss":"weave"},{"text":"இயர்","lemma":"iyar","gloss":"in order to"}],"gloss":"in order to build"}]},{"words":[{"surface":"தேம்பொதி","parts":[{"text":"தேம்பொதி","lemma":"தேம்பொதி","gloss":"storing sweetness"}],"gloss":"storing sweetness","split_unverified":true},{"surface":"கொண்ட","parts":[{"text":"கொண்ட","lemma":"koḷ","gloss":"having"}],"gloss":"having"},{"surface":"தீங்கழை","parts":[{"text":"தீம்","lemma":"tīm","gloss":"sweet"},{"text":"கழை","lemma":"kaḸai","gloss":"stalk"}],"gloss":"sweet-stalked"},{"surface":"கரும்பின்","parts":[{"text":"கரும்பு","lemma":"karumpu","gloss":"sugarcane"},{"text":"இன்","lemma":"iṉ","gloss":"of"}],"gloss":"of sugarcane"}]},{"words":[{"surface":"நாறா","parts":[{"text":"நாறா","lemma":"nāṟu","gloss":"scentless"}],"gloss":"scentless"},{"surface":"வெண்பூ","parts":[{"text":"வெண்பூ","lemma":"வெண்பூ","gloss":"white flower"}],"gloss":"white flower","split_unverified":true},{"surface":"கொழுதும்","parts":[{"text":"கொழுதும்","lemma":"koḸutu","gloss":"pecking"}],"gloss":"plucking"}]},{"words":[{"surface":"யாணர்","parts":[{"text":"யாணர்","lemma":"yāṇar","gloss":"fertility"}],"gloss":"fertile"},{"surface":"ஊரன்","parts":[{"text":"ஊர்","lemma":"ūr","gloss":"town"},{"text":"அன்","lemma":"aṉ","gloss":"he of"}],"gloss":"the chief of the town"},{"surface":"பாணன்","parts":[{"text":"பாணன்","lemma":"pāṇaṉ","gloss":"bard"}],"gloss":"the bard"},{"surface":"வாயே","parts":[{"text":"வாய்","lemma":"vāy","gloss":"mouth"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"according to the words of"}]}],"literal":"Than anyone he is sweet, he is of great love / of the inner village, the sparrow with a hopping gait, the male, / for the fully pregnant female, to build a birthing nest, / storing sweetness, having sweet-stalked sugarcane's / scentless white flower, plucks / of the fertile town, the chief, in the mouth of the bard.","translation":"According to the words of the bard, the chief of the fertile town is sweeter than anyone and possesses great love. In his town, the hopping male sparrow of the village plucks the scentless white flowers of the sweet-stalked sugarcane that stores sweetness, in order to build a birthing nest for his fully pregnant mate.","modern":"பாணனுடைய வார்த்தைகளின்படி, வளமான ஊர்த் தலைவன் எல்லாரையும் விட இனியவன், பேரன்பு கொண்டவன். அவனுடைய ஊரில், துள்ளி நடக்கும் ஆண் குருவி, தன் சூல் முதிர்ந்த பெண் குருவி முட்டையிடுவதற்காகக் கூடு கட்ட, தேன் நிறைந்த இனிய கரும்பின் வாசனை இல்லாத வெண்மையான பூவைக் கொய்து செல்லும்.","explanation":"The friend of the heroine speaks with deep irony to the bard who has come as a messenger from the unfaithful hero. The bard praises the hero as a man of great love and sweetness, but the friend exposes this falsehood through a vivid image of the hero's own fertile town. She describes a simple male sparrow that works tirelessly to build a nest for its pregnant mate using sugarcane flowers. This caring behavior of a tiny bird contrasts sharply with the hero's neglect of his wife. Furthermore, the sugarcane flower, though beautiful and growing on a sweet stalk, is completely scentless and useless for honey, symbolizing the sweet-sounding but empty and untruthful words of the bard.","model":"gemini-3.5-flash"}}