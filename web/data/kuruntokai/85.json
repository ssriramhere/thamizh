{"text":"kuruntokai","n":85,"lines":["யாரினும் இனியன் பேரன் பினனே","உள்ளூர்க் குரீஇத் துள்ளுநடைச் சேவல்","சூன்முதிர் பேடைக் கீனி லிழைஇயர்","தேம்பொதிக் கொண்ட தீங்கழைக் கரும்பின்","நாறா வெண்பூக் கொழுதும்","யாண ரூரன் பாணன் வாயே"],"tr":["yāriṉum iṉiyaṉ pēraṉ piṉaṉē","uḷḷūrk kurīit tuḷḷunaṭaic cēval","cūṉmutir pēṭaik kīṉi liḻaiiyar","tēmpotik koṇṭa tīṅkaḻaik karumpiṉ","nāṟā veṇpūk koḻutum","yāṇa rūraṉ pāṇaṉ vāyē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தோழி கூற்று","poet_ta":"வடம வண்ணக்கன் தாமோதரனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Vaṭama Vaṇṇakkaṉ Tāmōtaraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"யாரினும்","tr":"yāriṉum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nirai","text":"ரினும்","tr":"riṉum"}]},{"text":"இனியன்","tr":"iṉiyaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"இனி","tr":"iṉi"},{"kind":"nēr","text":"யன்","tr":"yaṉ"}]},{"text":"பேரன்","tr":"pēraṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"பே","tr":"pē"},{"kind":"nēr","text":"ரன்","tr":"raṉ"}]},{"text":"பினனே","tr":"piṉaṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"பின","tr":"piṉa"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}],[{"text":"உள்ளூர்க்","tr":"uḷḷūrk","foot":"tēmā","acai":[{"kind":"nēr","text":"உள்","tr":"uḷ"},{"kind":"nēr","text":"ளூர்க்","tr":"ḷūrk"}]},{"text":"குரீஇத்","tr":"kurīit","foot":"puḷimā","acai":[{"kind":"nirai","text":"குரீ","tr":"kurī"},{"kind":"nēr","text":"இத்","tr":"it"}]},{"text":"துள்ளுநடைச்","tr":"tuḷḷunaṭaic","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"துள்","tr":"tuḷ"},{"kind":"nirai","text":"ளுந","tr":"ḷuna"},{"kind":"nēr","text":"டைச்","tr":"ṭaic"}]},{"text":"ச