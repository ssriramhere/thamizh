lemma":"i","gloss":"verbal participle"}],"gloss":"desiring"}]},{"words":[{"surface":"யாம்","parts":[{"text":"யாம்","lemma":"yām","gloss":"we"}],"gloss":"we"},{"surface":"அஃது","parts":[{"text":"அஃது","lemma":"atu","gloss":"that"}],"gloss":"that"},{"surface":"அயர்கம்","parts":[{"text":"அயர்","lemma":"ayar","gloss":"to celebrate"},{"text":"கம்","lemma":"kam","gloss":"first person plural future suffix"}],"gloss":"we will celebrate"},{"surface":"சேறும்","parts":[{"text":"சேறும்","lemma":"சேறும்","gloss":"we will go"}],"gloss":"we will go","split_unverified":true},{"surface":"தான்","parts":[{"text":"தான்","lemma":"tāṉ","gloss":"she"}],"gloss":"she"},{"surface":"அஃது","parts":[{"text":"அஃது","lemma":"atu","gloss":"that"}],"gloss":"that"}]},{"words":[{"surface":"அஞ்சுவது","parts":[{"text":"அஞ்சு","lemma":"añcu","gloss":"fear"},{"text":"வது","lemma":"vatu","gloss":"participial noun suffix"}],"gloss":"fearing"},{"surface":"உடையள்","parts":[{"text":"உடை","lemma":"uṭai","gloss":"possess"},{"text":"அள்","lemma":"aḷ","gloss":"feminine singular suffix"}],"gloss":"she who has"},{"surface":"ஆயின்","parts":[{"text":"ஆயின்","lemma":"āyiṉ","gloss":"if"}],"gloss":"if"},{"surface":"வெம்","parts":[{"text":"வெம்","lemma":"வெம்","gloss":"fierce"}],"gloss":"fierce","split_unverified":true},{"surface":"போர்","parts":[{"text":"போர்","lemma":"pōr","gloss":"battle"}],"gloss":"battle"}]},{"words":[{"surface":"நுகம்பட","parts":[{"text":"நுகம்","lemma":"nukam","gloss":"yoke"},{"text":"பட","lemma":"paṭu","gloss":"to happen/suffer"}],"gloss":"to bring under the yoke"},{"surface":"கடக்கும்","parts":[{"text":"கட","lemma":"kaṭa","gloss":"conquer"},{"text":"கும்","lemma":"um","gloss":"relative participle suffix"}],"gloss":"who conquers"},{"surface":"பல்","parts":[{"text":"பல்","lemma":"பல்","gloss":"many"}],"gloss":"many","split_unverified":true},{"surface":"வேல்","parts":[{"text":"வேல்","lemma":"vēl","gloss":"spear"}],"gloss":"spear"},{"surface":"எழினி","parts":[{"text":"எழினி","lemma":"eḻiṉi","gloss":"Elini"}],"gloss":"Elini"}]},{"words":[{"surface":"முனையான்","parts":[{"text":"முனை","lemma":"muṉai","gloss":"battlefield/frontier"},{"text":"ஆன்","lemma":"āṉ","gloss":"locative/genitive suffix"}],"gloss":"of the battlefield"},{"surface":"பெரு","parts":[{"text":"பெரு","lemma":"பெரு","gloss":"great"}],"gloss":"great","split_unverified":true},{"surface":"நிரை","parts":[{"text":"நிரை","lemma":"nirai","gloss":"herd"}],"gloss":"herd"},{"surface":"போல","parts":[{"text":"போல","lemma":"pōl","gloss":"like"}],"gloss":"like"}]},{"words":[{"surface":"கிளையொடும்","parts":[{"text":"கிளை","lemma":"kiḷai","gloss":"kin/relatives"},{"text":"ஒடும்","lemma":"oṭu","gloss":"sociative suffix with intensive 'um'"}],"gloss":"along with her kin"},{"surface":"காக்க","parts":[{"text":"கா","lemma":"kā","gloss":"guard/protect"},{"text":"க","lemma":"ka","gloss":"optative suffix"}],"gloss":"let her guard"},{"surface":"தன்","parts":[{"text":"தன்","lemma":"tāṉ","gloss":"her"}],"gloss":"her"},{"surface":"கொழுநன்","parts":[{"text":"கொழுநன்","lemma":"koḻuṉaṉ","gloss":"husband"}],"gloss":"husband"},{"surface":"மார்பே","parts":[{"text":"மார்பு","lemma":"mārpu","gloss":"chest"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"chest indeed"}]}],"literal":"Tucking the whole fold of water lily in the hair, / desiring the vast bathing ghat where the great flood came, / we will go to celebrate that. If she / has fear of that, like the great herd of cattle at the frontier of Elini of many spears who conquers in fierce battle bringing under the yoke, / let her guard her husband's chest along with her kin.","translation":"Tucking full-petaled water lilies into our hair, we are going to enjoy the fresh floods at the vast bathing ghat. If she is afraid of this, let her guard her husband's chest with the help of all her relatives, like guarding a great herd of cattle captured at the battlefront of the chieftain Elini, who wins fierce wars with his many spears.","modern":"கூந்தலில் ஆம்பல் மலரின் முழு இதழ்களைச் சூடிக்கொண்டு, புதிய வெள்ளம் வந்த பெரிய நீர்த்துறையை விரும்பி, நாம் அந்த நீர்விளையாட்டைச் செய்யப் போவோம். அவள் அதற்கு அஞ்சுகிறாள் என்றால், கொடிய போரில் பகைவரை வெல்லும் பல வேல்களைக் கொண்ட எழினியின் போர்க்களத்துக் கால்நடை மந்தையைப் போல, தன் சுற்றத்தாருடன் சேர்ந்து தன் கணவனுடைய மார்பைக் காத்துக் கொள்ளட்டும்.","explanation":"This poem belongs to the Marutam landscape and is spoken by the courtesan (parattai) to her friends, intended for the hero's wife to hear. The arrival of fresh floods in the river has brought about a public bathing festival, a time of celebration and romance. The courtesan boldly announces that she is going to the bathing ghat adorned with water lilies to enjoy the water sports. She mockingly challenges the wife, stating that if she is afraid of losing her husband to her, she must guard him closely. The courtesan compares the husband's chest to a captured herd of cattle on the battlefield of the chieftain Elini, which requires an entire clan to guard it from being taken back. This vivid military imagery highlights the intense rivalry and the courtesan's confident defiance.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.5],[0.5,0.8],[0.8,1.5],[1.5,1.98],[1.98,2.8],[2.8,2.9],[2.9,3.6],[3.6,3.9],[3.9,4.38],[4.7,5.5],[5.5,5.9],[5.9,5.97],[6.0,6.8],[6.8,6.93],[6.93,7.07],[7.07,7.07],[7.07,7.2],[7.2,9.6],[9.6,9.8],[9.8,10.1],[10.1,11.4],[11.4,11.4],[11.4,12.3],[12.3,13.1],[13.1,13.6],[13.6,14.1],[14.1,14.5]],"female":[[0.0,0.6],[0.6,0.8],[0.8,1.5],[1.5,1.84],[1.9,3.0],[3.0,3.2],[3.2,4.0],[4.0,4.3],[4.3,4.96],[5.4,5.8],[5.8,6.2],[6.2,6.8],[7.08,7.35],[7.35,8.3],[8.3,8.7],[8.7,9.0],[9.0,10.0],[10.0,10.4],[10.4,10.7],[10.7,11.0],[11.0,13.0],[13.0,13.5],[13.5,14.02],[14.02,14.76],[14.76,14.76],[14.76,15.0],[15.0,16.6]]},"sync":[[["கூந்தல்","hair"]],[["ஆம்பல்","water lily"]],[["முழுநெறி","whole fold"]],[["அடைச்சி","having tucked in"]],[["பெரும்","great"],["புனல்","water"]],[["வந்த","which came"]],[["இருந்துறை","vast bathing ghat"]],[["விரும்பி","desiring"]],[["யாம்","we"],["அஃது","that"]],[["அஃது","that"],["அயர்கம்","we will celebrate"]],[["சேறும்","we will go"]],[["தான்","she"],["அஃது","that"]],[["அஞ்சுவது","fearing"]],[["அஞ்சுவது","fearing"],["உடையள்","she who has"]],[["ஆயின்","if"]],[["வெம்","fierce"],["போர்","battle"]],[["நுகம்பட","to bring under the yoke"]],[["கடக்கும்","who conquers"]],[["பல்","many"],["வேல்","spear"]],[["எழினி","Elini"]],[["முனையான்","of the battlefield"]],[["பெரு","great"],["நிரை","herd"]],[["போல","like"]],[["கிளையொடும்","along with her kin"]],[["காக்க","let her guard"],["தன்","her"]],[["கொழுநன்","husband"]],[["மார்பே","chest indeed"]]]}