peech"}],"gloss":"speech"}]},{"words":[{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"அன்ன","gloss":"such"}],"gloss":"such"},{"surface":"இனியோள்","parts":[{"text":"இனியோள்","lemma":"இனியோள்","gloss":"sweet woman"}],"gloss":"sweet woman","split_unverified":true},{"surface":"குணனும்","parts":[{"text":"குணன்","lemma":"குணம்","gloss":"qualities"},{"text":"உம்","lemma":"உம்","gloss":"also"}],"gloss":"qualities also"},{"surface":"இன்ன","parts":[{"text":"இன்ன","lemma":"இன்ன","gloss":"are of this nature"}],"gloss":"are like this"}]},{"words":[{"surface":"இன்னா","parts":[{"text":"இன்னா","lemma":"இன்னா","gloss":"painful"}],"gloss":"painful"},{"surface":"அரும்படர்","parts":[{"text":"அரும்படர்","lemma":"அரும்படர்","gloss":"intense distress"}],"gloss":"intense distress","split_unverified":true},{"surface":"செய்யும்","parts":[{"text":"செய்","lemma":"செய்","gloss":"do"},{"text":"உம்","lemma":"உம்","gloss":"habitual future suffix"}],"gloss":"makes"},{"surface":"ஆயின்","parts":[{"text":"ஆயின்","lemma":"ஆயின்","gloss":"if"}],"gloss":"if"}]},{"words":[{"surface":"உடன்","parts":[{"text":"உடன்","lemma":"உடன்","gloss":"together"}],"gloss":"together"},{"surface":"உறைவு","parts":[{"text":"உறை","lemma":"உறை","gloss":"dwell"},{"text":"வு","lemma":"வு","gloss":"noun suffix"}],"gloss":"living"},{"surface":"அரிது","parts":[{"text":"அரிது","lemma":"அரிது","gloss":"difficult"}],"gloss":"difficult"},{"surface":"ஏ","parts":[{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"indeed"},{"surface":"காமம்","parts":[{"text":"காமம்","lemma":"காமம்","gloss":"love"}],"gloss":"love"}]},{"words":[{"surface":"குறுகல்","parts":[{"text":"குறுகு","lemma":"குறுகு","gloss":"approach"},{"text":"அல்","lemma":"அல்","gloss":"verbal noun suffix"}],"gloss":"approaching"},{"surface":"ஓம்புமின்","parts":[{"text":"ஓம்பு","lemma":"ஓம்பு","gloss":"avoid"},{"text":"மின்","lemma":"மின்","gloss":"plural imperative suffix"}],"gloss":"avoid"},{"surface":"அறிவுடையீரே","parts":[{"text":"அறிவு","lemma":"அறிவு","gloss":"wisdom"},{"text":"உடை","lemma":"உடை","gloss":"possess"},{"text":"ஈர்","lemma":"நீர்","gloss":"you (plural)"},{"text":"ஏ","lemma":"ஏ","gloss":"vocative particle"}],"gloss":"O wise people!"}]}],"literal":"Like nectar, beautiful sweet speech / such a sweet woman's qualities also are like this / if they cause painful, intense distress / living together is difficult indeed; love / avoid approaching it, O wise people!","translation":"Her words are sweet, beautiful, and like nectar. If the qualities of such a sweet woman also cause this kind of painful, intense distress, then living together in love is indeed difficult. O wise people, avoid approaching love!","modern":"அமிர்தம் போன்ற இனிமையான சொற்களைப் பேசும் அந்தப் பெண்ணின் குணங்களும் இத்தகைய துன்பத்தைத் தருவதாக இருந்தால், அவளோடு கூடி வாழ்வது மிகவும் அரிதானது. அறிவுடையவர்களே, நீங்கள் காமத்தை நெருங்குவதைத் தவிர்த்துவிடுங்கள்.","explanation":"In this Kuriñci poem, the hero expresses his deep anguish caused by love and separation. He addresses wise people, warning them to stay away from love. He describes his beloved as a sweet woman whose words are as delightful as nectar, yet her qualities now bring him intense, painful distress. He laments that living together in love is extremely difficult when it is accompanied by such suffering. The contrast between the nectar-like sweetness of her words and the agonizing pain of separation highlights the overwhelming power of love.","model":"gemini-3.5-flash"}}