{"text":"kuruntokai","n":206,"lines":["அமிழ்தத் தன்ன அந்தீங் கிளவி","அன்ன இனியோள் குணனும் இன்ன","இன்னா அரும்படர் செய்யு மாயின்","உடனுறை வரிதே காமம்","குறுக லோம்புமின் அறிவுடை யீரே"],"tr":["amiḻtat taṉṉa antīṅ kiḷavi","aṉṉa iṉiyōḷ kuṇaṉum iṉṉa","iṉṉā arumpaṭar ceyyu māyiṉ","uṭaṉuṟai varitē kāmam","kuṟuka lōmpumiṉ aṟivuṭai yīrē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"ஐயூர் முடவனார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Aiyūr Muṭavaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அமிழ்தத்","tr":"amiḻtat","foot":"puḷimā","acai":[{"kind":"nirai","text":"அமிழ்","tr":"amiḻ"},{"kind":"nēr","text":"தத்","tr":"tat"}]},{"text":"தன்ன","tr":"taṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"தன்","tr":"taṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"அந்தீங்","tr":"antīṅ","foot":"tēmā","acai":[{"kind":"nēr","text":"அந்","tr":"an"},{"kind":"nēr","text":"தீங்","tr":"tīṅ"}]},{"text":"கிளவி","tr":"kiḷavi","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிள","tr":"kiḷa"},{"kind":"nēr","text":"வி","tr":"vi"}]}],[{"text":"அன்ன","tr":"aṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"அன்","tr":"aṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"இனியோள்","tr":"iṉiyōḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"இனி","tr":"iṉi"},{"kind":"nēr","text":"யோள்","tr":"yōḷ"}]},{"text":"குணனும்","tr":"kuṇaṉum","foot":"puḷimā","acai":[{"kind":"nirai","text":"குண","tr":"kuṇa"},{"kind":"nēr","text":"னும்","tr":"ṉum"}]},{"text":"இன்ன","tr":"iṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"இன்","tr":"iṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]}],[{"text":"இன்னா","tr":"iṉṉā","foot":"tēmā","acai":[{"kind":"nēr","te