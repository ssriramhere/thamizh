{"text":"kuruntokai","n":221,"lines":["அவரோ வாரார் முல்லையும் பூத்தன","பறியுடைக் கையர் மறியினத் தொழியப்","பாலொடு வந்து கூழொடு பெயரும்","யாடுடை இடைமகன் சென்னிச்","சூடிய வெல்லாம் சிறுபசு முகையே"],"tr":["avarō vārār mullaiyum pūttaṉa","paṟiyuṭaik kaiyar maṟiyiṉat toḻiyap","pāloṭu vantu kūḻoṭu peyarum","yāṭuṭai iṭaimakaṉ ceṉṉic","cūṭiya vellām ciṟupacu mukaiyē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"உறையூர் முதுகொற்றனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Uṟaiyūr Mutukoṟṟaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 7"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அவரோ","tr":"avarō","foot":"puḷimā","acai":[{"kind":"nirai","text":"அவ","tr":"ava"},{"kind":"nēr","text":"ரோ","tr":"rō"}]},{"text":"வாரார்","tr":"vārār","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ரார்","tr":"rār"}]},{"text":"முல்லையும்","tr":"mullaiyum","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"முல்","tr":"mul"},{"kind":"nēr","text":"லை","tr":"lai"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"பூத்தன","tr":"pūttaṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பூத்","tr":"pūt"},{"kind":"nirai","text":"தன","tr":"taṉa"}]}],[{"text":"பறியுடைக்","tr":"paṟiyuṭaik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பறி","tr":"paṟi"},{"kind":"nirai","text":"யுடைக்","tr":"yuṭaik"}]},{"text":"கையர்","tr":"kaiyar","foot":"tēmā","acai":[{"kind":"nēr","text":"கை","tr":"kai"},{"kind":"nēr","text":"யர்","tr":"yar"}]},{"text":"மறியினத்","tr":"maṟiyiṉat","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மறி","tr":"maṟi"},{"kind":"nirai","text":"யினத்","tr":"yiṉat"}]},{"text":"தொழியப்","tr":"toḻiyap","foot":"puḷimā","acai":[{"ki