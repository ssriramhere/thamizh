,"tr":"kō"},{"kind":"nirai","text":"வலர்","tr":"valar"}]},{"text":"கண்ணிச்","tr":"kaṇṇic","foot":"tēmā","acai":[{"kind":"nēr","text":"கண்","tr":"kaṇ"},{"kind":"nēr","text":"ணிச்","tr":"ṇic"}]}],[{"text":"சொல்லுப","tr":"collupa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சொல்","tr":"col"},{"kind":"nirai","text":"லுப","tr":"lupa"}]},{"text":"அன்ன","tr":"aṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"அன்","tr":"aṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"முல்லைமென்","tr":"mullaimeṉ","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"முல்","tr":"mul"},{"kind":"nēr","text":"லை","tr":"lai"},{"kind":"nēr","text":"மென்","tr":"meṉ"}]},{"text":"முகையே","tr":"mukaiyē","foot":"puḷimā","acai":[{"kind":"nirai","text":"முகை","tr":"mukai"},{"kind":"nēr","text":"யே","tr":"yē"}]}]]},"ai":{"lines":[{"words":[{"surface":"வீங்கிழை","parts":[{"text":"வீங்கு","lemma":"vīṅku","gloss":"tight"},{"text":"இழை","lemma":"iḻai","gloss":"jewels"}],"gloss":"tight jewels"},{"surface":"நெகிழ","parts":[{"text":"நெகிழ்","lemma":"nekiḻ","gloss":"loosen"},{"text":"அ","lemma":"a","gloss":"infinitive suffix"}],"gloss":"to slip"},{"surface":"விம்மி","parts":[{"text":"விம்மு","lemma":"vimmu","gloss":"sob"},{"text":"இ","lemma":"i","gloss":"past participle suffix"}],"gloss":"sobbing"},{"surface":"ஈங்கே","parts":[{"text":"ஈங்கு","lemma":"īṅku","gloss":"here"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"right here"}]},{"words":[{"surface":"எறிகண்","parts":[{"text":"எறி","lemma":"eṟi","gloss":"troubled"},{"text":"கண்","lemma":"kaṇ","gloss":"eye"}],"gloss":"troubled eyes"},{"surface":"பேதுறல்","parts":[{"text":"பேது","lemma":"pētu","gloss":"distress"},{"text":"உறல்","lemma":"uṟal","gloss":"experiencing"}],"gloss":"being bewildered"},{"surface":"ஆய்கோடு","parts":[{"text":"ஆய்","lemma":"āy","gloss":"beautiful"},{"text":"கோடு","lemma":"kōṭu","gloss":"line"}],"gloss":"beautiful lines"},{"surface":"இட்டு","parts":[{"text":"இட்டு","lemma":"இட்டு","gloss":"drawing"}],"gloss":"drawing","split_unverified":true}]},{"words":[{"surface":"சுவர்வாய்","parts":[{"text":"சுவர்","lemma":"cuvar","gloss":"wall"},{"text":"வாய்","lemma":"vāy","gloss":"surface"}],"gloss":"wall surface"},{"surface":"பற்று","parts":[{"text":"பற்று","lemma":"paṟṟu","gloss":"touching"}],"gloss":"touching"},{"surface":"நின்","parts":[{"text":"நின்","lemma":"niṉ","gloss":"your"}],"gloss":"your"},{"surface":"படர்","parts":[{"text":"படர்","lemma":"paṭar","gloss":"grief"}],"gloss":"grief"},{"surface":"சேண்","parts":[{"text":"சேண்","lemma":"cēṇ","gloss":"distance"}],"gloss":"far away"},{"surface":"நீங்க","parts":[{"text":"நீங்கு","lemma":"nīṅku","gloss":"leave"},{"text":"அ","lemma":"a","gloss":"infinitive suffix"}],"gloss":"to depart"}]},{"words":[{"surface":"வருவேம்","parts":[{"text":"வரு","lemma":"varu","gloss":"come"},{"text":"வ்","lemma":"v","gloss":"future tense marker"},{"text":"ஏம்","lemma":"ēm","gloss":"we (first person plural)"}],"gloss":"we will return"},{"surface":"என்ற","parts":[{"text":"என்","lemma":"eṉ","gloss":"say"},{"text":"ற்","lemma":"ṟ","gloss":"past tense marker"},{"text":"அ","lemma":"a","gloss":"relative participle suffix"}],"gloss":"said"},{"surface":"பருவம்","parts":[{"text":"பருவம்","lemma":"paruvam","gloss":"season"}],"gloss":"season"},{"surface":"உதுக்காண்","parts":[{"text":"உது","lemma":"utu","gloss":"that there"},{"text":"காண்","lemma":"kāṇ","gloss":"see"}],"gloss":"look there"}]},{"words":[{"surface":"தனியோர்","parts":[{"text":"தனி","lemma":"taṉi","gloss":"alone"},{"text":"ஓர்","lemma":"ōr","gloss":"people"}],"gloss":"lonely people"},{"surface":"இரங்கும்","parts":[{"text":"இரங்கு","lemma":"iraṅku","gloss":"lament"},{"text":"உம்","lemma":"um","gloss":"relative participle suffix"}],"gloss":"lamenting"},{"surface":"பனிகூர்","parts":[{"text":"பனி","lemma":"paṉi","gloss":"dew"},{"text":"கூர்","lemma":"kūr","gloss":"abundant"}],"gloss":"cold-abounding"},{"surface":"மாலை","parts":[{"text":"மாலை","lemma":"mālai","gloss":"evening"}],"gloss":"evening"}]},{"words":[{"surface":"பல்லான்","parts":[{"text":"பல்","lemma":"pal","gloss":"many"},{"text":"ஆன்","lemma":"āṉ","gloss":"cow"}],"gloss":"many cows"},{"surface":"கோவலர்","parts":[{"text":"கோவலர்","lemma":"kōvalar","gloss":"cowherds"}],"gloss":"cowherds"},{"surface":"கண்ணி","parts":[{"text":"கண்ணி","lemma":"kaṇṇi","gloss":"chaplet"}],"gloss":"chaplet"}]},{"words":[{"surface":"சொல்லுப","parts":[{"text":"சொல்","lemma":"col","gloss":"say"},{"text":"உப","lemma":"upa","gloss":"they (plural suffix)"}],"gloss":"they speak"},{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"aṉṉa","gloss":"as if"}],"gloss":"as if"},{"surface":"முல்லைமென்","parts":[{"text":"முல்லைமென்","lemma":"முல்லைமென்","gloss":"soft jasmine"}],"gloss":"soft jasmine","split_unverified":true},{"surface":"முகையே","parts":[{"text":"முகை","lemma":"mukai","gloss":"bud"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"buds indeed"}]}],"literal":"Tight jewels slipping, sobbing right here, / troubled eyes being bewildered, drawing beautiful lines / touching the wall's surface, so that your far-reaching grief departs, / 'We will return,' he said, that season, look there! / Lonely people lamenting, in the cold-abounding evening, / of the cowherds with many cows, on their chaplets, / as if they are speaking, are the soft buds of jasmine!","translation":"Look there! The season has arrived, the very one he promised when he said, 'We will return.' Do not sob right here, making your tight jewels slip and your troubled eyes bewildered, drawing lines on the wall to count the days. So that your deep grief departs, look at the soft jasmine buds on the chaplets of the cowherds who tend many cows; in this cold-abounding evening when lonely hearts lament, those buds seem to speak, assuring his return.","modern":"அணிந்திருக்கும் இறுக்கமான அணிகலன்கள் நெகிழ்ந்து கழல, அழுதுகொண்டே இங்கே, கலங்கிய கண்கள் தடுமாற, சுவரில் நாட்களைக் கணக்கிட்டுக் கோடுகளை வரைந்து வருந்தாதே. உன்னுடைய துன்பம் நீங்குமாறு, 'நாம் திரும்பி வருவோம்' என்று அவர் கூறிச் சென்ற கார்ப்பருவம் இதோ வந்துவிட்டது பார்! துணையற்ற தனிமையில் இருப்போர் வருந்தும் இந்தக் குளிர்ந்த மாலையில், பல பசுக்களை மேய்க்கும் ஆயர்கள் சூடியுள்ள மாலைகளில் உள்ள மென்மையான முல்லை அரும்புகள், தலைவன் வருவதை நமக்குச் சொல்வது போல மலர்கின்றன.","explanation":"This poem is set in the Mullai tiṇai (pastoral landscape), which represents patient waiting during the rainy season. The confidante (tōḻi) speaks to the grieving heroine (thalaivi) who is weeping and drawing lines on the wall to count the days since her lover's departure. The friend points out that the promised season of his return has arrived, marked by the cool evening and the blooming of jasmine. She draws attention to the soft jasmine buds worn by the cowherds, which look as if they are speaking to reassure the heroine. By highlighting these natural signs, the friend comforts the heroine and urges her to stop grieving, as her lover's return is imminent.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,1.2],[1.2,1.5],[1.6,2.0],[2.83,2.95],[2.95,2.95],[2.95,3.42],[3.42,3.8],[3.8,3.8],[3.8,4.32],[4.32,4.32],[4.32,6.4],[6.4,7.1],[7.1,7.4],[7.4,7.8],[7.8,7.9],[7.9,9.3],[9.3,9.4],[9.4,9.63],[9.63,9.63],[9.63,11.0],[11.0,11.5],[11.5,11.6],[11.6,12.44],[12.9,13.2],[13.2,13.6],[13.6,14.0]],"female":[[0.0,0.8],[0.8,1.2],[1.2,1.5],[1.58,1.9],[1.9,2.83],[3.07,3.3],[3.3,3.74],[3.83,4.3],[4.3,5.4],[5.4,6.0],[6.0,6.33],[6.6,7.0],[7.0,7.9],[7.9,8.2],[8.2,8.7],[8.7,8.8],[8.8,10.4],[10.4,10.4],[10.4,11.3],[11.3,11.97],[11.97,12.4],[12.4,13.0],[13.0,13.2],[13.2,13.88],[13.88,14.9],[14.9,14.97],[14.97,15.0]]}}