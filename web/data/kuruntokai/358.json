{"text":"kuruntokai","n":358,"lines":["வீங்கிழை நெகிழ விம்மி யீங்கே","எறிகண் பேதுற லாய்கோ டிட்டுச்","சுவர்வாய் பற்றுநின் படர்சே ணீங்க","வருவேம் என்ற பருவம் உதுக்காண்","தனியோர் இரங்கும் பனிகூர் மாலைப்","பல்லான் கோவலர் கண்ணிச்","சொல்லுப அன்ன முல்லைமென் முகையே"],"tr":["vīṅkiḻai nekiḻa vimmi yīṅkē","eṟikaṇ pētuṟa lāykō ṭiṭṭuc","cuvarvāy paṟṟuniṉ paṭarcē ṇīṅka","varuvēm eṉṟa paruvam utukkāṇ","taṉiyōr iraṅkum paṉikūr mālaip","pallāṉ kōvalar kaṇṇic","collupa aṉṉa mullaimeṉ mukaiyē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தோழி கூற்று","poet_ta":"கொற்றனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Koṟṟaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 11, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வீங்கிழை","tr":"vīṅkiḻai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வீங்","tr":"vīṅ"},{"kind":"nirai","text":"கிழை","tr":"kiḻai"}]},{"text":"நெகிழ","tr":"nekiḻa","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெகி","tr":"neki"},{"kind":"nēr","text":"ழ","tr":"ḻa"}]},{"text":"விம்மி","tr":"vimmi","foot":"tēmā","acai":[{"kind":"nēr","text":"விம்","tr":"vim"},{"kind":"nēr","text":"மி","tr":"mi"}]},{"text":"யீங்கே","tr":"yīṅkē","foot":"tēmā","acai":[{"kind":"nēr","text":"யீங்","tr":"yīṅ"},{"kind":"nēr","text":"கே","tr":"kē"}]}],[{"text":"எறிகண்","tr":"eṟikaṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"எறி","tr":"eṟi"},{"kind":"nēr","text":"கண்","tr":"kaṇ"}]},{"text":"பேதுற","tr":"pētuṟa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பே","tr":"pē"},{"kind":"nirai","text":"துற","tr":"tuṟa"}]},{"text":"லாய்கோ","tr":"lāykō","foot":"tēmā","acai":[{"kind":"nēr","text":"லாய்","tr":"lāy"},{"kind":"nēr","text":"கோ","tr":"kō"}]},{"text":"டிட்டுச்","tr":"ṭiṭṭuc",