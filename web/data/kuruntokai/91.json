{"text":"kuruntokai","n":91,"lines":["அரிற்பவர்ப் பிரம்பின் வரிப்புற விளைகனி","குண்டுநீ ரிலஞ்சிக் கெண்டை கதூஉம்","தண்டுறை ஊரன் பெண்டினை யாயிற்","பலவா குகநின் நெஞ்சிற் படரே","ஓவா தீயு மாரி வண்கைக்","கடும்பகட் டியானை நெடுந்தே ரஞ்சி","கொன்முனை இரவூர் போலச்","சிலவா குகநீ துஞ்சு நாளே"],"tr":["ariṟpavarp pirampiṉ varippuṟa viḷaikaṉi","kuṇṭunī rilañcik keṇṭai katūum","taṇṭuṟai ūraṉ peṇṭiṉai yāyiṟ","palavā kukaniṉ neñciṟ paṭarē","ōvā tīyu māri vaṇkaik","kaṭumpakaṭ ṭiyāṉai neṭuntē rañci","koṉmuṉai iravūr pōlac","cilavā kukanī tuñcu nāḷē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தலைவி கூற்று","poet_ta":"ஔவையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 31"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 12"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அரிற்பவர்ப்","tr":"ariṟpavarp","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அரிற்","tr":"ariṟ"},{"kind":"nirai","text":"பவர்ப்","tr":"pavarp"}]},{"text":"பிரம்பின்","tr":"pirampiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிரம்","tr":"piram"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]},{"text":"வரிப்புற","tr":"varippuṟa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வரிப்","tr":"varip"},{"kind":"nirai","text":"புற","tr":"puṟa"}]},{"text":"விளைகனி","tr":"viḷaikaṉi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விளை","tr":"viḷai"},{"kind":"nirai","text":"கனி","tr":"kaṉi"}]}],[{"text":"குண்டுநீ","tr":"kuṇṭunī","foot":"kūviḷam","acai":[{"kind":"nēr","text":"குண்","tr":"kuṇ"},{"kind":"nirai","text":"டுநீ","tr":"ṭunī"}]},{"text":"ரிலஞ்சிக்","tr":"rilañcik","foot":"puḷimā","acai":[{"kind":"nirai","text":"ரிலஞ்","tr":"rilañ"},{"kind":"nēr","text":"சிக்","tr":"cik"}]},{"text":"கெண்டை","tr":"keṇṭai","foot":"tēmā",