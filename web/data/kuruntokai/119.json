{"text":"kuruntokai","n":119,"lines":["சிறுவெள் ளரவின் அவ்வரிக் குருளை","கான யானை அணங்கி யாஅங்கு","இளையள் முளைவாள் எயிற்றள்","வளையுடைக் கையள்எம் அணங்கி யோளே"],"tr":["ciṟuveḷ ḷaraviṉ avvarik kuruḷai","kāṉa yāṉai aṇaṅki yāaṅku","iḷaiyaḷ muḷaivāḷ eyiṟṟaḷ","vaḷaiyuṭaik kaiyaḷem aṇaṅki yōḷē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"சத்திநாதனார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Cattinātaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 13, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 6, āciriyattaḷai 6, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"சிறுவெள்","tr":"ciṟuveḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nēr","text":"வெள்","tr":"veḷ"}]},{"text":"ளரவின்","tr":"ḷaraviṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"ளர","tr":"ḷara"},{"kind":"nēr","text":"வின்","tr":"viṉ"}]},{"text":"அவ்வரிக்","tr":"avvarik","foot":"kūviḷam","acai":[{"kind":"nēr","text":"அவ்","tr":"av"},{"kind":"nirai","text":"வரிக்","tr":"varik"}]},{"text":"குருளை","tr":"kuruḷai","foot":"puḷimā","acai":[{"kind":"nirai","text":"குரு","tr":"kuru"},{"kind":"nēr","text":"ளை","tr":"ḷai"}]}],[{"text":"கான","tr":"kāṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"யானை","tr":"yāṉai","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னை","tr":"ṉai"}]},{"text":"அணங்கி","tr":"aṇaṅki","foot":"puḷimā","acai":[{"kind":"nirai","text":"அணங்","tr":"aṇaṅ"},{"kind":"nēr","text":"கி","tr":"ki"}]},{"text":"யாஅங்கு","tr":"yāaṅku","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"அங்","tr":"aṅ"},{"kind":"nēr","text":"கு","tr":"ku"}]}],[{"text":"இளையள்","tr":"iḷaiyaḷ","f