{"text":"kuruntokai","n":377,"lines":["மலரேர் உண்கண் மாணலந் தொலைய","வளையேர் மென்றோள் ஞெகிழ்ந்ததன் தலையும்","மாற்றா கின்றே தோழியாற் றலையே","அறிதற் கமையா நாடனொடு","செய்து கொண்டதோர் சிறுநன் னட்பே"],"tr":["malarēr uṇkaṇ māṇalan tolaiya","vaḷaiyēr meṉṟōḷ ñekiḻntataṉ talaiyum","māṟṟā kiṉṟē tōḻiyāṟ ṟalaiyē","aṟitaṟ kamaiyā nāṭaṉoṭu","ceytu koṇṭatōr ciṟunaṉ ṉaṭpē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"மோசி கொற்றனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Mōci Koṟṟaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 5"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மலரேர்","tr":"malarēr","foot":"puḷimā","acai":[{"kind":"nirai","text":"மல","tr":"mala"},{"kind":"nēr","text":"ரேர்","tr":"rēr"}]},{"text":"உண்கண்","tr":"uṇkaṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"உண்","tr":"uṇ"},{"kind":"nēr","text":"கண்","tr":"kaṇ"}]},{"text":"மாணலந்","tr":"māṇalan","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"ணலந்","tr":"ṇalan"}]},{"text":"தொலைய","tr":"tolaiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"தொலை","tr":"tolai"},{"kind":"nēr","text":"ய","tr":"ya"}]}],[{"text":"வளையேர்","tr":"vaḷaiyēr","foot":"puḷimā","acai":[{"kind":"nirai","text":"வளை","tr":"vaḷai"},{"kind":"nēr","text":"யேர்","tr":"yēr"}]},{"text":"மென்றோள்","tr":"meṉṟōḷ","foot":"tēmā","acai":[{"kind":"nēr","text":"மென்","tr":"meṉ"},{"kind":"nēr","text":"றோள்","tr":"ṟōḷ"}]},{"text":"ஞெகிழ்ந்ததன்","tr":"ñekiḻntataṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"ஞெகிழ்ந்","tr":"ñekiḻn"},{"kind":"nirai","text":"ததன்","tr":"tataṉ"}]},{"text":"தலையும்","tr":"talaiyum","foot":"puḷimā","acai":[{"kind":"nirai","text":"தலை","tr":"talai"},{"kind