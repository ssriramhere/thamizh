{"text":"kuruntokai","n":258,"lines":["வாரலெஞ் சேரி தாரனின் றாரே","அலரா கின்றாற் பெரும காவிரிப்","பலராடு பெருந்துறை மருதொடு பிணித்த","ஏந்துகோட் டியானைச் சேந்தன் தந்தை","அரியலம் புகவி னந்தோட்டு வேட்டை","நிரைய ஒள்வாள் இளைஞர் பெருமகன்","அழிசி ஆர்க்கா டன்ன விவள்","பழிதீர் மாணலந் தொலைதல் கண்டே"],"tr":["vāraleñ cēri tāraṉiṉ ṟārē","alarā kiṉṟāṟ peruma kāvirip","palarāṭu peruntuṟai marutoṭu piṇitta","ēntukōṭ ṭiyāṉaic cēntaṉ tantai","ariyalam pukavi ṉantōṭṭu vēṭṭai","niraiya oḷvāḷ iḷaiñar perumakaṉ","aḻici ārkkā ṭaṉṉa vivaḷ","paḻitīr māṇalan tolaital kaṇṭē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தோழி கூற்று","poet_ta":"பரணர்","speaker_en":"her friend (tōḻi)","poet_tr":"Paraṇar"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"8×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 29, veṇcīr 2, other 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 19, veṇṭaḷai 10, kalittaḷai 1, ? 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வாரலெஞ்","tr":"vāraleñ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nirai","text":"ரலெஞ்","tr":"raleñ"}]},{"text":"சேரி","tr":"cēri","foot":"tēmā","acai":[{"kind":"nēr","text":"சே","tr":"cē"},{"kind":"nēr","text":"ரி","tr":"ri"}]},{"text":"தாரனின்","tr":"tāraṉiṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nirai","text":"ரனின்","tr":"raṉiṉ"}]},{"text":"றாரே","tr":"ṟārē","foot":"tēmā","acai":[{"kind":"nēr","text":"றா","tr":"ṟā"},{"kind":"nēr","text":"ரே","tr":"rē"}]}],[{"text":"அலரா","tr":"alarā","foot":"puḷimā","acai":[{"kind":"nirai","text":"அல","tr":"ala"},{"kind":"nēr","text":"ரா","tr":"rā"}]},{"text":"கின்றாற்","tr":"kiṉṟāṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"கின்","tr":"kiṉ"},{"kind":"nēr","text":"றாற்","tr":"ṟāṟ"}]},{"text":"பெரும","tr":"peruma","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெரு","tr":"per