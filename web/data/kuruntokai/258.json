loss":"he-who-has"}],"gloss":"he who has a garland"},{"surface":"நின்றாரே","parts":[{"text":"நின்றாரே","lemma":"நின்றாரே","gloss":"they stood indeed"}],"gloss":"they stood indeed","split_unverified":true}]},{"words":[{"surface":"அலரா","parts":[{"text":"அலரா","lemma":"அலரா","gloss":""}],"gloss":"","split_unverified":true},{"surface":"கின்றாற்","parts":[{"text":"கின்றாற்","lemma":"கின்றாற்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"பெரும","parts":[{"text":"பெரும","lemma":"பெரும","gloss":""}],"gloss":"","split_unverified":true},{"surface":"காவிரிப்","parts":[{"text":"காவிரிப்","lemma":"காவிரிப்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"பலராடு","parts":[{"text":"பலராடு","lemma":"பலராடு","gloss":""}],"gloss":"","split_unverified":true},{"surface":"பெருந்துறை","parts":[{"text":"பெருந்துறை","lemma":"பெருந்துறை","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மருதொடு","parts":[{"text":"மருதொடு","lemma":"மருதொடு","gloss":""}],"gloss":"","split_unverified":true},{"surface":"பிணித்த","parts":[{"text":"பிணித்த","lemma":"பிணித்த","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"ஏந்துகோட்","parts":[{"text":"ஏந்துகோட்","lemma":"ஏந்துகோட்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"டியானைச்","parts":[{"text":"டியானைச்","lemma":"டியானைச்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"சேந்தன்","parts":[{"text":"சேந்தன்","lemma":"சேந்தன்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தந்தை","parts":[{"text":"தந்தை","lemma":"தந்தை","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"அரியலம்","parts":[{"text":"அரியலம்","lemma":"அரியலம்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"புகவி","parts":[{"text":"புகவி","lemma":"புகவி","gloss":""}],"gloss":"","split_unverified":true},{"surface":"னந்தோட்டு","parts":[{"text":"னந்தோட்டு","lemma":"னந்தோட்டு","gloss":""}],"gloss":"","split_unverified":true},{"surface":"வேட்டை","parts":[{"text":"வேட்டை","lemma":"வேட்டை","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"நிரைய","parts":[{"text":"நிரைய","lemma":"nirai","gloss":"in rows/abundant"}],"gloss":"in rows"},{"surface":"ஒள்","parts":[{"text":"ஒள்","lemma":"oḷ","gloss":"bright"}],"gloss":"bright"},{"surface":"வாள்","parts":[{"text":"வாள்","lemma":"vāḷ","gloss":"sword"}],"gloss":"sword"},{"surface":"இளைஞர்","parts":[{"text":"இளைஞர்","lemma":"iḷaiñar","gloss":"young men"}],"gloss":"young men"},{"surface":"பெருமகன்","parts":[{"text":"பெரு","lemma":"peru","gloss":"great"},{"text":"மகன்","lemma":"makaṉ","gloss":"son/leader"}],"gloss":"great leader"}]},{"words":[{"surface":"அழிசி","parts":[{"text":"அழிசி","lemma":"aḦici","gloss":"AḦici (proper name)"}],"gloss":"AḦici"},{"surface":"ஆர்க்காடு","parts":[{"text":"ஆர்க்காடு","lemma":"ārkkāṭu","gloss":"Ārkkāṭu (place name)"}],"gloss":"Ārkkāṭu"},{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"anna","gloss":"like"}],"gloss":"like"},{"surface":"இவள்","parts":[{"text":"இவள்","lemma":"ivaḷ","gloss":"she/this woman"}],"gloss":"this woman"}]},{"words":[{"surface":"பழிதீர்","parts":[{"text":"பழிதீர்","lemma":"பழிதீர்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மாணலந்","parts":[{"text":"மாணலந்","lemma":"மாணலந்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தொலைதல்","parts":[{"text":"தொலைதல்","lemma":"தொலைதல்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"கண்டே","parts":[{"text":"கண்டே","lemma":"கண்டே","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true}],"literal":"Do not come to our street, O one with a garland! / Gossip is arising, O Lord, like the Kaveri / where many bathe at the great ghat, bound to the marutam tree / by the elephant with uplifted tusks of Cēntaṉ's father, / who has feasts of toddy and hunts with a group / of young men with rows of bright swords, the great leader / AḦici's Ārkkāṭu, like which is her / faultless, great beauty, seeing it waste away.","translation":"Do not come to our street, O lord wearing a garland! Gossip is spreading, O chief, like the great ghat of the Kaveri river where many bathe, where the elephant with uplifted tusks belonging to the father of Cēntaṉ—who feasts on toddy and hunts with a band of young men bearing rows of bright swords, the great leader AḦici—was bound to a marutam tree. Seeing her faultless, great beauty waste away like this, gossip is arising.","modern":"மாலை அணிந்த தலைவனே! எங்களது தெருவுக்கு வராதே. பலரும் நீராடும் காவிரியின் பெரிய துறையிலே, கள்ளுண்ட களிப்போடு பிரகாசிக்கும் வாளேந்திய இளைஞர்களோடு வேட்டையாடும் தலைவனான அழிசியின் (சேந்தனின் தந்தை) ஏந்திய தந்தங்களை உடைய யானையைக் கட்டிப்போட்ட மருத மரத்தைக் கொண்ட ஆர்க்காடு என்னும் ஊரைப் போலப் புகழ்பெற்ற இவளது குற்றமற்ற சிறந்த அழகு சிதைந்து போவதைக் கண்டு, இவ்வூரில் அலர் (பழிச்சொல்) எழுகின்றது.","explanation":"The speaker is the heroine's friend (தோழி) addressing the hero (தலைவன்) who has returned from his trysts with courtesans. She tells him not to enter their street because gossip (அலர்) is already spreading about his neglect of the heroine. She compares the widespread gossip to the busy ghats of the Kaveri river in Ārkkāṭu, a city ruled by the chieftain AḦici (father of Cēntaṉ). Just as the great elephant of AḦici was tied to a marutam tree at the river ghat, the heroine's beauty is now bound and ruined by public scandal. The imagery of the marutam tree and the river ghat perfectly fits the Marutam tiṇai (agricultural landscape), which deals with infidelity and the resulting sulking.","model":"gemini-3.5-flash"}}