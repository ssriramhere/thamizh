{"text":"kuruntokai","n":263,"lines":["மறிக்குர லறுத்துத் தினைப்பிரப் பிரீஇச்","செல்லாற்றுக் கவலைப் பல்லியங் கறங்கத்","தோற்ற மல்லது நோய்க்குமருந் தாகா","வேற்றுப் பெருந் தெய்வம் பலவுடன் வாழ்த்திப்","பேஎய்க் கொளீஇயள் இவளெனப் படுதல்","நோதக் கன்றே தோழி மால்வரை","மழைவிளை யாடு நாடனைப்","பிழையே மாகிய நாமிதற் படவே"],"tr":["maṟikkura laṟuttut tiṉaippirap pirīic","cellāṟṟuk kavalaip palliyaṅ kaṟaṅkat","tōṟṟa mallatu nōykkumarun tākā","vēṟṟup perun teyvam palavuṭaṉ vāḻttip","pēeyk koḷīiyaḷ ivaḷeṉap paṭutal","nōtak kaṉṟē tōḻi mālvarai","maḻaiviḷai yāṭu nāṭaṉaip","piḻaiyē mākiya nāmitaṟ paṭavē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"பெருஞ்சாத்தனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Peruñcāttaṉār"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"1×5, 6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 29, veṇcīr 2, other 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 20, veṇṭaḷai 9, kalittaḷai 1, ? 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"1 five-foot line (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"மறிக்குர","tr":"maṟikkura","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மறிக்","tr":"maṟik"},{"kind":"nirai","text":"குர","tr":"kura"}]},{"text":"லறுத்துத்","tr":"laṟuttut","foot":"puḷimā","acai":[{"kind":"nirai","text":"லறுத்","tr":"laṟut"},{"kind":"nēr","text":"துத்","tr":"tut"}]},{"text":"தினைப்பிரப்","tr":"tiṉaippirap","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தினைப்","tr":"tiṉaip"},{"kind":"nirai","text":"பிரப்","tr":"pirap"}]},{"text":"பிரீஇச்","tr":"pirīic","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிரீ","tr":"pirī"},{"kind":"nēr","text":"இச்","tr":"ic"}]}],[{"text":"செல்லாற்றுக்","tr":"cellāṟṟuk","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"செல்","tr":"cel"},{"kind":"nēr","text":"லாற்","tr":"lāṟ"},{"kind":"nēr","text":"றுக்","t