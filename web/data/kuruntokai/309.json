{"text":"kuruntokai","n":309,"lines":["கைவினை மாக்கடம் செய்வினை முடிமார்","சுரும்புண மலர்ந்த வாசங் கீழ்ப்பட","நீடின வரம்பின் வாடிய விடினும்","கொடியரோ நிலம்பெயர்ந் துறைவே மென்னாது","பெயர்த்துங் கடிந்த செறுவிற் பூக்கும்","நின்னூர் நெய்த லனையேம் பெரும","நீயெமக் கின்னா தனபல செய்யினும்","நின்னின் றமைதல் வல்லா மாறே"],"tr":["kaiviṉai mākkaṭam ceyviṉai muṭimār","curumpuṇa malarnta vācaṅ kīḻppaṭa","nīṭiṉa varampiṉ vāṭiya viṭiṉum","koṭiyarō nilampeyarn tuṟaivē meṉṉātu","peyarttuṅ kaṭinta ceṟuviṟ pūkkum","niṉṉūr neyta laṉaiyēm peruma","nīyemak kiṉṉā taṉapala ceyyiṉum","niṉṉiṉ ṟamaital vallā māṟē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தோழி கூற்று","poet_ta":"உறையூர்ச் சல்லியன் குமாரனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Uṟaiyūrc Calliyaṉ Kumāraṉār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"8×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 31, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 14, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கைவினை","tr":"kaiviṉai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கை","tr":"kai"},{"kind":"nirai","text":"வினை","tr":"viṉai"}]},{"text":"மாக்கடம்","tr":"mākkaṭam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மாக்","tr":"māk"},{"kind":"nirai","text":"கடம்","tr":"kaṭam"}]},{"text":"செய்வினை","tr":"ceyviṉai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"செய்","tr":"cey"},{"kind":"nirai","text":"வினை","tr":"viṉai"}]},{"text":"முடிமார்","tr":"muṭimār","foot":"puḷimā","acai":[{"kind":"nirai","text":"முடி","tr":"muṭi"},{"kind":"nēr","text":"மார்","tr":"mār"}]}],[{"text":"சுரும்புண","tr":"curumpuṇa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சுரும்","tr":"curum"},{"kind":"nirai","text":"புண","tr":"puṇa"}]},{"text":"மலர்ந்த","tr":"malarnta","foot":"puḷimā","acai":[{"kind":"nirai","text":"மலர்ந்","tr":"m