air"}],"gloss":"tresses"}]},{"words":[{"surface":"நிரந்து","parts":[{"text":"நிரந்து","lemma":"நிரவு","gloss":"having aligned in order"}],"gloss":"having aligned in order"},{"surface":"இலங்கு","parts":[{"text":"இலங்கு","lemma":"இலங்கு","gloss":"shining"}],"gloss":"shining"},{"surface":"வெண்","parts":[{"text":"வெண்","lemma":"வெண்மை","gloss":"white"}],"gloss":"white"},{"surface":"பல்","parts":[{"text":"பல்","lemma":"பல்","gloss":"tooth"}],"gloss":"teeth"},{"surface":"மடந்தை","parts":[{"text":"மடந்தை","lemma":"மடந்தை","gloss":"young woman"}],"gloss":"young woman"}]},{"words":[{"surface":"பரிந்தனென்","parts":[{"text":"பரிந்தனென்","lemma":"பரிந்தனென்","gloss":"I suffered / I pitied"}],"gloss":"I suffered / I pitied","split_unverified":true},{"surface":"அல்லனோ","parts":[{"text":"அல்","lemma":"அல்","gloss":"not"},{"text":"அன்","lemma":"அன்","gloss":"singular marker"},{"text":"ஓ","lemma":"ஓ","gloss":"interrogative clitic"}],"gloss":"am I not?"},{"surface":"இறை","parts":[{"text":"இறை","lemma":"இறை","gloss":"little/drop"}],"gloss":"little"},{"surface":"இறை","parts":[{"text":"இறை","lemma":"இறை","gloss":"little/drop"}],"gloss":"little"},{"surface":"யானே","parts":[{"text":"யான்","lemma":"யான்","gloss":"I"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"I indeed"}]}],"literal":"On the mountain slope where water glistens and roaring elephants tread, / seeing you shiver as if possessed by the deity Sūr, / with thick, dark tresses smelling of fragrant lemon grass, / O young woman with orderly, shining white teeth, / did I not feel pity and suffer, bit by bit?","translation":"On the water-glistening mountain slopes where roaring elephants tread, seeing you shiver as if possessed by the sacred mountain deity, O young woman with orderly, shining white teeth and thick, dark tresses fragrant with lemon grass, did I not suffer and feel pity for you, bit by bit?","modern":"ஒலிக்கும் ஆண் யானைகள் மிதித்த, நீர் விளங்கும் மலைச்சரிவிலே, மலையினது தெய்வமாகிய சூர்மகள் விரும்பியவள் போல நீ நடுங்குவதைக் கண்டு, நரந்தம் புல்லின் மணம் வீசும் அடர்ந்த கரிய கூந்தலையும், வரிசையாக விளங்கும் வெண்மையான பற்களையும் உடைய பெண்ணே! நான் சிறுகச் சிறுக வருந்தினேன் அல்லவா?","explanation":"This poem belongs to the Kuriñci (mountainous) landscape and is spoken by the heroine's companion (தோழி) to the heroine (தலைவி). The hero has been visiting the heroine secretly at night, traversing dangerous mountain paths. Filled with intense anxiety for his safety, the heroine shivers uncontrollably, looking as if she is possessed by the mountain deity, Sūr. The companion comforts her by acknowledging her distress, saying she watched her shiver and shared her pain, suffering along with her bit by bit. The imagery of the glistening mountain slopes where powerful elephants tread emphasizes both the beauty and the perilous nature of the hero's journey.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.8],[0.8,1.0],[1.0,1.4],[1.4,2.1],[2.1,3.75],[3.75,4.2],[4.2,4.7],[4.7,5.3],[5.3,6.09],[6.6,6.8],[6.8,7.4],[7.4,7.9],[7.9,9.05],[9.05,9.7],[9.7,10.36],[10.36,11.34],[11.34,12.0],[12.0,12.4],[12.4,12.9]],"female":[[0.0,0.8],[0.8,1.0],[1.0,1.3],[1.3,2.2],[2.2,3.2],[3.6,4.2],[4.2,4.7],[4.7,5.0],[5.0,5.33],[5.33,7.0],[7.0,7.5],[7.5,7.9],[7.9,9.13],[9.13,9.84],[9.84,10.54],[10.54,11.6],[11.6,12.5],[12.5,12.9],[12.9,13.5]]},"sync":[[["ஆர்","roaring/strong"],["களிறு","male elephant"]],[["மிதித்த","stepped on"]],[["நீர்","water"],["திகழ்","shining"]],[["சிலம்பின்","on the mountain slope"]],[["சூர்","mountain deity/fear"],["நசைந்து","having yearned/feared"]],[["நசைந்து","having yearned/feared"],["அனையையாய்","you who are like"]],[["நடுங்கல்","shivering"]],[["கண்டே","having seen indeed"]],[["நரந்த","fragrant lemon grass"]],[["நாறும்","smelling of"]],[["குவை","thick/abundant"],["இரும்","dark/black"]],[["கூந்தல்","tresses"]],[["நிரந்து","having aligned in order"],["இலங்கு","shining"]],[["வெண்","white"],["பல்","teeth"]],[["மடந்தை","young woman"]],[["பரிந்தனென்","I suffered / I pitied"]],[["அல்லனோ","am I not?"]],[["இறை","little"],["இறை","little"]],[["யானே","I indeed"]]]}