{"text":"kuruntokai","n":249,"lines":["இனமயில் அகவு மரம்பயில் கானத்து","நரைமுக ஊகம் பார்ப்பொடு பனிப்பப்","படுமழை பொழிந்த சாரலவர் நாட்டுக்","குன்ற நோக்கினென் தோழி","பண்டை யற்றோ கண்டிசின் நுதலே"],"tr":["iṉamayil akavu marampayil kāṉattu","naraimuka ūkam pārppoṭu paṉippap","paṭumaḻai poḻinta cāralavar nāṭṭuk","kuṉṟa nōkkiṉeṉ tōḻi","paṇṭai yaṟṟō kaṇṭiciṉ nutalē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"கபிலர்","speaker_en":"the heroine (talaivi)","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 6, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இனமயில்","tr":"iṉamayil","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இன","tr":"iṉa"},{"kind":"nirai","text":"மயில்","tr":"mayil"}]},{"text":"அகவு","tr":"akavu","foot":"puḷimā","acai":[{"kind":"nirai","text":"அக","tr":"aka"},{"kind":"nēr","text":"வு","tr":"vu"}]},{"text":"மரம்பயில்","tr":"marampayil","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மரம்","tr":"maram"},{"kind":"nirai","text":"பயில்","tr":"payil"}]},{"text":"கானத்து","tr":"kāṉattu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"னத்","tr":"ṉat"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"நரைமுக","tr":"naraimuka","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நரை","tr":"narai"},{"kind":"nirai","text":"முக","tr":"muka"}]},{"text":"ஊகம்","tr":"ūkam","foot":"tēmā","acai":[{"kind":"nēr","text":"ஊ","tr":"ū"},{"kind":"nēr","text":"கம்","tr":"kam"}]},{"text":"பார்ப்பொடு","tr":"pārppoṭu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பார்ப்","tr":"pārp"},{"kind":"nirai","text":"பொடு","tr":"poṭu"}]},{"text":"பனிப்பப்","tr":"paṉippap","foot":"puḷimā","acai":[{"kin