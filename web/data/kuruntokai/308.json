{"text":"kuruntokai","n":308,"lines":["சோலை வாழைச் சுரிநுகும் பினைய","அணங்குடை அருந்தலை நீவலின் மதனழிந்து","மயங்குதுயர் உற்ற மையல் வேழம்","உயங்குயிர் மடப்பிடி யுலைபுறந் தைவர","ஆமிழி சிலம்பின் அரிதுகண் படுக்கும்","மாமலை நாடன் கேண்மை","காமந் தருவதோர் கைதாழ்ந் தன்றே"],"tr":["cōlai vāḻaic curinukum piṉaiya","aṇaṅkuṭai aruntalai nīvaliṉ mataṉaḻintu","mayaṅkutuyar uṟṟa maiyal vēḻam","uyaṅkuyir maṭappiṭi yulaipuṟan taivara","āmiḻi cilampiṉ aritukaṇ paṭukkum","māmalai nāṭaṉ kēṇmai","kāman taruvatōr kaitāḻn taṉṟē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"பெருந்தோட் குறுஞ்சாத்தனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Peruntōṭ Kuṟuñcāttaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 11, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"சோலை","tr":"cōlai","foot":"tēmā","acai":[{"kind":"nēr","text":"சோ","tr":"cō"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"வாழைச்","tr":"vāḻaic","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ழைச்","tr":"ḻaic"}]},{"text":"சுரிநுகும்","tr":"curinukum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சுரி","tr":"curi"},{"kind":"nirai","text":"நுகும்","tr":"nukum"}]},{"text":"பினைய","tr":"piṉaiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"பினை","tr":"piṉai"},{"kind":"nēr","text":"ய","tr":"ya"}]}],[{"text":"அணங்குடை","tr":"aṇaṅkuṭai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அணங்","tr":"aṇaṅ"},{"kind":"nirai","text":"குடை","tr":"kuṭai"}]},{"text":"அருந்தலை","tr":"aruntalai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அருந்","tr":"arun"},{"kind":"nirai","text":"தலை","tr":"talai"}]},{"text":"நீவலின்","tr":"nīvaliṉ","foot":"kūviḷam","acai":[