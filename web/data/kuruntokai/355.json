{"text":"kuruntokai","n":355,"lines":["பெயல்கண் மறைத்தலின் விசும்புகா ணலையே","நீர்பரந் தொழுகலின் நிலங்கா ணலையே","எல்லை சேறலின் இருள்பெரிது பட்டன்று","பல்லோர் துஞ்சும் பானாட் கங்குல்","யாங்குவந் தனையோ ஓங்கல் வெற்ப","வேங்கை கமழுமெஞ் சிறுகுடி","யாங்கறிந் தனையோ நோகோ யானே"],"tr":["peyalkaṇ maṟaittaliṉ vicumpukā ṇalaiyē","nīrparan toḻukaliṉ nilaṅkā ṇalaiyē","ellai cēṟaliṉ iruḷperitu paṭṭaṉṟu","pallōr tuñcum pāṉāṭ kaṅkul","yāṅkuvan taṉaiyō ōṅkal veṟpa","vēṅkai kamaḻumeñ ciṟukuṭi","yāṅkaṟin taṉaiyō nōkō yāṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"கபிலர்","speaker_en":"her friend (tōḻi)","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 20, veṇṭaḷai 6"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பெயல்கண்","tr":"peyalkaṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெயல்","tr":"peyal"},{"kind":"nēr","text":"கண்","tr":"kaṇ"}]},{"text":"மறைத்தலின்","tr":"maṟaittaliṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மறைத்","tr":"maṟait"},{"kind":"nirai","text":"தலின்","tr":"taliṉ"}]},{"text":"விசும்புகா","tr":"vicumpukā","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விசும்","tr":"vicum"},{"kind":"nirai","text":"புகா","tr":"pukā"}]},{"text":"ணலையே","tr":"ṇalaiyē","foot":"puḷimā","acai":[{"kind":"nirai","text":"ணலை","tr":"ṇalai"},{"kind":"nēr","text":"யே","tr":"yē"}]}],[{"text":"நீர்பரந்","tr":"nīrparan","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நீர்","tr":"nīr"},{"kind":"nirai","text":"பரந்","tr":"paran"}]},{"text":"தொழுகலின்","tr":"toḻukaliṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தொழு","tr":"toḻu"},{"kind":"nirai","text":"கலின்","tr":"kaliṉ"}]},{"text":"நிலங்கா","tr":"nilaṅkā","foot":"puḷimā","acai":[{"kind":"nirai