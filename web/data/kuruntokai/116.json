{"text":"kuruntokai","n":116,"lines":["யானயந் துறைவோள் தேம்பாய் கூந்தல்","வளங்கெழு சோழர் உறந்தைப் பெருந்துறை","நுண்மணல் அறல்வார்ந் தன்ன","நன்னெறி யவ்வே நறுந்தண் ணியவே"],"tr":["yāṉayan tuṟaivōḷ tēmpāy kūntal","vaḷaṅkeḻu cōḻar uṟantaip peruntuṟai","nuṇmaṇal aṟalvārn taṉṉa","naṉṉeṟi yavvē naṟuntaṇ ṇiyavē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"இளங்கீரனார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Iḷaṅkīraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 15"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 8, āciriyattaḷai 6"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"யானயந்","tr":"yāṉayan","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nirai","text":"னயந்","tr":"ṉayan"}]},{"text":"துறைவோள்","tr":"tuṟaivōḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"துறை","tr":"tuṟai"},{"kind":"nēr","text":"வோள்","tr":"vōḷ"}]},{"text":"தேம்பாய்","tr":"tēmpāy","foot":"tēmā","acai":[{"kind":"nēr","text":"தேம்","tr":"tēm"},{"kind":"nēr","text":"பாய்","tr":"pāy"}]},{"text":"கூந்தல்","tr":"kūntal","foot":"tēmā","acai":[{"kind":"nēr","text":"கூந்","tr":"kūn"},{"kind":"nēr","text":"தல்","tr":"tal"}]}],[{"text":"வளங்கெழு","tr":"vaḷaṅkeḻu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வளங்","tr":"vaḷaṅ"},{"kind":"nirai","text":"கெழு","tr":"keḻu"}]},{"text":"சோழர்","tr":"cōḻar","foot":"tēmā","acai":[{"kind":"nēr","text":"சோ","tr":"cō"},{"kind":"nēr","text":"ழர்","tr":"ḻar"}]},{"text":"உறந்தைப்","tr":"uṟantaip","foot":"puḷimā","acai":[{"kind":"nirai","text":"உறந்","tr":"uṟan"},{"kind":"nēr","text":"தைப்","tr":"taip"}]},{"text":"பெருந்துறை","tr":"peruntuṟai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெருந்","tr":"perun"},{"kind":"nirai","text":"துறை","tr":"tuṟai"}]}],[{"text":"நுண்மணல்","tr":"nu