{"text":"kuruntokai","n":386,"lines":["வெண்மணல் விரிந்த வீததை கானல்","தண்ணந் துறைவன் தணவா ஊங்கே","வாலிழை மகளிர் விழவணிக் கூட்டும்","மாலையோ அறிவேன் மன்னே மாலை","நிலம்பரந் தன்ன புன்கணொடு","புலம்புடைத் தாகுதல் அறியேன் யானே"],"tr":["veṇmaṇal virinta vītatai kāṉal","taṇṇan tuṟaivaṉ taṇavā ūṅkē","vāliḻai makaḷir viḻavaṇik kūṭṭum","mālaiyō aṟivēṉ maṉṉē mālai","nilamparan taṉṉa puṉkaṇoṭu","pulampuṭait tākutal aṟiyēṉ yāṉē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"வெள்ளிவீதியார்","speaker_en":"the heroine (talaivi)","poet_tr":"Veḷḷivītiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 8, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வெண்மணல்","tr":"veṇmaṇal","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வெண்","tr":"veṇ"},{"kind":"nirai","text":"மணல்","tr":"maṇal"}]},{"text":"விரிந்த","tr":"virinta","foot":"puḷimā","acai":[{"kind":"nirai","text":"விரிந்","tr":"virin"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"வீததை","tr":"vītatai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வீ","tr":"vī"},{"kind":"nirai","text":"ததை","tr":"tatai"}]},{"text":"கானல்","tr":"kāṉal","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"னல்","tr":"ṉal"}]}],[{"text":"தண்ணந்","tr":"taṇṇan","foot":"tēmā","acai":[{"kind":"nēr","text":"தண்","tr":"taṇ"},{"kind":"nēr","text":"ணந்","tr":"ṇan"}]},{"text":"துறைவன்","tr":"tuṟaivaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"துறை","tr":"tuṟai"},{"kind":"nēr","text":"வன்","tr":"vaṉ"}]},{"text":"தணவா","tr":"taṇavā","foot":"puḷimā","acai":[{"kind":"nirai","text":"தண","tr":"taṇa"},{"kind":"nēr","text":"வா","tr":"vā"}]},{"text":"ஊங்கே","tr":"ūṅkē","foot":"tēmā","acai":[{"kind":"nēr","