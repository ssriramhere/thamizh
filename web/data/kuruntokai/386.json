:"aṟiyēṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"அறி","tr":"aṟi"},{"kind":"nēr","text":"யேன்","tr":"yēṉ"}]},{"text":"யானே","tr":"yāṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"வெண்மணல்","parts":[{"text":"வெண்மணல்","lemma":"வெண்மணல்","gloss":"white sand"}],"gloss":"white sand","split_unverified":true},{"surface":"விரிந்த","parts":[{"text":"விரிந்த","lemma":"விரி","gloss":"spread"}],"gloss":"spread"},{"surface":"வீததை","parts":[{"text":"வீ","lemma":"வீ","gloss":"flower"},{"text":"ததை","lemma":"ததை","gloss":"crowded"}],"gloss":"flower-crowded"},{"surface":"கானல்","parts":[{"text":"கானல்","lemma":"கானல்","gloss":"seashore grove"}],"gloss":"seashore grove"}]},{"words":[{"surface":"தண்ணந்துறைவன்","parts":[{"text":"தண்ணந்துறைவன்","lemma":"தண்ணந்துறைவன்","gloss":"lord of the cool, beautiful shore"}],"gloss":"lord of the cool, beautiful shore","split_unverified":true},{"surface":"தணவா","parts":[{"text":"தணவா","lemma":"தணத்தல்","gloss":"before separating"}],"gloss":"before separating"},{"surface":"ஊங்கே","parts":[{"text":"ஊங்கு","lemma":"ஊங்கு","gloss":"before"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"previously indeed"}]},{"words":[{"surface":"வாலிழை","parts":[{"text":"வால்","lemma":"வால்","gloss":"bright"},{"text":"இழை","lemma":"இழை","gloss":"ornament"}],"gloss":"bright-jeweled"},{"surface":"மகளிர்","parts":[{"text":"மகளிர்","lemma":"மகளிர்","gloss":"women"}],"gloss":"women"},{"surface":"விழவணி","parts":[{"text":"விழவு","lemma":"விழவு","gloss":"festival"},{"text":"அணி","lemma":"அணி","gloss":"attire"}],"gloss":"festival attire"},{"surface":"கூட்டும்","parts":[{"text":"கூட்டும்","lemma":"கூட்டு","gloss":"gathering"}],"gloss":"gathering"}]},{"words":[{"surface":"மாலையோ","parts":[{"text":"மாலை","lemma":"மாலை","gloss":"evening"},{"text":"ஓ","lemma":"ஓ","gloss":"emphasis"}],"gloss":"evening indeed"},{"surface":"அறிவேன்","parts":[{"text":"அறிவேன்","lemma":"அறி","gloss":"I knew"}],"gloss":"I knew"},{"surface":"மன்னே","parts":[{"text":"மன்","lemma":"மன்","gloss":"past state"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"in the past indeed"},{"surface":"மாலை","parts":[{"text":"மாலை","lemma":"மாலை","gloss":"evening"}],"gloss":"evening"}]},{"words":[{"surface":"நிலம்பரந்தன்ன","parts":[{"text":"நிலம்","lemma":"நிலம்","gloss":"earth"},{"text":"பரந்தன்ன","lemma":"பரந்தன்ன","gloss":"like spread over"}],"gloss":"like spread over the earth"},{"surface":"புன்கணொடு","parts":[{"text":"புன்கண்","lemma":"புன்கண்","gloss":"sorrow"},{"text":"ஒடு","lemma":"ஒடு","gloss":"with"}],"gloss":"with sorrow"}]},{"words":[{"surface":"புலம்புடைத்தாகுதல்","parts":[{"text":"புலம்பு","lemma":"புலம்பு","gloss":"loneliness"},{"text":"உடைத்து","lemma":"உடைத்து","gloss":"possessing"},{"text":"ஆகுதல்","lemma":"ஆகுதல்","gloss":"becoming"}],"gloss":"becoming lonely"},{"surface":"அறியேன்","parts":[{"text":"அறியேன்","lemma":"அறி","gloss":"I did not know"}],"gloss":"I did not know"},{"surface":"யானே","parts":[{"text":"யான்","lemma":"யான்","gloss":"I"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"I myself"}]}],"literal":"White sand spread flower-crowded grove / cool beautiful shore-lord before separating / bright-jeweled women festival-attire gathering / evening-indeed I knew in the past, evening / like spread over the earth with sorrow / possessing loneliness becoming, I did not know.","translation":"Before the lord of the cool, beautiful shore left me, in the flower-crowded grove of white sand, I knew evening only as the time that gathers bright-jeweled women for festival celebrations. I never knew then that evening could become so lonely, bringing a sorrow that spreads across the entire earth.","modern":"வெண்மையான மணல் பரவிய, மலர்கள் நிறைந்த கடற்கரைச் சோலையையுடைய குளிர்ந்த துறையின் தலைவன் என்னைப் பிரிவதற்கு முன்னால், பிரகாசமான அணிகலன்களை அணிந்த பெண்கள் திருவிழாவுக்காக ஒன்று கூடும் மாலைப் பொழுதை மட்டுமே நான் அறிந்திருந்தேன். ஆனால், அந்த மாலைப் பொழுது நிலம் முழுவதும் பரவியது போன்ற துன்பத்தோடு தனிமை உடையதாக மாறும் என்பதை நான் அப்போது அறிந்திருக்கவில்லை.","explanation":"The heroine is speaking to herself or her companion, lamenting her state of separation in the Neytal (seashore) landscape. Before her lover departed, evening was a joyful time associated with social gatherings and festive celebrations among women. Now, in his absence, the arrival of evening brings an overwhelming sense of loneliness and a sorrow that feels as vast as the earth itself. The contrast between her past perception of evening and her current painful reality highlights the agony of separation. The seashore grove, once a setting for happy union, now frames her deep isolation.","model":"gemini-3.5-flash"}}