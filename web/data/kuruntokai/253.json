{"text":"kuruntokai","n":253,"lines":["கேளா ராகுவர் தோழி கேட்பின்","விழுமிது கழிவ தாயினு நெகிழ் நூற்","பூச்சே ரணையிற் பெருங்கவின் றொலைந்தநின்","நாட்டுயர் கெடப்பி னீடலர் மாதோ","ஒலிகழை நிவந்த ஓங்குமலைச் சாரற்","புலிபுகா வுறுத்த புலவுநாறு கல்லளை","ஆறுசென் மாக்கள் சேக்கும்","கோடுயர் பிறங்கன் மலையிறந் தோரே"],"tr":["kēḷā rākuvar tōḻi kēṭpiṉ","viḻumitu kaḻiva tāyiṉu nekiḻ nūṟ","pūccē raṇaiyiṟ peruṅkaviṉ ṟolaintaniṉ","nāṭṭuyar keṭappi ṉīṭalar mātō","olikaḻai nivanta ōṅkumalaic cāraṟ","pulipukā vuṟutta pulavunāṟu kallaḷai","āṟuceṉ mākkaḷ cēkkum","kōṭuyar piṟaṅkaṉ malaiyiṟan tōrē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"பூங்கண்ணனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Pūṅkaṇṇaṉār"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"1×5, 6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28, other 2, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 15, āciriyattaḷai 14, ? 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"1 five-foot line (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"கேளா","tr":"kēḷā","foot":"tēmā","acai":[{"kind":"nēr","text":"கே","tr":"kē"},{"kind":"nēr","text":"ளா","tr":"ḷā"}]},{"text":"ராகுவர்","tr":"rākuvar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ரா","tr":"rā"},{"kind":"nirai","text":"குவர்","tr":"kuvar"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"கேட்பின்","tr":"kēṭpiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"கேட்","tr":"kēṭ"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]}],[{"text":"விழுமிது","tr":"viḻumitu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விழு","tr":"viḻu"},{"kind":"nirai","text":"மிது","tr":"mitu"}]},{"text":"கழிவ","tr":"kaḻiva","foot":"puḷimā","acai":[{"kind":"nirai","text":"கழி","tr":"kaḻi"},{"kind":"nēr","text":"வ","tr":"va"}]}