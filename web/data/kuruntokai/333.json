{"text":"kuruntokai","n":333,"lines":["குறும்படைப் பகழிக் கொடுவிற் கானவன்","புனமுண்டு கடிந்த பைங்கண் யானை","நறுந்தழை மகளிர் ஓப்புங் கிள்ளையொடு","குறும்பொறைக் கணவுங் குன்ற நாடன்","பணிக்குறை வருத்தம் வீடத்","துணியின் எவனோ தோழிநம் மறையே"],"tr":["kuṟumpaṭaip pakaḻik koṭuviṟ kāṉavaṉ","puṉamuṇṭu kaṭinta paiṅkaṇ yāṉai","naṟuntaḻai makaḷir ōppuṅ kiḷḷaiyoṭu","kuṟumpoṟaik kaṇavuṅ kuṉṟa nāṭaṉ","paṇikkuṟai varuttam vīṭat","tuṇiyiṉ evaṉō tōḻinam maṟaiyē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"உழுந்தினைம்புலவனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Uḻuntiṉaimpulavaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 1, vañcicīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 5, kalittaḷai 1, oṉṟiya vañcittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"குறும்படைப்","tr":"kuṟumpaṭaip","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குறும்","tr":"kuṟum"},{"kind":"nirai","text":"படைப்","tr":"paṭaip"}]},{"text":"பகழிக்","tr":"pakaḻik","foot":"puḷimā","acai":[{"kind":"nirai","text":"பக","tr":"paka"},{"kind":"nēr","text":"ழிக்","tr":"ḻik"}]},{"text":"கொடுவிற்","tr":"koṭuviṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கொடு","tr":"koṭu"},{"kind":"nēr","text":"விற்","tr":"viṟ"}]},{"text":"கானவன்","tr":"kāṉavaṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"னவன்","tr":"ṉavaṉ"}]}],[{"text":"புனமுண்டு","tr":"puṉamuṇṭu","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"புன","tr":"puṉa"},{"kind":"nēr","text":"முண்","tr":"muṇ"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"கடிந்த","tr":"kaṭinta","foot":"puḷimā","acai":[{"kind":"nirai","text":"கடிந்","tr":"kaṭin"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"பைங்கண்","tr":"paiṅkaṇ","foot":"tēmā","