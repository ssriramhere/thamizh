{"text":"kuruntokai","n":207,"lines":["செப்பினஞ் செலினே செலவரி தாகுமென்","றத்த வோமை அங்கவட் டிருந்த","இனந்தீர் பருந்தின் புலம்புகொள் தெள்விளி","சுரஞ்செல் மாக்கட் குயவுத்துணை யாகும்","கல்வரை யயலது தொல்வழங்கு சிறுநெறி","நல்லடி பொறிப்பத் தாஅய்ச்","சென்றெனக் கேட்டனம் ஆர்வலர் பலரே"],"tr":["ceppiṉañ celiṉē celavari tākumeṉ","ṟatta vōmai aṅkavaṭ ṭirunta","iṉantīr paruntiṉ pulampukoḷ teḷviḷi","curañcel mākkaṭ kuyavuttuṇai yākum","kalvarai yayalatu tolvaḻaṅku ciṟuneṟi","nallaṭi poṟippat tāayc","ceṉṟeṉak kēṭṭaṉam ārvalar palarē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"உறையனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Uṟaiyaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, vañcicīr 1, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 12, oṉṟā vañcittaḷai 1, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"செப்பினஞ்","tr":"ceppiṉañ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"செப்","tr":"cep"},{"kind":"nirai","text":"பினஞ்","tr":"piṉañ"}]},{"text":"செலினே","tr":"celiṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"செலி","tr":"celi"},{"kind":"nēr","text":"னே","tr":"ṉē"}]},{"text":"செலவரி","tr":"celavari","foot":"karuviḷam","acai":[{"kind":"nirai","text":"செல","tr":"cela"},{"kind":"nirai","text":"வரி","tr":"vari"}]},{"text":"தாகுமென்","tr":"tākumeṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nirai","text":"குமென்","tr":"kumeṉ"}]}],[{"text":"றத்த","tr":"ṟatta","foot":"tēmā","acai":[{"kind":"nēr","text":"றத்","tr":"ṟat"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"வோமை","tr":"vōmai","foot":"tēmā","acai":[{"kind":"nēr","text":"வோ","tr":"vō"},{"kind":"nēr","text":"மை","tr":"mai"}]},{"text":"அங்கவட்","tr":"aṅkavaṭ","foot":"kūviḷam","acai":[{"kind":"nēr",