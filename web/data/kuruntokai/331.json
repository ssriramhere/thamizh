nd"}],"gloss":"friend"},{"surface":"நறுவடி","parts":[{"text":"நறு","lemma":"நறுமை","gloss":"fragrant"},{"text":"வடி","lemma":"வடி","gloss":"tender mango"}],"gloss":"fragrant tender mango"}]},{"words":[{"surface":"பைங்கால்","parts":[{"text":"பைம்","lemma":"பசுமை","gloss":"green"},{"text":"கால்","lemma":"கால்","gloss":"trunk"}],"gloss":"green-trunked"},{"surface":"மாஅத்து","parts":[{"text":"மா","lemma":"மா","gloss":"mango tree"},{"text":"அத்து","lemma":"அத்து","gloss":"oblique marker"}],"gloss":"of the mango tree"},{"surface":"அம்","parts":[{"text":"அம்","lemma":"அம்","gloss":"beautiful"}],"gloss":"beautiful"},{"surface":"தளிர்","parts":[{"text":"தளிர்","lemma":"தளிர்","gloss":"sprout"}],"gloss":"sprout"},{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"அன்ன","gloss":"resembling"}],"gloss":"resembling"}]},{"words":[{"surface":"நன்மா","parts":[{"text":"நன்மா","lemma":"நன்மா","gloss":"beautiful dark"}],"gloss":"beautiful dark","split_unverified":true},{"surface":"மேனி","parts":[{"text":"மேனி","lemma":"மேனி","gloss":"body complexion"}],"gloss":"body complexion"},{"surface":"பசப்ப","parts":[{"text":"பசப்ப","lemma":"பசத்தல்","gloss":"to turn pale"}],"gloss":"to turn pale"}]},{"words":[{"surface":"நம்மினும்","parts":[{"text":"நம்","lemma":"நாம்","gloss":"us"},{"text":"இனும்","lemma":"உம்","gloss":"even more than"}],"gloss":"even more than us"},{"surface":"சிறந்த","parts":[{"text":"சிறந்த","lemma":"சிற","gloss":"superior"}],"gloss":"superior"},{"surface":"அரும்பொருள்","parts":[{"text":"அரும்","lemma":"அருமை","gloss":"rare"},{"text":"பொருள்","lemma":"பொருள்","gloss":"wealth"}],"gloss":"rare wealth"},{"surface":"தரற்கே","parts":[{"text":"தரற்கு","lemma":"தருதல்","gloss":"to bring"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"for bringing indeed"}]}],"literal":"Tall bamboo withered water-less difficult path / path-going travelers to perish standing in opposition / curved-bow bandits forest-plunder sharing-eating / fierce-eyed elephant forest having crossed / will he seek indeed? May you live long, friend! Fragrant tender mango / green-trunked mango tree's beautiful sprout resembling / good beautiful body complexion to turn pale / even more than us superior rare wealth for bringing indeed!","translation":"May you live long, my friend! Will he really go, traversing the forest of fierce-eyed elephants, where bandits with curved bows stand in wait to destroy travelers on the path and share their plunder in the waterless, difficult ways of withered tall bamboos, just to bring back rare wealth that he deems more precious than us, while your beautiful dark complexion, like the lovely tender sprout of the green-trunked mango tree with fragrant young fruits, turns pale with grief?","modern":"தோழியே! நீ வாழ்க! நறுமணமுள்ள வடுக்களைக் கொண்ட, பசுமையான அடிமரத்தையுடைய மாமரத்தின் அழகிய தளிரைப் போன்ற உன்னுடைய நல்ல அழகிய மேனி பசலை நிறம் கொள்ளும்படியாக, நம்மை விடவும் சிறந்ததாக அவன் கருதும் அரிய பொருளைத் தேடித் தருவதற்காக, உலர்ந்த நெடிய மூங்கில்களையுடைய, நீர் இல்லாத அரிய வழியில், வழியே செல்லும் புதியவர்கள் அழியும்படி வழிமறித்து நின்று, வளைந்த வில்லையுடைய மறவர்கள் காட்டில் கொள்ளையடித்த கூழினைப் பகிர்ந்து உண்ணும், கொடிய பார்வையையுடைய யானைகள் திரியும் காட்டைத் தாண்டி அவன் செல்வானோ?","explanation":"In this Pālai (wasteland) poem, the companion (tōḻi) speaks reassuringly to the distressed heroine (taleivi) whose lover is planning to depart in search of wealth. She describes the terrifying desert path filled with withered bamboos, waterless tracts, and fierce bandits who ambush travelers to share their plunder, alongside wild, fierce-eyed elephants. The companion contrasts this harsh, violent landscape with the heroine's delicate beauty, which resembles the fresh, fragrant sprout of a green-trunked mango tree. By asking rhetorically whether the hero would really choose to traverse such a perilous wilderness for the sake of material wealth while leaving his beloved to fade and turn pale with grief, she comforts the heroine, implying that his deep love will prevent him from leaving.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.83],[0.87,0.9],[0.9,1.35],[1.53,1.8],[1.8,2.6],[2.6,2.6],[2.6,3.2],[3.2,3.9],[3.9,4.5],[4.5,4.8],[4.8,5.1],[5.1,6.3],[6.3,6.56],[6.74,7.0],[7.0,7.0],[7.0,8.3],[8.3,9.5],[9.5,9.7],[9.7,9.9],[9.9,10.5],[10.5,10.5],[10.5,10.57],[10.67,11.54],[11.54,12.5],[12.5,13.4],[13.4,13.5],[13.5,14.2],[14.2,15.1],[15.1,15.6],[15.6,16.1],[16.1,16.3]],"female":[[0.0,0.8],[0.8,0.97],[1.0,1.45],[1.63,1.9],[1.9,2.8],[2.8,2.8],[2.8,3.4],[3.4,5.09],[5.09,5.26],[5.26,5.43],[5.43,5.43],[5.43,5.43],[5.43,5.6],[5.6,8.2],[8.2,8.2],[8.2,8.6],[8.6,8.6],[8.6,10.4],[10.4,10.6],[10.6,10.6],[10.6,12.3],[12.3,12.52],[12.52,13.08],[13.08,13.3],[13.3,14.5],[14.5,14.6],[14.6,15.4],[15.4,16.5],[16.5,17.1],[17.1,17.6],[17.6,17.9]]}}