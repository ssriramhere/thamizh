{"text":"kuruntokai","n":331,"lines":["நெடுங்கழை திரங்கிய நீரி லாரிடை","ஆறுசெல் வம்பலர் தொலைய மாறுநின்று","கொடுஞ்சிலை மறவர் கடறுகூட் டுண்ணும்","கடுங்கண் யானைக் கான நீந்தி","இரப்பர்கொல் வாழி தோழி நறுவடிப்","பைங்கால் மாஅத் தந்தளி ரன்ன","நன்மா மேனி பசப்ப","நம்மினுஞ் சிறந்த அரும்பொருள் தரற்கே"],"tr":["neṭuṅkaḻai tiraṅkiya nīri lāriṭai","āṟucel vampalar tolaiya māṟuniṉṟu","koṭuñcilai maṟavar kaṭaṟukūṭ ṭuṇṇum","kaṭuṅkaṇ yāṉaik kāṉa nīnti","irapparkol vāḻi tōḻi naṟuvaṭip","paiṅkāl māat tantaḷi raṉṉa","naṉmā mēṉi pacappa","nammiṉuñ ciṟanta arumporuḷ taraṟkē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"வாடாப் பிரபந்தனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Vāṭāp Pirapantaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 29, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 13, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நெடுங்கழை","tr":"neṭuṅkaḻai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நெடுங்","tr":"neṭuṅ"},{"kind":"nirai","text":"கழை","tr":"kaḻai"}]},{"text":"திரங்கிய","tr":"tiraṅkiya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"திரங்","tr":"tiraṅ"},{"kind":"nirai","text":"கிய","tr":"kiya"}]},{"text":"நீரி","tr":"nīri","foot":"tēmā","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nēr","text":"ரி","tr":"ri"}]},{"text":"லாரிடை","tr":"lāriṭai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"லா","tr":"lā"},{"kind":"nirai","text":"ரிடை","tr":"riṭai"}]}],[{"text":"ஆறுசெல்","tr":"āṟucel","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nirai","text":"றுசெல்","tr":"ṟucel"}]},{"text":"வம்பலர்","tr":"vampalar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வம்","tr":"vam"},{"kind":"nirai","text":"பலர்","tr":"palar"}]},{"text":"தொலைய","tr":"tolaiya"