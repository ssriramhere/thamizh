text":"கானம்","lemma":"kāṉam","gloss":"forest"}],"gloss":"forest"},{"surface":"நீந்தி","parts":[{"text":"நீந்து","lemma":"nīntu","gloss":"swim/traverse"},{"text":"இ","lemma":"i","gloss":"past participle suffix"}],"gloss":"traversing"}]},{"words":[{"surface":"இரப்பர்","parts":[{"text":"இர","lemma":"ira","gloss":"beg/seek"},{"text":"ப்பர்","lemma":"ppar","gloss":"future third person plural suffix"}],"gloss":"will they seek"},{"surface":"கொல்","parts":[{"text":"கொல்","lemma":"kol","gloss":"particle of doubt"}],"gloss":"indeed (doubt)"},{"surface":"வாழி","parts":[{"text":"வாழ்","lemma":"vāḻ","gloss":"live"},{"text":"இ","lemma":"i","gloss":"subjunctive suffix"}],"gloss":"may you live"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"tōḻi","gloss":"friend"}],"gloss":"friend"},{"surface":"நறு","parts":[{"text":"நறு","lemma":"naṟu","gloss":"fragrant"}],"gloss":"fragrant"},{"surface":"வடி","parts":[{"text":"வடி","lemma":"vaṭi","gloss":"unripe mango fruit"}],"gloss":"unripe mango"}]},{"words":[{"surface":"பைங்","parts":[{"text":"பைங்","lemma":"பைங்","gloss":"green"}],"gloss":"green","split_unverified":true},{"surface":"கால்","parts":[{"text":"கால்","lemma":"kāl","gloss":"trunk/stem"}],"gloss":"stemmed"},{"surface":"மாஅத்து","parts":[{"text":"மா","lemma":"mā","gloss":"mango tree"},{"text":"அத்து","lemma":"attu","gloss":"oblique case suffix"}],"gloss":"of the mango tree"},{"surface":"அம்","parts":[{"text":"அம்","lemma":"am","gloss":"beautiful"}],"gloss":"beautiful"},{"surface":"தளிர்","parts":[{"text":"தளிர்","lemma":"taḷir","gloss":"sprout"}],"gloss":"sprout"},{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"aṉṉa","gloss":"like"}],"gloss":"like"}]},{"words":[{"surface":"நன்மா","parts":[{"text":"நன்மா","lemma":"நன்மா","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மேனி","parts":[{"text":"மேனி","lemma":"மேனி","gloss":""}],"gloss":"","split_unverified":true},{"surface":"பசப்ப","parts":[{"text":"பசப்ப","lemma":"பசப்ப","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"நம்மினும்","parts":[{"text":"நம்","lemma":"nam","gloss":"we/us"},{"text":"இனும்","lemma":"iṉum","gloss":"than (comparative suffix)"}],"gloss":"than us"},{"surface":"சிறந்த","parts":[{"text":"சிற","lemma":"ciṟa","gloss":"be superior"},{"text":"ந்த","lemma":"nta","gloss":"past adjectival participle suffix"}],"gloss":"superior"},{"surface":"அரும்","parts":[{"text":"அரும்","lemma":"அரும்","gloss":"rare"}],"gloss":"rare","split_unverified":true},{"surface":"பொருள்","parts":[{"text":"பொருள்","lemma":"poruḷ","gloss":"wealth"}],"gloss":"wealth"},{"surface":"தரற்கே","parts":[{"text":"தரல்","lemma":"taral","gloss":"giving/bringing"},{"text":"கு","lemma":"ku","gloss":"dative suffix"},{"text":"ஏ","lemma":"ē","gloss":"emphasis particle"}],"gloss":"to bring indeed"}]}],"literal":"tall bamboo withered water-less difficult path / path-going wayfarers to perish, hostilely standing / bent-bow bandits desert-plunder eating / fierce-eyed elephants' forest traversing / will they seek, may you live, friend, fragrant unripe-mango / green-stemmed mango tree's beautiful sprout-like / beautiful dark complexion to turn pale / than us superior rare wealth to bring?","translation":"Will he really traverse, my friend, may you live, the forest of fierce-eyed elephants where bent-bow bandits stand in wait to destroy wayfarers on the path and feed on their plunder, in the difficult waterless way where tall bamboos are withered, just to bring back rare wealth deemed more precious than us, while my beautiful dark complexion, like the lovely sprout of the green-stemmed mango tree with fragrant unripe fruits, turns pale with pining?","modern":"நெடிய மூங்கில்கள் வாடிய, நீர் இல்லாத, கடப்பதற்கு அரிய வழியில், வழியே செல்லும் புதியவர்கள் அழியும்படி பகைத்து நின்று, வளைந்த வில்லை உடைய மறவர்கள் காட்டில் கொள்ளையடித்த உணவை உண்ணும், சினங்கொண்ட கண்களை உடைய யானைகள் வாழும் காட்டைத் தாண்டிச் சென்று, தோழியே! நீ வாழ்க! நறிய மாங்காய் போன்ற, பசுமையான கிளையையுடைய மாமரத்தின் அழகிய தளிரைப் போன்ற எனது நல்ல அழகிய மேனி பசலை கொள்ளுமாறு, நம்மை விடவும் சிறந்த அரிய பொருளை ஈட்டி வருவதற்காக அவர் செல்வாரோ?","explanation":"This poem is set in the pālai (desert) landscape, spoken by the confidante to the heroine. The hero has departed to earn wealth, leaving the heroine behind. The confidante describes the perilous desert path filled with hostile bandits and fierce elephants, contrasting the harshness of the wasteland with the tender beauty of the heroine's complexion, which is like a fresh mango sprout. She questions whether the wealth he seeks is truly more valuable than the heroine's love and well-being, subtly reassuring the heroine of her worth and expressing hope for his quick return. The key words are 'பசப்ப' (to turn pale with pining) and 'அரும்பொருள்' (rare wealth).","model":"gemini-3.5-flash"}}