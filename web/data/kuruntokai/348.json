{"text":"kuruntokai","n":348,"lines":["தாமே செல்ப வாயிற் கானத்துப்","புலந்தேர் யானைக் கோட்டிடை யொழிந்த","சிறுவீ முல்லைக் கொம்பிற் றாஅய்","இதழழிந் தூறுங் கண்பனி மதரெழிற்","பூணக வனமுலை நனைத்தலும்","காணார் கொல்லோ மாணிழை நமரே"],"tr":["tāmē celpa vāyiṟ kāṉattup","pulantēr yāṉaik kōṭṭiṭai yoḻinta","ciṟuvī mullaik kompiṟ ṟāay","itaḻaḻin tūṟuṅ kaṇpaṉi matareḻiṟ","pūṇaka vaṉamulai naṉaittalum","kāṇār kollō māṇiḻai namarē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"மாவளத்தனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Māvaḷattaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 5, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"தாமே","tr":"tāmē","foot":"tēmā","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"மே","tr":"mē"}]},{"text":"செல்ப","tr":"celpa","foot":"tēmā","acai":[{"kind":"nēr","text":"செல்","tr":"cel"},{"kind":"nēr","text":"ப","tr":"pa"}]},{"text":"வாயிற்","tr":"vāyiṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"யிற்","tr":"yiṟ"}]},{"text":"கானத்துப்","tr":"kāṉattup","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"னத்","tr":"ṉat"},{"kind":"nēr","text":"துப்","tr":"tup"}]}],[{"text":"புலந்தேர்","tr":"pulantēr","foot":"puḷimā","acai":[{"kind":"nirai","text":"புலந்","tr":"pulan"},{"kind":"nēr","text":"தேர்","tr":"tēr"}]},{"text":"யானைக்","tr":"yāṉaik","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னைக்","tr":"ṉaik"}]},{"text":"கோட்டிடை","tr":"kōṭṭiṭai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கோட்","tr":"kōṭ"},{"kind":"nirai","text":"டிடை","tr":"ṭiṭai"}]},{"text":"யொழிந்த","tr":"yoḻinta","foot":"puḷimā","