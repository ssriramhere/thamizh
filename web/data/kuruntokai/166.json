{"text":"kuruntokai","n":166,"lines":["தண்கடற் படுதிரை பெயர்த்தலின் வெண்பறை","நாரை நிரைபெயர்ந் தயிரை யாரும்","ஊரோ நன்றுமன் மரந்தை","ஒருதனி வைகிற் புலம்பா கின்றே"],"tr":["taṇkaṭaṟ paṭutirai peyarttaliṉ veṇpaṟai","nārai niraipeyarn tayirai yārum","ūrō naṉṟumaṉ marantai","orutaṉi vaikiṟ pulampā kiṉṟē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தோழி கூற்று","poet_ta":"கூடலூர் கிழார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kūṭalūr Kiḻār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 15"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 8, veṇṭaḷai 6"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"தண்கடற்","tr":"taṇkaṭaṟ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தண்","tr":"taṇ"},{"kind":"nirai","text":"கடற்","tr":"kaṭaṟ"}]},{"text":"படுதிரை","tr":"paṭutirai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"படு","tr":"paṭu"},{"kind":"nirai","text":"திரை","tr":"tirai"}]},{"text":"பெயர்த்தலின்","tr":"peyarttaliṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெயர்த்","tr":"peyart"},{"kind":"nirai","text":"தலின்","tr":"taliṉ"}]},{"text":"வெண்பறை","tr":"veṇpaṟai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வெண்","tr":"veṇ"},{"kind":"nirai","text":"பறை","tr":"paṟai"}]}],[{"text":"நாரை","tr":"nārai","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"ரை","tr":"rai"}]},{"text":"நிரைபெயர்ந்","tr":"niraipeyarn","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நிரை","tr":"nirai"},{"kind":"nirai","text":"பெயர்ந்","tr":"peyarn"}]},{"text":"தயிரை","tr":"tayirai","foot":"puḷimā","acai":[{"kind":"nirai","text":"தயி","tr":"tayi"},{"kind":"nēr","text":"ரை","tr":"rai"}]},{"text":"யாரும்","tr":"yārum","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"ரும்","tr":"rum"}]}],[{"text":"ஊரோ",