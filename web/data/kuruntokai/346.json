{"text":"kuruntokai","n":346,"lines":["நாகுபிடி நயந்த முளைக்கோட் டிளங்களிறு","குன்றம் நண்ணிக் குறவர் ஆர்ப்ப","மன்றம் போழு நாடன் தோழி","சுனைப்பூங் குவளைத் தொடலை தந்தும்","தினைப்புன மருங்கிற் படுகிளி யோப்பியும்","காலை வந்து மாலைப் பொழுதில்","நல்லக நயந்துதான் உயங்கிச்","சொல்லவும் ஆகா தஃகி யோனே"],"tr":["nākupiṭi nayanta muḷaikkōṭ ṭiḷaṅkaḷiṟu","kuṉṟam naṇṇik kuṟavar ārppa","maṉṟam pōḻu nāṭaṉ tōḻi","cuṉaippūṅ kuvaḷait toṭalai tantum","tiṉaippuṉa maruṅkiṟ paṭukiḷi yōppiyum","kālai vantu mālaip poḻutil","nallaka nayantutāṉ uyaṅkic","collavum ākā taḵki yōṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"வாயிலிளங் கண்ணனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Vāyiliḷaṅ Kaṇṇaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 29, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 13, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நாகுபிடி","tr":"nākupiṭi","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nirai","text":"குபி","tr":"kupi"},{"kind":"nēr","text":"டி","tr":"ṭi"}]},{"text":"நயந்த","tr":"nayanta","foot":"puḷimā","acai":[{"kind":"nirai","text":"நயந்","tr":"nayan"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"முளைக்கோட்","tr":"muḷaikkōṭ","foot":"puḷimā","acai":[{"kind":"nirai","text":"முளைக்","tr":"muḷaik"},{"kind":"nēr","text":"கோட்","tr":"kōṭ"}]},{"text":"டிளங்களிறு","tr":"ṭiḷaṅkaḷiṟu","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"டிளங்","tr":"ṭiḷaṅ"},{"kind":"nirai","text":"களி","tr":"kaḷi"},{"kind":"nēr","text":"று","tr":"ṟu"}]}],[{"text":"குன்றம்","tr":"kuṉṟam","foot":"tēmā","acai":[{"kind":"nēr","text":"குன்","tr":"kuṉ"},{"kind":"nēr","text":"றம்","tr":"ṟam"}]},{"text":"நண்ணிக்","tr":"naṇṇik","foot":"tēmā","acai":[{"kind":"nēr","text":"நண்",