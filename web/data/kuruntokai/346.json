llet"},{"text":"புனம்","lemma":"புனம்","gloss":"field"}],"gloss":"millet field"},{"surface":"மருங்கின்","parts":[{"text":"மருங்கு","lemma":"மருங்கு","gloss":"side"},{"text":"இன்","lemma":"இன்","gloss":"locative suffix"}],"gloss":"at the side of"},{"surface":"படுகிளி","parts":[{"text":"படு","lemma":"படு","gloss":"alight"},{"text":"கிளி","lemma":"கிளி","gloss":"parrot"}],"gloss":"alighting parrots"},{"surface":"ஓப்பியும்","parts":[{"text":"ஓப்பு","lemma":"ஓப்பு","gloss":"drive away"},{"text":"இ","lemma":"இ","gloss":"past participle suffix"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and driving away"}]},{"words":[{"surface":"காலை","parts":[{"text":"காலை","lemma":"காலை","gloss":"morning"}],"gloss":"morning"},{"surface":"வந்து","parts":[{"text":"வந்து","lemma":"வந்து","gloss":"having come"}],"gloss":"having come","split_unverified":true},{"surface":"மாலை","parts":[{"text":"மாலை","lemma":"மாலை","gloss":"evening"}],"gloss":"evening"},{"surface":"பொழுதில்","parts":[{"text":"பொழுது","lemma":"பொழுது","gloss":"time"},{"text":"இல்","lemma":"இல்","gloss":"locative suffix"}],"gloss":"at the time of"}]},{"words":[{"surface":"நல்லகம்","parts":[{"text":"நல்","lemma":"நன்மை","gloss":"good"},{"text":"அகம்","lemma":"அகம்","gloss":"heart"}],"gloss":"good heart"},{"surface":"நயந்து","parts":[{"text":"நய","lemma":"நய","gloss":"desire"},{"text":"ந்த்","lemma":"த்","gloss":"past tense"},{"text":"உ","lemma":"உ","gloss":"past participle suffix"}],"gloss":"having desired"},{"surface":"தான்","parts":[{"text":"தான்","lemma":"தான்","gloss":"himself"}],"gloss":"himself"},{"surface":"உயங்கி","parts":[{"text":"உயங்கு","lemma":"உயங்கு","gloss":"pine"},{"text":"இ","lemma":"இ","gloss":"past participle suffix"}],"gloss":"having pined"}]},{"words":[{"surface":"சொல்லவும்","parts":[{"text":"சொல்","lemma":"சொல்","gloss":"speak"},{"text":"அ","lemma":"அ","gloss":"infinitive suffix"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"even to speak"},{"surface":"ஆகாது","parts":[{"text":"ஆகு","lemma":"ஆகு","gloss":"be possible"},{"text":"ஆ","lemma":"ஆ","gloss":"negative suffix"},{"text":"து","lemma":"து","gloss":"neuter singular suffix"}],"gloss":"it is not possible"},{"surface":"அஃகியோனே","parts":[{"text":"அஃகு","lemma":"அஃகு","gloss":"shrink"},{"text":"இ","lemma":"இ","gloss":"past tense suffix"},{"text":"ஓன்","lemma":"ஓன்","gloss":"he"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"he who has pined"}]}],"literal":"A young male elephant with sprout-like tusks that desired a young female elephant, / approaching the hill, as the hill-dwellers shout, / cleaves through the village common ground, O friend, such is the lord of the land! / Having given a garland of blue water-lilies from the mountain pool, / and having driven away the alighting parrots at the side of the millet field, / having come in the morning, and in the evening, / desiring your good heart, himself pining, / unable even to speak, he has shrunk!","translation":"O friend! The lord of the land where a young male elephant with sprout-like tusks, desiring a young female elephant, approaches the hill and cleaves through the village common ground as the hill-dwellers shout, came in the morning and gave you a garland of blue water-lilies from the mountain pool, and helped drive away the alighting parrots at the side of the millet field. But by evening, desiring your good heart, he himself pined, and unable even to speak, he has shrunk in grief.","modern":"தோழியே! இளமையான பெண் யானையை விரும்பிய, முளை போன்ற தந்தங்களை உடைய இளங் களிறு, மலையை நெருங்கி, குறவர்கள் ஆரவாரம் செய்ய, ஊர் மன்றத்தைப் பிளந்து கொண்டு செல்லும் நாட்டை உடையவன் அவன். அவன் காலையில் வந்து, சுனைப் பூக்களாகிய குவளை மலர்களால் தொடுத்த மாலையைத் தந்தான்; தினைப்புனத்தின் பக்கத்தில் வந்து விழும் கிளிகளையும் ஓட்டினான். ஆனால், மாலைப் பொழுதில் உனது நல்ல நெஞ்சத்தை விரும்பி, தானும் வருந்தி, தன் குறையைச் சொல்லவும் முடியாமல் மெலிந்து போய்விட்டான்.","explanation":"The friend (தோழி) is speaking to the heroine (தலைவி) about the hero (தலைவன்). The hero has been visiting the heroine during the day, helping her guard the millet field and offering her garlands. The friend points out how the hero came in the morning, full of energy, giving her a garland of blue water-lilies and helping her chase away the parrots. However, as evening approached, his love and desire for her made him pine so deeply that he became silent and visibly withered, unable to express his grief of impending separation. The opening image of the young male elephant with sprout-like tusks, rushing through the village common ground to reach its desired female elephant despite the loud shouts of the hill-dwellers, mirrors the hero's intense, unstoppable desire to be with the heroine, disregarding any obstacles or gossip.","model":"gemini-3.5-flash"},"timing":{"male":[[0.11,0.8],[0.8,1.2],[1.2,1.62],[1.62,2.02],[2.1,3.2],[3.2,3.3],[3.3,3.6],[3.6,4.2],[4.2,5.2],[5.2,5.5],[5.5,5.8],[5.8,6.1],[6.1,6.1],[6.1,7.7],[7.7,7.8],[7.8,8.2],[8.2,9.35],[9.35,10.03],[10.03,10.09],[10.15,10.4],[10.4,11.6],[11.6,11.9],[11.9,12.09],[12.09,12.7],[12.7,13.45],[13.6,13.9],[13.9,14.4],[14.4,15.5],[15.75,16.0],[16.0,16.0],[16.0,16.5]],"female":[[0.0,0.9],[0.9,1.4],[1.4,1.9],[1.9,2.31],[2.4,3.5],[3.5,3.6],[3.6,3.8],[3.8,4.3],[4.3,5.4],[5.4,5.7],[5.7,6.3],[6.3,6.6],[6.6,7.8],[7.8,8.3],[8.3,8.4],[8.4,8.8],[8.8,10.03],[10.03,10.16],[10.16,10.16],[10.16,10.3],[10.3,12.8],[12.8,13.2],[13.2,13.3],[13.3,14.0],[14.0,14.75],[14.88,15.42],[15.49,16.0],[16.0,17.2],[17.2,17.44],[17.57,17.81],[17.81,18.18]]},"sync":[[["நாகு","young"],["பிடி","female elephant"]],[["நயந்த","that desired"]],[["முளைக்கோட்டு","having sprout-like tusks"]],[["முளைக்கோட்டு","having sprout-like tusks"],["இளங்களிறு","young male elephant"]],[["குன்றம்","hill"]],[["நண்ணி","having approached"],["குறவர்","hill-dwellers"]],[["குறவர்","hill-dwellers"]],[["ஆர்ப்ப","to shout"]],[["மன்றம்","village common ground"]],[["போழும்","that cleaves"]],[["நாடன்","lord of the land"]],[["தோழி","O friend!"]],[["சுனைப்பூங்",""]],[["குவ