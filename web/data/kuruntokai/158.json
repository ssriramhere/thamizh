{"text":"kuruntokai","n":158,"lines":["நெடுவரை மருங்கிற் பாம்புபட இடிக்கும்","கடுவிசை உருமின் கழறுகுரல் அளைஇக்","காலொடு வந்த கமஞ்சூல் மாமழை","ஆரளி யிலையோ நீயே பேரிசை","இமயமும் துளக்கும் பண்பினை","துணையிலர் அளியர் பெண்டிர் இஃதெவனோ"],"tr":["neṭuvarai maruṅkiṟ pāmpupaṭa iṭikkum","kaṭuvicai urumiṉ kaḻaṟukural aḷaiik","kāloṭu vanta kamañcūl māmaḻai","āraḷi yilaiyō nīyē pēricai","imayamum tuḷakkum paṇpiṉai","tuṇaiyilar aḷiyar peṇṭir iḵtevaṉō"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"ஔவையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 20, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 5, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஓ"}],"ending":"ஓ","lines":[[{"text":"நெடுவரை","tr":"neṭuvarai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நெடு","tr":"neṭu"},{"kind":"nirai","text":"வரை","tr":"varai"}]},{"text":"மருங்கிற்","tr":"maruṅkiṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மருங்","tr":"maruṅ"},{"kind":"nēr","text":"கிற்","tr":"kiṟ"}]},{"text":"பாம்புபட","tr":"pāmpupaṭa","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"பாம்","tr":"pām"},{"kind":"nirai","text":"புப","tr":"pupa"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"இடிக்கும்","tr":"iṭikkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"இடிக்","tr":"iṭik"},{"kind":"nēr","text":"கும்","tr":"kum"}]}],[{"text":"கடுவிசை","tr":"kaṭuvicai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கடு","tr":"kaṭu"},{"kind":"nirai","text":"விசை","tr":"vicai"}]},{"text":"உருமின்","tr":"urumiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"உரு","tr":"uru"},{"kind":"nēr","text":"மின்","tr":"miṉ"}]},{"text":"கழறுகுரல்","tr":"kaḻaṟukural","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"கழ","t