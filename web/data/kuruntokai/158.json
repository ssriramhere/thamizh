ி","tr":"aḷi"},{"kind":"nēr","text":"யர்","tr":"yar"}]},{"text":"பெண்டிர்","tr":"peṇṭir","foot":"tēmā","acai":[{"kind":"nēr","text":"பெண்","tr":"peṇ"},{"kind":"nēr","text":"டிர்","tr":"ṭir"}]},{"text":"இஃதெவனோ","tr":"iḵtevaṉō","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"இஃ","tr":"iḵ"},{"kind":"nirai","text":"தெவ","tr":"teva"},{"kind":"nēr","text":"னோ","tr":"ṉō"}]}]]},"ai":null}