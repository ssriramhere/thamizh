{"text":"kuruntokai","n":337,"lines":["முலையே முகிழ்முகிழ்த் தனவே தலையே","கிளைஇய மென்குரல் கிழக்கு வீழ்ந் தனவே","செறிநிரை வெண்பலும் பறிமுறை நிரம்பின","சுணங்குஞ் சிலதோன் றினவே யணங்குதற்","கியான்ற னறிவலே தானறி யலளே","யாங்கா குவள்கொ றானே","பெருமுது செல்வ ரொருமட மகளே"],"tr":["mulaiyē mukiḻmukiḻt taṉavē talaiyē","kiḷaiiya meṉkural kiḻakku vīḻn taṉavē","ceṟinirai veṇpalum paṟimuṟai nirampiṉa","cuṇaṅkuñ cilatōṉ ṟiṉavē yaṇaṅkutaṟ","kiyāṉṟa ṉaṟivalē tāṉaṟi yalaḷē","yāṅkā kuvaḷko ṟāṉē","perumutu celva rorumaṭa makaḷē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"பொதுக்கயத்துக் கீரந்தையார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Potukkayattuk Kīrantaiyār"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"1×5, 5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27, other 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 15, āciriyattaḷai 11, ? 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"1 five-foot line (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"முலையே","tr":"mulaiyē","foot":"puḷimā","acai":[{"kind":"nirai","text":"முலை","tr":"mulai"},{"kind":"nēr","text":"யே","tr":"yē"}]},{"text":"முகிழ்முகிழ்த்","tr":"mukiḻmukiḻt","foot":"karuviḷam","acai":[{"kind":"nirai","text":"முகிழ்","tr":"mukiḻ"},{"kind":"nirai","text":"முகிழ்த்","tr":"mukiḻt"}]},{"text":"தனவே","tr":"taṉavē","foot":"puḷimā","acai":[{"kind":"nirai","text":"தன","tr":"taṉa"},{"kind":"nēr","text":"வே","tr":"vē"}]},{"text":"தலையே","tr":"talaiyē","foot":"puḷimā","acai":[{"kind":"nirai","text":"தலை","tr":"talai"},{"kind":"nēr","text":"யே","tr":"yē"}]}],[{"text":"கிளைஇய","tr":"kiḷaiiya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கிளை","tr":"kiḷai"},{"kind":"nirai","text":"இய","tr":"iya"}]},{"text":"மென்குரல்","tr":"meṉkural","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மென்","tr":"meṉ"},{"kind":"nirai","text":