{"text":"kuruntokai","n":123,"lines":["இருள்திணிந் தன்ன ஈர்ந்தண் கொழுநிழல்","நிலவுக்குவித் தன்ன வெண்மணல் ஒருசிறைக்","கருங்கோட்டுப் புன்னைப் பூம்பொழில் புலம்ப","இன்னும் வாரார் வரூஉம்","பன்மீன் வேட்டத் தென்னையர் திமிலே"],"tr":["iruḷtiṇin taṉṉa īrntaṇ koḻuniḻal","nilavukkuvit taṉṉa veṇmaṇal oruciṟaik","karuṅkōṭṭup puṉṉaip pūmpoḻil pulampa","iṉṉum vārār varūum","paṉmīṉ vēṭṭat teṉṉaiyar timilē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தோழி கூற்று","poet_ta":"ஐயூர் முடவனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Aiyūr Muṭavaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 16, veṇcīr 2, vañcicīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 4, oṉṟā vañcittaḷai 1, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இருள்திணிந்","tr":"iruḷtiṇin","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இருள்","tr":"iruḷ"},{"kind":"nirai","text":"திணிந்","tr":"tiṇin"}]},{"text":"தன்ன","tr":"taṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"தன்","tr":"taṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"ஈர்ந்தண்","tr":"īrntaṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"ஈர்ந்","tr":"īrn"},{"kind":"nēr","text":"தண்","tr":"taṇ"}]},{"text":"கொழுநிழல்","tr":"koḻuniḻal","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கொழு","tr":"koḻu"},{"kind":"nirai","text":"நிழல்","tr":"niḻal"}]}],[{"text":"நிலவுக்குவித்","tr":"nilavukkuvit","foot":"puḷimāṅkaṉi","acai":[{"kind":"nirai","text":"நில","tr":"nila"},{"kind":"nēr","text":"வுக்","tr":"vuk"},{"kind":"nirai","text":"குவித்","tr":"kuvit"}]},{"text":"தன்ன","tr":"taṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"தன்","tr":"taṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"வெண்மணல்","tr":"veṇmaṇal","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வெண்","tr":"veṇ"},{"kind":"nirai","