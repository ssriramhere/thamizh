{"text":"kuruntokai","n":384,"lines":["உழுந்துடைக் கழுந்திற் கரும்புடைப் பணைத்தோள்","நெடும்பல் கூந்தற் குறுந்தொடி மகளிர்","நலனுண்டு துறத்தி யாயின்","மிகநன் றம்ம மகிழ்நநின் சூளே"],"tr":["uḻuntuṭaik kaḻuntiṟ karumpuṭaip paṇaittōḷ","neṭumpal kūntaṟ kuṟuntoṭi makaḷir","nalaṉuṇṭu tuṟatti yāyiṉ","mikanaṉ ṟamma makiḻnaniṉ cūḷē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தோழி கூற்று","poet_ta":"ஓரம்போகியார்","speaker_en":"her friend (tōḻi)","poet_tr":"Ōrampōkiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 14, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 7, āciriyattaḷai 6, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"உழுந்துடைக்","tr":"uḻuntuṭaik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"உழுந்","tr":"uḻun"},{"kind":"nirai","text":"துடைக்","tr":"tuṭaik"}]},{"text":"கழுந்திற்","tr":"kaḻuntiṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கழுந்","tr":"kaḻun"},{"kind":"nēr","text":"திற்","tr":"tiṟ"}]},{"text":"கரும்புடைப்","tr":"karumpuṭaip","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கரும்","tr":"karum"},{"kind":"nirai","text":"புடைப்","tr":"puṭaip"}]},{"text":"பணைத்தோள்","tr":"paṇaittōḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பணைத்","tr":"paṇait"},{"kind":"nēr","text":"தோள்","tr":"tōḷ"}]}],[{"text":"நெடும்பல்","tr":"neṭumpal","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெடும்","tr":"neṭum"},{"kind":"nēr","text":"பல்","tr":"pal"}]},{"text":"கூந்தற்","tr":"kūntaṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"கூந்","tr":"kūn"},{"kind":"nēr","text":"தற்","tr":"taṟ"}]},{"text":"குறுந்தொடி","tr":"kuṟuntoṭi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குறுந்","tr":"kuṟun"},{"kind":"nirai","text":"தொடி","tr":"toṭi"}]},{"text":"மகளிர்","tr":"makaḷir","foot":"puḷimā","acai":[{"kind":"nirai","tex