{"text":"kuruntokai","n":269,"lines":["சேயாறு சென்று துனைபரி யசாவா","துசாவுநர்ப் பெறினே நன்றுமற் றில்ல","வயச்சுறா எறிந்த புண்தணிந் தெந்தையும்","நீனிறப் பெருங்கடல் புக்கனன் யாயும்","உப்பை மாறி வெண்ணெல் தரீஇய","உப்புவிளை கழனிச் சென்றனள் இதனால்","பனியிரும் மரப்பிற் சேர்ப்பற்","கினிவரி னௌியள் என்னும் தூதே"],"tr":["cēyāṟu ceṉṟu tuṉaipari yacāvā","tucāvunarp peṟiṉē naṉṟumaṟ ṟilla","vayaccuṟā eṟinta puṇtaṇin tentaiyum","nīṉiṟap peruṅkaṭal pukkaṉaṉ yāyum","uppai māṟi veṇṇel tarīiya","uppuviḷai kaḻaṉic ceṉṟaṉaḷ itaṉāl","paṉiyirum marappiṟ cērppaṟ","kiṉivari ṉauyaḷ eṉṉum tūtē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"கல்லாடனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kallāṭaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 14, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"சேயாறு","tr":"cēyāṟu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"சே","tr":"cē"},{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"சென்று","tr":"ceṉṟu","foot":"tēmā","acai":[{"kind":"nēr","text":"சென்","tr":"ceṉ"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"துனைபரி","tr":"tuṉaipari","foot":"karuviḷam","acai":[{"kind":"nirai","text":"துனை","tr":"tuṉai"},{"kind":"nirai","text":"பரி","tr":"pari"}]},{"text":"யசாவா","tr":"yacāvā","foot":"puḷimā","acai":[{"kind":"nirai","text":"யசா","tr":"yacā"},{"kind":"nēr","text":"வா","tr":"vā"}]}],[{"text":"துசாவுநர்ப்","tr":"tucāvunarp","foot":"karuviḷam","acai":[{"kind":"nirai","text":"துசா","tr":"tucā"},{"kind":"nirai","text":"வுநர்ப்","tr":"vunarp"}]},{"text":"பெறினே","tr":"peṟiṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெறி","tr":"peṟi"},{"kind":"nēr","text":"னே","tr":"ṉ