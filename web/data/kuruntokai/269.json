ss":"horse"}],"gloss":"fast horse"},{"surface":"யசாவா","parts":[{"text":"ய்","lemma":"ய்","gloss":"glide"},{"text":"அசாவா","lemma":"அசாவா","gloss":"without tiring"}],"gloss":"without tiring"}]},{"words":[{"surface":"துசாவுநர்ப்","parts":[{"text":"துசாவுநர்","lemma":"துசாவுநர்","gloss":"those who inquire"},{"text":"ப்","lemma":"ப்","gloss":"sandhi consonant"}],"gloss":"those who inquire"},{"surface":"பெறினே","parts":[{"text":"பெறின்","lemma":"பெறு","gloss":"if we obtain"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"if we obtain indeed"},{"surface":"நன்றுமற்","parts":[{"text":"நன்றுமற்","lemma":"நன்றுமற்","gloss":"it would be good indeed"}],"gloss":"it would be good indeed","split_unverified":true},{"surface":"றில்ல","parts":[{"text":"றில்ல","lemma":"றில்ல","gloss":"alas"}],"gloss":"alas","split_unverified":true}]},{"words":[{"surface":"வயச்சுறா","parts":[{"text":"வயச்சுறா","lemma":"வயச்சுறா","gloss":"strong shark"}],"gloss":"strong shark","split_unverified":true},{"surface":"எறிந்த","parts":[{"text":"எறிந்த","lemma":"எறி","gloss":"that struck"}],"gloss":"that struck"},{"surface":"புண்தணிந்","parts":[{"text":"புண்தணிந்","lemma":"புண்தணிந்","gloss":"wound having healed"}],"gloss":"wound having healed","split_unverified":true},{"surface":"தெந்தையும்","parts":[{"text":"தெந்தையும்","lemma":"தெந்தையும்","gloss":"my father also"}],"gloss":"my father also","split_unverified":true}]},{"words":[{"surface":"நீனிறப்","parts":[{"text":"நீனிறப்","lemma":"நீனிறப்","gloss":"blue-colored"}],"gloss":"blue-colored","split_unverified":true},{"surface":"பெருங்கடல்","parts":[{"text":"பெருங்கடல்","lemma":"பெருங்கடல்","gloss":"great ocean"}],"gloss":"great ocean","split_unverified":true},{"surface":"புக்கனன்","parts":[{"text":"புக்கனன்","lemma":"புக்கனன்","gloss":"he entered"}],"gloss":"he entered","split_unverified":true},{"surface":"யாயும்","parts":[{"text":"யாய்","lemma":"யாய்","gloss":"my mother"},{"text":"உம்","lemma":"உம்","gloss":"also"}],"gloss":"my mother also"}]},{"words":[{"surface":"உப்பை","parts":[{"text":"உப்பு","lemma":"உப்பு","gloss":"salt"},{"text":"ஐ","lemma":"ஐ","gloss":"accusative case marker"}],"gloss":"salt"},{"surface":"மாறி","parts":[{"text":"மாறி","lemma":"மாறு","gloss":"having bartered"}],"gloss":"having bartered"},{"surface":"வெண்ணெல்","parts":[{"text":"வெள்","lemma":"வெண்மை","gloss":"white"},{"text":"நெல்","lemma":"நெல்","gloss":"paddy"}],"gloss":"white paddy"},{"surface":"தரீஇய","parts":[{"text":"தரீஇய","lemma":"தரு","gloss":"to bring"}],"gloss":"to bring"}]},{"words":[{"surface":"உப்புவிளை","parts":[{"text":"உப்பு","lemma":"உப்பு","gloss":"salt"},{"text":"விளை","lemma":"விளை","gloss":"yielding"}],"gloss":"salt-yielding"},{"surface":"கழனிச்","parts":[{"text":"கழனி","lemma":"கழனி","gloss":"field"},{"text":"ச்","lemma":"ச்","gloss":"sandhi consonant"}],"gloss":"field"},{"surface":"சென்றனள்","parts":[{"text":"சென்றனள்","lemma":"சென்றனள்","gloss":"she went"}],"gloss":"she went","split_unverified":true},{"surface":"இதனால்","parts":[{"text":"இதனால்","lemma":"இதனால்","gloss":"because of this"}],"gloss":"because of this","split_unverified":true}]},{"words":[{"surface":"பனியிரும்","parts":[{"text":"பனி","lemma":"பனி","gloss":"cold"},{"text":"இரும்","lemma":"இரும்","gloss":"dark"}],"gloss":"cold and dark"},{"surface":"மரப்பிற்","parts":[{"text":"மரப்பிற்","lemma":"மரப்பிற்","gloss":"of the chilliness"}],"gloss":"of the chilliness","split_unverified":true},{"surface":"சேர்ப்பற்","parts":[{"text":"சேர்ப்பற்","lemma":"சேர்ப்பற்","gloss":"to the lord of the maritime tract"}],"gloss":"to the lord of the maritime tract","split_unverified":true}]},{"words":[{"surface":"கினிவரி","parts":[{"text":"கினிவரி","lemma":"கினிவரி","gloss":"if he comes now"}],"gloss":"if he comes now","split_unverified":true},{"surface":"னௌியள்","parts":[{"text":"னௌியள்","lemma":"னௌியள்","gloss":"she is easy to attain"}],"gloss":"she is easy to attain","split_unverified":true},{"surface":"என்னும்","parts":[{"text":"என்னும்","lemma":"என்","gloss":"saying"}],"gloss":"saying"},{"surface":"தூதே","parts":[{"text":"தூது","lemma":"தூது","gloss":"message"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"the message indeed"}]}],"literal":"A distant path having gone, fast horses without tiring / those who inquire if we obtain, it would be good indeed / the wound struck by a strong shark having healed, my father also / entered the blue-colored great ocean; my mother also / to barter salt and bring white paddy / went to the salt-yielding field; because of this / to the lord of the cold, dark, chilly maritime tract / if he comes now, she is easy to attain, is the message.","translation":"If only we could find someone who, without tiring their fast horses, would travel the long path to ask of our welfare! It would be so good. The wound inflicted by the strong shark has healed, and my father has gone back to the blue, vast ocean. My mother, too, has gone to the salt pans to barter salt for white paddy. Therefore, this is the message for the lord of the cool, dark maritime shore: 'If he comes now, she is easy to win.'","modern":"தொலைதூர வழியில் விரைந்து செல்லும் குதிரைகளை இளைப்பாறச் செய்யாமல் சென்று, நம் நிலையைப் பற்றி விசாரிப்பாரைப் பெற்றால் அது மிகவும் நல்லது. வலிய சுறா மீன் தாக்கியதால் ஏற்பட்ட காயம் ஆறிவிட்டதால், என் தந்தையும் நீல நிறமுடைய பெரிய கடலுக்குள் மீன் பிடிக்கச் சென்றுவிட்டார். என் தாயும் உப்பைக் கொடுத்துவிட்டு வெண்ணெல்லைப் பெற்று வருவதற்காக உப்பு விளையும் வயலுக்குச் சென்றுவிட்டாள். இதனால், குளிர்ந்த கரிய கடற்கரைத் தலைவனுக்கு, 'அவன் இப்போது வந்தால் தலைவியை அடைவது எளிது' என்னும் செய்தியைத் தூதாக அனுப்புங்கள்.","explanation":"The heroine speaks to her companion (or expresses her thoughts aloud in the hearing of the hero who is hiding nearby). She wishes for a messenger who can ride swiftly to the hero's land to convey her situation. She explains that her father, whose shark-wound has healed, has gone back to sea, and her mother has gone to barter salt for paddy. This means the house is unguarded, and the hero can easily come and marry her now. The maritime landscape (neytal) is evoked through the shark, the blue ocean, and the salt pans, reflecting the anxiety of waiting and the opportunity for union. Key words include 'வயச்சுறா' (strong shark), 'சேர்ப்பற்கு' (to the lord of the shore), and 'எளியள்' (easy to attain).","model":"gemini-3.5-flash"}}