 not be considered"}],"gloss":"will not be counted"}]},{"words":[{"surface":"இல்லோர்","parts":[{"text":"இல்லோர்","lemma":"இல்லோர்","gloss":"those who have nothing"}],"gloss":"the poor"},{"surface":"வாழ்க்கை","parts":[{"text":"வாழ்க்கை","lemma":"வாழ்க்கை","gloss":"life"}],"gloss":"life"},{"surface":"இரவினும்","parts":[{"text":"இரவு","lemma":"இரவு","gloss":"begging"},{"text":"இனும்","lemma":"இனும்","gloss":"than"}],"gloss":"even more than begging"},{"surface":"இளிவு","parts":[{"text":"இளிவு","lemma":"இளிவு","gloss":"disgrace"}],"gloss":"disgraceful"},{"surface":"என","parts":[{"text":"என","lemma":"என","gloss":"saying"}],"gloss":"saying"}]},{"words":[{"surface":"சொல்லிய","parts":[{"text":"சொல்லிய","lemma":"சொல்லிய","gloss":""}],"gloss":"","split_unverified":true},{"surface":"வன்மை","parts":[{"text":"வன்மை","lemma":"வன்மை","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தௌியக்","parts":[{"text":"தௌியக்","lemma":"தௌியக்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"காட்டிச்","parts":[{"text":"காட்டிச்","lemma":"காட்டிச்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"சென்றனர்","parts":[{"text":"சென்றனர்","lemma":"செல்","gloss":"he went"}],"gloss":"he departed"},{"surface":"வாழி","parts":[{"text":"வாழி","lemma":"வாழி","gloss":"may you live long"}],"gloss":"may you live long"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"தோழி","gloss":"friend"}],"gloss":"my friend"},{"surface":"என்றும்","parts":[{"text":"என்றும்","lemma":"என்றும்","gloss":"always"}],"gloss":"always"}]},{"words":[{"surface":"கூற்றத்","parts":[{"text":"கூற்றத்","lemma":"கூற்றத்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தன்ன","parts":[{"text":"தன்ன","lemma":"தன்ன","gloss":""}],"gloss":"","split_unverified":true},{"surface":"கொலைவேல்","parts":[{"text":"கொலைவேல்","lemma":"கொலைவேல்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மறவர்","parts":[{"text":"மறவர்","lemma":"மறவர்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"ஆற்று","parts":[{"text":"ஆற்று","lemma":"ஆறு","gloss":"path"}],"gloss":"on the path"},{"surface":"இருந்து","parts":[{"text":"இருந்து","lemma":"இரு","gloss":"staying"}],"gloss":"staying"},{"surface":"அல்கி","parts":[{"text":"அல்கி","lemma":"அல்கு","gloss":"lingering"}],"gloss":"lying in wait"},{"surface":"வழங்குநர்","parts":[{"text":"வழங்குநர்","lemma":"வழங்குநர்","gloss":"travelers"}],"gloss":"passers-by"},{"surface":"செகுத்த","parts":[{"text":"செகுத்த","lemma":"செகு","gloss":"killed"}],"gloss":"whom they killed"}]},{"words":[{"surface":"படு","parts":[{"text":"படு","lemma":"படு","gloss":"occurring"}],"gloss":"arising"},{"surface":"முடை","parts":[{"text":"முடை","lemma":"முடை","gloss":"stench of flesh"}],"gloss":"stench of corpses"},{"surface":"பருந்து","parts":[{"text":"பருந்து","lemma":"பருந்து","gloss":"vulture"}],"gloss":"vultures"},{"surface":"பார்த்து","parts":[{"text":"பார்த்து","lemma":"பார்","gloss":"watching"}],"gloss":"watching for"},{"surface":"இருக்கும்","parts":[{"text":"இருக்கும்","lemma":"இரு","gloss":"will be"}],"gloss":"staying"}]},{"words":[{"surface":"நெடு","parts":[{"text":"நெடு","lemma":"நெடு","gloss":"vast"}],"gloss":"vast"},{"surface":"மூது","parts":[{"text":"மூது","lemma":"மூது","gloss":"ancient"}],"gloss":"ancient"},{"surface":"இடைய","parts":[{"text":"இடை","lemma":"இடை","gloss":"wasteland"},{"text":"அ","lemma":"அ","gloss":"inflectional suffix"}],"gloss":"wasteland's"},{"surface":"நீரில்","parts":[{"text":"நீர்","lemma":"நீர்","gloss":"water"},{"text":"இல்","lemma":"இல்","gloss":"without"}],"gloss":"waterless"},{"surface":"ஆறே","parts":[{"text":"ஆறு","lemma":"ஆறு","gloss":"path"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"path indeed"}]}],"literal":"Those who destroy what they have are not considered as living / The life of those who have nothing is more disgraceful than begging, thus / showing clearly his strength of resolve / he went, may you live, my friend, always / through the path of the spear-bearing bandits like the God of Death / who stay and linger on the path and kill those who pass by / where vultures watch for the stench of corpses / in the vast ancient wasteland, the path indeed without water.","translation":"My friend, may you live long! He has departed, demonstrating clearly his firm resolve: 'Those who waste their existing wealth are not counted among the living, and the life of those who have nothing is more disgraceful than begging.' He has gone through the waterless path in the vast, ancient wasteland, where vultures watch for the stench of corpses of travelers killed by fierce bandits with murderous spears like Death itself, who lie in wait along the way.","modern":"தோழியே! நீ வாழ்க! 'தம்மிடம் உள்ள பொருளை அழித்து வாழ்பவர்கள் உயிருடன் வாழ்பவர்களாகக் கருதப்பட மாட்டார்கள்; வறுமையில் வாடுபவர்களின் வாழ்க்கை இரந்து கேட்பதை விடவும் இழிவானது' என்று தான் கூறிய உறுதியைத் தெளிவாகக் காட்டிவிட்டு அவர் சென்றுவிட்டார். எமனைப் போன்ற கொலை செய்யும் வேலினை ஏந்திய மறவர்கள், வழியில் தங்கிச் செல்வோரைக் கொன்று குவித்ததால் உண்டான பிண நாற்றத்தை எதிர்நோக்கிப் பருந்துகள் காத்திருக்கும், நீர் இல்லாத, நீண்ட பழமையான பாலைநில வழியில்தான் அவர் சென்றுள்ளார்.","explanation":"The heroine is speaking to her confidante (tōḻi) after her lover has departed to earn wealth. She recalls his words about the importance of earning wealth: that wasting existing resources is not true living, and living in poverty is worse than begging. To prove his resolve, he has journeyed through a perilous desert path (pālai tiṇai). This path is described as waterless and ancient, infested with ruthless bandits who, like the God of Death, lie in wait to kill travelers, leaving corpses that attract vultures. The harshness of the landscape reflects the immense difficulty of his quest and the strength of his determination, while highlighting the heroine's deep anxiety for his safety.","model":"gemini-3.5-flash"}}