{"text":"kuruntokai","n":283,"lines":["உள்ளது சிதைப்போர் உளரெனப் படாஅர்","இல்லோர் வாழ்க்கை இரவினும் இளிவெனச்","சொல்லிய வன்மை தௌியக் காட்டிச்","சென்றனர் வாழி தோழி யென்றும்","கூற்றத் தன்ன கொலைவேல் மறவர்","ஆற்றிருந் தல்கி வழங்குநர்ச் செகுத்த","படுமுடை பருந்துபார்த் திருக்கும்","நெடுமூ திடைய நீரில் ஆறே"],"tr":["uḷḷatu citaippōr uḷareṉap paṭāar","illōr vāḻkkai iraviṉum iḷiveṉac","colliya vaṉmai tauyak kāṭṭic","ceṉṟaṉar vāḻi tōḻi yeṉṟum","kūṟṟat taṉṉa kolaivēl maṟavar","āṟṟirun talki vaḻaṅkunarc cekutta","paṭumuṭai paruntupārt tirukkum","neṭumū tiṭaiya nīril āṟē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"பாலை பாடிய பெருங்கடுங்கோ","speaker_en":"the heroine (talaivi)","poet_tr":"Pālai Pāṭiya Peruṅkaṭuṅkō"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 31"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 12"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"உள்ளது","tr":"uḷḷatu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"உள்","tr":"uḷ"},{"kind":"nirai","text":"ளது","tr":"ḷatu"}]},{"text":"சிதைப்போர்","tr":"citaippōr","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிதைப்","tr":"citaip"},{"kind":"nēr","text":"போர்","tr":"pōr"}]},{"text":"உளரெனப்","tr":"uḷareṉap","foot":"karuviḷam","acai":[{"kind":"nirai","text":"உள","tr":"uḷa"},{"kind":"nirai","text":"ரெனப்","tr":"reṉap"}]},{"text":"படாஅர்","tr":"paṭāar","foot":"puḷimā","acai":[{"kind":"nirai","text":"படா","tr":"paṭā"},{"kind":"nēr","text":"அர்","tr":"ar"}]}],[{"text":"இல்லோர்","tr":"illōr","foot":"tēmā","acai":[{"kind":"nēr","text":"இல்","tr":"il"},{"kind":"nēr","text":"லோர்","tr":"lōr"}]},{"text":"வாழ்க்கை","tr":"vāḻkkai","foot":"tēmā","acai":[{"kind":"nēr","text":"வாழ்க்","tr":"vāḻk"},{"kind":"nēr","text":"கை","tr":"kai"}]},{"text":"இரவினும்","tr":"iraviṉum","foot