{"text":"kuruntokai","n":246,"lines":["பெருங்கடற் கரையது சிறுவெண் காக்கை","களிற்றுச்செவி யன்ன பாசடை மயக்கிப்","பனிக்கழி துழவும் பானாள் தனித்தோர்","தேர்வந்து பெயர்ந்த தென்ப வதற்கொண்","டோரு மலைக்கு மன்னை பிறரும்","பின்னுவிடு கதுப்பின் மின்னிழை மகளிர்","இளையரு மடவரும் உளரே","அலையாத் தாயரொடு நற்பா லோரே"],"tr":["peruṅkaṭaṟ karaiyatu ciṟuveṇ kākkai","kaḷiṟṟuccevi yaṉṉa pācaṭai mayakkip","paṉikkaḻi tuḻavum pāṉāḷ taṉittōr","tērvantu peyarnta teṉpa vataṟkoṇ","ṭōru malaikku maṉṉai piṟarum","piṉṉuviṭu katuppiṉ miṉṉiḻai makaḷir","iḷaiyaru maṭavarum uḷarē","alaiyāt tāyaroṭu naṟpā lōrē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"கபிலர்","speaker_en":"the heroine (talaivi)","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27, veṇcīr 3, vañcicīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 9, kalittaḷai 2, oṉṟā vañcittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பெருங்கடற்","tr":"peruṅkaṭaṟ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெருங்","tr":"peruṅ"},{"kind":"nirai","text":"கடற்","tr":"kaṭaṟ"}]},{"text":"கரையது","tr":"karaiyatu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கரை","tr":"karai"},{"kind":"nirai","text":"யது","tr":"yatu"}]},{"text":"சிறுவெண்","tr":"ciṟuveṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nēr","text":"வெண்","tr":"veṇ"}]},{"text":"காக்கை","tr":"kākkai","foot":"tēmā","acai":[{"kind":"nēr","text":"காக்","tr":"kāk"},{"kind":"nēr","text":"கை","tr":"kai"}]}],[{"text":"களிற்றுச்செவி","tr":"kaḷiṟṟuccevi","foot":"puḷimāṅkaṉi","acai":[{"kind":"nirai","text":"களிற்","tr":"kaḷiṟ"},{"kind":"nēr","text":"றுச்","tr":"ṟuc"},{"kind":"nirai","text":"செவி","tr":"cevi"}]},{"text":"யன்ன","tr":"yaṉṉa","foot":"tēmā","acai":[{"kind":"nēr