{"text":"kuruntokai","n":104,"lines":["அம்ம வாழி தோழி காதலர்","நூலறு முத்தின் தண்சிதர் உறைப்பத்","தாளித் தண்பவர் நாளா மேயும்","பனிபடு நாளே பிரிந்தனர்","பிரியும் நாளும் பலவா குபவே"],"tr":["amma vāḻi tōḻi kātalar","nūlaṟu muttiṉ taṇcitar uṟaippat","tāḷit taṇpavar nāḷā mēyum","paṉipaṭu nāḷē pirintaṉar","piriyum nāḷum palavā kupavē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"காவன் முல்லைப்பூதனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kāvaṉ Mullaippūtaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அம்ம","tr":"amma","foot":"tēmā","acai":[{"kind":"nēr","text":"அம்","tr":"am"},{"kind":"nēr","text":"ம","tr":"ma"}]},{"text":"வாழி","tr":"vāḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"காதலர்","tr":"kātalar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"தலர்","tr":"talar"}]}],[{"text":"நூலறு","tr":"nūlaṟu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நூ","tr":"nū"},{"kind":"nirai","text":"லறு","tr":"laṟu"}]},{"text":"முத்தின்","tr":"muttiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"முத்","tr":"mut"},{"kind":"nēr","text":"தின்","tr":"tiṉ"}]},{"text":"தண்சிதர்","tr":"taṇcitar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தண்","tr":"taṇ"},{"kind":"nirai","text":"சிதர்","tr":"citar"}]},{"text":"உறைப்பத்","tr":"uṟaippat","foot":"puḷimā","acai":[{"kind":"nirai","text":"உறைப்","tr":"uṟaip"},{"kind":"nēr","text":"பத்","tr":"pat"}]}],[{"text":"தாளித்","tr":"tāḷit","foot":"tēmā","ac