{"text":"kuruntokai","n":64,"lines":["பல்லா நெடுநெறிக் ககன்று வந்தெனப்","புன்றலை மன்றம் நோக்கி மாலை","மடக்கண் குழவி அலவந் தன்ன","நோயேம் ஆகுதல் அறிந்தும்","சேயர்தோழி சேய்நாட் டோரே"],"tr":["pallā neṭuneṟik kakaṉṟu vanteṉap","puṉṟalai maṉṟam nōkki mālai","maṭakkaṇ kuḻavi alavan taṉṉa","nōyēm ākutal aṟintum","cēyartōḻi cēynāṭ ṭōrē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"கருவூர்க் கதப்பிள்ளை","speaker_en":"the heroine (talaivi)","poet_tr":"Karuvūrk Katappiḷḷai"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 2×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, other 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 6, ? 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பல்லா","tr":"pallā","foot":"tēmā","acai":[{"kind":"nēr","text":"பல்","tr":"pal"},{"kind":"nēr","text":"லா","tr":"lā"}]},{"text":"நெடுநெறிக்","tr":"neṭuneṟik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நெடு","tr":"neṭu"},{"kind":"nirai","text":"நெறிக்","tr":"neṟik"}]},{"text":"ககன்று","tr":"kakaṉṟu","foot":"puḷimā","acai":[{"kind":"nirai","text":"ககன்","tr":"kakaṉ"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"வந்தெனப்","tr":"vanteṉap","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வந்","tr":"van"},{"kind":"nirai","text":"தெனப்","tr":"teṉap"}]}],[{"text":"புன்றலை","tr":"puṉṟalai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"புன்","tr":"puṉ"},{"kind":"nirai","text":"றலை","tr":"ṟalai"}]},{"text":"மன்றம்","tr":"maṉṟam","foot":"tēmā","acai":[{"kind":"nēr","text":"மன்","tr":"maṉ"},{"kind":"nēr","text":"றம்","tr":"ṟam"}]},{"text":"நோக்கி","tr":"nōkki","foot":"tēmā","acai":[{"kind":"nēr","text":"நோக்","tr":"nōk"},{"kind":"nēr","text":"கி","tr":"ki"}]},{"text":"மாலை","tr":"mālai","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"லை","tr":"lai"}]}],[{"text":"மடக்க