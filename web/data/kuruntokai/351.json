{"text":"kuruntokai","n":351,"lines":["வளையோய் உவந்திசின் விரைவுறு கொடுந்தாள்","அளைவாழ் அலவன் கூருகிர் வரித்த","ஈர்மணல் மலிர்நெறி சிதைய இழுமென","உருமிசைப் புணரி உடைதரும் துறைவர்க்கு","உரிமை செப்பினர் நமரே விரியலர்ப்","புன்னை ஓங்கிய புலாலஞ் சேரி","இன்னகை ஆயத் தாரோடு","இன்னும் அற்றோஇவ் வழுங்க லூரே"],"tr":["vaḷaiyōy uvanticiṉ viraivuṟu koṭuntāḷ","aḷaivāḻ alavaṉ kūrukir varitta","īrmaṇal malirneṟi citaiya iḻumeṉa","urumicaip puṇari uṭaitarum tuṟaivarkku","urimai ceppiṉar namarē viriyalarp","puṉṉai ōṅkiya pulālañ cēri","iṉṉakai āyat tārōṭu","iṉṉum aṟṟōiv vaḻuṅka lūrē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தோழி கூற்று","poet_ta":"அம்மூவனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Ammūvaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 19, veṇṭaḷai 9, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வளையோய்","tr":"vaḷaiyōy","foot":"puḷimā","acai":[{"kind":"nirai","text":"வளை","tr":"vaḷai"},{"kind":"nēr","text":"யோய்","tr":"yōy"}]},{"text":"உவந்திசின்","tr":"uvanticiṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"உவந்","tr":"uvan"},{"kind":"nirai","text":"திசின்","tr":"ticiṉ"}]},{"text":"விரைவுறு","tr":"viraivuṟu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விரை","tr":"virai"},{"kind":"nirai","text":"வுறு","tr":"vuṟu"}]},{"text":"கொடுந்தாள்","tr":"koṭuntāḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கொடுந்","tr":"koṭun"},{"kind":"nēr","text":"தாள்","tr":"tāḷ"}]}],[{"text":"அளைவாழ்","tr":"aḷaivāḻ","foot":"puḷimā","acai":[{"kind":"nirai","text":"அளை","tr":"aḷai"},{"kind":"nēr","text":"வாழ்","tr":"vāḻ"}]},{"text":"அலவன்","tr":"alavaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"அல","tr":"ala"},{"kind":"nēr","text":"வன்","tr":"vaṉ"}]},{"text":"கூர