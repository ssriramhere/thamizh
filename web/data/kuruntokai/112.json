ire"}],"gloss":"love"},{"surface":"எய்க்கும்","parts":[{"text":"எய்","lemma":"எய்","gloss":"diminish"},{"text":"கும்","lemma":"கும்","gloss":"will"}],"gloss":"will fade"}]},{"words":[{"surface":"எள்","parts":[{"text":"எள்","lemma":"எள்","gloss":"scorn"}],"gloss":"scorn"},{"surface":"அற","parts":[{"text":"அறு","lemma":"அறு","gloss":"cease"},{"text":"அ","lemma":"அ","gloss":"to"}],"gloss":"to be removed"},{"surface":"விடினே","parts":[{"text":"விடு","lemma":"விடு","gloss":"leave"},{"text":"இன்","lemma":"இன்","gloss":"if"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"if left indeed"},{"surface":"உள்ளது","parts":[{"text":"உள்","lemma":"உள்","gloss":"exist"},{"text":"அது","lemma":"அது","gloss":"that which"}],"gloss":"that which remains"},{"surface":"நாணே","parts":[{"text":"நாண்","lemma":"நாண்","gloss":"modesty"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"modesty indeed"}]},{"words":[{"surface":"பெருமை","parts":[{"text":"பெருமை","lemma":"பெருமை","gloss":"greatness"}],"gloss":"great"},{"surface":"களிறு","parts":[{"text":"களிறு","lemma":"களிறு","gloss":"male elephant"}],"gloss":"male elephant"},{"surface":"வாங்க","parts":[{"text":"வாங்கு","lemma":"வாங்கு","gloss":"bend"},{"text":"அ","lemma":"அ","gloss":"when"}],"gloss":"when pulling down"},{"surface":"முரிந்து","parts":[{"text":"முரிந்து","lemma":"முரிந்து","gloss":"having snapped"}],"gloss":"having snapped","split_unverified":true},{"surface":"நிலம்","parts":[{"text":"நிலம்","lemma":"நிலம்","gloss":"ground"}],"gloss":"ground"},{"surface":"படாஅ","parts":[{"text":"படு","lemma":"படு","gloss":"fall"},{"text":"ஆஅ","lemma":"ஆஅ","gloss":"not"}],"gloss":"not touching"}]},{"words":[{"surface":"நார்","parts":[{"text":"நார்","lemma":"நார்","gloss":"fiber"}],"gloss":"bark-fiber"},{"surface":"உடை","parts":[{"text":"உடை","lemma":"உடை","gloss":"possessing"}],"gloss":"having"},{"surface":"ஒசியல்","parts":[{"text":"ஒசி","lemma":"ஒசி","gloss":"bend"},{"text":"அல்","lemma":"அல்","gloss":"noun suffix"}],"gloss":"bent branch"},{"surface":"அற்றே","parts":[{"text":"அற்று","lemma":"அற்று","gloss":"like that"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"is of such nature indeed"}]},{"words":[{"surface":"கண்டிசின்","parts":[{"text":"கண்டிசின்","lemma":"கண்டிசின்","gloss":"behold!"}],"gloss":"behold!","split_unverified":true},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"தோழி","gloss":"friend"}],"gloss":"friend"},{"surface":"அவர்","parts":[{"text":"அவர்","lemma":"அவர்","gloss":"he"}],"gloss":"he"},{"surface":"உண்ட","parts":[{"text":"உண்","lemma":"உண்","gloss":"consume"},{"text":"த்","lemma":"த்","gloss":"past"},{"text":"அ","lemma":"அ","gloss":"adjectival"}],"gloss":"consumed"},{"surface":"என்","parts":[{"text":"என்","lemma":"என்","gloss":"my"}],"gloss":"my"},{"surface":"நலனே","parts":[{"text":"நலன்","lemma":"நலன்","gloss":"beauty"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"beauty indeed"}]}],"literal":"If one fears public gossip, love will fade. / If scorn is removed and left, modesty is what remains. / Like a branch that snaps when a great male elephant pulls it down, but does not touch the ground, / because it is held by its tough bark-fiber, / behold, my friend, the beauty of mine that he consumed!","translation":"If one fears public gossip, love will fade. If one abandons modesty to avoid scorn, only shame remains. Look, my friend, at my beauty which he enjoyed and left behind: it is like a branch pulled down and snapped by a great male elephant, which does not fall to the ground because it is still held by its strong bark-fiber.","modern":"ஊராரின் அலர் தூற்றுதலுக்கு அஞ்சினால் காதல் குறைந்துவிடும். பழிச்சொல் நீங்குமாறு நாணத்தை விட்டுவிட்டால், மிஞ்சுவது வெறும் உயிர்தான். தோழியே! ஒரு பெரிய ஆண் யானை இழுத்து வளைத்ததால் ஒடிந்தும், நார் இன்னும் பற்றிக்கொண்டிருப்பதால் தரையில் விழாமல் தொங்கும் மரக்கிளையைப் போன்றது, அவர் நுகர்ந்து சென்ற என் அழகு!","explanation":"In this Kurinci poem, the heroine speaks to her confidante about her suffering during the secret courtship period. She explains that she is trapped between the fear of public gossip and her desire to preserve her modesty. To illustrate her fragile state, she uses a vivid natural metaphor from the mountainous landscape. Her physical beauty, worn out by the hero's passionate embraces and subsequent absence, is compared to a tree branch snapped by a powerful male elephant. Just as the broken branch does not fall to the ground because it is still held by its tough bark-fiber, her life-breath barely clings to her body due to her deep-rooted love and modesty.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.67,1.1],[1.1,1.51],[1.52,1.6],[1.6,1.6],[1.6,3.8],[3.8,4.0],[4.0,4.2],[4.2,6.1],[6.1,6.2],[6.2,6.9],[6.9,7.2],[7.2,8.3],[8.3,8.84],[9.02,9.2],[9.2,10.2],[10.2,10.8],[10.8,11.1],[11.1,11.2]],"female":[[0.0,0.33],[0.5,1.0],[1.0,1.4],[1.45,1.7],[1.7,2.13],[2.7,3.1],[3.1,3.3],[3.3,3.6],[3.6,5.1],[5.1,5.4],[5.4,6.2],[6.2,6.5],[6.5,7.1],[7.94,8.42],[8.78,8.9],[8.9,10.1],[10.1,10.7],[10.7,11.1],[11.1,11.3]]},"sync":[[["கௌவை","public gossip"]],[["அஞ்சின்","if one fears"]],[["காமம்","love"]],[["எய்க்கும்","will fade"]],[["எள்","scorn"],["அற","to be removed"]],[["விடினே","if left indeed"]],[["உள்ளது","that which remains"]],[["நாணே","modesty indeed"]],[["பெருமை","great"],["களிறு","male elephant"]],[["வாங்க","when pulling down"]],[["முரிந்து","having snapped"],["நிலம்","ground"]],[["படாஅ","not touching"]],[["நார்","bark-fiber"],["உடை","having"]],[["ஒசியல்","bent branch"]],[["அற்றே","is of such nature indeed"]],[["கண்டிசின்","behold!"]],[["தோழி","friend"],["அவர்","he"]],[["உண்ட","consumed"],["என்","my"]],[["நலனே","beauty indeed"]]]}