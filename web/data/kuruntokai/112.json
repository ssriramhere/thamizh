{"text":"kuruntokai","n":112,"lines":["கௌவை யஞ்சிற் காமம் எய்க்கும்","எள்ளற விடினே உள்ளது நாணே","பெருங்களிறு வாங்க முரிந்துநிலம் படாஅ","நாருடை ஒசியல் அற்றே","கண்டிசின் தோழியவர் உண்டஎன் நலனே"],"tr":["kauvai yañciṟ kāmam eykkum","eḷḷaṟa viṭiṉē uḷḷatu nāṇē","peruṅkaḷiṟu vāṅka murintunilam paṭāa","nāruṭai ociyal aṟṟē","kaṇṭiciṉ tōḻiyavar uṇṭaeṉ nalaṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"ஆலத்தூர் கிழார்","speaker_en":"the heroine (talaivi)","poet_tr":"Ālattūr Kiḻār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 16, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 6, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கௌவை","tr":"kauvai","foot":"tēmā","acai":[{"kind":"nēr","text":"கௌ","tr":"kau"},{"kind":"nēr","text":"வை","tr":"vai"}]},{"text":"யஞ்சிற்","tr":"yañciṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"யஞ்","tr":"yañ"},{"kind":"nēr","text":"சிற்","tr":"ciṟ"}]},{"text":"காமம்","tr":"kāmam","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"மம்","tr":"mam"}]},{"text":"எய்க்கும்","tr":"eykkum","foot":"tēmā","acai":[{"kind":"nēr","text":"எய்க்","tr":"eyk"},{"kind":"nēr","text":"கும்","tr":"kum"}]}],[{"text":"எள்ளற","tr":"eḷḷaṟa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"எள்","tr":"eḷ"},{"kind":"nirai","text":"ளற","tr":"ḷaṟa"}]},{"text":"விடினே","tr":"viṭiṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"விடி","tr":"viṭi"},{"kind":"nēr","text":"னே","tr":"ṉē"}]},{"text":"உள்ளது","tr":"uḷḷatu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"உள்","tr":"uḷ"},{"kind":"nirai","text":"ளது","tr":"ḷatu"}]},{"text":"நாணே","tr":"nāṇē","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"ணே","tr":"ṇē"}]}],[{"text":"பெருங்களிறு"