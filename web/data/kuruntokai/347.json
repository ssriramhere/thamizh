{"text":"kuruntokai","n":347,"lines":["மல்குசுனை புலர்ந்த நல்கூர் சுரமுதற்","குமரி வாகைக் கோலுடை நறுவீ","மடமாத் தோகைக் குடுமியிற் றோன்றும்","கான நீளிடைத் தானு நம்மொடு","ஒன்றுமணஞ் செய்தனள் இவளெனின்","நன்றே நெஞ்சம் நயந்தநின் துணிவே"],"tr":["malkucuṉai pularnta nalkūr curamutaṟ","kumari vākaik kōluṭai naṟuvī","maṭamāt tōkaik kuṭumiyiṟ ṟōṉṟum","kāṉa nīḷiṭait tāṉu nammoṭu","oṉṟumaṇañ ceytaṉaḷ ivaḷeṉiṉ","naṉṟē neñcam nayantaniṉ tuṇivē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவன் கூற்று","poet_ta":"காவிரிப்பூம்பட்டினத்துச் சேந்தங் கண்ணனார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Kāvirippūmpaṭṭiṉattuc Cēntaṅ Kaṇṇaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 9, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மல்குசுனை","tr":"malkucuṉai","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"மல்","tr":"mal"},{"kind":"nirai","text":"குசு","tr":"kucu"},{"kind":"nēr","text":"னை","tr":"ṉai"}]},{"text":"புலர்ந்த","tr":"pularnta","foot":"puḷimā","acai":[{"kind":"nirai","text":"புலர்ந்","tr":"pularn"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"நல்கூர்","tr":"nalkūr","foot":"tēmā","acai":[{"kind":"nēr","text":"நல்","tr":"nal"},{"kind":"nēr","text":"கூர்","tr":"kūr"}]},{"text":"சுரமுதற்","tr":"curamutaṟ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சுர","tr":"cura"},{"kind":"nirai","text":"முதற்","tr":"mutaṟ"}]}],[{"text":"குமரி","tr":"kumari","foot":"puḷimā","acai":[{"kind":"nirai","text":"கும","tr":"kuma"},{"kind":"nēr","text":"ரி","tr":"ri"}]},{"text":"வாகைக்","tr":"vākaik","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"கைக்","tr":"kaik"}]},{"text":"கோலுடை","tr":"kōluṭai","foot":"kūviḷam","acai":[{"kind":"nēr","text"