{"text":"kuruntokai","n":223,"lines":["பேரூர் கொண்ட ஆர்கலி விழவில்","செல்வாம் செல்வாம் என்றி அன்றிவண்","நல்லோர் நல்ல பலவாற் றில்ல","தழலும் தட்டையும் முறியுந் தந்திவை","ஒத்தன நினக்கெனப் பொய்த்தன கூறி","அன்னை யோம்பிய ஆய்நலம்","என்னை கொண்டான்யாம் இன்னமா லினியே"],"tr":["pērūr koṇṭa ārkali viḻavil","celvām celvām eṉṟi aṉṟivaṇ","nallōr nalla palavāṟ ṟilla","taḻalum taṭṭaiyum muṟiyun tantivai","ottaṉa niṉakkeṉap poyttaṉa kūṟi","aṉṉai yōmpiya āynalam","eṉṉai koṇṭāṉyām iṉṉamā liṉiyē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"மதுரைக் கடையத்தார் மகனார் வெண்ணாகனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Maturaik Kaṭaiyattār Makaṉār Veṇṇākaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 9, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பேரூர்","tr":"pērūr","foot":"tēmā","acai":[{"kind":"nēr","text":"பே","tr":"pē"},{"kind":"nēr","text":"ரூர்","tr":"rūr"}]},{"text":"கொண்ட","tr":"koṇṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"கொண்","tr":"koṇ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"ஆர்கலி","tr":"ārkali","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஆர்","tr":"ār"},{"kind":"nirai","text":"கலி","tr":"kali"}]},{"text":"விழவில்","tr":"viḻavil","foot":"puḷimā","acai":[{"kind":"nirai","text":"விழ","tr":"viḻa"},{"kind":"nēr","text":"வில்","tr":"vil"}]}],[{"text":"செல்வாம்","tr":"celvām","foot":"tēmā","acai":[{"kind":"nēr","text":"செல்","tr":"cel"},{"kind":"nēr","text":"வாம்","tr":"vām"}]},{"text":"செல்வாம்","tr":"celvām","foot":"tēmā","acai":[{"kind":"nēr","text":"செல்","tr":"cel"},{"kind":"nēr","text":"வாம்","tr":"vām"}]},{"text":"என்றி","tr":"eṉṟi","foot":"tēmā","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nēr"