"தி","lemma":"ti","gloss":"second-person singular suffix"}],"gloss":"you say"},{"surface":"அன்று","parts":[{"text":"அன்று","lemma":"aṉṟu","gloss":"that day"}],"gloss":"on that day"},{"surface":"இவண்","parts":[{"text":"இவண்","lemma":"ivaṇ","gloss":"here"}],"gloss":"here"}]},{"words":[{"surface":"நல்லோர்","parts":[{"text":"நல்","lemma":"nal","gloss":"good"},{"text":"ஓர்","lemma":"ōr","gloss":"people"}],"gloss":"good people"},{"surface":"நல்ல","parts":[{"text":"நல்","lemma":"nal","gloss":"good"},{"text":"அ","lemma":"a","gloss":"neuter plural suffix"}],"gloss":"good things"},{"surface":"பலவாற்று","parts":[{"text":"பலவாற்று","lemma":"பலவாற்று","gloss":"in many ways"}],"gloss":"in many ways","split_unverified":true},{"surface":"இல்ல","parts":[{"text":"இல்","lemma":"il","gloss":"not"},{"text":"அ","lemma":"a","gloss":"neuter plural suffix"}],"gloss":"are not there"}]},{"words":[{"surface":"தழலும்","parts":[{"text":"தழல்","lemma":"taḻal","gloss":"rattle"},{"text":"உம்","lemma":"um","gloss":"and"}],"gloss":"and the rattle"},{"surface":"தட்டையும்","parts":[{"text":"தட்டை","lemma":"taṭṭai","gloss":"bamboo clapper"},{"text":"உம்","lemma":"um","gloss":"and"}],"gloss":"and the clapper"},{"surface":"முறியும்","parts":[{"text":"முறி","lemma":"muṟi","gloss":"leafy shoot"},{"text":"உம்","lemma":"um","gloss":"and"}],"gloss":"and the leafy shoots"},{"surface":"தந்து","parts":[{"text":"தந்து","lemma":"தந்து","gloss":"having given"}],"gloss":"having given","split_unverified":true},{"surface":"இவை","parts":[{"text":"இவை","lemma":"ivai","gloss":"these"}],"gloss":"these"}]},{"words":[{"surface":"ஒத்தன","parts":[{"text":"ஒத்தன","lemma":"ஒத்தன","gloss":"they are suitable"}],"gloss":"they are suitable","split_unverified":true},{"surface":"நினக்கு","parts":[{"text":"நினக்கு","lemma":"நினக்கு","gloss":"to you"}],"gloss":"to you","split_unverified":true},{"surface":"என","parts":[{"text":"என்","lemma":"eṉ","gloss":"say"},{"text":"அ","lemma":"a","gloss":"infinitive suffix"}],"gloss":"saying"},{"surface":"பொய்த்தன","parts":[{"text":"பொய்","lemma":"poy","gloss":"lie"},{"text":"த்","lemma":"t","gloss":"past tense marker"},{"text":"த்","lemma":"t","gloss":"glide"},{"text":"அன","lemma":"aṉa","gloss":"they"}],"gloss":"lies"},{"surface":"கூறி","parts":[{"text":"கூறு","lemma":"kūṟu","gloss":"say"},{"text":"இ","lemma":"i","gloss":"verbal participle suffix"}],"gloss":"having spoken"}]},{"words":[{"surface":"அன்னை","parts":[{"text":"அன்னை","lemma":"aṉṉai","gloss":"mother"}],"gloss":"mother"},{"surface":"ஓம்பிய","parts":[{"text":"ஓம்பு","lemma":"ōmpu","gloss":"protect"},{"text":"இ","lemma":"i","gloss":"past tense marker"},{"text":"அ","lemma":"a","gloss":"adjectival participle suffix"}],"gloss":"protected"},{"surface":"ஆய்நலம்","parts":[{"text":"ஆய்","lemma":"āy","gloss":"choice"},{"text":"நலம்","lemma":"nalam","gloss":"beauty"}],"gloss":"choice beauty"}]},{"words":[{"surface":"என்னை","parts":[{"text":"என்","lemma":"eṉ","gloss":"my"},{"text":"ஐ","lemma":"ai","gloss":"lord"}],"gloss":"my lord"},{"surface":"கொண்டான்","parts":[{"text":"கொண்டான்","lemma":"கொண்டான்","gloss":"he took"}],"gloss":"he took","split_unverified":true},{"surface":"யாம்","parts":[{"text":"யாம்","lemma":"yām","gloss":"we"}],"gloss":"we"},{"surface":"இன்னம்","parts":[{"text":"இன்னம்","lemma":"iṉṉam","gloss":"of this state"}],"gloss":"are of this state"},{"surface":"ஆல்","parts":[{"text":"ஆல்","lemma":"āl","gloss":"indeed"}],"gloss":"indeed"},{"surface":"இனியே","parts":[{"text":"இனி","lemma":"iṉi","gloss":"now"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"now"}]}],"literal":"In the bustling festival of the great town / 'We will go, we will go,' you say, but on that day, here / good people, good things, in many ways, are not there. / Giving the rattle, the clapper, and leafy shoots, and saying 'These / are suitable for you,' speaking lies, / the choice beauty protected by my mother, / my lord took; we are of this state now.","translation":"You say, 'We shall go, we shall go to the bustling festival in the great town.' But on that day, here, there are no good people to help us in many ways. Giving me the rattle, the bamboo clapper, and leafy shoots, and saying, 'These suit you well,' he spoke lies and took away my choice beauty that my mother had guarded so carefully. And now, this is the state we are in.","modern":"பெரிய ஊரில் நடைபெறும் ஆரவாரம் மிக்க திருவிழாவிற்கு 'நாம் போவோம், போவோம்' என்று நீ சொல்கிறாய். ஆனால், அன்று அங்கே நமக்கு உதவி செய்யக்கூடிய நல்லவர்கள் பல வழிகளிலும் இருக்க மாட்டார்கள். தழல், தட்டை, தழை ஆகியவற்றைத் தந்து, 'இவை உனக்குப் பொருத்தமானவை' என்று பொய் மொழிகளைக் கூறி, என் தாய் பாதுகாத்த எனது அழகை என் தலைவன் கவர்ந்து கொண்டான். இப்போது நாம் இந்த நிலையில் இருக்கிறோம்.","explanation":"The heroine (தலைவி) is speaking to her friend (தோழி) in a kuṟiñci (mountainous) landscape. The friend suggests that they go to a festival in a big town, perhaps to distract the heroine or to find a way to meet the hero. The heroine refuses, recalling how the hero first approached her when she was guarding the millet fields. He had given her playthings like the rattle (தழல்), the bamboo clapper (தட்டை), and leafy shoots (முறி), praising her beauty with sweet, false words, and eventually won her heart and took away her innocence and beauty. She points out that during the crowded festival, there will be no trustworthy people to help them, and she is now left in a state of pining, having surrendered everything to her lover.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.3],[0.3,0.6],[0.6,0.9],[0.9,1.4],[1.4,2.1],[2.1,2.3],[2.3,2.7],[2.7,3.3],[3.3,4.2],[4.2,4.4],[4.4,4.6],[4.68,5.0],[5.0,6.2],[6.2,6.4],[6.4,6.7],[6.7,7.5],[7.5,8.5],[8.5,9.1],[9.1,9.6],[9.6,10.0],[10.0,10.6],[10.68,11.1],[11.1,11.7],[11.7,12.4],[12.4,13.0],[13.0,13.62],[13.62,13.94]],"female":[[0.0,0.35],[0.35,0.7],[0.7,1.0],[1.0,1.6],[1.6,2.7],[2.7,2.9],[2.9,3.5],[3.5,4.1],[4.1,5.2],[5.2,5.4],[5.4,5.6],[5.7,6.1],[6.1,7.3],[7.3,7.5],[7.5,7.9],[7.9,8.7],[8.7,9.5],[9.96,10.3],[10.3,10.8],[10.8,11.16],[11.16,11.7],[12.05,12.4],[12.4,12.8],[12.8,13.66],[13.66,14.6],[14.7,15.15],[15.15,15.53]]},"sync":[[["பேரூர்","great town"]],[["கொண்ட","having"]],[["ஆர்கலி","bustling"]],[["விழவில்","in the festival"]],[["செல்வாம்","we will go"]],[["செல்வாம்","we will go"]],[["என்றி","you say"]],[["அன்று","on that day"],["இவண்","here"]],[["நல்லோர்","good people"]],[["நல்ல","good things"]],[["பலவாற்று","in many ways"]],[["பலவாற்று","in many ways"],["இல்ல","are not there"]],[["தழலும்","and the rattle"]],[["தட்டையும்","and the clapper"]],[["முறியும்","and the leafy shoots"]],[["தந்து","having given"],["இவை","these"]],[["ஒத்தன","they are suitable"]],[["நினக்கு","to you"],["என","saying"]],[["பொய்த்தன","lies"]],[["கூறி","having spoken"]],[["அன்னை","mother"]],[["ஓம்பிய","protected"]],[["ஆய்நலம்","choice beauty"]],[["என்னை","my lord"]],[["கொண்டான்","he took"],["யாம்","we"]],[["இன்னம்","are of this state"]],[["ஆல்","indeed"],["இனியே","now"]]]}