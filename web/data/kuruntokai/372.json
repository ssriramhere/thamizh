{"text":"kuruntokai","n":372,"lines":["பனைத்தலைக் கருக்குடை நெடுமடல் குருத்தொடு மாயக்","கடுவளி தொகுத்த நெடுவெண் குப்பைக்","கணங்கொள் சிமைய வணங்குங் கானல்","ஆழிதலை வீசிய வயிர்ச்சேற் றருவிக்","கூழைபெய் எக்கர்க் குழீஇய பதுக்கை","புலர்பதங் கொள்ளா வளவை","அலரெழுந் தன்றிவ் வழங்க லூரே"],"tr":["paṉaittalaik karukkuṭai neṭumaṭal kuruttoṭu māyak","kaṭuvaḷi tokutta neṭuveṇ kuppaik","kaṇaṅkoḷ cimaiya vaṇaṅkuṅ kāṉal","āḻitalai vīciya vayirccēṟ ṟaruvik","kūḻaipey ekkark kuḻīiya patukkai","pularpataṅ koḷḷā vaḷavai","alareḻun taṉṟiv vaḻaṅka lūrē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தோழி கூற்று","poet_ta":"விற்றூற்று மூதெயினனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Viṟṟūṟṟu Mūteyiṉaṉār"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"1×5, 5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 16, āciriyattaḷai 11"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"1 five-foot line (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"பனைத்தலைக்","tr":"paṉaittalaik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பனைத்","tr":"paṉait"},{"kind":"nirai","text":"தலைக்","tr":"talaik"}]},{"text":"கருக்குடை","tr":"karukkuṭai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கருக்","tr":"karuk"},{"kind":"nirai","text":"குடை","tr":"kuṭai"}]},{"text":"நெடுமடல்","tr":"neṭumaṭal","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நெடு","tr":"neṭu"},{"kind":"nirai","text":"மடல்","tr":"maṭal"}]},{"text":"குருத்தொடு","tr":"kuruttoṭu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குருத்","tr":"kurut"},{"kind":"nirai","text":"தொடு","tr":"toṭu"}]},{"text":"மாயக்","tr":"māyak","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"யக்","tr":"yak"}]}],[{"text":"கடுவளி","tr":"kaṭuvaḷi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கடு","