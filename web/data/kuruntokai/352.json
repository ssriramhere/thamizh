ṇā","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"ணா","tr":"ṇā"}]},{"text":"ஊங்கே","tr":"ūṅkē","foot":"tēmā","acai":[{"kind":"nēr","text":"ஊங்","tr":"ūṅ"},{"kind":"nēr","text":"கே","tr":"kē"}]}]]},"ai":{"lines":[{"words":[{"surface":"நெடு","parts":[{"text":"நெடு","lemma":"நெடு","gloss":"deep"}],"gloss":"deep"},{"surface":"நீர்","parts":[{"text":"நீர்","lemma":"நீர்","gloss":"water"}],"gloss":"water"},{"surface":"ஆம்பல்","parts":[{"text":"ஆம்பல்","lemma":"ஆம்பல்","gloss":"water lily"}],"gloss":"water lily"},{"surface":"அடை","parts":[{"text":"அடை","lemma":"அடை","gloss":"leaf"}],"gloss":"leaf"},{"surface":"புறத்து","parts":[{"text":"புறத்து","lemma":"புறத்து","gloss":"on the back side"}],"gloss":"on the back side","split_unverified":true},{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"அன்ன","gloss":"like"}],"gloss":"like"}]},{"words":[{"surface":"கொடு","parts":[{"text":"கொடு","lemma":"கொடு","gloss":"curved"}],"gloss":"curved"},{"surface":"மென்","parts":[{"text":"மென்","lemma":"மென்","gloss":"soft"}],"gloss":"soft","split_unverified":true},{"surface":"சிறைய","parts":[{"text":"சிறை","lemma":"சிறை","gloss":"wing"},{"text":"அ","lemma":"அ","gloss":"having"}],"gloss":"having wings"},{"surface":"கூர்","parts":[{"text":"கூர்","lemma":"கூர்","gloss":"sharp"}],"gloss":"sharp"},{"surface":"உகிர்ப்","parts":[{"text":"உகிர்ப்","lemma":"உகிர்ப்","gloss":"clawed"}],"gloss":"clawed","split_unverified":true},{"surface":"பறவை","parts":[{"text":"பறவை","lemma":"பறவை","gloss":"bird"}],"gloss":"bird"}]},{"words":[{"surface":"அகல்","parts":[{"text":"அகல்","lemma":"அகல்","gloss":"wide"}],"gloss":"wide"},{"surface":"இலைப்","parts":[{"text":"இலைப்","lemma":"இலைப்","gloss":"leaved"}],"gloss":"leaved","split_unverified":true},{"surface":"பலவின்","parts":[{"text":"பலவின்","lemma":"பலவின்","gloss":"of the jackfruit tree"}],"gloss":"of the jackfruit tree","split_unverified":true},{"surface":"சாரல்","parts":[{"text":"சாரல்","lemma":"சாரல்","gloss":"mountain slope"}],"gloss":"mountain slope"},{"surface":"முன்னி","parts":[{"text":"முன்னு","lemma":"முன்னு","gloss":"to approach"},{"text":"இ","lemma":"இ","gloss":"having"}],"gloss":"approaching"}]},{"words":[{"surface":"பகல்","parts":[{"text":"பகல்","lemma":"பகல்","gloss":"daytime"}],"gloss":"daytime"},{"surface":"உறை","parts":[{"text":"உறை","lemma":"உறை","gloss":"to dwell"}],"gloss":"dwelling"},{"surface":"முது","parts":[{"text":"முது","lemma":"முது","gloss":"old"}],"gloss":"old"},{"surface":"மரம்","parts":[{"text":"மரம்","lemma":"மரம்","gloss":"tree"}],"gloss":"tree"},{"surface":"புலம்ப","parts":[{"text":"புலம்பு","lemma":"புலம்பு","gloss":"to feel lonely"},{"text":"அ","lemma":"அ","gloss":"to"}],"gloss":"to feel lonely"},{"surface":"போகும்","parts":[{"text":"போகும்","lemma":"போகும்","gloss":"departing"}],"gloss":"departing","split_unverified":true}]},{"words":[{"surface":"சிறு","parts":[{"text":"சிறு","lemma":"சிறு","gloss":"small"}],"gloss":"small"},{"surface":"புன்","parts":[{"text":"புன்","lemma":"புன்","gloss":"sorrowful"}],"gloss":"sorrowful","split_unverified":true},{"surface":"மாலை","parts":[{"text":"மாலை","lemma":"மாலை","gloss":"evening"}],"gloss":"evening"},{"surface":"உண்மை","parts":[{"text":"உண்மை","lemma":"உண்மை","gloss":"existence"}],"gloss":"existence","split_unverified":true}]},{"words":[{"surface":"அறிவேன்","parts":[{"text":"அறி","lemma":"அறி","gloss":"to know"},{"text":"வ்","lemma":"வ்","gloss":"future/habitual marker"},{"text":"ஏன்","lemma":"ஏன்","gloss":"I"}],"gloss":"I know"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"தோழி","gloss":"friend"}],"gloss":"friend"},{"surface":"அவர்க்","parts":[{"text":"அவர்க்","lemma":"அவர்க்","gloss":"him"}],"gloss":"him","split_unverified":true},{"surface":"காணா","parts":[{"text":"காண்","lemma":"காண்","gloss":"to see"},{"text":"ஆ","lemma":"ஆ","gloss":"not"}],"gloss":"not seeing"},{"surface":"ஊங்கே","parts":[{"text":"ஊங்கு","lemma":"ஊங்கு","gloss":"before"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"even before"}]}],"literal":"Like the back of the leaves of water lilies in deep water, / birds with curved soft wings and sharp claws, / heading towards the mountain slopes of wide-leaved jackfruit trees, / depart, leaving the ancient trees where they stayed during the day to feel lonely. / The existence of this small, sorrowful evening, / I knew, oh friend, even before not seeing him.","translation":"Like the underside of water-lily leaves in deep water, birds with curved, soft wings and sharp claws fly toward the mountain slopes rich in wide-leaved jackfruit trees, leaving the ancient trees where they roosted by day to suffer in loneliness. Oh friend, I already knew the painful reality of this brief, sorrowful evening, even before I was separated from him.","modern":"ஆழமான நீரில் உள்ள அல்லி இலையின் பின்புறத்தைப் போன்ற, வளைந்த மென்மையான இறக்கைகளையும் கூர்மையான நகங்களையும் உடைய வௌவால்கள், அகன்ற இலைகளைக் கொண்ட பலா மரங்கள் நிறைந்த மலைச்சரிவை நோக்கிச் செல்கின்றன; இதனால் அவை பகலில் தங்கியிருந்த பழமையான மரங்கள் தனிமையில் வாடி வருந்தும்படி அவை கடந்து போகின்றன. தோழியே! அவரைப் பிரிந்து காண்பதற்கு முன்னரே, இந்தச் சிறிய துன்பம் தரும் மாலைப் பொழுதின் தன்மையை நான் நன்கு அறிந்திருந்தேன்.","explanation":"This poem is set in the Pālai (wasteland/separation) landscape, where the heroine speaks to her close friend about her intense grief. Her lover has gone away on a journey, and the arrival of evening makes her feel utterly abandoned. She describes bats (referred to as birds with curved soft wings and sharp claws, resembling the underside of water-lily leaves) leaving their daytime roosts in ancient trees to fly toward the jackfruit orchards on the mountain slopes. This departure leaves the daytime trees 'lonely' (pulampa), mirroring her own state of abandonment. She tells her friend that she was already aware of how agonizing the evening could be, even before she experienced this actual separation from him, highlighting her deep anxiety and the inevitable pain of twilight.","model":"gemini-3.5-flash"}}