{"text":"kuruntokai","n":352,"lines":["நெடுநீ ராம்பல் அடைப்புறத் தன்ன","கொடுமென் சிறைய கூருகிர்ப் பறவை","அகலிலைப் பலவின் சாரல் முன்னிப்","பகலுறை முதுமரம் புலம்பப் போகும்","சிறுபுன் மாலை உண்மை","அறிவேன் தோழியவர்க் காணா ஊங்கே"],"tr":["neṭunī rāmpal aṭaippuṟat taṉṉa","koṭumeṉ ciṟaiya kūrukirp paṟavai","akalilaip palaviṉ cāral muṉṉip","pakaluṟai mutumaram pulampap pōkum","ciṟupuṉ mālai uṇmai","aṟivēṉ tōḻiyavark kāṇā ūṅkē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"கடியலூர் உருத்திரங்கண்ணனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kaṭiyalūr Uruttiraṅkaṇṇaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 9"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நெடுநீ","tr":"neṭunī","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெடு","tr":"neṭu"},{"kind":"nēr","text":"நீ","tr":"nī"}]},{"text":"ராம்பல்","tr":"rāmpal","foot":"tēmā","acai":[{"kind":"nēr","text":"ராம்","tr":"rām"},{"kind":"nēr","text":"பல்","tr":"pal"}]},{"text":"அடைப்புறத்","tr":"aṭaippuṟat","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அடைப்","tr":"aṭaip"},{"kind":"nirai","text":"புறத்","tr":"puṟat"}]},{"text":"தன்ன","tr":"taṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"தன்","tr":"taṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]}],[{"text":"கொடுமென்","tr":"koṭumeṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கொடு","tr":"koṭu"},{"kind":"nēr","text":"மென்","tr":"meṉ"}]},{"text":"சிறைய","tr":"ciṟaiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிறை","tr":"ciṟai"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"கூருகிர்ப்","tr":"kūrukirp","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கூ","tr":"kū"},{"kind":"nirai","text":"ருகிர்ப்","tr":"rukirp"}]},{"text":"பறவை","tr":"paṟava