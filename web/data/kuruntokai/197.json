{"text":"kuruntokai","n":197,"lines":["யாதுசெய் வாங்கொல் தோழி நோதக","நீரெதிர் கருவிய காரெதிர் கிளைமழை","ஊதையங் குளிரொடு பேதுற்று மயங்கிய","கூதிர் உருவிற் கூற்றம்","காதலர்ப் பிரிந்த எற்குறித்து வருமே"],"tr":["yātucey vāṅkol tōḻi nōtaka","nīretir karuviya kāretir kiḷaimaḻai","ūtaiyaṅ kuḷiroṭu pētuṟṟu mayaṅkiya","kūtir uruviṟ kūṟṟam","kātalarp pirinta eṟkuṟittu varumē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"கச்சிப்பேட்டு நன்னாகையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kaccippēṭṭu Naṉṉākaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 16, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 8, veṇṭaḷai 7, kalittaḷai 3"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"யாதுசெய்","tr":"yātucey","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nirai","text":"துசெய்","tr":"tucey"}]},{"text":"வாங்கொல்","tr":"vāṅkol","foot":"tēmā","acai":[{"kind":"nēr","text":"வாங்","tr":"vāṅ"},{"kind":"nēr","text":"கொல்","tr":"kol"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"நோதக","tr":"nōtaka","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நோ","tr":"nō"},{"kind":"nirai","text":"தக","tr":"taka"}]}],[{"text":"நீரெதிர்","tr":"nīretir","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nirai","text":"ரெதிர்","tr":"retir"}]},{"text":"கருவிய","tr":"karuviya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கரு","tr":"karu"},{"kind":"nirai","text":"விய","tr":"viya"}]},{"text":"காரெதிர்","tr":"kāretir","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"ரெதிர்","tr":"retir"}]},{"text":"கிளைமழை","tr":"kiḷaimaḻai","foot":"karuviḷam","acai":[{"kind":"nirai","te