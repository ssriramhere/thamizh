{"text":"kuruntokai","n":378,"lines":["ஞாயிறு காயாது மரநிழற் பட்டு","மலைமுதற் சிறுநெறி மணன்மிகத் தாஅய்த்","தண்மழை தலையின் றாக நந்நீத்துச்","சுடர்வாய் நெடுவேற் காளையொடு","மடமா அரிவை போகிய சுரனே"],"tr":["ñāyiṟu kāyātu maraniḻaṟ paṭṭu","malaimutaṟ ciṟuneṟi maṇaṉmikat tāayt","taṇmaḻai talaiyiṉ ṟāka nannīttuc","cuṭarvāy neṭuvēṟ kāḷaiyoṭu","maṭamā arivai pōkiya curaṉē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"செவிலி கூற்று","poet_ta":"கயமனார்","speaker_en":"the foster-mother (cevili)","poet_tr":"Kayamaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 16, veṇcīr 2, vañcicīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 9, veṇṭaḷai 6, kalittaḷai 2, oṉṟiya vañcittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஞாயிறு","tr":"ñāyiṟu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஞா","tr":"ñā"},{"kind":"nirai","text":"யிறு","tr":"yiṟu"}]},{"text":"காயாது","tr":"kāyātu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"மரநிழற்","tr":"maraniḻaṟ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மர","tr":"mara"},{"kind":"nirai","text":"நிழற்","tr":"niḻaṟ"}]},{"text":"பட்டு","tr":"paṭṭu","foot":"tēmā","acai":[{"kind":"nēr","text":"பட்","tr":"paṭ"},{"kind":"nēr","text":"டு","tr":"ṭu"}]}],[{"text":"மலைமுதற்","tr":"malaimutaṟ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மலை","tr":"malai"},{"kind":"nirai","text":"முதற்","tr":"mutaṟ"}]},{"text":"சிறுநெறி","tr":"ciṟuneṟi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nirai","text":"நெறி","tr":"neṟi"}]},{"text":"மணன்மிகத்","tr":"maṇaṉmikat","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மணன்","tr":"maṇaṉ"},{"kind":"nirai","text":"மிகத்","tr":"mikat"}]},{"text":