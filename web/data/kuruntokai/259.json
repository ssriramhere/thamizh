:[{"text":"தருவி","lemma":"தருவி","gloss":""}],"gloss":"","split_unverified":true},{"surface":"யார்ந்த","parts":[{"text":"யார்ந்த","lemma":"யார்ந்த","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தண்ணறுங்","parts":[{"text":"தண்ணறுங்","lemma":"தண்ணறுங்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"காந்தள்","parts":[{"text":"காந்தள்","lemma":"காந்தள்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"முகையவிழந்","parts":[{"text":"முகையவிழந்","lemma":"முகையவிழந்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தானா","parts":[{"text":"தானா","lemma":"தானா","gloss":""}],"gloss":"","split_unverified":true},{"surface":"நாறு","parts":[{"text":"நாறு","lemma":"நாறு","gloss":""}],"gloss":"","split_unverified":true},{"surface":"நறுநுதல்","parts":[{"text":"நறுநுதல்","lemma":"நறுநுதல்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"பல்","parts":[{"text":"பல்","lemma":"பல்","gloss":"many"}],"gloss":"many"},{"surface":"இதழ்","parts":[{"text":"இதழ்","lemma":"இதழ்","gloss":"petal"}],"gloss":"petal"},{"surface":"மழை","parts":[{"text":"மழை","lemma":"மழை","gloss":"cool"}],"gloss":"cool"},{"surface":"கண்","parts":[{"text":"கண்","lemma":"கண்","gloss":"eye"}],"gloss":"eye"},{"surface":"மாஅயோயே","parts":[{"text":"மாஅயோய்","lemma":"மாஅயோள்","gloss":"dark-skinned woman"},{"text":"ஏ","lemma":"ஏ","gloss":"vocative particle"}],"gloss":"O dark-skinned woman!"}]},{"words":[{"surface":"ஒல்வை","parts":[{"text":"ஒல்வை","lemma":"ஒல்","gloss":"you will agree"}],"gloss":"you will agree"},{"surface":"ஆயினும்","parts":[{"text":"ஆயினும்","lemma":"ஆயினும்","gloss":"even if"}],"gloss":"even if"},{"surface":"கொல்வை","parts":[{"text":"கொல்வை","lemma":"கொல்","gloss":"you will kill"}],"gloss":"you will kill"},{"surface":"ஆயினும்","parts":[{"text":"ஆயினும்","lemma":"ஆயினும்","gloss":"even if"}],"gloss":"even if"}]},{"words":[{"surface":"நீ","parts":[{"text":"நீ","lemma":"நீ","gloss":"you"}],"gloss":"you"},{"surface":"அளந்து","parts":[{"text":"அளந்து","lemma":"அள","gloss":"having measured"}],"gloss":"having measured"},{"surface":"அறிவை","parts":[{"text":"அறிவை","lemma":"அறி","gloss":"you know"}],"gloss":"you know"},{"surface":"நின்","parts":[{"text":"நின்","lemma":"நின்","gloss":"your"}],"gloss":"your"},{"surface":"புரைமை","parts":[{"text":"புரைமை","lemma":"புரைமை","gloss":"greatness"}],"gloss":"greatness"},{"surface":"வாய்","parts":[{"text":"வாய்","lemma":"வாய்","gloss":"truth"}],"gloss":"truth"},{"surface":"போல்","parts":[{"text":"போல்","lemma":"போல்","gloss":"like"}],"gloss":"like"}]},{"words":[{"surface":"பொய்ம்மொழி","parts":[{"text":"பொய்ம்மொழி","lemma":"பொய்ம்மொழி","gloss":"false words"}],"gloss":"false words","split_unverified":true},{"surface":"கூறல்","parts":[{"text":"கூறல்","lemma":"கூறல்","gloss":"speaking"}],"gloss":"speaking"},{"surface":"அஃது","parts":[{"text":"அஃது","lemma":"அஃது","gloss":"that"}],"gloss":"that"},{"surface":"எவனோ","parts":[{"text":"எவன்","lemma":"எவன்","gloss":"why"},{"text":"ஓ","lemma":"ஓ","gloss":"question particle"}],"gloss":"why"}]},{"words":[{"surface":"நெஞ்சம்","parts":[{"text":"நெஞ்சம்","lemma":"நெஞ்சம்","gloss":"heart"}],"gloss":"heart"},{"surface":"நன்றே","parts":[{"text":"நன்று","lemma":"நன்று","gloss":"is good"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"is good indeed"},{"surface":"நின்","parts":[{"text":"நின்","lemma":"நின்","gloss":"your"}],"gloss":"your"},{"surface":"வயின்","parts":[{"text":"வயின்","lemma":"வயின்","gloss":"side"}],"gloss":"side"},{"surface":"ஆனே","parts":[{"text":"ஆன்","lemma":"ஆன்","gloss":"indeed"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis particle"}],"gloss":"indeed"}]}],"literal":"Cloud-reached rising rain hill's / waterfall-filled cool fragrant glory lily / buds having blossomed ceaselessly smelling fragrant forehead, / many-petalled cool eyes, O dark-skinned woman! / Whether you agree or whether you kill, / you, having measured, know your greatness; like truth, / speaking false words, why is that? / The heart is good indeed on your side!","translation":"O dark-skinned woman with many-petalled cool eyes and a fragrant forehead that ceaselessly smells of the cool, sweet glory lily buds blossomed by the waterfalls of the rain-swept hills where clouds gather! Whether you accept him or whether you kill him, you know your own greatness after weighing it. Why then do you speak false words as if they were the truth? His heart is truly good and devoted to you.","modern":"மேகங்கள் சூழ்ந்து எழுகின்ற மழையைப் பொழியும் மலையின் அருவி நீரால் நனைந்து, மலர்ந்த குளிர்ந்த நறுமணமிக்க செங்காந்தள் மொட்டுகளின் ஓயாத நறுமணம் வீசும் நெற்றியையும், பல இதழ்களைக் கொண்ட குளிர்ந்த கண்களையும் உடைய மாஅயோளே! நீ தலைவனை ஏற்றுக்கொண்டாலும் சரி, அல்லது அவனைக் கொன்றாலும் சரி, உன்னுடைய பெருமையை நீயே ஆராய்ந்து அறிவாய். உண்மை போலப் பொய்ம்மொழிகளைக் கூறுவது ஏனோ? அவனுடைய நெஞ்சம் உன்னிடத்தே மிகவும் நல்லதாகவே இருக்கிறது.","explanation":"In this Kuriñci poem, the heroine's close friend (thozhi) speaks to the heroine (thalaivi) who is feigning indifference or anger toward the hero. The friend describes the heroine's beauty using the rich imagery of the mountain landscape, where glory lily buds are nourished by waterfalls on rain-swept hills. She points out that whether the heroine decides to accept the hero's love or reject him (which would be like killing him), she must act with the dignity and greatness that define her. The friend questions why the heroine speaks false words of rejection when her heart is actually filled with love. Ultimately, she reassures the heroine that the hero's heart is entirely good and devoted to her.","model":"gemini-3.5-flash"}}