{"text":"kuruntokai","n":259,"lines":["மழைசேர்ந் தெழுதரு மாரிக் குன்றத்","தருவி யார்ந்த தண்ணறுங் காந்தள்","முகையவிழந் தானா நாறு நறுநுதல்","பல்லிதழ் மழைக்கண் மாஅ யோயே","ஒல்வை யாயினுங் கொல்வை யாயினும்","நீயளந் தறிவைநின் புரைமை வாய்போற்","பொய்ம்மொழி கூறலஃ தெவனோ","நெஞ்ச நன்றே நின்வயி னானே"],"tr":["maḻaicērn teḻutaru mārik kuṉṟat","taruvi yārnta taṇṇaṟuṅ kāntaḷ","mukaiyaviḻan tāṉā nāṟu naṟunutal","pallitaḻ maḻaikkaṇ māa yōyē","olvai yāyiṉuṅ kolvai yāyiṉum","nīyaḷan taṟivainiṉ puraimai vāypōṟ","poymmoḻi kūṟalaḵ tevaṉō","neñca naṉṟē niṉvayi ṉāṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"பரணர்","speaker_en":"her friend (tōḻi)","poet_tr":"Paraṇar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 29, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 12, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மழைசேர்ந்","tr":"maḻaicērn","foot":"puḷimā","acai":[{"kind":"nirai","text":"மழை","tr":"maḻai"},{"kind":"nēr","text":"சேர்ந்","tr":"cērn"}]},{"text":"தெழுதரு","tr":"teḻutaru","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தெழு","tr":"teḻu"},{"kind":"nirai","text":"தரு","tr":"taru"}]},{"text":"மாரிக்","tr":"mārik","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"ரிக்","tr":"rik"}]},{"text":"குன்றத்","tr":"kuṉṟat","foot":"tēmā","acai":[{"kind":"nēr","text":"குன்","tr":"kuṉ"},{"kind":"nēr","text":"றத்","tr":"ṟat"}]}],[{"text":"தருவி","tr":"taruvi","foot":"puḷimā","acai":[{"kind":"nirai","text":"தரு","tr":"taru"},{"kind":"nēr","text":"வி","tr":"vi"}]},{"text":"யார்ந்த","tr":"yārnta","foot":"tēmā","acai":[{"kind":"nēr","text":"யார்ந்","tr":"yārn"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"தண்ணறுங்","tr":"taṇṇaṟuṅ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"த