{"text":"kuruntokai","n":242,"lines":["கானங் கோழி கவர்குரற் சேவல்","ஒண்பொறி எருத்தின் தண்சிதர் உறைப்பப்","புதனீர் வாரும் பூநாறு புறவிற்","சீறூ ரோளே மடந்தை வேறூர்","வேந்துவிடு தொழிலொடு செலினும்","சேந்துவரல் அறியாது செம்மல் தேரே"],"tr":["kāṉaṅ kōḻi kavarkuraṟ cēval","oṇpoṟi eruttiṉ taṇcitar uṟaippap","putaṉīr vārum pūnāṟu puṟaviṟ","cīṟū rōḷē maṭantai vēṟūr","vēntuviṭu toḻiloṭu celiṉum","cēntuvaral aṟiyātu cemmal tērē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"செவிலித்தாய் கூற்று","poet_ta":"குழற்றத்தனார்","speaker_en":"the foster-mother (cevili)","poet_tr":"Kuḻaṟṟattaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 5, kalittaḷai 3"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கானங்","tr":"kāṉaṅ","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"னங்","tr":"ṉaṅ"}]},{"text":"கோழி","tr":"kōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"கோ","tr":"kō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"கவர்குரற்","tr":"kavarkuraṟ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கவர்","tr":"kavar"},{"kind":"nirai","text":"குரற்","tr":"kuraṟ"}]},{"text":"சேவல்","tr":"cēval","foot":"tēmā","acai":[{"kind":"nēr","text":"சே","tr":"cē"},{"kind":"nēr","text":"வல்","tr":"val"}]}],[{"text":"ஒண்பொறி","tr":"oṇpoṟi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஒண்","tr":"oṇ"},{"kind":"nirai","text":"பொறி","tr":"poṟi"}]},{"text":"எருத்தின்","tr":"eruttiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"எருத்","tr":"erut"},{"kind":"nēr","text":"தின்","tr":"tiṉ"}]},{"text":"தண்சிதர்","tr":"taṇcitar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தண்","tr":"taṇ"},{"kind":"nirai","text":"சிதர்","tr":"citar"}]},{"text":"உறைப்பப்","tr":"uṟaippap","foot":"pu