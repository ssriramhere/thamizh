{"text":"kuruntokai","n":354,"lines":["நீர்நீ டாடிற் கண்ணுஞ் சிவக்கும்","ஆர்ந்தோர் வாயில் தேனும் புளிக்கும்","தணந்தனை யாயினெம் இல்லுய்த்துக் கொடுமோ","அந்தண் பொய்கை எந்தை எம்மூர்க்","கடும்பாம்பு வழங்குந் தெருவில்","நடுங்கஞர் எவ்வம் களைந்த எம்மே"],"tr":["nīrnī ṭāṭiṟ kaṇṇuñ civakkum","ārntōr vāyil tēṉum puḷikkum","taṇantaṉai yāyiṉem illuyttuk koṭumō","antaṇ poykai entai emmūrk","kaṭumpāmpu vaḻaṅkun teruvil","naṭuṅkañar evvam kaḷainta emmē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தோழி கூற்று","poet_ta":"கயத்தூர்கிழார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kayattūrkiḻār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 10, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நீர்நீ","tr":"nīrnī","foot":"tēmā","acai":[{"kind":"nēr","text":"நீர்","tr":"nīr"},{"kind":"nēr","text":"நீ","tr":"nī"}]},{"text":"டாடிற்","tr":"ṭāṭiṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"டா","tr":"ṭā"},{"kind":"nēr","text":"டிற்","tr":"ṭiṟ"}]},{"text":"கண்ணுஞ்","tr":"kaṇṇuñ","foot":"tēmā","acai":[{"kind":"nēr","text":"கண்","tr":"kaṇ"},{"kind":"nēr","text":"ணுஞ்","tr":"ṇuñ"}]},{"text":"சிவக்கும்","tr":"civakkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிவக்","tr":"civak"},{"kind":"nēr","text":"கும்","tr":"kum"}]}],[{"text":"ஆர்ந்தோர்","tr":"ārntōr","foot":"tēmā","acai":[{"kind":"nēr","text":"ஆர்ந்","tr":"ārn"},{"kind":"nēr","text":"தோர்","tr":"tōr"}]},{"text":"வாயில்","tr":"vāyil","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"யில்","tr":"yil"}]},{"text":"தேனும்","tr":"tēṉum","foot":"tēmā","acai":[{"kind":"nēr","text":"தே","tr":"tē"},{"kind":"nēr","text":"னும்","tr":"ṉum"}]},{"text":"புளிக்கும்","tr":"puḷikkum","foot":"puḷimā","acai":[{"