{"text":"kuruntokai","n":312,"lines":["இரண்டறி கள்விநங் காத லோளே","முரண்கொள் துப்பிற் செவ்வேன் மலையன்","முள்ளூர்க் கான நாற வந்து","நள்ளென் கங்குல் நம்மோ ரன்னள்","கூந்தல் வேய்ந்த விரவுமலர் உதிர்த்துச்","சாந்துளர் நறுங்கதுப் பெண்ணெய் நீவி","அமரா முகத்த ளாகித்","தமரோ ரன்னள் வைகறை யானே"],"tr":["iraṇṭaṟi kaḷvinaṅ kāta lōḷē","muraṇkoḷ tuppiṟ cevvēṉ malaiyaṉ","muḷḷūrk kāṉa nāṟa vantu","naḷḷeṉ kaṅkul nammō raṉṉaḷ","kūntal vēynta viravumalar utirttuc","cāntuḷar naṟuṅkatup peṇṇey nīvi","amarā mukatta ḷākit","tamarō raṉṉaḷ vaikaṟai yāṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"கபிலர்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 19, veṇṭaḷai 10, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இரண்டறி","tr":"iraṇṭaṟi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இரண்","tr":"iraṇ"},{"kind":"nirai","text":"டறி","tr":"ṭaṟi"}]},{"text":"கள்விநங்","tr":"kaḷvinaṅ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கள்","tr":"kaḷ"},{"kind":"nirai","text":"விநங்","tr":"vinaṅ"}]},{"text":"காத","tr":"kāta","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"லோளே","tr":"lōḷē","foot":"tēmā","acai":[{"kind":"nēr","text":"லோ","tr":"lō"},{"kind":"nēr","text":"ளே","tr":"ḷē"}]}],[{"text":"முரண்கொள்","tr":"muraṇkoḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"முரண்","tr":"muraṇ"},{"kind":"nēr","text":"கொள்","tr":"koḷ"}]},{"text":"துப்பிற்","tr":"tuppiṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"துப்","tr":"tup"},{"kind":"nēr","text":"பிற்","tr":"piṟ"}]},{"text":"செவ்வேன்","tr":"cevvēṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"செவ்","tr":"cev"},{"k