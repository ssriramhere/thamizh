{"text":"kuruntokai","n":328,"lines":["சிறுவீ ஞாழல் வேரளைப் பள்ளி","அலவன் சிறுமனை சிதையப் புணரி","குணில்வாய் முரசின் இயங்குந் துறைவன்","நல்கிய நாள்தவச் சிலவே அலரே","வில்கெழு தானை விச்சியர் பெருமகன்","வேந்தரொடு பொருத ஞான்றைப் பாணர்","புலிநோக் குறழ்நிலை கண்ட","கலிகெழு குறும்பூர் ஆர்ப்பினும் பெரிதே"],"tr":["ciṟuvī ñāḻal vēraḷaip paḷḷi","alavaṉ ciṟumaṉai citaiyap puṇari","kuṇilvāy muraciṉ iyaṅkun tuṟaivaṉ","nalkiya nāḷtavac cilavē alarē","vilkeḻu tāṉai vicciyar perumakaṉ","vēntaroṭu poruta ñāṉṟaip pāṇar","pulinōk kuṟaḻnilai kaṇṭa","kalikeḻu kuṟumpūr ārppiṉum peritē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தோழி கூற்று","poet_ta":"பரணர்","speaker_en":"her friend (tōḻi)","poet_tr":"Paraṇar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 16, āciriyattaḷai 13, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"சிறுவீ","tr":"ciṟuvī","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nēr","text":"வீ","tr":"vī"}]},{"text":"ஞாழல்","tr":"ñāḻal","foot":"tēmā","acai":[{"kind":"nēr","text":"ஞா","tr":"ñā"},{"kind":"nēr","text":"ழல்","tr":"ḻal"}]},{"text":"வேரளைப்","tr":"vēraḷaip","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வே","tr":"vē"},{"kind":"nirai","text":"ரளைப்","tr":"raḷaip"}]},{"text":"பள்ளி","tr":"paḷḷi","foot":"tēmā","acai":[{"kind":"nēr","text":"பள்","tr":"paḷ"},{"kind":"nēr","text":"ளி","tr":"ḷi"}]}],[{"text":"அலவன்","tr":"alavaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"அல","tr":"ala"},{"kind":"nēr","text":"வன்","tr":"vaṉ"}]},{"text":"சிறுமனை","tr":"ciṟumaṉai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nirai","text":"மனை","tr":"maṉai"}]},{"text":"சிதையப்","tr":"citaiyap","foot":"puḷimā","acai":[{"kind":"nira