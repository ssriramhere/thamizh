{"text":"kuruntokai","n":295,"lines":["உடுத்துந் தொடுத்தும் பூண்டுஞ் செரீஇயும்","தழையணிப் பொலிந்த ஆயமொடு துவன்றி","விழவொடு வருதி நீயே யிஃதோ","ஓரான் வல்சிச் சீரில் வாழ்க்கை","பெருநலக் குறுமகள் வந்தென","இனிவிழ வாயிற் றென்னுமிவ் வூரே"],"tr":["uṭuttun toṭuttum pūṇṭuñ cerīiyum","taḻaiyaṇip polinta āyamoṭu tuvaṉṟi","viḻavoṭu varuti nīyē yiḵtō","ōrāṉ valcic cīril vāḻkkai","perunalak kuṟumakaḷ vanteṉa","iṉiviḻa vāyiṟ ṟeṉṉumiv vūrē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தோழி கூற்று","poet_ta":"தூங்கலோரியார்","speaker_en":"her friend (tōḻi)","poet_tr":"Tūṅkalōriyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 7, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"உடுத்துந்","tr":"uṭuttun","foot":"puḷimā","acai":[{"kind":"nirai","text":"உடுத்","tr":"uṭut"},{"kind":"nēr","text":"துந்","tr":"tun"}]},{"text":"தொடுத்தும்","tr":"toṭuttum","foot":"puḷimā","acai":[{"kind":"nirai","text":"தொடுத்","tr":"toṭut"},{"kind":"nēr","text":"தும்","tr":"tum"}]},{"text":"பூண்டுஞ்","tr":"pūṇṭuñ","foot":"tēmā","acai":[{"kind":"nēr","text":"பூண்","tr":"pūṇ"},{"kind":"nēr","text":"டுஞ்","tr":"ṭuñ"}]},{"text":"செரீஇயும்","tr":"cerīiyum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"செரீ","tr":"cerī"},{"kind":"nirai","text":"இயும்","tr":"iyum"}]}],[{"text":"தழையணிப்","tr":"taḻaiyaṇip","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தழை","tr":"taḻai"},{"kind":"nirai","text":"யணிப்","tr":"yaṇip"}]},{"text":"பொலிந்த","tr":"polinta","foot":"puḷimā","acai":[{"kind":"nirai","text":"பொலிந்","tr":"polin"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"ஆயமொடு","tr":"āyamoṭu","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nirai","text":"யமொ","tr":"yamo"},{"kind":"