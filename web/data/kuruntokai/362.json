{"text":"kuruntokai","n":362,"lines":["முருகயர்ந் துவந்த முதுவாய் வேல","சினவ லோம்புமதி வினவுவ துடையேன்","பல்வே றுருவிற் சில்லவிழ் மடையொடு","சிறுமறி கொன்றிவள் நறுநுதல் நீவி","வணங்கினை கொடுத்தி யாயின் அணங்கிய","விண்தோய் மாமலைச் சிலம்பன்","ஒண்தார் அகலமும் உண்ணுமோ பலியே"],"tr":["murukayarn tuvanta mutuvāy vēla","ciṉava lōmpumati viṉavuva tuṭaiyēṉ","palvē ṟuruviṟ cillaviḻ maṭaiyoṭu","ciṟumaṟi koṉṟivaḷ naṟunutal nīvi","vaṇaṅkiṉai koṭutti yāyiṉ aṇaṅkiya","viṇtōy māmalaic cilampaṉ","oṇtār akalamum uṇṇumō paliyē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"வேம்பற்றூர்க் கண்ணன் கூத்தனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Vēmpaṟṟūrk Kaṇṇaṉ Kūttaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 10, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"முருகயர்ந்","tr":"murukayarn","foot":"karuviḷam","acai":[{"kind":"nirai","text":"முரு","tr":"muru"},{"kind":"nirai","text":"கயர்ந்","tr":"kayarn"}]},{"text":"துவந்த","tr":"tuvanta","foot":"puḷimā","acai":[{"kind":"nirai","text":"துவந்","tr":"tuvan"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"முதுவாய்","tr":"mutuvāy","foot":"puḷimā","acai":[{"kind":"nirai","text":"முது","tr":"mutu"},{"kind":"nēr","text":"வாய்","tr":"vāy"}]},{"text":"வேல","tr":"vēla","foot":"tēmā","acai":[{"kind":"nēr","text":"வே","tr":"vē"},{"kind":"nēr","text":"ல","tr":"la"}]}],[{"text":"சினவ","tr":"ciṉava","foot":"puḷimā","acai":[{"kind":"nirai","text":"சின","tr":"ciṉa"},{"kind":"nēr","text":"வ","tr":"va"}]},{"text":"லோம்புமதி","tr":"lōmpumati","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"லோம்","tr":"lōm"},{"kind":"nirai","text":"பும","tr":"puma"},{"kind":"nēr","text":"தி","tr":"ti"}]},{"text":"வினவுவ","tr":"viṉ