{"text":"kuruntokai","n":374,"lines":["எந்தையும் யாயும் உணரக் காட்டி","ஒளித்த செய்தி வௌிப்படக் கிளந்தபின்","மலைகெழு வெற்பன் தலைவந் திரப்ப","நன்றுபுரி கொள்கையின் ஒன்றா கின்றே","முடங்கல் இறைய தூங்கணங் குரீஇ","நீடிரும் பெண்ணைத் தொடுத்த","கூடினும் மயங்கிய மைய லூரே"],"tr":["entaiyum yāyum uṇarak kāṭṭi","oḷitta ceyti vauppaṭak kiḷantapiṉ","malaikeḻu veṟpaṉ talaivan tirappa","naṉṟupuri koḷkaiyiṉ oṉṟā kiṉṟē","muṭaṅkal iṟaiya tūṅkaṇaṅ kurīi","nīṭirum peṇṇait toṭutta","kūṭiṉum mayaṅkiya maiya lūrē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"உறையூர்ப் பல்காயனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Uṟaiyūrp Palkāyaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 24, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 13, āciriyattaḷai 13"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"எந்தையும்","tr":"entaiyum","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"எந்","tr":"en"},{"kind":"nēr","text":"தை","tr":"tai"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"யாயும்","tr":"yāyum","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"உணரக்","tr":"uṇarak","foot":"puḷimā","acai":[{"kind":"nirai","text":"உண","tr":"uṇa"},{"kind":"nēr","text":"ரக்","tr":"rak"}]},{"text":"காட்டி","tr":"kāṭṭi","foot":"tēmā","acai":[{"kind":"nēr","text":"காட்","tr":"kāṭ"},{"kind":"nēr","text":"டி","tr":"ṭi"}]}],[{"text":"ஒளித்த","tr":"oḷitta","foot":"puḷimā","acai":[{"kind":"nirai","text":"ஒளித்","tr":"oḷit"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"செய்தி","tr":"ceyti","foot":"tēmā","acai":[{"kind":"nēr","text":"செய்","tr":"cey"},{"kind":"nēr","text":"தி","tr":"ti"}]},{"text":"வௌப்படக்","tr":"vauppaṭak","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வௌப்","tr":"vaup"},{"kind":