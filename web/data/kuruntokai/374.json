ḷam","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nirai","text":"டிரும்","tr":"ṭirum"}]},{"text":"பெண்ணைத்","tr":"peṇṇait","foot":"tēmā","acai":[{"kind":"nēr","text":"பெண்","tr":"peṇ"},{"kind":"nēr","text":"ணைத்","tr":"ṇait"}]},{"text":"தொடுத்த","tr":"toṭutta","foot":"puḷimā","acai":[{"kind":"nirai","text":"தொடுத்","tr":"toṭut"},{"kind":"nēr","text":"த","tr":"ta"}]}],[{"text":"கூடினும்","tr":"kūṭiṉum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கூ","tr":"kū"},{"kind":"nirai","text":"டினும்","tr":"ṭiṉum"}]},{"text":"மயங்கிய","tr":"mayaṅkiya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மயங்","tr":"mayaṅ"},{"kind":"nirai","text":"கிய","tr":"kiya"}]},{"text":"மைய","tr":"maiya","foot":"tēmā","acai":[{"kind":"nēr","text":"மை","tr":"mai"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"லூரே","tr":"lūrē","foot":"tēmā","acai":[{"kind":"nēr","text":"லூ","tr":"lū"},{"kind":"nēr","text":"ரே","tr":"rē"}]}]]},"ai":{"lines":[{"words":[{"surface":"எந்தையும்","parts":[{"text":"எந்தை","lemma":"எந்தை","gloss":"my father"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and my father"},{"surface":"யாயும்","parts":[{"text":"யாய்","lemma":"யாய்","gloss":"my mother"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and my mother"},{"surface":"உணர","parts":[{"text":"உணர","lemma":"உணர்","gloss":"to realize"}],"gloss":"to realize"},{"surface":"காட்டி","parts":[{"text":"காட்டி","lemma":"காட்டு","gloss":"having shown"}],"gloss":"having shown"}]},{"words":[{"surface":"ஒளித்த","parts":[{"text":"ஒளித்த","lemma":"ஒளி","gloss":"hidden"}],"gloss":"hidden"},{"surface":"செய்தி","parts":[{"text":"செய்தி","lemma":"செய்தி","gloss":"news"}],"gloss":"news"},{"surface":"வௌிப்பட","parts":[{"text":"வௌிப்பட","lemma":"வௌிப்படு","gloss":"to become clear"}],"gloss":"to become clear"},{"surface":"கிளந்தபின்","parts":[{"text":"கிளந்த","lemma":"கிள","gloss":"revealed"},{"text":"பின்","lemma":"பின்","gloss":"after"}],"gloss":"after revealing"}]},{"words":[{"surface":"மலைகெழு","parts":[{"text":"மலை","lemma":"மலை","gloss":"mountain"},{"text":"கெழு","lemma":"கெழு","gloss":"having"}],"gloss":"mountain-possessing"},{"surface":"வெற்பன்","parts":[{"text":"வெற்பன்","lemma":"வெற்பன்","gloss":"lord of the hills"}],"gloss":"lord of the hills"},{"surface":"தலைவந்து","parts":[{"text":"தலை","lemma":"தலை","gloss":"head/in person"},{"text":"வந்து","lemma":"வா","gloss":"having come"}],"gloss":"having come in person"},{"surface":"இரப்ப","parts":[{"text":"இரப்ப","lemma":"இர","gloss":"to entreat"}],"gloss":"to entreat"}]},{"words":[{"surface":"நன்றுபுரி","parts":[{"text":"நன்று","lemma":"நன்று","gloss":"good"},{"text":"புரி","lemma":"புரி","gloss":"do"}],"gloss":"doing good"},{"surface":"கொள்கையின்","parts":[{"text":"கொள்கை","lemma":"கொள்கை","gloss":"principle"},{"text":"இன்","lemma":"இன்","gloss":"with"}],"gloss":"with the principle"},{"surface":"ஒன்றா","parts":[{"text":"ஒன்று","lemma":"ஒன்று","gloss":"one"},{"text":"ஆ","lemma":"ஆ","gloss":"become"}],"gloss":"becoming one"},{"surface":"கின்றே","parts":[{"text":"கின்று","lemma":"கின்று","gloss":"present tense marker"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"indeed does"}]},{"words":[{"surface":"முடங்கல்","parts":[{"text":"முடங்கல்","lemma":"முடங்கல்","gloss":"curved"}],"gloss":"curved"},{"surface":"இறைய","parts":[{"text":"இறைய","lemma":"இறை","gloss":"joints/eaves"}],"gloss":"joints"},{"surface":"தூங்கணம்","parts":[{"text":"தூங்கணம்","lemma":"தூங்கணம்","gloss":"weaver bird"}],"gloss":"weaver bird"},{"surface":"குரீஇ","parts":[{"text":"குரீஇ","lemma":"குரீஇ","gloss":"bird"}],"gloss":"bird"}]},{"words":[{"surface":"நீடிரும்","parts":[{"text":"நீடு","lemma":"நீடு","gloss":"long"},{"text":"இரும்","lemma":"இரும்","gloss":"dark"}],"gloss":"long and dark"},{"surface":"பெண்ணை","parts":[{"text":"பெண்ணை","lemma":"பெண்ணை","gloss":"palmyra palm"}],"gloss":"palmyra palm"},{"surface":"தொடுத்த","parts":[{"text":"தொடுத்த","lemma":"தொடு","gloss":"built"}],"gloss":"built"}]},{"words":[{"surface":"கூடினும்","parts":[{"text":"கூடு","lemma":"கூடு","gloss":"nest"},{"text":"இன்","lemma":"இன்","gloss":"locative/oblique"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"even in the nest"},{"surface":"மயங்கிய","parts":[{"text":"மயங்கிய","lemma":"மயங்கு","gloss":"confused"}],"gloss":"confused"},{"surface":"மையல்","parts":[{"text":"மையல்","lemma":"மையல்","gloss":"madness/confusion"}],"gloss":"madness"},{"surface":"ஊரே","parts":[{"text":"ஊர்","lemma":"ஊர்","gloss":"town"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"indeed the town"}]}],"literal":"My father and my mother to realize, having shown / the hidden news, clearly after revealing, / the lord of the mountain-possessing hills, having come in person, to entreat, / with the principle of doing good, becoming one indeed / with curved joints, the weaver bird, / on the long, dark palmyra palm, built / even in the nest, confused, is the mad town!","translation":"After we revealed clearly the hidden secret of our love, making my father and mother understand it, the lord of the mountain-possessing hills came in person to entreat for my hand. Now, our minds have become one in this virtuous path. Yet, this foolish town is as confused as the weaver birds that build their nests on the curved fronds of the tall, dark palmyra palm, and still get disoriented even inside their own nests!","modern":"என் தந்தையும் தாயும் உணருமாறு காட்டி, நாங்கள் மறைத்து வைத்திருந்த செய்தியை வெளிப்படையாகச் சொன்ன பிறகு, மலைநாட்டின் தலைவன் நேரில் வந்து என் கையை இரந்து கேட்கிறான். நன்மையை விரும்பும் கொள்கையோடு எங்கள் இருவர் மனமும் இப்போது ஒன்றாக இணைந்துவிட்டது. ஆனால், வளைந்த ஓலைகளையுடைய, நீண்ட கரிய பனைமரத்தில் கூடு கட்டிய தூக்கணங்குருவிகள் தங்களின் கூட்டுக்குள்ளேயே வழி தெரியாமல் திகைப்பதைப் போல, இந்த ஊர் மக்கள் இன்னும் வீணாகக் குழம்பிக் கொண்டிருக்கிறார்களே!","explanation":"The foster-mother and parents have come to know of the secret love between the heroine and the hero. The friend (thōḻi) is speaking about the town's reaction now that the marriage is settled. She explains that after the secret was revealed, the hero came in person to formally ask for her hand, and their hearts are now united in this virtuous path. However, the townspeople, who previously gossiped, are still confused and unable to comprehend that the marriage is finalized. The poet compares the foolish townspeople to weaver birds (tūṅkaṇaṅ kurīi) that build intricate nests on the curved fronds of a tall palmyra palm, yet get confused and disoriented even within their own nests.","model":"gemini-3.5-flash"}}