ுள்","gloss":"resembling"}],"gloss":"resembling"},{"surface":"திரள்","parts":[{"text":"திரள்","lemma":"திரள்","gloss":"clustered"}],"gloss":"clustered"},{"surface":"வீ","parts":[{"text":"வீ","lemma":"வீ","gloss":"flower"}],"gloss":"flower"}]},{"words":[{"surface":"நெய்தல்","parts":[{"text":"நெய்தல்","lemma":"நெய்தல்","gloss":"blue water lily"}],"gloss":"blue water lily"},{"surface":"மா","parts":[{"text":"மா","lemma":"மா","gloss":"great"}],"gloss":"great"},{"surface":"மலர்","parts":[{"text":"மலர்","lemma":"மலர்","gloss":"blossom"}],"gloss":"blossom"},{"surface":"பெய்தல்","parts":[{"text":"பெய்தல்","lemma":"பெய்","gloss":"raining"}],"gloss":"raining"},{"surface":"போல","parts":[{"text":"போல","lemma":"போல","gloss":"like"}],"gloss":"like"}]},{"words":[{"surface":"ஊதை","parts":[{"text":"ஊதை","lemma":"ஊதை","gloss":"cold wind"}],"gloss":"cold wind"},{"surface":"தூற்றும்","parts":[{"text":"தூற்று","lemma":"தூற்று","gloss":"scattering"},{"text":"உம்","lemma":"உம்","gloss":"adjectival suffix"}],"gloss":"scattering"},{"surface":"உரவு","parts":[{"text":"உரவு","lemma":"உரவு","gloss":"strong"}],"gloss":"strong"},{"surface":"நீர்","parts":[{"text":"நீர்","lemma":"நீர்","gloss":"water"}],"gloss":"water"},{"surface":"சேர்ப்ப","parts":[{"text":"சேர்ப்பு","lemma":"சேர்ப்பு","gloss":"coast"},{"text":"அ","lemma":"அ","gloss":"vocative suffix"}],"gloss":"O lord of the shore"}]},{"words":[{"surface":"தாயுடன்","parts":[{"text":"தாயுடன்","lemma":"தாயுடன்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"றலைக்கும்","parts":[{"text":"றலைக்கும்","lemma":"றலைக்கும்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"காலையும்","parts":[{"text":"காலையும்","lemma":"காலையும்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"வாய்விட்","parts":[{"text":"வாய்விட்","lemma":"வாய்விட்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"டன்னா","parts":[{"text":"டன்னா","lemma":"டன்னா","gloss":""}],"gloss":"","split_unverified":true},{"surface":"வென்னுங்","parts":[{"text":"வென்னுங்","lemma":"வென்னுங்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"குழவி","parts":[{"text":"குழவி","lemma":"குழவி","gloss":""}],"gloss":"","split_unverified":true},{"surface":"போல","parts":[{"text":"போல","lemma":"போல","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"இன்னா","parts":[{"text":"இன்னா","lemma":"இன்னா","gloss":"painful things"}],"gloss":"painful things"},{"surface":"செயினும்","parts":[{"text":"செய்","lemma":"செய்","gloss":"do"},{"text":"இனும்","lemma":"இனும்","gloss":"even if"}],"gloss":"even if you do"},{"surface":"இனிது","parts":[{"text":"இனிது","lemma":"இனிது","gloss":"pleasantness"}],"gloss":"sweetly"},{"surface":"தலை","parts":[{"text":"தலை","lemma":"தலை","gloss":"grace"}],"gloss":"grace"},{"surface":"அளிப்பினும்","parts":[{"text":"அளி","lemma":"அளி","gloss":"bestow"},{"text":"ப்ப்","lemma":"ப்ப்","gloss":"empty morph"},{"text":"இனும்","lemma":"இனும்","gloss":"even if"}],"gloss":"even if you bestow"}]},{"words":[{"surface":"நின்","parts":[{"text":"நின்","lemma":"நீ","gloss":"your"}],"gloss":"your"},{"surface":"வரைப்பினள்","parts":[{"text":"வரைப்பு","lemma":"வரைப்பு","gloss":"domain"},{"text":"இன்","lemma":"இன்","gloss":"of"},{"text":"அள்","lemma":"அள்","gloss":"she-suffix"}],"gloss":"she who is within your domain"},{"surface":"என்","parts":[{"text":"என்","lemma":"என்","gloss":"my"}],"gloss":"my"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"தோழி","gloss":"friend"}],"gloss":"friend"}]},{"words":[{"surface":"தன்","parts":[{"text":"தன்","lemma":"தான்","gloss":"her own"}],"gloss":"her own"},{"surface":"உறு","parts":[{"text":"உறு","lemma":"உறு","gloss":"suffering"}],"gloss":"suffering"},{"surface":"விழுமம்","parts":[{"text":"விழுமம்","lemma":"விழுமம்","gloss":"distress"}],"gloss":"distress"},{"surface":"களைஞரோ","parts":[{"text":"களைஞர்","lemma":"களை","gloss":"those who remove"},{"text":"ஓ","lemma":"ஓ","gloss":"emphasis"}],"gloss":"those who remove"},{"surface":"இலளே","parts":[{"text":"இலள்","lemma":"இல்","gloss":"she has none"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"she has none"}]}],"literal":"Bud-mature ñāḻal tree's millet-resembling clustered flowers / on the great blossoms of the neytal, showering like rain, / O lord of the shore of strong waters where the cold wind scatters! / Even at the time when her mother, having become angry, beats her, crying out loud / \"Mother!\" calling, like an infant, / even if you do unpleasant things, or even if you sweetly bestow grace, / my friend is within your domain; / she has no one else to remove her suffering.","translation":"O lord of the shore of mighty waters, where the cold wind scatters the millet-like clustered flowers of the mature ñāḻal tree like rain onto the great blossoms of the neytal! Like an infant who, even when its mother beats it in anger, cries out \"Mother!\", my friend belongs only to your domain, whether you cause her pain or sweetly bestow your grace. She has no one else to remove her suffering.","modern":"குளிர்ந்த காற்று வீசி, அரும்புகள் முதிர்ந்த ஞாழல் மரத்தின் தினை போன்ற திரண்ட பூக்களை, நெய்தலின் பெரிய மலர்கள் மேல் மழை போலத் தூவுகின்ற வலிமையான கடல்நீரை உடைய கடற்கரைத் தலைவனே! கோபமடைந்த தாய் தன்னை அடிக்கும் போதும், வாய்விட்டு \"அம்மா!\" என்று கதறும் குழந்தையைப் போல, நீ துன்பமே செய்தாலும் அல்லது இன்பமாக அன்பு காட்டினாலும், என் தோழி உன்னையே தஞ்சமெனக் கொண்டவள்; தன் துன்பத்தைத் தீர்ப்பவர் உன்னைத் தவிர வேறு யாரும் அவளுக்கு இல்லை.","explanation":"The friend (தோழி) is speaking to the hero (தலைவன்) who has been delaying his marriage. She urges him to marry the heroine quickly by emphasizing her absolute devotion and vulnerability. She compares the heroine to an infant who cries out for its mother even when the mother is beating it in anger; similarly, the heroine looks only to the hero for comfort, whether he causes her distress by his absence or shows her love. This is a Neytal (coastal) poem, and the image of the cold wind scattering the yellow, millet-like pollen of the ñāḻal tree onto the blue neytal flowers like rain represents the hero's actions affecting the heroine. The key words are 'குழவி' (infant), 'இன்னா செயினும்' (even if you do painful things), and 'நின் வரைப்பினள்' (she is within your domain).","model":"gemini-3.5-flash"}}