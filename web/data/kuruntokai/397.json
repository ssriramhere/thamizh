{"text":"kuruntokai","n":397,"lines":["நனைமுதிர் ஞாழற் தினைமருள் திரள்வீ","நெய்தல் மாமலர்ப் பெய்தல் போல","ஊதை தூற்றும் உரவுநீர்ச் சேர்ப்ப","தாயுடன் றலைக்கும் காலையும் வாய்விட்","டன்னா வென்னுங் குழவி போல","இன்னா செயினும் இனிதுதலை யளிப்பினும்","நின்வரைப் பினளென் தோழி","தன்னுறு விழுமங் களைஞரோ இலளே"],"tr":["naṉaimutir ñāḻaṟ tiṉaimaruḷ tiraḷvī","neytal māmalarp peytal pōla","ūtai tūṟṟum uravunīrc cērppa","tāyuṭaṉ ṟalaikkum kālaiyum vāyviṭ","ṭaṉṉā veṉṉuṅ kuḻavi pōla","iṉṉā ceyiṉum iṉitutalai yaḷippiṉum","niṉvaraip piṉaḷeṉ tōḻi","taṉṉuṟu viḻumaṅ kaḷaiñarō ilaḷē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தோழி கூற்று","poet_ta":"அம்மூவனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Ammūvaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 29, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 11, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நனைமுதிர்","tr":"naṉaimutir","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நனை","tr":"naṉai"},{"kind":"nirai","text":"முதிர்","tr":"mutir"}]},{"text":"ஞாழற்","tr":"ñāḻaṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"ஞா","tr":"ñā"},{"kind":"nēr","text":"ழற்","tr":"ḻaṟ"}]},{"text":"தினைமருள்","tr":"tiṉaimaruḷ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தினை","tr":"tiṉai"},{"kind":"nirai","text":"மருள்","tr":"maruḷ"}]},{"text":"திரள்வீ","tr":"tiraḷvī","foot":"puḷimā","acai":[{"kind":"nirai","text":"திரள்","tr":"tiraḷ"},{"kind":"nēr","text":"வீ","tr":"vī"}]}],[{"text":"நெய்தல்","tr":"neytal","foot":"tēmā","acai":[{"kind":"nēr","text":"நெய்","tr":"ney"},{"kind":"nēr","text":"தல்","tr":"tal"}]},{"text":"மாமலர்ப்","tr":"māmalarp","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"மலர்ப்","tr":"malarp"}]},{"text":"பெய்தல்","tr":"peytal",