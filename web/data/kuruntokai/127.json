{"text":"kuruntokai","n":127,"lines":["குருகுகொளக் குளித்த கெண்டை அயலது","உருகெழு தாமரை வான்முகை வெரூஉம்","கழனியம் படப்பைக் காஞ்சி யூர","ஒருநின் பாணன் பொய்ய னாக","உள்ள பாணர் எல்லாம்","கள்வர் போல்வர்நீ அகன்றிசி னோர்க்கே"],"tr":["kurukukoḷak kuḷitta keṇṭai ayalatu","urukeḻu tāmarai vāṉmukai verūum","kaḻaṉiyam paṭappaik kāñci yūra","oruniṉ pāṇaṉ poyya ṉāka","uḷḷa pāṇar ellām","kaḷvar pōlvarnī akaṉṟici ṉōrkkē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தோழி கூற்று","poet_ta":"ஓரம் போகியார்","speaker_en":"her friend (tōḻi)","poet_tr":"Ōram Pōkiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 6, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"குருகுகொளக்","tr":"kurukukoḷak","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"குரு","tr":"kuru"},{"kind":"nirai","text":"குகொ","tr":"kuko"},{"kind":"nēr","text":"ளக்","tr":"ḷak"}]},{"text":"குளித்த","tr":"kuḷitta","foot":"puḷimā","acai":[{"kind":"nirai","text":"குளித்","tr":"kuḷit"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"கெண்டை","tr":"keṇṭai","foot":"tēmā","acai":[{"kind":"nēr","text":"கெண்","tr":"keṇ"},{"kind":"nēr","text":"டை","tr":"ṭai"}]},{"text":"அயலது","tr":"ayalatu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அய","tr":"aya"},{"kind":"nirai","text":"லது","tr":"latu"}]}],[{"text":"உருகெழு","tr":"urukeḻu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"உரு","tr":"uru"},{"kind":"nirai","text":"கெழு","tr":"keḻu"}]},{"text":"தாமரை","tr":"tāmarai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nirai","text":"மரை","tr":"marai"}]},{"text":"வான்முகை","tr":"vāṉmukai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வான்","tr":"vāṉ"},{"kind":"nirai","text":"முகை","tr":"mukai"}]