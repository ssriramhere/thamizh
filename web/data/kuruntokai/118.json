{"text":"kuruntokai","n":118,"lines":["புள்ளும் மாவும் புலம்பொடு வதிய","நள்ளென வந்த நாரில் மாலைப்","பலர்புகு வாயில் அடைப்பக் கடவுநர்","வருவீர் உளீரோ எனவும்","வாரார் தோழிநங் காத லோரே"],"tr":["puḷḷum māvum pulampoṭu vatiya","naḷḷeṉa vanta nāril mālaip","palarpuku vāyil aṭaippak kaṭavunar","varuvīr uḷīrō eṉavum","vārār tōḻinaṅ kāta lōrē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"நன்னாகையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Naṉṉākaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 9, veṇṭaḷai 9"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"புள்ளும்","tr":"puḷḷum","foot":"tēmā","acai":[{"kind":"nēr","text":"புள்","tr":"puḷ"},{"kind":"nēr","text":"ளும்","tr":"ḷum"}]},{"text":"மாவும்","tr":"māvum","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"வும்","tr":"vum"}]},{"text":"புலம்பொடு","tr":"pulampoṭu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"புலம்","tr":"pulam"},{"kind":"nirai","text":"பொடு","tr":"poṭu"}]},{"text":"வதிய","tr":"vatiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"வதி","tr":"vati"},{"kind":"nēr","text":"ய","tr":"ya"}]}],[{"text":"நள்ளென","tr":"naḷḷeṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நள்","tr":"naḷ"},{"kind":"nirai","text":"ளென","tr":"ḷeṉa"}]},{"text":"வந்த","tr":"vanta","foot":"tēmā","acai":[{"kind":"nēr","text":"வந்","tr":"van"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"நாரில்","tr":"nāril","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"ரில்","tr":"ril"}]},{"text":"மாலைப்","tr":"mālaip","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"லைப்","tr":"laip"}]}],[{"text":"பலர்புகு","tr":"palarpuku","foot":"karuvi