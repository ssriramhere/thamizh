{"text":"kuruntokai","n":368,"lines":["மெல்லிய லோயே மெல்லிய லோயே","நன்னாண் நீத்த பழிதீர் மாமை","வன்பின் ஆற்றுதல் அல்லது செப்பிற்","சொல்ல கிற்றா மெல்லிய லோயே","சிறியரும் பெரியரும் வாழும் ஊர்க்கே","நாளிடைப் படாஅ நளிநீர் நீத்தத்","திண்கரைப் பெருமரம் போலத்","தீதில் நிலைமை முயங்குகம் பலவே"],"tr":["melliya lōyē melliya lōyē","naṉṉāṇ nītta paḻitīr māmai","vaṉpiṉ āṟṟutal allatu ceppiṟ","colla kiṟṟā melliya lōyē","ciṟiyarum periyarum vāḻum ūrkkē","nāḷiṭaip paṭāa naḷinīr nīttat","tiṇkaraip perumaram pōlat","tītil nilaimai muyaṅkukam palavē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தலைவி கூற்று","poet_ta":"நக்கீரனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Nakkīraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 31"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 12"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மெல்லிய","tr":"melliya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மெல்","tr":"mel"},{"kind":"nirai","text":"லிய","tr":"liya"}]},{"text":"லோயே","tr":"lōyē","foot":"tēmā","acai":[{"kind":"nēr","text":"லோ","tr":"lō"},{"kind":"nēr","text":"யே","tr":"yē"}]},{"text":"மெல்லிய","tr":"melliya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மெல்","tr":"mel"},{"kind":"nirai","text":"லிய","tr":"liya"}]},{"text":"லோயே","tr":"lōyē","foot":"tēmā","acai":[{"kind":"nēr","text":"லோ","tr":"lō"},{"kind":"nēr","text":"யே","tr":"yē"}]}],[{"text":"நன்னாண்","tr":"naṉṉāṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"நன்","tr":"naṉ"},{"kind":"nēr","text":"னாண்","tr":"ṉāṇ"}]},{"text":"நீத்த","tr":"nītta","foot":"tēmā","acai":[{"kind":"nēr","text":"நீத்","tr":"nīt"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"பழிதீர்","tr":"paḻitīr","foot":"puḷimā","acai":[{"kind":"nirai","text":"பழி","tr":"paḻi"},{"kind":"nēr","text":"தீர்","tr":"tīr"}]}