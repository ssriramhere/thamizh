":"த்து","gloss":"past participle suffix"}],"gloss":"having stripped"}]},{"words":[{"surface":"தண்டொடு","parts":[{"text":"தண்டு","lemma":"தண்டு","gloss":"staff"},{"text":"ஒடு","lemma":"ஒடு","gloss":"with"}],"gloss":"with the staff"},{"surface":"பிடித்த","parts":[{"text":"பிடி","lemma":"பிடி","gloss":"to hold"},{"text":"த்த","lemma":"த்த","gloss":"past relative participle suffix"}],"gloss":"held"},{"surface":"தாழ்","parts":[{"text":"தாழ்","lemma":"தாழ்","gloss":"to hang low"}],"gloss":"hanging low"},{"surface":"கமண்டலத்து","parts":[{"text":"கமண்டலத்து","lemma":"கமண்டலத்து","gloss":"of the water pot"}],"gloss":"of the water pot","split_unverified":true}]},{"words":[{"surface":"படிவ","parts":[{"text":"படிவ","lemma":"படிவ","gloss":"vowed"}],"gloss":"vowed","split_unverified":true},{"surface":"உண்டி","parts":[{"text":"உண்டி","lemma":"உண்டி","gloss":"food"}],"gloss":"food"},{"surface":"பார்ப்பன","parts":[{"text":"பார்ப்பன","lemma":"பார்ப்பான்","gloss":"Brahmin"}],"gloss":"Brahmin"},{"surface":"மகனே","parts":[{"text":"மகன்","lemma":"மகன்","gloss":"son/youth"},{"text":"ஏ","lemma":"ஏ","gloss":"vocative particle"}],"gloss":"O youth!"}]},{"words":[{"surface":"எழுதா","parts":[{"text":"எழுது","lemma":"எழுது","gloss":"to write"},{"text":"ஆ","lemma":"ஆ","gloss":"negative relative participle suffix"}],"gloss":"unwritten"},{"surface":"கற்பின்","parts":[{"text":"கற்பு","lemma":"கற்பு","gloss":"learning/Vedas"},{"text":"இன்","lemma":"இன்","gloss":"oblique suffix"}],"gloss":"of the learning"},{"surface":"இன்","parts":[{"text":"இன்","lemma":"இனிமை","gloss":"sweet"}],"gloss":"sweet"},{"surface":"சொல்","parts":[{"text":"சொல்","lemma":"சொல்","gloss":"word"}],"gloss":"words"},{"surface":"உள்ளும்","parts":[{"text":"உள்","lemma":"உள்","gloss":"inside/among"},{"text":"உம்","lemma":"உம்","gloss":"even/also"}],"gloss":"even among"}]},{"words":[{"surface":"பிரிந்தோர்","parts":[{"text":"பிரி","lemma":"பிரி","gloss":"to separate"},{"text":"ந்தோர்","lemma":"ந்தோர்","gloss":"those who (past)"}],"gloss":"those who are separated"},{"surface":"புணர்க்கும்","parts":[{"text":"புணர்","lemma":"புணர்","gloss":"to unite"},{"text":"க்கும்","lemma":"க்கும்","gloss":"future/habitual relative participle suffix"}],"gloss":"uniting"},{"surface":"பண்பின்","parts":[{"text":"பண்பு","lemma":"பண்பு","gloss":"quality/nature"},{"text":"இன்","lemma":"இன்","gloss":"genitive/instrumental suffix"}],"gloss":"of the nature"}]},{"words":[{"surface":"மருந்தும்","parts":[{"text":"மருந்து","lemma":"மருந்து","gloss":"remedy/medicine"},{"text":"உம்","lemma":"உம்","gloss":"even/also"}],"gloss":"even a remedy"},{"surface":"உண்டோ","parts":[{"text":"உண்டு","lemma":"உண்டு","gloss":"is there"},{"text":"ஓ","lemma":"ஓ","gloss":"interrogative particle"}],"gloss":"is there?"},{"surface":"மயலோ","parts":[{"text":"மயல்","lemma":"மயல்","gloss":"madness/confusion"},{"text":"ஓ","lemma":"ஓ","gloss":"interrogative particle"}],"gloss":"is it madness?"},{"surface":"இதுவே","parts":[{"text":"இது","lemma":"இது","gloss":"this"},{"text":"ஏ","lemma":"ஏ","gloss":"emphatic particle"}],"gloss":"this indeed"}]}],"literal":"O Brahmin youth! O Brahmin youth! / having stripped the good bark of the red-flowered palasa tree, / with the staff, holding the low-hanging water pot, / of vowed food, O Brahmin youth! / Among the sweet words of the unwritten learning, / with the quality of uniting those who are separated, / is there even a medicine? Or is this indeed madness?","translation":"O Brahmin youth! O Brahmin youth! You who have stripped the good bark of the red-flowered palasa tree, and hold a staff along with a low-hanging water pot, eating only the food of your vows, O Brahmin youth! Among the sweet words of your unwritten scriptures, is there any remedy that has the power to reunite those who are separated? Or is this love of mine just madness?","modern":"செந்நிற மலர்களைக் கொண்ட முருக்கு மரத்தின் நல்ல பட்டையை உரித்து, தண்டோடு தாழ்ந்த கமண்டலத்தையும் கையில் ஏந்தி, நோன்பு உணவை உண்ணும் பார்ப்பன இளைஞனே! பார்ப்பன இளைஞனே! எழுதப்படாத உன்னுடைய வேதக் கல்வியின் இனிய சொற்களுக்குள்ளே, பிரிந்தவர்களை ஒன்று சேர்க்கும் தன்மை கொண்ட மருந்து ஏதேனும் இருக்கிறதா? அல்லது இது வெறும் மயக்கம்தானா?","explanation":"In this Kuriñci poem, the hero, suffering from the intense pain of separation from his beloved, addresses a passing young Brahmin ascetic. He describes the ascetic's appearance, noting that he has stripped the bark of the red-flowered palasa tree to make his staff, carries a low-hanging water pot, and eats only vowed food. The hero then asks if, among the sweet words of the unwritten Vedas that the ascetic studies, there is any remedy that can reunite those who are separated. If no such remedy exists, the hero wonders if his intense longing is simply an incurable madness. The contrast between the ascetic's disciplined, detached life and the hero's passionate, love-sick state highlights the overwhelming power of love in the mountainous landscape.","model":"gemini-3.5-flash"}}