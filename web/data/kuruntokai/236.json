{"text":"kuruntokai","n":236,"lines":["விட்டென விடுக்குநாள் வருக அதுநீ","நேர்ந்தனை யாயின் தந்தனை சென்மோ","குன்றத் தன்ன குவவுமணல் அடைகரை","நின்ற புன்னை நிலந்தோய் படுசினை","வம்ப நாரை சேக்கும்","தண்கடற் சேர்ப்பநீ உண்டவென் னலனே"],"tr":["viṭṭeṉa viṭukkunāḷ varuka atunī","nērntaṉai yāyiṉ tantaṉai ceṉmō","kuṉṟat taṉṉa kuvavumaṇal aṭaikarai","niṉṟa puṉṉai nilantōy paṭuciṉai","vampa nārai cēkkum","taṇkaṭaṟ cērppanī uṇṭaveṉ ṉalaṉē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தோழி கூற்று","poet_ta":"நரிவெரூஉத் தலையார்","speaker_en":"her friend (tōḻi)","poet_tr":"Nariverūut Talaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 10, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"விட்டென","tr":"viṭṭeṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"விட்","tr":"viṭ"},{"kind":"nirai","text":"டென","tr":"ṭeṉa"}]},{"text":"விடுக்குநாள்","tr":"viṭukkunāḷ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விடுக்","tr":"viṭuk"},{"kind":"nirai","text":"குநாள்","tr":"kunāḷ"}]},{"text":"வருக","tr":"varuka","foot":"puḷimā","acai":[{"kind":"nirai","text":"வரு","tr":"varu"},{"kind":"nēr","text":"க","tr":"ka"}]},{"text":"அதுநீ","tr":"atunī","foot":"puḷimā","acai":[{"kind":"nirai","text":"அது","tr":"atu"},{"kind":"nēr","text":"நீ","tr":"nī"}]}],[{"text":"நேர்ந்தனை","tr":"nērntaṉai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நேர்ந்","tr":"nērn"},{"kind":"nirai","text":"தனை","tr":"taṉai"}]},{"text":"யாயின்","tr":"yāyiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"யின்","tr":"yiṉ"}]},{"text":"தந்தனை","tr":"tantaṉai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தந்","tr":"tan"},{"kind":"nirai","text":"தனை","tr":"taṉai"}]},{"text":"சென்மோ","tr