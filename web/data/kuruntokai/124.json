{"text":"kuruntokai","n":124,"lines":["உமணர் சேர்ந்து கழிந்து மருங்கி னகன்றலை","ஊர்பாழ்த் தன்ன ஓமையம் பெருங்காடு","இன்னா என்றி ராயின்","இனியவோ பெரும தமியோர்க்கு மனையே"],"tr":["umaṇar cērntu kaḻintu maruṅki ṉakaṉṟalai","ūrpāḻt taṉṉa ōmaiyam peruṅkāṭu","iṉṉā eṉṟi rāyiṉ","iṉiyavō peruma tamiyōrkku maṉaiyē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"பாலைபாடிய பெருங்கடுங்கோ","speaker_en":"her friend (tōḻi)","poet_tr":"Pālaipāṭiya Peruṅkaṭuṅkō"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"1×5, 2×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 13, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 7, āciriyattaḷai 6, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"1 five-foot line (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"உமணர்","tr":"umaṇar","foot":"puḷimā","acai":[{"kind":"nirai","text":"உம","tr":"uma"},{"kind":"nēr","text":"ணர்","tr":"ṇar"}]},{"text":"சேர்ந்து","tr":"cērntu","foot":"tēmā","acai":[{"kind":"nēr","text":"சேர்ந்","tr":"cērn"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"கழிந்து","tr":"kaḻintu","foot":"puḷimā","acai":[{"kind":"nirai","text":"கழிந்","tr":"kaḻin"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"மருங்கி","tr":"maruṅki","foot":"puḷimā","acai":[{"kind":"nirai","text":"மருங்","tr":"maruṅ"},{"kind":"nēr","text":"கி","tr":"ki"}]},{"text":"னகன்றலை","tr":"ṉakaṉṟalai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"னகன்","tr":"ṉakaṉ"},{"kind":"nirai","text":"றலை","tr":"ṟalai"}]}],[{"text":"ஊர்பாழ்த்","tr":"ūrpāḻt","foot":"tēmā","acai":[{"kind":"nēr","text":"ஊர்","tr":"ūr"},{"kind":"nēr","text":"பாழ்த்","tr":"pāḻt"}]},{"text":"தன்ன","tr":"taṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"தன்","tr":"taṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"ஓமையம்","tr":"ōmaiyam","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"ஓ","tr":"ō"},{"kind":"nēr","text":"மை","tr":"mai"},{"kind":"nēr","text":"யம்","tr":"yam"}]},{"text":"பெருங்காடு","tr":"peruṅkāṭu","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"பெருங்","tr":"peruṅ"},{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"டு","tr":"ṭu"}]}],[{"text":"இன்னா","tr":"iṉṉā","foot":"tēmā","acai":[{"kind":"nēr","text":"இன்","tr":"iṉ"},{"kind":"nēr","text":"னா","tr":"ṉā"}]},{"text":"என்றி","tr":"eṉṟi","foot":"tēmā","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nēr","text":"றி","tr":"ṟi"}]},{"text":"ராயின்","tr":"rāyiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"ரா","tr":"rā"},{"kind":"nēr","text":"யின்","tr":"yiṉ"}]}],[{"text":"இனியவோ","tr":"iṉiyavō","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இனி","tr":"iṉi"},{"kind":"nirai","text":"யவோ","tr":"yavō"}]},{"text":"பெரும","tr":"peruma","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெரு","tr":"peru"},{"kind":"nēr","text":"ம","tr":"ma"}]},{"text":"தமியோர்க்கு","tr":"tamiyōrkku","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"தமி","tr":"tami"},{"kind":"nēr","text":"யோர்க்","tr":"yōrk"},{"kind":"nēr","text":"கு","tr":"ku"}]},{"text":"மனையே","tr":"maṉaiyē","foot":"puḷimā","acai":[{"kind":"nirai","text":"மனை","tr":"maṉai"},{"kind":"nēr","text":"யே","tr":"yē"}]}]]},"ai":null}