{"text":"kuruntokai","n":217,"lines":["தினைகிளி கடிகெனிற் பகலும் ஒல்லும்","இரவுநீ வருதலி னூறு மஞ்சுவல்","யாங்குச் செய்வாமெம் இடும்பை நோய்க்கென","ஆங்கியான் கூறிய அனைத்திற்குப் பிறிதுசெத்","தோங்குமலை நாடன் உயிர்த்தோன் மன்ற","ஐதே காமம் யானே","கழிமுதுக் குறைமையும் பழியுமென் றிசினே"],"tr":["tiṉaikiḷi kaṭikeṉiṟ pakalum ollum","iravunī varutali ṉūṟu mañcuval","yāṅkuc ceyvāmem iṭumpai nōykkeṉa","āṅkiyāṉ kūṟiya aṉaittiṟkup piṟitucet","tōṅkumalai nāṭaṉ uyirttōṉ maṉṟa","aitē kāmam yāṉē","kaḻimutuk kuṟaimaiyum paḻiyumeṉ ṟiciṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"தங்கால் முடக்கொல்லனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Taṅkāl Muṭakkollaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 9, kalittaḷai 3"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"தினைகிளி","tr":"tiṉaikiḷi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தினை","tr":"tiṉai"},{"kind":"nirai","text":"கிளி","tr":"kiḷi"}]},{"text":"கடிகெனிற்","tr":"kaṭikeṉiṟ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கடி","tr":"kaṭi"},{"kind":"nirai","text":"கெனிற்","tr":"keṉiṟ"}]},{"text":"பகலும்","tr":"pakalum","foot":"puḷimā","acai":[{"kind":"nirai","text":"பக","tr":"paka"},{"kind":"nēr","text":"லும்","tr":"lum"}]},{"text":"ஒல்லும்","tr":"ollum","foot":"tēmā","acai":[{"kind":"nēr","text":"ஒல்","tr":"ol"},{"kind":"nēr","text":"லும்","tr":"lum"}]}],[{"text":"இரவுநீ","tr":"iravunī","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இர","tr":"ira"},{"kind":"nirai","text":"வுநீ","tr":"vunī"}]},{"text":"வருதலி","tr":"varutali","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வரு","tr":"varu"},{"kind":"nirai","text":"தலி","tr":"tali"}]},{"text":"னூறு","tr":"ṉūṟu","foot":"tēmā","a