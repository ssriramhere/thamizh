t":"நீ","lemma":"நீ","gloss":"you"}],"gloss":"you"},{"surface":"வருதலின்","parts":[{"text":"வருதல்","lemma":"வருதல்","gloss":"coming"},{"text":"இன்","lemma":"இன்","gloss":"because of"}],"gloss":"because of [your] coming"},{"surface":"ஊறும்","parts":[{"text":"ஊறு","lemma":"ஊறு","gloss":"danger/harm"},{"text":"உம்","lemma":"உம்","gloss":"also"}],"gloss":"danger also"},{"surface":"அஞ்சுவல்","parts":[{"text":"அஞ்சு","lemma":"அஞ்சுதல்","gloss":"to fear"},{"text":"வல்","lemma":"வல்","gloss":"first-person singular suffix"}],"gloss":"I fear"}]},{"words":[{"surface":"யாங்கு","parts":[{"text":"யாங்கு","lemma":"யாங்கு","gloss":"how"}],"gloss":"how"},{"surface":"செய்வாம்","parts":[{"text":"செய்","lemma":"செய்தல்","gloss":"to do"},{"text":"வாம்","lemma":"வாம்","gloss":"we will (first-person plural suffix)"}],"gloss":"shall we do"},{"surface":"எம்","parts":[{"text":"எம்","lemma":"எம்","gloss":"our"}],"gloss":"our"},{"surface":"இடும்பை","parts":[{"text":"இடும்பை","lemma":"இடும்பை","gloss":"affliction/distress"}],"gloss":"distress"},{"surface":"நோய்க்கு","parts":[{"text":"நோய்","lemma":"நோய்","gloss":"pain/disease"},{"text":"கு","lemma":"கு","gloss":"for"}],"gloss":"for the painful disease"},{"surface":"என","parts":[{"text":"என","lemma":"என","gloss":"saying/thus"}],"gloss":"thus"}]},{"words":[{"surface":"ஆங்கியான்","parts":[{"text":"ஆங்கியான்","lemma":"ஆங்கியான்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"கூறிய","parts":[{"text":"கூறிய","lemma":"கூறிய","gloss":""}],"gloss":"","split_unverified":true},{"surface":"அனைத்திற்குப்","parts":[{"text":"அனைத்திற்குப்","lemma":"அனைத்திற்குப்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"பிறிதுசெத்","parts":[{"text":"பிறிதுசெத்","lemma":"பிறிதுசெத்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"தோங்குமலை","parts":[{"text":"தோங்குமலை","lemma":"தோங்குமலை","gloss":""}],"gloss":"","split_unverified":true},{"surface":"நாடன்","parts":[{"text":"நாடன்","lemma":"நாடன்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"உயிர்த்தோன்","parts":[{"text":"உயிர்த்தோன்","lemma":"உயிர்த்தோன்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மன்ற","parts":[{"text":"மன்ற","lemma":"மன்ற","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"ஐது","parts":[{"text":"ஐது","lemma":"ஐது","gloss":"delicate/subtle/strange"}],"gloss":"delicate/strange"},{"surface":"ஏ","parts":[{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"indeed"},{"surface":"காமம்","parts":[{"text":"காமம்","lemma":"காமம்","gloss":"love/passion"}],"gloss":"love"},{"surface":"யான்","parts":[{"text":"யான்","lemma":"யான்","gloss":"I"}],"gloss":"I"},{"surface":"ஏ","parts":[{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"indeed"}]},{"words":[{"surface":"கழிமுதுக்குறைமையும்","parts":[{"text":"கழி","lemma":"கழி","gloss":"excessive/great"},{"text":"முது","lemma":"முது","gloss":"mature/old"},{"text":"குறைமை","lemma":"குறைமை","gloss":"wisdom/nature"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and great maturity/wisdom"},{"surface":"பழியும்","parts":[{"text":"பழி","lemma":"பழி","gloss":"blame/slander"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and blame"},{"surface":"என்று","parts":[{"text":"என்று","lemma":"என்றல்","gloss":"having said"}],"gloss":"having said"},{"surface":"இசின்","parts":[{"text":"இசின்","lemma":"இசின்","gloss":"past tense/expletive suffix"}],"gloss":"indeed"},{"surface":"ஏ","parts":[{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"indeed"}]}],"literal":"To drive away parrots from the millet, if we say, the daytime also is possible / At night, because of your coming, danger also I fear / How shall we do for our painful disease of distress, thus / Thus, to all that I said, thinking otherwise / The lord of the lofty mountain sighed, surely / Delicate indeed is love! I, indeed, / Spoke of great maturity and blame.","translation":"If we say, 'Let us drive away parrots from the millet fields,' meeting during the day is possible. But I fear the dangers of your coming at night. What shall we do for this painful distress of ours?' When I spoke thus, the lord of the lofty mountains misunderstood my words and sighed deeply. How strange is love! And I, indeed, spoke only out of great maturity and fear of slander.","modern":"தினைப்புனத்தில் கிளிகளை விரட்டுவதற்கு என்று சொன்னால் பகல் பொழுதும் நமக்குக் கூடிவரும். ஆனால், இரவில் நீ வருவதால் ஏற்படும் ஆபத்துகளுக்கு நான் அஞ்சுகிறேன். நம்முடைய துன்பத்தைத் தரும் இந்த நோய்க்கு நாம் என்ன செய்வோம்? என்று நான் கூறிய எல்லாவற்றையும் தவறாகப் புரிந்துகொண்டு, உயர்ந்த மலைநாட்டிற்குரிய தலைவன் பெருமூச்சு விட்டான். காதல் என்பது மிகவும் விசித்திரமானது! நானோ, மிகுந்த அறிவோடும் பழிக்கு அஞ்சியுமே அவ்வாறு கூறினேன்.","explanation":"In this Kuriñci poem, the friend (தோழி) is speaking to the heroine within hearing of the hero (தலைவன்). She points out that they can meet during the day while guarding the millet fields, but expresses deep fear for the dangers he faces when traveling to meet them at night. She asks how they can resolve this painful distress, subtly urging him to marry the heroine. However, the hero misunderstands her words as a rejection or an obstacle, and sighs deeply in despair. The friend marvels at how delicate and easily misunderstood love is, noting that she spoke only out of mature concern and fear of public slander.","model":"gemini-3.5-flash"}}