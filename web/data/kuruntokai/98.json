{"text":"kuruntokai","n":98,"lines":["இன்ன ளாயினள் நன்னுதல் என்றவர்த்","துன்னச் சென்று செப்புநர்ப் பெறினே","நன்றுமன் வாழி தோழிநம் படப்பை","நீர்வார் பைம்புதற் கலித்த","மாரிப் பீரத் தலர்சில கொண்டே"],"tr":["iṉṉa ḷāyiṉaḷ naṉṉutal eṉṟavart","tuṉṉac ceṉṟu ceppunarp peṟiṉē","naṉṟumaṉ vāḻi tōḻinam paṭappai","nīrvār paimputaṟ kalitta","mārip pīrat talarcila koṇṭē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"கோக்குள முற்றனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kōkkuḷa Muṟṟaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 6"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இன்ன","tr":"iṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"இன்","tr":"iṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"ளாயினள்","tr":"ḷāyiṉaḷ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ளா","tr":"ḷā"},{"kind":"nirai","text":"யினள்","tr":"yiṉaḷ"}]},{"text":"நன்னுதல்","tr":"naṉṉutal","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நன்","tr":"naṉ"},{"kind":"nirai","text":"னுதல்","tr":"ṉutal"}]},{"text":"என்றவர்த்","tr":"eṉṟavart","foot":"kūviḷam","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nirai","text":"றவர்த்","tr":"ṟavart"}]}],[{"text":"துன்னச்","tr":"tuṉṉac","foot":"tēmā","acai":[{"kind":"nēr","text":"துன்","tr":"tuṉ"},{"kind":"nēr","text":"னச்","tr":"ṉac"}]},{"text":"சென்று","tr":"ceṉṟu","foot":"tēmā","acai":[{"kind":"nēr","text":"சென்","tr":"ceṉ"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"செப்புநர்ப்","tr":"ceppunarp","foot":"kūviḷam","acai":[{"kind":"nēr","text":"செப்","tr":"cep"},{"kind":"nirai","text":"புநர்ப்","tr":"punarp"}]},{"text":"பெறினே","tr":"peṟiṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெறி","tr":"peṟi"},{"kind":"nēr","text":"னே","