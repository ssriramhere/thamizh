{"text":"kuruntokai","n":46,"lines":["ஆம்பற் பூவின் சாம்ப லன்ன","கூம்பிய சிறகர் மனையுறை குரீஇ","முன்றில் உணங்கல் மாந்தி மன்றத்து","எருவினுண் தாது குடைவன ஆடி","இல்லிறைப் பள்ளித்தம் பிள்ளையொடு வதியும்","புன்கண் மாலையும் புலம்பும்","இன்றுகொல் தோழியவர் சென்ற நாட்டே"],"tr":["āmpaṟ pūviṉ cāmpa laṉṉa","kūmpiya ciṟakar maṉaiyuṟai kurīi","muṉṟil uṇaṅkal mānti maṉṟattu","eruviṉuṇ tātu kuṭaivaṉa āṭi","illiṟaip paḷḷittam piḷḷaiyoṭu vatiyum","puṉkaṇ mālaiyum pulampum","iṉṟukol tōḻiyavar ceṉṟa nāṭṭē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தலைவி கூற்று","poet_ta":"மாமலாடனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Māmalāṭaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 4, vañcicīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 9, kalittaḷai 2, oṉṟiya vañcittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஆம்பற்","tr":"āmpaṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"ஆம்","tr":"ām"},{"kind":"nēr","text":"பற்","tr":"paṟ"}]},{"text":"பூவின்","tr":"pūviṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"பூ","tr":"pū"},{"kind":"nēr","text":"வின்","tr":"viṉ"}]},{"text":"சாம்ப","tr":"cāmpa","foot":"tēmā","acai":[{"kind":"nēr","text":"சாம்","tr":"cām"},{"kind":"nēr","text":"ப","tr":"pa"}]},{"text":"லன்ன","tr":"laṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"லன்","tr":"laṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]}],[{"text":"கூம்பிய","tr":"kūmpiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கூம்","tr":"kūm"},{"kind":"nirai","text":"பிய","tr":"piya"}]},{"text":"சிறகர்","tr":"ciṟakar","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிற","tr":"ciṟa"},{"kind":"nēr","text":"கர்","tr":"kar"}]},{"text":"மனையுறை","tr":"maṉaiyuṟai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மனை","tr":"maṉai"},{"kind":"nirai","tex