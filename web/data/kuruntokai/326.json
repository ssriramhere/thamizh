{"text":"kuruntokai","n":326,"lines":["துணைத்த கோதைப் பணைப்பெருந் தோளினர்","கடலாடு மகளிர் கான லிழைத்த","சிறுமனைப் புணர்ந்த நட்பே தோழி","ஒருநாள் துறைவன் துறப்பின்","பன்னாள் வரூஉம் இன்னா மைத்தே"],"tr":["tuṇaitta kōtaip paṇaipperun tōḷiṉar","kaṭalāṭu makaḷir kāṉa liḻaitta","ciṟumaṉaip puṇarnta naṭpē tōḻi","orunāḷ tuṟaivaṉ tuṟappiṉ","paṉṉāḷ varūum iṉṉā maittē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","speaker_en":"the heroine (talaivi)"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 9, veṇṭaḷai 8, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"துணைத்த","tr":"tuṇaitta","foot":"puḷimā","acai":[{"kind":"nirai","text":"துணைத்","tr":"tuṇait"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"கோதைப்","tr":"kōtaip","foot":"tēmā","acai":[{"kind":"nēr","text":"கோ","tr":"kō"},{"kind":"nēr","text":"தைப்","tr":"taip"}]},{"text":"பணைப்பெருந்","tr":"paṇaipperun","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பணைப்","tr":"paṇaip"},{"kind":"nirai","text":"பெருந்","tr":"perun"}]},{"text":"தோளினர்","tr":"tōḷiṉar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nirai","text":"ளினர்","tr":"ḷiṉar"}]}],[{"text":"கடலாடு","tr":"kaṭalāṭu","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"கட","tr":"kaṭa"},{"kind":"nēr","text":"லா","tr":"lā"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"மகளிர்","tr":"makaḷir","foot":"puḷimā","acai":[{"kind":"nirai","text":"மக","tr":"maka"},{"kind":"nēr","text":"ளிர்","tr":"ḷir"}]},{"text":"கான","tr":"kāṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"லிழைத்த","tr":"liḻaitta","foot":"puḷimā","acai":[{"kind":"nirai","text":"லிழைத்","tr":"liḻait"},{"kind":"nēr","