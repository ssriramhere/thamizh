{"text":"kuruntokai","n":398,"lines":["தேற்றா மன்றே தோழி தண்ணெனத்","தூற்றுந் துவலைத் துயர்கூர் காலைக்","கயலே ருண்கட் கனங்குழை மகளிர்","கைபுணை யாக நெய்பெய்து மாட்டிய","சுடர்துய ரெடுப்பும் புன்கண் மாலை","அரும்பெறற் காதலர் வந்தென விருந்தயர்பு","மெய்ம்மலி யுவகையி னெழுதரு","கண்கலி ழுகுபனி யரக்கு வோரே"],"tr":["tēṟṟā maṉṟē tōḻi taṇṇeṉat","tūṟṟun tuvalait tuyarkūr kālaik","kayalē ruṇkaṭ kaṉaṅkuḻai makaḷir","kaipuṇai yāka neypeytu māṭṭiya","cuṭartuya reṭuppum puṉkaṇ mālai","arumpeṟaṟ kātalar vanteṉa viruntayarpu","meymmali yuvakaiyi ṉeḻutaru","kaṇkali ḻukupaṉi yarakku vōrē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"பாலைபாடிய பெருங்கடுங்கோ","speaker_en":"the heroine (talaivi)","poet_tr":"Pālaipāṭiya Peruṅkaṭuṅkō"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 12, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"தேற்றா","tr":"tēṟṟā","foot":"tēmā","acai":[{"kind":"nēr","text":"தேற்","tr":"tēṟ"},{"kind":"nēr","text":"றா","tr":"ṟā"}]},{"text":"மன்றே","tr":"maṉṟē","foot":"tēmā","acai":[{"kind":"nēr","text":"மன்","tr":"maṉ"},{"kind":"nēr","text":"றே","tr":"ṟē"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"தண்ணெனத்","tr":"taṇṇeṉat","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தண்","tr":"taṇ"},{"kind":"nirai","text":"ணெனத்","tr":"ṇeṉat"}]}],[{"text":"தூற்றுந்","tr":"tūṟṟun","foot":"tēmā","acai":[{"kind":"nēr","text":"தூற்","tr":"tūṟ"},{"kind":"nēr","text":"றுந்","tr":"ṟun"}]},{"text":"துவலைத்","tr":"tuvalait","foot":"puḷimā","acai":[{"kind":"nirai","text":"துவ","tr":"tuva"},{"kind":"nēr","text":"லைத்","tr":"lait"}]},{"text":"துயர்கூர்","tr":"tuyarkūr","foot":"p