{"text":"kuruntokai","n":317,"lines":["புரிமட மரையான் கருநரை நல்லேறு","தீம்புளி நெல்லி மாந்தி யயலது","தேம்பாய் மாமலர் நடுங்க வெய்துயிர்த்","தோங்குமலைப் பைஞ்சுனை பருகு நாடன்","நம்மைவிட் டமையுமோ மற்றே கைம்மிக","வடபுல வாடைக் கழிமழை","தென்புலம் படருந் தண்பனி நாளே"],"tr":["purimaṭa maraiyāṉ karunarai nallēṟu","tīmpuḷi nelli mānti yayalatu","tēmpāy māmalar naṭuṅka veytuyirt","tōṅkumalaip paiñcuṉai paruku nāṭaṉ","nammaiviṭ ṭamaiyumō maṟṟē kaimmika","vaṭapula vāṭaik kaḻimaḻai","teṉpulam paṭarun taṇpaṉi nāḷē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"மதுரைக் கண்டரதத்தனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Maturaik Kaṇṭaratattaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 24, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 13, āciriyattaḷai 12, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"புரிமட","tr":"purimaṭa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"புரி","tr":"puri"},{"kind":"nirai","text":"மட","tr":"maṭa"}]},{"text":"மரையான்","tr":"maraiyāṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மரை","tr":"marai"},{"kind":"nēr","text":"யான்","tr":"yāṉ"}]},{"text":"கருநரை","tr":"karunarai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கரு","tr":"karu"},{"kind":"nirai","text":"நரை","tr":"narai"}]},{"text":"நல்லேறு","tr":"nallēṟu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"நல்","tr":"nal"},{"kind":"nēr","text":"லே","tr":"lē"},{"kind":"nēr","text":"று","tr":"ṟu"}]}],[{"text":"தீம்புளி","tr":"tīmpuḷi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தீம்","tr":"tīm"},{"kind":"nirai","text":"புளி","tr":"puḷi"}]},{"text":"நெல்லி","tr":"nelli","foot":"tēmā","acai":[{"kind":"nēr","text":"நெல்","tr":"nel"},{"kind":"nēr","text":"லி","tr":"li"}]},{"text":"மாந்தி","tr":"mānti","foot":