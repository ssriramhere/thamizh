{"text":"kuruntokai","n":373,"lines":["நிலம்புடை பெயரினு நீர்தீப் பிறழினும்","இலங்குதிரைப் பெருங்கடற் கெல்லை தோன்றினும்","வெவ்வாய்ப் பெண்டிர் கௌவை அஞ்சிக்","கேடெவன் உடைத்தோ தோழி நீடுமயிர்க்","கடும்பல் ஊகக் கறைவிரல் ஏற்றை","புடைத்தொடு புடைஇப் பூநாறு பலவுக்கனி","காந்தளஞ் சிறுகுடிக் கமழும்","ஓங்குமலை நாடனொ டமைந்தநந் தொடர்பே"],"tr":["nilampuṭai peyariṉu nīrtīp piṟaḻiṉum","ilaṅkutiraip peruṅkaṭaṟ kellai tōṉṟiṉum","vevvāyp peṇṭir kauvai añcik","kēṭevaṉ uṭaittō tōḻi nīṭumayirk","kaṭumpal ūkak kaṟaiviral ēṟṟai","puṭaittoṭu puṭaiip pūnāṟu palavukkaṉi","kāntaḷañ ciṟukuṭik kamaḻum","ōṅkumalai nāṭaṉo ṭamaintanan toṭarpē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"மதுரைக் கொல்லம் புல்லனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Maturaik Kollam Pullaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 4, vañcicīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 8, kalittaḷai 3, oṉṟā vañcittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நிலம்புடை","tr":"nilampuṭai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நிலம்","tr":"nilam"},{"kind":"nirai","text":"புடை","tr":"puṭai"}]},{"text":"பெயரினு","tr":"peyariṉu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெய","tr":"peya"},{"kind":"nirai","text":"ரினு","tr":"riṉu"}]},{"text":"நீர்தீப்","tr":"nīrtīp","foot":"tēmā","acai":[{"kind":"nēr","text":"நீர்","tr":"nīr"},{"kind":"nēr","text":"தீப்","tr":"tīp"}]},{"text":"பிறழினும்","tr":"piṟaḻiṉum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பிற","tr":"piṟa"},{"kind":"nirai","text":"ழினும்","tr":"ḻiṉum"}]}],[{"text":"இலங்குதிரைப்","tr":"ilaṅkutiraip","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"இலங்","tr":"ilaṅ"},{"kind":"nirai","text":"குதி","tr":"kuti"},{"kind":"nēr","text":"ர