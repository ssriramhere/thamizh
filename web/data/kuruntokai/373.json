{"text":"kuruntokai","n":373,"lines":["நிலம்புடை பெயரினு நீர்தீப் பிறழினும்","இலங்குதிரைப் பெருங்கடற் கெல்லை தோன்றினும்","வெவ்வாய்ப் பெண்டிர் கௌவை அஞ்சிக்","கேடெவன் உடைத்தோ தோழி நீடுமயிர்க்","கடும்பல் ஊகக் கறைவிரல் ஏற்றை","புடைத்தொடு புடைஇப் பூநாறு பலவுக்கனி","காந்தளஞ் சிறுகுடிக் கமழும்","ஓங்குமலை நாடனொ டமைந்தநந் தொடர்பே"],"tr":["nilampuṭai peyariṉu nīrtīp piṟaḻiṉum","ilaṅkutiraip peruṅkaṭaṟ kellai tōṉṟiṉum","vevvāyp peṇṭir kauvai añcik","kēṭevaṉ uṭaittō tōḻi nīṭumayirk","kaṭumpal ūkak kaṟaiviral ēṟṟai","puṭaittoṭu puṭaiip pūnāṟu palavukkaṉi","kāntaḷañ ciṟukuṭik kamaḻum","ōṅkumalai nāṭaṉo ṭamaintanan toṭarpē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"மதுரைக் கொல்லம் புல்லனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Maturaik Kollam Pullaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 4, vañcicīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 8, kalittaḷai 3, oṉṟā vañcittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நிலம்புடை","tr":"nilampuṭai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நிலம்","tr":"nilam"},{"kind":"nirai","text":"புடை","tr":"puṭai"}]},{"text":"பெயரினு","tr":"peyariṉu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெய","tr":"peya"},{"kind":"nirai","text":"ரினு","tr":"riṉu"}]},{"text":"நீர்தீப்","tr":"nīrtīp","foot":"tēmā","acai":[{"kind":"nēr","text":"நீர்","tr":"nīr"},{"kind":"nēr","text":"தீப்","tr":"tīp"}]},{"text":"பிறழினும்","tr":"piṟaḻiṉum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பிற","tr":"piṟa"},{"kind":"nirai","text":"ழினும்","tr":"ḻiṉum"}]}],[{"text":"இலங்குதிரைப்","tr":"ilaṅkutiraip","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"இலங்","tr":"ilaṅ"},{"kind":"nirai","text":"குதி","tr":"kuti"},{"kind":"nēr","text":"ரைப்","tr":"raip"}]},{"text":"பெருங்கடற்","tr":"peruṅkaṭaṟ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெருங்","tr":"peruṅ"},{"kind":"nirai","text":"கடற்","tr":"kaṭaṟ"}]},{"text":"கெல்லை","tr":"kellai","foot":"tēmā","acai":[{"kind":"nēr","text":"கெல்","tr":"kel"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"தோன்றினும்","tr":"tōṉṟiṉum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தோன்","tr":"tōṉ"},{"kind":"nirai","text":"றினும்","tr":"ṟiṉum"}]}],[{"text":"வெவ்வாய்ப்","tr":"vevvāyp","foot":"tēmā","acai":[{"kind":"nēr","text":"வெவ்","tr":"vev"},{"kind":"nēr","text":"வாய்ப்","tr":"vāyp"}]},{"text":"பெண்டிர்","tr":"peṇṭir","foot":"tēmā","acai":[{"kind":"nēr","text":"பெண்","tr":"peṇ"},{"kind":"nēr","text":"டிர்","tr":"ṭir"}]},{"text":"கௌவை","tr":"kauvai","foot":"tēmā","acai":[{"kind":"nēr","text":"கௌ","tr":"kau"},{"kind":"nēr","text":"வை","tr":"vai"}]},{"text":"அஞ்சிக்","tr":"añcik","foot":"tēmā","acai":[{"kind":"nēr","text":"அஞ்","tr":"añ"},{"kind":"nēr","text":"சிக்","tr":"cik"}]}],[{"text":"கேடெவன்","tr":"kēṭevaṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கே","tr":"kē"},{"kind":"nirai","text":"டெவன்","tr":"ṭevaṉ"}]},{"text":"உடைத்தோ","tr":"uṭaittō","foot":"puḷimā","acai":[{"kind":"nirai","text":"உடைத்","tr":"uṭait"},{"kind":"nēr","text":"தோ","tr":"tō"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"நீடுமயிர்க்","tr":"nīṭumayirk","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nirai","text":"டும","tr":"ṭuma"},{"kind":"nēr","text":"யிர்க்","tr":"yirk"}]}],[{"text":"கடும்பல்","tr":"kaṭumpal","foot":"puḷimā","acai":[{"kind":"nirai","text":"கடும்","tr":"kaṭum"},{"kind":"nēr","text":"பல்","tr":"pal"}]},{"text":"ஊகக்","tr":"ūkak","foot":"tēmā","acai":[{"kind":"nēr","text":"ஊ","tr":"ū"},{"kind":"nēr","text":"கக்","tr":"kak"}]},{"text":"கறைவிரல்","tr":"kaṟaiviral","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கறை","tr":"kaṟai"},{"kind":"nirai