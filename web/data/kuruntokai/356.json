{"text":"kuruntokai","n":356,"lines":["நிழலான் றவிந்த நீரில் ஆரிடைக்","கழலோன் காப்பக் கடுகுபு போகி","அறுசுனை மருங்கின் மறுகுபு வெந்த","வெவ்வெங் கலுழி தவ்வெனக் குடிக்கிய","யாங்கு வல்லுநள்கொல் தானே ஏந்திய","செம்பொற் புனைகலத் தம்பொரிக் கலந்த","பாலும் பலவென உண்ணாள்","கோலமை குறுந்தொடித் தளிரன் னோளே"],"tr":["niḻalāṉ ṟavinta nīril āriṭaik","kaḻalōṉ kāppak kaṭukupu pōki","aṟucuṉai maruṅkiṉ maṟukupu venta","vevveṅ kaluḻi tavveṉak kuṭikkiya","yāṅku vallunaḷkol tāṉē ēntiya","cempoṟ puṉaikalat tamporik kalanta","pālum palaveṉa uṇṇāḷ","kōlamai kuṟuntoṭit taḷiraṉ ṉōḷē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"செவிலி கூற்று","poet_ta":"கயமனார்","speaker_en":"the foster-mother (cevili)","poet_tr":"Kayamaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 14"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நிழலான்","tr":"niḻalāṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"நிழ","tr":"niḻa"},{"kind":"nēr","text":"லான்","tr":"lāṉ"}]},{"text":"றவிந்த","tr":"ṟavinta","foot":"puḷimā","acai":[{"kind":"nirai","text":"றவிந்","tr":"ṟavin"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"நீரில்","tr":"nīril","foot":"tēmā","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nēr","text":"ரில்","tr":"ril"}]},{"text":"ஆரிடைக்","tr":"āriṭaik","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nirai","text":"ரிடைக்","tr":"riṭaik"}]}],[{"text":"கழலோன்","tr":"kaḻalōṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கழ","tr":"kaḻa"},{"kind":"nēr","text":"லோன்","tr":"lōṉ"}]},{"text":"காப்பக்","tr":"kāppak","foot":"tēmā","acai":[{"kind":"nēr","text":"காப்","tr":"kāp"},{"kind":"nēr","text":"பக்","tr":"pak"}]},{"text":"கடுகுபு","tr":"kaṭukupu","foot":"karuviḷam","acai":[{"kind":"nirai","