{"text":"kuruntokai","n":109,"lines":["முட்கால் இறவின் முடங்குபுறப் பெருங்கிளை","புணரி இகுதிரை தரூஉந் துறைவன்","புணரிய இருந்த ஞான்றும்","இன்னது மன்னோ நன்னுதற் கவினே"],"tr":["muṭkāl iṟaviṉ muṭaṅkupuṟap peruṅkiḷai","puṇari ikutirai tarūun tuṟaivaṉ","puṇariya irunta ñāṉṟum","iṉṉatu maṉṉō naṉṉutaṟ kaviṉē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தோழி கூற்று","poet_ta":"நம்பி குட்டுவனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Nampi Kuṭṭuvaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 14, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 7, veṇṭaḷai 6, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"முட்கால்","tr":"muṭkāl","foot":"tēmā","acai":[{"kind":"nēr","text":"முட்","tr":"muṭ"},{"kind":"nēr","text":"கால்","tr":"kāl"}]},{"text":"இறவின்","tr":"iṟaviṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"இற","tr":"iṟa"},{"kind":"nēr","text":"வின்","tr":"viṉ"}]},{"text":"முடங்குபுறப்","tr":"muṭaṅkupuṟap","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"முடங்","tr":"muṭaṅ"},{"kind":"nirai","text":"குபு","tr":"kupu"},{"kind":"nēr","text":"றப்","tr":"ṟap"}]},{"text":"பெருங்கிளை","tr":"peruṅkiḷai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெருங்","tr":"peruṅ"},{"kind":"nirai","text":"கிளை","tr":"kiḷai"}]}],[{"text":"புணரி","tr":"puṇari","foot":"puḷimā","acai":[{"kind":"nirai","text":"புண","tr":"puṇa"},{"kind":"nēr","text":"ரி","tr":"ri"}]},{"text":"இகுதிரை","tr":"ikutirai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இகு","tr":"iku"},{"kind":"nirai","text":"திரை","tr":"tirai"}]},{"text":"தரூஉந்","tr":"tarūun","foot":"puḷimā","acai":[{"kind":"nirai","text":"தரூ","tr":"tarū"},{"kind":"nēr","text":"உந்","tr":"un"}]},{"text":"துறைவன்","tr":"tuṟaivaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"துறை",