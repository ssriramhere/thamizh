{"text":"kuruntokai","n":153,"lines":["குன்றக் கூகை குழறினும் முன்றிற்","பலவி னிருஞ்சினைக் கலைபாய்ந் துகளினும்","அஞ்சுமன் அளித்தெ னெஞ்ச மினியே","ஆரிருட் கங்குல் அவர்வயிற்","சாரல் நீளிடைச் செலவா னாதே"],"tr":["kuṉṟak kūkai kuḻaṟiṉum muṉṟiṟ","palavi ṉiruñciṉaik kalaipāyn tukaḷiṉum","añcumaṉ aḷitte ṉeñca miṉiyē","āriruṭ kaṅkul avarvayiṟ","cāral nīḷiṭaic celavā ṉātē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"கபிலர்","speaker_en":"the heroine (talaivi)","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 10, āciriyattaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"குன்றக்","tr":"kuṉṟak","foot":"tēmā","acai":[{"kind":"nēr","text":"குன்","tr":"kuṉ"},{"kind":"nēr","text":"றக்","tr":"ṟak"}]},{"text":"கூகை","tr":"kūkai","foot":"tēmā","acai":[{"kind":"nēr","text":"கூ","tr":"kū"},{"kind":"nēr","text":"கை","tr":"kai"}]},{"text":"குழறினும்","tr":"kuḻaṟiṉum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குழ","tr":"kuḻa"},{"kind":"nirai","text":"றினும்","tr":"ṟiṉum"}]},{"text":"முன்றிற்","tr":"muṉṟiṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"முன்","tr":"muṉ"},{"kind":"nēr","text":"றிற்","tr":"ṟiṟ"}]}],[{"text":"பலவி","tr":"palavi","foot":"puḷimā","acai":[{"kind":"nirai","text":"பல","tr":"pala"},{"kind":"nēr","text":"வி","tr":"vi"}]},{"text":"னிருஞ்சினைக்","tr":"ṉiruñciṉaik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"னிருஞ்","tr":"ṉiruñ"},{"kind":"nirai","text":"சினைக்","tr":"ciṉaik"}]},{"text":"கலைபாய்ந்","tr":"kalaipāyn","foot":"puḷimā","acai":[{"kind":"nirai","text":"கலை","tr":"kalai"},{"kind":"nēr","text":"பாய்ந்","tr":"pāyn"}]},{"text":"துகளினும்","tr":"tukaḷiṉum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"துக","tr":"tuka"},{"kind":"ni