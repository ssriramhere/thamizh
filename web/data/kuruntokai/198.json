{"text":"kuruntokai","n":198,"lines":["யாஅங் கொன்ற மரஞ்சுட் டியவிற்","கரும்புமருண் முதல பைந்தாட் செந்தினை","மடப்பிடித் தடக்கை யன்னபால் வார்பு","கரிக்குறட் டிறைஞ்சிய செறிகோட் பைங்குரற்","படுகிளி கடிகஞ் சேறும் அடுபோர்","எஃகுவிளங்கு தடக்கை மலையன் கானத்","தார நாறு மார்பினை","வாரற்க தில்ல வருகுவள் யாயே"],"tr":["yāaṅ koṉṟa marañcuṭ ṭiyaviṟ","karumpumaruṇ mutala paintāṭ centiṉai","maṭappiṭit taṭakkai yaṉṉapāl vārpu","karikkuṟaṭ ṭiṟaiñciya ceṟikōṭ paiṅkuraṟ","paṭukiḷi kaṭikañ cēṟum aṭupōr","eḵkuviḷaṅku taṭakkai malaiyaṉ kāṉat","tāra nāṟu mārpiṉai","vāraṟka tilla varukuvaḷ yāyē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"கபிலர்","speaker_en":"her friend (tōḻi)","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28, veṇcīr 2, other 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 11, kalittaḷai 1, ? 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"யாஅங்","tr":"yāaṅ","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"அங்","tr":"aṅ"}]},{"text":"கொன்ற","tr":"koṉṟa","foot":"tēmā","acai":[{"kind":"nēr","text":"கொன்","tr":"koṉ"},{"kind":"nēr","text":"ற","tr":"ṟa"}]},{"text":"மரஞ்சுட்","tr":"marañcuṭ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மரஞ்","tr":"marañ"},{"kind":"nēr","text":"சுட்","tr":"cuṭ"}]},{"text":"டியவிற்","tr":"ṭiyaviṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"டிய","tr":"ṭiya"},{"kind":"nēr","text":"விற்","tr":"viṟ"}]}],[{"text":"கரும்புமருண்","tr":"karumpumaruṇ","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"கரும்","tr":"karum"},{"kind":"nirai","text":"பும","tr":"puma"},{"kind":"nēr","text":"ருண்","tr":"ruṇ"}]},{"text":"முதல","tr":"mutala","foot":"puḷimā","acai":[{"kind":"nirai","text":"முத","tr":"muta"},{"kind":"nēr","text":"ல","tr":"