{"text":"kuruntokai","n":371,"lines":["கைவளை நெகிழ்தலும் மெய்பசப் பூர்தலும்","மைபடு சிலம்பின் ஐவனம் வித்தி","அருவியின் விளைக்கும் நாடனொடு","மருவேன் தோழியது காமமோ பெரிதே"],"tr":["kaivaḷai nekiḻtalum meypacap pūrtalum","maipaṭu cilampiṉ aivaṉam vitti","aruviyiṉ viḷaikkum nāṭaṉoṭu","maruvēṉ tōḻiyatu kāmamō peritē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"உறையூர் முதுகூற்றனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Uṟaiyūr Mutukūṟṟaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 13, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 7, veṇṭaḷai 6, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கைவளை","tr":"kaivaḷai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கை","tr":"kai"},{"kind":"nirai","text":"வளை","tr":"vaḷai"}]},{"text":"நெகிழ்தலும்","tr":"nekiḻtalum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நெகிழ்","tr":"nekiḻ"},{"kind":"nirai","text":"தலும்","tr":"talum"}]},{"text":"மெய்பசப்","tr":"meypacap","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மெய்","tr":"mey"},{"kind":"nirai","text":"பசப்","tr":"pacap"}]},{"text":"பூர்தலும்","tr":"pūrtalum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பூர்","tr":"pūr"},{"kind":"nirai","text":"தலும்","tr":"talum"}]}],[{"text":"மைபடு","tr":"maipaṭu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மை","tr":"mai"},{"kind":"nirai","text":"படு","tr":"paṭu"}]},{"text":"சிலம்பின்","tr":"cilampiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிலம்","tr":"cilam"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]},{"text":"ஐவனம்","tr":"aivaṉam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஐ","tr":"ai"},{"kind":"nirai","text":"வனம்","tr":"vaṉam"}]},{"text":"வித்தி","tr":"vitti","foot":"tēmā","acai":[{"kind":"nēr","text":"வித்","tr":"vit"},{"kind":