{"text":"kuruntokai","n":365,"lines":["கோடீர் இலங்குவளை நெகிழ நாளும்","பாடில கலிழ்ந்து பனியா னாவே","துன்னரும் நெடுவரைத் ததும்பிய அருவி","தன்ணென் முரசின் இமிழிசை காட்டும்","மருங்கிற் கொண்ட பலவிற்","பெருங்கல் நாடநீ நயந்தோள் கண்ணே"],"tr":["kōṭīr ilaṅkuvaḷai nekiḻa nāḷum","pāṭila kaliḻntu paṉiyā ṉāvē","tuṉṉarum neṭuvarait tatumpiya aruvi","taṉṇeṉ muraciṉ imiḻicai kāṭṭum","maruṅkiṟ koṇṭa palaviṟ","peruṅkal nāṭanī nayantōḷ kaṇṇē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"மதுரை நல்வெள்ளியார்","speaker_en":"her friend (tōḻi)","poet_tr":"Maturai Nalveḷḷiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 8, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கோடீர்","tr":"kōṭīr","foot":"tēmā","acai":[{"kind":"nēr","text":"கோ","tr":"kō"},{"kind":"nēr","text":"டீர்","tr":"ṭīr"}]},{"text":"இலங்குவளை","tr":"ilaṅkuvaḷai","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"இலங்","tr":"ilaṅ"},{"kind":"nirai","text":"குவ","tr":"kuva"},{"kind":"nēr","text":"ளை","tr":"ḷai"}]},{"text":"நெகிழ","tr":"nekiḻa","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெகி","tr":"neki"},{"kind":"nēr","text":"ழ","tr":"ḻa"}]},{"text":"நாளும்","tr":"nāḷum","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"ளும்","tr":"ḷum"}]}],[{"text":"பாடில","tr":"pāṭila","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nirai","text":"டில","tr":"ṭila"}]},{"text":"கலிழ்ந்து","tr":"kaliḻntu","foot":"puḷimā","acai":[{"kind":"nirai","text":"கலிழ்ந்","tr":"kaliḻn"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"பனியா","tr":"paṉiyā","foot":"puḷimā","acai":[{"kind":"nirai","text":"பனி","tr":"paṉi"},{"kind":"nēr","text":"யா","tr":"yā"}]},