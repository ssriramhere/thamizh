{"text":"kuruntokai","n":94,"lines":["பெருந்தண் மாரிப் பேதைப் பித்திகத்து","அரும்பே முன்னும் மிகச்சிவந் தனவே","மானே மருள்வேன் தோழி பானாள்","இன்னுந் தமியர் கேட்பிற் பெயர்த்தும்","என்னா குவர்கொல் பிரிந்திசி னோரே","அருவி மாமலை தத்தக்","கருவி மாமழைச் சிலை தருங் குரலே"],"tr":["peruntaṇ mārip pētaip pittikattu","arumpē muṉṉum mikaccivan taṉavē","māṉē maruḷvēṉ tōḻi pāṉāḷ","iṉṉun tamiyar kēṭpiṟ peyarttum","eṉṉā kuvarkol pirintici ṉōrē","aruvi māmalai tattak","karuvi māmaḻaic cilai taruṅ kuralē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"கதக்கண்ணனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Katakkaṇṇaṉār"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"1×5, 5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, other 2, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 10, ? 2, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"1 five-foot line (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"பெருந்தண்","tr":"peruntaṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெருந்","tr":"perun"},{"kind":"nēr","text":"தண்","tr":"taṇ"}]},{"text":"மாரிப்","tr":"mārip","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"ரிப்","tr":"rip"}]},{"text":"பேதைப்","tr":"pētaip","foot":"tēmā","acai":[{"kind":"nēr","text":"பே","tr":"pē"},{"kind":"nēr","text":"தைப்","tr":"taip"}]},{"text":"பித்திகத்து","tr":"pittikattu","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"பித்","tr":"pit"},{"kind":"nirai","text":"திகத்","tr":"tikat"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"அரும்பே","tr":"arumpē","foot":"puḷimā","acai":[{"kind":"nirai","text":"அரும்","tr":"arum"},{"kind":"nēr","text":"பே","tr":"pē"}]},{"text":"முன்னும்","tr":"muṉṉum","foot":"tēmā","acai":[{"kind":"nēr","text":"முன்","tr":"muṉ"},{"kind":"nēr","text":"னும்","tr":"ṉu