{"text":"kuruntokai","n":335,"lines":["நிரைவளை முன்கை நேரிழை மகளிர்","இருங்கல் வியலறைச் செந்தினை பரப்பிச்","சுனைபாய் சோர்விடை நோக்கிச் சினையிழிந்து","பைங்கண் மந்தி பார்ப்போடு கவரும்","வெற்பிடை நண்ணி யதுவே வார்கோல்","வல்விற் கானவர் தங்கைப்","பெருந்தோட் கொடிச்சி யிருந்த வூரே"],"tr":["niraivaḷai muṉkai nēriḻai makaḷir","iruṅkal viyalaṟaic centiṉai parappic","cuṉaipāy cōrviṭai nōkkic ciṉaiyiḻintu","paiṅkaṇ manti pārppōṭu kavarum","veṟpiṭai naṇṇi yatuvē vārkōl","valviṟ kāṉavar taṅkaip","peruntōṭ koṭicci yirunta vūrē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"இருந்தையூர்க் கொற்றன் புலவனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Iruntaiyūrk Koṟṟaṉ Pulavaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 14, āciriyattaḷai 11, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நிரைவளை","tr":"niraivaḷai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நிரை","tr":"nirai"},{"kind":"nirai","text":"வளை","tr":"vaḷai"}]},{"text":"முன்கை","tr":"muṉkai","foot":"tēmā","acai":[{"kind":"nēr","text":"முன்","tr":"muṉ"},{"kind":"nēr","text":"கை","tr":"kai"}]},{"text":"நேரிழை","tr":"nēriḻai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நே","tr":"nē"},{"kind":"nirai","text":"ரிழை","tr":"riḻai"}]},{"text":"மகளிர்","tr":"makaḷir","foot":"puḷimā","acai":[{"kind":"nirai","text":"மக","tr":"maka"},{"kind":"nēr","text":"ளிர்","tr":"ḷir"}]}],[{"text":"இருங்கல்","tr":"iruṅkal","foot":"puḷimā","acai":[{"kind":"nirai","text":"இருங்","tr":"iruṅ"},{"kind":"nēr","text":"கல்","tr":"kal"}]},{"text":"வியலறைச்","tr":"viyalaṟaic","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விய","tr":"viya"},{"kind":"nirai","text":"லறைச்","tr":"laṟaic"}]},{"text":"செந்தினை","tr":"centiṉai","f