{"text":"kuruntokai","n":49,"lines":["அணிற்பல் அன்ன கொங்குமுதிர் முண்டகத்து","மணிக்கேழ் அன்ன மாநீர்ச் சேர்ப்ப","இம்மை மாறி மறுமை யாயினும்","நீயா கியரென் கணவனை","யானா கியர்நின் னெஞ்சுநேர் பவளே"],"tr":["aṇiṟpal aṉṉa koṅkumutir muṇṭakattu","maṇikkēḻ aṉṉa mānīrc cērppa","immai māṟi maṟumai yāyiṉum","nīyā kiyareṉ kaṇavaṉai","yāṉā kiyarniṉ ṉeñcunēr pavaḷē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"அம்மூவனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Ammūvaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 7, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அணிற்பல்","tr":"aṇiṟpal","foot":"puḷimā","acai":[{"kind":"nirai","text":"அணிற்","tr":"aṇiṟ"},{"kind":"nēr","text":"பல்","tr":"pal"}]},{"text":"அன்ன","tr":"aṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"அன்","tr":"aṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"கொங்குமுதிர்","tr":"koṅkumutir","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"கொங்","tr":"koṅ"},{"kind":"nirai","text":"குமு","tr":"kumu"},{"kind":"nēr","text":"திர்","tr":"tir"}]},{"text":"முண்டகத்து","tr":"muṇṭakattu","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"முண்","tr":"muṇ"},{"kind":"nirai","text":"டகத்","tr":"ṭakat"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"மணிக்கேழ்","tr":"maṇikkēḻ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மணிக்","tr":"maṇik"},{"kind":"nēr","text":"கேழ்","tr":"kēḻ"}]},{"text":"அன்ன","tr":"aṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"அன்","tr":"aṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"மாநீர்ச்","tr":"mānīrc","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"நீர்ச்","tr":"nīrc"}]},{"text":"சேர்ப்ப","tr":"cērppa","foot":