ty of"}],"gloss":"having the quality of"},{"surface":"ஏ","parts":[{"text":"ஏ","lemma":"ஏ","gloss":"arrow"}],"gloss":"arrow"},{"surface":"ஒத்து","parts":[{"text":"ஒத்து","lemma":"ஒத்தல்","gloss":"resembling"}],"gloss":"resembling"}]},{"words":[{"surface":"எல்லாரும்","parts":[{"text":"எல்லாரும்","lemma":"எல்லாரும்","gloss":"everyone"}],"gloss":"everyone"},{"surface":"அறிய","parts":[{"text":"அறிய","lemma":"அறிதல்","gloss":"to know"}],"gloss":"to know"},{"surface":"நோய்","parts":[{"text":"நோய்","lemma":"நோய்","gloss":"affliction"}],"gloss":"affliction"},{"surface":"செய்தனவே","parts":[{"text":"செய்","lemma":"செய்தல்","gloss":"do"},{"text":"தன","lemma":"தான்","gloss":"they (neuter)"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"they did indeed"}]},{"words":[{"surface":"தேமொழி","parts":[{"text":"தேமொழி","lemma":"தேமொழி","gloss":"honey-sweet speech"}],"gloss":"honey-sweet speech","split_unverified":true},{"surface":"திரண்ட","parts":[{"text":"திரண்ட","lemma":"திரளுதல்","gloss":"rounded"}],"gloss":"rounded"},{"surface":"மென்தோள்","parts":[{"text":"மென்தோள்","lemma":"மென்தோள்","gloss":"soft shoulders"}],"gloss":"soft shoulders","split_unverified":true},{"surface":"மாமலை","parts":[{"text":"மா","lemma":"மா","gloss":"great"},{"text":"மலை","lemma":"மலை","gloss":"mountain"}],"gloss":"great mountain"}]},{"words":[{"surface":"பரீஇ","parts":[{"text":"பரீஇ","lemma":"பரிதல்","gloss":"having cleared"}],"gloss":"having cleared"},{"surface":"வித்திய","parts":[{"text":"வித்திய","lemma":"வித்துதல்","gloss":"sown"}],"gloss":"sown"},{"surface":"ஏனல்","parts":[{"text":"ஏனல்","lemma":"ஏனல்","gloss":"millet"}],"gloss":"millet"}]},{"words":[{"surface":"குரீஇ","parts":[{"text":"குரீஇ","lemma":"குருவி","gloss":"sparrows"}],"gloss":"sparrows"},{"surface":"ஓப்புவாள்","parts":[{"text":"ஓப்புவாள்","lemma":"ஓப்புதல்","gloss":"she who drives away"}],"gloss":"she who drives away"},{"surface":"பெருமழை","parts":[{"text":"பெரு","lemma":"பெரு","gloss":"great"},{"text":"மழை","lemma":"மழை","gloss":"coolness"}],"gloss":"great cool"},{"surface":"கண்ணே","parts":[{"text":"கண்","lemma":"கண்","gloss":"eyes"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"eyes indeed"}]}],"literal":"Resembling a flower, spinning in nature, resembling an arrow, / so that everyone knows, they caused affliction, / she of honey-sweet speech, rounded soft shoulders, on the great mountain / where [forest] was cleared and millet sown, / she who drives away sparrows, her great rain-like eyes!","translation":"Resembling a flower in their spinning motion, yet resembling a sharp arrow, they have caused me an affliction that everyone can see—the great, rain-cool eyes of her who drives away sparrows from the millet field, sown after clearing the forest on the great mountain, she of honey-sweet speech and rounded, soft shoulders.","modern":"பெரிய மலையில் காட்டை அழித்து விதைத்த தினைப்புனத்தில், குருவிகளை விரட்டும் தேன் போன்ற இனிய மொழியையும் திரண்ட மென்மையான தோள்களையும் உடையவளின் பெரிய குளிர்ந்த கண்கள், சுழலும் தன்மையால் மலரைப் போன்றும், தைக்கும் தன்மையால் அம்பைப் போன்றும் இருந்து, எல்லாரும் அறியும்படி எனக்குக் காமநோயை உண்டாக்கிவிட்டன.","explanation":"The hero is speaking to himself or his friend, expressing his deep love-sickness after encountering the heroine in the mountain slopes (kuriñci). He describes her eyes, which are both beautiful and tormenting. On one hand, they spin and flutter gently like a flower caught in a breeze; on the other hand, they pierce his heart like sharp arrows. She is guarding the millet field on the great mountain, driving away sparrows, and her physical beauty is marked by soft, rounded shoulders and sweet speech. The contrast between her gentle task of driving away tiny birds and the powerful, wounding effect of her eyes on the hero highlights the intensity of his love.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.35],[0.35,1.04],[1.04,1.5],[1.71,2.0],[2.0,2.7],[2.7,3.0],[3.0,3.5],[3.5,3.8],[3.8,4.87],[4.87,5.2],[5.2,5.4],[5.4,5.8],[5.8,6.26],[6.26,7.04],[7.04,7.5],[7.5,8.03],[8.03,8.9],[8.9,9.46],[9.46,9.7]],"female":[[0.0,0.45],[0.45,1.24],[1.24,1.7],[1.7,2.0],[2.0,2.9],[2.9,3.1],[3.1,3.65],[3.65,3.9],[3.9,5.08],[5.08,5.5],[5.5,5.7],[5.7,6.2],[6.2,6.64],[6.64,7.36],[7.36,7.8],[7.8,8.1],[8.1,8.4],[8.4,8.7],[8.7,9.0]]},"sync":[[["பூ","flower"],["ஒத்து","resembling"]],[["ஒத்து","resembling"],["அலமரும்","spinning"]],[["தகைய","having the quality of"]],[["ஏ","arrow"],["ஒத்து","resembling"]],[["எல்லாரும்","everyone"]],[["அறிய","to know"]],[["நோய்","affliction"],["செய்தனவே","they did indeed"]],[["செய்தனவே","they did indeed"]],[["தேமொழி","honey-sweet speech"]],[["திரண்ட","rounded"]],[["மென்தோள்","soft shoulders"]],[["மாமலை","great mountain"]],[["பரீஇ","having cleared"]],[["வித்திய","sown"]],[["ஏனல்","millet"]],[["குரீஇ","sparrows"]],[["ஓப்புவாள்","she who drives away"]],[["பெருமழை","great cool"],["கண்ணே","eyes indeed"]],[["கண்ணே","eyes indeed"]]]}