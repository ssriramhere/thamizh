{"text":"kuruntokai","n":72,"lines":["பூவொத் தலமருந் தகைய ஏவொத்து","எல்லாரும் அறிய நோய்செய் தனவே","தேமொழித் திரண்ட மென்தோள் மாமலைப்","பரீஇ வித்திய ஏனற்","குரீஇ ஓப்புவாள் பெருமழைக் கண்ணே"],"tr":["pūvot talamarun takaiya ēvottu","ellārum aṟiya nōycey taṉavē","tēmoḻit tiraṇṭa meṉtōḷ māmalaip","parīi vittiya ēṉaṟ","kurīi ōppuvāḷ perumaḻaik kaṇṇē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"மள்ளனார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Maḷḷaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 6, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பூவொத்","tr":"pūvot","foot":"tēmā","acai":[{"kind":"nēr","text":"பூ","tr":"pū"},{"kind":"nēr","text":"வொத்","tr":"vot"}]},{"text":"தலமருந்","tr":"talamarun","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தல","tr":"tala"},{"kind":"nirai","text":"மருந்","tr":"marun"}]},{"text":"தகைய","tr":"takaiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"தகை","tr":"takai"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"ஏவொத்து","tr":"ēvottu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"ஏ","tr":"ē"},{"kind":"nēr","text":"வொத்","tr":"vot"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"எல்லாரும்","tr":"ellārum","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"எல்","tr":"el"},{"kind":"nēr","text":"லா","tr":"lā"},{"kind":"nēr","text":"ரும்","tr":"rum"}]},{"text":"அறிய","tr":"aṟiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"அறி","tr":"aṟi"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"நோய்செய்","tr":"nōycey","foot":"tēmā","acai":[{"kind":"nēr","text":"நோய்","tr":"nōy"},{"kind":"nēr","text":"செய்","tr":"cey"}]},{"text":"தனவே","tr":"taṉavē","foot":"puḷimā","acai":[{"kind":"nirai","text":