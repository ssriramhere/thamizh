{"text":"kuruntokai","n":285,"lines":["வைகல் வைகல் வைகவும் வாரார்","எல்லா எல்லை எல்லையுந் தோன்றார்","யாண்டுளர் கொல்லோ தோழி ஈண்டிவர்","சொல்லிய பருவமோ இதுவே பல்லூழ்","புன்புறப் பெடையொடு பயிரி யின்புற","இமைக்கண் ஏதா கின்றோ ஞெமைத்தலை","ஊனசைஇ யொருபருந் திருக்கும்","வானுயர் பிறங்கல் மலையிறந் தோரே"],"tr":["vaikal vaikal vaikavum vārār","ellā ellai ellaiyun tōṉṟār","yāṇṭuḷar kollō tōḻi īṇṭivar","colliya paruvamō ituvē pallūḻ","puṉpuṟap peṭaiyoṭu payiri yiṉpuṟa","imaikkaṇ ētā kiṉṟō ñemaittalai","ūṉacaii yoruparun tirukkum","vāṉuyar piṟaṅkal malaiyiṟan tōrē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"பூதத் தேவனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Pūtat Tēvaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 29, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 21, veṇṭaḷai 8, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வைகல்","tr":"vaikal","foot":"tēmā","acai":[{"kind":"nēr","text":"வை","tr":"vai"},{"kind":"nēr","text":"கல்","tr":"kal"}]},{"text":"வைகல்","tr":"vaikal","foot":"tēmā","acai":[{"kind":"nēr","text":"வை","tr":"vai"},{"kind":"nēr","text":"கல்","tr":"kal"}]},{"text":"வைகவும்","tr":"vaikavum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வை","tr":"vai"},{"kind":"nirai","text":"கவும்","tr":"kavum"}]},{"text":"வாரார்","tr":"vārār","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ரார்","tr":"rār"}]}],[{"text":"எல்லா","tr":"ellā","foot":"tēmā","acai":[{"kind":"nēr","text":"எல்","tr":"el"},{"kind":"nēr","text":"லா","tr":"lā"}]},{"text":"எல்லை","tr":"ellai","foot":"tēmā","acai":[{"kind":"nēr","text":"எல்","tr":"el"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"எல்லையுந்","tr":"ellaiyun","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"எல்","tr":"el"},{"