{"text":"kuruntokai","n":111,"lines":["மென்தோள் நெகிழ்த்த செல்லல் வேலன்","வென்றி நெடுவேள் என்னும் அன்னையும்","அதுவென உணரும் ஆயின் ஆயிடைக்","கூழை இரும்பிடிக் கைகரந் தன்ன","கேழிருந் துறுகற் கெழுமலை நாடன்","வல்லே வருக தோழிநம்","இல்லோர் பெருநகை காணிய சிறிதே"],"tr":["meṉtōḷ nekiḻtta cellal vēlaṉ","veṉṟi neṭuvēḷ eṉṉum aṉṉaiyum","atuveṉa uṇarum āyiṉ āyiṭaik","kūḻai irumpiṭik kaikaran taṉṉa","kēḻirun tuṟukaṟ keḻumalai nāṭaṉ","vallē varuka tōḻinam","illōr perunakai kāṇiya ciṟitē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"தீன்மதி நாகனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Tīṉmati Nākaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 12, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மென்தோள்","tr":"meṉtōḷ","foot":"tēmā","acai":[{"kind":"nēr","text":"மென்","tr":"meṉ"},{"kind":"nēr","text":"தோள்","tr":"tōḷ"}]},{"text":"நெகிழ்த்த","tr":"nekiḻtta","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெகிழ்த்","tr":"nekiḻt"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"செல்லல்","tr":"cellal","foot":"tēmā","acai":[{"kind":"nēr","text":"செல்","tr":"cel"},{"kind":"nēr","text":"லல்","tr":"lal"}]},{"text":"வேலன்","tr":"vēlaṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"வே","tr":"vē"},{"kind":"nēr","text":"லன்","tr":"laṉ"}]}],[{"text":"வென்றி","tr":"veṉṟi","foot":"tēmā","acai":[{"kind":"nēr","text":"வென்","tr":"veṉ"},{"kind":"nēr","text":"றி","tr":"ṟi"}]},{"text":"நெடுவேள்","tr":"neṭuvēḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெடு","tr":"neṭu"},{"kind":"nēr","text":"வேள்","tr":"vēḷ"}]},{"text":"என்னும்","tr":"eṉṉum","foot":"tēmā","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nēr","text":"னும்","tr":"ṉum"}]},{"text":"அன்ன