{"text":"kuruntokai","n":329,"lines":["கான விருப்பை வேனல் வெண்பூ","வளிபொரு நெடுஞ்சினை உகுத்தலி னார்கழல்பு","களிறுவழங்கு சிறுநெறி புதையத் தாஅம்","பிறங்குமலை அருஞ்சுரம் இறந்தவர்ப் படர்ந்து","பயிலிருள் நடுநாள் துயிலரி தாகித்","தெண்ணீர் நிகர்மலர் புரையும்","நன்மலர் மழைக்கணிற் கௌியவாற் பனியே"],"tr":["kāṉa viruppai vēṉal veṇpū","vaḷiporu neṭuñciṉai ukuttali ṉārkaḻalpu","kaḷiṟuvaḻaṅku ciṟuneṟi putaiyat tāam","piṟaṅkumalai aruñcuram iṟantavarp paṭarntu","payiliruḷ naṭunāḷ tuyilari tākit","teṇṇīr nikarmalar puraiyum","naṉmalar maḻaikkaṇiṟ kauyavāṟ paṉiyē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"ஓதலாந்தையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Ōtalāntaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 24, veṇcīr 2, other 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 9, kalittaḷai 2, ? 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கான","tr":"kāṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"விருப்பை","tr":"viruppai","foot":"puḷimā","acai":[{"kind":"nirai","text":"விருப்","tr":"virup"},{"kind":"nēr","text":"பை","tr":"pai"}]},{"text":"வேனல்","tr":"vēṉal","foot":"tēmā","acai":[{"kind":"nēr","text":"வே","tr":"vē"},{"kind":"nēr","text":"னல்","tr":"ṉal"}]},{"text":"வெண்பூ","tr":"veṇpū","foot":"tēmā","acai":[{"kind":"nēr","text":"வெண்","tr":"veṇ"},{"kind":"nēr","text":"பூ","tr":"pū"}]}],[{"text":"வளிபொரு","tr":"vaḷiporu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வளி","tr":"vaḷi"},{"kind":"nirai","text":"பொரு","tr":"poru"}]},{"text":"நெடுஞ்சினை","tr":"neṭuñciṉai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நெடுஞ்","tr":"neṭuñ"},{"kind":"nirai","text":"சினை","tr":"ciṉai"}]},{"text":"உகுத்தலி","tr":"ukuttali","foot":"karuviḷa