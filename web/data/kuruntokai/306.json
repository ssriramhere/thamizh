nd":"nēr","text":"கண்","tr":"kaṇ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"பின்னே","tr":"piṉṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"பின்","tr":"piṉ"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"மெல்லிய","parts":[{"text":"மெல்","lemma":"மெல்","gloss":"soft"},{"text":"இய","lemma":"இய","gloss":"adjectival suffix"}],"gloss":"soft/gentle"},{"surface":"இனிய","parts":[{"text":"இனி","lemma":"இனிது","gloss":"sweet"},{"text":"அ","lemma":"அ","gloss":"adjectival suffix"}],"gloss":"sweet/pleasant"},{"surface":"மேவரு","parts":[{"text":"மே","lemma":"மே","gloss":"desire"},{"text":"வரு","lemma":"வருதல்","gloss":"come"}],"gloss":"desirable/loving"},{"surface":"தகுந","parts":[{"text":"தகு","lemma":"தகு","gloss":"fit/worthy"},{"text":"ந","lemma":"ந","gloss":"neuter plural suffix"}],"gloss":"worthy things"}]},{"words":[{"surface":"இவை","parts":[{"text":"இ","lemma":"இ","gloss":"this"},{"text":"வை","lemma":"வை","gloss":"plural suffix"}],"gloss":"these things"},{"surface":"மொழியாம்","parts":[{"text":"மொழி","lemma":"மொழிதல்","gloss":"speak"},{"text":"ஆம்","lemma":"ஆம்","gloss":"we will not (negative first-person plural)"}],"gloss":"we will not speak"},{"surface":"என","parts":[{"text":"என்","lemma":"என்","gloss":"say"},{"text":"அ","lemma":"அ","gloss":"infinitive suffix"}],"gloss":"saying"},{"surface":"சொல்லினும்","parts":[{"text":"சொல்","lemma":"சொல்லுதல்","gloss":"say"},{"text":"இன்","lemma":"இன்","gloss":"conditional suffix"},{"text":"உம்","lemma":"உம்","gloss":"even/concessive"}],"gloss":"even if saying"},{"surface":"அவை","parts":[{"text":"அ","lemma":"அ","gloss":"that"},{"text":"வை","lemma":"வை","gloss":"plural suffix"}],"gloss":"those things"},{"surface":"நீ","parts":[{"text":"நீ","lemma":"நீ","gloss":"you"}],"gloss":"you"}]},{"words":[{"surface":"மறத்தியோ","parts":[{"text":"மற","lemma":"மறத்தல்","gloss":"forget"},{"text":"த்தி","lemma":"த்தி","gloss":"second person singular suffix"},{"text":"ஓ","lemma":"ஓ","gloss":"interrogative particle"}],"gloss":"do you forget?"},{"surface":"வாழி","parts":[{"text":"வாழ்","lemma":"வாழ்தல்","gloss":"live"},{"text":"இ","lemma":"இ","gloss":"optative suffix"}],"gloss":"may you live"},{"surface":"என்","parts":[{"text":"என்","lemma":"என்","gloss":"my"}],"gloss":"my"},{"surface":"நெஞ்சே","parts":[{"text":"நெஞ்சு","lemma":"நெஞ்சு","gloss":"heart"},{"text":"ஏ","lemma":"ஏ","gloss":"vocative/emphasis"}],"gloss":"O heart"},{"surface":"பல","parts":[{"text":"பல","lemma":"பல","gloss":"many"}],"gloss":"many things"},{"surface":"உடன்","parts":[{"text":"உடன்","lemma":"உடன்","gloss":"together"}],"gloss":"together"}]},{"words":[{"surface":"காமர்","parts":[{"text":"காமர்","lemma":"காமர்","gloss":"beautiful"}],"gloss":"beautiful"},{"surface":"மாஅத்து","parts":[{"text":"மா","lemma":"மா","gloss":"mango tree"},{"text":"அத்து","lemma":"அத்து","gloss":"oblique case suffix"}],"gloss":"of the mango tree"},{"surface":"தாது","parts":[{"text":"தாது","lemma":"தாது","gloss":"pollen"}],"gloss":"pollen"},{"surface":"அமர்","parts":[{"text":"அமர்","lemma":"அமர்தல்","gloss":"abiding/resting"}],"gloss":"abiding"},{"surface":"பூவின்","parts":[{"text":"பூ","lemma":"பூ","gloss":"flower"},{"text":"இன்","lemma":"இன்","gloss":"oblique suffix"}],"gloss":"of the flower"}]},{"words":[{"surface":"வண்டு","parts":[{"text":"வண்டு","lemma":"வண்டு","gloss":"bee"}],"gloss":"bee"},{"surface":"வீழ்","parts":[{"text":"வீழ்","lemma":"வீழ்தல்","gloss":"falling upon"}],"gloss":"falling upon"},{"surface":"பயரும்","parts":[{"text":"பயர்","lemma":"பயர்தல்","gloss":"moving/sounding"},{"text":"உம்","lemma":"உம்","gloss":"adjectival participle suffix"}],"gloss":"moving/sounding"},{"surface":"கானல்","parts":[{"text":"கானல்","lemma":"கானல்","gloss":"seaside grove"}],"gloss":"seaside grove"}]},{"words":[{"surface":"தண்","parts":[{"text":"தண்","lemma":"தண்மை","gloss":"cool"}],"gloss":"cool"},{"surface":"கடல்","parts":[{"text":"கடல்","lemma":"கடல்","gloss":"sea"}],"gloss":"sea"},{"surface":"சேர்ப்பனை","parts":[{"text":"சேர்ப்பன்","lemma":"சேர்ப்பன்","gloss":"lord of the shore"},{"text":"ஐ","lemma":"ஐ","gloss":"accusative suffix"}],"gloss":"lord of the shore"},{"surface":"கண்ட","parts":[{"text":"கண்ட","lemma":"கண்ட","gloss":"having seen"}],"gloss":"having seen","split_unverified":true},{"surface":"பின்னே","parts":[{"text":"பின்","lemma":"பின்","gloss":"after"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"after"}]}],"literal":"Gentle, sweet, desirable, worthy things / 'these we will not speak', even if I say, those things, you / do you forget? May you live, my heart! Many things together, / of the beautiful mango tree, pollen-abiding flower, / bees falling and moving, in the seaside grove, / the cool sea's lord, after seeing?","translation":"O my heart, may you live! Even when I tell you, 'Let us not speak of these gentle, sweet, desirable, and worthy things,' do you forget that advice? The moment you see the lord of the cool seashore, where bees fall upon and swarm around the pollen-rich flowers of the lovely mango tree in the seaside grove, you forget everything at once!","modern":"என் நெஞ்சமே, நீ வாழ்க! 'மென்மையான, இனிய, விரும்பத்தக்க, தகுதியான இந்த வார்த்தைகளை நாம் அவரிடம் பேசக் கூடாது' என்று நான் உனக்குச் சொன்னாலும், அழகிய மாமரத்துப் பூக்களின் தாதுக்களை விரும்பி வண்டுகள் வீழ்ந்து ஒலிக்கும் நெய்தல் நிலக் கானலையும், குளிர்ந்த கடலையும் உடைய தலைவனைக் கண்ட உடனே, நீ அந்தப் பலவற்றையும் மறந்துவிடுகிறாயோ?","explanation":"This poem is spoken by the heroine to her own heart in the Neytal (coastal) landscape. She gently chides her heart for its lack of resolve. She had resolved not to speak sweet, gentle, and loving words to the hero, perhaps to show her anger or distress over his delay. However, the moment she sees the lord of the cool seashore, her heart immediately forgets all its resolutions and rushes to him. The imagery of the bees falling upon the pollen-rich flowers of the mango tree in the seaside grove mirrors her heart's natural, uncontrollable attraction to the hero. The key words are 'நெஞ்சே' (O heart), 'மறத்தியோ' (do you forget?), and 'சேர்ப்பன்' (lord of the shore).","model":"gemini-3.5-flash"}}