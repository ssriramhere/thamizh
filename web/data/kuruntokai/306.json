{"text":"kuruntokai","n":306,"lines":["மெல்லிய இனிய மேவரு தகுந","இவைமொழி யாமெனச் சொல்லினு மவைநீ","மறத்தியோ வாழியென் னெஞ்சே பலவுடன்","காமர் மாஅத்துத் தாதமர் பூவின்","வண்டுவீழ் பயருங் கானல்","தண்கடற் சேர்ப்பனைக் கண்ட பின்னே"],"tr":["melliya iṉiya mēvaru takuna","ivaimoḻi yāmeṉac colliṉu mavainī","maṟattiyō vāḻiyeṉ ṉeñcē palavuṭaṉ","kāmar māattut tātamar pūviṉ","vaṇṭuvīḻ payaruṅ kāṉal","taṇkaṭaṟ cērppaṉaik kaṇṭa piṉṉē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"அம்மூவனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Ammūvaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 12, āciriyattaḷai 10"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மெல்லிய","tr":"melliya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மெல்","tr":"mel"},{"kind":"nirai","text":"லிய","tr":"liya"}]},{"text":"இனிய","tr":"iṉiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"இனி","tr":"iṉi"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"மேவரு","tr":"mēvaru","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மே","tr":"mē"},{"kind":"nirai","text":"வரு","tr":"varu"}]},{"text":"தகுந","tr":"takuna","foot":"puḷimā","acai":[{"kind":"nirai","text":"தகு","tr":"taku"},{"kind":"nēr","text":"ந","tr":"na"}]}],[{"text":"இவைமொழி","tr":"ivaimoḻi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இவை","tr":"ivai"},{"kind":"nirai","text":"மொழி","tr":"moḻi"}]},{"text":"யாமெனச்","tr":"yāmeṉac","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nirai","text":"மெனச்","tr":"meṉac"}]},{"text":"சொல்லினு","tr":"colliṉu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சொல்","tr":"col"},{"kind":"nirai","text":"லினு","tr":"liṉu"}]},{"text":"மவைநீ","tr":"mavainī","foot":"puḷimā","acai":[{"kind":"nirai"