{"text":"kuruntokai","n":315,"lines":["எழுதரு மதியங் கடற்கண் டாஅங்","கொழுகுவெள் ளருவி யோங்குமலை நாடன்","ஞாயி றனையன் தோழி","நெருஞ்சி யனையவென் பெரும்பணைத் தோளே"],"tr":["eḻutaru matiyaṅ kaṭaṟkaṇ ṭāaṅ","koḻukuveḷ ḷaruvi yōṅkumalai nāṭaṉ","ñāyi ṟaṉaiyaṉ tōḻi","neruñci yaṉaiyaveṉ perumpaṇait tōḷē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"மதுரை வேள்ஆதத்தனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Maturai Vēḷātattaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 14, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 7, veṇṭaḷai 7"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"எழுதரு","tr":"eḻutaru","foot":"karuviḷam","acai":[{"kind":"nirai","text":"எழு","tr":"eḻu"},{"kind":"nirai","text":"தரு","tr":"taru"}]},{"text":"மதியங்","tr":"matiyaṅ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மதி","tr":"mati"},{"kind":"nēr","text":"யங்","tr":"yaṅ"}]},{"text":"கடற்கண்","tr":"kaṭaṟkaṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கடற்","tr":"kaṭaṟ"},{"kind":"nēr","text":"கண்","tr":"kaṇ"}]},{"text":"டாஅங்","tr":"ṭāaṅ","foot":"tēmā","acai":[{"kind":"nēr","text":"டா","tr":"ṭā"},{"kind":"nēr","text":"அங்","tr":"aṅ"}]}],[{"text":"கொழுகுவெள்","tr":"koḻukuveḷ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கொழு","tr":"koḻu"},{"kind":"nirai","text":"குவெள்","tr":"kuveḷ"}]},{"text":"ளருவி","tr":"ḷaruvi","foot":"puḷimā","acai":[{"kind":"nirai","text":"ளரு","tr":"ḷaru"},{"kind":"nēr","text":"வி","tr":"vi"}]},{"text":"யோங்குமலை","tr":"yōṅkumalai","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"யோங்","tr":"yōṅ"},{"kind":"nirai","text":"கும","tr":"kuma"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"நாடன்","tr":"nāṭaṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"டன்","tr":"ṭaṉ"}]}],[{"text":"ஞாயி","tr":"ñāyi","foot":"tēmā","acai":[{"kind":"nēr","text":"ஞா","tr":"ñā"},{"kind":"nēr","text":"யி","tr":"yi"}]},{"text":"றனையன்","tr":"ṟaṉaiyaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"றனை","tr":"ṟaṉai"},{"kind":"nēr","text":"யன்","tr":"yaṉ"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]}],[{"text":"நெருஞ்சி","tr":"neruñci","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெருஞ்","tr":"neruñ"},{"kind":"nēr","text":"சி","tr":"ci"}]},{"text":"யனையவென்","tr":"yaṉaiyaveṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"யனை","tr":"yaṉai"},{"kind":"nirai","text":"யவென்","tr":"yaveṉ"}]},{"text":"பெரும்பணைத்","tr":"perumpaṇait","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெரும்","tr":"perum"},{"kind":"nirai","text":"பணைத்","tr":"paṇait"}]},{"text":"தோளே","tr":"tōḷē","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ளே","tr":"ḷē"}]}]]},"ai":null}