{"text":"kuruntokai","n":53,"lines":["எம்மணங் கினவே மகிழ்ந முன்றில்","நனைமுதிர் புன்கின் பூத்தாழ் வெண்மணல்","வேலன் புனைந்த வெறியயர் களந்தொறும்","செந்நெல் வான்பொரி சிதறி யன்ன","எக்கர் நண்ணிய எம்மூர் வியன்துறை","நேரிறை முன்கை பற்றிச்","சூரர மகளிரோ டுற்ற சூளே"],"tr":["emmaṇaṅ kiṉavē makiḻna muṉṟil","naṉaimutir puṉkiṉ pūttāḻ veṇmaṇal","vēlaṉ puṉainta veṟiyayar kaḷantoṟum","cennel vāṉpori citaṟi yaṉṉa","ekkar naṇṇiya emmūr viyaṉtuṟai","nēriṟai muṉkai paṟṟic","cūrara makaḷirō ṭuṟṟa cūḷē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தோழி கூற்று","poet_ta":"கோப்பெருஞ் சோழன்","speaker_en":"her friend (tōḻi)","poet_tr":"Kōpperuñ Cōḻaṉ"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 12"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"எம்மணங்","tr":"emmaṇaṅ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"எம்","tr":"em"},{"kind":"nirai","text":"மணங்","tr":"maṇaṅ"}]},{"text":"கினவே","tr":"kiṉavē","foot":"puḷimā","acai":[{"kind":"nirai","text":"கின","tr":"kiṉa"},{"kind":"nēr","text":"வே","tr":"vē"}]},{"text":"மகிழ்ந","tr":"makiḻna","foot":"puḷimā","acai":[{"kind":"nirai","text":"மகிழ்","tr":"makiḻ"},{"kind":"nēr","text":"ந","tr":"na"}]},{"text":"முன்றில்","tr":"muṉṟil","foot":"tēmā","acai":[{"kind":"nēr","text":"முன்","tr":"muṉ"},{"kind":"nēr","text":"றில்","tr":"ṟil"}]}],[{"text":"நனைமுதிர்","tr":"naṉaimutir","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நனை","tr":"naṉai"},{"kind":"nirai","text":"முதிர்","tr":"mutir"}]},{"text":"புன்கின்","tr":"puṉkiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"புன்","tr":"puṉ"},{"kind":"nēr","text":"கின்","tr":"kiṉ"}]},{"text":"பூத்தாழ்","tr":"pūttāḻ","foot":"tēmā","acai":[{"kind":"nēr","text":"பூத்","tr":"pūt"},{"kind":"nēr","text":"தாழ்","tr":"tāḻ"}]},