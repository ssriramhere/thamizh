{"text":"kuruntokai","n":265,"lines":["காந்தளங் கொழுமுகை காவல் செல்லாது","வண்டுவாய் திறக்கும் பொழுதிற் பண்டும்","தாமறி செம்மைச் சான்றோர்க் கண்ட","கடனறி மாக்கள் போல இடன்விட்","டிதழ்தளை யவிழ்ந்த ஏகல் வெற்பன்","நன்னர் நெஞ்சத்தன் தோழி நின்னிலை","யான்றனக் குரைத்தனெ னாகத்","தானா ணினனிஃ தாகா வாறே"],"tr":["kāntaḷaṅ koḻumukai kāval cellātu","vaṇṭuvāy tiṟakkum poḻutiṟ paṇṭum","tāmaṟi cemmaic cāṉṟōrk kaṇṭa","kaṭaṉaṟi mākkaḷ pōla iṭaṉviṭ","ṭitaḻtaḷai yaviḻnta ēkal veṟpaṉ","naṉṉar neñcattaṉ tōḻi niṉṉilai","yāṉṟaṉak kuraittaṉe ṉākat","tāṉā ṇiṉaṉiḵ tākā vāṟē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"கருவூர்க்கதப் பிள்ளை","speaker_en":"her friend (tōḻi)","poet_tr":"Karuvūrkkatap Piḷḷai"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 29, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 12"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"காந்தளங்","tr":"kāntaḷaṅ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"காந்","tr":"kān"},{"kind":"nirai","text":"தளங்","tr":"taḷaṅ"}]},{"text":"கொழுமுகை","tr":"koḻumukai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கொழு","tr":"koḻu"},{"kind":"nirai","text":"முகை","tr":"mukai"}]},{"text":"காவல்","tr":"kāval","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"வல்","tr":"val"}]},{"text":"செல்லாது","tr":"cellātu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"செல்","tr":"cel"},{"kind":"nēr","text":"லா","tr":"lā"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"வண்டுவாய்","tr":"vaṇṭuvāy","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வண்","tr":"vaṇ"},{"kind":"nirai","text":"டுவாய்","tr":"ṭuvāy"}]},{"text":"திறக்கும்","tr":"tiṟakkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"திறக்","tr":"tiṟak"},{"kind":"nēr","text":"கும்","tr":"kum"}]}