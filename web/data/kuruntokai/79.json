{"text":"kuruntokai","n":79,"lines":["கான யானை தோனயந் துண்ட","பொரிதாள் ஓமை வளிபொரு நெடுஞ்சினை","அலங்கல் உலவை யேறி ஒய்யெனப்","புலம்புதரு குரல புறவுப்பெடை பயிரும்","அத்தம் நண்ணிய அங்குடிச் சீறூர்ச்","சேந்தனர் கொல்லோ தாமே யாந்தமக்கு","ஒல்லேம் என்ற தப்பற்குச்","சொல்லா தகறல் வல்லு வோரே"],"tr":["kāṉa yāṉai tōṉayan tuṇṭa","poritāḷ ōmai vaḷiporu neṭuñciṉai","alaṅkal ulavai yēṟi oyyeṉap","pulamputaru kurala puṟavuppeṭai payirum","attam naṇṇiya aṅkuṭic cīṟūrc","cēntaṉar kollō tāmē yāntamakku","ollēm eṉṟa tappaṟkuc","collā takaṟal vallu vōrē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"குடவாயிற் கீரத்தனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kuṭavāyiṟ Kīrattaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27, veṇcīr 3, vañcicīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 11, kalittaḷai 1, oṉṟiya vañcittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கான","tr":"kāṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"யானை","tr":"yāṉai","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னை","tr":"ṉai"}]},{"text":"தோனயந்","tr":"tōṉayan","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nirai","text":"னயந்","tr":"ṉayan"}]},{"text":"துண்ட","tr":"tuṇṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"துண்","tr":"tuṇ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]}],[{"text":"பொரிதாள்","tr":"poritāḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பொரி","tr":"pori"},{"kind":"nēr","text":"தாள்","tr":"tāḷ"}]},{"text":"ஓமை","tr":"ōmai","foot":"tēmā","acai":[{"kind":"nēr","text":"ஓ","tr":"ō"},{"kind":"nēr","text":"மை","tr":"mai"}]},{"text":"வளிபொரு","tr":"vaḷiporu","foot":"karuviḷam","acai":[{"kind":"nirai","