{"text":"kuruntokai","n":388,"lines":["நீர்கால் யாத்த நிரையிதழ்க் குவளை","கோடை ஒற்றினும் வாடா தாகும்","கவணை அன்ன பூட்டுப்பொரு தசாஅ","உமணெருத் தொழுகைத் தோடுநிரைத் தன்ன","முளிசினை பிளக்கு முன்பின் மையின்","யானை கைமடித் துயவும்","கானமும் இனியவாம் நும்மொடு வரினே"],"tr":["nīrkāl yātta niraiyitaḻk kuvaḷai","kōṭai oṟṟiṉum vāṭā tākum","kavaṇai aṉṉa pūṭṭupporu tacāa","umaṇerut toḻukait tōṭunirait taṉṉa","muḷiciṉai piḷakku muṉpiṉ maiyiṉ","yāṉai kaimaṭit tuyavum","kāṉamum iṉiyavām nummoṭu variṉē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"ஔவையார்","speaker_en":"her friend (tōḻi)","poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, vañcicīr 1, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 7, oṉṟiya vañcittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நீர்கால்","tr":"nīrkāl","foot":"tēmā","acai":[{"kind":"nēr","text":"நீர்","tr":"nīr"},{"kind":"nēr","text":"கால்","tr":"kāl"}]},{"text":"யாத்த","tr":"yātta","foot":"tēmā","acai":[{"kind":"nēr","text":"யாத்","tr":"yāt"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"நிரையிதழ்க்","tr":"niraiyitaḻk","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நிரை","tr":"nirai"},{"kind":"nirai","text":"யிதழ்க்","tr":"yitaḻk"}]},{"text":"குவளை","tr":"kuvaḷai","foot":"puḷimā","acai":[{"kind":"nirai","text":"குவ","tr":"kuva"},{"kind":"nēr","text":"ளை","tr":"ḷai"}]}],[{"text":"கோடை","tr":"kōṭai","foot":"tēmā","acai":[{"kind":"nēr","text":"கோ","tr":"kō"},{"kind":"nēr","text":"டை","tr":"ṭai"}]},{"text":"ஒற்றினும்","tr":"oṟṟiṉum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஒற்","tr":"oṟ"},{"kind":"nirai","text":"றினும்","tr":"ṟiṉum"}]},{"text":"வாடா","tr":"vāṭā","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"டா","tr":