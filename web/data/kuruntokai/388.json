:"nēr","text":"னை","tr":"ṉai"}]},{"text":"கைமடித்","tr":"kaimaṭit","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கை","tr":"kai"},{"kind":"nirai","text":"மடித்","tr":"maṭit"}]},{"text":"துயவும்","tr":"tuyavum","foot":"puḷimā","acai":[{"kind":"nirai","text":"துய","tr":"tuya"},{"kind":"nēr","text":"வும்","tr":"vum"}]}],[{"text":"கானமும்","tr":"kāṉamum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"னமும்","tr":"ṉamum"}]},{"text":"இனியவாம்","tr":"iṉiyavām","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இனி","tr":"iṉi"},{"kind":"nirai","text":"யவாம்","tr":"yavām"}]},{"text":"நும்மொடு","tr":"nummoṭu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நும்","tr":"num"},{"kind":"nirai","text":"மொடு","tr":"moṭu"}]},{"text":"வரினே","tr":"variṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"வரி","tr":"vari"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"நீர்கால்","parts":[{"text":"நீர்","lemma":"nīr","gloss":"water"},{"text":"கால்","lemma":"kāl","gloss":"channel"}],"gloss":"water channel"},{"surface":"யாத்த","parts":[{"text":"யாத்த","lemma":"yā","gloss":"nourished"}],"gloss":"nourished"},{"surface":"நிரையிதழ்","parts":[{"text":"நிரை","lemma":"nirai","gloss":"row"},{"text":"இதழ்","lemma":"ithaḻ","gloss":"petal"}],"gloss":"arranged petals"},{"surface":"குவளை","parts":[{"text":"குவளை","lemma":"kuvaḷai","gloss":"blue water lily"}],"gloss":"blue water lily"}]},{"words":[{"surface":"கோடை","parts":[{"text":"கோடை","lemma":"kōṭai","gloss":"summer wind"}],"gloss":"summer wind"},{"surface":"ஒற்றினும்","parts":[{"text":"ஒற்று","lemma":"oṟṟu","gloss":"strike"},{"text":"இன்","lemma":"iṉ","gloss":"conditional"},{"text":"உம்","lemma":"um","gloss":"even if"}],"gloss":"even if it strikes"},{"surface":"வாடாதாகும்","parts":[{"text":"வாடாது","lemma":"vāṭātu","gloss":"without withering"},{"text":"ஆகும்","lemma":"ākum","gloss":"will be"}],"gloss":"does not wither"}]},{"words":[{"surface":"கவணை","parts":[{"text":"கவணை","lemma":"kavaṇai","gloss":"sling"}],"gloss":"sling"},{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"aṉṉa","gloss":"like"}],"gloss":"like"},{"surface":"பூட்டு","parts":[{"text":"பூட்டு","lemma":"pūṭṭu","gloss":"yoke"}],"gloss":"yoke"},{"surface":"பொருது","parts":[{"text":"பொருது","lemma":"poru","gloss":"rubbing against"}],"gloss":"rubbing against"},{"surface":"அசாஅ","parts":[{"text":"அசாஅ","lemma":"acā","gloss":"being weary"}],"gloss":"being weary"}]},{"words":[{"surface":"உமண்","parts":[{"text":"உமண்","lemma":"umaṇ","gloss":"salt-merchant"}],"gloss":"salt-merchant"},{"surface":"எருத்து","parts":[{"text":"எருத்து","lemma":"eruttu","gloss":"bullock"}],"gloss":"bullock"},{"surface":"ஒழுகை","parts":[{"text":"ஒழுகை","lemma":"oḻukai","gloss":"caravan"}],"gloss":"caravan"},{"surface":"தோடு","parts":[{"text":"தோடு","lemma":"tōṭu","gloss":"herd"}],"gloss":"herd"},{"surface":"நிரைத்தன்ன","parts":[{"text":"நிரைத்து","lemma":"nirai","gloss":"having arranged in a row"},{"text":"அன்ன","lemma":"aṉṉa","gloss":"like"}],"gloss":"like being arranged in a row"}]},{"words":[{"surface":"முளி","parts":[{"text":"முளி","lemma":"muḷi","gloss":"withered"}],"gloss":"withered"},{"surface":"சினை","parts":[{"text":"சினை","lemma":"ciṉai","gloss":"branch"}],"gloss":"branch"},{"surface":"பிளக்கும்","parts":[{"text":"பிளக்கும்","lemma":"piḷa","gloss":"splitting"}],"gloss":"splitting"},{"surface":"முன்பு","parts":[{"text":"முன்பு","lemma":"muṉpu","gloss":"strength"}],"gloss":"strength"},{"surface":"இன்மையின்","parts":[{"text":"இன்மையின்","lemma":"iṉmai","gloss":"due to lack of"}],"gloss":"due to lack of"}]},{"words":[{"surface":"யானை","parts":[{"text":"யானை","lemma":"yāṉai","gloss":"elephant"}],"gloss":"elephant"},{"surface":"கை","parts":[{"text":"கை","lemma":"kai","gloss":"trunk"}],"gloss":"trunk"},{"surface":"மடித்து","parts":[{"text":"மடித்து","lemma":"maṭi","gloss":"folding"}],"gloss":"folding"},{"surface":"உயவும்","parts":[{"text":"உயவும்","lemma":"uyavu","gloss":"languishing"}],"gloss":"languishing"}]},{"words":[{"surface":"கானமும்","parts":[{"text":"கானம்","lemma":"kāṉam","gloss":"forest"},{"text":"உம்","lemma":"um","gloss":"even"}],"gloss":"even the forest"},{"surface":"இனியவாம்","parts":[{"text":"இனிய","lemma":"iṉiya","gloss":"pleasant things"},{"text":"ஆம்","lemma":"ām","gloss":"will become"}],"gloss":"will be pleasant"},{"surface":"நும்மொடு","parts":[{"text":"நும்","lemma":"num","gloss":"you"},{"text":"ஒடு","lemma":"oṭu","gloss":"with"}],"gloss":"with you"},{"surface":"வரினே","parts":[{"text":"வரின்","lemma":"variṉ","gloss":"if she comes"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"if she comes"}]}],"literal":"The blue water lily with arranged petals, nourished by a water channel, / does not wither even if the summer wind strikes it. / Like the weary bullocks rubbing against their yokes like slings, / like being arranged in a row, the herd of the salt-merchants' caravan, / due to lack of strength to split the withered branches, / the elephants fold their trunks and languish. / Even the forest will be pleasant if she comes with you.","translation":"The blue water lily with rows of petals, nourished by a water channel, does not wither even when the hot summer wind strikes it. In the desert, elephants lack the strength to split the dry branches; they fold their trunks and languish, looking like the weary bullocks of a salt-merchant's caravan that rub against their sling-like yokes as they stand in a row. Yet, even such a harsh forest will be pleasant for her, if she comes along with you.","modern":"நீர்க்காலால் நீர் ஊட்டப்பட்டு, வரிசையான இதழ்களைக் கொண்ட குவளை மலர், கோடைக்காலத்து வெப்பக் காற்று வீசினாலும் வாடாமல் இருக்கும். கவண் போன்ற நுகத்தடியில் தேய்ந்து வருந்தும் உமணர்களது வண்டிகளை இழுக்கும் எருதுகளின் வரிசையைப் போல, காய்ந்த மரக்கிளைகளை ஒடிப்பதற்கான வலிமை இல்லாததால், தும்பிக்கையை மடக்கிக் கொண்டு யானைகள் வருந்தும். இத்தகைய கொடிய காடும், அவள் உன்னோடு வந்தால் அவளுக்கு இனியதாகவே இருக்கும்.","explanation":"The friend (tōḻi) speaks to the hero who is planning to depart on a journey through the harsh desert path to earn wealth, leaving the heroine behind. She describes the severe heat of the desert (pālai), where even mighty elephants fold their trunks in exhaustion, unable to break the dry branches, resembling a weary line of salt-merchants' bullocks. However, she reassures him that if he takes the heroine with him, the journey will not be painful for her. She uses an implied metaphor (uḷḷurai) of the blue water lily: just as the lily does not wither in the hot summer wind because it is constantly nourished by a water channel, the heroine will easily endure the desert heat if she is sustained by the constant flow of his love. Thus, the friend urges the hero to either take her along or refrain from leaving her.","model":"gemini-3.5-flash"}}