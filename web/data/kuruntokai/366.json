{"text":"kuruntokai","n":366,"lines":["பால்வரைந் தமைத்த லல்ல தவர்வயிற்","சால்பளந் தறிதற் கியாஅம் யாரோ","வெறியாள் கூறவும் அமையாள் அதன்தலைப்","பைங்கண் மாச்சுனைப் பல்பிணி யவிழ்ந்த","வள்ளிதழ் நீலம் நோக்கி உள்ளகை","பழுத கண்ண ளாகிப்","பழூதன் றம்மவிவ் வாயிழை துணிவே"],"tr":["pālvarain tamaitta lalla tavarvayiṟ","cālpaḷan taṟitaṟ kiyāam yārō","veṟiyāḷ kūṟavum amaiyāḷ ataṉtalaip","paiṅkaṇ māccuṉaip palpiṇi yaviḻnta","vaḷḷitaḻ nīlam nōkki uḷḷakai","paḻuta kaṇṇa ḷākip","paḻūtaṉ ṟammaviv vāyiḻai tuṇivē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"பேரிசாத்தனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Pēricāttaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 10"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பால்வரைந்","tr":"pālvarain","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பால்","tr":"pāl"},{"kind":"nirai","text":"வரைந்","tr":"varain"}]},{"text":"தமைத்த","tr":"tamaitta","foot":"puḷimā","acai":[{"kind":"nirai","text":"தமைத்","tr":"tamait"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"லல்ல","tr":"lalla","foot":"tēmā","acai":[{"kind":"nēr","text":"லல்","tr":"lal"},{"kind":"nēr","text":"ல","tr":"la"}]},{"text":"தவர்வயிற்","tr":"tavarvayiṟ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தவர்","tr":"tavar"},{"kind":"nirai","text":"வயிற்","tr":"vayiṟ"}]}],[{"text":"சால்பளந்","tr":"cālpaḷan","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சால்","tr":"cāl"},{"kind":"nirai","text":"பளந்","tr":"paḷan"}]},{"text":"தறிதற்","tr":"taṟitaṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"தறி","tr":"taṟi"},{"kind":"nēr","text":"தற்","tr":"taṟ"}]},{"text":"கியாஅம்","tr":"kiyāam","foot":"puḷimā","acai":[{"kind":"nirai","text":"கியா","tr":"kiyā"},{"kind":"nēr","text