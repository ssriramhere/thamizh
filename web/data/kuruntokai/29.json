{"text":"kuruntokai","n":29,"lines":["நல்லுரை யிகந்து புல்லுரை தாஅய்ப்","பெயல்நீர்க் கேற்ற பசுங்கலம் போல","உள்ளம் தாங்கா வெள்ளம் நீந்தி","அரிதவா உற்றனை நெஞ்சே நன்றும்","பெரிதால் அம்மநின் பூசல் உயர்கோட்டு","மகவுடை மந்தி போல","அகனுறத் தழீஇக் கேட்குநர்ப் பெறினே"],"tr":["nallurai yikantu pullurai tāayp","peyalnīrk kēṟṟa pacuṅkalam pōla","uḷḷam tāṅkā veḷḷam nīnti","aritavā uṟṟaṉai neñcē naṉṟum","peritāl ammaniṉ pūcal uyarkōṭṭu","makavuṭai manti pōla","akaṉuṟat taḻīik kēṭkunarp peṟiṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைன் கூற்று","poet_ta":"ஔவையார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 12, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நல்லுரை","tr":"nallurai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நல்","tr":"nal"},{"kind":"nirai","text":"லுரை","tr":"lurai"}]},{"text":"யிகந்து","tr":"yikantu","foot":"puḷimā","acai":[{"kind":"nirai","text":"யிகந்","tr":"yikan"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"புல்லுரை","tr":"pullurai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"புல்","tr":"pul"},{"kind":"nirai","text":"லுரை","tr":"lurai"}]},{"text":"தாஅய்ப்","tr":"tāayp","foot":"tēmā","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"அய்ப்","tr":"ayp"}]}],[{"text":"பெயல்நீர்க்","tr":"peyalnīrk","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெயல்","tr":"peyal"},{"kind":"nēr","text":"நீர்க்","tr":"nīrk"}]},{"text":"கேற்ற","tr":"kēṟṟa","foot":"tēmā","acai":[{"kind":"nēr","text":"கேற்","tr":"kēṟ"},{"kind":"nēr","text":"ற","tr":"ṟa"}]},{"text":"பசுங்கலம்","tr":"pacuṅkalam","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பசுங்","tr":"pacuṅ"},{"kind":"nirai"