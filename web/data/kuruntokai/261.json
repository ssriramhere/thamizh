{"text":"kuruntokai","n":261,"lines":["பழமழை பொழிந்தெனப் பதனழிந் துருகிய","சிதட்டுக்கா யெண்ணின் சில்பெயற் கடைநாள்","சேற்றுநிலை முனைஇய செங்கட் காரான்","நள்ளென் யாமத் தையெனக் கரையும்","அஞ்சுவரு பொழுதி னானு மென்கண்","துஞ்சா வாழி தோழி காவலர்","கணக்காய் வகையின் வருந்தியென்","நெஞ்சுபுண் ணுற்ற விழுமத் தானே"],"tr":["paḻamaḻai poḻinteṉap pataṉaḻin turukiya","citaṭṭukkā yeṇṇiṉ cilpeyaṟ kaṭaināḷ","cēṟṟunilai muṉaiiya ceṅkaṭ kārāṉ","naḷḷeṉ yāmat taiyeṉak karaiyum","añcuvaru poḻuti ṉāṉu meṉkaṇ","tuñcā vāḻi tōḻi kāvalar","kaṇakkāy vakaiyiṉ varuntiyeṉ","neñcupuṇ ṇuṟṟa viḻumat tāṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"கழார்க் கீரனெயிற்றியார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kaḻārk Kīraṉeyiṟṟiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 21, veṇṭaḷai 7, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பழமழை","tr":"paḻamaḻai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பழ","tr":"paḻa"},{"kind":"nirai","text":"மழை","tr":"maḻai"}]},{"text":"பொழிந்தெனப்","tr":"poḻinteṉap","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பொழிந்","tr":"poḻin"},{"kind":"nirai","text":"தெனப்","tr":"teṉap"}]},{"text":"பதனழிந்","tr":"pataṉaḻin","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பத","tr":"pata"},{"kind":"nirai","text":"னழிந்","tr":"ṉaḻin"}]},{"text":"துருகிய","tr":"turukiya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"துரு","tr":"turu"},{"kind":"nirai","text":"கிய","tr":"kiya"}]}],[{"text":"சிதட்டுக்கா","tr":"citaṭṭukkā","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"சிதட்","tr":"citaṭ"},{"kind":"nēr","text":"டுக்","tr":"ṭuk"},{"kind":"nēr","text":"கா","tr":"kā"}]},{"text":"யெண்ணின்","tr":"yeṇṇiṉ","foot":"tēmā","acai":[{