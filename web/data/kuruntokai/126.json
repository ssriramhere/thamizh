{"text":"kuruntokai","n":126,"lines":["இளமை பாரார் வளநசைஇச் சென்றோர்","இவணும் வாரார் எவண ரோவெனப்","பெயல்புறந் தந்த பூங்கொடி முல்லைத்","தொகுமுகை இலங்கெயி றாக","நகுமே தோழி நறுந்தண் காரே"],"tr":["iḷamai pārār vaḷanacaiic ceṉṟōr","ivaṇum vārār evaṇa rōveṉap","peyalpuṟan tanta pūṅkoṭi mullait","tokumukai ilaṅkeyi ṟāka","nakumē tōḻi naṟuntaṇ kārē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"ஒக்கூர் மாசாத்தியார்","speaker_en":"the heroine (talaivi)","poet_tr":"Okkūr Mācāttiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 10, āciriyattaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இளமை","tr":"iḷamai","foot":"puḷimā","acai":[{"kind":"nirai","text":"இள","tr":"iḷa"},{"kind":"nēr","text":"மை","tr":"mai"}]},{"text":"பாரார்","tr":"pārār","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"ரார்","tr":"rār"}]},{"text":"வளநசைஇச்","tr":"vaḷanacaiic","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"வள","tr":"vaḷa"},{"kind":"nirai","text":"நசை","tr":"nacai"},{"kind":"nēr","text":"இச்","tr":"ic"}]},{"text":"சென்றோர்","tr":"ceṉṟōr","foot":"tēmā","acai":[{"kind":"nēr","text":"சென்","tr":"ceṉ"},{"kind":"nēr","text":"றோர்","tr":"ṟōr"}]}],[{"text":"இவணும்","tr":"ivaṇum","foot":"puḷimā","acai":[{"kind":"nirai","text":"இவ","tr":"iva"},{"kind":"nēr","text":"ணும்","tr":"ṇum"}]},{"text":"வாரார்","tr":"vārār","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ரார்","tr":"rār"}]},{"text":"எவண","tr":"evaṇa","foot":"puḷimā","acai":[{"kind":"nirai","text":"எவ","tr":"eva"},{"kind":"nēr","text":"ண","tr":"ṇa"}]},{"text":"ரோவெனப்","tr":"rōveṉap","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ரோ","tr":"rō"},{"kind":"nirai","text"