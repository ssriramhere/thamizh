{"text":"kuruntokai","n":126,"lines":["இளமை பாரார் வளநசைஇச் சென்றோர்","இவணும் வாரார் எவண ரோவெனப்","பெயல்புறந் தந்த பூங்கொடி முல்லைத்","தொகுமுகை இலங்கெயி றாக","நகுமே தோழி நறுந்தண் காரே"],"tr":["iḷamai pārār vaḷanacaiic ceṉṟōr","ivaṇum vārār evaṇa rōveṉap","peyalpuṟan tanta pūṅkoṭi mullait","tokumukai ilaṅkeyi ṟāka","nakumē tōḻi naṟuntaṇ kārē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"ஒக்கூர் மாசாத்தியார்","speaker_en":"the heroine (talaivi)","poet_tr":"Okkūr Mācāttiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 10, āciriyattaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இளமை","tr":"iḷamai","foot":"puḷimā","acai":[{"kind":"nirai","text":"இள","tr":"iḷa"},{"kind":"nēr","text":"மை","tr":"mai"}]},{"text":"பாரார்","tr":"pārār","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"ரார்","tr":"rār"}]},{"text":"வளநசைஇச்","tr":"vaḷanacaiic","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"வள","tr":"vaḷa"},{"kind":"nirai","text":"நசை","tr":"nacai"},{"kind":"nēr","text":"இச்","tr":"ic"}]},{"text":"சென்றோர்","tr":"ceṉṟōr","foot":"tēmā","acai":[{"kind":"nēr","text":"சென்","tr":"ceṉ"},{"kind":"nēr","text":"றோர்","tr":"ṟōr"}]}],[{"text":"இவணும்","tr":"ivaṇum","foot":"puḷimā","acai":[{"kind":"nirai","text":"இவ","tr":"iva"},{"kind":"nēr","text":"ணும்","tr":"ṇum"}]},{"text":"வாரார்","tr":"vārār","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ரார்","tr":"rār"}]},{"text":"எவண","tr":"evaṇa","foot":"puḷimā","acai":[{"kind":"nirai","text":"எவ","tr":"eva"},{"kind":"nēr","text":"ண","tr":"ṇa"}]},{"text":"ரோவெனப்","tr":"rōveṉap","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ரோ","tr":"rō"},{"kind":"nirai","text":"வெனப்","tr":"veṉap"}]}],[{"text":"பெயல்புறந்","tr":"peyalpuṟan","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெயல்","tr":"peyal"},{"kind":"nirai","text":"புறந்","tr":"puṟan"}]},{"text":"தந்த","tr":"tanta","foot":"tēmā","acai":[{"kind":"nēr","text":"தந்","tr":"tan"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"பூங்கொடி","tr":"pūṅkoṭi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பூங்","tr":"pūṅ"},{"kind":"nirai","text":"கொடி","tr":"koṭi"}]},{"text":"முல்லைத்","tr":"mullait","foot":"tēmā","acai":[{"kind":"nēr","text":"முல்","tr":"mul"},{"kind":"nēr","text":"லைத்","tr":"lait"}]}],[{"text":"தொகுமுகை","tr":"tokumukai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தொகு","tr":"toku"},{"kind":"nirai","text":"முகை","tr":"mukai"}]},{"text":"இலங்கெயி","tr":"ilaṅkeyi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இலங்","tr":"ilaṅ"},{"kind":"nirai","text":"கெயி","tr":"keyi"}]},{"text":"றாக","tr":"ṟāka","foot":"tēmā","acai":[{"kind":"nēr","text":"றா","tr":"ṟā"},{"kind":"nēr","text":"க","tr":"ka"}]}],[{"text":"நகுமே","tr":"nakumē","foot":"puḷimā","acai":[{"kind":"nirai","text":"நகு","tr":"naku"},{"kind":"nēr","text":"மே","tr":"mē"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"நறுந்தண்","tr":"naṟuntaṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"நறுந்","tr":"naṟun"},{"kind":"nēr","text":"தண்","tr":"taṇ"}]},{"text":"காரே","tr":"kārē","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"ரே","tr":"rē"}]}]]},"ai":{"lines":[{"words":[{"surface":"இளமை","parts":[{"text":"இளமை","lemma":"இளமை","gloss":"youth"}],"gloss":"youth"},{"surface":"பாரார்","parts":[{"text":"பாரார்","lemma":"பார்","gloss":"look at or consider (negative third person plural)"}],"gloss":"not considering"},{"surface":"வள","parts":[{"text":"வள","lemma":"வள","gloss":"wealth"}],"gloss":"wealth","split_unverified":true},{"surface":"நசைஇ","parts":[{"text":"நசைஇ","lemma":"நசை","gloss":"desiring (with measure-lengthening)"}],"gloss":"desiring"},{"surface":"சென்றோர்","parts":[{"text":"சென்றோர்","lemma":"செல்","gloss":"those who went"}],"gloss":"he who went"}]},{"words":[{"surface":"இவணும்","parts":[{"text":"இவண்","lemma":"இவண்","gloss":"here"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"even here"},{"surface":"வாரார்","parts":[{"text":"வாரார்","lemma":"வரு","gloss":"come (negative third person plural)"}],"gloss":"he has not returned"},{"surface":"எவணரோ","parts":[{"text":"எவண்","lemma":"எவண்","gloss":"where"},{"text":"அர்","lemma":"அர்","gloss":"he (honorific)"},{"text":"ஓ","lemma":"ஓ","gloss":"interrogative particle"}],"gloss":"where is he?"},{"surface":"என","parts":[{"text":"என","lemma":"என","gloss":"saying"}],"gloss":"saying"}]},{"words":[{"surface":"பெயல்","parts":[{"text":"பெயல்","lemma":"பெயல்","gloss":"rain"}],"gloss":"rain"},{"surface":"புறந்தந்த","parts":[{"text":"புறந்தந்த","lemma":"புறந்தரு","gloss":"nurtured"}],"gloss":"nurtured"},{"surface":"பூங்கொடி","parts":[{"text":"பூங்கொடி","lemma":"பூங்கொடி","gloss":"flowering creeper"}],"gloss":"flowering creeper","split_unverified":true},{"surface":"முல்லை","parts":[{"text":"முல்லை","lemma":"முல்லை","gloss":"mullai jasmine"}],"gloss":"mullai jasmine"}]},{"words":[{"surface":"தொகு","parts":[{"text":"தொகு","lemma":"தொகு","gloss":"clustered"}],"gloss":"clustered"},{"surface":"முகை","parts":[{"text":"முகை","lemma":"முகை","gloss":"bud"}],"gloss":"buds"},{"surface":"இலங்கு","parts":[{"text":"இலங்கு","lemma":"இலங்கு","gloss":"shining"}],"gloss":"shining"},{"surface":"எயிறு","parts":[{"text":"எயிறு","lemma":"எயிறு","gloss":"teeth"}],"gloss":"teeth"},{"surface":"ஆக","parts":[{"text":"ஆக","lemma":"ஆ","gloss":"to become"}],"gloss":"as"}]},{"words":[{"surface":"நகுமே","parts":[{"text":"நகு","lemma":"நகு","gloss":"laugh or smile"},{"text":"மே","lemma":"மே","gloss":"emphatic particle"}],"gloss":"smiles indeed"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"தோழி","gloss":"friend"}],"gloss":"O friend"},{"surface":"நறுந்தண்","parts":[{"text":"நறும்","lemma":"நறுமை","gloss":"fragrant"},{"text":"தண்","lemma":"தண்மை","gloss":"cool"}],"gloss":"fragrant and cool"},{"surface":"காரே","parts":[{"text":"கார்","lemma":"கார்","gloss":"rainy season"},{"text":"ஏ","lemma":"ஏ","gloss":"emphatic particle"}],"gloss":"the rainy season"}]}],"literal":"Not considering youth, desiring wealth, he who went / even here has not returned, where is he? saying / nurtured by the rain, the flowering creeper mullai's / clustered buds as shining teeth, / smiles indeed, O friend, the fragrant cool rainy season!","translation":"Not considering our youth, desiring wealth, he departed. He has not returned here yet; where could he be? Mocking my plight, O friend, the fragrant, cool rainy season smiles at me, showing the clustered buds of the rain-nurtured mullai creeper as its shining teeth.","modern":"நம் இளமையைப் பொருட்படுத்தாமல், செல்வத்தை விரும்பிச் சென்றவர் இன்னும் இங்கு வரவில்லை; அவர் எங்கே இருக்கிறாரோ? தோழியே! மழையால் வளர்க்கப்பட்ட பூங்கொடியான முல்லையின் திரண்ட மொட்டுகளைத் தன் விளங்கும் பற்களாகக் கொண்டு, இந்த நறிய குளிர்ந்த கார்காலம் நம்மைப் பார்த்துப் புன்னகைக்கிறது.","explanation":"The heroine is speaking to her close friend in distress. The hero had promised to return before the onset of the rainy season, but he has not yet arrived. The rainy season has now commenced, bringing fresh showers that nurture the mullai jasmine creepers. The white, clustered buds of the jasmine look like a row of shining teeth. To the lonely heroine, this sight feels as if the cool, fragrant rainy season is mocking her waiting state with a bright, white smile. This poem belongs to the Mullai tiṇai, where the forest landscape, the rainy season, and the mullai flower represent the theme of patient waiting.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.5],[0.5,0.8],[0.8,1.5],[1.5,2.1],[2.1,2.7],[2.7,3.0],[3.0,3.25],[3.57,3.86],[3.93,4.0],[4.0,5.3],[5.3,5.6],[5.6,5.9],[5.9,6.7],[6.7,7.12],[7.12,7.2],[7.2,8.7],[8.7,8.8],[8.8,9.2],[9.2,9.7]],"female":[[0.0,0.6],[0.6,0.9],[0.9,1.6],[1.6,2.3],[2.3,3.0],[3.0,3.4],[3.4,3.47],[3.53,4.12],[4.12,5.4],[5.4,5.6],[5.6,6.0],[6.0,6.3],[6.3,6.3],[6.3,6.3],[6.3,6.3],[6.3,9.2],[9.2,9.3],[9.3,9.7],[9.7,10.4]]}}