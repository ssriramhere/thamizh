{"text":"kuruntokai","n":390,"lines":["எல்லும் எல்லின்று பாடுங் கேளாய்","செல்லா தீமோ சிறுபிடி துணையே","வேற்றுமுனை வெம்மையிற் சாத்துவந் திறுத்தென","வளையணி நெடுவேல் ஏந்தி","மிளைவந்து பெயரும் தண்ணுமைக் குரலே"],"tr":["ellum elliṉṟu pāṭuṅ kēḷāy","cellā tīmō ciṟupiṭi tuṇaiyē","vēṟṟumuṉai vemmaiyiṟ cāttuvan tiṟutteṉa","vaḷaiyaṇi neṭuvēl ēnti","miḷaivantu peyarum taṇṇumaik kuralē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"கண்டோர் கூற்று","poet_ta":"உறையூர் முதுகொற்றனார்","speaker_en":"onlookers (kaṇṭōr)","poet_tr":"Uṟaiyūr Mutukoṟṟaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 15, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 5, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"எல்லும்","tr":"ellum","foot":"tēmā","acai":[{"kind":"nēr","text":"எல்","tr":"el"},{"kind":"nēr","text":"லும்","tr":"lum"}]},{"text":"எல்லின்று","tr":"elliṉṟu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"எல்","tr":"el"},{"kind":"nēr","text":"லின்","tr":"liṉ"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"பாடுங்","tr":"pāṭuṅ","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"டுங்","tr":"ṭuṅ"}]},{"text":"கேளாய்","tr":"kēḷāy","foot":"tēmā","acai":[{"kind":"nēr","text":"கே","tr":"kē"},{"kind":"nēr","text":"ளாய்","tr":"ḷāy"}]}],[{"text":"செல்லா","tr":"cellā","foot":"tēmā","acai":[{"kind":"nēr","text":"செல்","tr":"cel"},{"kind":"nēr","text":"லா","tr":"lā"}]},{"text":"தீமோ","tr":"tīmō","foot":"tēmā","acai":[{"kind":"nēr","text":"தீ","tr":"tī"},{"kind":"nēr","text":"மோ","tr":"mō"}]},{"text":"சிறுபிடி","tr":"ciṟupiṭi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nirai","text":"பிடி","tr":"piṭi"}]},{"text":"துணையே","tr":"tuṇaiyē","foot":"puḷimā","acai":[{"kind":"nirai","text":"த