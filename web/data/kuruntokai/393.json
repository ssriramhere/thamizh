{"text":"kuruntokai","n":393,"lines":["மயங்குமலர்க் கோதை குழைய மகிழ்நன்","முயங்கிய நாடவச் சிலவே அலரே","கூகைக் கோழி வாகைப் பறந்தலைப்","பசும்பூண் பாண்டியன் வினைவ லதிகன்","களிறொடு பட்ட ஞான்றை","ஒளிறுவாட் கொங்கர் ஆர்ப்பினும் பெரிதே"],"tr":["mayaṅkumalark kōtai kuḻaiya makiḻnaṉ","muyaṅkiya nāṭavac cilavē alarē","kūkaik kōḻi vākaip paṟantalaip","pacumpūṇ pāṇṭiyaṉ viṉaiva latikaṉ","kaḷiṟoṭu paṭṭa ñāṉṟai","oḷiṟuvāṭ koṅkar ārppiṉum peritē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தோழி கூற்று","poet_ta":"பரணர்","speaker_en":"her friend (tōḻi)","poet_tr":"Paraṇar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 12, āciriyattaḷai 10"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மயங்குமலர்க்","tr":"mayaṅkumalark","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"மயங்","tr":"mayaṅ"},{"kind":"nirai","text":"கும","tr":"kuma"},{"kind":"nēr","text":"லர்க்","tr":"lark"}]},{"text":"கோதை","tr":"kōtai","foot":"tēmā","acai":[{"kind":"nēr","text":"கோ","tr":"kō"},{"kind":"nēr","text":"தை","tr":"tai"}]},{"text":"குழைய","tr":"kuḻaiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"குழை","tr":"kuḻai"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"மகிழ்நன்","tr":"makiḻnaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மகிழ்","tr":"makiḻ"},{"kind":"nēr","text":"நன்","tr":"naṉ"}]}],[{"text":"முயங்கிய","tr":"muyaṅkiya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"முயங்","tr":"muyaṅ"},{"kind":"nirai","text":"கிய","tr":"kiya"}]},{"text":"நாடவச்","tr":"nāṭavac","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nirai","text":"டவச்","tr":"ṭavac"}]},{"text":"சிலவே","tr":"cilavē","foot":"puḷimā","acai":[{"kind":"nirai","text":"சில","tr":"cila"},{"kind":"nēr","text":"வே","tr":"vē"}]},{"t