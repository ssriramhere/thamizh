{"text":"kuruntokai","n":132,"lines":["கவவுக் கடுங்குரையள் காமர் வனப்பினள்","குவவுமென் முலையள் கொடிக்கூந் தலளே","யாங்குமறந் தமைகோ யானே ஞாங்கர்க்","கடுஞ்சுரை நல்லா னடுங்குதலைக் குழவி","தாய்காண் விருப்பி னன்ன","சாஅய்நோக் கினளே மாஅ யோளே"],"tr":["kavavuk kaṭuṅkuraiyaḷ kāmar vaṉappiṉaḷ","kuvavumeṉ mulaiyaḷ koṭikkūn talaḷē","yāṅkumaṟan tamaikō yāṉē ñāṅkark","kaṭuñcurai nallā ṉaṭuṅkutalaik kuḻavi","tāykāṇ viruppi ṉaṉṉa","cāaynōk kiṉaḷē māa yōḷē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"சிறைக்குடியாந்தையார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Ciṟaikkuṭiyāntaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 9, kalittaḷai 3"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கவவுக்","tr":"kavavuk","foot":"puḷimā","acai":[{"kind":"nirai","text":"கவ","tr":"kava"},{"kind":"nēr","text":"வுக்","tr":"vuk"}]},{"text":"கடுங்குரையள்","tr":"kaṭuṅkuraiyaḷ","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"கடுங்","tr":"kaṭuṅ"},{"kind":"nirai","text":"குரை","tr":"kurai"},{"kind":"nēr","text":"யள்","tr":"yaḷ"}]},{"text":"காமர்","tr":"kāmar","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"மர்","tr":"mar"}]},{"text":"வனப்பினள்","tr":"vaṉappiṉaḷ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வனப்","tr":"vaṉap"},{"kind":"nirai","text":"பினள்","tr":"piṉaḷ"}]}],[{"text":"குவவுமென்","tr":"kuvavumeṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குவ","tr":"kuva"},{"kind":"nirai","text":"வுமென்","tr":"vumeṉ"}]},{"text":"முலையள்","tr":"mulaiyaḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"முலை","tr":"mulai"},{"kind":"nēr","text":"யள்","tr":"yaḷ"}]},{"text":"கொடிக்கூந்","tr":"koṭikkūn","foot":"puḷimā","acai":[{"k