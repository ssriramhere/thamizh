{"text":"kuruntokai","n":40,"lines":["யாயும் ஞாயும் யாரா கியரோ","எந்தையும் நுந்தையும் எம்முறைக் கேளிர்","யானும் நீயும் எவ்வழி யறிதும்","செம்புலப் பெயனீர் போல","அன்புடை நெஞ்சம் தாங்கலந் தனவே"],"tr":["yāyum ñāyum yārā kiyarō","entaiyum nuntaiyum emmuṟaik kēḷir","yāṉum nīyum evvaḻi yaṟitum","cempulap peyaṉīr pōla","aṉpuṭai neñcam tāṅkalan taṉavē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"செம்புலப் பெயனீரார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Cempulap Peyaṉīrār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 5"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"யாயும்","tr":"yāyum","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"ஞாயும்","tr":"ñāyum","foot":"tēmā","acai":[{"kind":"nēr","text":"ஞா","tr":"ñā"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"யாரா","tr":"yārā","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"ரா","tr":"rā"}]},{"text":"கியரோ","tr":"kiyarō","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிய","tr":"kiya"},{"kind":"nēr","text":"ரோ","tr":"rō"}]}],[{"text":"எந்தையும்","tr":"entaiyum","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"எந்","tr":"en"},{"kind":"nēr","text":"தை","tr":"tai"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"நுந்தையும்","tr":"nuntaiyum","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"நுந்","tr":"nun"},{"kind":"nēr","text":"தை","tr":"tai"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"எம்முறைக்","tr":"emmuṟaik","foot":"kūviḷam","acai":[{"kind":"nēr","text":"எம்","tr":"em"},{"kind":"nirai","text":"முறைக்","tr":"muṟaik"}]},{"text":"கேளிர்","tr":"kēḷir","foot":"tēmā","acai":[{"kind":"nēr","t