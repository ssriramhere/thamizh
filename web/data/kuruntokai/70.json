{"text":"kuruntokai","n":70,"lines":["ஒடுங்கீர் ஓதி ஒண்ணுதற் குறுமகள்","நறுந்தண் ணீரள் ஆரணங் கினளே","இனையள் என்றவட் புனையள வறியேன்","சிலமெல் லியவே கிளவி","அணைமெல் லியள்யான் முயங்குங் காலே"],"tr":["oṭuṅkīr ōti oṇṇutaṟ kuṟumakaḷ","naṟuntaṇ ṇīraḷ āraṇaṅ kiṉaḷē","iṉaiyaḷ eṉṟavaṭ puṉaiyaḷa vaṟiyēṉ","cilamel liyavē kiḷavi","aṇaimel liyaḷyāṉ muyaṅkuṅ kālē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"ஓரம்போகியார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Ōrampōkiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 7"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஒடுங்கீர்","tr":"oṭuṅkīr","foot":"puḷimā","acai":[{"kind":"nirai","text":"ஒடுங்","tr":"oṭuṅ"},{"kind":"nēr","text":"கீர்","tr":"kīr"}]},{"text":"ஓதி","tr":"ōti","foot":"tēmā","acai":[{"kind":"nēr","text":"ஓ","tr":"ō"},{"kind":"nēr","text":"தி","tr":"ti"}]},{"text":"ஒண்ணுதற்","tr":"oṇṇutaṟ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஒண்","tr":"oṇ"},{"kind":"nirai","text":"ணுதற்","tr":"ṇutaṟ"}]},{"text":"குறுமகள்","tr":"kuṟumakaḷ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குறு","tr":"kuṟu"},{"kind":"nirai","text":"மகள்","tr":"makaḷ"}]}],[{"text":"நறுந்தண்","tr":"naṟuntaṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"நறுந்","tr":"naṟun"},{"kind":"nēr","text":"தண்","tr":"taṇ"}]},{"text":"ணீரள்","tr":"ṇīraḷ","foot":"tēmā","acai":[{"kind":"nēr","text":"ணீ","tr":"ṇī"},{"kind":"nēr","text":"ரள்","tr":"raḷ"}]},{"text":"ஆரணங்","tr":"āraṇaṅ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nirai","text":"ரணங்","tr":"raṇaṅ"}]},{"text":"கினளே","tr":"kiṉaḷē","foot":"puḷimā","acai":[{"kind":"nirai","text":"கின","tr":"kiṉa"},{"kind":"nēr","text":"ளே","tr":"ḷē"}]}],[{"text":"இன