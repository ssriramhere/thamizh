:"forehead"}],"gloss":"forehead"},{"surface":"குறுமகள்","parts":[{"text":"குறு","lemma":"குறு","gloss":"young"},{"text":"மகள்","lemma":"மகள்","gloss":"woman"}],"gloss":"young woman"}]},{"words":[{"surface":"நறும்","parts":[{"text":"நறும்","lemma":"நறுமை","gloss":"fragrant"}],"gloss":"fragrant"},{"surface":"தண்","parts":[{"text":"தண்","lemma":"தண்மை","gloss":"cool"}],"gloss":"cool"},{"surface":"நீரள்","parts":[{"text":"நீர்","lemma":"நீர்","gloss":"nature"},{"text":"அள்","lemma":"அள்","gloss":"she who has"}],"gloss":"she of the nature"},{"surface":"ஆர்","parts":[{"text":"ஆர்","lemma":"ஆர்","gloss":"rare"}],"gloss":"rare"},{"surface":"அணங்கினளே","parts":[{"text":"அணங்கினள்","lemma":"அணங்கு","gloss":"she who torments"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"she has tormented indeed"}]},{"words":[{"surface":"இனையள்","parts":[{"text":"இனையள்","lemma":"இனையள்","gloss":"she of this nature"}],"gloss":"she is of this nature"},{"surface":"என்று","parts":[{"text":"என்று","lemma":"என்","gloss":"saying"}],"gloss":"saying"},{"surface":"அவள்","parts":[{"text":"அவள்","lemma":"அவள்","gloss":"she"}],"gloss":"her"},{"surface":"புனை","parts":[{"text":"புனை","lemma":"புனை","gloss":"describe"}],"gloss":"to describe"},{"surface":"அளவு","parts":[{"text":"அளவு","lemma":"அளவு","gloss":"limit"}],"gloss":"limit"},{"surface":"அறியேன்","parts":[{"text":"அறி","lemma":"அறி","gloss":"know"},{"text":"ஏன்","lemma":"ஏன்","gloss":"I (negative)"}],"gloss":"I do not know"}]},{"words":[{"surface":"சில","parts":[{"text":"சில","lemma":"சில","gloss":"few"}],"gloss":"few"},{"surface":"மெல்லியவே","parts":[{"text":"மெல்லிய","lemma":"மெல்லிது","gloss":"soft things"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"are very soft"},{"surface":"கிளவி","parts":[{"text":"கிளவி","lemma":"கிளவி","gloss":"words"}],"gloss":"words"}]},{"words":[{"surface":"அணை","parts":[{"text":"அணை","lemma":"அணை","gloss":"mattress"}],"gloss":"mattress"},{"surface":"மெல்லியள்","parts":[{"text":"மெல்லியள்","lemma":"மெல்லியள்","gloss":"soft woman"}],"gloss":"she is soft"},{"surface":"யான்","parts":[{"text":"யான்","lemma":"யான்","gloss":"I"}],"gloss":"I"},{"surface":"முயங்கும்","parts":[{"text":"முயங்கும்","lemma":"முயங்கு","gloss":"embracing"}],"gloss":"embracing"},{"surface":"காலே","parts":[{"text":"கால்","lemma":"கால்","gloss":"time"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"at the time"}]}],"literal":"Dense moist hair bright forehead young woman / fragrant cool she of the nature of water rare she has tormented indeed / \"she is of this nature\" saying her to describe limit I do not know / few are very soft words / mattress soft she I embracing at the time","translation":"The young woman with dense, moist hair and a bright forehead has the nature of fragrant, cool water, and she has tormented me like a goddess. I do not know how to describe her, saying, 'She is like this.' Her words are few and very soft. And when I embrace her, she is softer than a mattress.","modern":"அடர்ந்த ஈரமான கூந்தலையும் ஒளிரும் நெற்றியையும் உடைய இளம்பெண், நறுமணமிக்க குளிர்ந்த நீரின் தன்மையைக் கொண்டவள்; அவள் எனக்கு அணங்கு போன்றவள் ஆயினாள். 'இவள் இப்படிப்பட்டவள்' என்று அவளைப் புகழ்ந்துரைக்கும் எல்லையை நான் அறியேன். அவளுடைய சொற்கள் சிலவே, அவை மிகவும் மென்மையானவை. நான் அவளைத் தழுவும்போது, அவள் மெத்தையை விடவும் மென்மையானவள் ஆவாள்.","explanation":"The speaker is the hero, expressing his deep love and admiration for the heroine. He describes her physical and behavioral qualities, noting that her hair is dense and moist, and her forehead is bright. He compares her nature to fragrant, cool water, which is both refreshing and tormenting to his heart like a celestial deity. He confesses that he cannot find the words to fully describe her beauty and nature. Her speech is sparse and gentle, and when he embraces her, her body feels softer than a soft mattress. This poem belongs to the Kuriñci tiṇai, representing the union of lovers and the intense, intimate feelings of the hero.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,0.83],[0.83,1.21],[1.21,1.59],[1.59,1.97],[1.97,2.2],[2.2,2.55],[2.55,3.6],[3.6,4.6],[4.6,5.0],[5.0,5.42],[5.42,5.85],[5.85,6.27],[6.27,6.59],[6.59,6.91],[6.91,7.33],[7.33,7.96],[8.14,8.33],[8.33,8.63]],"female":[[0.0,0.64],[0.64,0.9],[0.9,1.6],[1.6,1.8],[1.8,3.37],[3.37,3.69],[3.69,4.0],[4.0,4.16],[4.32,4.98],[4.98,5.8],[5.8,5.97],[5.97,6.65],[6.65,7.32],[7.32,7.83],[7.83,8.33],[8.33,9.01],[9.01,9.86],[9.86,10.7],[10.7,11.0]]},"sync":[[["ஒடுங்கு","dense"],["ஈர்","moist"]],[["ஓதி","hair"]],[["ஒள்","bright"],["நுதல்","forehead"]],[["குறுமகள்","young woman"]],[["நறும்","fragrant"],["தண்","cool"]],[["நீரள்","she of the nature"]],[["ஆர்","rare"],["அணங்கினளே","she has tormented indeed"]],[["அணங்கினளே","she has tormented indeed"]],[["இனையள்","she is of this nature"]],[["என்று","saying"],["அவள்","her"]],[["புனை","to describe"],["அளவு","limit"]],[["அளவு","limit"],["அறியேன்","I do not know"]],[["சில","few"],["மெல்லியவே","are very soft"]],[["மெல்லியவே","are very soft"]],[["கிளவி","words"]],[["அணை","mattress"],["மெல்லியள்","she is soft"]],[["மெல்லியள்","she is soft"],["யான்","I"]],[["முயங்கும்","embracing"]],[["காலே","at the time"]]]}