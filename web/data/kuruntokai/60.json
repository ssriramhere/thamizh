{"text":"kuruntokai","n":60,"lines":["குறுந்தாட் கூதளி யாடிய நெடுவரைப்","பெருந்தேன் கண்ட இருங்கால் முடவன்","உட்கைச் சிறுகுடை கோலிக் கீழிருந்து","சுட்டுபு நக்கி யாங்குக் காதலர்","நல்கார் நயவா ராயினும்","பல்காற் காண்டலும் உள்ளத்துக் கினிதே"],"tr":["kuṟuntāṭ kūtaḷi yāṭiya neṭuvaraip","peruntēṉ kaṇṭa iruṅkāl muṭavaṉ","uṭkaic ciṟukuṭai kōlik kīḻiruntu","cuṭṭupu nakki yāṅkuk kātalar","nalkār nayavā rāyiṉum","palkāṟ kāṇṭalum uḷḷattuk kiṉitē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"பரணர்","speaker_en":"the heroine (talaivi)","poet_tr":"Paraṇar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 11, āciriyattaḷai 10, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"குறுந்தாட்","tr":"kuṟuntāṭ","foot":"puḷimā","acai":[{"kind":"nirai","text":"குறுந்","tr":"kuṟun"},{"kind":"nēr","text":"தாட்","tr":"tāṭ"}]},{"text":"கூதளி","tr":"kūtaḷi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கூ","tr":"kū"},{"kind":"nirai","text":"தளி","tr":"taḷi"}]},{"text":"யாடிய","tr":"yāṭiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nirai","text":"டிய","tr":"ṭiya"}]},{"text":"நெடுவரைப்","tr":"neṭuvaraip","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நெடு","tr":"neṭu"},{"kind":"nirai","text":"வரைப்","tr":"varaip"}]}],[{"text":"பெருந்தேன்","tr":"peruntēṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெருந்","tr":"perun"},{"kind":"nēr","text":"தேன்","tr":"tēṉ"}]},{"text":"கண்ட","tr":"kaṇṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"கண்","tr":"kaṇ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"இருங்கால்","tr":"iruṅkāl","foot":"puḷimā","acai":[{"kind":"nirai","text":"இருங்","tr":"iruṅ"},{"kind":"nēr","text":"கால்","tr":"kāl"}]},{"text":"முடவன்","tr