,"tr":"yatuvē","foot":"puḷimā","acai":[{"kind":"nirai","text":"யது","tr":"yatu"},{"kind":"nēr","text":"வே","tr":"vē"}]}]]},"ai":{"lines":[{"words":[{"surface":"நீ","parts":[{"text":"நீ","lemma":"நீ","gloss":"you"}],"gloss":"you"},{"surface":"உடம்படுதலின்","parts":[{"text":"உடம்படுதல்","lemma":"உடம்படுதல்","gloss":"agreeing"},{"text":"இன்","lemma":"இன்","gloss":"because of"}],"gloss":"because of agreeing"},{"surface":"யான்","parts":[{"text":"யான்","lemma":"யான்","gloss":"I"}],"gloss":"I"},{"surface":"தர","parts":[{"text":"தர","lemma":"தருதல்","gloss":"to bring"}],"gloss":"to bring"},{"surface":"வந்து","parts":[{"text":"வந்து","lemma":"வருதல்","gloss":"having come"}],"gloss":"having come"}]},{"words":[{"surface":"குறி","parts":[{"text":"குறி","lemma":"குறி","gloss":"trysting place"}],"gloss":"at the trysting place"},{"surface":"நின்றனனே","parts":[{"text":"நின்றனன்","lemma":"நிற்றல்","gloss":"he stood"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"he stood indeed"},{"surface":"குன்ற","parts":[{"text":"குன்ற","lemma":"குன்ற","gloss":"of the hills"}],"gloss":"of the hills","split_unverified":true},{"surface":"நாடன்","parts":[{"text":"நாடன்","lemma":"நாடன்","gloss":"lord of the land"}],"gloss":"the lord of the land"}]},{"words":[{"surface":"இன்றை","parts":[{"text":"இன்றை","lemma":"இன்று","gloss":"today"}],"gloss":"today's"},{"surface":"அளவை","parts":[{"text":"அளவை","lemma":"அளவை","gloss":"limit"}],"gloss":"limit"},{"surface":"சென்றைக்கு","parts":[{"text":"சென்றை","lemma":"சென்றை","gloss":"going"},{"text":"கு","lemma":"கு","gloss":"for"}],"gloss":"for going"},{"surface":"என்றி","parts":[{"text":"என்றி","lemma":"என்றல்","gloss":"you say"}],"gloss":"you say"}]},{"words":[{"surface":"கையும்","parts":[{"text":"கை","lemma":"கை","gloss":"hand"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and hands"},{"surface":"காலும்","parts":[{"text":"கால்","lemma":"கால்","gloss":"foot"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and feet"},{"surface":"ஓய்வன","parts":[{"text":"ஓய்வன","lemma":"ஓய்தல்","gloss":"they are exhausted"}],"gloss":"being exhausted"},{"surface":"அழுங்க","parts":[{"text":"அழுங்க","lemma":"அழுங்குதல்","gloss":"to suffer"}],"gloss":"to suffer"}]},{"words":[{"surface":"தீ","parts":[{"text":"தீ","lemma":"தீ","gloss":"fire"}],"gloss":"fire"},{"surface":"உறு","parts":[{"text":"உறு","lemma":"உறுதல்","gloss":"to touch"}],"gloss":"touched by"},{"surface":"தளிரின்","parts":[{"text":"தளிர்","lemma":"தளிர்","gloss":"sprout"},{"text":"இன்","lemma":"இன்","gloss":"like"}],"gloss":"like a sprout"},{"surface":"நடுங்கி","parts":[{"text":"நடுங்கி","lemma":"நடுங்குதல்","gloss":"having trembled"}],"gloss":"trembling"}]},{"words":[{"surface":"யாவதும்","parts":[{"text":"யாவதும்","lemma":"யாவதும்","gloss":"anything at all"}],"gloss":"anything at all"},{"surface":"இலை","parts":[{"text":"இலை","lemma":"இலை","gloss":"there is not"}],"gloss":"there is not"},{"surface":"யான்","parts":[{"text":"யான்","lemma":"யான்","gloss":"I"}],"gloss":"for me"},{"surface":"செயற்கு","parts":[{"text":"செயல்","lemma":"செயல்","gloss":"doing"},{"text":"கு","lemma":"கு","gloss":"for"}],"gloss":"to do"},{"surface":"உரியதுவே","parts":[{"text":"உரியது","lemma":"உரியது","gloss":"that which is appropriate"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"that which is possible"}]}],"literal":"Because you agreed, I brought him, and he came / and stood at the trysting place, the lord of the hills. / 'Let him go for today,' you say. / My hands and feet are exhausted and suffering, / trembling like a sprout touched by fire, / there is nothing at all for me to do.","translation":"Because you agreed, I brought him here, and the lord of the hills came and stood at the trysting place. But now you say, 'Let him go back for today.' My hands and feet are exhausted and distressed; trembling like a tender sprout touched by fire, there is absolutely nothing I can do.","modern":"நீ சம்மதித்ததால் நான் அழைத்து வர, குன்றுகளின் தலைவன் வந்து சந்திக்கும் இடத்தில் காத்து நிற்கிறான். ஆனால் நீயோ, 'இன்றைக்குப் போதும், அவர் போகட்டும்' என்று சொல்கிறாய். என் கைகளும் கால்களும் சோர்ந்து வருந்த, நெருப்புப் பட்ட தளிரைப் போல நடுங்கி, நான் செய்வதற்கு என்று இனி ஒன்றுமே இல்லை.","explanation":"The friend (tōḻi) is speaking to the heroine (talaivi) in this Pālai (wasteland/separation) poem. The friend had arranged a secret meeting (tryst) with the hero after getting the heroine's consent. However, when the hero arrives and waits at the designated spot, the heroine hesitates or refuses to meet him, telling the friend to send him away for the day. The friend expresses her deep distress and helplessness at this sudden change of mind. She describes her physical state as trembling like a delicate sprout caught in fire, showing how painful it is for her to turn away the waiting lover. The key words are 'குறி' (trysting place), 'சென்றைக்கு' (for going), and 'தீயுறு தளிர்' (sprout touched by fire).","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.64],[0.64,1.2],[1.2,1.7],[1.7,2.0],[2.0,2.57],[2.57,3.0],[3.0,3.6],[3.6,3.9],[3.9,4.73],[4.73,4.9],[4.9,5.5],[5.53,5.7],[5.7,6.8],[6.8,7.2],[7.2,7.47],[7.6,8.29],[8.29,8.7],[8.82,9.4],[9.4,9.8],[9.8,10.5],[10.5,10.9],[10.9,11.29],[11.48,11.8]],"female":[[0.0,0.8],[0.8,1.2],[1.2,1.64],[1.7,2.0],[2.0,2.96],[2.96,3.2],[3.2,3.7],[3.7,4.0],[4.0,4.92],[4.92,5.1],[5.1,5.9],[5.95,6.2],[6.2,7.2],[7.2,7.6],[7.75,8.0],[8.0,8.48],[8.48,8.78],[8.78,9.16],[9.16,9.55],[9.55,9.94],[9.94,12.1],[12.1,12.49],[12.68,13.0]]},"sync":[[["நீ","you"],["உடம்படுதலின்","because of agreeing"]],[["உடம்படுதலின்","because of agreeing"]],[["யான்","I"],["தர","to bring"]],[["வந்து","having come"]],[["குறி","at the trysting place"],["நின்றனனே","he stood indeed"]],[["நின்றனனே","he stood indeed"]],[["குன்ற","of the hills"]],[["நாடன்","the lord of the land"]],[["இன்றை","today's"]],[["அளவை","limit"]],[["சென்றைக்கு","for going"]],[["சென்றைக்கு","for going"],["என்றி","you say"]],[["கையும்","and hands"]],[["காலும்","and feet"]],[["ஓய்வன","being exhausted"]],[["அழுங்க","to suffer"]],[["தீ","fire"],["உறு","touched by"]],[["தளிரின்","like a sprout"]],[["நடுங்கி","trembling"]],[["யாவதும்","anything at all"]],[["இலை","there is not"],["யான்","for me"]],[["செயற்கு","to do"],["உரியதுவே","that which is possible"]],[["உரியதுவே","that which is possible"]]]}