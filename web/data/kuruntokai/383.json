{"text":"kuruntokai","n":383,"lines":["நீயுடம் படுதலின் யான்தர வந்து","குறிநின் றனனே குன்ற நாடன்","இன்றை யளவை சென்றைக் கென்றி","கையுங் காலும் ஓய்வன அழுங்கத்","தீயுறு தளிரின் நடுங்கி","யாவதும் இலையான் செயற்குரி யதுவே"],"tr":["nīyuṭam paṭutaliṉ yāṉtara vantu","kuṟiniṉ ṟaṉaṉē kuṉṟa nāṭaṉ","iṉṟai yaḷavai ceṉṟaik keṉṟi","kaiyuṅ kālum ōyvaṉa aḻuṅkat","tīyuṟu taḷiriṉ naṭuṅki","yāvatum ilaiyāṉ ceyaṟkuri yatuvē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"படுமரத்து மோசிகீரனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Paṭumarattu Mōcikīraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 7"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நீயுடம்","tr":"nīyuṭam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nirai","text":"யுடம்","tr":"yuṭam"}]},{"text":"படுதலின்","tr":"paṭutaliṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"படு","tr":"paṭu"},{"kind":"nirai","text":"தலின்","tr":"taliṉ"}]},{"text":"யான்தர","tr":"yāṉtara","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யான்","tr":"yāṉ"},{"kind":"nirai","text":"தர","tr":"tara"}]},{"text":"வந்து","tr":"vantu","foot":"tēmā","acai":[{"kind":"nēr","text":"வந்","tr":"van"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"குறிநின்","tr":"kuṟiniṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"குறி","tr":"kuṟi"},{"kind":"nēr","text":"நின்","tr":"niṉ"}]},{"text":"றனனே","tr":"ṟaṉaṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"றன","tr":"ṟaṉa"},{"kind":"nēr","text":"னே","tr":"ṉē"}]},{"text":"குன்ற","tr":"kuṉṟa","foot":"tēmā","acai":[{"kind":"nēr","text":"குன்","tr":"kuṉ"},{"kind":"nēr","text":"ற","tr":"ṟa"}]},{"text":"நாடன்","tr":"nāṭaṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"