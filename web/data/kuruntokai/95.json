{"text":"kuruntokai","n":95,"lines":["மால்வரை இழிதருந் தூவெள் அருவி","கல்முகைத் ததும்பும் பன்மலர்ச் சாரல்","சிறுகுடிக் குறவன் பெருந்தோட் குறுமகள்","நீரோ ரன்ன சாயல்","தீயோ ரன்னவென் உரனவித் தன்றே"],"tr":["mālvarai iḻitarun tūveḷ aruvi","kalmukait tatumpum paṉmalarc cāral","ciṟukuṭik kuṟavaṉ peruntōṭ kuṟumakaḷ","nīrō raṉṉa cāyal","tīyō raṉṉaveṉ uraṉavit taṉṟē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"கபிலர்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மால்வரை","tr":"mālvarai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மால்","tr":"māl"},{"kind":"nirai","text":"வரை","tr":"varai"}]},{"text":"இழிதருந்","tr":"iḻitarun","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இழி","tr":"iḻi"},{"kind":"nirai","text":"தருந்","tr":"tarun"}]},{"text":"தூவெள்","tr":"tūveḷ","foot":"tēmā","acai":[{"kind":"nēr","text":"தூ","tr":"tū"},{"kind":"nēr","text":"வெள்","tr":"veḷ"}]},{"text":"அருவி","tr":"aruvi","foot":"puḷimā","acai":[{"kind":"nirai","text":"அரு","tr":"aru"},{"kind":"nēr","text":"வி","tr":"vi"}]}],[{"text":"கல்முகைத்","tr":"kalmukait","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கல்","tr":"kal"},{"kind":"nirai","text":"முகைத்","tr":"mukait"}]},{"text":"ததும்பும்","tr":"tatumpum","foot":"puḷimā","acai":[{"kind":"nirai","text":"ததும்","tr":"tatum"},{"kind":"nēr","text":"பும்","tr":"pum"}]},{"text":"பன்மலர்ச்","tr":"paṉmalarc","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பன்","tr":"paṉ"},{"kind":"nirai","text":"மலர்ச்","tr":"malarc"}]},{"text":"சாரல்","tr":"cāral","foot":"tēmā","acai":[{"kind":"nēr","text":"சா","tr":"cā"},{"kind":"nēr","text":"ரல்","t