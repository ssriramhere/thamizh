{"text":"kuruntokai","n":303,"lines":["கழிதேர்ந் தசைஇய கருங்கால் வெண்குரு","கடைகரைத் தாழைக் குழீஇப் பெருங்கடல்","உடைதிரை ஒலியில் துஞ்சுந் துறைவ","தொன்னிலை நெகிழ்ந்த வளைய ளீங்குப்","பசந்தனள் மன்னென் தோழி யென்னொடும்","இன்னிணர்ப் புன்னையம் புகர்நிழற்","பொன்வரி அலவன் ஆட்டிய ஞான்றே"],"tr":["kaḻitērn tacaiiya karuṅkāl veṇkuru","kaṭaikarait tāḻaik kuḻīip peruṅkaṭal","uṭaitirai oliyil tuñcun tuṟaiva","toṉṉilai nekiḻnta vaḷaiya ḷīṅkup","pacantaṉaḷ maṉṉeṉ tōḻi yeṉṉoṭum","iṉṉiṇarp puṉṉaiyam pukarniḻaṟ","poṉvari alavaṉ āṭṭiya ñāṉṟē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தோழி கூற்று","poet_ta":"அம்மூவனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Ammūvaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 12, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கழிதேர்ந்","tr":"kaḻitērn","foot":"puḷimā","acai":[{"kind":"nirai","text":"கழி","tr":"kaḻi"},{"kind":"nēr","text":"தேர்ந்","tr":"tērn"}]},{"text":"தசைஇய","tr":"tacaiiya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தசை","tr":"tacai"},{"kind":"nirai","text":"இய","tr":"iya"}]},{"text":"கருங்கால்","tr":"karuṅkāl","foot":"puḷimā","acai":[{"kind":"nirai","text":"கருங்","tr":"karuṅ"},{"kind":"nēr","text":"கால்","tr":"kāl"}]},{"text":"வெண்குரு","tr":"veṇkuru","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வெண்","tr":"veṇ"},{"kind":"nirai","text":"குரு","tr":"kuru"}]}],[{"text":"கடைகரைத்","tr":"kaṭaikarait","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கடை","tr":"kaṭai"},{"kind":"nirai","text":"கரைத்","tr":"karait"}]},{"text":"தாழைக்","tr":"tāḻaik","foot":"tēmā","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"ழைக்","tr":"ḻaik"}]},{"text":"குழீஇப்","tr":"kuḻīip","foot":"puḷimā","acai":[{"k