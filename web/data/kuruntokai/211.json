{"text":"kuruntokai","n":211,"lines":["அஞ்சி லோதி யாய்வளை நெகிழ","நேர்ந்துநம் அருளார் நீத்தோர்க் கஞ்சல்","எஞ்சினம் வாழி தோழி யெஞ்சாத்","தீய்ந்த மராஅத் தோங்கல் வெஞ்சினை","வேனி லோரிணர் தேனோ டூதி","ஆராது பெயருந் தும்பி","நீரில் வைப்பிற் சுரனிறந் தோரே"],"tr":["añci lōti yāyvaḷai nekiḻa","nērntunam aruḷār nīttōrk kañcal","eñciṉam vāḻi tōḻi yeñcāt","tīynta marāat tōṅkal veñciṉai","vēṉi lōriṇar tēṉō ṭūti","ārātu peyarun tumpi","nīril vaippiṟ curaṉiṟan tōrē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"காவன்முல்லைப் பூதனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kāvaṉmullaip Pūtaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 19, veṇṭaḷai 6, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அஞ்சி","tr":"añci","foot":"tēmā","acai":[{"kind":"nēr","text":"அஞ்","tr":"añ"},{"kind":"nēr","text":"சி","tr":"ci"}]},{"text":"லோதி","tr":"lōti","foot":"tēmā","acai":[{"kind":"nēr","text":"லோ","tr":"lō"},{"kind":"nēr","text":"தி","tr":"ti"}]},{"text":"யாய்வளை","tr":"yāyvaḷai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யாய்","tr":"yāy"},{"kind":"nirai","text":"வளை","tr":"vaḷai"}]},{"text":"நெகிழ","tr":"nekiḻa","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெகி","tr":"neki"},{"kind":"nēr","text":"ழ","tr":"ḻa"}]}],[{"text":"நேர்ந்துநம்","tr":"nērntunam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நேர்ந்","tr":"nērn"},{"kind":"nirai","text":"துநம்","tr":"tunam"}]},{"text":"அருளார்","tr":"aruḷār","foot":"puḷimā","acai":[{"kind":"nirai","text":"அரு","tr":"aru"},{"kind":"nēr","text":"ளார்","tr":"ḷār"}]},{"text":"நீத்தோர்க்","tr":"nīttōrk","foot":"tēmā","acai":[{"kind":"nēr","text":"நீத்","tr":"nīt"},{"kind":"nēr","text":"தோர்க்","tr":"tōrk"}]},{"text":"கஞ்சல்","