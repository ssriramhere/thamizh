r","text":"ருந்","tr":"run"}]},{"text":"தும்பி","tr":"tumpi","foot":"tēmā","acai":[{"kind":"nēr","text":"தும்","tr":"tum"},{"kind":"nēr","text":"பி","tr":"pi"}]}],[{"text":"நீரில்","tr":"nīril","foot":"tēmā","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nēr","text":"ரில்","tr":"ril"}]},{"text":"வைப்பிற்","tr":"vaippiṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"வைப்","tr":"vaip"},{"kind":"nēr","text":"பிற்","tr":"piṟ"}]},{"text":"சுரனிறந்","tr":"curaṉiṟan","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சுர","tr":"cura"},{"kind":"nirai","text":"னிறந்","tr":"ṉiṟan"}]},{"text":"தோரே","tr":"tōrē","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ரே","tr":"rē"}]}]]},"ai":{"lines":[{"words":[{"surface":"அஞ்சில்","parts":[{"text":"அம்","lemma":"am","gloss":"beautiful"},{"text":"சில்","lemma":"cil","gloss":"fine/thin"}],"gloss":"beautiful and fine"},{"surface":"ஓதி","parts":[{"text":"ஓதி","lemma":"ōti","gloss":"hair"}],"gloss":"hair"},{"surface":"ஆய்வளை","parts":[{"text":"ஆய்","lemma":"āy","gloss":"select/beautiful"},{"text":"வளை","lemma":"vaḷai","gloss":"bangles"}],"gloss":"select bangles"},{"surface":"நெகிழ","parts":[{"text":"நெகிழ","lemma":"nekiḻa","gloss":"to slip/loosen"}],"gloss":"to slip"}]},{"words":[{"surface":"நேர்ந்து","parts":[{"text":"நேர்ந்து","lemma":"nēr","gloss":"having consented/agreed"}],"gloss":"having consented"},{"surface":"நம்","parts":[{"text":"நம்","lemma":"nam","gloss":"our"}],"gloss":"our"},{"surface":"அருளார்","parts":[{"text":"அருள்","lemma":"aruḷ","gloss":"grace/mercy"},{"text":"ஆர்","lemma":"ār","gloss":"he who does not have (negative personal suffix)"}],"gloss":"he who does not show grace"},{"surface":"நீத்தோர்க்கு","parts":[{"text":"நீத்து","lemma":"nī","gloss":"having abandoned"},{"text":"ஓர்","lemma":"ōr","gloss":"he"},{"text":"கு","lemma":"ku","gloss":"to"}],"gloss":"to him who abandoned"},{"surface":"அஞ்சல்","parts":[{"text":"அஞ்சல்","lemma":"añcal","gloss":"fearing/fear"}],"gloss":"fear"}]},{"words":[{"surface":"எஞ்சினம்","parts":[{"text":"எஞ்சு","lemma":"eñcu","gloss":"to remain/cease"},{"text":"இன்","lemma":"iṉ","gloss":"past tense marker"},{"text":"அம்","lemma":"am","gloss":"we"}],"gloss":"we ceased"},{"surface":"வாழி","parts":[{"text":"வாழி","lemma":"vāḻi","gloss":"may you live"}],"gloss":"may you live"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"tōḻi","gloss":"friend"}],"gloss":"friend"},{"surface":"எஞ்சா","parts":[{"text":"எஞ்சா","lemma":"eñcā","gloss":"unceasingly/completely"}],"gloss":"completely"}]},{"words":[{"surface":"தீய்ந்த","parts":[{"text":"தீய்ந்த","lemma":"tīy","gloss":"scorched/withered"}],"gloss":"scorched"},{"surface":"மராஅத்து","parts":[{"text":"மராஅத்து","lemma":"மராஅத்து","gloss":"of the marāam tree"}],"gloss":"of the marāam tree","split_unverified":true},{"surface":"ஓங்கல்","parts":[{"text":"ஓங்கல்","lemma":"ōṅkal","gloss":"lofty/high"}],"gloss":"lofty"},{"surface":"வெஞ்சினை","parts":[{"text":"வெம்","lemma":"vem","gloss":"hot/cruel"},{"text":"சினை","lemma":"ciṉai","gloss":"branch"}],"gloss":"hot branch"}]},{"words":[{"surface":"வேனில்","parts":[{"text":"வேனில்","lemma":"vēṉil","gloss":"summer"}],"gloss":"summer"},{"surface":"ஓர்","parts":[{"text":"ஓர்","lemma":"ōr","gloss":"one/single"}],"gloss":"a single"},{"surface":"இணர்","parts":[{"text":"இணர்","lemma":"iṇar","gloss":"flower cluster"}],"gloss":"flower cluster"},{"surface":"தேனோடு","parts":[{"text":"தேன்","lemma":"tēṉ","gloss":"honey"},{"text":"ஓடு","lemma":"ōṭu","gloss":"with"}],"gloss":"with honey"},{"surface":"ஊதி","parts":[{"text":"ஊதி","lemma":"ūti","gloss":"having hummed/blown"}],"gloss":"having hummed"}]},{"words":[{"surface":"ஆராது","parts":[{"text":"ஆர்","lemma":"ār","gloss":"to be satisfied"},{"text":"ஆது","lemma":"ātu","gloss":"without"}],"gloss":"without being satisfied"},{"surface":"பெயரும்","parts":[{"text":"பெயரும்","lemma":"peyar","gloss":"returning"}],"gloss":"returning"},{"surface":"தும்பி","parts":[{"text":"தும்பி","lemma":"tumpi","gloss":"bee"}],"gloss":"bee"}]},{"words":[{"surface":"நீரில்","parts":[{"text":"நீர்","lemma":"nīr","gloss":"water"},{"text":"இல்","lemma":"il","gloss":"without"}],"gloss":"waterless"},{"surface":"வைப்பின்","parts":[{"text":"வைப்பு","lemma":"vaippu","gloss":"land/place"},{"text":"இன்","lemma":"iṉ","gloss":"of"}],"gloss":"of the land"},{"surface":"சுரன்","parts":[{"text":"சுரன்","lemma":"curaṉ","gloss":"desert path"}],"gloss":"desert path"},{"surface":"இறந்தோரே","parts":[{"text":"இறந்து","lemma":"iṟa","gloss":"having crossed"},{"text":"ஓர்","lemma":"ōr","gloss":"he"},{"text":"ஏ","lemma":"ē","gloss":"indeed (emphasis)"}],"gloss":"he who traversed indeed"}]}],"literal":"As beautiful, fine hair-adorned arms' select bangles slip, / having consented, our grace-less abandoner, to fear him / we ceased, may you live, friend! Completely / scorched marāam tree's lofty hot branch, / in summer, a single flower cluster, with honey, having hummed, / without being satisfied, returning bee, / in the waterless land's desert path, he traversed.","translation":"May you live, my friend! As our select bangles slip from arms adorned with beautiful, fine hair, we have ceased to fear him who abandoned us without showing grace. He has traversed the waterless desert path where, in the heat of summer, a bee hums around a single flower cluster on a lofty, hot branch of a completely scorched marāam tree, only to return unsatisfied.","modern":"தோழியே, நீ வாழ்க! அழகிய மெல்லிய கூந்தலையும், கழன்று விழும் வளையல்களையும் உடைய நம்மை விட்டு, நமக்கு அருள் செய்யாமல் பிரிந்து சென்ற தலைவரைப் பற்றிய அச்சத்தை நாம் விட்டுவிட்டோம். கோடைக் காலத்தில், முற்றிலும் காய்ந்துபோன மராஅ மரத்தின் உயர்ந்த வெம்மையான கிளையில் உள்ள ஒரே ஒரு பூங்கொத்தில் தேனைத் தேடி ஊதி, அது கிடைக்காமல் திருப்தியடையாமல் திரும்பும் வண்டுகள் வாழும், நீர் இல்லாத பாலைவன வழியைக் கடந்து சென்றவர் அவரே.","explanation":"The companion (tōḻi) speaks to the heroine (தலைவி) to comfort her during the hero's absence. The hero has departed to the desert wasteland to acquire wealth, leaving the heroine in deep grief, causing her to grow thin and her bangles to slip off. The companion reassures the heroine, saying they no longer need to fear or worry about the hero who left them without pity. This poem belongs to the pālai (desert/separation) landscape. The image of the bee humming around a single flower cluster on a scorched, hot branch of a marāam tree and returning unsatisfied represents the barrenness and cruelty of the desert. It also subtly mirrors the hero's situation: he went seeking wealth (honey) in a harsh land, but may find nothing and return empty-handed.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.43],[0.43,0.7],[0.83,1.3],[1.3,1.7],[1.7,2.7],[2.7,3.0],[3.1,3.53],[3.57,3.6],[3.6,4.9],[4.9,5.2],[5.2,5.5],[5.64,6.0],[6.28,7.1],[7.1,7.36],[7.36,8.0],[8.0,8.4],[8.4,9.13],[9.13,9.5],[9.5,9.57],[9.57,9.7],[9.7,11.3],[11.7,12.1],[12.1,12.4],[12.4,13.3],[13.3,13.7],[13.7,14.1],[14.1,14.4]],"female":[[0.0,0.5],[0.5,0.8],[0.97,1.5],[1.5,1.9],[1.9,2.82],[2.82,2.93],[3.16,3.97],[4.08,4.2],[4.2,5.4],[5.4,5.8],[5.8,6.0],[6.14,6.5],[6.75,7.5],[7.5,7.73],[7.73,8.3],[8.3,8.8],[8.8,9.53],[9.53,10.2],[10.35,10.73],[10.97,11.3],[11.3,12.3],[12.3,12.7],[12.7,13.0],[13.0,14.1],[14.1,14.5],[14.5,14.95],[14.95,15.3]]}}