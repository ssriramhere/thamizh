{"text":"kuruntokai","n":369,"lines":["அத்த வாகை அமலை வானெற்","றரியார் சிலம்பி னரிசி யார்ப்பக்","கோடை தூக்குங் கானம்","செல்வாந் தோழி நல்கினர் நமரே"],"tr":["atta vākai amalai vāṉeṟ","ṟariyār cilampi ṉarici yārppak","kōṭai tūkkuṅ kāṉam","celvān tōḻi nalkiṉar namarē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"குடவாயிற் கீரத்தனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kuṭavāyiṟ Kīrattaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 15"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 4"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அத்த","tr":"atta","foot":"tēmā","acai":[{"kind":"nēr","text":"அத்","tr":"at"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"வாகை","tr":"vākai","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"கை","tr":"kai"}]},{"text":"அமலை","tr":"amalai","foot":"puḷimā","acai":[{"kind":"nirai","text":"அம","tr":"ama"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"வானெற்","tr":"vāṉeṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"னெற்","tr":"ṉeṟ"}]}],[{"text":"றரியார்","tr":"ṟariyār","foot":"puḷimā","acai":[{"kind":"nirai","text":"றரி","tr":"ṟari"},{"kind":"nēr","text":"யார்","tr":"yār"}]},{"text":"சிலம்பி","tr":"cilampi","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிலம்","tr":"cilam"},{"kind":"nēr","text":"பி","tr":"pi"}]},{"text":"னரிசி","tr":"ṉarici","foot":"puḷimā","acai":[{"kind":"nirai","text":"னரி","tr":"ṉari"},{"kind":"nēr","text":"சி","tr":"ci"}]},{"text":"யார்ப்பக்","tr":"yārppak","foot":"tēmā","acai":[{"kind":"nēr","text":"யார்ப்","tr":"yārp"},{"kind":"nēr","text":"பக்","tr":"pak"}]}],[{"text":"கோடை","tr":"kōṭai","foot":"tēmā","acai":[{"kind":"nēr","text":"கோ","tr":"kō"},{"kind":"nēr","text":"டை","tr":"ṭai"}]},{"text":"தூக்குங்","tr":"tūkkuṅ","foot":"tēmā","acai":[{"kind":"nēr","text":"தூக்","tr":"tūk"},{"kind":"nēr","text":"குங்","tr":"kuṅ"}]},{"text":"கானம்","tr":"kāṉam","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"னம்","tr":"ṉam"}]}],[{"text":"செல்வாந்","tr":"celvān","foot":"tēmā","acai":[{"kind":"nēr","text":"செல்","tr":"cel"},{"kind":"nēr","text":"வாந்","tr":"vān"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"நல்கினர்","tr":"nalkiṉar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நல்","tr":"nal"},{"kind":"nirai","text":"கினர்","tr":"kiṉar"}]},{"text":"நமரே","tr":"namarē","foot":"puḷimā","acai":[{"kind":"nirai","text":"நம","tr":"nama"},{"kind":"nēr","text":"ரே","tr":"rē"}]}]]},"ai":null}