,"tr":"naṉantalai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நனந்","tr":"naṉan"},{"kind":"nirai","text":"தலை","tr":"talai"}]},{"text":"உலகமும்","tr":"ulakamum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"உல","tr":"ula"},{"kind":"nirai","text":"கமும்","tr":"kamum"}]},{"text":"துஞ்சும்","tr":"tuñcum","foot":"tēmā","acai":[{"kind":"nēr","text":"துஞ்","tr":"tuñ"},{"kind":"nēr","text":"சும்","tr":"cum"}]}],[{"text":"ஓர்யான்","tr":"ōryāṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"ஓர்","tr":"ōr"},{"kind":"nēr","text":"யான்","tr":"yāṉ"}]},{"text":"மன்ற","tr":"maṉṟa","foot":"tēmā","acai":[{"kind":"nēr","text":"மன்","tr":"maṉ"},{"kind":"nēr","text":"ற","tr":"ṟa"}]},{"text":"துஞ்சா","tr":"tuñcā","foot":"tēmā","acai":[{"kind":"nēr","text":"துஞ்","tr":"tuñ"},{"kind":"nēr","text":"சா","tr":"cā"}]},{"text":"தேனே","tr":"tēṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"தே","tr":"tē"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"நள்ளென்","parts":[{"text":"நள்ளென்","lemma":"நள்ளென்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"றன்றே","parts":[{"text":"றன்றே","lemma":"றன்றே","gloss":""}],"gloss":"","split_unverified":true},{"surface":"யாமம்","parts":[{"text":"யாமம்","lemma":"யாமம்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"சொல்லவிந்","parts":[{"text":"சொல்லவிந்","lemma":"சொல்லவிந்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"தினிது","parts":[{"text":"தினிது","lemma":"தினிது","gloss":"pleasantly"}],"gloss":"pleasantly","split_unverified":true},{"surface":"அடங்கினரே","parts":[{"text":"அடங்கு","lemma":"அடங்கு","gloss":"subside"},{"text":"இன்","lemma":"இன்","gloss":"past tense marker"},{"text":"அர்","lemma":"அர்","gloss":"they"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"they became still indeed"},{"surface":"மாக்கள்","parts":[{"text":"மாக்கள்","lemma":"மாக்கள்","gloss":"people"}],"gloss":"people"},{"surface":"முனிவு","parts":[{"text":"முனிவு","lemma":"முனிவு","gloss":"resentment"}],"gloss":"resentment"},{"surface":"இன்று","parts":[{"text":"இன்று","lemma":"இன்று","gloss":"without"}],"gloss":"without"}]},{"words":[{"surface":"நனம்","parts":[{"text":"நனம்","lemma":"நனம்","gloss":"wide"}],"gloss":"wide"},{"surface":"தலை","parts":[{"text":"தலை","lemma":"தலை","gloss":"place/expanse"}],"gloss":"place"},{"surface":"உலகம்","parts":[{"text":"உலகம்","lemma":"உலகம்","gloss":"world"}],"gloss":"world"},{"surface":"உம்","parts":[{"text":"உம்","lemma":"உம்","gloss":"also/even"}],"gloss":"even"},{"surface":"துஞ்சும்","parts":[{"text":"துஞ்சும்","lemma":"துஞ்சு","gloss":"sleeps"}],"gloss":"sleeps"}]},{"words":[{"surface":"ஓர்","parts":[{"text":"ஓர்","lemma":"ஓர்","gloss":"one/alone"}],"gloss":"one"},{"surface":"யான்","parts":[{"text":"யான்","lemma":"யான்","gloss":"I"}],"gloss":"I"},{"surface":"மன்ற","parts":[{"text":"மன்ற","lemma":"மன்ற","gloss":"surely/certainly"}],"gloss":"surely"},{"surface":"துஞ்சாதேன்","parts":[{"text":"துஞ்சாது","lemma":"துஞ்சு","gloss":"not sleeping"},{"text":"ஏன்","lemma":"ஏன்","gloss":"I (pronominal suffix)"}],"gloss":"I who do not sleep"},{"surface":"ஏ","parts":[{"text":"ஏ","lemma":"ஏ","gloss":"indeed/emphasis"}],"gloss":"indeed"}]}],"literal":"Midnight has become dark indeed. Speech having subsided, / sweetly settled down indeed have people, without grief. / Even the wide-placed world sleeps. / Only I, surely, am one who does not sleep.","translation":"Midnight has fallen, dark and deep. Speech has died down, and people have settled into sweet, peaceful sleep, free of grief. Even the wide world is asleep. I alone, surely, remain awake.","modern":"நள்ளிரவு வந்துவிட்டது. பேச்சுக்கள் அடங்கி மக்கள் வருத்தமின்றி இனிமையாகத் தூங்கிவிட்டார்கள். அகன்ற இடத்தைக் கொண்ட இந்த உலகமும் தூங்குகிறது. நான் ஒருத்தி மட்டும்தான் நிச்சயமாகத் தூங்காமல் இருக்கிறேன்.","explanation":"In this Neytal (seashore) poem, the heroine speaks to herself in the deep of the night, expressing the intense pain of separation from her lover. She observes that midnight has fallen and all human speech has ceased. People have peacefully gone to sleep, free from any worries or grief, and even the vast world itself is asleep. In stark contrast to this universal peace, she is the only one kept awake by her agonizing longing. The image of a sleeping world highlights her profound loneliness and the quiet intensity of her suffering.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.46],[0.46,0.8],[0.8,1.1],[1.1,1.67],[1.67,2.9],[2.9,3.5],[3.5,3.68],[3.68,4.6],[4.6,6.1],[6.1,6.6],[6.6,7.33],[7.33,8.05],[8.05,8.6],[8.6,9.1],[9.1,9.3]],"female":[[0.0,0.51],[0.51,0.9],[0.9,1.2],[1.2,1.94],[1.94,3.2],[3.2,3.8],[3.8,4.06],[4.06,5.1],[5.1,6.7],[6.7,7.3],[7.3,7.5],[7.5,8.59],[8.59,9.4],[9.4,9.82],[9.82,10.1]]},"sync":[[["நள்ளென்",""]],[["றன்றே",""]],[["யாமம்",""]],[["சொல்லவிந்",""]],[["தினிது","pleasantly"],["அடங்கினரே","they became still indeed"]],[["அடங்கினரே","they became still indeed"]],[["மாக்கள்","people"]],[["முனிவு","resentment"],["இன்று","without"]],[["நனம்","wide"],["தலை","place"]],[["உலகம்","world"],["உம்","even"]],[["துஞ்சும்","sleeps"]],[["ஓர்","one"],["யான்","I"]],[["மன்ற","surely"]],[["துஞ்சாதேன்","I who do not sleep"]],[["துஞ்சாதேன்","I who do not sleep"]]]}