xt":"அடை","lemma":"அடை","gloss":"adjoining"}],"gloss":"adjoining"},{"surface":"கரை","parts":[{"text":"கரை","lemma":"கரை","gloss":"shore"}],"gloss":"shore"}]},{"words":[{"surface":"நனைந்த","parts":[{"text":"நனைந்த","lemma":"நனை","gloss":"budded"}],"gloss":"budded"},{"surface":"புன்னை","parts":[{"text":"புன்னை","lemma":"புன்னை","gloss":"mastwood tree"}],"gloss":"punnai tree"},{"surface":"மா","parts":[{"text":"மா","lemma":"மா","gloss":"dark"}],"gloss":"dark"},{"surface":"சினை","parts":[{"text":"சினை","lemma":"சினை","gloss":"branch"}],"gloss":"branches"},{"surface":"தொகூஉம்","parts":[{"text":"தொகூஉம்","lemma":"தொகு","gloss":"gathering"}],"gloss":"gathering"}]},{"words":[{"surface":"மலர்ந்த","parts":[{"text":"மலர்ந்த","lemma":"மலர்ந்த","gloss":""}],"gloss":"","split_unverified":true},{"surface":"பூவின்","parts":[{"text":"பூவின்","lemma":"பூவின்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"மாநீர்ச்","parts":[{"text":"மாநீர்ச்","lemma":"மாநீர்ச்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"சேர்ப்பற்","parts":[{"text":"சேர்ப்பற்","lemma":"சேர்ப்பற்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"கிரங்கேன்","parts":[{"text":"கிரங்கேன்","lemma":"கிரங்கேன்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தோழியீங்","parts":[{"text":"தோழியீங்","lemma":"தோழியீங்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"கென்கொ","parts":[{"text":"கென்கொ","lemma":"கென்கொ","gloss":""}],"gloss":"","split_unverified":true},{"surface":"லென்று","parts":[{"text":"லென்று","lemma":"லென்று","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"பிறர்","parts":[{"text":"பிறர்","lemma":"பிறர்","gloss":"others"}],"gloss":"others"},{"surface":"பிறர்","parts":[{"text":"பிறர்","lemma":"பிறர்","gloss":"others"}],"gloss":"others"},{"surface":"அறிய","parts":[{"text":"அறிய","lemma":"அறி","gloss":"to know"}],"gloss":"to know"},{"surface":"கூறல்","parts":[{"text":"கூறல்","lemma":"கூறு","gloss":"speaking"}],"gloss":"speaking"}]},{"words":[{"surface":"அமைந்தாங்","parts":[{"text":"அமைந்தாங்","lemma":"அமைந்தாங்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"கமைக","parts":[{"text":"கமைக","lemma":"கமைக","gloss":""}],"gloss":"","split_unverified":true},{"surface":"அம்பலஃ","parts":[{"text":"அம்பலஃ","lemma":"அம்பலஃ","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தெவனே","parts":[{"text":"தெவனே","lemma":"தெவனே","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true}],"literal":"Desiring the seasonal honey, a swarm of many wings / on the adjoining shore of dense sand dashed by strong waves, / gathers on the dark branches of the budded punnai tree. / For the lord of the coast of vast waters with bloomed flowers, / I will not pine, O friend! Saying \"What is this here?\" / others and others speaking so that everyone knows, / let it settle as it settles. What does that gossip matter?","translation":"Desiring the seasonal honey, a swarm of many wings gathers on the dark branches of the budded punnai tree on the dense sandy shore dashed by strong waves. I will not pine for the lord of the coast of vast waters with bloomed flowers, O friend! Let others gossip so that everyone knows, saying, 'What is this here?' Let it settle as it settles. What does that gossip matter to us?","modern":"பருவகாலத்துத் தேனை விரும்பி, பல இறக்கைகளையுடைய வண்டுகளின் கூட்டம், வலிமையான அலைகள் மோதும் செறிந்த மணலையுடைய கரையில், அரும்புகள் நிறைந்த புன்னை மரத்தின் கரிய கிளைகளில் வந்து கூடும். மலர்ந்த பூக்களையும் கரிய கடலையும் உடைய கடற்கரைத் தலைவனுக்காக நான் வருந்தமாட்டேன், தோழியே! 'இங்கே நடப்பது என்ன?' என்று மற்றவர்கள் ஒருவருக்கொருவர் அறியும்படி அலர் தூற்றுவதைப் பற்றி எனக்குக் கவலையில்லை. அது எப்படி அடங்குமோ அப்படி அடங்கட்டும். அந்த அலர் பேச்சால் நமக்கு என்ன வந்துவிடப் போகிறது?","explanation":"The heroine is speaking to her close friend in this coastal (neytal) poem. The friend is deeply worried about the rumors and gossip (alar) spreading through the village regarding the heroine's secret love affair. The heroine, however, remains calm and defiant, stating that she will not pine for the lord of the coast. She dismisses the villagers' gossip, saying let them talk and let the rumors settle on their own. The image of the bees gathering on the punnai tree on the wave-beaten shore to seek seasonal honey represents the natural, inevitable attraction of the lovers, which remains unaffected by the noisy waves of public gossip.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.57],[0.6,1.05],[1.05,1.66],[1.74,1.9],[2.03,2.6],[2.6,3.0],[3.1,3.2],[3.2,3.5],[3.5,4.9],[4.9,5.2],[5.2,5.52],[5.84,6.0],[6.0,6.9],[6.9,7.2],[7.5,7.6],[7.6,7.6],[7.6,7.7],[7.7,9.9],[9.9,9.98],[9.98,10.3],[10.3,11.4],[11.4,11.8],[11.8,12.1],[12.1,13.3],[13.3,13.62],[13.62,13.79],[14.28,14.6]],"female":[[0.0,0.42],[0.42,1.14],[1.14,1.7],[1.7,1.9],[1.9,2.8],[2.8,2.9],[3.4,3.5],[3.5,3.8],[3.8,3.8],[3.8,3.8],[3.8,3.8],[3.8,3.8],[3.8,7.6],[7.6,7.6],[7.6,7.6],[7.6,7.6],[7.6,7.6],[7.6,7.6],[7.6,7.6],[7.6,7.6],[7.6,12.3],[12.3,12.7],[12.7,13.0],[13.0,14.73],[14.73,14.73],[14.73,14.73],[14.73,15.6]]}}