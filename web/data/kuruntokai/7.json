்","tr":"muṉ"},{"kind":"nēr","text":"னி","tr":"ṉi"}]},{"text":"யோரே","tr":"yōrē","foot":"tēmā","acai":[{"kind":"nēr","text":"யோ","tr":"yō"},{"kind":"nēr","text":"ரே","tr":"rē"}]}]]},"ai":{"lines":[{"words":[{"surface":"வில்லோன்","parts":[{"text":"வில்","lemma":"vil","gloss":"bow"},{"text":"ஓன்","lemma":"ōṉ","gloss":"he who has"}],"gloss":"the man with the bow"},{"surface":"காலன","parts":[{"text":"கால்","lemma":"kāl","gloss":"leg/foot"},{"text":"அன","lemma":"aṉa","gloss":"they (neuter)"}],"gloss":"are on his feet"},{"surface":"கழலே","parts":[{"text":"கழல்","lemma":"kaḻal","gloss":"warrior's anklet"},{"text":"ஏ","lemma":"ē","gloss":"indeed (emphasis)"}],"gloss":"indeed the warrior's anklets"},{"surface":"தொடியோள்","parts":[{"text":"தொடி","lemma":"toṭi","gloss":"bracelet"},{"text":"ஓள்","lemma":"ōḷ","gloss":"she who has"}],"gloss":"she who wears bracelets"}]},{"words":[{"surface":"மெல்லடி","parts":[{"text":"மெல்","lemma":"mel","gloss":"soft"},{"text":"அடி","lemma":"aṭi","gloss":"foot"}],"gloss":"soft feet"},{"surface":"மேலவும்","parts":[{"text":"மேல்","lemma":"mēl","gloss":"upon"},{"text":"அவும்","lemma":"avum","gloss":"they also"}],"gloss":"are also upon"},{"surface":"சிலம்பே","parts":[{"text":"சிலம்பு","lemma":"cilampu","gloss":"woman's anklet"},{"text":"ஏ","lemma":"ē","gloss":"indeed (emphasis)"}],"gloss":"indeed the anklets"},{"surface":"நல்லோர்","parts":[{"text":"நல்","lemma":"nal","gloss":"good/beautiful"},{"text":"ஓர்","lemma":"ōr","gloss":"they (plural/honorific)"}],"gloss":"the beautiful ones"}]},{"words":[{"surface":"யார்கொல்","parts":[{"text":"யார்","lemma":"yār","gloss":"who"},{"text":"கொல்","lemma":"kol","gloss":"particle of doubt"}],"gloss":"who indeed?"},{"surface":"அளியர்","parts":[{"text":"அளி","lemma":"aḷi","gloss":"pity/love"},{"text":"அர்","lemma":"ar","gloss":"they (plural)"}],"gloss":"worthy of pity"},{"surface":"தாமே","parts":[{"text":"தாம்","lemma":"tām","gloss":"themselves"},{"text":"ஏ","lemma":"ē","gloss":"indeed (emphasis)"}],"gloss":"themselves"},{"surface":"ஆரியர்","parts":[{"text":"ஆரியர்","lemma":"āriyar","gloss":"Aryans/acrobats"}],"gloss":"Aryans/tightrope dancers"}]},{"words":[{"surface":"கயிறாடு","parts":[{"text":"கயிறு","lemma":"kayiṟu","gloss":"rope"},{"text":"ஆடு","lemma":"āṭu","gloss":"dance/move"}],"gloss":"rope-dancing"},{"surface":"பறையின்","parts":[{"text":"பறை","lemma":"paṟai","gloss":"drum"},{"text":"இன்","lemma":"iṉ","gloss":"like (comparison suffix)"}],"gloss":"like the drum"},{"surface":"கால்பொர","parts":[{"text":"கால்","lemma":"kāl","gloss":"wind"},{"text":"பொர","lemma":"pora","gloss":"to beat/strike"}],"gloss":"as the wind beats"},{"surface":"கலங்கி","parts":[{"text":"கலங்கு","lemma":"kalaṅku","gloss":"shake/stir"},{"text":"இ","lemma":"i","gloss":"having (past participle)"}],"gloss":"having shaken"}]},{"words":[{"surface":"வாகை","parts":[{"text":"வாகை","lemma":"vākai","gloss":"sirissa tree"}],"gloss":"Vākai tree"},{"surface":"வெண்ணெற்று","parts":[{"text":"வெள்","lemma":"veḷ","gloss":"white/dry"},{"text":"நெற்று","lemma":"neṟṟu","gloss":"dry pod"}],"gloss":"white dry pods"},{"surface":"ஒலிக்கும்","parts":[{"text":"ஒலி","lemma":"oli","gloss":"sound"},{"text":"க்கும்","lemma":"kkum","gloss":"making (adjectival participle)"}],"gloss":"which make sound"}]},{"words":[{"surface":"வேய்பயில்","parts":[{"text":"வேய்","lemma":"vēy","gloss":"bamboo"},{"text":"பயில்","lemma":"payil","gloss":"dense/crowded"}],"gloss":"bamboo-crowded"},{"surface":"அழுவம்","parts":[{"text":"அழுவம்","lemma":"aḻuvam","gloss":"wasteland/forest"}],"gloss":"wasteland"},{"surface":"முன்னியோரே","parts":[{"text":"முன்னு","lemma":"muṉṉu","gloss":"approach/think of"},{"text":"இயோர்","lemma":"iyōr","gloss":"those who did"},{"text":"ஏ","lemma":"ē","gloss":"indeed (emphasis)"}],"gloss":"those who have set out towards"}]}],"literal":"On the feet of the bowman are warrior's anklets; on the soft feet of the braceleted girl / are also anklets; who indeed are they, worthy of pity themselves? / Like the drum of the rope-dancing Aryans, shaken as the wind beats, / the white dry pods of the Vākai tree rattle / in the bamboo-crowded wasteland which they have set out to cross.","translation":"On the feet of the youth with the bow are warrior's anklets; on the soft feet of the girl with bracelets are anklets too. Who are they, so worthy of pity? They have set out to cross the bamboo-dense desert, where the dry white pods of the vākai tree rattle, shaken by the beating wind like the drums of tightrope-dancing acrobats.","modern":"வில்லேந்திய இளைஞனின் கால்களில் வீரக்கழல் ஒலிக்கிறது. வளையல் அணிந்த பெண்ணின் மெல்லிய கால்களிலோ சிலம்பு ஒலிக்கிறது. தமக்குள் அன்பு கொண்டு உடன்போக்கு மேற்கொள்ளும் இவர்கள் யார்? மிகவும் இரங்கத்தக்கவர்கள். கயிற்றின் மேல் நடனமாடும் ஆரியர்களின் பறை முழக்கத்தைப் போல, காற்று மோதி அசைவதால் வாகை மரத்தின் உலர்ந்த வெள்ளை நெற்றுகள் சத்தமிடும் மூங்கில்கள் நிறைந்த பாலைவனக் காட்டுப் பாதையை நோக்கிச் செல்பவர்கள் இவர்கள்.","explanation":"This poem is set in the pālai (desert/wasteland) landscape and is spoken by onlookers who witness a young couple eloping. The observers notice that the young man carrying a bow wears warrior anklets, while the young woman with soft feet wears maiden anklets. They express deep pity and concern for these tender lovers who have ventured into such a harsh environment. The poet uses a vivid auditory image: the dry white pods of the vākai tree rattle in the wind, sounding like the drums played during the tightrope dances of traveling acrobats. This comparison highlights the dry, desolate, and intimidating nature of the desert path the young couple must traverse.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.46],[0.46,0.8],[0.8,1.2],[1.2,1.6],[1.6,2.5],[2.5,3.4],[3.4,3.8],[3.8,4.3],[4.3,6.0],[6.0,6.4],[6.4,6.6],[6.6,7.0],[7.0,7.95],[7.95,8.9],[8.9,9.3],[9.3,9.7],[9.7,11.3],[11.3,11.6],[11.6,11.9],[11.9,12.9],[12.9,13.7],[13.7,14.3],[14.3,14.7]],"female":[[0.0,0.46],[0.46,0.8],[0.8,1.3],[1.3,1.8],[1.8,2.75],[2.75,3.7],[3.7,4.2],[4.2,4.9],[4.9,6.6],[6.6,7.1],[7.1,7.5],[7.5,7.8],[7.8,8.13],[8.13,9.13],[9.13,9.94],[10.23,10.8],[10.8,12.4],[12.4,12.7],[12.7,12.9],[12.9,13.98],[13.98,14.85],[14.85,15.5],[15.5,16.0]]},"sync":[[["வில்லோன்","the man with the bow"]],[["காலன","are on his feet"]],[["கழலே","indeed the warrior's anklets"]],[["தொடியோள்","she who wears bracelets"]],[["மெல்லடி","soft feet"]],[["மேலவும்","are also upon"]],[["சிலம்பே","indeed the anklets"]],[["நல்லோர்","the beautiful ones"]],[["யார்கொல்","who indeed?"]],[["அளியர்","worthy of pity"]],[["தாமே","themselves"]],[["ஆரியர்","Aryans/tightrope dancers"]],[["கயிறாடு","rope-dancing"]],[["பறையின்","like the drum"]],[["கால்பொர","as the wind beats"],["கலங்கி","having shaken"]],[["கலங்கி","having shaken"]],[["வாகை","Vākai tree"]],[["வெண்ணெற்று","white dry pods"]],[["வெண்ணெற்று","white dry pods"],["ஒலிக்கும்","which make sound"]],[["வேய்பயில்","bamboo-crowded"]],[["அழுவம்","wasteland"]],[["முன்னியோரே","those who have set out towards"]],[["முன்னியோரே","those who have set out towards"]]]}