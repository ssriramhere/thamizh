{"text":"kuruntokai","n":7,"lines":["வில்லோன் காலன கழலே தொடியோள்","மெல்லடி மேலவும் சிலம்பே நல்லோர்","யார்கொல் அளியர் தாமே ஆரியர்","கயிறாடு பறையிற் கால்பொரக் கலங்கி","வாகை வெண்ணெற் றொலிக்கும்","வேய்பயில் அழுவம் முன்னி யோரே"],"tr":["villōṉ kālaṉa kaḻalē toṭiyōḷ","mellaṭi mēlavum cilampē nallōr","yārkol aḷiyar tāmē āriyar","kayiṟāṭu paṟaiyiṟ kālporak kalaṅki","vākai veṇṇeṟ ṟolikkum","vēypayil aḻuvam muṉṉi yōrē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"கண்டோர் கூற்று","poet_ta":"பெரும்பதுமனார்","speaker_en":"onlookers (kaṇṭōr)","poet_tr":"Perumpatumaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 4, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வில்லோன்","tr":"villōṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"வில்","tr":"vil"},{"kind":"nēr","text":"லோன்","tr":"lōṉ"}]},{"text":"காலன","tr":"kālaṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"லன","tr":"laṉa"}]},{"text":"கழலே","tr":"kaḻalē","foot":"puḷimā","acai":[{"kind":"nirai","text":"கழ","tr":"kaḻa"},{"kind":"nēr","text":"லே","tr":"lē"}]},{"text":"தொடியோள்","tr":"toṭiyōḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"தொடி","tr":"toṭi"},{"kind":"nēr","text":"யோள்","tr":"yōḷ"}]}],[{"text":"மெல்லடி","tr":"mellaṭi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மெல்","tr":"mel"},{"kind":"nirai","text":"லடி","tr":"laṭi"}]},{"text":"மேலவும்","tr":"mēlavum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மே","tr":"mē"},{"kind":"nirai","text":"லவும்","tr":"lavum"}]},{"text":"சிலம்பே","tr":"cilampē","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிலம்","tr":"cilam"},{"kind":"nēr","text":"பே","tr":"pē"}]},{"text":"நல்லோர்","tr":"nallōr","foot":"tēmā","acai":[{"kind":"nē