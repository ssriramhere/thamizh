{"text":"kuruntokai","n":277,"lines":["ஆசில் தெருவில் நாயில் வியன்கடைச்","செந்நெல் அமலை வெண்மை வெள்ளிழுது","ஓரிற் பிச்சை ஆர மாந்தி","அற்சிர வெய்ய வெப்பத் தண்ணீர்","சேமச் செப்பிற் பெறீஇயரோ நீயே","மின்னிடை நடுங்கும் கடைப்பெயல் வாடை","எக்கால் வருவ தென்றி","அக்கால் வருவரெங் காத லோரே"],"tr":["ācil teruvil nāyil viyaṉkaṭaic","cennel amalai veṇmai veḷḷiḻutu","ōriṟ piccai āra mānti","aṟcira veyya veppat taṇṇīr","cēmac ceppiṟ peṟīiyarō nīyē","miṉṉiṭai naṭuṅkum kaṭaippeyal vāṭai","ekkāl varuva teṉṟi","akkāl varuvareṅ kāta lōrē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"ஓரிற் பிச்சையார்","speaker_en":"her friend (tōḻi)","poet_tr":"Ōriṟ Piccaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 29, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 13"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஆசில்","tr":"ācil","foot":"tēmā","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nēr","text":"சில்","tr":"cil"}]},{"text":"தெருவில்","tr":"teruvil","foot":"puḷimā","acai":[{"kind":"nirai","text":"தெரு","tr":"teru"},{"kind":"nēr","text":"வில்","tr":"vil"}]},{"text":"நாயில்","tr":"nāyil","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"யில்","tr":"yil"}]},{"text":"வியன்கடைச்","tr":"viyaṉkaṭaic","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வியன்","tr":"viyaṉ"},{"kind":"nirai","text":"கடைச்","tr":"kaṭaic"}]}],[{"text":"செந்நெல்","tr":"cennel","foot":"tēmā","acai":[{"kind":"nēr","text":"செந்","tr":"cen"},{"kind":"nēr","text":"நெல்","tr":"nel"}]},{"text":"அமலை","tr":"amalai","foot":"puḷimā","acai":[{"kind":"nirai","text":"அம","tr":"ama"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"வெண்மை","tr":"veṇmai","foot":"tēmā","acai":[{"kind":"nēr","text":"வெண்","tr":"veṇ"},{"kind":"nēr","t