்நெல்","parts":[{"text":"செந்நெல்","lemma":"செந்நெல்","gloss":"fine red rice"}],"gloss":"fine red rice","split_unverified":true},{"surface":"அமலை","parts":[{"text":"அமலை","lemma":"amalai","gloss":"thick heap of cooked rice"}],"gloss":"thick heap of cooked rice"},{"surface":"வெண்மை","parts":[{"text":"வெண்மை","lemma":"veṇmai","gloss":"whiteness"}],"gloss":"white"},{"surface":"வெள்ளிழுது","parts":[{"text":"வெள்","lemma":"veḷ","gloss":"white"},{"text":"இழுது","lemma":"iḻutu","gloss":"ghee"}],"gloss":"white ghee"}]},{"words":[{"surface":"ஓரில்","parts":[{"text":"ஓர்","lemma":"ōr","gloss":"one"},{"text":"இல்","lemma":"il","gloss":"house"}],"gloss":"from a single house"},{"surface":"பிச்சை","parts":[{"text":"பிச்சை","lemma":"piccai","gloss":"alms"}],"gloss":"alms"},{"surface":"ஆர","parts":[{"text":"ஆர","lemma":"āra","gloss":"fully"}],"gloss":"fully"},{"surface":"மாந்தி","parts":[{"text":"மாந்தி","lemma":"mānti","gloss":"having eaten"}],"gloss":"having eaten"}]},{"words":[{"surface":"அற்சிர","parts":[{"text":"அற்சிர","lemma":"அற்சிர","gloss":"of early winter"}],"gloss":"of early winter","split_unverified":true},{"surface":"வெய்ய","parts":[{"text":"வெய்ய","lemma":"veyya","gloss":"desirable"}],"gloss":"desirable"},{"surface":"வெப்ப","parts":[{"text":"வெப்ப","lemma":"வெப்ப","gloss":"warm"}],"gloss":"warm","split_unverified":true},{"surface":"தண்ணீர்","parts":[{"text":"தண்","lemma":"taṇ","gloss":"cool"},{"text":"நீர்","lemma":"nīr","gloss":"water"}],"gloss":"water"}]},{"words":[{"surface":"சேம","parts":[{"text":"சேம","lemma":"சேம","gloss":"protective"}],"gloss":"protective","split_unverified":true},{"surface":"செப்பில்","parts":[{"text":"செப்பு","lemma":"ceppu","gloss":"casket"},{"text":"இல்","lemma":"il","gloss":"in"}],"gloss":"in a casket"},{"surface":"பெறீஇயரோ","parts":[{"text":"பெறு","lemma":"peṟu","gloss":"to receive"},{"text":"ஈஇயர்","lemma":"īiyar","gloss":"optative suffix"},{"text":"ஓ","lemma":"ō","gloss":"emphasis"}],"gloss":"may you receive!"},{"surface":"நீயே","parts":[{"text":"நீ","lemma":"nī","gloss":"you"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"you indeed"}]},{"words":[{"surface":"மின்னிடை","parts":[{"text":"மின்","lemma":"miṉ","gloss":"lightning"},{"text":"இடை","lemma":"iṭai","gloss":"midst"}],"gloss":"amidst lightning"},{"surface":"நடுங்கும்","parts":[{"text":"நடுங்கு","lemma":"naṭuṅku","gloss":"to shiver"},{"text":"உம்","lemma":"um","gloss":"relative participle suffix"}],"gloss":"shivering"},{"surface":"கடைப்பெயல்","parts":[{"text":"கடை","lemma":"kaṭai","gloss":"end"},{"text":"பெயல்","lemma":"peyal","gloss":"rain"}],"gloss":"late rains"},{"surface":"வாடை","parts":[{"text":"வாடை","lemma":"vāṭai","gloss":"north wind"}],"gloss":"north wind"}]},{"words":[{"surface":"எக்கால்","parts":[{"text":"எ","lemma":"e","gloss":"which"},{"text":"கால்","lemma":"kāl","gloss":"time"}],"gloss":"at what time"},{"surface":"வருவது","parts":[{"text":"வரு","lemma":"varu","gloss":"to come"},{"text":"வது","lemma":"vatu","gloss":"pronominal suffix"}],"gloss":"coming"},{"surface":"என்றி","parts":[{"text":"என்","lemma":"eṉ","gloss":"to say"},{"text":"தி","lemma":"ti","gloss":"you"}],"gloss":"you ask"}]},{"words":[{"surface":"அக்கால்","parts":[{"text":"அ","lemma":"a","gloss":"that"},{"text":"கால்","lemma":"kāl","gloss":"time"}],"gloss":"at that time"},{"surface":"வருவர்","parts":[{"text":"வரு","lemma":"varu","gloss":"to come"},{"text":"அர்","lemma":"ar","gloss":"he (honorific)"}],"gloss":"he will come"},{"surface":"எம்","parts":[{"text":"எம்","lemma":"em","gloss":"our"}],"gloss":"our"},{"surface":"காதலோரே","parts":[{"text":"காதல்","lemma":"kātal","gloss":"love"},{"text":"ஓர்","lemma":"ōr","gloss":"person"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"lover"}]}],"literal":"In the clean street, at the dogless wide entrance, / fine red rice heap with white ghee, / as alms from a single house, eating to the fill, / in the early winter, desirable warm water / in a protective casket, may you receive indeed! / Amidst lightning, shivering, with the late rains, the north wind / 'At what time will it come?' you ask; / at that time, he will come, our lover.","translation":"May you receive desirable warm water kept safe in a protective casket during the chilly winter, just like a mendicant who, wandering through clean, dogless streets, receives a satisfying meal of fine red rice heaped with white ghee from a single house! You ask, 'When will the shivering north wind of the late rains, flashing with lightning, arrive?' At that very time, our lover will return.","modern":"குற்றமில்லாத சுத்தமான தெருவில், நாய் இல்லாத அகன்ற வாசலில், செந்நெல் சோற்றுத் திரளையும் வெண்மையான நெய்யையும் ஒரே வீட்டில் பிச்சையாகப் பெற்று வயிறார உண்டு மகிழ்வது போல, குளிர்காலத்தில் பாதுகாப்பான செப்பில் வைக்கப்பட்ட விரும்பத்தக்க வெதுவெதுப்பான வெந்நீரை நீ பெறுவாயாக! மின்னல்களுக்கு இடையே நடுங்கச் செய்யும் கடைசிக் கால மழையோடு வீசும் வாடைக்காற்று எப்போது வரும் என்று கேட்கிறாய்; அந்த வாடைக்காற்று வீசும் காலத்தில்தான் நம் காதலர் திரும்பி வருவார்.","explanation":"This poem is spoken by the confidante (tōḻi) to comfort the anxious heroine (talaivi) during the hero's absence. The hero had promised to return before the onset of the cold season, and the heroine is worried about when that time will come. The confidante uses a beautiful simile of a mendicant who, instead of wandering from door to door, finds a clean, dogless street and receives a rich, satisfying meal of red rice and ghee from a single house. She blesses the heroine to receive comforting warm water kept safe in a casket during the cold winter, just as easily and satisfyingly. She reassures her that the cold north wind, which brings shivering rains and lightning, is the very signal of the hero's promised return. The poet's name, Ōriṟ Piccaiyār, is derived from the unique phrase 'ōriṟ piccai' (alms from a single house) used in this poem.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,1.0],[1.0,1.5],[1.5,2.06],[2.06,2.5],[2.5,2.7],[2.7,3.1],[3.1,3.8],[3.8,4.4],[4.8,5.1],[5.1,5.4],[5.4,5.8],[5.8,6.36],[6.36,6.54],[6.54,6.6],[6.6,7.2],[7.2,7.3],[7.33,7.35],[7.4,8.9],[8.9,9.6],[9.6,10.5],[10.5,10.5],[10.5,11.4],[11.4,11.7],[11.7,12.7],[12.7,12.93],[12.93,13.22],[13.4,14.1],[14.1,14.7],[14.7,14.91],[14.91,15.2]],"female":[[0.0,0.6],[0.6,1.0],[1.0,1.5],[1.5,2.09],[2.09,2.7],[2.7,3.1],[3.1,3.5],[3.5,4.0],[4.37,4.73],[5.1,5.6],[5.6,5.9],[5.9,6.3],[6.3,7.2],[7.2,7.24],[7.28,7.36],[7.4,8.1],[8.1,8.59],[8.75,9.24],[9.24,9.4],[9.4,10.4],[10.4,11.3],[11.3,11.3],[11.3,12.4],[12.4,12.7],[12.96,13.6],[13.6,13.87],[13.87,14.2],[14.2,14.4],[14.4,15.33],[15.8,16.4],[16.4,16.8]]},"sync":[[["ஆசில்","blemishless"]],[["தெருவில்","in the street"]],[["நாயில்","dogless"]],[["வியன்கடை","wide entrance"]],[["செந்நெல்","fine red rice"]],[["அமலை","thick heap of cooked rice"]],[["வெண்மை","white"]],[["வெள்ளிழுது","white ghee"]],[["ஓரில்","from a single house"]],[["பிச்சை","alms"]],[["ஆர","fully"]],[["மாந்தி","having eaten"]],[["அற்சிர","of early winter"]],[["வெய்ய","desirable"]],[["வெப்ப","warm"],["தண்ணீர்","water"]],[["தண்ணீர்","water"]],[["சேம","protective"]],[["செப்பில்","in a casket"]],[["பெறீஇயரோ","may you receive!"]],[["நீயே","you indeed"]],[["மின்னிடை","amidst lightning"]],[["நடுங்கும்","shivering"]],[["கடைப்பெயல்","late rains"]],[["வாடை","north wind"]],[["எக்கால்","at what time"]],[["வருவது","coming"]],[["வருவது","coming"],["என்றி","you ask"]],[["அக்கால்","at that time"]],[["வருவர்","he will come"],["எம்","our"]],[["காதலோரே","lover"]],[["காதலோரே","lover"]]]}