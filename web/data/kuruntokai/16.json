{"text":"kuruntokai","n":16,"lines":["உள்ளார் கொல்லோ தோழி கள்வர்","பொன்புனை பகழி செப்பங் கொண்மார்","உகிர்நுதி புரட்டும் ஓசை போலச்","செங்காற் பல்லி தன்றுணை பயிரும்","அங்காற் கள்ளியங் காடிறந் தாரே"],"tr":["uḷḷār kollō tōḻi kaḷvar","poṉpuṉai pakaḻi ceppaṅ koṇmār","ukirnuti puraṭṭum ōcai pōlac","ceṅkāṟ palli taṉṟuṇai payirum","aṅkāṟ kaḷḷiyaṅ kāṭiṟan tārē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"பாலைபாடிய பெருங்கடுங்கோ","speaker_en":"her friend (tōḻi)","poet_tr":"Pālaipāṭiya Peruṅkaṭuṅkō"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"5×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 20"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 3"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"உள்ளார்","tr":"uḷḷār","foot":"tēmā","acai":[{"kind":"nēr","text":"உள்","tr":"uḷ"},{"kind":"nēr","text":"ளார்","tr":"ḷār"}]},{"text":"கொல்லோ","tr":"kollō","foot":"tēmā","acai":[{"kind":"nēr","text":"கொல்","tr":"kol"},{"kind":"nēr","text":"லோ","tr":"lō"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"கள்வர்","tr":"kaḷvar","foot":"tēmā","acai":[{"kind":"nēr","text":"கள்","tr":"kaḷ"},{"kind":"nēr","text":"வர்","tr":"var"}]}],[{"text":"பொன்புனை","tr":"poṉpuṉai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பொன்","tr":"poṉ"},{"kind":"nirai","text":"புனை","tr":"puṉai"}]},{"text":"பகழி","tr":"pakaḻi","foot":"puḷimā","acai":[{"kind":"nirai","text":"பக","tr":"paka"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"செப்பங்","tr":"ceppaṅ","foot":"tēmā","acai":[{"kind":"nēr","text":"செப்","tr":"cep"},{"kind":"nēr","text":"பங்","tr":"paṅ"}]},{"text":"கொண்மார்","tr":"koṇmār","foot":"tēmā","acai":[{"kind":"nēr","text":"கொண்","tr":"koṇ"},{"kind":"nēr","text":"மார்","tr":"mār"}]}],[{"text":"உகிர்நுதி","tr":"uki