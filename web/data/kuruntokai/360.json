{"text":"kuruntokai","n":360,"lines":["வெறியென உணர்ந்த வேல னோய்மருந்","தறியா னாகுதல் அன்னை காணிய","அரும்படர் எவ்வம் இன்றுநாம் உழப்பினும்","வாரற்க தில்ல தோழி சாரற்","பிடிக்கை அன்ன பெருங்குரல் ஏனல்","உண்கிளி கடியும் கொடிச்சிகைக் குளிரே","சிலம்பிற் சிலம்புஞ் சோலை","இலங்குமலை நாடன் இரவி னானே"],"tr":["veṟiyeṉa uṇarnta vēla ṉōymarun","taṟiyā ṉākutal aṉṉai kāṇiya","arumpaṭar evvam iṉṟunām uḻappiṉum","vāraṟka tilla tōḻi cāraṟ","piṭikkai aṉṉa peruṅkural ēṉal","uṇkiḷi kaṭiyum koṭiccikaik kuḷirē","cilampiṟ cilampuñ cōlai","ilaṅkumalai nāṭaṉ iravi ṉāṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"மதுரை ஈழத்துப் பூதன்றேவனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Maturai Īḻattup Pūtaṉṟēvaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 29, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 13"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வெறியென","tr":"veṟiyeṉa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வெறி","tr":"veṟi"},{"kind":"nirai","text":"யென","tr":"yeṉa"}]},{"text":"உணர்ந்த","tr":"uṇarnta","foot":"puḷimā","acai":[{"kind":"nirai","text":"உணர்ந்","tr":"uṇarn"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"வேல","tr":"vēla","foot":"tēmā","acai":[{"kind":"nēr","text":"வே","tr":"vē"},{"kind":"nēr","text":"ல","tr":"la"}]},{"text":"னோய்மருந்","tr":"ṉōymarun","foot":"kūviḷam","acai":[{"kind":"nēr","text":"னோய்","tr":"ṉōy"},{"kind":"nirai","text":"மருந்","tr":"marun"}]}],[{"text":"தறியா","tr":"taṟiyā","foot":"puḷimā","acai":[{"kind":"nirai","text":"தறி","tr":"taṟi"},{"kind":"nēr","text":"யா","tr":"yā"}]},{"text":"னாகுதல்","tr":"ṉākutal","foot":"kūviḷam","acai":[{"kind":"nēr","text":"னா","tr":"ṉā"},{"kind":"nirai","text":"குதல்","tr":"kutal"}]},{"text":"அன்னை","tr":"aṉṉai","foot":"tēmā",