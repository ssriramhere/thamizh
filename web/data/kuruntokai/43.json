{"text":"kuruntokai","n":43,"lines":["செல்வார் அல்லரென் றியானிகழ்ந் தனனே","ஒல்வாள் அல்லளென் றவரிகழ்ந் தனரே","ஆயிடை இருபே ராண்மை செய்த பூசல்","நல்லராக் கதுவி யாங்கென்","அல்லல் நெஞ்சம் அலமலக் குறுமே"],"tr":["celvār allareṉ ṟiyāṉikaḻn taṉaṉē","olvāḷ allaḷeṉ ṟavarikaḻn taṉarē","āyiṭai irupē rāṇmai ceyta pūcal","nallarāk katuvi yāṅkeṉ","allal neñcam alamalak kuṟumē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"ஔவையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Auvaiyār"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"1×5, 3×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 20"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"1 five-foot line (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"செல்வார்","tr":"celvār","foot":"tēmā","acai":[{"kind":"nēr","text":"செல்","tr":"cel"},{"kind":"nēr","text":"வார்","tr":"vār"}]},{"text":"அல்லரென்","tr":"allareṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"அல்","tr":"al"},{"kind":"nirai","text":"லரென்","tr":"lareṉ"}]},{"text":"றியானிகழ்ந்","tr":"ṟiyāṉikaḻn","foot":"karuviḷam","acai":[{"kind":"nirai","text":"றியா","tr":"ṟiyā"},{"kind":"nirai","text":"னிகழ்ந்","tr":"ṉikaḻn"}]},{"text":"தனனே","tr":"taṉaṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"தன","tr":"taṉa"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}],[{"text":"ஒல்வாள்","tr":"olvāḷ","foot":"tēmā","acai":[{"kind":"nēr","text":"ஒல்","tr":"ol"},{"kind":"nēr","text":"வாள்","tr":"vāḷ"}]},{"text":"அல்லளென்","tr":"allaḷeṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"அல்","tr":"al"},{"kind":"nirai","text":"லளென்","tr":"laḷeṉ"}]},{"text":"றவரிகழ்ந்","tr":"ṟavarikaḻn","foot":"karuviḷam","acai":[{"kind":"nirai","text":"றவ","tr":"ṟava"},{"kind":"nirai","text":"ரிகழ்ந்","tr":"rikaḻn"}]},{"text":"தனரே","tr":"taṉarē","foot":"puḷimā","