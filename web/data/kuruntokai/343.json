text":"டுபூஞ்","tr":"ṭupūñ"}]},{"text":"சினையிற்","tr":"ciṉaiyiṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"சினை","tr":"ciṉai"},{"kind":"nēr","text":"யிற்","tr":"yiṟ"}]},{"text":"கிடக்கும்","tr":"kiṭakkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிடக்","tr":"kiṭak"},{"kind":"nēr","text":"கும்","tr":"kum"}]}],[{"text":"உயர்வரை","tr":"uyarvarai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"உயர்","tr":"uyar"},{"kind":"nirai","text":"வரை","tr":"varai"}]},{"text":"நாடனொடு","tr":"nāṭaṉoṭu","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nirai","text":"டனொ","tr":"ṭaṉo"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"பெயரும்","tr":"peyarum","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெய","tr":"peya"},{"kind":"nēr","text":"ரும்","tr":"rum"}]},{"text":"ஆறே","tr":"āṟē","foot":"tēmā","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nēr","text":"றே","tr":"ṟē"}]}]]},"ai":{"lines":[{"words":[{"surface":"நினையாய்","parts":[{"text":"நினையாய்","lemma":"நினை","gloss":"think"}],"gloss":"think"},{"surface":"வாழி","parts":[{"text":"வாழி","lemma":"வாழ்","gloss":"may you live"}],"gloss":"may you live"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"தோழி","gloss":"friend"}],"gloss":"friend"},{"surface":"நனைகவுள்","parts":[{"text":"நனை","lemma":"நனை","gloss":"wet"},{"text":"கவுள்","lemma":"கவுள்","gloss":"temple"}],"gloss":"wet temples"}]},{"words":[{"surface":"அண்ணல்","parts":[{"text":"அண்ணல்","lemma":"அண்ணல்","gloss":"majestic"}],"gloss":"majestic"},{"surface":"யானை","parts":[{"text":"யானை","lemma":"யானை","gloss":"elephant"}],"gloss":"elephant"},{"surface":"அணிமுகம்","parts":[{"text":"அணி","lemma":"அணி","gloss":"beautiful"},{"text":"முகம்","lemma":"முகம்","gloss":"face"}],"gloss":"beautiful face"},{"surface":"பாய்ந்தென","parts":[{"text":"பாய்ந்து","lemma":"பாய்","gloss":"having pounced"},{"text":"என","lemma":"என","gloss":"as"}],"gloss":"because it pounced"}]},{"words":[{"surface":"மிகுவலி","parts":[{"text":"மிகு","lemma":"மிகு","gloss":"great"},{"text":"வலி","lemma":"வலி","gloss":"strength"}],"gloss":"great strength"},{"surface":"இரும்புலிப்","parts":[{"text":"இரும்புலிப்","lemma":"இரும்புலிப்","gloss":"dark tiger"}],"gloss":"dark tiger","split_unverified":true},{"surface":"பகுவா","parts":[{"text":"பகுவா","lemma":"பகுவா","gloss":"gaping mouth"}],"gloss":"gaping mouth","split_unverified":true},{"surface":"யேற்றை","parts":[{"text":"யேற்றை","lemma":"யேற்றை","gloss":"male tiger"}],"gloss":"male tiger","split_unverified":true}]},{"words":[{"surface":"வெண்கொடு","parts":[{"text":"வெண்கொடு","lemma":"வெண்கொடு","gloss":"white tusk"}],"gloss":"white tusk","split_unverified":true},{"surface":"செம்மறுக்","parts":[{"text":"செம்மறுக்","lemma":"செம்மறுக்","gloss":"red stain"}],"gloss":"red stain","split_unverified":true},{"surface":"கொளீஇ","parts":[{"text":"கொளீஇ","lemma":"கொள்","gloss":"having caused to take"}],"gloss":"causing to receive"},{"surface":"விடர்முகைக்","parts":[{"text":"விடர்முகைக்","lemma":"விடர்முகைக்","gloss":"mountain cleft cave"}],"gloss":"mountain cleft cave","split_unverified":true}]},{"words":[{"surface":"கோடை","parts":[{"text":"கோடை","lemma":"கோடை","gloss":"summer wind"}],"gloss":"summer wind"},{"surface":"யொற்றிய","parts":[{"text":"யொற்றிய","lemma":"யொற்றிய","gloss":"that dried up"}],"gloss":"that dried up","split_unverified":true},{"surface":"கருங்கால்","parts":[{"text":"கருமை","lemma":"கருமை","gloss":"black"},{"text":"கால்","lemma":"கால்","gloss":"trunk"}],"gloss":"black-trunked"},{"surface":"வேங்கை","parts":[{"text":"வேங்கை","lemma":"வேங்கை","gloss":"Kino tree"}],"gloss":"Vengai tree"}]},{"words":[{"surface":"வாடுபூஞ்","parts":[{"text":"வாடுபூஞ்","lemma":"வாடுபூஞ்","gloss":"withered flowers"}],"gloss":"withered flowers","split_unverified":true},{"surface":"சினையிற்","parts":[{"text":"சினையிற்","lemma":"சினையிற்","gloss":"on the branch"}],"gloss":"on the branch","split_unverified":true},{"surface":"கிடக்கும்","parts":[{"text":"கிடக்கும்","lemma":"கிட","gloss":"lies"}],"gloss":"lies"}]},{"words":[{"surface":"உயர்வரை","parts":[{"text":"உயர்","lemma":"உயர்","gloss":"high"},{"text":"வரை","lemma":"வரை","gloss":"mountain"}],"gloss":"high mountain"},{"surface":"நாடனொடு","parts":[{"text":"நாடன்","lemma":"நாடன்","gloss":"lord of the land"},{"text":"ஒடு","lemma":"ஒடு","gloss":"with"}],"gloss":"with the lord of the land"},{"surface":"பெயரும்","parts":[{"text":"பெயரும்","lemma":"பெயர்","gloss":"departing"}],"gloss":"departing"},{"surface":"ஆறே","parts":[{"text":"ஆறு","lemma":"ஆறு","gloss":"path"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"the very path"}]}],"literal":"Think, may you live, my friend, of the wet-templed / majestic elephant's beautiful face, because it pounced, / the very strong, gaping-mouthed male of the dark tiger, / making the white tusk receive red stains, in the mountain cleft / by the summer wind dried, black-trunked Vengai tree's / withered-flower branch like, lies / the path on which you depart with the lord of the high mountains.","translation":"May you live long, my friend! Think of the path on which you will depart with the lord of the high mountains. On that path, because it pounced on the beautiful face of a majestic elephant with wet temples, a powerful, gaping-mouthed male tiger is gored by the white tusk, receiving red stains of blood. It now lies dead in a mountain cleft, looking just like a withered-flower branch of a black-trunked Vengai tree dried by the summer wind.","modern":"தோழியே! நீ வாழ்க! மதம் ஒழுகும் கன்னங்களை உடைய கம்பீரமான யானையின் அழகான முகத்தில் பாய்ந்ததால், மிகுந்த வலிமையும் பிளந்த வாயும் கொண்ட ஆண் புலி, யானையின் வெண்மையான தந்தத்தால் குத்தப்பட்டு, செந்நிறக் குருதி படிந்து இறந்து கிடக்கிறது. மலைப்பிளவிலே கோடைக்காலக் காற்று பட்டு உலர்ந்துபோன, கரிய அடிமரத்தைக் கொண்ட வேங்கை மரத்தின் வாடிய பூக்களை உடைய கிளையைப் போல அப்புலி கிடக்கிறது. அத்தகைய உயர்ந்த மலைநாட்டோடு நீ அவனுடன் செல்லும் வழியைப் பற்றிச் சிந்திப்பாயாக.","explanation":"The friend is speaking to the heroine who is planning to elope with her lover. She describes the perilous mountain path they must traverse, highlighting a fierce battle between a majestic elephant and a powerful male tiger. The tiger, gored by the elephant's tusk and stained with blood, lies dead in a mountain cleft, resembling a withered Vengai branch. This vivid imagery belongs to the transition of Kurinci into Palai, emphasizing the dry, harsh, and dangerous nature of the journey. By depicting these hardships, the friend gently prompts the heroine to reflect on the gravity of her decision to elope.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.8],[0.8,0.9],[0.9,1.4],[1.4,1.9],[1.9,2.8],[2.8,2.8],[2.8,3.05],[3.05,3.3],[3.3,5.08],[5.08,5.6],[5.6,5.61],[5.61,5.63],[5.65,5.7],[5.7,7.2],[7.2,7.5],[8.1,8.78],[8.78,9.6],[9.66,10.0],[10.0,10.5],[10.5,10.9],[10.9,10.9],[10.9,10.9],[10.9,12.5],[12.5,13.6],[13.6,13.7],[13.7,14.45],[14.75,14.9]],"female":[[0.0,0.7],[0.7,0.8],[0.8,1.2],[1.2,1.8],[1.8,2.7],[2.7,2.8],[2.8,3.6],[3.6,4.1],[4.1,5.17],[5.17,5.7],[5.7,5.72],[5.72,5.75],[5.75,5.75],[5.75,5.81],[5.81,6.59],[6.59,6.59],[6.59,6.59],[6.59,10.7],[10.7,11.2],[11.2,11.5],[11.5,12.43],[12.43,12.9],[12.9,13.0],[13.0,14.5],[14.5,14.7],[14.7,15.6],[15.6,15.9]]}}