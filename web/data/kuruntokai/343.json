{"text":"kuruntokai","n":343,"lines":["நினையாய் வாழி தோழி நனைகவுள்","அண்ணல் யானை அணிமுகம் பாய்ந்தென","மிகுவலி இரும்புலிப் பகுவா யேற்றை","வெண்கொடு செம்மறுக் கொளீஇ விடர்முகைக்","கோடை யொற்றிய கருங்கால் வேங்கை","வாடுபூஞ் சினையிற் கிடக்கும்","உயர்வரை நாடனொடு பெயரும் ஆறே"],"tr":["niṉaiyāy vāḻi tōḻi naṉaikavuḷ","aṇṇal yāṉai aṇimukam pāynteṉa","mikuvali irumpulip pakuvā yēṟṟai","veṇkoṭu cemmaṟuk koḷīi viṭarmukaik","kōṭai yoṟṟiya karuṅkāl vēṅkai","vāṭupūñ ciṉaiyiṟ kiṭakkum","uyarvarai nāṭaṉoṭu peyarum āṟē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தோழி கூற்று","poet_ta":"ஈழத்துப் பூதன்றேவனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Īḻattup Pūtaṉṟēvaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 10, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நினையாய்","tr":"niṉaiyāy","foot":"puḷimā","acai":[{"kind":"nirai","text":"நினை","tr":"niṉai"},{"kind":"nēr","text":"யாய்","tr":"yāy"}]},{"text":"வாழி","tr":"vāḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"நனைகவுள்","tr":"naṉaikavuḷ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நனை","tr":"naṉai"},{"kind":"nirai","text":"கவுள்","tr":"kavuḷ"}]}],[{"text":"அண்ணல்","tr":"aṇṇal","foot":"tēmā","acai":[{"kind":"nēr","text":"அண்","tr":"aṇ"},{"kind":"nēr","text":"ணல்","tr":"ṇal"}]},{"text":"யானை","tr":"yāṉai","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னை","tr":"ṉai"}]},{"text":"அணிமுகம்","tr":"aṇimukam","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அணி","tr":"aṇi"},{"kind":"nirai","text":"மு