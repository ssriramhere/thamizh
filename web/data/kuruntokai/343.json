text":"டுபூஞ்","tr":"ṭupūñ"}]},{"text":"சினையிற்","tr":"ciṉaiyiṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"சினை","tr":"ciṉai"},{"kind":"nēr","text":"யிற்","tr":"yiṟ"}]},{"text":"கிடக்கும்","tr":"kiṭakkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிடக்","tr":"kiṭak"},{"kind":"nēr","text":"கும்","tr":"kum"}]}],[{"text":"உயர்வரை","tr":"uyarvarai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"உயர்","tr":"uyar"},{"kind":"nirai","text":"வரை","tr":"varai"}]},{"text":"நாடனொடு","tr":"nāṭaṉoṭu","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nirai","text":"டனொ","tr":"ṭaṉo"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"பெயரும்","tr":"peyarum","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெய","tr":"peya"},{"kind":"nēr","text":"ரும்","tr":"rum"}]},{"text":"ஆறே","tr":"āṟē","foot":"tēmā","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nēr","text":"றே","tr":"ṟē"}]}]]},"ai":{"lines":[{"words":[{"surface":"நினையாய்","parts":[{"text":"நினை","lemma":"நினை","gloss":"think"},{"text":"ஆய்","lemma":"ஆய்","gloss":"you (subjunctive/imperative)"}],"gloss":"think of it"},{"surface":"வாழி","parts":[{"text":"வாழி","lemma":"வாழி","gloss":"may you live"}],"gloss":"may you live"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"தோழி","gloss":"friend"}],"gloss":"friend"},{"surface":"நனைகவுள்","parts":[{"text":"நனை","lemma":"நனை","gloss":"wet"},{"text":"கவுள்","lemma":"கவுள்","gloss":"cheek"}],"gloss":"wet cheek"}]},{"words":[{"surface":"அண்ணல்","parts":[{"text":"அண்ணல்","lemma":"அண்ணல்","gloss":"majestic/noble"}],"gloss":"majestic"},{"surface":"யானை","parts":[{"text":"யானை","lemma":"யானை","gloss":"elephant"}],"gloss":"elephant"},{"surface":"அணிமுகம்","parts":[{"text":"அணி","lemma":"அணி","gloss":"beautiful"},{"text":"முகம்","lemma":"முகம்","gloss":"face/forehead"}],"gloss":"beautiful forehead"},{"surface":"பாய்ந்தென","parts":[{"text":"பாய்ந்து","lemma":"பாய்","gloss":"having pounced"},{"text":"என","lemma":"என","gloss":"as/because"}],"gloss":"because of pouncing"}]},{"words":[{"surface":"மிகுவலி","parts":[{"text":"மிகு","lemma":"மிகு","gloss":"great"},{"text":"வலி","lemma":"வலி","gloss":"strength"}],"gloss":"great strength"},{"surface":"இரும்புலி","parts":[{"text":"இரும்","lemma":"இரும்","gloss":"dark/great"},{"text":"புலி","lemma":"புலி","gloss":"tiger"}],"gloss":"dark tiger"},{"surface":"பகுவாய்","parts":[{"text":"பகு","lemma":"பகு","gloss":"gaping/split"},{"text":"வாய்","lemma":"வாய்","gloss":"mouth"}],"gloss":"gaping mouth"},{"surface":"ஏற்றை","parts":[{"text":"ஏற்றை","lemma":"ஏற்றை","gloss":"male animal"}],"gloss":"male tiger"}]},{"words":[{"surface":"வெண்கொடு","parts":[{"text":"வெண்கொடு","lemma":"வெண்கொடு","gloss":""}],"gloss":"","split_unverified":true},{"surface":"செம்மறுக்","parts":[{"text":"செம்மறுக்","lemma":"செம்மறுக்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"கொளீஇ","parts":[{"text":"கொளீஇ","lemma":"கொளீஇ","gloss":""}],"gloss":"","split_unverified":true},{"surface":"விடர்முகைக்","parts":[{"text":"விடர்முகைக்","lemma":"விடர்முகைக்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"கோடை","parts":[{"text":"கோடை","lemma":"கோடை","gloss":"summer wind"}],"gloss":"summer wind"},{"surface":"ஒற்றிய","parts":[{"text":"ஒற்றிய","lemma":"ஒற்று","gloss":"which blew against"}],"gloss":"which blew against"},{"surface":"கருங்கால்","parts":[{"text":"கருங்","lemma":"கருமை","gloss":"black"},{"text":"கால்","lemma":"கால்","gloss":"trunk"}],"gloss":"black-trunked"},{"surface":"வேங்கை","parts":[{"text":"வேங்கை","lemma":"வேங்கை","gloss":"Vengai tree"}],"gloss":"Vengai tree"}]},{"words":[{"surface":"வாடு","parts":[{"text":"வாடு","lemma":"வாடு","gloss":"withered"}],"gloss":"withered"},{"surface":"பூஞ்சினை","parts":[{"text":"பூஞ்சினை","lemma":"பூஞ்சினை","gloss":"flowering branch"}],"gloss":"flowering branch","split_unverified":true},{"surface":"இல்","parts":[{"text":"இல்","lemma":"இல்","gloss":"in/on"}],"gloss":"on"},{"surface":"கிடக்கும்","parts":[{"text":"கிட","lemma":"கிட","gloss":"lie/rest"},{"text":"க்கும்","lemma":"உம்","gloss":"habitual future relative participle suffix"}],"gloss":"lies resting"}]},{"words":[{"surface":"உயர்வரை","parts":[{"text":"உயர்","lemma":"உயர்","gloss":"high"},{"text":"வரை","lemma":"வரை","gloss":"mountain"}],"gloss":"high mountain"},{"surface":"நாடனொடு","parts":[{"text":"நாடன்","lemma":"நாடன்","gloss":"lord of the land"},{"text":"ஒடு","lemma":"ஒடு","gloss":"with"}],"gloss":"with the lord of the land"},{"surface":"பெயரும்","parts":[{"text":"பெயரும்","lemma":"பெயர்","gloss":"departing"}],"gloss":"departing"},{"surface":"ஆறே","parts":[{"text":"ஆறு","lemma":"ஆறு","gloss":"path"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"the path indeed"}]}],"literal":"Think of it, may you live, friend! The wet-cheeked / majestic elephant's beautiful face, because [it] pounced, / the very strong dark tiger with a gaping mouth, the male, / making [its] white tusk take a red stain, in the mountain cleft cave, / where the summer wind blew against the black-trunked Vengai tree, / on the withered flowering branch, lies [resting]. / Such is the path of departing with the lord of the high mountains.","translation":"May you live, my friend! Think of this: The male tiger of immense strength and gaping mouth, having pounced upon the beautiful forehead of a majestic elephant with wet cheeks, stains its white tusks with red blood. In a mountain cleft cave, where the summer wind blows against the black-trunked Vengai tree, the tiger lies resting on its withered, flowering branches. Such is the difficult mountain path you must traverse to depart with the lord of the high peaks.","modern":"தோழியே! நீ வாழ்வாயாக! மதநீர் வழியும் கன்னங்களை உடைய பெருமையுள்ள யானையின் அழகான முகத்தில் பாய்ந்ததால், மிகுந்த வலிமையையும் பிளந்த வாயையும் உடைய கரிய வரிகளை உடைய ஆண் புலி, யானையின் வெண்மையான தந்தத்தில் சிவந்த குருதி கறையாகப் படியுமாறு செய்துவிட்டு, மலைப்பிளவிலுள்ள குகைக்கு அருகில், கோடைக்காலக் காற்று மோதிய கரிய அடிமரத்தைக் கொண்ட வேங்கை மரத்தின் வாடிய பூக்களைக் கொண்ட கிளையின் மீது படுத்துக் கிடக்கும். அத்தகைய உயர்ந்த மலைநாட்டிற்குரிய தலைவனுடன் நீ உடன்போக்குச் செல்லும் வழி இதுவேயாகும். இதனைச் சிந்தித்துப் பார்.","explanation":"The companion is speaking to the heroine who is planning to elope with her lover, the lord of the high mountains. She describes the perilous path they must take through the arid wasteland. The poem vividly depicts a powerful male tiger that has just attacked a majestic elephant, staining the elephant's white tusks with red blood. Afterward, the tiger lies resting on the withered, flowering branches of a black-trunked Vengai tree near a mountain cave where the hot summer wind blows. Through this intense imagery, the companion warns the heroine of the extreme dangers of the journey, urging her to think carefully before embarking on this path with her lord.","model":"gemini-3.5-flash"}}