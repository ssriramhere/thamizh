{"text":"kuruntokai","n":143,"lines":["அழிய லாயிழை அன்பு பெரிதுடையன்","பழியும் அஞ்சும் பயமலை நாடன்","நில்லா மையே நிலையிற் றாகலின்","நல்லிசை வேட்ட நயனுடை நெஞ்சிற்","கடப்பாட் டாள னுடைப்பொருள் போலத்","தங்குதற் குரிய தன்றுநின்","அங்கலுழ் மேனிப் பாய பசப்பே"],"tr":["aḻiya lāyiḻai aṉpu perituṭaiyaṉ","paḻiyum añcum payamalai nāṭaṉ","nillā maiyē nilaiyiṟ ṟākaliṉ","nallicai vēṭṭa nayaṉuṭai neñciṟ","kaṭappāṭ ṭāḷa ṉuṭaipporuḷ pōlat","taṅkutaṟ kuriya taṉṟuniṉ","aṅkaluḻ mēṉip pāya pacappē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"மதுரைக் கணக்காயனார் மகனார் நக்கீரனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Maturaik Kaṇakkāyaṉār Makaṉār Nakkīraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 15, āciriyattaḷai 10, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அழிய","tr":"aḻiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"அழி","tr":"aḻi"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"லாயிழை","tr":"lāyiḻai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"லா","tr":"lā"},{"kind":"nirai","text":"யிழை","tr":"yiḻai"}]},{"text":"அன்பு","tr":"aṉpu","foot":"tēmā","acai":[{"kind":"nēr","text":"அன்","tr":"aṉ"},{"kind":"nēr","text":"பு","tr":"pu"}]},{"text":"பெரிதுடையன்","tr":"perituṭaiyaṉ","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"பெரி","tr":"peri"},{"kind":"nirai","text":"துடை","tr":"tuṭai"},{"kind":"nēr","text":"யன்","tr":"yaṉ"}]}],[{"text":"பழியும்","tr":"paḻiyum","foot":"puḷimā","acai":[{"kind":"nirai","text":"பழி","tr":"paḻi"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"அஞ்சும்","tr":"añcum","foot":"tēmā","acai":[{"kind":"nēr","text":"அஞ்","tr":"añ"},{"kind":"nēr","text":"சும்","tr":"cum"}]},{"text":"பயமலை","tr":"payamalai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பய","tr":"paya"},{"kind":"nirai","text":"மலை","tr":"malai"}]},{"text":"நாடன்","tr":"nāṭaṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"டன்","tr":"ṭaṉ"}]}],[{"text":"நில்லா","tr":"nillā","foot":"tēmā","acai":[{"kind":"nēr","text":"நில்","tr":"nil"},{"kind":"nēr","text":"லா","tr":"lā"}]},{"text":"மையே","tr":"maiyē","foot":"tēmā","acai":[{"kind":"nēr","text":"மை","tr":"mai"},{"kind":"nēr","text":"யே","tr":"yē"}]},{"text":"நிலையிற்","tr":"nilaiyiṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"நிலை","tr":"nilai"},{"kind":"nēr","text":"யிற்","tr":"yiṟ"}]},{"text":"றாகலின்","tr":"ṟākaliṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"றா","tr":"ṟā"},{"kind":"nirai","text":"கலின்","tr":"kaliṉ"}]}],[{"text":"நல்லிசை","tr":"nallicai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நல்","tr":"nal"},{"kind":"nirai","text":"லிசை","tr":"licai"}]},{"text":"வேட்ட","tr":"vēṭṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"வேட்","tr":"vēṭ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"நயனுடை","tr":"nayaṉuṭai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நய","tr":"naya"},{"kind":"nirai","text":"னுடை","tr":"ṉuṭai"}]},{"text":"நெஞ்சிற்","tr":"neñciṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"நெஞ்","tr":"neñ"},{"kind":"nēr","text":"சிற்","tr":"ciṟ"}]}],[{"text":"கடப்பாட்","tr":"kaṭappāṭ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கடப்","tr":"kaṭap"},{"kind":"nēr","text":"பாட்","tr":"pāṭ"}]},{"text":"டாள","tr":"ṭāḷa","foot":"tēmā","acai":[{"kind":"nēr","text":"டா","tr":"ṭā"},{"kind":"nēr","text":"ள","tr":"ḷa"}]},{"text":"னுடைப்பொருள்","tr":"ṉuṭaipporuḷ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"னுடைப்","tr":"ṉuṭaip"},{"kind":"nirai","text":"பொருள்","tr":"poruḷ"}]},{"text":"போலத்","tr":"pōlat","foot":"tēmā","acai":[{"kind":"nēr","text":"போ","tr":"pō"},{"kind":"nēr","text":"லத்","tr":"lat"}]}],[{"text":"தங்குதற்","tr":"taṅkutaṟ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தங்","tr":"taṅ"