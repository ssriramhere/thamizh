ய","gloss":"yield/fruit"}],"gloss":"fruitful"},{"surface":"மலை","parts":[{"text":"மலை","lemma":"மலை","gloss":"mountain"}],"gloss":"mountain"},{"surface":"நாடன்","parts":[{"text":"நாடு","lemma":"நாடு","gloss":"land"},{"text":"அன்","lemma":"அன்","gloss":"he (masculine singular suffix)"}],"gloss":"lord of the land"}]},{"words":[{"surface":"நில்லாமையே","parts":[{"text":"நில்","lemma":"நில்","gloss":"stay"},{"text":"ஆ","lemma":"ஆ","gloss":"negative"},{"text":"மை","lemma":"மை","gloss":"nominalizer"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"impermanence indeed"},{"surface":"நிலையிற்று","parts":[{"text":"நிலை","lemma":"நிலை","gloss":"state"},{"text":"இற்று","lemma":"இற்று","gloss":"pronominal suffix"}],"gloss":"is the established state"},{"surface":"ஆகலின்","parts":[{"text":"ஆகு","lemma":"ஆகு","gloss":"become"},{"text":"அல்","lemma":"அல்","gloss":"verbal noun"},{"text":"இன்","lemma":"இன்","gloss":"because"}],"gloss":"because"}]},{"words":[{"surface":"நல்","parts":[{"text":"நல்","lemma":"நல்","gloss":"good"}],"gloss":"good"},{"surface":"இசை","parts":[{"text":"இசை","lemma":"இசை","gloss":"fame"}],"gloss":"fame"},{"surface":"வேட்ட","parts":[{"text":"வேள்","lemma":"வேள்","gloss":"desire"},{"text":"த","lemma":"த","gloss":"past relative participle"}],"gloss":"desired"},{"surface":"நயன்","parts":[{"text":"நயன்","lemma":"நயன்","gloss":"benevolence"}],"gloss":"benevolence"},{"surface":"உடை","parts":[{"text":"உடை","lemma":"உடை","gloss":"possessing"}],"gloss":"possessing"},{"surface":"நெஞ்சின்","parts":[{"text":"நெஞ்சு","lemma":"நெஞ்சு","gloss":"heart"},{"text":"இன்","lemma":"இன்","gloss":"of"}],"gloss":"of the heart"}]},{"words":[{"surface":"கடப்பாட்டாளன்","parts":[{"text":"கடப்பாட்டாளன்","lemma":"கடப்பாட்டாளன்","gloss":"dutiful person"}],"gloss":"dutiful person","split_unverified":true},{"surface":"உடை","parts":[{"text":"உடை","lemma":"உடை","gloss":"owned"}],"gloss":"owned"},{"surface":"பொருள்","parts":[{"text":"பொருள்","lemma":"பொருள்","gloss":"wealth"}],"gloss":"wealth"},{"surface":"போல","parts":[{"text":"போல்","lemma":"போல்","gloss":"resemble"},{"text":"அ","lemma":"அ","gloss":"infinitive"}],"gloss":"like"}]},{"words":[{"surface":"தங்குதற்கு","parts":[{"text":"தங்குதற்கு","lemma":"தங்குதற்கு","gloss":"to stay"}],"gloss":"to stay","split_unverified":true},{"surface":"உரியது","parts":[{"text":"உரிய","lemma":"உரிய","gloss":"appropriate"},{"text":"து","lemma":"து","gloss":"neuter singular"}],"gloss":"appropriate thing"},{"surface":"அன்று","parts":[{"text":"அன்று","lemma":"அன்று","gloss":"is not"}],"gloss":"is not","split_unverified":true},{"surface":"நின்","parts":[{"text":"நின்","lemma":"நின்","gloss":"your"}],"gloss":"your","split_unverified":true}]},{"words":[{"surface":"அம்","parts":[{"text":"அம்","lemma":"அம்","gloss":"beautiful"}],"gloss":"beautiful"},{"surface":"கலுழ்","parts":[{"text":"கலுழ்","lemma":"கலுழ்","gloss":"dimmed/weeping"}],"gloss":"dimmed"},{"surface":"மேனி","parts":[{"text":"மேனி","lemma":"மேனி","gloss":"body"}],"gloss":"body"},{"surface":"பாய","parts":[{"text":"பாய்","lemma":"பாய்","gloss":"spread"},{"text":"அ","lemma":"அ","gloss":"relative participle"}],"gloss":"spread"},{"surface":"பசப்பே","parts":[{"text":"பசப்பு","lemma":"பசப்பு","gloss":"pallor"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"pallor indeed"}]}],"literal":"Do not grieve, O wearer of choice jewels! He has great love, / and he fears blame, the lord of the fruitful mountain land. / Since impermanence itself is the established nature of things, / like the wealth owned by a dutiful person of benevolent heart / who desires good fame, / it is not fit to stay, your / pallor that has spread over your beautiful, dimmed body.","translation":"Do not grieve, O wearer of choice jewels! The lord of the fruitful mountain land has great love for you and fears blame. Since impermanence is the very nature of this world, the pallor that has spread over your beautiful, tear-stained body is not destined to stay forever—just like the wealth of a generous, dutiful man who desires noble fame.","modern":"தேர்ந்தெடுத்த அணிகலன்களை அணிந்தவளே! வருந்தாதே. பயன் தரும் மலைநாட்டிற்குத் தலைவன் உன் மேல் மிகுந்த அன்பு உடையவன்; அவன் பழிக்கும் அஞ்சுவான். உலகில் நிலையாமை ஒன்றே நிலையான பண்பு என்பதால், நல்ல புகழை விரும்பும் கொடையாளியின் செல்வம் பிறருக்குப் பயன்பட்டு அவனிடம் தங்காமல் போவது போல, உன்னுடைய அழகிய, வருத்தமுற்ற உடம்பில் பரவியுள்ள இந்தப் பசலை நோயும் உன்னிடம் நிலைத்துத் தங்காது; விரைவில் நீங்கும்.","explanation":"The friend is speaking to the heroine to console her during the hero's temporary absence. The heroine is pining, which has caused a yellowish-green pallor (பசலை) to spread over her body. The friend reassures her that the hero, who is the lord of the fruitful mountains, loves her deeply and fears the blame of abandoning her. She uses a philosophical truth—that impermanence is the only permanent thing in life—to comfort her. She compares the heroine's pallor to the wealth of a generous, dutiful philanthropist (கடப்பாட்டாளன்). Just as a philanthropist's wealth does not stay with him because he constantly gives it away to those in need, the painful pallor will not stay on the heroine's body; it will vanish as soon as the hero returns.","model":"gemini-3.5-flash"}}