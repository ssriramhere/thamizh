{"text":"kuruntokai","n":110,"lines":["வாரா ராயினும் வரினும் அவர்நமக்கு","யாரா கியரோ தோழி நீர","நீலப் பைம்போ துளரிப் புதல","பீலி ஒண்பொறிக் கருவிளை யாட்டி","நுண்முள் ஈங்கைச் செவ்வரும் பூழ்த்த","வண்ணத் துய்ம்மலர் உதிரத் தண்ணென்று","இன்னா தெறிதரும் வாடையொடு","என்னா யினள்கொல் என்னா தோரே"],"tr":["vārā rāyiṉum variṉum avarnamakku","yārā kiyarō tōḻi nīra","nīlap paimpō tuḷarip putala","pīli oṇpoṟik karuviḷai yāṭṭi","nuṇmuḷ īṅkaic cevvarum pūḻtta","vaṇṇat tuymmalar utirat taṇṇeṉṟu","iṉṉā teṟitarum vāṭaiyoṭu","eṉṉā yiṉaḷkol eṉṉā tōrē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"கிள்ளிமங்கலங்கிழார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kiḷḷimaṅkalaṅkiḻār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28, veṇcīr 2, vañcicīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 11, oṉṟā vañcittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வாரா","tr":"vārā","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ரா","tr":"rā"}]},{"text":"ராயினும்","tr":"rāyiṉum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ரா","tr":"rā"},{"kind":"nirai","text":"யினும்","tr":"yiṉum"}]},{"text":"வரினும்","tr":"variṉum","foot":"puḷimā","acai":[{"kind":"nirai","text":"வரி","tr":"vari"},{"kind":"nēr","text":"னும்","tr":"ṉum"}]},{"text":"அவர்நமக்கு","tr":"avarnamakku","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"அவர்","tr":"avar"},{"kind":"nirai","text":"நமக்","tr":"namak"},{"kind":"nēr","text":"கு","tr":"ku"}]}],[{"text":"யாரா","tr":"yārā","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"ரா","tr":"rā"}]},{"text":"கியரோ","tr":"kiyarō","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிய","tr":"kiya"},{"kind":"nēr","text":"ரோ","tr":"rō"}]},{"text":"தோழி","tr"