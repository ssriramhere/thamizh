{"text":"kuruntokai","n":88,"lines":["ஒலிவெள் ளருவி ஓங்குமலை நாடன்","சிறுகண் பெருங்களிறு வயப்புலி தாக்கித்","தொல்முரண் சோருந் துன்னருஞ் சாரல்","நடுநாள் வருதலும் வரூஉம்","வடுநா ணலமே தோழி நாமே"],"tr":["oliveḷ ḷaruvi ōṅkumalai nāṭaṉ","ciṟukaṇ peruṅkaḷiṟu vayappuli tākkit","tolmuraṇ cōrun tuṉṉaruñ cāral","naṭunāḷ varutalum varūum","vaṭunā ṇalamē tōḻi nāmē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"மதுரைக் கதக்கண்ணனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Maturaik Katakkaṇṇaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 11, āciriyattaḷai 6, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஒலிவெள்","tr":"oliveḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"ஒலி","tr":"oli"},{"kind":"nēr","text":"வெள்","tr":"veḷ"}]},{"text":"ளருவி","tr":"ḷaruvi","foot":"puḷimā","acai":[{"kind":"nirai","text":"ளரு","tr":"ḷaru"},{"kind":"nēr","text":"வி","tr":"vi"}]},{"text":"ஓங்குமலை","tr":"ōṅkumalai","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"ஓங்","tr":"ōṅ"},{"kind":"nirai","text":"கும","tr":"kuma"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"நாடன்","tr":"nāṭaṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"டன்","tr":"ṭaṉ"}]}],[{"text":"சிறுகண்","tr":"ciṟukaṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nēr","text":"கண்","tr":"kaṇ"}]},{"text":"பெருங்களிறு","tr":"peruṅkaḷiṟu","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"பெருங்","tr":"peruṅ"},{"kind":"nirai","text":"களி","tr":"kaḷi"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"வயப்புலி","tr":"vayappuli","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வயப்","tr":"vayap"},{"kind":"nirai","text":"புலி","tr":"puli"}]},