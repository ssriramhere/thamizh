high"},{"text":"மலை","lemma":"மலை","gloss":"mountain"}],"gloss":"high mountain"},{"surface":"நாடன்","parts":[{"text":"நாடு","lemma":"நாடு","gloss":"land"},{"text":"அன்","lemma":"அன்","gloss":"masculine singular suffix"}],"gloss":"lord of the land"}]},{"words":[{"surface":"சிறுகண்","parts":[{"text":"சிறு","lemma":"சிறுமை","gloss":"small"},{"text":"கண்","lemma":"கண்","gloss":"eye"}],"gloss":"small-eyed"},{"surface":"பெருங்களிறு","parts":[{"text":"பெருங்களிறு","lemma":"பெருங்களிறு","gloss":"large male elephant"}],"gloss":"large male elephant","split_unverified":true},{"surface":"வயப்புலி","parts":[{"text":"வய","lemma":"வயம்","gloss":"strong"},{"text":"புலி","lemma":"புலி","gloss":"tiger"}],"gloss":"strong tiger"},{"surface":"தாக்கித்","parts":[{"text":"தாக்கு","lemma":"தாக்கு","gloss":"attack"},{"text":"இ","lemma":"இ","gloss":"past participle suffix"},{"text":"த்","lemma":"த்","gloss":"sandhi consonant"}],"gloss":"having attacked"}]},{"words":[{"surface":"தொல்முரண்","parts":[{"text":"தொல்","lemma":"தொன்மை","gloss":"ancient"},{"text":"முரண்","lemma":"முரண்","gloss":"strength"}],"gloss":"ancient strength"},{"surface":"சோருந்","parts":[{"text":"சோர்","lemma":"சோர்","gloss":"become weak"},{"text":"உம்","lemma":"உம்","gloss":"habitual suffix"},{"text":"ந்","lemma":"ந்","gloss":"sandhi change of m"}],"gloss":"which exhausts"},{"surface":"துன்னருஞ்","parts":[{"text":"துன்னு","lemma":"துன்னு","gloss":"approach"},{"text":"அரு","lemma":"அருமை","gloss":"difficult"},{"text":"உம்","lemma":"உம்","gloss":"adjectival suffix"},{"text":"ஞ்","lemma":"ஞ்","gloss":"sandhi change of m"}],"gloss":"difficult to approach"},{"surface":"சாரல்","parts":[{"text":"சாரல்","lemma":"சாரல்","gloss":"mountain slope"}],"gloss":"mountain slope"}]},{"words":[{"surface":"நடுநாள்","parts":[{"text":"நடு","lemma":"நடு","gloss":"middle"},{"text":"நாள்","lemma":"நாள்","gloss":"night"}],"gloss":"midnight"},{"surface":"வருதலும்","parts":[{"text":"வருதல்","lemma":"வருதல்","gloss":"coming"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"even coming"},{"surface":"வரூஉம்","parts":[{"text":"வரூஉம்","lemma":"வரூஉம்","gloss":"will come"}],"gloss":"will come","split_unverified":true}]},{"words":[{"surface":"வடு","parts":[{"text":"வடு","lemma":"வடு","gloss":"blemish"}],"gloss":"blemish"},{"surface":"நாணலமே","parts":[{"text":"நாண்","lemma":"நாண்","gloss":"modesty"},{"text":"நலம்","lemma":"நலம்","gloss":"goodness"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"virtue of modesty"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"தோழி","gloss":"friend"}],"gloss":"O friend"},{"surface":"நாமே","parts":[{"text":"நாம்","lemma":"நாம்","gloss":"we"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"we"}]}],"literal":"Sounding white waterfall high mountain lord of the land / small-eyed large male elephant strong tiger having attacked / ancient strength exhausting difficult to approach mountain slope / midnight even coming will come / blemish modesty-virtue O friend we","translation":"O friend! The lord of the high mountain land of roaring white waterfalls, where even the ancient strength of a small-eyed, massive male elephant is exhausted when attacked by a fierce tiger on the difficult-to-reach slopes, continues to come to us at midnight. If he does, what will become of our virtue of modesty, which fears any blemish?","modern":"ஒலிக்கும் வெள்ளிய அருவிகளைக் கொண்ட உயர்ந்த மலைநாட்டிற்குத் தலைவன், சிறிய கண்களைக் கொண்ட பெரிய ஆண் யானை வலிமையான புலியால் தாக்கப்பட்டுத் தன் பழமையான வலிமையையெல்லாம் இழந்து சோர்ந்துபோகும், அணுகுதற்கரிய மலைச்சாரல் வழியே நள்ளிரவில் வருகிறான். தோழியே! அவன் அவ்வாறு வருவதால், பழிச்சொல்லுக்கு அஞ்சும் நம்முடைய நாணமாகிய நற்பண்பு என்னவாகுமோ?","explanation":"This poem is spoken by the heroine's friend to the heroine, but it is intended to be overheard by the hero who is waiting nearby. The friend describes the dangerous path the hero takes to meet the heroine at night. The mountain slopes are so perilous that even a mighty, large male elephant loses its ancient strength when attacked by a fierce tiger. By highlighting this danger, the friend subtly urges the hero to stop these risky nightly visits and instead seek a formal, public marriage. The mention of 'modesty fearing blemish' reflects the heroine's anxiety over both the hero's safety and the potential gossip that could ruin her virtue. This imagery of the tiger and elephant perfectly fits the Kuriñci (mountain) landscape, symbolizing the intense passion and the inherent dangers of secret love.","model":"gemini-3.5-flash"}}