{"text":"kuruntokai","n":9,"lines":["யாயா கியளே மாஅ யோளே","மடைமாண் செப்பில் தமிய வைகிய","பெய்யாப் பூவின் மெய்சா யினளே","பாசடை நிவந்த கணைக்கால் நெய்தல்","இனமீ னிருங்கழி யோத மல்குதொறும்","கயமூழ்கு மகளிர் கண்ணின் மானும்","தண்ணந் துறைவன் கொடுமை","நம்மு னாணிக் கரப்பா டும்மே"],"tr":["yāyā kiyaḷē māa yōḷē","maṭaimāṇ ceppil tamiya vaikiya","peyyāp pūviṉ meycā yiṉaḷē","pācaṭai nivanta kaṇaikkāl neytal","iṉamī ṉiruṅkaḻi yōta malkutoṟum","kayamūḻku makaḷir kaṇṇiṉ māṉum","taṇṇan tuṟaivaṉ koṭumai","nammu ṉāṇik karappā ṭummē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தோழி கூற்று","poet_ta":"கயமனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kayamaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 29, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 12, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"யாயா","tr":"yāyā","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"யா","tr":"yā"}]},{"text":"கியளே","tr":"kiyaḷē","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிய","tr":"kiya"},{"kind":"nēr","text":"ளே","tr":"ḷē"}]},{"text":"மாஅ","tr":"māa","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"அ","tr":"a"}]},{"text":"யோளே","tr":"yōḷē","foot":"tēmā","acai":[{"kind":"nēr","text":"யோ","tr":"yō"},{"kind":"nēr","text":"ளே","tr":"ḷē"}]}],[{"text":"மடைமாண்","tr":"maṭaimāṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மடை","tr":"maṭai"},{"kind":"nēr","text":"மாண்","tr":"māṇ"}]},{"text":"செப்பில்","tr":"ceppil","foot":"tēmā","acai":[{"kind":"nēr","text":"செப்","tr":"cep"},{"kind":"nēr","text":"பில்","tr":"pil"}]},{"text":"தமிய","tr":"tamiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"தமி","tr":"tami"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"வைகிய","tr":"v