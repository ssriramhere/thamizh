{"text":"kuruntokai","n":271,"lines":["அருவி யன்ன பருவறை சிதறி","யாறுநிறை பகரு நாடனைத் தேறி","உற்றது மன்னு மொருநாள் மற்றது","தவப்பன் னாள்தோள் மயங்கி","வௌவும் பண்பின் நோயா கின்றே"],"tr":["aruvi yaṉṉa paruvaṟai citaṟi","yāṟuniṟai pakaru nāṭaṉait tēṟi","uṟṟatu maṉṉu morunāḷ maṟṟatu","tavappaṉ ṉāḷtōḷ mayaṅki","vauvum paṇpiṉ nōyā kiṉṟē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தலைவி கூற்று","poet_ta":"அழிசி நச்சாத்தனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Aḻici Naccāttaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 5, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அருவி","tr":"aruvi","foot":"puḷimā","acai":[{"kind":"nirai","text":"அரு","tr":"aru"},{"kind":"nēr","text":"வி","tr":"vi"}]},{"text":"யன்ன","tr":"yaṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"யன்","tr":"yaṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"பருவறை","tr":"paruvaṟai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பரு","tr":"paru"},{"kind":"nirai","text":"வறை","tr":"vaṟai"}]},{"text":"சிதறி","tr":"citaṟi","foot":"puḷimā","acai":[{"kind":"nirai","text":"சித","tr":"cita"},{"kind":"nēr","text":"றி","tr":"ṟi"}]}],[{"text":"யாறுநிறை","tr":"yāṟuniṟai","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nirai","text":"றுநி","tr":"ṟuni"},{"kind":"nēr","text":"றை","tr":"ṟai"}]},{"text":"பகரு","tr":"pakaru","foot":"puḷimā","acai":[{"kind":"nirai","text":"பக","tr":"paka"},{"kind":"nēr","text":"ரு","tr":"ru"}]},{"text":"நாடனைத்","tr":"nāṭaṉait","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nirai","text":"டனைத்","tr":"ṭaṉait"}]},{"text":"தேறி","tr":"tēṟi","foot":"tēmā","acai":[{"kind":"nēr","text":"தே","tr":"tē"},{"kind":"nēr"