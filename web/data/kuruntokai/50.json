{"text":"kuruntokai","n":50,"lines":["ஐயவி அன்ன சிறுவீ ஞாழல்","செவ்வி மருதின் செம்மலொடு தாஅய்த்","துறைஅணிந் தன்றவ ரூரே யிறையிறந்","திலங்குவளை ஞெகிழச் சாஅய்ப்","புலம்பணிந் தன்றவர் மணந்த தோளே"],"tr":["aiyavi aṉṉa ciṟuvī ñāḻal","cevvi marutiṉ cemmaloṭu tāayt","tuṟaiaṇin taṉṟava rūrē yiṟaiyiṟan","tilaṅkuvaḷai ñekiḻac cāayp","pulampaṇin taṉṟavar maṇanta tōḷē"],"colophon":{"tinai":"marutam","tinai_ta":"மருதம்","speaker_ta":"தலைவி கூற்று","poet_ta":"குன்றியனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Kuṉṟiyaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 10, āciriyattaḷai 7, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஐயவி","tr":"aiyavi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஐ","tr":"ai"},{"kind":"nirai","text":"யவி","tr":"yavi"}]},{"text":"அன்ன","tr":"aṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"அன்","tr":"aṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"சிறுவீ","tr":"ciṟuvī","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nēr","text":"வீ","tr":"vī"}]},{"text":"ஞாழல்","tr":"ñāḻal","foot":"tēmā","acai":[{"kind":"nēr","text":"ஞா","tr":"ñā"},{"kind":"nēr","text":"ழல்","tr":"ḻal"}]}],[{"text":"செவ்வி","tr":"cevvi","foot":"tēmā","acai":[{"kind":"nēr","text":"செவ்","tr":"cev"},{"kind":"nēr","text":"வி","tr":"vi"}]},{"text":"மருதின்","tr":"marutiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மரு","tr":"maru"},{"kind":"nēr","text":"தின்","tr":"tiṉ"}]},{"text":"செம்மலொடு","tr":"cemmaloṭu","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"செம்","tr":"cem"},{"kind":"nirai","text":"மலொ","tr":"malo"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"தாஅய்த்","tr":"tāayt","foot":"tēmā","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":