{"text":"kuruntokai","n":310,"lines":["புள்ளும் புலம்பின பூவிங் கூம்பின","கானலும் புலம்புநனி யுடைத்தே வானமும்","நம்மே போலும் மம்மர்த் தாகி","எல்லைகழியப் புல்லென் றன்றே","இன்னும் உளெனே தோழி இந்நிலை","தண்ணிய கமழுஞாழல்","தண்ணந் துறைவர்க் குரைக்குநர்ப் பெறினே"],"tr":["puḷḷum pulampiṉa pūviṅ kūmpiṉa","kāṉalum pulampunaṉi yuṭaittē vāṉamum","nammē pōlum mammart tāki","ellaikaḻiyap pulleṉ ṟaṉṟē","iṉṉum uḷeṉē tōḻi innilai","taṇṇiya kamaḻuñāḻal","taṇṇan tuṟaivark kuraikkunarp peṟiṉē"],"colophon":{"tinai":"neytal","tinai_ta":"நெய்தல்","speaker_ta":"தலைவி கூற்று","poet_ta":"பெருங்கண்ணனார்","speaker_en":"the heroine (talaivi)","poet_tr":"Peruṅkaṇṇaṉār"},"scan":{"meter":"iṇaikkuṟaḷ āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3, 1×2 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 2, other 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 9, kalittaḷai 1, ? 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"புள்ளும்","tr":"puḷḷum","foot":"tēmā","acai":[{"kind":"nēr","text":"புள்","tr":"puḷ"},{"kind":"nēr","text":"ளும்","tr":"ḷum"}]},{"text":"புலம்பின","tr":"pulampiṉa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"புலம்","tr":"pulam"},{"kind":"nirai","text":"பின","tr":"piṉa"}]},{"text":"பூவிங்","tr":"pūviṅ","foot":"tēmā","acai":[{"kind":"nēr","text":"பூ","tr":"pū"},{"kind":"nēr","text":"விங்","tr":"viṅ"}]},{"text":"கூம்பின","tr":"kūmpiṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கூம்","tr":"kūm"},{"kind":"nirai","text":"பின","tr":"piṉa"}]}],[{"text":"கானலும்","tr":"kāṉalum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"னலும்","tr":"ṉalum"}]},{"text":"புலம்புநனி","tr":"pulampunaṉi","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"புலம்","tr":"pulam"},{"kind":"nirai","text":"புந","tr":"puna"},{"kind":"nēr","text":"னி","tr":"ṉi"}]},{"text":"யுடைத்தே","tr":"yuṭaittē","foot":"p