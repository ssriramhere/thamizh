":[{"kind":"nirai","text":"கம","tr":"kama"},{"kind":"nirai","text":"ழுஞா","tr":"ḻuñā"},{"kind":"nēr","text":"ழல்","tr":"ḻal"}]}],[{"text":"தண்ணந்","tr":"taṇṇan","foot":"tēmā","acai":[{"kind":"nēr","text":"தண்","tr":"taṇ"},{"kind":"nēr","text":"ணந்","tr":"ṇan"}]},{"text":"துறைவர்க்","tr":"tuṟaivark","foot":"puḷimā","acai":[{"kind":"nirai","text":"துறை","tr":"tuṟai"},{"kind":"nēr","text":"வர்க்","tr":"vark"}]},{"text":"குரைக்குநர்ப்","tr":"kuraikkunarp","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குரைக்","tr":"kuraik"},{"kind":"nirai","text":"குநர்ப்","tr":"kunarp"}]},{"text":"பெறினே","tr":"peṟiṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெறி","tr":"peṟi"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"புள்ளும்","parts":[{"text":"புள்","lemma":"puḷ","gloss":"bird"},{"text":"உம்","lemma":"um","gloss":"also"}],"gloss":"birds also"},{"surface":"புலம்பின","parts":[{"text":"புலம்பின","lemma":"pulampu","gloss":"lamented"}],"gloss":"lamented"},{"surface":"பூவிங்","parts":[{"text":"பூவிங்","lemma":"பூவிங்","gloss":"flowers here"}],"gloss":"flowers here","split_unverified":true},{"surface":"கூம்பின","parts":[{"text":"கூம்பின","lemma":"kūmpu","gloss":"closed"}],"gloss":"closed"}]},{"words":[{"surface":"கானலும்","parts":[{"text":"கானல்","lemma":"kāṉal","gloss":"seashore grove"},{"text":"உம்","lemma":"um","gloss":"also"}],"gloss":"the seashore grove also"},{"surface":"புலம்புநனி","parts":[{"text":"புலம்பு","lemma":"pulampu","gloss":"loneliness"},{"text":"நனி","lemma":"naṉi","gloss":"much"}],"gloss":"much loneliness"},{"surface":"யுடைத்தே","parts":[{"text":"யுடைத்தே","lemma":"யுடைத்தே","gloss":"possesses indeed"}],"gloss":"possesses indeed","split_unverified":true},{"surface":"வானமும்","parts":[{"text":"வானம்","lemma":"vāṉam","gloss":"sky"},{"text":"உம்","lemma":"um","gloss":"also"}],"gloss":"the sky also"}]},{"words":[{"surface":"நம்மே","parts":[{"text":"நம்","lemma":"nam","gloss":"us"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"us indeed"},{"surface":"போலும்","parts":[{"text":"போலும்","lemma":"pōl","gloss":"resembling"}],"gloss":"resembling"},{"surface":"மம்மர்த்","parts":[{"text":"மம்மர்த்","lemma":"மம்மர்த்","gloss":"distress"}],"gloss":"distress","split_unverified":true},{"surface":"தாகி","parts":[{"text":"தாகி","lemma":"தாகி","gloss":"having become"}],"gloss":"having become","split_unverified":true}]},{"words":[{"surface":"எல்லைகழியப்","parts":[{"text":"எல்லைகழியப்","lemma":"எல்லைகழியப்","gloss":"as daylight passes"}],"gloss":"as daylight passes","split_unverified":true},{"surface":"புல்லென்","parts":[{"text":"புல்","lemma":"pul","gloss":"dim"},{"text":"என்","lemma":"eṉ","gloss":"say"}],"gloss":"becoming dim"},{"surface":"றன்றே","parts":[{"text":"றன்றே","lemma":"றன்றே","gloss":"it became indeed"}],"gloss":"it became indeed","split_unverified":true}]},{"words":[{"surface":"இன்னும்","parts":[{"text":"இன்னும்","lemma":"iṉṉum","gloss":"still"}],"gloss":"still"},{"surface":"உளெனே","parts":[{"text":"உளெனே","lemma":"உளெனே","gloss":"I exist indeed"}],"gloss":"I exist indeed","split_unverified":true},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"tōḻi","gloss":"friend"}],"gloss":"O friend"},{"surface":"இந்நிலை","parts":[{"text":"இந்நிலை","lemma":"இந்நிலை","gloss":"this state"}],"gloss":"this state","split_unverified":true}]},{"words":[{"surface":"தண்ணிய","parts":[{"text":"தண்ணிய","lemma":"taṇ","gloss":"cool"}],"gloss":"cool"},{"surface":"கமழுஞாழல்","parts":[{"text":"கமழும்","lemma":"kamaḻ","gloss":"fragrant"},{"text":"ஞாழல்","lemma":"ñāḻal","gloss":"ñāḻal tree"}],"gloss":"fragrant ñāḻal tree"}]},{"words":[{"surface":"தண்ணந்","parts":[{"text":"தண்ணந்","lemma":"தண்ணந்","gloss":"cool and beautiful"}],"gloss":"cool and beautiful","split_unverified":true},{"surface":"துறைவர்க்","parts":[{"text":"துறைவர்க்","lemma":"துறைவர்க்","gloss":"to the lord of the shore"}],"gloss":"to the lord of the shore","split_unverified":true},{"surface":"குரைக்குநர்ப்","parts":[{"text":"குரைக்குநர்ப்","lemma":"குரைக்குநர்ப்","gloss":"those who would tell"}],"gloss":"those who would tell","split_unverified":true},{"surface":"பெறினே","parts":[{"text":"பெறின்","lemma":"peṟu","gloss":"if obtain"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"if only I could find"}]}],"literal":"Birds also lamented, flowers here closed / the seashore grove also possesses much loneliness, the sky also / resembling us indeed, having become distressed / as daylight passes, it became dim indeed / I still exist indeed, O friend, in this state / cool, fragrant ñāḻal tree / if only I could find those who would tell the lord of the cool, beautiful shore","translation":"The birds have fallen silent and lament, and the flowers here have closed. The seashore grove, too, is filled with deep loneliness. The sky, resembling us, has grown distressed and dim as daylight fades away. Yet, O friend, I still survive in this state. If only I could find someone to go and tell the lord of the cool, beautiful shore, where the cool ñāḻal trees bloom with fragrance!","modern":"பறவைகளும் வருந்தி ஒலித்தன; இங்குள்ள பூக்களும் குவிந்தன. கடற்கரைச் சோலையும் மிகுந்த தனிமையைக் கொண்டுள்ளது. வானமும் நம்மைப் போலவே மயக்கமுற்று, பகல் பொழுது கழிந்தவுடன் பொலிவிழந்துவிட்டது. தோழியே! குளிர்ந்த, நறுமணம் வீசும் ஞாழல் மரங்கள் நிறைந்த குளிர்ந்த கடற்கரைத் தலைவனுக்கு என் நிலையைச் சொல்லக்கூடிய ஒருவரைப் பெற்றால், இந்நிலையிலும் நான் உயிர் பிழைத்திருப்பேன்.","explanation":"The heroine is speaking to her confidante during the evening, expressing her deep grief over the hero's absence. This poem belongs to the neytal (seashore) landscape, which traditionally depicts the theme of pining and lamentation in separation. As evening falls, the natural world around her reflects her own sorrow: the birds fall silent, the flowers close, and the sky grows dim. She compares the darkening sky to her own distressed mind. She laments that she is still barely holding onto life in this state, and wishes she could find a messenger to convey her suffering to her lover, the lord of the cool, beautiful shore where fragrant ñāḻal trees grow.","model":"gemini-3.5-flash"}}