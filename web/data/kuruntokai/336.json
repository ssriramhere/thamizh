{"text":"kuruntokai","n":336,"lines":["செறுவர்க் குவகை யாகத் தெறுவர","ஈங்கனம் வருபவோ தேம்பாய் துறைவ","சிறுநா வொண்மணி விளரி யார்ப்பக்","கடுமா நெடுந்தேர் நேமி போகிய","இருங்கழி நெய்தல் போல","வருந்தின ளளியணீ பிரிந்திசி னோளே"],"tr":["ceṟuvark kuvakai yākat teṟuvara","īṅkaṉam varupavō tēmpāy tuṟaiva","ciṟunā voṇmaṇi viḷari yārppak","kaṭumā neṭuntēr nēmi pōkiya","iruṅkaḻi neytal pōla","varuntiṉa ḷaḷiyaṇī pirintici ṉōḷē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"குன்றியனார்","speaker_en":"her friend (tōḻi)","poet_tr":"Kuṉṟiyaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 11, āciriyattaḷai 11"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"செறுவர்க்","tr":"ceṟuvark","foot":"puḷimā","acai":[{"kind":"nirai","text":"செறு","tr":"ceṟu"},{"kind":"nēr","text":"வர்க்","tr":"vark"}]},{"text":"குவகை","tr":"kuvakai","foot":"puḷimā","acai":[{"kind":"nirai","text":"குவ","tr":"kuva"},{"kind":"nēr","text":"கை","tr":"kai"}]},{"text":"யாகத்","tr":"yākat","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"கத்","tr":"kat"}]},{"text":"தெறுவர","tr":"teṟuvara","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தெறு","tr":"teṟu"},{"kind":"nirai","text":"வர","tr":"vara"}]}],[{"text":"ஈங்கனம்","tr":"īṅkaṉam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஈங்","tr":"īṅ"},{"kind":"nirai","text":"கனம்","tr":"kaṉam"}]},{"text":"வருபவோ","tr":"varupavō","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வரு","tr":"varu"},{"kind":"nirai","text":"பவோ","tr":"pavō"}]},{"text":"தேம்பாய்","tr":"tēmpāy","foot":"tēmā","acai":[{"kind":"nēr","text":"தேம்","tr":"tēm"},{"kind":"nēr","text":"பாய்","tr":"pāy"}]},{"text":"துறைவ","tr":"tuṟaiva","foot":"puḷimā","acai":[{"kind":"nirai","text