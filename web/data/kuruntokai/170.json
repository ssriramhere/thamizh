{"text":"kuruntokai","n":170,"lines":["பலவும் கூறுகவஃ தறியா தோரே","அருவி தந்த நாட்குர லெருவை","கயனா டியானை கவள மாந்தும்","மலைகெழு நாடன் கேண்மை","தலைபோ காமைநற் கறிந்தனென் யானே"],"tr":["palavum kūṟukavaḵ taṟiyā tōrē","aruvi tanta nāṭkura leruvai","kayaṉā ṭiyāṉai kavaḷa māntum","malaikeḻu nāṭaṉ kēṇmai","talaipō kāmainaṟ kaṟintaṉeṉ yāṉē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"கருவூர்கிழார்","speaker_en":"the heroine (talaivi)","poet_tr":"Karuvūrkiḻār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 8, veṇṭaḷai 8, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பலவும்","tr":"palavum","foot":"puḷimā","acai":[{"kind":"nirai","text":"பல","tr":"pala"},{"kind":"nēr","text":"வும்","tr":"vum"}]},{"text":"கூறுகவஃ","tr":"kūṟukavaḵ","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"கூ","tr":"kū"},{"kind":"nirai","text":"றுக","tr":"ṟuka"},{"kind":"nēr","text":"வஃ","tr":"vaḵ"}]},{"text":"தறியா","tr":"taṟiyā","foot":"puḷimā","acai":[{"kind":"nirai","text":"தறி","tr":"taṟi"},{"kind":"nēr","text":"யா","tr":"yā"}]},{"text":"தோரே","tr":"tōrē","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ரே","tr":"rē"}]}],[{"text":"அருவி","tr":"aruvi","foot":"puḷimā","acai":[{"kind":"nirai","text":"அரு","tr":"aru"},{"kind":"nēr","text":"வி","tr":"vi"}]},{"text":"தந்த","tr":"tanta","foot":"tēmā","acai":[{"kind":"nēr","text":"தந்","tr":"tan"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"நாட்குர","tr":"nāṭkura","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நாட்","tr":"nāṭ"},{"kind":"nirai","text":"குர","tr":"kura"}]},{"text":"லெருவை","tr":"leruvai","foot":"puḷimā","acai":[{"kind":"nirai","text":"லெரு","tr":"leru"},{"kind":"nēr","text":"வை","t