{"text":"kuruntokai","n":176,"lines":["ஒருநாள் வாரலன் இருநாள் வாரலன்","பன்னாள் வந்து பணிமொழி பயிற்றியென்","நன்னர் நெஞ்ச நெகிழ்த்த பின்றை","வரைமுதிர் தேனிற் போகி யோனே","ஆசா கெந்தை யாண்டுளன் கொல்லோ","வேறுபுல னன்னாட்டுப் பெய்த","ஏறுடை மழையிற் கலிழும்என் னெஞ்சே"],"tr":["orunāḷ vāralaṉ irunāḷ vāralaṉ","paṉṉāḷ vantu paṇimoḻi payiṟṟiyeṉ","naṉṉar neñca nekiḻtta piṉṟai","varaimutir tēṉiṟ pōki yōṉē","ācā kentai yāṇṭuḷaṉ kollō","vēṟupula ṉaṉṉāṭṭup peyta","ēṟuṭai maḻaiyiṟ kaliḻumeṉ ṉeñcē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","poet_ta":"வருமுலையாரித்தியார்","speaker_en":"her friend (tōḻi)","poet_tr":"Varumulaiyārittiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 24, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 11"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஒருநாள்","tr":"orunāḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"ஒரு","tr":"oru"},{"kind":"nēr","text":"நாள்","tr":"nāḷ"}]},{"text":"வாரலன்","tr":"vāralaṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nirai","text":"ரலன்","tr":"ralaṉ"}]},{"text":"இருநாள்","tr":"irunāḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"இரு","tr":"iru"},{"kind":"nēr","text":"நாள்","tr":"nāḷ"}]},{"text":"வாரலன்","tr":"vāralaṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nirai","text":"ரலன்","tr":"ralaṉ"}]}],[{"text":"பன்னாள்","tr":"paṉṉāḷ","foot":"tēmā","acai":[{"kind":"nēr","text":"பன்","tr":"paṉ"},{"kind":"nēr","text":"னாள்","tr":"ṉāḷ"}]},{"text":"வந்து","tr":"vantu","foot":"tēmā","acai":[{"kind":"nēr","text":"வந்","tr":"van"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"பணிமொழி","tr":"paṇimoḻi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பணி","tr":"paṇi"},{"kind":"nirai","text":"மொழி","tr":"moḻi"}]