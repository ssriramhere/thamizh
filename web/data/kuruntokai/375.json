{"text":"kuruntokai","n":375,"lines":["அம்ம வாழி தோழி இன்றவர்","வாரா ராயினோ நன்றே சாரற்","சிறுதினை விளைந்த வியன்கண் இரும்புனத்","திரவரி வாரின் தொண்டகச் சிறுபறை","பானாள் யாமத்துங் கறங்கும்","யாமங் காவலர் அவியா மாறே"],"tr":["amma vāḻi tōḻi iṉṟavar","vārā rāyiṉō naṉṟē cāraṟ","ciṟutiṉai viḷainta viyaṉkaṇ irumpuṉat","tiravari vāriṉ toṇṭakac ciṟupaṟai","pāṉāḷ yāmattuṅ kaṟaṅkum","yāmaṅ kāvalar aviyā māṟē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தோழி கூற்று","speaker_en":"her friend (tōḻi)"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 7, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அம்ம","tr":"amma","foot":"tēmā","acai":[{"kind":"nēr","text":"அம்","tr":"am"},{"kind":"nēr","text":"ம","tr":"ma"}]},{"text":"வாழி","tr":"vāḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"தோழி","tr":"tōḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"இன்றவர்","tr":"iṉṟavar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"இன்","tr":"iṉ"},{"kind":"nirai","text":"றவர்","tr":"ṟavar"}]}],[{"text":"வாரா","tr":"vārā","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ரா","tr":"rā"}]},{"text":"ராயினோ","tr":"rāyiṉō","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ரா","tr":"rā"},{"kind":"nirai","text":"யினோ","tr":"yiṉō"}]},{"text":"நன்றே","tr":"naṉṟē","foot":"tēmā","acai":[{"kind":"nēr","text":"நன்","tr":"naṉ"},{"kind":"nēr","text":"றே","tr":"ṟē"}]},{"text":"சாரற்","tr":"cāraṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"சா","tr":"cā"},{"kind":"nēr","text":"ரற்","tr":"raṟ"}]}],[{"text":"சிறுதினை","tr":"ciṟutiṉai","foot":"karuviḷam","aca