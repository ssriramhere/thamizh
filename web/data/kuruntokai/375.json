,"foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"றே","tr":"ṟē"}]}]]},"ai":{"lines":[{"words":[{"surface":"அம்ம","parts":[{"text":"அம்ம","lemma":"amma","gloss":"listen"}],"gloss":"listen"},{"surface":"வாழி","parts":[{"text":"வாழி","lemma":"vāḻi","gloss":"may you live"}],"gloss":"may you live long"},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"tōḻi","gloss":"friend"}],"gloss":"friend"},{"surface":"இன்றவர்","parts":[{"text":"இன்று","lemma":"iṉṟu","gloss":"today"},{"text":"அவர்","lemma":"avar","gloss":"he"}],"gloss":"today he"}]},{"words":[{"surface":"வாராராயினோ","parts":[{"text":"வாரார்","lemma":"varutal","gloss":"he will not come"},{"text":"ஆயின்","lemma":"āyiṉ","gloss":"if"},{"text":"ஓ","lemma":"ō","gloss":"emphasis"}],"gloss":"if he does not come"},{"surface":"நன்றே","parts":[{"text":"நன்று","lemma":"naṉṟu","gloss":"good thing"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"it is good indeed"},{"surface":"சாரல்","parts":[{"text":"சாரல்","lemma":"cāral","gloss":"mountain slope"}],"gloss":"mountain slope"}]},{"words":[{"surface":"சிறுதினை","parts":[{"text":"சிறுதினை","lemma":"சிறுதினை","gloss":""}],"gloss":"","split_unverified":true},{"surface":"விளைந்த","parts":[{"text":"விளைந்த","lemma":"விளைந்த","gloss":""}],"gloss":"","split_unverified":true},{"surface":"வியன்கண்","parts":[{"text":"வியன்கண்","lemma":"வியன்கண்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"இரும்புனத்","parts":[{"text":"இரும்புனத்","lemma":"இரும்புனத்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"திரவரி","parts":[{"text":"திரவரி","lemma":"திரவரி","gloss":""}],"gloss":"","split_unverified":true},{"surface":"வாரின்","parts":[{"text":"வாரின்","lemma":"வாரின்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தொண்டகச்","parts":[{"text":"தொண்டகச்","lemma":"தொண்டகச்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"சிறுபறை","parts":[{"text":"சிறுபறை","lemma":"சிறுபறை","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"பானாள்","parts":[{"text":"பானாள்","lemma":"பானாள்","gloss":"midnight"}],"gloss":"midnight","split_unverified":true},{"surface":"யாமத்தும்","parts":[{"text":"யாமத்தும்","lemma":"யாமத்தும்","gloss":"even during the night watch"}],"gloss":"even during the night watch","split_unverified":true},{"surface":"கறங்கும்","parts":[{"text":"கறங்கும்","lemma":"kaṟaṅkutal","gloss":"will sound"}],"gloss":"will sound"}]},{"words":[{"surface":"யாமம்","parts":[{"text":"யாமம்","lemma":"yāmam","gloss":"night watch"}],"gloss":"night watch"},{"surface":"காவலர்","parts":[{"text":"காவலர்","lemma":"kāvalar","gloss":"watchmen"}],"gloss":"watchmen"},{"surface":"அவியா","parts":[{"text":"அவியா","lemma":"avital","gloss":"not sleeping"}],"gloss":"without sleeping"},{"surface":"மாறே","parts":[{"text":"மாறு","lemma":"māṟu","gloss":"because"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"because indeed"}]}],"literal":"Listen! May you live, friend! Today he / if he does not come, it is good indeed! On the slope / where small millet has ripened, in the wide, dark field, / because of those who reap at night, the small Toṇṭakam drum / even at midnight will sound, / as the watchmen of the night do not sleep.","translation":"Listen, my friend, may you live long! If he does not come tonight, it is for the best. In the wide, dark field on the mountain slope where the small millet has ripened, the small Toṇṭakam drum will keep sounding even at midnight, because of those who reap the harvest at night, keeping the watchmen wide awake.","modern":"தோழியே, கேள்! நீ வாழ்க! இன்று அவர் வராமல் இருந்தால் மிகவும் நல்லது. மலைச்சாரலில் சிறிய தினை விளைந்த அகன்ற கரிய புனத்தில், இரவில் தினை அறுப்பவர்கள் இருப்பதனால், நள்ளிரவிலும் தொண்டகச் சிறுபறை ஒலித்துக் கொண்டே இருக்கும்; இதனால் இரவுக்காவலர்கள் தூங்காமல் விழித்திருப்பார்கள்.","explanation":"The friend is speaking to the heroine, warning her that the hero should not visit for a secret night tryst tonight. She explains that the small millet in the wide mountain fields has ripened, prompting people to harvest it even during the night. Because of these night-reapers, the watchmen are beating their Toṇṭakam drums and staying alert and sleepless throughout the midnight hours. This makes a secret meeting highly dangerous. By highlighting the sleepless watchmen, the friend subtly urges the hero to stop the secret visits and seek a formal, public marriage.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.36],[0.36,0.6],[0.6,0.9],[0.99,1.5],[1.5,1.97],[1.97,2.43],[2.6,3.0],[3.0,3.2],[3.2,4.4],[4.4,4.8],[4.8,5.4],[5.4,5.6],[5.6,6.3],[6.3,6.83],[6.83,7.7],[7.7,7.9],[7.9,8.2],[8.2,8.7],[8.7,9.2],[9.55,10.6],[10.6,11.1],[11.1,11.4],[11.4,11.7]],"female":[[0.0,0.36],[0.36,0.6],[0.6,0.9],[0.9,1.7],[1.7,2.43],[2.43,3.03],[3.2,3.52],[3.6,3.9],[3.9,5.1],[5.1,5.6],[5.6,5.75],[5.75,6.79],[6.79,7.48],[7.48,8.0],[8.0,8.6],[8.6,8.8],[8.8,9.25],[9.25,10.0],[10.0,10.5],[10.5,12.1],[12.1,12.6],[12.6,13.05],[13.05,13.35]]},"sync":[[["அம்ம","listen"]],[["வாழி","may you live long"]],[["தோழி","friend"]],[["இன்றவர்","today he"]],[["வாராராயினோ","if he does not come"]],[["வாராராயினோ","if he does not come"]],[["நன்றே","it is good indeed"]],[["சாரல்","mountain slope"]],[["சிறுதினை",""]],[["விளைந்த",""]],[["வியன்கண்",""]],[["இரும்புனத்",""]],[["திரவரி",""]],[["வாரின்",""]],[["தொண்டகச்",""]],[["சிறுபறை",""]],[["பானாள்","midnight"]],[["யாமத்தும்","even during the night watch"]],[["கறங்கும்","will sound"]],[["யாமம்","night watch"]],[["காவலர்","watchmen"]],[["அவியா","without sleeping"]],[["மாறே","because indeed"]]]}