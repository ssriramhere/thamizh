{"text":"kuruntokai","n":105,"lines":["புனவன் துடவைப் பொன்போற் சிறுதினைக்","கடியுண் கடவுட் கிட்ட செழுங்குரல்","அறியா துண்ட மஞ்ஞை ஆடுமகள்","வெறியுறு வனப்பின் வெய்துற்று நடுங்கும்","சூர்மலை நாடன் கேண்மை","நீர்மலி கண்ணொடு நினைப்பா கின்றே"],"tr":["puṉavaṉ tuṭavaip poṉpōṟ ciṟutiṉaik","kaṭiyuṇ kaṭavuṭ kiṭṭa ceḻuṅkural","aṟiyā tuṇṭa maññai āṭumakaḷ","veṟiyuṟu vaṉappiṉ veytuṟṟu naṭuṅkum","cūrmalai nāṭaṉ kēṇmai","nīrmali kaṇṇoṭu niṉaippā kiṉṟē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவி கூற்று","poet_ta":"நக்கீரர்","speaker_en":"the heroine (talaivi)","poet_tr":"Nakkīrar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 6, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"புனவன்","tr":"puṉavaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"புன","tr":"puṉa"},{"kind":"nēr","text":"வன்","tr":"vaṉ"}]},{"text":"துடவைப்","tr":"tuṭavaip","foot":"puḷimā","acai":[{"kind":"nirai","text":"துட","tr":"tuṭa"},{"kind":"nēr","text":"வைப்","tr":"vaip"}]},{"text":"பொன்போற்","tr":"poṉpōṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"பொன்","tr":"poṉ"},{"kind":"nēr","text":"போற்","tr":"pōṟ"}]},{"text":"சிறுதினைக்","tr":"ciṟutiṉaik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nirai","text":"தினைக்","tr":"tiṉaik"}]}],[{"text":"கடியுண்","tr":"kaṭiyuṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கடி","tr":"kaṭi"},{"kind":"nēr","text":"யுண்","tr":"yuṇ"}]},{"text":"கடவுட்","tr":"kaṭavuṭ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கட","tr":"kaṭa"},{"kind":"nēr","text":"வுட்","tr":"vuṭ"}]},{"text":"கிட்ட","tr":"kiṭṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"கிட்","tr":"kiṭ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"செழுங்குரல்","tr":"