{"text":"kuruntokai","n":151,"lines":["வங்காக் கடந்த செங்காற் பேடை","எழாஅலுற வீழ்ந்தெனக் கணவற் காணாது","குழலிசைக் குரல் குறும்பல அகவும்","குன்றுகெழு சிறுநெறி அரிய என்னாது","மறப்பருங் காதலி யொழிய","இறப்ப லென்பதீண் டிளமைக்கு முடிவே"],"tr":["vaṅkāk kaṭanta ceṅkāṟ pēṭai","eḻāaluṟa vīḻnteṉak kaṇavaṟ kāṇātu","kuḻalicaik kural kuṟumpala akavum","kuṉṟukeḻu ciṟuneṟi ariya eṉṉātu","maṟapparuṅ kātali yoḻiya","iṟappa leṉpatīṇ ṭiḷamaikku muṭivē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவன் கூற்று","poet_ta":"தூங்கலோரியார்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Tūṅkalōriyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 5, other 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 5, kalittaḷai 4, ? 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வங்காக்","tr":"vaṅkāk","foot":"tēmā","acai":[{"kind":"nēr","text":"வங்","tr":"vaṅ"},{"kind":"nēr","text":"காக்","tr":"kāk"}]},{"text":"கடந்த","tr":"kaṭanta","foot":"puḷimā","acai":[{"kind":"nirai","text":"கடந்","tr":"kaṭan"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"செங்காற்","tr":"ceṅkāṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"செங்","tr":"ceṅ"},{"kind":"nēr","text":"காற்","tr":"kāṟ"}]},{"text":"பேடை","tr":"pēṭai","foot":"tēmā","acai":[{"kind":"nēr","text":"பே","tr":"pē"},{"kind":"nēr","text":"டை","tr":"ṭai"}]}],[{"text":"எழாஅலுற","tr":"eḻāaluṟa","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"எழா","tr":"eḻā"},{"kind":"nirai","text":"அலு","tr":"alu"},{"kind":"nēr","text":"ற","tr":"ṟa"}]},{"text":"வீழ்ந்தெனக்","tr":"vīḻnteṉak","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வீழ்ந்","tr":"vīḻn"},{"kind":"nirai","text":"தெனக்","tr":"teṉak"}]},{"text":"கணவற்","tr":"kaṇavaṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கண","tr":"kaṇa"},{"kind":"nēr","text":"வற்","tr"