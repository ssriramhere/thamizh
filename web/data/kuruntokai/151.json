nd":"nēr","text":"லென்","tr":"leṉ"},{"kind":"nirai","text":"பதீண்","tr":"patīṇ"}]},{"text":"டிளமைக்கு","tr":"ṭiḷamaikku","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"டிள","tr":"ṭiḷa"},{"kind":"nēr","text":"மைக்","tr":"maik"},{"kind":"nēr","text":"கு","tr":"ku"}]},{"text":"முடிவே","tr":"muṭivē","foot":"puḷimā","acai":[{"kind":"nirai","text":"முடி","tr":"muṭi"},{"kind":"nēr","text":"வே","tr":"vē"}]}]]},"ai":{"lines":[{"words":[{"surface":"வங்கா","parts":[{"text":"வங்கா","lemma":"vaṅkā","gloss":"vankā bird"}],"gloss":"vankā bird"},{"surface":"கடந்த","parts":[{"text":"கட","lemma":"kaṭa","gloss":"cross"},{"text":"ந்த","lemma":"nta","gloss":"past participle suffix"}],"gloss":"that crossed"},{"surface":"செங்கால்","parts":[{"text":"செம்","lemma":"cem","gloss":"red"},{"text":"கால்","lemma":"kāl","gloss":"leg"}],"gloss":"red-legged"},{"surface":"பேடை","parts":[{"text":"பேடை","lemma":"pēṭai","gloss":"female bird"}],"gloss":"female bird"}]},{"words":[{"surface":"எழாஅல்","parts":[{"text":"எழாஅல்","lemma":"eḻāal","gloss":"rising/flight"}],"gloss":"rising/flight"},{"surface":"உற","parts":[{"text":"உற","lemma":"uṟa","gloss":"to experience"}],"gloss":"to experience"},{"surface":"வீழ்ந்தென","parts":[{"text":"வீழ்ந்தென","lemma":"வீழ்ந்தென","gloss":"because [it] fell"}],"gloss":"because [it] fell","split_unverified":true},{"surface":"கணவன்","parts":[{"text":"கணவன்","lemma":"kaṇavaṉ","gloss":"husband/mate"}],"gloss":"husband/mate"},{"surface":"காணாது","parts":[{"text":"காண்","lemma":"kāṇ","gloss":"see"},{"text":"ஆது","lemma":"ātu","gloss":"without"}],"gloss":"not seeing"}]},{"words":[{"surface":"குழல்","parts":[{"text":"குழல்","lemma":"kuḻal","gloss":"flute"}],"gloss":"flute"},{"surface":"இசை","parts":[{"text":"இசை","lemma":"icai","gloss":"sound/music"}],"gloss":"sound/music"},{"surface":"குரல்","parts":[{"text":"குரல்","lemma":"kural","gloss":"voice/call"}],"gloss":"voice/call"},{"surface":"குறும்","parts":[{"text":"குறும்","lemma":"kuṟum","gloss":"short"}],"gloss":"short"},{"su