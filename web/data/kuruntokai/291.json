்","parts":[{"text":"எழு","lemma":"எழு","gloss":"rise"},{"text":"அல்","lemma":"அல்","gloss":"verbal noun suffix"}],"gloss":"rising up"},{"surface":"ஒல்லாவே","parts":[{"text":"ஒல்","lemma":"ஒல்","gloss":"agree"},{"text":"ஆ","lemma":"ஆ","gloss":"negative suffix"},{"text":"வே","lemma":"வே","gloss":"emphasis"}],"gloss":"do not agree to"}]},{"words":[{"surface":"அது","parts":[{"text":"அது","lemma":"அது","gloss":"that"}],"gloss":"because of that"},{"surface":"புலந்து","parts":[{"text":"புல","lemma":"புலத்தல்","gloss":"grieve"},{"text":"ந்து","lemma":"ந்து","gloss":"past participle suffix"}],"gloss":"grieving"},{"surface":"அழுத","parts":[{"text":"அழு","lemma":"அழு","gloss":"weep"},{"text":"த","lemma":"த","gloss":"past relative participle suffix"}],"gloss":"that wept"},{"surface":"கண்ணே","parts":[{"text":"கண்","lemma":"கண்","gloss":"eye"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"eyes indeed"},{"surface":"சாரல்","parts":[{"text":"சாரல்","lemma":"சாரல்","gloss":"mountain slope"}],"gloss":"of the mountain slope"}]},{"words":[{"surface":"குண்டு","parts":[{"text":"குண்டு","lemma":"குண்டு","gloss":"deep"}],"gloss":"deep"},{"surface":"நீர்","parts":[{"text":"நீர்","lemma":"நீர்","gloss":"water"}],"gloss":"water"},{"surface":"பைம்","parts":[{"text":"பைம்","lemma":"பைம்","gloss":"fresh"}],"gloss":"fresh","split_unverified":true},{"surface":"சுனை","parts":[{"text":"சுனை","lemma":"சுனை","gloss":"pool"}],"gloss":"pool's"},{"surface":"பூத்த","parts":[{"text":"பூ","lemma":"பூ","gloss":"blossom"},{"text":"த்த","lemma":"த்த","gloss":"past relative participle suffix"}],"gloss":"blossomed"},{"surface":"குவளை","parts":[{"text":"குவளை","lemma":"குவளை","gloss":"blue water-lily"}],"gloss":"blue water-lilies"}]},{"words":[{"surface":"வண்டு","parts":[{"text":"வண்டு","lemma":"வண்டு","gloss":"bee"}],"gloss":"bees"},{"surface":"பயில்","parts":[{"text":"பயில்","lemma":"பயில்","gloss":"frequent"}],"gloss":"frequenting"},{"surface":"பல்","parts":[{"text":"பல்","lemma":"பல்","gloss":"many"}],"gloss":"many","split_unverified":true},{"surface":"இதழ்","parts":[{"text":"இதழ்","lemma":"இதழ்","gloss":"petal"}],"gloss":"petals"},{"surface":"கலைஇ","parts":[{"text":"கலை","lemma":"கலை","gloss":"disperse"},{"text":"இ","lemma":"இ","gloss":"past participle suffix"}],"gloss":"being shaken"}]},{"words":[{"surface":"தண்","parts":[{"text":"தண்","lemma":"தண்","gloss":"cool"}],"gloss":"cool","split_unverified":true},{"surface":"துளிக்கு","parts":[{"text":"துளி","lemma":"துளி","gloss":"drop"},{"text":"க்கு","lemma":"க்கு","gloss":"dative suffix"}],"gloss":"to the drops"},{"surface":"ஏற்ற","parts":[{"text":"ஏல்","lemma":"ஏல்","gloss":"receive"},{"text":"ற","lemma":"ற","gloss":"past relative participle suffix"}],"gloss":"that received"},{"surface":"மலர்","parts":[{"text":"மலர்","lemma":"மலர்","gloss":"flower"}],"gloss":"flowers"},{"surface":"போன்றனவே","parts":[{"text":"போன்றன","lemma":"போன்றன","gloss":"resembled"},{"text":"வே","lemma":"வே","gloss":"emphasis"}],"gloss":"resembled"}]}],"literal":"On the side of the burnt forest field, sprouted millet / swooping parrots chasing mountain girl's hand rattle / with music harmonizing sweet rhythm has / 'parrots, her call!' saying, rising up they do not agree to / because of that, grieving, wept eyes indeed, of the mountain slope / deep water fresh pool blossomed blue water-lilies / bees frequenting many petals being shaken / cool drops received flowers resembled.","translation":"The rattle in the hand of the mountain girl, who chases away the swooping parrots from the millet field grown thick on the side of the burnt forest clearing, has a sweet rhythm that harmonizes with music. The parrots, thinking her rattle's sound is her sweet call, refuse to fly away. Grieved by this, she wept. Her tear-filled eyes resembled the blue water-lilies blooming in the deep, fresh pool of the mountain slope, their many petals frequented by bees shaken as they receive the cool raindrops.","modern":"சுட்டு எரிக்கப்பட்ட காட்டுப்புனத்தின் பக்கத்தில் செழித்து வளர்ந்த தினைப்புனத்தில், வந்து விழும் கிளிகளை விரட்டுகின்ற மலைக்குறத்தியின் கையில் உள்ள குளிர்கருவி, இசையோடு பொருந்திய இனிய தாளத்தைக் கொண்டது. அக்கிளிகள், அந்தக் குளிரின் ஒலியை அவளுடைய இனிய குரல் என்று கருதி, அங்கிருந்து பறந்து போக மறுக்கின்றன. அதனால் வருத்தமடைந்து அவள் அழுதாள். அவளுடைய அழுத கண்கள், மலைச்சரிவில் உள்ள ஆழமான நீரையுடைய பசிய சுனையில் பூத்த குவளை மலர்கள், வண்டுகள் மொய்க்கும் பல இதழ்கள் கலைந்து குளிர்ந்த மழைத்துளிகளை ஏற்றுக்கொண்ட மலர்களைப் போலக் காட்சியளித்தன.","explanation":"In this Kurinji poem, the hero describes the beauty of the heroine's tear-filled eyes to himself. The heroine was guarding the mountain millet field and trying to scare away the swooping parrots using a hand rattle. However, the sound of her rattle was so sweet and musical that the parrots mistook it for her own inviting voice and refused to fly away. Frustrated by her inability to drive them off, she wept in grief. The hero compares her tearful, dark eyes to blue water-lilies blooming in a deep mountain pool, shaken by bees and covered in cool raindrops. This vivid imagery beautifully captures the lush mountain landscape and the delicate emotions of the heroine.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,0.8],[0.8,1.4],[1.4,1.7],[1.7,1.93],[1.93,3.3],[3.3,3.6],[3.6,4.2],[4.2,5.0],[5.0,5.3],[5.3,5.3],[5.3,5.3],[5.3,7.1],[7.47,7.85],[7.85,7.85],[7.85,8.6],[8.6,8.9],[8.9,9.8],[9.8,10.09],[10.16,10.3],[10.3,11.8],[11.8,12.2],[12.2,12.6],[12.6,13.0],[13.0,14.3],[14.3,14.6],[14.6,15.3],[15.3,16.23],[16.23,16.5],[16.5,17.35],[17.35,17.6]],"female":[[0.0,0.8],[0.8,0.8],[0.8,1.53],[1.53,1.9],[1.9,2.47],[2.47,2.61],[2.61,2.9],[2.9,4.4],[4.4,5.3],[5.3,5.7],[5.7,6.15],[6.26,6.49],[6.49,6.6],[7.25,7.9],[7.9,7.9],[7.9,9.2],[9.2,9.57],[9.57,10.7],[10.7,10.99],[11.06,11.2],[11.2,12.6],[12.6,13.4],[13.4,13.6],[13.6,14.1],[15.0,15.3],[15.37,15.57],[15.57,15.77],[15.77,15.9],[16.3,17.5],[17.5,18.2],[18.2,18.5]]}}