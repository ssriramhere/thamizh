{"text":"kuruntokai","n":291,"lines":["சுடுபுன மருங்கிற் கலித்த வேனற்","படுகிளி கடியுங் கொடிச்சிகைக் குளிரே","இசையின் இசையா இன்பா ணித்தே","கிளியவள் விளியென எழலொல் லாவே","அதுபுலந் தழுத கண்ணே சாரற்","குண்டுநீர்ப் பைஞ்சுனைப் பூத்த குவளை","வண்டுபயில் பல்லிதழ் கலைஇத்","தண்துளிக் கேற்ற மலர்போன் றனவே"],"tr":["cuṭupuṉa maruṅkiṟ kalitta vēṉaṟ","paṭukiḷi kaṭiyuṅ koṭiccikaik kuḷirē","icaiyiṉ icaiyā iṉpā ṇittē","kiḷiyavaḷ viḷiyeṉa eḻalol lāvē","atupulan taḻuta kaṇṇē cāraṟ","kuṇṭunīrp paiñcuṉaip pūtta kuvaḷai","vaṇṭupayil pallitaḻ kalaiit","taṇtuḷik kēṟṟa malarpōṉ ṟaṉavē"],"colophon":{"tinai":"kuṟiñci","tinai_ta":"குறிஞ்சி","speaker_ta":"தலைவன் கூற்று","poet_ta":"கபிலர்","speaker_en":"the hero (talaivaṉ)","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 14"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"சுடுபுன","tr":"cuṭupuṉa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சுடு","tr":"cuṭu"},{"kind":"nirai","text":"புன","tr":"puṉa"}]},{"text":"மருங்கிற்","tr":"maruṅkiṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மருங்","tr":"maruṅ"},{"kind":"nēr","text":"கிற்","tr":"kiṟ"}]},{"text":"கலித்த","tr":"kalitta","foot":"puḷimā","acai":[{"kind":"nirai","text":"கலித்","tr":"kalit"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"வேனற்","tr":"vēṉaṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"வே","tr":"vē"},{"kind":"nēr","text":"னற்","tr":"ṉaṟ"}]}],[{"text":"படுகிளி","tr":"paṭukiḷi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"படு","tr":"paṭu"},{"kind":"nirai","text":"கிளி","tr":"kiḷi"}]},{"text":"கடியுங்","tr":"kaṭiyuṅ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கடி","tr":"kaṭi"},{"kind":"nēr","text":"யுங்","tr":"yuṅ"}]},{"text":"கொடிச்சிகைக்","tr":"koṭiccikaik","foot":"kar