{"text":"kuruntokai","n":140,"lines":["வேதின வெரிநின் ஓதிமுது போத்து","ஆறுசெல் மாக்கள் புட்கொளப் பொருந்தும்","சுரனே சென்றனர் காதலர் உரனழிந்து","ஈங்கியான் தாங்கிய எவ்வம்","யாங்கறிந் தன்றிவ் வழுங்க லூரே"],"tr":["vētiṉa veriniṉ ōtimutu pōttu","āṟucel mākkaḷ puṭkoḷap poruntum","curaṉē ceṉṟaṉar kātalar uraṉaḻintu","īṅkiyāṉ tāṅkiya evvam","yāṅkaṟin taṉṟiv vaḻuṅka lūrē"],"colophon":{"tinai":"pālai","tinai_ta":"பாலை","speaker_ta":"தலைவி கூற்று","poet_ta":"அள்ளூர் நன்முல்லையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Aḷḷūr Naṉmullaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 9, veṇṭaḷai 9"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வேதின","tr":"vētiṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வே","tr":"vē"},{"kind":"nirai","text":"தின","tr":"tiṉa"}]},{"text":"வெரிநின்","tr":"veriniṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"வெரி","tr":"veri"},{"kind":"nēr","text":"நின்","tr":"niṉ"}]},{"text":"ஓதிமுது","tr":"ōtimutu","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"ஓ","tr":"ō"},{"kind":"nirai","text":"திமு","tr":"timu"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"போத்து","tr":"pōttu","foot":"tēmā","acai":[{"kind":"nēr","text":"போத்","tr":"pōt"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"ஆறுசெல்","tr":"āṟucel","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nirai","text":"றுசெல்","tr":"ṟucel"}]},{"text":"மாக்கள்","tr":"mākkaḷ","foot":"tēmā","acai":[{"kind":"nēr","text":"மாக்","tr":"māk"},{"kind":"nēr","text":"கள்","tr":"kaḷ"}]},{"text":"புட்கொளப்","tr":"puṭkoḷap","foot":"kūviḷam","acai":[{"kind":"nēr","text":"புட்","tr":"puṭ"},{"kind":"nirai","text":"கொளப்","tr":"koḷap"}]},{"text":"பொருந்தும்","tr":"poruntum","foot":"puḷimā","acai":[{"kind":"nirai