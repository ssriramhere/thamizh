":"யுரு","tr":"yuru"},{"kind":"nirai","text":"மின","tr":"miṉa"}]},{"text":"முரலும்","tr":"muralum","foot":"puḷimā","acai":[{"kind":"nirai","text":"முர","tr":"mura"},{"kind":"nēr","text":"லும்","tr":"lum"}]}],[{"text":"முன்வரல்","tr":"muṉvaral","foot":"kūviḷam","acai":[{"kind":"nēr","text":"முன்","tr":"muṉ"},{"kind":"nirai","text":"வரல்","tr":"varal"}]},{"text":"ஏமம்","tr":"ēmam","foot":"tēmā","acai":[{"kind":"nēr","text":"ஏ","tr":"ē"},{"kind":"nēr","text":"மம்","tr":"mam"}]},{"text":"செய்தகன்","tr":"ceytakaṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"செய்","tr":"cey"},{"kind":"nirai","text":"தகன்","tr":"takaṉ"}]},{"text":"றோரே","tr":"ṟōrē","foot":"tēmā","acai":[{"kind":"nēr","text":"றோ","tr":"ṟō"},{"kind":"nēr","text":"ரே","tr":"rē"}]}]]},"ai":{"lines":[{"words":[{"surface":"பெய்த","parts":[{"text":"பெய்","lemma":"pey","gloss":"rain"},{"text":"த்","lemma":"t","gloss":"past tense"},{"text":"அ","lemma":"a","gloss":"adjectival participle suffix"}],"gloss":"rained"},{"surface":"குன்றத்து","parts":[{"text":"குன்று","lemma":"kuṉṟu","gloss":"hill"},{"text":"அத்து","lemma":"attu","gloss":"oblique case suffix"}],"gloss":"of the hill"},{"surface":"பூநாறு","parts":[{"text":"பூ","lemma":"pū","gloss":"flower"},{"text":"நாறு","lemma":"nāṟu","gloss":"fragrant"}],"gloss":"flower-fragrant"},{"surface":"தண்கலுழ்","parts":[{"text":"தண்","lemma":"taṇ","gloss":"cool"},{"text":"கலுழ்","lemma":"kaluḻ","gloss":"muddy water"}],"gloss":"cool muddy water"}]},{"words":[{"surface":"மீமிசைச்","parts":[{"text":"மீமிசைச்","lemma":"மீமிசைச்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தாஅய","parts":[{"text":"தாஅய","lemma":"தாஅய","gloss":""}],"gloss":"","split_unverified":true},{"surface":"வீஇ","parts":[{"text":"வீஇ","lemma":"வீஇ","gloss":""}],"gloss":"","split_unverified":true},{"surface":"சுமந்துவந்","parts":[{"text":"சுமந்துவந்","lemma":"சுமந்துவந்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"திழிதரும்","parts":[{"text":"திழிதரும்","lemma":"திழிதரும்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"புனலும்","parts":[{"text":"புனலும்","lemma":"புனலும்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"வாரார்","parts":[{"text":"வாரார்","lemma":"வாரார்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"தோழி","parts":[{"text":"தோழி","lemma":"தோழி","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"மறந்தோர்","parts":[{"text":"மறந்தோர்","lemma":"மறந்தோர்","gloss":"he who forgot"}],"gloss":"he who forgot","split_unverified":true},{"surface":"மன்ற","parts":[{"text":"மன்ற","lemma":"maṉṟa","gloss":"surely"}],"gloss":"surely"},{"surface":"மறவா","parts":[{"text":"மற","lemma":"maṟa","gloss":"forget"},{"text":"ஆ","lemma":"ā","gloss":"negative participle suffix"}],"gloss":"not forgetting"},{"surface":"நாமே","parts":[{"text":"நாம்","lemma":"nām","gloss":"we"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"we indeed"}]},{"words":[{"surface":"கால","parts":[{"text":"கால","lemma":"கால","gloss":"seasonal"}],"gloss":"seasonal","split_unverified":true},{"surface":"மாரி","parts":[{"text":"மாரி","lemma":"māri","gloss":"rain"}],"gloss":"rain"},{"surface":"மாலை","parts":[{"text":"மாலை","lemma":"mālai","gloss":"evening"}],"gloss":"evening"},{"surface":"மாமழை","parts":[{"text":"மா","lemma":"mā","gloss":"great"},{"text":"மழை","lemma":"maḻai","gloss":"cloud"}],"gloss":"great dark clouds"}]},{"words":[{"surface":"இன்னிசை","parts":[{"text":"இன்","lemma":"iṉ","gloss":"sweet"},{"text":"இசை","lemma":"icai","gloss":"sound"}],"gloss":"sweet sound"},{"surface":"உருமின","parts":[{"text":"உருமு","lemma":"urumu","gloss":"thunder"},{"text":"இன்","lemma":"iṉ","gloss":"oblique case suffix"},{"text":"அ","lemma":"a","gloss":"plural suffix"}],"gloss":"of the thunder"},{"surface":"முரலும்","parts":[{"text":"முரல்","lemma":"mural","gloss":"roar"},{"text":"உம்","lemma":"um","gloss":"habitual future suffix"}],"gloss":"roaring"}]},{"words":[{"surface":"முன்வரல்","parts":[{"text":"முன்","lemma":"muṉ","gloss":"before"},{"text":"வரல்","lemma":"varal","gloss":"coming"}],"gloss":"coming beforehand"},{"surface":"ஏமம்","parts":[{"text":"ஏமம்","lemma":"ēmam","gloss":"assurance"}],"gloss":"assurance"},{"surface":"செய்து","parts":[{"text":"செய்","lemma":"cey","gloss":"do"},{"text":"த்","lemma":"t","gloss":"past tense"},{"text":"உ","lemma":"u","gloss":"verbal participle suffix"}],"gloss":"having made"},{"surface":"அகன்றோரே","parts":[{"text":"அகன்றோரே","lemma":"அகன்றோரே","gloss":"he who departed"}],"gloss":"he who departed","split_unverified":true}]}],"literal":"Rained hill's flower-fragrant cool muddy water / high up on the heights spread blossoms carrying having come / descending even the freshet, he does not return, O friend! / He forgot surely, not forgetting we indeed, / seasonal rain evening great dark clouds / sweet sound of thunder roaring, / coming beforehand assurance having made he who departed.","translation":"Even as the cool, muddy freshet, fragrant with flowers from the rained-upon hills, comes carrying blossoms that spread over the high peaks and descends, he does not return, O friend! He has surely forgotten us, while we do not forget him—he who departed after assuring us that he would return before the season of evening rains, when great dark clouds roar with the sweet sound of thunder.","modern":"மழை பெய்த மலையிலிருந்து மலர்களின் நறுமணத்தோடு குளிர்ந்த கலங்கல் நீர், மலை உச்சிகளில் பரவியிருந்த மலர்களைச் சுமந்து கொண்டு கீழே இறங்கி வருகிறது. ஆனால் அவர் இன்னும் வரவில்லை தோழி! மாலை நேரத்தில் பருவகால மழையைத் தரும் கரிய மேகங்கள் இனிய ஓசையோடு இடி முழங்கும் கார்ப்பருவம் தொடங்குவதற்கு முன்பே திரும்பி வருவதாக நமக்கு உறுதி கூறிச் சென்றவர், நம்மை மறந்துவிட்டார் போலும்; ஆனால் நாம் அவரை மறக்காமல் இருக்கிறோம்.","explanation":"The heroine (Thalaivi) is speaking to her close friend (Thōḻi) in this Mullai (forest/pastoral) landscape poem. The hero had departed on a journey, promising to return before the onset of the rainy season. Now, the rainy season has arrived, marked by the cool freshets carrying flowers from the hills and the roaring thunder of evening clouds, but the hero has not yet returned. The heroine laments that while she remains faithful and remembers him constantly, the hero seems to have completely forgotten his promise. The imagery of the fresh mountain stream carrying fallen blossoms and the roaring rain clouds vividly evokes the onset of the monsoon, intensifying the heroine's grief.","model":"gemini-3.5-flash"}}