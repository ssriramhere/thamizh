{"text":"kuruntokai","n":200,"lines":["பெய்த குன்றத்துப் பூநாறு தண்கலுழ்","மீமிசைச் தாஅய வீஇ சுமந்துவந்","திழிதரும் புனலும் வாரார் தோழி","மறந்தோர் மன்ற மறவா நாமே","கால மாரி மாலை மாமழை","இன்னிசை யுருமின முரலும்","முன்வரல் ஏமம் செய்தகன் றோரே"],"tr":["peyta kuṉṟattup pūnāṟu taṇkaluḻ","mīmicaic tāaya vīi cumantuvan","tiḻitarum puṉalum vārār tōḻi","maṟantōr maṉṟa maṟavā nāmē","kāla māri mālai māmaḻai","iṉṉicai yurumiṉa muralum","muṉvaral ēmam ceytakaṉ ṟōrē"],"colophon":{"tinai":"mullai","tinai_ta":"முல்லை","speaker_ta":"தலைவி கூற்று","poet_ta":"ஔவையார்","speaker_en":"the heroine (talaivi)","poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 11"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பெய்த","tr":"peyta","foot":"tēmā","acai":[{"kind":"nēr","text":"பெய்","tr":"pey"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"குன்றத்துப்","tr":"kuṉṟattup","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"குன்","tr":"kuṉ"},{"kind":"nēr","text":"றத்","tr":"ṟat"},{"kind":"nēr","text":"துப்","tr":"tup"}]},{"text":"பூநாறு","tr":"pūnāṟu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"பூ","tr":"pū"},{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"தண்கலுழ்","tr":"taṇkaluḻ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தண்","tr":"taṇ"},{"kind":"nirai","text":"கலுழ்","tr":"kaluḻ"}]}],[{"text":"மீமிசைச்","tr":"mīmicaic","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மீ","tr":"mī"},{"kind":"nirai","text":"மிசைச்","tr":"micaic"}]},{"text":"தாஅய","tr":"tāaya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nirai","text":"அய","tr":"aya"}]},{"text":"வீஇ","tr":"vīi","foot":"tēmā","acai":[{"kind":"nēr","text":"வீ","tr":"vī"},{"kind":"nēr","text":