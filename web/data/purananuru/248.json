{"text":"purananuru","n":248,"lines":["அளிய தாமே சிறுவெள் ளாம்பல்","இளையம் ஆகத் தழையா யினவே இனியே","பெருவளக் கொழுநன் மாய்ந்தெனப் பொழுது மறுத்து","இன்னா வைகல் உண்ணும்","அல்லிப் படுஉம் புல் ஆயினவே"],"tr":["aḷiya tāmē ciṟuveḷ ḷāmpal","iḷaiyam ākat taḻaiyā yiṉavē iṉiyē","peruvaḷak koḻunaṉ māynteṉap poḻutu maṟuttu","iṉṉā vaikal uṇṇum","allip paṭuum pul āyiṉavē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"தாபதநிலை","poet_ta":"ஒக்கூர் மாசாத்தனார்","poet_tr":"Okkūr Mācāttaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 9, veṇṭaḷai 8, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அளிய","tr":"aḷiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"அளி","tr":"aḷi"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"தாமே","tr":"tāmē","foot":"tēmā","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"மே","tr":"mē"}]},{"text":"சிறுவெள்","tr":"ciṟuveḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nēr","text":"வெள்","tr":"veḷ"}]},{"text":"ளாம்ப","tr":"ḷāmpa","foot":"tēmā","acai":[{"kind":"nēr","text":"ளாம்","tr":"ḷām"},{"kind":"nēr","text":"ப","tr":"pa"}]}],[{"text":"லிளையமாகத்","tr":"liḷaiyamākat","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"லிளை","tr":"liḷai"},{"kind":"nirai","text":"யமா","tr":"yamā"},{"kind":"nēr","text":"கத்","tr":"kat"}]},{"text":"தழையா","tr":"taḻaiyā","foot":"puḷimā","acai":[{"kind":"nirai","text":"தழை","tr":"taḻai"},{"kind":"nēr","text":"யா","tr":"yā"}]},{"text":"யினவே","tr":"yiṉavē","foot":"puḷimā","acai":[{"kind":"nirai","text":"யின","tr":"yiṉa"},{"kind":"nēr","text":"வே","tr":"vē"}]},{"text":"யினியே","tr":"yiṉiyē","foot":"puḷimā","acai":[{"kind":"nirai","text":"யினி","tr":"yiṉi"},{"kind":"nēr","text":