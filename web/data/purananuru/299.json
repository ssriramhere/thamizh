{"text":"purananuru","n":299,"lines":["பருத்தி வேலிச் சீறூர் மன்னன்","உழுத்துஅதர் உண்ட ஓய்நடைப் புரவி","கடல்மண்டு தோணியின் படைமுகம் போழ","நெய்ம்மிதி அருந்திய கொய்சுவல் எருத்தின்","தண்ணடை மன்னர் தாருடைப் புரவி","அணங்குஉடை முருகன் கோட்டத்துக்","கலம்தொடா மகளிரின் இகழ்ந்துநின் றவ்வே"],"tr":["parutti vēlic cīṟūr maṉṉaṉ","uḻuttuatar uṇṭa ōynaṭaip puravi","kaṭalmaṇṭu tōṇiyiṉ paṭaimukam pōḻa","neymmiti aruntiya koycuval eruttiṉ","taṇṇaṭai maṉṉar tāruṭaip puravi","aṇaṅkuuṭai murukaṉ kōṭṭattuk","kalamtoṭā makaḷiriṉ ikaḻntuniṉ ṟavvē"],"colophon":{"tinai":"nocci","tinai_ta":"நொச்சி","turai_ta":"குதிரை மறம்","poet_ta":"பொன் முடியார்","poet_tr":"Poṉ Muṭiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"7×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 11"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பருத்தி","tr":"parutti","foot":"puḷimā","acai":[{"kind":"nirai","text":"பருத்","tr":"parut"},{"kind":"nēr","text":"தி","tr":"ti"}]},{"text":"வேலிச்","tr":"vēlic","foot":"tēmā","acai":[{"kind":"nēr","text":"வே","tr":"vē"},{"kind":"nēr","text":"லிச்","tr":"lic"}]},{"text":"சீறூர்","tr":"cīṟūr","foot":"tēmā","acai":[{"kind":"nēr","text":"சீ","tr":"cī"},{"kind":"nēr","text":"றூர்","tr":"ṟūr"}]},{"text":"மன்ன","tr":"maṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"மன்","tr":"maṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]}],[{"text":"னுழுத்தத","tr":"ṉuḻuttata","foot":"karuviḷam","acai":[{"kind":"nirai","text":"னுழுத்","tr":"ṉuḻut"},{"kind":"nirai","text":"தத","tr":"tata"}]},{"text":"ருண்ட","tr":"ruṇṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"ருண்","tr":"ruṇ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"வோய்நடைப்","tr":"vōynaṭaip","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வோய்","tr":"vōy"},{"kind":"nirai","text":"நடைப்","tr":"naṭaip"}]},{"text":"புரவி","tr":"p