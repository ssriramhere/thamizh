{"text":"purananuru","n":94,"lines":["ஊர்க்குறு மாக்கள் வெண்கோடு கழாஅலின்","நீர்த்துறை படியும் பெருங்களிறு போல","இனியை பெரும எமக்கே மற்றதன்","துன்னருங் கடாஅம் போல","இன்னாய் பெரும நின் ஒன்னா தோர்க்கே"],"tr":["ūrkkuṟu mākkaḷ veṇkōṭu kaḻāaliṉ","nīrttuṟai paṭiyum peruṅkaḷiṟu pōla","iṉiyai peruma emakkē maṟṟataṉ","tuṉṉaruṅ kaṭāam pōla","iṉṉāy peruma niṉ oṉṉā tōrkkē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"அரச வாகை","poet_ta":"ஔவையார்","addressed_ta":"அதியமான் நெடுமான் அஞ்சி","poet_tr":"Auvaiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"5×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 9, āciriyattaḷai 9, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஊர்க்குறு","tr":"ūrkkuṟu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஊர்க்","tr":"ūrk"},{"kind":"nirai","text":"குறு","tr":"kuṟu"}]},{"text":"மாக்கள்","tr":"mākkaḷ","foot":"tēmā","acai":[{"kind":"nēr","text":"மாக்","tr":"māk"},{"kind":"nēr","text":"கள்","tr":"kaḷ"}]},{"text":"வெண்கோடு","tr":"veṇkōṭu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"வெண்","tr":"veṇ"},{"kind":"nēr","text":"கோ","tr":"kō"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"கழாஅலின்","tr":"kaḻāaliṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கழா","tr":"kaḻā"},{"kind":"nirai","text":"அலின்","tr":"aliṉ"}]}],[{"text":"நீர்த்துறை","tr":"nīrttuṟai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நீர்த்","tr":"nīrt"},{"kind":"nirai","text":"துறை","tr":"tuṟai"}]},{"text":"படியும்","tr":"paṭiyum","foot":"puḷimā","acai":[{"kind":"nirai","text":"படி","tr":"paṭi"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"பெருங்களி","tr":"peruṅkaḷi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெருங்","tr":"peruṅ"},{"kind":"nirai","text":"களி","tr":"kaḷi"}]},{"text":"றுபோல","tr":"ṟupōla","foot":"puḷimā",