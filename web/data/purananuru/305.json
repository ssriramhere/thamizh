{"text":"purananuru","n":305,"lines":["வயலைக் கொடியின் வாடிய மருங்கின்","உயவல் ஊர்திப் பயலைப் பார்ப்பான்","எல்லி வந்து நில்லாது புக்குச்","சொல்லிய சொல்லோ சிலவே அதற்கே","ஏணியும் சீப்பும் மாற்றி","மாண்வினை யானையும் மணிகளைந் தனவே"],"tr":["vayalaik koṭiyiṉ vāṭiya maruṅkiṉ","uyaval ūrtip payalaip pārppāṉ","elli vantu nillātu pukkuc","colliya collō cilavē ataṟkē","ēṇiyum cīppum māṟṟi","māṇviṉai yāṉaiyum maṇikaḷain taṉavē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"பார்ப்பன வாகை","poet_ta":"மதுரை வேளாசான்","poet_tr":"Maturai Vēḷācāṉ"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 9, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வயலைக்","tr":"vayalaik","foot":"puḷimā","acai":[{"kind":"nirai","text":"வய","tr":"vaya"},{"kind":"nēr","text":"லைக்","tr":"laik"}]},{"text":"கொடியின்","tr":"koṭiyiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கொடி","tr":"koṭi"},{"kind":"nēr","text":"யின்","tr":"yiṉ"}]},{"text":"வாடிய","tr":"vāṭiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nirai","text":"டிய","tr":"ṭiya"}]},{"text":"மருங்கி","tr":"maruṅki","foot":"puḷimā","acai":[{"kind":"nirai","text":"மருங்","tr":"maruṅ"},{"kind":"nēr","text":"கி","tr":"ki"}]}],[{"text":"னுயவ","tr":"ṉuyava","foot":"puḷimā","acai":[{"kind":"nirai","text":"னுய","tr":"ṉuya"},{"kind":"nēr","text":"வ","tr":"va"}]},{"text":"லூர்திப்","tr":"lūrtip","foot":"tēmā","acai":[{"kind":"nēr","text":"லூர்","tr":"lūr"},{"kind":"nēr","text":"திப்","tr":"tip"}]},{"text":"பயலைப்","tr":"payalaip","foot":"puḷimā","acai":[{"kind":"nirai","text":"பய","tr":"paya"},{"kind":"nēr","text":"லைப்","tr":"laip"}]},{"text":"பார்ப்பா","tr":"pārppā","foot":"tēmā","acai":[{"kind":"nēr","text":"பார்ப்","tr":"pā