{"text":"purananuru","n":315,"lines":["உடையன் ஆயின் உண்ணவும் வல்லன்","கடவர் மீதும் இரப்போர்க்கு ஈயும்","மடவர் மகிழ்துணை நெடுமான் அஞ்சி","இல்லிறைச் செரீஇய ஞெலிகோல் போலத்","தோன்றாது இருக்கவும் வல்லன் மற்றதன்","கான்றுபடு கனைஎரி போலத்","தோன்றவும் வல்லன் தான் தோன்றுங் காலே"],"tr":["uṭaiyaṉ āyiṉ uṇṇavum vallaṉ","kaṭavar mītum irappōrkku īyum","maṭavar makiḻtuṇai neṭumāṉ añci","illiṟaic cerīiya ñelikōl pōlat","tōṉṟātu irukkavum vallaṉ maṟṟataṉ","kāṉṟupaṭu kaṉaieri pōlat","tōṉṟavum vallaṉ tāṉ tōṉṟuṅ kālē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"வல்லான் முல்லை","poet_ta":"ஔவையார்","addressed_ta":"அதியமான் நெடுமான் அஞ்சி","poet_tr":"Auvaiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"7×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 12"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"உடைய","tr":"uṭaiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"உடை","tr":"uṭai"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"னாயி","tr":"ṉāyi","foot":"tēmā","acai":[{"kind":"nēr","text":"னா","tr":"ṉā"},{"kind":"nēr","text":"யி","tr":"yi"}]},{"text":"னுண்ணவும்","tr":"ṉuṇṇavum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"னுண்","tr":"ṉuṇ"},{"kind":"nirai","text":"ணவும்","tr":"ṇavum"}]},{"text":"வல்லன்","tr":"vallaṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"வல்","tr":"val"},{"kind":"nēr","text":"லன்","tr":"laṉ"}]}],[{"text":"கடவர்","tr":"kaṭavar","foot":"puḷimā","acai":[{"kind":"nirai","text":"கட","tr":"kaṭa"},{"kind":"nēr","text":"வர்","tr":"var"}]},{"text":"மீது","tr":"mītu","foot":"tēmā","acai":[{"kind":"nēr","text":"மீ","tr":"mī"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"மிரப்போர்க்","tr":"mirappōrk","foot":"puḷimā","acai":[{"kind":"nirai","text":"மிரப்","tr":"mirap"},{"kind":"nēr","text":"போர்க்","tr":"pōrk"}]},{"text":"கீயு