{"text":"purananuru","n":351,"lines":["படுமணி மருங்கின் பணைத் தாள் யானையும்","கொடிநுடங்கு மிசைய தேரும் மாவும்","படைஅமை மறவரொடு துவன்றிக் கல்லெனக்","கடல்கண் டன்ன கண்அகன் தானை","வென்றுஎறி முரசின் வேந்தர் என்றும்","வண்கை எயினன் வாகை அன்ன","இவள்நலம் தாராது அமைகுவர் அல்லர்","என்ஆ வதுகொல் தானே தெண்ணீர்ப்","பொய்கை மேய்ந்த செவ்வரி நாரை","தேம்கொள் மருதின் பூஞ்சினை முனையின்","காமரு காஞ்சித் துஞ்சும்","ஏமம்சால் சிறப்பின் இப் பணைநல் லூரே"],"tr":["paṭumaṇi maruṅkiṉ paṇait tāḷ yāṉaiyum","koṭinuṭaṅku micaiya tērum māvum","paṭaiamai maṟavaroṭu tuvaṉṟik kalleṉak","kaṭalkaṇ ṭaṉṉa kaṇakaṉ tāṉai","veṉṟueṟi muraciṉ vēntar eṉṟum","vaṇkai eyiṉaṉ vākai aṉṉa","ivaḷnalam tārātu amaikuvar allar","eṉā vatukol tāṉē teṇṇīrp","poykai mēynta cevvari nārai","tēmkoḷ marutiṉ pūñciṉai muṉaiyiṉ","kāmaru kāñcit tuñcum","ēmamcāl ciṟappiṉ ip paṇainal lūrē"],"colophon":{"tinai":"kāñci","tinai_ta":"காஞ்சி","turai_ta":"மகட்பாற் காஞ்சி","poet_ta":"மதுரைப் படைமங்க மன்னியார்","poet_tr":"Maturaip Paṭaimaṅka Maṉṉiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"12 lines"},{"name":"feet per line","ok":true,"detail":"11×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 43, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 30, veṇṭaḷai 12, kalittaḷai 4"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"படுமணி","tr":"paṭumaṇi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"படு","tr":"paṭu"},{"kind":"nirai","text":"மணி","tr":"maṇi"}]},{"text":"மருங்கின்","tr":"maruṅkiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மருங்","tr":"maruṅ"},{"kind":"nēr","text":"கின்","tr":"kiṉ"}]},{"text":"பணைத்தாள்","tr":"paṇaittāḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பணைத்","tr":"paṇait"},{"kind":"nēr","text":"தாள்","tr":"tāḷ"}]},{"text":"யானையும்","tr":"yāṉaiyum","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னை","tr":"ṉai"},{"kind":"nēr","text":"யும்","tr":"yum"}]}],[{"tex