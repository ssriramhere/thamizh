{"text":"purananuru","n":50,"lines":["மாசற விசித்த வார்புஉறு வள்பின்","மைபடு மருங்குல் பொலிய மஞ்ஞை","ஒலிநெடும் பீலி ஒண்பொறி மணித்தார்","பொலங்குழை உழிஞையடு பொலியச் சூட்டிக்","குருதி வேட்கை உருகெழு முரசம்","மண்ணி வாரா அளவை எண்ணெய்","நுரைமுகந் தன்ன மென்பூஞ் சேக்கை","அறியாது ஏறிய என்னைத் தெறுவர","இருபாற் படுக்குநின் வாள்வாய் ஒழித்ததை","அதூஉம் சாலும் நற் றமிழ்முழுது அறிதல்","அதனொடும் அமையாது அணுக வந்து நின்","மதனுடை முழவுத்தோள் ஓச்சித் தண்ணென","வீசி யோயே வியலிடம் கமழ","இவன்இசை உடையோர்க்கு அல்லது அவணது","உயர்நிலை உலகத்து உறையுள் இன்மை","விளங்கக் கேட்ட மாறுகொல்","வலம்படு குருசில் நீ ஈங்குஇது செயலே"],"tr":["mācaṟa vicitta vārpuuṟu vaḷpiṉ","maipaṭu maruṅkul poliya maññai","olineṭum pīli oṇpoṟi maṇittār","polaṅkuḻai uḻiñaiyaṭu poliyac cūṭṭik","kuruti vēṭkai urukeḻu muracam","maṇṇi vārā aḷavai eṇṇey","nuraimukan taṉṉa meṉpūñ cēkkai","aṟiyātu ēṟiya eṉṉait teṟuvara","irupāṟ paṭukkuniṉ vāḷvāy oḻittatai","atūum cālum naṟ ṟamiḻmuḻutu aṟital","ataṉoṭum amaiyātu aṇuka vantu niṉ","mataṉuṭai muḻavuttōḷ ōccit taṇṇeṉa","vīci yōyē viyaliṭam kamaḻa","ivaṉicai uṭaiyōrkku allatu avaṇatu","uyarnilai ulakattu uṟaiyuḷ iṉmai","viḷaṅkak kēṭṭa māṟukol","valampaṭu kurucil nī īṅkuitu ceyalē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"இயன் மொழி","poet_ta":"மோசிகீரனார்","addressed_ta":"சேரமான் தகடூர் எறிந்த பெருஞ்சேரல் இரும்பொறை","poet_tr":"Mōcikīraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"17 lines"},{"name":"feet per line","ok":true,"detail":"16×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 63, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 36, veṇṭaḷai 29, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மாசற","tr":"mācaṟa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"சற","tr":"caṟa"}]},{"text":"விசித்த","tr":"vicitta","foot":"puḷimā","acai":[{"kind":"nirai","text":"விசித்","tr":"vicit"},{"kind":"nēr","tex