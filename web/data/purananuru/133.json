{"text":"purananuru","n":133,"lines":["மெல்லியல் விறலி நீ நல்லிசை செவியிற்","கேட்பின் அல்லது காண்பறி யலையே","காண்டல் சால வேண்டினை யாயின் மாண்ட நின்","விரை வளர் கூந்தல் வரைவளி உளரக்","கலவ மஞ்ஞையின் காண்வர இயலி","மாரி யன்ன வண்மைத்","தேர்வேள் ஆயைக் காணிய சென்மே"],"tr":["melliyal viṟali nī nallicai ceviyiṟ","kēṭpiṉ allatu kāṇpaṟi yalaiyē","kāṇṭal cāla vēṇṭiṉai yāyiṉ māṇṭa niṉ","virai vaḷar kūntal varaivaḷi uḷarak","kalava maññaiyiṉ kāṇvara iyali","māri yaṉṉa vaṇmait","tērvēḷ āyaik kāṇiya ceṉmē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"விறலியாற்றுப்படை","poet_ta":"உறையூர் ஏணிச்சேரி முடமோசியார்","addressed_ta":"ஆய் அண்டிரன்","poet_tr":"Uṟaiyūr Ēṇiccēri Muṭamōciyār"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"1×5, 5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 19, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"1 five-foot line (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"மெல்லியல்","tr":"melliyal","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மெல்","tr":"mel"},{"kind":"nirai","text":"லியல்","tr":"liyal"}]},{"text":"விறலிநீ","tr":"viṟalinī","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விற","tr":"viṟa"},{"kind":"nirai","text":"லிநீ","tr":"linī"}]},{"text":"நல்லிசை","tr":"nallicai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நல்","tr":"nal"},{"kind":"nirai","text":"லிசை","tr":"licai"}]},{"text":"செவியிற்","tr":"ceviyiṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"செவி","tr":"cevi"},{"kind":"nēr","text":"யிற்","tr":"yiṟ"}]}],[{"text":"கேட்பி","tr":"kēṭpi","foot":"tēmā","acai":[{"kind":"nēr","text":"கேட்","tr":"kēṭ"},{"kind":"nēr","text":"பி","tr":"pi"}]},{"text":"னல்லது","tr":"ṉallatu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"னல்","tr":"ṉal"},{"kind":"nirai","text":"லது","tr":"latu"}]},{"text":"காண்பறி","tr":"kāṇp