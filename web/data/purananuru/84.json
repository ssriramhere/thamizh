:"like"},{"text":"அம்","lemma":"அம்","gloss":"beauty"}],"gloss":"golden beauty"},{"surface":"ஏ","parts":[{"text":"ஏ","lemma":"ஏ","gloss":"vocative particle"}],"gloss":"O mother"}]},{"words":[{"surface":"போறெதிர்ந்து","parts":[{"text":"போறெதிர்ந்து","lemma":"போரெதிர்","gloss":"having opposed in battle"}],"gloss":"having opposed in battle"},{"surface":"என்னை","parts":[{"text":"என்","lemma":"என்","gloss":"my"},{"text":"ஐ","lemma":"ஐ","gloss":"lord"}],"gloss":"my lord"},{"surface":"போர்க்களம்","parts":[{"text":"போர்","lemma":"போர்","gloss":"battle"},{"text":"களம்","lemma":"களம்","gloss":"field"}],"gloss":"battlefield"},{"surface":"புகினே","parts":[{"text":"புகின்","lemma":"புகு","gloss":"if he enters"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"if he enters indeed"}]},{"words":[{"surface":"கல்லென்","parts":[{"text":"கல்","lemma":"கல்","gloss":"bustling sound"},{"text":"என்","lemma":"என்","gloss":"making"}],"gloss":"making a bustling sound"},{"surface":"பேரூர்","parts":[{"text":"பேர்","lemma":"பேர்","gloss":"great"},{"text":"ஊர்","lemma":"ஊர்","gloss":"town"}],"gloss":"great town"},{"surface":"விழவுடை","parts":[{"text":"விழவு","lemma":"விழவு","gloss":"festival"},{"text":"உடை","lemma":"உடை","gloss":"having"}],"gloss":"having festivals"},{"surface":"ஆங்கண்","parts":[{"text":"ஆங்கண்","lemma":"ஆங்கண்","gloss":"in that place"}],"gloss":"in that place"}]},{"words":[{"surface":"ஏமுற்று","parts":[{"text":"ஏமுற்று","lemma":"ஏமுறு","gloss":"having been bewildered / excited"}],"gloss":"having been bewildered / excited"},{"surface":"கழிந்த","parts":[{"text":"கழிந்த","lemma":"கழி","gloss":"that passed / perished"}],"gloss":"that passed / perished"},{"surface":"மள்ளர்க்கு","parts":[{"text":"மள்ளர்","lemma":"மள்ளர்","gloss":"warriors"},{"text":"கு","lemma":"கு","gloss":"to"}],"gloss":"to the warriors"}]},{"words":[{"surface":"உமணர்","parts":[{"text":"உமணர்","lemma":"உமணர்","gloss":"salt-merchants"}],"gloss":"salt-merchants"},{"surface":"வெரூஉம்","parts":[{"text":"வெரூஉம்","lemma":"வெருவு","gloss":"fearing"}],"gloss":"fearing"},{"surface":"துறையன்","parts":[{"text":"துறை","lemma":"துறை","gloss":"ghat / shore"},{"text":"அன்","lemma":"அன்","gloss":"he"}],"gloss":"he of the shore / ghat"},{"surface":"அன்னே","parts":[{"text":"அன்ன","lemma":"அன்ன","gloss":"like"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"is like indeed"}]}],"literal":"My lord, even eating poor gruel, is one of great shoulders, O mother! / We indeed, even remaining in the outer suburbs, are like golden beauty, O mother! / If my lord, opposing in battle, enters the battlefield, / in that place of the great town having festivals making a bustling sound, / to the warriors who are bewildered and perished, / he is like the lord of the ghat which the salt-merchants fear!","translation":"My lord, even when eating poor gruel, has great shoulders, O mother! We, even while living in the outer suburbs, are like gold, O mother! If my lord, opposing in battle, enters the battlefield, to the warriors who wander in bewilderment in the festive areas of the bustling great town, he is like the lord of a dangerous river-crossing that makes even the salt-merchants tremble with fear!","modern":"என் தலைவன் எளிய கஞ்சியை உணவாகக் குடித்தாலும் பெரிய தோள்களை உடையவன், தாயே! நாம் ஊருக்குப் புறம்பே வசித்தாலும் பொன்னைப் போன்றவர்கள், தாயே! என் தலைவன் போரை எதிர்த்துப் போர்க்களத்தில் புகுந்தால், ஆரவாரமுடைய பெரிய ஊரின் திருவிழா நடக்கும் இடங்களில் மயங்கித் திரியும் வீரர்களுக்கு, உப்பு வணிகர்கள் அஞ்சும் ஆற்றின் துறையைப் போன்றவன் ஆவான்.","explanation":"This poem is spoken by a young woman to her mother, expressing her deep love and admiration for the Chola king Porvaiko Perunarkilli. She describes how her lord, despite eating simple gruel, possesses magnificent, strong shoulders, while she and her companions remain beautiful like gold even in the outskirts of the town. When he enters the battlefield, he strikes terror into the hearts of opposing warriors, just like a treacherous river-crossing that terrifies salt-merchants who travel with heavy carts. The imagery of the salt-merchants fearing the dangerous ghat perfectly conveys the overwhelming power and formidable nature of the hero in battle. Key words include 'புற்கை' (poor gruel), 'மள்ளர்' (warriors), and 'துறையன்' (lord of the ghat).","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.38],[0.5,0.81],[0.96,1.3],[1.3,1.7],[1.7,2.1],[2.1,3.1],[3.1,3.3],[3.3,3.7],[3.7,4.1],[4.22,4.58],[4.7,5.7],[5.7,6.2],[6.2,6.8],[6.8,7.0],[7.0,8.1],[8.1,8.6],[8.6,8.6],[8.6,9.0],[9.0,9.32],[9.32,10.3],[10.3,10.6],[10.6,11.6],[11.6,11.6],[11.6,12.4],[12.48,12.6]],"female":[[0.0,0.52],[0.7,1.1],[1.1,1.1],[1.1,1.6],[1.92,2.4],[2.4,3.5],[3.5,3.7],[3.7,4.1],[4.1,4.6],[4.74,5.16],[5.16,5.3],[5.3,7.1],[7.1,7.7],[7.7,7.9],[7.9,9.2],[9.2,9.6],[9.6,9.6],[9.6,10.1],[10.1,10.55],[10.55,11.9],[11.9,12.3],[12.3,13.5],[13.5,13.5],[13.5,14.4],[14.46,14.58]]},"sync":[[["என்ஜ","my lord"]],[["புற்கை","poor gruel"]],[["உண்டும்","even eating"]],[["பெருந்தோள்","great shoulders"]],[["பெருந்தோள்","great shoulders"],["அன்னே","O mother"]],[["யாமே","we indeed"]],[["புறஞ்சிறை","outer suburbs"]],[["இருந்தும்","even remaining"]],[["பொன்னன்னம்","golden beauty"]],[["பொன்னன்னம்","golden beauty"]],[["போறெதிர்ந்து","having opposed in battle"]],[["என்னை","my lord"]],[["போர்க்களம்","battlefield"]],[["புகினே","if he enters indeed"]],[["கல்லென்","making a bustling sound"]],[["பேரூர்","great town"]],[["விழவுடை","having festivals"]],[["ஆங்கண்","in that place"]],[["ஏமுற்று","having been bewildered / excited"]],[["கழிந்த","that passed / perished"]],[["மள்ளர்க்கு","to the warriors"]],[["உமணர்","salt-merchants"]],[["வெரூஉம்","fearing"]],[["துறையன்","he of the shore / ghat"]],[["அன்னே","is like indeed"]]]}