{"text":"purananuru","n":84,"lines":["என்ஜ புற்கை யுண்டும் பெருந்தோ ளன்னே","யாமே புறஞ்சிறை இருந்தும் பொன்னன் னம்மே","போறெதிர்ந்து என் ஜ் போர்க்களம் புகினே","கல்லென் பேரூர் விழவுடை ஆங்கண்","ஏமுற்றுக் கழிந்த மள்ளர்க்கு","உமணர் வெரூஉம் துறையன் னன்னே"],"tr":["eṉja puṟkai yuṇṭum peruntō ḷaṉṉē","yāmē puṟañciṟai iruntum poṉṉaṉ ṉammē","pōṟetirntu eṉ j pōrkkaḷam pukiṉē","kalleṉ pērūr viḻavuṭai āṅkaṇ","ēmuṟṟuk kaḻinta maḷḷarkku","umaṇar verūum tuṟaiyaṉ ṉaṉṉē"],"colophon":{"tinai":"kaikkiḷai","tinai_ta":"கைக்கிளை","turai_ta":"பழிச்சுதல்","poet_ta":"பெருங்கோழி நாய்கன் மகள் நக்கண்ணையார்","addressed_ta":"சோழன் போர்வைக்கோப் பெருநற்கிள்ளி","poet_tr":"Peruṅkōḻi Nāykaṉ Makaḷ Nakkaṇṇaiyār"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"1×5, 5×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 24, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"1 five-foot line (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"என்ஜபுற்கை","tr":"eṉjapuṟkai","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nirai","text":"ஜபுற்","tr":"japuṟ"},{"kind":"nēr","text":"கை","tr":"kai"}]},{"text":"யுண்டும்","tr":"yuṇṭum","foot":"tēmā","acai":[{"kind":"nēr","text":"யுண்","tr":"yuṇ"},{"kind":"nēr","text":"டும்","tr":"ṭum"}]},{"text":"பெருந்தோ","tr":"peruntō","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெருந்","tr":"perun"},{"kind":"nēr","text":"தோ","tr":"tō"}]},{"text":"ளன்னே","tr":"ḷaṉṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"ளன்","tr":"ḷaṉ"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}],[{"text":"யாமே","tr":"yāmē","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"மே","tr":"mē"}]},{"text":"புறஞ்சிறை","tr":"puṟañciṟai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"புறஞ்","tr":"puṟañ"},{"kind":"nirai","text":"சிறை","tr":"ciṟai"}]},{"tex