s"]],[["வலம்புரி","right-spiralled conches"]],[["ஆர்ப்ப","roaring"]],[["இரவுப்","of night"]],[["புறங்கண்ட","that saw the back"]],[["காலைத்","at morning"]],[["தோன்றி","appearing"]],[["எஃகு","steel weapons"],["இருள்","darkness"]],[["அகற்றும்","dispelling"]],[["ஏமப்","protective"]],[["பாசறை","camp"]],[["வைகறை","at dawn"]],[["அரவம்","sound"]],[["கேளியர்","may you hear"]],[["பலகோள்","many victories"]],[["செய்தார்","garland-wearer"]],[["மார்ப","O broad-chested one"]],[["எழுமதி","please rise"]],[["துயில்","from sleep"]],[["எனத்","thus"]],[["தெண்கண்","clear-skinned drumhead"]],[["மாக்கிணை","large drum"]],[["தெளிர்ப்ப","to sound clearly"]],[["ஒற்றி","beating"]],[["நெடுங்கடைத்","at the tall gate"]],[["தோன்றி","having appeared"]],[["யேனே","I indeed"]],[["அது","that"]],[["நயந்து","desiring"]],[["உள்ளி","thinking of"]],[["வந்த","who came"]],[["பரிசிலன்","the suppliant"]],[["இவன்","this man"]],[["என","thinking"]],[["நெய்யுறப்","soaked in ghee"]],[["பொரித்த","fried"]],[["குய்யுடை","having rich seasoning"]],[["நெடுஞ்சூடு","large pieces of roasted meat"]],[["மணிக்கலன்","gem-like vessels"]],[["நிறைந்த","filled with"]],[["மணநாறு","sweet-smelling"]],[["தேறல்","clear liquor"]],[["பாம்புரித்","sloughed snake-skin"]],[["தன்ன","like"]],[["வான்பூங்","fine white patterned"]],[["கலிங்கமொடு","with garments"]],[["மாரி","rain"]],[["யன்ன","like"]],[["வண்மையின்","with generosity"]],[["சொரிந்து","showering"]],[["வேனில்","summer"]],[["அன்ன","like"]],[["என்","my"]],[["வெப்பு","distress"]],[["நீங்க","to be removed"]],[["அருங்கலம்","rare ornaments"]],[["நல்கி","having granted"]],[["யோனே","he indeed"]],[["என்றும்","always"]],[["செறுவிற்","in the fields"]],[["பூத்த","blossomed"]],[["சேயிதழ்த்","red-petalled"]],[["தாமரை","lotus"]],[["அறுதொழில்","six-fold duties"]],[["அந்தணர்","sages"]],[["அறம்புரிந்து","performing righteousness"]],[["எடுத்த","nurtured"]],[["தீயடு","with sacrificial fire"]],[["விளங்கும்","shining"]],[["நாடன்","lord of the land"]],[["வாய்வாள்","of sharp sword"]],[["வலம்படு","victorious"]],[