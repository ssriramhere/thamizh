{"text":"purananuru","n":296,"lines":["வேம்புசினை ஒடிப்பவும் காஞ்சி பாடவும்","நெய்யுடைக் கையர் ஐயவி புகைப்பவும்","எல்லா மனையும் கல்லென் றவ்வே","வெந்துஉடன்று எறிவான் கொல்லோ","நெடிதுவந் தன்றால் நெடுந்தகை தேரே"],"tr":["vēmpuciṉai oṭippavum kāñci pāṭavum","neyyuṭaik kaiyar aiyavi pukaippavum","ellā maṉaiyum kalleṉ ṟavvē","ventuuṭaṉṟu eṟivāṉ kollō","neṭituvan taṉṟāl neṭuntakai tērē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"எறான் முல்லை","poet_ta":"வெள்ளை மாளர்","poet_tr":"Veḷḷai Māḷar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 9, āciriyattaḷai 8, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வேம்புசினை","tr":"vēmpuciṉai","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"வேம்","tr":"vēm"},{"kind":"nirai","text":"புசி","tr":"puci"},{"kind":"nēr","text":"னை","tr":"ṉai"}]},{"text":"யொடிப்பவும்","tr":"yoṭippavum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"யொடிப்","tr":"yoṭip"},{"kind":"nirai","text":"பவும்","tr":"pavum"}]},{"text":"காஞ்சி","tr":"kāñci","foot":"tēmā","acai":[{"kind":"nēr","text":"காஞ்","tr":"kāñ"},{"kind":"nēr","text":"சி","tr":"ci"}]},{"text":"பாடவும்","tr":"pāṭavum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nirai","text":"டவும்","tr":"ṭavum"}]}],[{"text":"நெய்யுடைக்","tr":"neyyuṭaik","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நெய்","tr":"ney"},{"kind":"nirai","text":"யுடைக்","tr":"yuṭaik"}]},{"text":"கைய","tr":"kaiya","foot":"tēmā","acai":[{"kind":"nēr","text":"கை","tr":"kai"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"ரையவி","tr":"raiyavi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ரை","tr":"rai"},{"kind":"nirai","text":"யவி","tr":"yavi"}]},{"text":"புகைப்பவு","tr":"pukaippavu","foot":"karuviḷam","acai":[{"kind":