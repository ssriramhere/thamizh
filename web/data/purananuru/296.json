emma":"உம்","gloss":"and"}],"gloss":"and breaking"},{"surface":"காஞ்சி","parts":[{"text":"காஞ்சி","lemma":"காஞ்சி","gloss":"Kāñci song"}],"gloss":"Kāñci song"},{"surface":"பாடவும்","parts":[{"text":"பாடு","lemma":"பாடு","gloss":"sing"},{"text":"அ","lemma":"அ","gloss":"infinitive marker"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and singing"}]},{"words":[{"surface":"நெய்யுடை","parts":[{"text":"நெய்","lemma":"நெய்","gloss":"ghee/oil"},{"text":"உடை","lemma":"உடை","gloss":"having"}],"gloss":"having ghee"},{"surface":"கையர்","parts":[{"text":"கை","lemma":"கை","gloss":"hand"},{"text":"அர்","lemma":"அர்","gloss":"pronominal plural suffix"}],"gloss":"those with hands"},{"surface":"ஐயவி","parts":[{"text":"ஐயவி","lemma":"ஐயவி","gloss":"white mustard"}],"gloss":"white mustard"},{"surface":"புகைப்பவும்","parts":[{"text":"புகை","lemma":"புகை","gloss":"smoke/fumigate"},{"text":"ப்ப","lemma":"ப்ப","gloss":"transitive/future marker"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and fumigating"}]},{"words":[{"surface":"எல்லா","parts":[{"text":"எல்லா","lemma":"எல்லா","gloss":"all"}],"gloss":"all"},{"surface":"மனையும்","parts":[{"text":"மனை","lemma":"மனை","gloss":"house"},{"text":"உம்","lemma":"உம்","gloss":"also/and"}],"gloss":"houses too"},{"surface":"கல்லென்று","parts":[{"text":"கல்","lemma":"கல்","gloss":"bustle (onomatopoeia)"},{"text":"என்று","lemma":"என்","gloss":"saying/making"}],"gloss":"making a bustling sound"},{"surface":"அவ்வே","parts":[{"text":"அவ்வே","lemma":"அவ்வே","gloss":"they indeed"}],"gloss":"they indeed","split_unverified":true}]},{"words":[{"surface":"வெந்து","parts":[{"text":"வெந்து","lemma":"வெந்து","gloss":"having burned (with anger)"}],"gloss":"having burned (with anger)","split_unverified":true},{"surface":"உடன்று","parts":[{"text":"உடன்று","lemma":"உடன்று","gloss":"having raged"}],"gloss":"having raged","split_unverified":true},{"surface":"எறிவான்","parts":[{"text":"எறி","lemma":"எறி","gloss":"strike/throw"},{"text":"வான்","lemma":"வான்","gloss":"he (future third person masculine)"}],"gloss":"he will strike"},{"surface":"கொல்லோ","parts":[{"text":"கொல்","lemma":"கொல்","gloss":"particle of doubt"},{"text":"ஓ","lemma":"ஓ","gloss":"particle of wonder"}],"gloss":"will he?"}]},{"words":[{"surface":"நெடிது","parts":[{"text":"நெடிது","lemma":"நெடிது","gloss":"from afar"}],"gloss":"from afar"},{"surface":"வந்தன்றால்","parts":[{"text":"வந்தன்றால்","lemma":"வந்தன்றால்","gloss":"it came indeed"}],"gloss":"it came indeed","split_unverified":true},{"surface":"நெடுந்தகை","parts":[{"text":"நெடுந்தகை","lemma":"நெடுந்தகை","gloss":"the man of great nobility"}],"gloss":"the man of great nobility","split_unverified":true},{"surface":"தேரே","parts":[{"text":"தேர்","lemma":"தேர்","gloss":"chariot"},{"text":"ஏ","lemma":"ஏ","gloss":"emphatic particle"}],"gloss":"the chariot indeed"}]}],"literal":"Neem branch breaking and, Kāñci song singing and, / having ghee hands-possessing-people white mustard fumigating and, / all houses too making a bustling sound they indeed [became]. / Having burned and raged, will he strike? / From afar came indeed, the great noble man's chariot indeed.","translation":"With neem branches being broken, and the Kāñci song being sung, and people with ghee-smeared hands fumigating white mustard, all the houses have become bustling with noise. Will he strike again, burning with rage? The chariot of the great noble warrior has arrived from afar.","modern":"வேப்பங்கிளைகளை ஒடித்தும், காஞ்சிப் பாடல்களை பாடியும், கைகளில் நெய்யை ஏந்தியவர்கள் வெண்கடுகைப் புகைத்தும் கொண்டிருப்பதால், எல்லா வீடுகளும் ஆரவார ஒலியுடன் விளங்குகின்றன. சினந்து வெந்து பகைவரை அவர் மீண்டும் தாக்குவாரோ? பெருந்தகையாளனின் தேர் நெடுந்தொலைவிலிருந்து வந்துவிட்டது.","explanation":"The poet Veḷḷai Māḷar describes the anxious atmosphere in a warrior's town after he returns severely wounded from battle. To protect him from evil spirits attracted to his wounds, the townspeople perform protective rituals: they break neem branches, sing the Kāñci song, and burn white mustard mixed with ghee. All the houses in the settlement are bustling with the noise of these protective activities. Despite his critical condition, the poet wonders if the warrior, burning with rage, will rise again to strike his enemies. The arrival of his chariot from afar highlights his unyielding heroic spirit, fitting the Vākai landscape.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.8],[0.85,1.4],[1.4,1.8],[1.8,2.0],[2.16,3.0],[3.0,3.5],[3.5,3.64],[3.64,4.8],[4.8,5.5],[5.5,5.9],[5.9,6.2],[6.37,6.53],[6.7,8.0],[8.0,8.6],[8.6,8.85],[9.1,9.73],[9.73,10.25],[10.25,10.71],[10.71,10.9]],"female":[[0.0,0.8],[0.85,1.4],[1.4,1.9],[1.9,2.2],[2.2,2.68],[2.68,2.96],[2.96,3.25],[3.25,3.6],[3.6,4.47],[4.76,6.2],[6.2,6.69],[6.69,6.98],[6.98,7.66],[7.66,8.21],[8.21,8.63],[9.6,10.33],[10.33,10.85],[10.85,11.31],[11.31,11.5]]},"sync":[[["வேம்பு","neem tree"],["சினை","branch"]],[["ஒடிப்பவும்","and breaking"]],[["காஞ்சி","Kāñci song"]],[["பாடவும்","and singing"]],[["நெய்யுடை","having ghee"]],[["கையர்","those with hands"]],[["ஐயவி","white mustard"]],[["புகைப்பவும்","and fumigating"]],[["எல்லா","all"]],[["மனையும்","houses too"]],[["கல்லென்று","making a bustling sound"]],[["கல்லென்று","making a bustling sound"],["அவ்வே","they indeed"]],[["வெந்து","having burned (with anger)"],["உடன்று","having raged"]],[["எறிவான்","he will strike"]],[["கொல்லோ","will he?"]],[["நெடிது","from afar"],["வந்தன்றால்","it came indeed"]],[["வந்தன்றால்","it came indeed"]],[["நெடுந்தகை","the man of great nobility"]],[["தேரே","the chariot indeed"]]]}