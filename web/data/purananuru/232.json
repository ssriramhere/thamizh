{"text":"purananuru","n":232,"lines":["இல்லா கியரோ காலை மாலை","அல்லா கியர் யான் வாழும் நாளே","நடுகல் பீலி சூட்டி நார்அரி","சிறுகலத்து உகுப்பவும் கொள்வன் கொல்லொ","கோடு உயர் பிறங்குமலை கெழீஇய","நாடு உடன் கொடுப்புவும் கொள்ளா தோனே"],"tr":["illā kiyarō kālai mālai","allā kiyar yāṉ vāḻum nāḷē","naṭukal pīli cūṭṭi nārari","ciṟukalattu ukuppavum koḷvaṉ kollo","kōṭu uyar piṟaṅkumalai keḻīiya","nāṭu uṭaṉ koṭuppuvum koḷḷā tōṉē"],"colophon":{"tinai":"tumpai","tinai_ta":"தும்பை","turai_ta":"பாண்பாட்டும் ஆம்","poet_ta":"ஔவையார்","addressed_ta":"அதியமான் நெடுமான் அஞ்சி","poet_tr":"Auvaiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"6×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 24"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 7"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இல்லா","tr":"illā","foot":"tēmā","acai":[{"kind":"nēr","text":"இல்","tr":"il"},{"kind":"nēr","text":"லா","tr":"lā"}]},{"text":"கியரோ","tr":"kiyarō","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிய","tr":"kiya"},{"kind":"nēr","text":"ரோ","tr":"rō"}]},{"text":"காலை","tr":"kālai","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"மாலை","tr":"mālai","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"லை","tr":"lai"}]}],[{"text":"யல்லா","tr":"yallā","foot":"tēmā","acai":[{"kind":"nēr","text":"யல்","tr":"yal"},{"kind":"nēr","text":"லா","tr":"lā"}]},{"text":"கியர்யான்","tr":"kiyaryāṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கியர்","tr":"kiyar"},{"kind":"nēr","text":"யான்","tr":"yāṉ"}]},{"text":"வாழும்","tr":"vāḻum","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ழும்","tr":"ḻum"}]},{"text":"நாளே","tr":"nāḷē","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"ளே","tr":"ḷē"}]}],[{"tex