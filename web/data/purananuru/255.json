{"text":"purananuru","n":255,"lines":["ஐயோ எனின் யான் புலி அஞ் சுவலே","அணைத்தனன் கொளினே அகன்மார்புஎடுக்கல்லேன்","என்போல் பெருவிதிர்ப்பு உறுக நின்னை","இன்னாது உற்ற அறனில் கூற்றே","திரைவளை முன்கை பற்றி","வரைநிழல் சேர்கம் நடந்திசின் சிறிதே"],"tr":["aiyō eṉiṉ yāṉ puli añ cuvalē","aṇaittaṉaṉ koḷiṉē akaṉmārpueṭukkallēṉ","eṉpōl peruvitirppu uṟuka niṉṉai","iṉṉātu uṟṟa aṟaṉil kūṟṟē","tiraivaḷai muṉkai paṟṟi","varainiḻal cērkam naṭanticiṉ ciṟitē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"முதுபாலை","poet_ta":"வன்பரணர்","poet_tr":"Vaṉparaṇar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 14, āciriyattaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஐயோ","tr":"aiyō","foot":"tēmā","acai":[{"kind":"nēr","text":"ஐ","tr":"ai"},{"kind":"nēr","text":"யோ","tr":"yō"}]},{"text":"வெனின்யான்","tr":"veṉiṉyāṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"வெனின்","tr":"veṉiṉ"},{"kind":"nēr","text":"யான்","tr":"yāṉ"}]},{"text":"புலியஞ்","tr":"puliyañ","foot":"puḷimā","acai":[{"kind":"nirai","text":"புலி","tr":"puli"},{"kind":"nēr","text":"யஞ்","tr":"yañ"}]},{"text":"சுவலே","tr":"cuvalē","foot":"puḷimā","acai":[{"kind":"nirai","text":"சுவ","tr":"cuva"},{"kind":"nēr","text":"லே","tr":"lē"}]}],[{"text":"யணைத்தனன்","tr":"yaṇaittaṉaṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"யணைத்","tr":"yaṇait"},{"kind":"nirai","text":"தனன்","tr":"taṉaṉ"}]},{"text":"கொளினே","tr":"koḷiṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"கொளி","tr":"koḷi"},{"kind":"nēr","text":"னே","tr":"ṉē"}]},{"text":"யகன்மார்","tr":"yakaṉmār","foot":"puḷimā","acai":[{"kind":"nirai","text":"யகன்","tr":"yakaṉ"},{"kind":"nēr","text":"மார்","tr":"mār"}]},{"text":"பெடுக்கல்லே","tr":"peṭukkallē","foot":"puḷimāṅkāy","acai":[{"kind":"