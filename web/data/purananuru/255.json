rai","text":"நடந்","tr":"naṭan"},{"kind":"nirai","text":"திசின்","tr":"ticiṉ"}]},{"text":"சிறிதே","tr":"ciṟitē","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிறி","tr":"ciṟi"},{"kind":"nēr","text":"தே","tr":"tē"}]}]]},"ai":{"lines":[{"words":[{"surface":"ஐயோ","parts":[{"text":"ஐயோ","lemma":"aiyō","gloss":"alas"}],"gloss":"alas"},{"surface":"எனின்","parts":[{"text":"என்","lemma":"eṉ","gloss":"say"},{"text":"இன்","lemma":"iṉ","gloss":"if"}],"gloss":"if I say"},{"surface":"யான்","parts":[{"text":"யான்","lemma":"yāṉ","gloss":"I"}],"gloss":"I"},{"surface":"புலி","parts":[{"text":"புலி","lemma":"puli","gloss":"tiger"}],"gloss":"tiger"},{"surface":"அஞ்சுவலே","parts":[{"text":"அஞ்சு","lemma":"añcu","gloss":"fear"},{"text":"வல்","lemma":"val","gloss":"will-I"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"I fear indeed"}]},{"words":[{"surface":"அணைத்தனன்","parts":[{"text":"அணை","lemma":"aṇai","gloss":"embrace"},{"text":"த்","lemma":"t","gloss":"past"},{"text":"அன்","lemma":"aṉ","gloss":"empty particle"},{"text":"அன்","lemma":"aṉ","gloss":"I"}],"gloss":"I embraced"},{"surface":"கொளினே","parts":[{"text":"கொள்","lemma":"koḷ","gloss":"take"},{"text":"இன்","lemma":"iṉ","gloss":"if"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"if I hold"},{"surface":"அகன்","parts":[{"text":"அகன்","lemma":"அகன்","gloss":"wide"}],"gloss":"wide","split_unverified":true},{"surface":"மார்பு","parts":[{"text":"மார்பு","lemma":"mārpu","gloss":"chest"}],"gloss":"chest"},{"surface":"எடுக்கல்லேன்","parts":[{"text":"எடு","lemma":"eṭu","gloss":"lift"},{"text":"கு","lemma":"ku","gloss":"increment"},{"text":"அல்","lemma":"al","gloss":"not"},{"text":"ஏன்","lemma":"ēṉ","gloss":"I"}],"gloss":"I cannot lift"}]},{"words":[{"surface":"என்","parts":[{"text":"என்","lemma":"eṉ","gloss":"my"}],"gloss":"my"},{"surface":"போல்","parts":[{"text":"போல்","lemma":"pōl","gloss":"like"}],"gloss":"like"},{"surface":"பெரு","parts":[{"text":"பெரு","lemma":"peru","gloss":"great"}],"gloss":"great"},{"surface":"விதிர்ப்பு","parts":[{"text":"விதிர்ப்பு","lemma":"vitirppu","gloss":"trembling"}],"gloss":"trembling"},{"surface":"உறுக","parts":[{"text":"உறு","lemma":"uṟu","gloss":"experience"},{"text":"க","lemma":"ka","gloss":"optative"}],"gloss":"may you suffer"},{"surface":"நின்னை","parts":[{"text":"நின்னை","lemma":"நின்னை","gloss":"you"}],"gloss":"you","split_unverified":true}]},{"words":[{"surface":"இன்னாது","parts":[{"text":"இன்னா","lemma":"iṉṉā","gloss":"painful"},{"text":"து","lemma":"tu","gloss":"it"}],"gloss":"painfully"},{"surface":"உற்ற","parts":[{"text":"உற்ற","lemma":"உற்ற","gloss":"that befell"}],"gloss":"that befell","split_unverified":true},{"surface":"அறன்","parts":[{"text":"அறன்","lemma":"அறன்","gloss":"virtue"}],"gloss":"virtue","split_unverified":true},{"surface":"இல்","parts":[{"text":"இல்","lemma":"il","gloss":"without"}],"gloss":"without"},{"surface":"கூற்றே","parts":[{"text":"கூற்று","lemma":"kūṟṟu","gloss":"Death"},{"text":"ஏ","lemma":"ē","gloss":"vocative"}],"gloss":"O Death!"}]},{"words":[{"surface":"திரை","parts":[{"text":"திரை","lemma":"tirai","gloss":"wave"}],"gloss":"wave"},{"surface":"வளை","parts":[{"text":"வளை","lemma":"vaḷai","gloss":"bangle"}],"gloss":"bangle"},{"surface":"முன்கை","parts":[{"text":"முன்","lemma":"muṉ","gloss":"fore"},{"text":"கை","lemma":"kai","gloss":"arm"}],"gloss":"forearm"},{"surface":"பற்றி","parts":[{"text":"பற்று","lemma":"paṟṟu","gloss":"grasp"},{"text":"இ","lemma":"i","gloss":"having done"}],"gloss":"having grasped"}]},{"words":[{"surface":"வரை","parts":[{"text":"வரை","lemma":"varai","gloss":"mountain"}],"gloss":"mountain"},{"surface":"நிழல்","parts":[{"text":"நிழல்","lemma":"niṉal","gloss":"shade"}],"gloss":"shade"},{"surface":"சேர்கம்","parts":[{"text":"சேர்","lemma":"cēr","gloss":"reach"},{"text":"கம்","lemma":"kam","gloss":"let us"}],"gloss":"let us reach"},{"surface":"நடந்திசின்","parts":[{"text":"நடந்திசின்","lemma":"நடந்திசின்","gloss":"please walk"}],"gloss":"please walk","split_unverified":true},{"surface":"சிறிதே","parts":[{"text":"சிறிது","lemma":"ciṟitu","gloss":"a little"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"a little"}]}],"literal":"Alas! if I say, I fear the tiger / If I embrace and take him, his wide chest I cannot lift / Like me, may you suffer a great trembling / O merciless Death who brought this painful state! / Holding my forearm adorned with conch bangles, / walk a little, let us reach the mountain shade.","translation":"If I cry out \"Alas!\", I fear the tiger will come. If I try to lift him in my embrace, I cannot lift his broad chest. O merciless Death, who brought this painful end, may you suffer a great trembling just like me! My love, hold my forearm with its conch bangles; walk just a little, and let us reach the shade of the mountain.","modern":"\"ஐயோ\" என்று நான் கதறினால், புலி வந்துவிடுமோ என்று அஞ்சுகிறேன். அவனது அகன்ற மார்பைத் தழுவித் தூக்க முயன்றால், என்னால் தூக்க முடியவில்லை. எங்களுக்குத் துன்பம் தந்த இரக்கமற்ற கூற்றுவனே (எமனே), நீயும் என்னைப்போலவே பெரு நடுக்கத்தை அடைவாயாக! என் வளையல் அணிந்த முன்கையைப் பற்றிக்கொண்டு, சிறிது தூரம் நடந்து அந்த மலை நிழலை அடைவோம், எழுந்து வா.","explanation":"This poignant poem belongs to the Poduviyal tiṇai and the Mudupālai tuṟai, depicting a wife's lament over her dying or deceased husband in the harsh desert wilderness. The speaker is the wife, who finds herself in an agonizing dilemma. If she screams in grief, she fears attracting predatory tigers; yet she lacks the physical strength to lift and carry her husband's broad, heavy chest. In her despair, she curses Death (Kūṟṟu) for its merciless cruelty, wishing it would experience the same violent trembling of grief that she feels. Finally, speaking to her husband as if he were still alive, she begs him to hold her bangled forearm and walk just a little further to the safety of the mountain shade.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.5],[0.57,0.7],[0.89,1.09],[1.09,1.3],[2.0,2.13],[2.13,2.26],[2.26,2.94],[2.94,3.27],[3.27,4.7],[4.7,5.5],[5.5,6.2],[6.2,6.5],[6.5,6.8],[6.8,7.26],[7.26,7.6],[7.6,7.8],[7.8,8.5],[8.5,9.7],[10.0,10.3],[10.3,10.6],[10.6,10.9],[10.9,11.5],[11.5,11.83],[11.9,12.4]],"female":[[0.0,0.6],[0.6,0.96],[0.96,1.2],[1.2,1.7],[1.7,1.92],[1.92,2.22],[2.22,3.0],[3.0,3.39],[3.39,5.09],[5.4,6.6],[6.6,7.4],[7.4,7.8],[7.8,8.36],[8.36,9.1],[9.1,9.4],[9.4,9.6],[9.6,9.99],[9.99,10.5],[10.5,10.92],[11.34,12.4],[12.4,13.7],[13.7,14.1],[14.1,14.94],[14.94,15.2]]},"sync":[[["ஐயோ","alas"]],[["எனின்","if I say"]],[["யான்","I"]],[["புலி","tiger"]],[["அஞ்சுவலே","I fear indeed"]],[["அஞ்சுவலே","I fear indeed"]],[["அணைத்தனன்","I embraced"]],[["கொளினே","if I hold"]],[["அகன்","wide"],["மார்பு","chest"],["எடுக்கல்லேன்","I cannot lift"]],[["என்","my"],["போல்","like"]],[["பெரு","great"],["விதிர்ப்பு","trembling"]],[["உறுக","may you suffer"]],[["நின்னை","you"]],[["இன்னாது","painfully"]],[["உற்ற","that befell"]],[["அறன்","virtue"],["இல்","without"]],[["கூற்றே","O Death!"]],[["திரை","wave"],["வளை","bangle"]],[["முன்கை","forearm"]],[["பற்றி","having grasped"]],[["வரை","mountain"],["நிழல்","shade"]],[["சேர்கம்","let us reach"]],[["நடந்திசின்","please walk"]],[["சிறிதே","a little"]]]}