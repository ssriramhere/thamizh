{"text":"purananuru","n":172,"lines":["ஏற்றுக உலையே ஆக்குக சோறே","கள்ளும் குறைபடல் ஓம்புக ஒள்ளிழைப்","பாடுவல் விறலியர் கோதையும் புனைக","அன்னவை பலவும் செய்க என்னதூஉம்","பரியல் வெண்டா வருபதம் நாடி","ஐவனங் காவல் பெய்தீ நந்தின்","ஒளிதிகழ் திருந்துமணி நளியிருள் அகற்றும்","வன்புல நாடன் வயமான் பிட்டன்","ஆரமர் கடக்கும் வேலும் அவனிறை","மாவள் ஈகைக் கோதையும்","மாறுகொள் மன்னரும் வாழியர் நெடிதே"],"tr":["ēṟṟuka ulaiyē ākkuka cōṟē","kaḷḷum kuṟaipaṭal ōmpuka oḷḷiḻaip","pāṭuval viṟaliyar kōtaiyum puṉaika","aṉṉavai palavum ceyka eṉṉatūum","pariyal veṇṭā varupatam nāṭi","aivaṉaṅ kāval peytī nantiṉ","oḷitikaḻ tiruntumaṇi naḷiyiruḷ akaṟṟum","vaṉpula nāṭaṉ vayamāṉ piṭṭaṉ","āramar kaṭakkum vēlum avaṉiṟai","māvaḷ īkaik kōtaiyum","māṟukoḷ maṉṉarum vāḻiyar neṭitē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"இயன்மொழி","poet_ta":"வடமண்ணக்கன் தாமோதரனார்","addressed_ta":"பிட்டங்கொற்றன்","poet_tr":"Vaṭamaṇṇakkaṉ Tāmōtaraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"11 lines"},{"name":"feet per line","ok":true,"detail":"10×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 40, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 22, veṇṭaḷai 18, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஏற்றுக","tr":"ēṟṟuka","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஏற்","tr":"ēṟ"},{"kind":"nirai","text":"றுக","tr":"ṟuka"}]},{"text":"வுலையே","tr":"vulaiyē","foot":"puḷimā","acai":[{"kind":"nirai","text":"வுலை","tr":"vulai"},{"kind":"nēr","text":"யே","tr":"yē"}]},{"text":"யாக்குக","tr":"yākkuka","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யாக்","tr":"yāk"},{"kind":"nirai","text":"குக","tr":"kuka"}]},{"text":"சோறே","tr":"cōṟē","foot":"tēmā","acai":[{"kind":"nēr","text":"சோ","tr":"cō"},{"kind":"nēr","text":"றே","tr":"ṟē"}]}],[{"text":"கள்ளும்","tr":"kaḷḷum","foot":"tēmā","acai":[{"kind":"nēr","text":"கள்","tr":"kaḷ"},{"kind":"nēr","text":"ளும்","tr":"ḷum"}]},{"text"