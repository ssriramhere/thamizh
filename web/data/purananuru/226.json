{"text":"purananuru","n":226,"lines":["செற்றன்று ஆயினும் செயிர்த்தன்று ஆயினும்","உற்றன்று ஆயினும் உய்வின்று மாதோ","பாடுநர் போலக் கைதொழுது ஏத்தி","இரந்தன்று ஆகல் வேண்டும் பொலந்தார்","மண்டமர் கடக்கும் தானைத்","திண்தேர் வளவற் கொண்ட கூற்றே"],"tr":["ceṟṟaṉṟu āyiṉum ceyirttaṉṟu āyiṉum","uṟṟaṉṟu āyiṉum uyviṉṟu mātō","pāṭunar pōlak kaitoḻutu ētti","irantaṉṟu ākal vēṇṭum polantār","maṇṭamar kaṭakkum tāṉait","tiṇtēr vaḷavaṟ koṇṭa kūṟṟē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"கையறுநிலை","poet_ta":"மாறோக்கத்து நப்பசலையார்","addressed_ta":"சோழன் குளுமுற்றத்துத் துஞ்சிய கிள்ளி வளவன்","poet_tr":"Māṟōkkattu Nappacalaiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"6×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 24"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"செற்றன்","tr":"ceṟṟaṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"செற்","tr":"ceṟ"},{"kind":"nēr","text":"றன்","tr":"ṟaṉ"}]},{"text":"றாயினும்","tr":"ṟāyiṉum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"றா","tr":"ṟā"},{"kind":"nirai","text":"யினும்","tr":"yiṉum"}]},{"text":"செயிர்த்தன்","tr":"ceyirttaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"செயிர்த்","tr":"ceyirt"},{"kind":"nēr","text":"தன்","tr":"taṉ"}]},{"text":"றாயினு","tr":"ṟāyiṉu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"றா","tr":"ṟā"},{"kind":"nirai","text":"யினு","tr":"yiṉu"}]}],[{"text":"முற்றன்","tr":"muṟṟaṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"முற்","tr":"muṟ"},{"kind":"nēr","text":"றன்","tr":"ṟaṉ"}]},{"text":"றாயினு","tr":"ṟāyiṉu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"றா","tr":"ṟā"},{"kind":"nirai","text":"யினு","tr":"yiṉu"}]},{"text":"முய்வின்","tr":"muyviṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"முய்","tr":"muy"},{"kind":"nēr","text":"வின்","tr":"viṉ"}]},{"text":"றுமாதோ