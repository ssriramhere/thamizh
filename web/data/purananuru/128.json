{"text":"purananuru","n":128,"lines":["மன்றப் பலவின் மாச்சினை மந்தி","இரவலர் நாற்றிய விசிகூடு முழவின்","பாடின் தெண்கண் கனி செத்து அடிப்பின்","அன்னச் சேவல் மாறு எழுந்து ஆலும்","கழல் தொடி ஆஅய் மழை தவழ் பொதியில்","ஆடு மகள் குறுகின் அல்லது","பீடுகெழு மன்னர் குறுகலோ அரிதே"],"tr":["maṉṟap palaviṉ mācciṉai manti","iravalar nāṟṟiya vicikūṭu muḻaviṉ","pāṭiṉ teṇkaṇ kaṉi cettu aṭippiṉ","aṉṉac cēval māṟu eḻuntu ālum","kaḻal toṭi āay maḻai tavaḻ potiyil","āṭu makaḷ kuṟukiṉ allatu","pīṭukeḻu maṉṉar kuṟukalō aritē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"வாழ்த்து; இயன்மொழியும் ஆம்","poet_ta":"உறையூர் ஏணிச்சேரி முடமோசியார்","addressed_ta":"ஆய் அண்டிரன்","poet_tr":"Uṟaiyūr Ēṇiccēri Muṭamōciyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 15, āciriyattaḷai 11"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மன்றப்","tr":"maṉṟap","foot":"tēmā","acai":[{"kind":"nēr","text":"மன்","tr":"maṉ"},{"kind":"nēr","text":"றப்","tr":"ṟap"}]},{"text":"பலவின்","tr":"palaviṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பல","tr":"pala"},{"kind":"nēr","text":"வின்","tr":"viṉ"}]},{"text":"மாச்சினை","tr":"mācciṉai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மாச்","tr":"māc"},{"kind":"nirai","text":"சினை","tr":"ciṉai"}]},{"text":"மந்தி","tr":"manti","foot":"tēmā","acai":[{"kind":"nēr","text":"மந்","tr":"man"},{"kind":"nēr","text":"தி","tr":"ti"}]}],[{"text":"யிரவலர்","tr":"yiravalar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"யிர","tr":"yira"},{"kind":"nirai","text":"வலர்","tr":"valar"}]},{"text":"நாற்றிய","tr":"nāṟṟiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நாற்","tr":"nāṟ"},{"kind":"nirai","text":"றிய","tr":"ṟiya"}]},{"text":"விசிகூ","tr":"vicikū","foot":"puḷimā","acai":[{"kind":"nirai","text":"விசி","tr":