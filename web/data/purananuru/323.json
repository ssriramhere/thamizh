{"text":"purananuru","n":323,"lines":["புலிப்பாற் பட்ட ஆமான் குழவிக்குச்","சினங்கழி மூதாக் கன்றுமடுத்து ஊட்டும்","கா … க்கு","உள்ளியது சுரக்கும் ஓம்பா ஈகை","வெள்வேல் ஆவம்ஆயின் ஒள் வாள்","கறையடி யானைக்கு அல்லது","உறைகழிப் பறியா வேலோன் ஊரே"],"tr":["pulippāṟ paṭṭa āmāṉ kuḻavikkuc","ciṉaṅkaḻi mūtāk kaṉṟumaṭuttu ūṭṭum","kā kku","uḷḷiyatu curakkum ōmpā īkai","veḷvēl āvamāyiṉ oḷ vāḷ","kaṟaiyaṭi yāṉaikku allatu","uṟaikaḻip paṟiyā vēlōṉ ūrē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"வல்லாண் முல்லை","addressed_ta":"பெயர்கள் தெரிந்தில"},"scan":{"meter":"not a regular āciriyappā","ok":false,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":false,"detail":"5×4, 1×3, 1×0 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 20, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 6, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"புலிப்பாற்","tr":"pulippāṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"புலிப்","tr":"pulip"},{"kind":"nēr","text":"பாற்","tr":"pāṟ"}]},{"text":"பட்ட","tr":"paṭṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"பட்","tr":"paṭ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"வாமான்","tr":"vāmāṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"மான்","tr":"māṉ"}]},{"text":"குழவிக்குச்","tr":"kuḻavikkuc","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"குழ","tr":"kuḻa"},{"kind":"nēr","text":"விக்","tr":"vik"},{"kind":"nēr","text":"குச்","tr":"kuc"}]}],[{"text":"சினங்கழி","tr":"ciṉaṅkaḻi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சினங்","tr":"ciṉaṅ"},{"kind":"nirai","text":"கழி","tr":"kaḻi"}]},{"text":"மூதாக்","tr":"mūtāk","foot":"tēmā","acai":[{"kind":"nēr","text":"மூ","tr":"mū"},{"kind":"nēr","text":"தாக்","tr":"tāk"}]},{"text":"கன்றுமடுத்","tr":"kaṉṟumaṭut","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"கன்","tr":"kaṉ"},{"kind":"nirai","text":"றும","tr":"ṟuma"},{"kind":"nēr","text":"ட