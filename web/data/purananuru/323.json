:"tēmā","acai":[{"kind":"nēr","text":"வே","tr":"vē"},{"kind":"nēr","text":"லோ","tr":"lō"}]},{"text":"னூரே","tr":"ṉūrē","foot":"tēmā","acai":[{"kind":"nēr","text":"னூ","tr":"ṉū"},{"kind":"nēr","text":"ரே","tr":"rē"}]}]]},"ai":{"lines":[{"words":[{"surface":"புலிப்பால்","parts":[{"text":"புலி","lemma":"புலி","gloss":"tiger"},{"text":"பால்","lemma":"பால்","gloss":"vicinity"}],"gloss":"vicinity of a tiger"},{"surface":"பட்ட","parts":[{"text":"பட்ட","lemma":"படு","gloss":"caught"}],"gloss":"caught"},{"surface":"ஆமான்","parts":[{"text":"ஆமான்","lemma":"ஆமான்","gloss":"wild cow"}],"gloss":"wild cow"},{"surface":"குழவிக்கு","parts":[{"text":"குழவி","lemma":"குழவி","gloss":"calf"},{"text":"க்கு","lemma":"கு","gloss":"to"}],"gloss":"to the calf"}]},{"words":[{"surface":"சினங்கழி","parts":[{"text":"சினம்","lemma":"சினம்","gloss":"grief"},{"text":"கழி","lemma":"கழி","gloss":"passed"}],"gloss":"whose grief has passed"},{"surface":"மூதா","parts":[{"text":"மூது","lemma":"மூது","gloss":"old"},{"text":"ஆ","lemma":"ஆ","gloss":"cow"}],"gloss":"old cow"},{"surface":"கன்று","parts":[{"text":"கன்று","lemma":"கன்று","gloss":"calf"}],"gloss":"calf"},{"surface":"மடுத்து","parts":[{"text":"மடுத்து","lemma":"மடு","gloss":"offered"}],"gloss":"having offered"},{"surface":"ஊட்டும்","parts":[{"text":"ஊட்டும்","lemma":"ஊட்டு","gloss":"nursing"}],"gloss":"nursing"}]},{"words":[{"surface":"கா","parts":[{"text":"கா","lemma":"கா","gloss":"forest"}],"gloss":"forest"},{"surface":"…","parts":[{"text":"…","lemma":"…","gloss":"gap"}],"gloss":"gap"},{"surface":"க்கு","parts":[{"text":"க்கு","lemma":"கு","gloss":"to"}],"gloss":"to"}]},{"words":[{"surface":"உள்ளியது","parts":[{"text":"உள்ளியது","lemma":"உள்ளு","gloss":"desired"}],"gloss":"what is desired"},{"surface":"சுரக்கும்","parts":[{"text":"சுரக்கும்","lemma":"சுர","gloss":"yielding"}],"gloss":"yielding"},{"surface":"ஓம்பா","parts":[{"text":"ஓம்பா","lemma":"ஓம்பு","gloss":"unstinting"}],"gloss":"unstinting"},{"surface":"ஈகை","parts":[{"text":"ஈகை","lemma":"ஈகை","gloss":"generosity"}],"gloss":"generosity"}]},{"words":[{"surface":"வெள்வேல்","parts":[{"text":"வெள்","lemma":"வெள்","gloss":"bright"},{"text":"வேல்","lemma":"வேல்","gloss":"spear"}],"gloss":"bright spear"},{"surface":"ஆவம்","parts":[{"text":"ஆவம்","lemma":"ஆவம்","gloss":"quiver"}],"gloss":"quiver"},{"surface":"ஆயின்","parts":[{"text":"ஆயின்","lemma":"ஆயின்","gloss":"if it is"}],"gloss":"if it is"},{"surface":"ஒள்","parts":[{"text":"ஒள்","lemma":"ஒள்","gloss":"bright"}],"gloss":"bright"},{"surface":"வாள்","parts":[{"text":"வாள்","lemma":"வாள்","gloss":"sword"}],"gloss":"sword"}]},{"words":[{"surface":"கறையடி","parts":[{"text":"கறை","lemma":"கறை","gloss":"pillar"},{"text":"அடி","lemma":"அடி","gloss":"foot"}],"gloss":"pillar-footed"},{"surface":"யானைக்கு","parts":[{"text":"யானை","lemma":"யானை","gloss":"elephant"},{"text":"க்கு","lemma":"கு","gloss":"to"}],"gloss":"to the elephant"},{"surface":"அல்லது","parts":[{"text":"அல்லது","lemma":"அல்","gloss":"except"}],"gloss":"except"}]},{"words":[{"surface":"உறைகழிப்பு","parts":[{"text":"உறை","lemma":"உறை","gloss":"sheath"},{"text":"கழிப்பு","lemma":"கழி","gloss":"drawing"}],"gloss":"drawing from sheath"},{"surface":"அறியா","parts":[{"text":"அறியா","lemma":"அறி","gloss":"not knowing"}],"gloss":"not knowing"},{"surface":"வேலோன்","parts":[{"text":"வேலோன்","lemma":"வேலோன்","gloss":"he of the spear"}],"gloss":"he of the spear","split_unverified":true},{"surface":"ஊரே","parts":[{"text":"ஊர்","lemma":"ஊர்","gloss":"town"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"is the town indeed"}]}],"literal":"To the calf of the wild cow caught in the vicinity of a tiger / an old cow whose grief has passed, offering her teat, nurses / in the forest ... to / yielding what is desired, unstinting generosity / if the quiver of bright spears is like that, the bright sword / except for the pillar-footed elephant / does not know being drawn from its sheath, such is the town of the spear-bearing warrior.","translation":"In the forest, an old domestic cow whose grief has passed nurses the calf of a wild cow that was killed by a tiger, by offering her own teat. In such a place, if his quiver of bright spears is like unstinting generosity that yields whatever is desired, his bright sword is never drawn from its sheath except to strike down pillar-legged elephants. Such is the town of this spear-bearing warrior.","modern":"புலியிடம் அகப்பட்டுக்கொண்ட காட்டுப் பசுவின் கன்றுக்கு, தன் கன்றை இழந்த துயரம் நீங்கிய வீட்டுப் பசுவானது தன் மடியைச் சேர்த்துப் பால் புகட்டும் காட்டை உடையது அந்த ஊர். வேண்டியதை எல்லாம் வாரி வழங்கும் வள்ளல் தன்மை கொண்ட வெண்மையான வேல்களைக் கொண்ட அம்பறாத்தூணியை உடையவன் அந்த வீரன். அவனது ஒளிரும் வாளானது, உரல் போன்ற கால்களை உடைய யானைகளை வீழ்த்துவதற்கே அன்றி, பிறவற்றிற்காக உறையிலிருந்து வெளிப்பட அறியாது. அத்தகைய வேலேந்திய வீரனின் ஊர் இதுவாகும்.","explanation":"This poem belongs to the Vākai tiṇai and Vallāṇ Mullai tuṟai, which celebrates the strength, valor, and domestic virtue of a warrior in the forest region. The poet describes the warrior's town and his exceptional valor. The opening image shows an old domestic cow nursing an orphaned wild cow calf whose mother was killed by a tiger. This image of natural compassion and abundance sets the tone for the warrior's own character. The warrior's quiver is filled with bright spears that are always ready to be given like unstinting generosity that yields whatever is desired. His bright sword is so noble and powerful that it is never drawn from its sheath for minor foes, but only to face mighty, pillar-legged enemy elephants.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,1.0],[1.0,1.2],[1.2,2.09],[2.09,3.01],[3.01,3.23],[3.23,3.4],[3.47,3.6],[3.6,3.6],[3.6,3.6],[3.6,5.8],[5.8,5.9],[5.9,6.3],[6.3,6.9],[6.9,7.03],[7.06,7.08],[7.08,7.08],[7.08,7.1],[7.1,9.5],[9.5,10.1],[10.1,10.3],[11.0,11.08],[11.24,11.4],[11.4,12.2],[12.2,12.3]],"female":[[0.0,0.6],[0.6,1.0],[1.0,1.3],[1.3,2.28],[2.28,3.6],[3.6,3.8],[3.8,3.8],[3.8,4.8],[4.8,4.8],[4.8,4.8],[4.8,6.8],[6.8,7.0],[7.0,7.6],[7.6,8.3],[8.3,9.01],[9.19,9.72],[9.72,9.72],[9.72,9.9],[9.9,11.3],[11.3,12.3],[12.3,12.6],[12.6,13.7],[13.7,14.2],[14.2,14.7],[14.7,14.8]]},"sync":[[["புலிப்பால்","vicinity of a tiger"]],[["பட்ட","caught"]],[["ஆமான்","wild cow"]],[["குழவிக்கு","to the calf"]],[["சினங்கழி","whose grief has passed"]],[["மூதா","old cow"]],[["கன்று","calf"],["மடுத்து","having offered"]],[["ஊட்டும்","nursing"]],[["கா","forest"]],[["க்கு","to"]],[["உள்ளியது","what is desired"]],[["சுரக்கும்","yielding"]],[["ஓம்பா","unstinting"]],[["ஈகை","generosity"]],[["வெள்வேல்","bright spear"]],[["ஆவம்","quiver"],["ஆயின்","if it is"]],[["ஒள்","bright"]],[["வாள்","sword"]],[["கறையடி","pillar-footed"]],[["யானைக்கு","to the elephant"]],[["அல்லது","except"]],[["உறைகழிப்பு","drawing from sheath"]],[["உறைகழிப்பு","drawing from sheath"],["அறியா","not knowing"]],[["வேலோன்","he of the spear"]],[["ஊரே","is the town indeed"]]]}