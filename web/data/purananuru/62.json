்","tr":"kam"}]},{"text":"நிறைய","tr":"niṟaiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"நிறை","tr":"niṟai"},{"kind":"nēr","text":"ய","tr":"ya"}]}],[{"text":"விருந்துபெற்","tr":"viruntupeṟ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விருந்","tr":"virun"},{"kind":"nirai","text":"துபெற்","tr":"tupeṟ"}]},{"text":"றனரால்","tr":"ṟaṉarāl","foot":"puḷimā","acai":[{"kind":"nirai","text":"றன","tr":"ṟaṉa"},{"kind":"nēr","text":"ரால்","tr":"rāl"}]},{"text":"பொலிகநும்","tr":"polikanum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பொலி","tr":"poli"},{"kind":"nirai","text":"கநும்","tr":"kanum"}]},{"text":"புகழே","tr":"pukaḻē","foot":"puḷimā","acai":[{"kind":"nirai","text":"புக","tr":"puka"},{"kind":"nēr","text":"ழே","tr":"ḻē"}]}]]},"ai":null}