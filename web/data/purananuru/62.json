்ப்","tr":"pēeyp","foot":"tēmā","acai":[{"kind":"nēr","text":"பே","tr":"pē"},{"kind":"nēr","text":"எய்ப்","tr":"eyp"}]},{"text":"பெண்டி","tr":"peṇṭi","foot":"tēmā","acai":[{"kind":"nēr","text":"பெண்","tr":"peṇ"},{"kind":"nēr","text":"டி","tr":"ṭi"}]}],[{"text":"ரெடுத்தெறி","tr":"reṭutteṟi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"ரெடுத்","tr":"reṭut"},{"kind":"nirai","text":"தெறி","tr":"teṟi"}]},{"text":"யனந்தற்","tr":"yaṉantaṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"யனந்","tr":"yaṉan"},{"kind":"nēr","text":"தற்","tr":"taṟ"}]},{"text":"பறைச்சீர்","tr":"paṟaiccīr","foot":"puḷimā","acai":[{"kind":"nirai","text":"பறைச்","tr":"paṟaic"},{"kind":"nēr","text":"சீர்","tr":"cīr"}]},{"text":"தூங்கப்","tr":"tūṅkap","foot":"tēmā","acai":[{"kind":"nēr","text":"தூங்","tr":"tūṅ"},{"kind":"nēr","text":"கப்","tr":"kap"}]}],[{"text":"பருந்தருந்","tr":"paruntarun","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பருந்","tr":"parun"},{"kind":"nirai","text":"தருந்","tr":"tarun"}]},{"text":"துற்றதா","tr":"tuṟṟatā","foot":"kūviḷam","acai":[{"kind":"nēr","text":"துற்","tr":"tuṟ"},{"kind":"nirai","text":"றதா","tr":"ṟatā"}]},{"text":"னையடு","tr":"ṉaiyaṭu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"னை","tr":"ṉai"},{"kind":"nirai","text":"யடு","tr":"yaṭu"}]},{"text":"செருமுனிந்","tr":"cerumuṉin","foot":"karuviḷam","acai":[{"kind":"nirai","text":"செரு","tr":"ceru"},{"kind":"nirai","text":"முனிந்","tr":"muṉin"}]}],[{"text":"தறத்தின்","tr":"taṟattiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"தறத்","tr":"taṟat"},{"kind":"nēr","text":"தின்","tr":"tiṉ"}]},{"text":"மண்டிய","tr":"maṇṭiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மண்","tr":"maṇ"},{"kind":"nirai","text":"டிய","tr":"ṭiya"}]},{"text":"மறப்போர்","tr":"maṟappōr","foot":"puḷimā","acai":[{"kind":"nirai","text":"மறப்","tr":"maṟap"},{"kind":"nēr","text":"போர்","tr":"pōr"}]},{"text":"வேந்தர்","tr":"vēntar","foot":"tēmā","acai":[{"kind":"nēr","text":"வேந்","tr":"vēn"},{"kind":"nēr","text":"தர்","tr":"tar"}]}],