{"text":"purananuru","n":365,"lines":["மயங்குஇருங் கருவிய விசும்புமுக னாக","இயங்கிய இருசுடர் கண் எனப் பெயரிய","வளியிடை வழங்கா வழக்கரு நீத்தம்","வயிரக் குறட்டின் வயங்குமணி யாரத்து","பொன்னந் திகிரி முன்சமத்து உருட்டிப்","பொருநர்க் காணாச் செருமிகு முன்பின்","முன்னோர் செல்லவும் செல்லாது இன்னும்","விலைநலப் பெண்டிரிற் பலர்மீக் கூற","உள்ளேன் வாழியர் யான் எனப் பன்மாண்","நிலமகள் அழுத காஞ்சியும்","உண்டென உரைப்பரால் உணர்ந்திசி னோரே"],"tr":["mayaṅkuiruṅ karuviya vicumpumuka ṉāka","iyaṅkiya irucuṭar kaṇ eṉap peyariya","vaḷiyiṭai vaḻaṅkā vaḻakkaru nīttam","vayirak kuṟaṭṭiṉ vayaṅkumaṇi yārattu","poṉṉan tikiri muṉcamattu uruṭṭip","porunark kāṇāc cerumiku muṉpiṉ","muṉṉōr cellavum cellātu iṉṉum","vilainalap peṇṭiriṟ palarmīk kūṟa","uḷḷēṉ vāḻiyar yāṉ eṉap paṉmāṇ","nilamakaḷ aḻuta kāñciyum","uṇṭeṉa uraipparāl uṇarntici ṉōrē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"பெருங்காஞ்சி","poet_ta":"மார்க்கண்டேயனார்","poet_tr":"Mārkkaṇṭēyaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"11 lines"},{"name":"feet per line","ok":true,"detail":"10×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 42, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 22, veṇṭaḷai 20"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மயங்கிருங்","tr":"mayaṅkiruṅ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மயங்","tr":"mayaṅ"},{"kind":"nirai","text":"கிருங்","tr":"kiruṅ"}]},{"text":"கருவிய","tr":"karuviya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கரு","tr":"karu"},{"kind":"nirai","text":"விய","tr":"viya"}]},{"text":"விசும்புமு","tr":"vicumpumu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விசும்","tr":"vicum"},{"kind":"nirai","text":"புமு","tr":"pumu"}]},{"text":"கனாக","tr":"kaṉāka","foot":"puḷimā","acai":[{"kind":"nirai","text":"கனா","tr":"kaṉā"},{"kind":"nēr","text":"க","tr":"ka"}]}],[{"text":"வியங்கிய","tr":"viyaṅkiya","foot":"karuviḷam","acai":[{"kind":"nirai