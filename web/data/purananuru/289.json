ன்","gloss":"for himself"}],"gloss":"for himself"},{"surface":"முகந்து","parts":[{"text":"முகந்து","lemma":"முக","gloss":"scooping up"}],"gloss":"scooping up"},{"surface":"ஏந்திய","parts":[{"text":"ஏந்திய","lemma":"ஏந்து","gloss":"holding up"}],"gloss":"holding up"},{"surface":"பசும்பொன்","parts":[{"text":"பசும்","lemma":"பசுமை","gloss":"pure"},{"text":"பொன்","lemma":"பொன்","gloss":"gold"}],"gloss":"pure gold"},{"surface":"மண்டை","parts":[{"text":"மண்டை","lemma":"மண்டை","gloss":"bowl"}],"gloss":"bowl"}]},{"words":[{"surface":"இவற்கு","parts":[{"text":"இவன்","lemma":"இவன்","gloss":"this man"},{"text":"கு","lemma":"கு","gloss":"to"}],"gloss":"to this man"},{"surface":"ஈக","parts":[{"text":"ஈக","lemma":"ஈ","gloss":"give"}],"gloss":"give"},{"surface":"என்னும்","parts":[{"text":"என்னும்","lemma":"என்","gloss":"saying"}],"gloss":"saying"},{"surface":"அதுவும்அன்","parts":[{"text":"அதுவும்அன்","lemma":"அதுவும்அன்","gloss":"not only that"}],"gloss":"not only that","split_unverified":true},{"surface":"றிசினே","parts":[{"text":"றிசினே","lemma":"றிசினே","gloss":"indeed"}],"gloss":"indeed","split_unverified":true}]},{"words":[{"surface":"கேட்டியோ","parts":[{"text":"கேட்டி","lemma":"கேள்","gloss":"listen"},{"text":"ஓ","lemma":"ஓ","gloss":"address"}],"gloss":"listen!"},{"surface":"வாழிபாண","parts":[{"text":"வாழிபாண","lemma":"வாழிபாண","gloss":"may you live long, oh bard!"}],"gloss":"may you live long, oh bard!","split_unverified":true},{"surface":"பாசறைப்","parts":[{"text":"பாசறை","lemma":"பாசறை","gloss":"army camp"},{"text":"ப்","lemma":"ப்","gloss":"sandhi"}],"gloss":"army camp"}]},{"words":[{"surface":"பூக்கோள்","parts":[{"text":"பூ","lemma":"பூ","gloss":"flower"},{"text":"கோள்","lemma":"கோள்","gloss":"taking"}],"gloss":"taking the battle-flower"},{"surface":"இன்று","parts":[{"text":"இன்று","lemma":"இன்று","gloss":"today"}],"gloss":"today"},{"surface":"என்று","parts":[{"text":"என்று","lemma":"என்","gloss":"saying"}],"gloss":"saying"},{"surface":"அறையும்","parts":[{"text":"அறையும்","lemma":"அறை","gloss":"announcing"}],"gloss":"announcing"}]},{"words":[{"surface":"மடிவாய்த்","parts":[{"text":"மடி","lemma":"மடி","gloss":"folded"},{"text":"வாய்","lemma":"வாய்","gloss":"mouth"},{"text":"த்","lemma":"த்","gloss":"sandhi"}],"gloss":"folded-mouthed"},{"surface":"தண்ணுமை","parts":[{"text":"தண்ணுமை","lemma":"தண்ணுமை","gloss":"drum"}],"gloss":"drum"},{"surface":"இழிசினன்","parts":[{"text":"இழிசினன்","lemma":"இழிசினன்","gloss":"drummer"}],"gloss":"drummer's"},{"surface":"குரலே","parts":[{"text":"குரல்","lemma":"குரல்","gloss":"sound"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"sound indeed"}]}],"literal":"Tiṇai and tuṟai are not known / Even though the wet season has helped, / looking at the good bull among many bulls, / like a farmer who selects them individually, / from the ancient families of great pride where many achievements abide, / among those householders, out of love, / the pure golden bowl scooped up and held for himself, / saying 'give to this man', it is not only that! / Listen, may you live long, oh bard! In the army camp, / announcing 'today is the day of wearing the battle-flower', / is the sound of the folded-mouthed drum of the drummer.","translation":"Tiṇai and tuṟai are not known. Even when the wet season has brought the right time for ploughing, a farmer looks among his many bulls and selects the best ones, one by one. Like him, from among the men of ancient, proud lineages where many glorious deeds abide, the king, out of love, points and says, 'Give this pure golden bowl, filled to the brim, to this man!' But it is not only that! Listen, may you live long, oh bard! In the army camp, the drummer's folded-mouthed drum resounds, announcing: 'Today is the day of taking up the battle-flower!'","modern":"திணை மற்றும் துறை அறியப்படவில்லை. ஈரப்பதம் உள்ள உழவுக் காலம் உதவி செய்த போதிலும், பல எருதுகளுக்குள்ளும் நல்ல எருதுகளை ஆராய்ந்து தனித்தனியாகத் தேர்ந்தெடுக்கும் உழவனைப் போல, பெருமை பொருந்திய பழங்குடியில் பிறந்து பல புகழ்களைத் தம்பால் கொண்ட மூதிலாளர்களுள், அரசன் தன் அன்பினால் தனக்கென முகந்து ஏந்திய பசும்பொன் கிண்ணத்தை 'இவனுக்குக் கொடுப்பாயாக' என்று சிறப்பித்துக் கூறுவது மட்டும் அல்லாமல்; பாணனே! நீ வாழ்க! பாசறையிலே 'இன்று பூக்கோள் நாள்' என்று முழங்கும் வளைந்த வாயைக் கொண்ட தண்ணுமையை முழக்கும் இழிசினனின் குரலைக் கேட்பாயாக!","explanation":"This poem is from the Puṟanāṉūṟu collection, composed by Kaḻāttalaiyār. The tiṇai and tuṟai of this poem are not recorded in the colophons. The poet addresses a bard in an army camp, describing the dual glory of the warriors of ancient lineages. First, the poet compares the king to a discerning farmer: just as a farmer selects the finest bulls individually from a large herd during the ploughing season, the king selects outstanding heroes from ancient, noble families to honor them with golden bowls of toddy. Second, the poet points out that their glory is not just in receiving rewards, but in their immediate readiness for battle. This is highlighted by the sound of the drummer's drum announcing the 'pūkkōḷ' (the ceremony of wearing battle-flowers), signaling that today they must march to the battlefield.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.4],[0.4,0.7],[0.7,0.7],[0.7,1.6],[1.6,1.8],[1.8,2.0],[2.0,2.4],[2.4,2.85],[2.85,3.9],[4.15,4.28],[4.28,4.4],[4.4,5.0],[5.0,5.0],[5.0,5.0],[5.0,6.4],[6.4,6.5],[6.65,7.7],[7.7,7.72],[7.72,7.72],[7.72,7.8],[7.8,8.64],[9.06,9.9],[9.9,10.1],[10.1,10.3],[10.3,11.5],[11.5,11.7],[11.7,12.0],[12.0,12.8],[12.8,12.9],[12.9,13.9],[14.05,14.2],[14.2,14.5],[14.5,15.08],[15.08,15.5],[16.28,16.88],[16.88,17.24],[17.38,17.67],[17.67,18.13],[18.22,18.49],[18.58,18.98],[18.98,19.38],[19.52,20.38],[20.38,20.98],[20.98,20.98],[20.98,21.68]],"female":[[0.0,0.5],[0.5,0.7],[0.7,0.8],[1.01,1.23],[1.44,2.3],[2.3,3.0],[3.0,3.0],[3.0,3.0],[3.0,3.0],[3.0,3.0],[3.0,3.0],[3.0,6.0],[6.0,6.7],[6.7,7.4],[7.4,7.5],[7.5,8.0],[8.0,9.15],[9.15,9.15],[9.15,10.3],[10.3,10.9],[10.9,11.38],[11.38,11.62],[11.62,12.1],[12.1,12.7],[12.7,13.7],[13.7,14.0],[14.0,14.4],[14.4,15.3],[15.3,15.5],[15.5,16.7],[16.95,17.2],[17.2,17.5],[17.5,18.2],[18.2,18.7],[19.52,20.12],[20.12,20.65],[20.72,21.41],[21.41,21.92],[21.92,22.32],[22.32,22.62],[22.62,22.88],[22.88,22.92],[22.92,24.72],[24.72,25.12],[25.12,25.92]]},"sync":[[["திணை","genre"]],[["துறை","theme"]],[["தெரிந்தில","are not known"]],[["ஈரச்","wet"]],[["செவ்வி","season"]],[["உதவின","yielded"]],[["ஆயினும்","although"]],[["பல்எருத்","many bulls"]],[["துள்ளும்","among"]],[["நல்","good"]],[["எருது","bull"]],[["நோக்கி","looking at"]],[["வீறுவீறு","individually"]],[["ஆயும்","selecting"]],[["உழவன்","farmer"]],[["போலப்","like"]],[["பீடுபெறு","proud"]],[["தொல்குடிப்","ancient lineage"]],[["பாடுபல","many glories"]],[["தங்கிய","abiding"]],[["மூதி","ancient"]],[["லாளர்","men"]],[["உள்ளும்","among"]],[["காதலின்","with love"]],[["தனக்கு","for himself"]],[["முகந்து","scooping up"]],[["ஏந்திய","holding up"]],[["பசும்பொன்","pure gold"]],[["மண்டை","bowl"]],[["இவற்கு","to this man"]],[["ஈக","give"]],[["என்னும்","saying"]],[["அதுவும்அன்","not only that"]],[["றிசினே","indeed"]],[["கேட்டியோ","listen!"]],[["வாழிபாண","may you live long, oh bard!"]],[["பாசறைப்","army camp"]],[["பூக்கோள்","taking the battle-flower"]],[["இன்று","today"]],[["என்று","saying"]],[["அறையும்","announcing"]],[["மடிவாய்த்","folded-mouthed"]],[["தண்ணுமை","drum"]],[["இழிசினன்","drummer's"]],[["குரலே","sound indeed"]]]}