{"text":"purananuru","n":147,"lines":["கல்முழை அருவிப் பன்மலை நீந்திச்","சீறியாழ் செவ்வழி பண்ணி வந்ததைக்","கார்வான் இன்னுறை தமியள் கேளா","நெருநல் ஒருசிறைப் புலம்புகொண்டு உறையும்","அரிமதர் மழைக்கண் அம்மா அரிவை","நெய்யடு துறந்த மையிருங் கூந்தல்","மண்ணூறு மணியின் மாசுஅற மண்ணிப்","புதுமலர் கஞல இன்று பெயரின்","அதுமன் எம் பரிசில் ஆவியர் கோவே"],"tr":["kalmuḻai aruvip paṉmalai nīntic","cīṟiyāḻ cevvaḻi paṇṇi vantataik","kārvāṉ iṉṉuṟai tamiyaḷ kēḷā","nerunal oruciṟaip pulampukoṇṭu uṟaiyum","arimatar maḻaikkaṇ ammā arivai","neyyaṭu tuṟanta maiyiruṅ kūntal","maṇṇūṟu maṇiyiṉ mācuaṟa maṇṇip","putumalar kañala iṉṟu peyariṉ","atumaṉ em paricil āviyar kōvē"],"colophon":{"tinai":"peruntiṇai","tinai_ta":"பெருந்திணை","turai_ta":"குறுங்கலி","poet_ta":"பெருங்குன்றூர் கிழார்","addressed_ta":"வையாவிக் கோப்பெரும் பேகன்","poet_tr":"Peruṅkuṉṟūr Kiḻār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"9×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 36"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 19, veṇṭaḷai 16"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கல்முழை","tr":"kalmuḻai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கல்","tr":"kal"},{"kind":"nirai","text":"முழை","tr":"muḻai"}]},{"text":"யருவிப்","tr":"yaruvip","foot":"puḷimā","acai":[{"kind":"nirai","text":"யரு","tr":"yaru"},{"kind":"nēr","text":"விப்","tr":"vip"}]},{"text":"பன்மலை","tr":"paṉmalai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பன்","tr":"paṉ"},{"kind":"nirai","text":"மலை","tr":"malai"}]},{"text":"நீந்திச்","tr":"nīntic","foot":"tēmā","acai":[{"kind":"nēr","text":"நீந்","tr":"nīn"},{"kind":"nēr","text":"திச்","tr":"tic"}]}],[{"text":"சீறியாழ்","tr":"cīṟiyāḻ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சீ","tr":"cī"},{"kind":"nirai","text":"றியாழ்","tr":"ṟiyāḻ"}]},{"text":"செவ்வழி","tr":"cevvaḻi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"செவ்","tr":"cev"},{"kind":"nirai","text":"வழி","tr":"vaḻi"}]},{"text":"பண்ணி","tr":"paṇṇi","foot":"tēmā","acai":[{"kind":"nēr","text":"பண்","tr":"paṇ"},{"kind":"nēr","text":"ணி","tr":"ṇi"}]},{"text":"வந்ததைக்","tr":"vantataik","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வந்","tr":"van"},{"kind":"nirai","text":"ததைக்","tr":"tataik"}]}],[{"text":"கார்வா","tr":"kārvā","foot":"tēmā","acai":[{"kind":"nēr","text":"கார்","tr":"kār"},{"kind":"nēr","text":"வா","tr":"vā"}]},{"text":"னின்னுறை","tr":"ṉiṉṉuṟai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"னின்","tr":"ṉiṉ"},{"kind":"nirai","text":"னுறை","tr":"ṉuṟai"}]},{"text":"தமியள்","tr":"tamiyaḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"தமி","tr":"tami"},{"kind":"nēr","text":"யள்","tr":"yaḷ"}]},{"text":"கேளா","tr":"kēḷā","foot":"tēmā","acai":[{"kind":"nēr","text":"கே","tr":"kē"},{"kind":"nēr","text":"ளா","tr":"ḷā"}]}],[{"text":"நெருந","tr":"neruna","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெரு","tr":"neru"},{"kind":"nēr","text":"ந","tr":"na"}]},{"text":"லொருசிறைப்","tr":"loruciṟaip","foot":"karuviḷam","acai":[{"kind":"nirai","text":"லொரு","tr":"loru"},{"kind":"nirai","text":"சிறைப்","tr":"ciṟaip"}]},{"text":"புலம்புகொண்","tr":"pulampukoṇ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"புலம்","tr":"pulam"},{"kind":"nirai","text":"புகொண்","tr":"pukoṇ"}]},{"text":"டுறையு","tr":"ṭuṟaiyu","foot":"puḷimā","acai":[{"kind":"nirai","text":"டுறை","tr":"ṭuṟai"},{"kind":"nēr","text":"யு","tr":"yu"}]}],[{"text":"மரிமதர்","tr":"marimatar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மரி","tr":"mari"},{"kind":"nirai","text":"மதர்","tr":"matar"}]},{"text":"மழைக்க","tr":"maḻaikka","foot":"puḷimā","acai":[{"kind":"nirai","text":"மழைக்","tr":"maḻaik"},{"kind":"nēr","text":"க","tr":"ka"}]},{"text":"ணம்மா","tr":"ṇammā","foot":"tēmā","acai":[{"kind":"nēr","text":"ணம்","tr":"ṇam"},{"kind":"nēr","text":"மா","tr":"mā"}]},{"text":"வரிவை","tr":"varivai","foot":"puḷimā","acai":[{"kind":"nirai","text":"வரி","tr":"vari"},{"kind":"nēr","te