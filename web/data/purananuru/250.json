{"text":"purananuru","n":250,"lines":["குய்குரல் மலிந்த கொழுந்துவை அடிசில்","இரவலர்த் தடுத்த வாயிற் புரவலர்","கண்ணீர்த் தடுத்த தண்ணறும் பந்தர்க்","கூந்தல் கொய்து குறுந்தொடு நீக்கி","அல்லி உணவின் மனைவியடு இனியே","புல்என் றனையால் வளங்கெழு திருநகர்","வான் சோறு கொண்டு தீம்பால் வேண்டும்","முனித்தலைப் புதல்வர் தந்தை","தனித்தலைப் பெருங்காடு முன்னிய பின்னே"],"tr":["kuykural malinta koḻuntuvai aṭicil","iravalart taṭutta vāyiṟ puravalar","kaṇṇīrt taṭutta taṇṇaṟum pantark","kūntal koytu kuṟuntoṭu nīkki","alli uṇaviṉ maṉaiviyaṭu iṉiyē","puleṉ ṟaṉaiyāl vaḷaṅkeḻu tirunakar","vāṉ cōṟu koṇṭu tīmpāl vēṇṭum","muṉittalaip putalvar tantai","taṉittalaip peruṅkāṭu muṉṉiya piṉṉē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"தாபதநிலை","poet_ta":"தாயங் கண்ணியார்","poet_tr":"Tāyaṅ Kaṇṇiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"9×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 36"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 18, āciriyattaḷai 17"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"குய்குரல்","tr":"kuykural","foot":"kūviḷam","acai":[{"kind":"nēr","text":"குய்","tr":"kuy"},{"kind":"nirai","text":"குரல்","tr":"kural"}]},{"text":"மலிந்த","tr":"malinta","foot":"puḷimā","acai":[{"kind":"nirai","text":"மலிந்","tr":"malin"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"கொழுந்துவை","tr":"koḻuntuvai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கொழுந்","tr":"koḻun"},{"kind":"nirai","text":"துவை","tr":"tuvai"}]},{"text":"யடிசி","tr":"yaṭici","foot":"puḷimā","acai":[{"kind":"nirai","text":"யடி","tr":"yaṭi"},{"kind":"nēr","text":"சி","tr":"ci"}]}],[{"text":"லிரவலர்த்","tr":"liravalart","foot":"karuviḷam","acai":[{"kind":"nirai","text":"லிர","tr":"lira"},{"kind":"nirai","text":"வலர்த்","tr":"valart"}]},{"text":"தடுத்த","tr":"taṭutta","foot":"puḷimā","acai":[{"kind":"nirai","text":"தடுத்","tr":"taṭut"},{