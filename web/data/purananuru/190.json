{"text":"purananuru","n":190,"lines":["விளைபதச் சீறிடம் நோக்கி வளைகதிர்","வல்சி கொண்டு அளை மல்க வைக்கும்","எலிமுயன் றனைய ராகி உள்ளதம்","வளன்வலி உறுக்கும் உளம் இலாளரோடு","இயைந்த கேண்மை இல்லா கியரோ","கடுங்கண் கேழல் இடம்பட வீழ்ந்தென","அன்று அவண் உண்ணா தாகி வழிநாள்","பெருமலை விடரகம் புலம்ப வேட்டெழுந்து","இருங்களிற்று ஒருத்தல் நல்வலம் படுக்கும்","புலிபசித் தன்ன மெலிவில் உள்ளத்து","உரனுடை யாளர் கேண்மையடு","இயைந்த வைகல் உளவா கியரோ"],"tr":["viḷaipatac cīṟiṭam nōkki vaḷaikatir","valci koṇṭu aḷai malka vaikkum","elimuyaṉ ṟaṉaiya rāki uḷḷatam","vaḷaṉvali uṟukkum uḷam ilāḷarōṭu","iyainta kēṇmai illā kiyarō","kaṭuṅkaṇ kēḻal iṭampaṭa vīḻnteṉa","aṉṟu avaṇ uṇṇā tāki vaḻināḷ","perumalai viṭarakam pulampa vēṭṭeḻuntu","iruṅkaḷiṟṟu oruttal nalvalam paṭukkum","pulipacit taṉṉa melivil uḷḷattu","uraṉuṭai yāḷar kēṇmaiyaṭu","iyainta vaikal uḷavā kiyarō"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"பொருண்மொழிக் காஞ்சி","poet_ta":"சோழன் நல்லுருத்திரன்","poet_tr":"Cōḻaṉ Nalluruttiraṉ"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"12 lines"},{"name":"feet per line","ok":true,"detail":"12×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 48"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 25, veṇṭaḷai 22"},{"name":"ending","ok":true,"detail":"ends on ஓ"}],"ending":"ஓ","lines":[[{"text":"விளைபதச்","tr":"viḷaipatac","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விளை","tr":"viḷai"},{"kind":"nirai","text":"பதச்","tr":"patac"}]},{"text":"சீறிடம்","tr":"cīṟiṭam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சீ","tr":"cī"},{"kind":"nirai","text":"றிடம்","tr":"ṟiṭam"}]},{"text":"நோக்கி","tr":"nōkki","foot":"tēmā","acai":[{"kind":"nēr","text":"நோக்","tr":"nōk"},{"kind":"nēr","text":"கி","tr":"ki"}]},{"text":"வளைகதிர்","tr":"vaḷaikatir","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வளை","tr":"vaḷai"},{"kind":"nirai","text":"கதிர்","tr":"katir"}]}],[{"text":"வல்சி","tr":"valci","foot":"tēmā","acai":[{"kind":