{"text":"purananuru","n":65,"lines":["மண்முழா மறப்பப் பண் யாழ் மறப்ப","இருங்கண் குழிசி கவிழ்ந்து இழுது பறப்பச்","சுரும்பூஆர் தேறல் சுற்றம் மறப்ப","உழவர் ஓதை மறப்ப விழவும்","அகலுள் ஆங்கண் சீறூர் மறப்ப","உவவுத் தலைவந்த பெருநாள் அமையத்து","இருசுடர் தம்முள் நோக்கி ஒரு சுடர்","புன்கண் மாலை மலைமறைந் தாங்குத்","தன்போல் வேந்தன் முன்பு குறித்து எறிந்த","புறப்புண் நாணி மறத்தகை மன்னன்","வாள் வடக்கு இருந்தனன் ஈங்கு","நாள்போல் கழியல ஞாயிற்றுப் பகலே"],"tr":["maṇmuḻā maṟappap paṇ yāḻ maṟappa","iruṅkaṇ kuḻici kaviḻntu iḻutu paṟappac","curumpūār tēṟal cuṟṟam maṟappa","uḻavar ōtai maṟappa viḻavum","akaluḷ āṅkaṇ cīṟūr maṟappa","uvavut talaivanta perunāḷ amaiyattu","irucuṭar tammuḷ nōkki oru cuṭar","puṉkaṇ mālai malaimaṟain tāṅkut","taṉpōl vēntaṉ muṉpu kuṟittu eṟinta","puṟappuṇ nāṇi maṟattakai maṉṉaṉ","vāḷ vaṭakku iruntaṉaṉ īṅku","nāḷpōl kaḻiyala ñāyiṟṟup pakalē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"கையறுநிலை","poet_ta":"கழாஅத் தலையார்","addressed_ta":"சேரமான் பெருஞ்சேரலாதன்; இவன் கரிகாற் பெருவளத்தானோடு பொருது","poet_tr":"Kaḻāat Talaiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"12 lines"},{"name":"feet per line","ok":true,"detail":"12×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 44, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 27, āciriyattaḷai 17, kalittaḷai 3"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மண்முழா","tr":"maṇmuḻā","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மண்","tr":"maṇ"},{"kind":"nirai","text":"முழா","tr":"muḻā"}]},{"text":"மறப்பப்","tr":"maṟappap","foot":"puḷimā","acai":[{"kind":"nirai","text":"மறப்","tr":"maṟap"},{"kind":"nēr","text":"பப்","tr":"pap"}]},{"text":"பண்யாழ்","tr":"paṇyāḻ","foot":"tēmā","acai":[{"kind":"nēr","text":"பண்","tr":"paṇ"},{"kind":"nēr","text":"யாழ்","tr":"yāḻ"}]},{"text":"மறப்ப","tr":"maṟappa","foot":"puḷimā","acai":[{"kind":"nirai","text":"மறப்","tr":"maṟap"},{"kind":"nēr","text":"ப","tr