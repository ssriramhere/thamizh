{"text":"purananuru","n":134,"lines":["இம்மைச் செய்தது மறுமைக்கு ஆம் எனும்","அறவிலை வணிகன் ஆ அய் அல்லன்","பிறரும் சான்றோர் சென்ற நெறியென","ஆங்குப் பட்டன்று அவன் கைவண் மையே"],"tr":["immaic ceytatu maṟumaikku ām eṉum","aṟavilai vaṇikaṉ ā ay allaṉ","piṟarum cāṉṟōr ceṉṟa neṟiyeṉa","āṅkup paṭṭaṉṟu avaṉ kaivaṇ maiyē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"இயன் மொழி","poet_ta":"உறையூர் ஏணிச்சேரி முடமோசியார்","addressed_ta":"ஆய் அண்டிரன்","poet_tr":"Uṟaiyūr Ēṇiccēri Muṭamōciyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"4×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 15, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 5"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இம்மைச்","tr":"immaic","foot":"tēmā","acai":[{"kind":"nēr","text":"இம்","tr":"im"},{"kind":"nēr","text":"மைச்","tr":"maic"}]},{"text":"செய்தது","tr":"ceytatu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"செய்","tr":"cey"},{"kind":"nirai","text":"தது","tr":"tatu"}]},{"text":"மறுமைக்","tr":"maṟumaik","foot":"puḷimā","acai":[{"kind":"nirai","text":"மறு","tr":"maṟu"},{"kind":"nēr","text":"மைக்","tr":"maik"}]},{"text":"காமெனு","tr":"kāmeṉu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"மெனு","tr":"meṉu"}]}],[{"text":"மறவிலை","tr":"maṟavilai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மற","tr":"maṟa"},{"kind":"nirai","text":"விலை","tr":"vilai"}]},{"text":"வணிக","tr":"vaṇika","foot":"puḷimā","acai":[{"kind":"nirai","text":"வணி","tr":"vaṇi"},{"kind":"nēr","text":"க","tr":"ka"}]},{"text":"னாவய்","tr":"ṉāvay","foot":"tēmā","acai":[{"kind":"nēr","text":"னா","tr":"ṉā"},{"kind":"nēr","text":"வய்","tr":"vay"}]},{"text":"யல்லன்","tr":"yallaṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"யல்","tr":"yal"},{"kind":"nēr","text":"லன்","tr":"laṉ"}]}],[{"text":"பிறரும்","tr":"piṟ