{"text":"purananuru","n":113,"lines":["மட்டு வாய் திறப்பவும் மை விடை வீழ்ப்பவும்","அட்டு ஆன்று ஆனாக் கொழுந் துவை ஊன் சோறும்","பெட்டாங்கு ஈயும் பெருவளம் பழுனி","நட்டனை மன்னோ முன்னே இனியே","பாரி மாய்ந்தெனக் கலங்கிக் கையற்று","நீர் வார் கண்ணேம் தொழுது நிற் பழிச்சிச்","சேறும் வாழியோ பெரும்பெயர்ப் பறம்பே","கோல் திரள் முன்கைக் குறுந் தொடி மகளிர்","நாறு இருங் கூந்தற் கிழவரைப் படர்ந்தே"],"tr":["maṭṭu vāy tiṟappavum mai viṭai vīḻppavum","aṭṭu āṉṟu āṉāk koḻun tuvai ūṉ cōṟum","peṭṭāṅku īyum peruvaḷam paḻuṉi","naṭṭaṉai maṉṉō muṉṉē iṉiyē","pāri māynteṉak kalaṅkik kaiyaṟṟu","nīr vār kaṇṇēm toḻutu niṟ paḻiccic","cēṟum vāḻiyō perumpeyarp paṟampē","kōl tiraḷ muṉkaik kuṟun toṭi makaḷir","nāṟu iruṅ kūntaṟ kiḻavaraip paṭarntē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"கையறுநிலை","poet_ta":"கபிலர்","poet_tr":"Kapilar"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"9×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 34, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 20, veṇṭaḷai 15"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மட்டுவாய்","tr":"maṭṭuvāy","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மட்","tr":"maṭ"},{"kind":"nirai","text":"டுவாய்","tr":"ṭuvāy"}]},{"text":"திறப்பவும்","tr":"tiṟappavum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"திறப்","tr":"tiṟap"},{"kind":"nirai","text":"பவும்","tr":"pavum"}]},{"text":"மைவிடை","tr":"maiviṭai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மை","tr":"mai"},{"kind":"nirai","text":"விடை","tr":"viṭai"}]},{"text":"வீழ்ப்பவு","tr":"vīḻppavu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வீழ்ப்","tr":"vīḻp"},{"kind":"nirai","text":"பவு","tr":"pavu"}]}],[{"text":"மட்டான்","tr":"maṭṭāṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"மட்","tr":"maṭ"},{"kind":"nēr","text":"டான்","tr":"ṭāṉ"}]},{"text":"றானாக்","tr":"ṟāṉāk","foot":"tēmā","acai":[{"kind":"