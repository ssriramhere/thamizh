உம்","lemma":"um","gloss":"and"}],"gloss":"and rice"}]},{"words":[{"surface":"பெட்டாங்கு","parts":[{"text":"பெட்டு","lemma":"peṭṭu","gloss":"desire"},{"text":"ஆங்கு","lemma":"āṅku","gloss":"manner"}],"gloss":"as desired"},{"surface":"ஈயும்","parts":[{"text":"ஈ","lemma":"ī","gloss":"give"},{"text":"உம்","lemma":"um","gloss":"adjectival participle suffix"}],"gloss":"giving"},{"surface":"பெருவளம்","parts":[{"text":"பெருமை","lemma":"perumai","gloss":"greatness"},{"text":"வளம்","lemma":"vaḷam","gloss":"wealth"}],"gloss":"great wealth"},{"surface":"பழுனி","parts":[{"text":"பழுனி","lemma":"பழுனி","gloss":"having ripened"}],"gloss":"having ripened","split_unverified":true}]},{"words":[{"surface":"நட்டனை","parts":[{"text":"நள்","lemma":"naḷ","gloss":"befriend"},{"text":"த்","lemma":"t","gloss":"past tense"},{"text":"அனை","lemma":"aṉai","gloss":"second person singular suffix"}],"gloss":"you befriended"},{"surface":"மன்னோ","parts":[{"text":"மன்","lemma":"maṉ","gloss":"indeed"},{"text":"ஓ","lemma":"ō","gloss":"particle of regret"}],"gloss":"indeed (alas)"},{"surface":"முன்னே","parts":[{"text":"முன்","lemma":"muṉ","gloss":"before"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"formerly"},{"surface":"இனியே","parts":[{"text":"இனி","lemma":"iṉi","gloss":"now"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"now"}]},{"words":[{"surface":"பாரி","parts":[{"text":"பாரி","lemma":"pāri","gloss":"Pari"}],"gloss":"Pari"},{"surface":"மாய்ந்தென","parts":[{"text":"மாய்ந்தென","lemma":"மாய்ந்தென","gloss":"because [he] died"}],"gloss":"because [he] died","split_unverified":true},{"surface":"கலங்கி","parts":[{"text":"கலங்கு","lemma":"kalaṅku","gloss":"be distressed"},{"text":"இ","lemma":"i","gloss":"past participle suffix"}],"gloss":"having grieved"},{"surface":"கையற்று","parts":[{"text":"கை","lemma":"kai","gloss":"hand/means"},{"text":"அற்று","lemma":"aṟu","gloss":"having lost"}],"gloss":"having become helpless"}]},{"words":[{"surface":"நீர்","parts":[{"text":"நீர்","lemma":"nīr","gloss":"water"}],"gloss":"tears"},{"surface":"வார்","parts":[{"text":"வார்","lemma":"vār","gloss":"flow"}],"gloss":"flowing"},{"surface":"கண்ணேம்","parts":[{"text":"கண்","lemma":"kaṇ","gloss":"eye"},{"text":"ஏம்","lemma":"ēm","gloss":"pronominal suffix (we)"}],"gloss":"we with eyes"},{"surface":"தொழுது","parts":[{"text":"தொழு","lemma":"toḻu","gloss":"worship"},{"text":"து","lemma":"tu","gloss":"past participle suffix"}],"gloss":"having worshipped"},{"surface":"நின்","parts":[{"text":"நின்","lemma":"நின்","gloss":"you"}],"gloss":"you","split_unverified":true},{"surface":"பழிச்சி","parts":[{"text":"பழிச்சு","lemma":"paḻiccu","gloss":"praise"},{"text":"இ","lemma":"i","gloss":"past participle suffix"}],"gloss":"having praised"}]},{"words":[{"surface":"சேறும்","parts":[{"text":"சேறும்","lemma":"சேறும்","gloss":"we will go"}],"gloss":"we will go","split_unverified":true},{"surface":"வாழியோ","parts":[{"text":"வாழியோ","lemma":"வாழியோ","gloss":"may you live long"}],"gloss":"may you live long","split_unverified":true},{"surface":"பெரும்பெயர்","parts":[{"text":"பெருமை","lemma":"perumai","gloss":"greatness"},{"text":"பெயர்","lemma":"peyar","gloss":"name/fame"}],"gloss":"of great fame"},{"surface":"பறம்பே","parts":[{"text":"பறம்பு","lemma":"paṟampu","gloss":"Parampu hill"},{"text":"ஏ","lemma":"ē","gloss":"vocative"}],"gloss":"O Parampu hill!"}]},{"words":[{"surface":"கோல்","parts":[{"text":"கோல்","lemma":"kōl","gloss":"staff"}],"gloss":"round/well-shaped"},{"surface":"திரள்","parts":[{"text":"திரள்","lemma":"tiraḷ","gloss":"round"}],"gloss":"rounded"},{"surface":"முன்கை","parts":[{"text":"முன்","lemma":"muṉ","gloss":"front"},{"text":"கை","lemma":"kai","gloss":"hand/arm"}],"gloss":"forearm"},{"surface":"குறும்","parts":[{"text":"குறும்","lemma":"குறும்","gloss":"small"}],"gloss":"small","split_unverified":true},{"surface":"தொடி","parts":[{"text":"தொடி","lemma":"toṭi","gloss":"bangle"}],"gloss":"bangles"},{"surface":"மகளிர்","parts":[{"text":"மகளிர்","lemma":"makaḷir","gloss":"women"}],"gloss":"daughters/women"}]},{"words":[{"surface":"நாறு","parts":[{"text":"நாறு","lemma":"nāṟu","gloss":"fragrance"}],"gloss":"fragrant"},{"surface":"இரும்","parts":[{"text":"இரும்","lemma":"irum","gloss":"dark/black"}],"gloss":"dark/black"},{"surface":"கூந்தல்","parts":[{"text":"கூந்தல்","lemma":"kūntal","gloss":"hair"}],"gloss":"hair"},{"surface":"கிழவரை","parts":[{"text":"கிழவர்","lemma":"kiḻavar","gloss":"lords/owners"},{"text":"ஐ","lemma":"ai","gloss":"accusative suffix"}],"gloss":"husbands/lords"},{"surface":"படர்ந்தே","parts":[{"text":"படர்","lemma":"paṭar","gloss":"think of/go towards"},{"text":"ந்த்","lemma":"t","gloss":"past tense"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"seeking/thinking of"}]}],"literal":"When jars of toddy were opened and black rams were slaughtered, / and cooked, abundant, ceaseless rich sauce and meat rice / was given as desired, ripening great wealth, / you befriended us indeed in the past! But now, / because Pari has died, we are distressed and helpless, / with eyes shedding tears, worshipping and praising you, / we depart, may you live long, O Parampu of great fame! / The daughters with small bangles on their round, plump forearms, / seeking husbands for their fragrant, dark hair.","translation":"In the past, you befriended us indeed, when jars of toddy were opened, black rams were slaughtered, and rich meat rice with endless thick sauce was cooked and given as much as we desired, in your mature, great prosperity. But now, since Pari has died, we are distressed and helpless. With eyes streaming with tears, we worship and praise you, and we depart. May you live long, O Parampu of great fame! We go seeking husbands for these daughters with small bangles on their round, plump forearms and fragrant, dark hair.","modern":"மதுக்குடங்கள் திறக்கப்பட்டு, கரிய கடாக்கள் வெட்டப்பட்டு, சமைக்கப்பட்டதும் அளவில்லாததுமான கொழுத்த இறைச்சிச் சோறும் குழம்பும் விரும்பியவாறு வழங்கப்பட்ட பெருவளத்தோடு விளங்கிய பறம்பு மலையே! முன்பு நீ எங்களோடு நட்போடு இருந்தாய். ஆனால் இப்பொழுது, பாரி இறந்துவிட்டதால் நாங்கள் கலங்கி, செயலற்று, கண்ணீர் வடியும் கண்களோடு உன்னைத் தொழுது துதித்து விடைபெற்றுச் செல்கிறோம். பெரும் புகழையுடைய பறம்பே! நீ வாழ்க! திரண்ட முன்கைகளில் சிறிய வளையல்களை அணிந்த, நறுமணமிக்க கரிய கூந்தலையுடைய இப்பெண்களுக்கு ஏற்ற கணவர்களைத் தேடி நாங்கள் செல்கிறோம்.","explanation":"This poem is spoken by the poet Kapilar, expressing his deep grief (kaiyaṟunilai) after the death of his close friend and patron, King Pari. He addresses the Parampu hill, which was once a place of immense wealth and hospitality where guests were treated to endless toddy, meat, and rice. Now, with Pari gone, the hill is desolate, and Kapilar must leave it forever. He is taking Pari's unmarried daughters with him to find suitable husbands for them. The contrast between the past glory of Parampu and its current sorrowful state heightens the tragedy of Pari's demise.","model":"gemini-3.5-flash"}}