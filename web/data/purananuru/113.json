{"text":"purananuru","n":113,"lines":["மட்டு வாய் திறப்பவும் மை விடை வீழ்ப்பவும்","அட்டு ஆன்று ஆனாக் கொழுந் துவை ஊன் சோறும்","பெட்டாங்கு ஈயும் பெருவளம் பழுனி","நட்டனை மன்னோ முன்னே இனியே","பாரி மாய்ந்தெனக் கலங்கிக் கையற்று","நீர் வார் கண்ணேம் தொழுது நிற் பழிச்சிச்","சேறும் வாழியோ பெரும்பெயர்ப் பறம்பே","கோல் திரள் முன்கைக் குறுந் தொடி மகளிர்","நாறு இருங் கூந்தற் கிழவரைப் படர்ந்தே"],"tr":["maṭṭu vāy tiṟappavum mai viṭai vīḻppavum","aṭṭu āṉṟu āṉāk koḻun tuvai ūṉ cōṟum","peṭṭāṅku īyum peruvaḷam paḻuṉi","naṭṭaṉai maṉṉō muṉṉē iṉiyē","pāri māynteṉak kalaṅkik kaiyaṟṟu","nīr vār kaṇṇēm toḻutu niṟ paḻiccic","cēṟum vāḻiyō perumpeyarp paṟampē","kōl tiraḷ muṉkaik kuṟun toṭi makaḷir","nāṟu iruṅ kūntaṟ kiḻavaraip paṭarntē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"கையறுநிலை","poet_ta":"கபிலர்","poet_tr":"Kapilar"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"9×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 34, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 20, veṇṭaḷai 15"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மட்டுவாய்","tr":"maṭṭuvāy","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மட்","tr":"maṭ"},{"kind":"nirai","text":"டுவாய்","tr":"ṭuvāy"}]},{"text":"திறப்பவும்","tr":"tiṟappavum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"திறப்","tr":"tiṟap"},{"kind":"nirai","text":"பவும்","tr":"pavum"}]},{"text":"மைவிடை","tr":"maiviṭai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மை","tr":"mai"},{"kind":"nirai","text":"விடை","tr":"viṭai"}]},{"text":"வீழ்ப்பவு","tr":"vīḻppavu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வீழ்ப்","tr":"vīḻp"},{"kind":"nirai","text":"பவு","tr":"pavu"}]}],[{"text":"மட்டான்","tr":"maṭṭāṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"மட்","tr":"maṭ"},{"kind":"nēr","text":"டான்","tr":"ṭāṉ"}]},{"text":"றானாக்","tr":"ṟāṉāk","foot":"tēmā","acai":[{"kind":"nēr","text":"றா","tr":"ṟā"},{"kind":"nēr","text":"னாக்","tr":"ṉāk"}]},{"text":"கொழுந்துவை","tr":"koḻuntuvai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கொழுந்","tr":"koḻun"},{"kind":"nirai","text":"துவை","tr":"tuvai"}]},{"text":"யூன்சோறும்","tr":"yūṉcōṟum","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"யூன்","tr":"yūṉ"},{"kind":"nēr","text":"சோ","tr":"cō"},{"kind":"nēr","text":"றும்","tr":"ṟum"}]}],[{"text":"பெட்டாங்","tr":"peṭṭāṅ","foot":"tēmā","acai":[{"kind":"nēr","text":"பெட்","tr":"peṭ"},{"kind":"nēr","text":"டாங்","tr":"ṭāṅ"}]},{"text":"கீயும்","tr":"kīyum","foot":"tēmā","acai":[{"kind":"nēr","text":"கீ","tr":"kī"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"பெருவளம்","tr":"peruvaḷam","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெரு","tr":"peru"},{"kind":"nirai","text":"வளம்","tr":"vaḷam"}]},{"text":"பழுனி","tr":"paḻuṉi","foot":"puḷimā","acai":[{"kind":"nirai","text":"பழு","tr":"paḻu"},{"kind":"nēr","text":"னி","tr":"ṉi"}]}],[{"text":"நட்டனை","tr":"naṭṭaṉai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நட்","tr":"naṭ"},{"kind":"nirai","text":"டனை","tr":"ṭaṉai"}]},{"text":"மன்னோ","tr":"maṉṉō","foot":"tēmā","acai":[{"kind":"nēr","text":"மன்","tr":"maṉ"},{"kind":"nēr","text":"னோ","tr":"ṉō"}]},{"text":"முன்னே","tr":"muṉṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"முன்","tr":"muṉ"},{"kind":"nēr","text":"னே","tr":"ṉē"}]},{"text":"யினியே","tr":"yiṉiyē","foot":"puḷimā","acai":[{"kind":"nirai","text":"யினி","tr":"yiṉi"},{"kind":"nēr","text":"யே","tr":"yē"}]}],[{"text":"பாரி","tr":"pāri","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"ரி","tr":"ri"}]},{"text":"மாய்ந்தெனக்","tr":"māynteṉak","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மாய்ந்","tr":"māyn"},{"kind":"nirai","text":"தெனக்","tr":"teṉak"}]},{"text":"கலங்கிக்","tr":"kalaṅkik","foot":"puḷimā","acai":[{"kind":"nirai","text":"கலங்","tr":"kalaṅ"},{"kind":"nēr","text":"கிக்","tr":"kik"}]},{"text":"கையற்று","tr":"kaiyaṟṟu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"கை","tr":"kai"},{"kind":"nēr","text":"யற்","tr":"yaṟ"},{"kind":"nēr","text":"று","tr":"ṟu"}]}],[{"text":"நீர்வார்","tr":"nīrvār","foot":"tēmā","acai":[{"kind":"nēr","text":"நீர்","tr":"nīr"},{"kind":"nēr","text":"வார்","tr":"vār"}]},{"text":"கண்ணேம்","tr":"kaṇṇēm","foot":"tēmā","acai":[{"kind":"nēr","text":"கண்","tr":"kaṇ"},{"kind":"nēr","text":"ணேம்","tr":"ṇēm"}]},{"text":"தொழுதுநிற்","tr":"toḻutuniṟ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தொழு","tr":"toḻu"},{"kind":"nirai","text":"துநிற்","tr":"tuniṟ"}]},{"text":"பழிச்சிச்","tr":"paḻiccic","foot":"puḷimā","acai":[{"kind":"nirai","text":"பழிச்","tr":"paḻic"},{"kind":"nēr","text":"சிச்","tr":"cic"}]}],[{"text":"சேறும்","tr":"cēṟum","foot":"tēmā","acai":[{"kind":"nēr","text":"சே","tr":"cē"},{"kind":"nēr","text":"றும்","tr":"ṟum"}]},{"text":"வாழியோ","tr":"vāḻiyō","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nirai","text":"ழியோ","tr":"ḻiyō"}]},{"text":"பெரும்பெயர்ப்","tr":"perumpeyarp","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெரும்","tr":"perum"},{"kind":"nirai","text":"பெயர்ப்","tr":"peyarp"}]},{"text":"பறம்பே","tr":"paṟampē","foot":"puḷimā","acai":[{"kind":"nirai","text":"பறம்","tr":"paṟam"},{"kind":"nēr","text":"பே","tr":"pē"}]}],[{"text":"கோல்திரள்","tr":"kōltiraḷ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கோல்","tr":"kōl"},{"kind":"nirai","text":"திரள்","tr":"tiraḷ"}]},{"text":"முன்கைக்","tr":"muṉkaik","foot":"tēmā","acai":[{"kind":"nēr","text":"முன்","tr":"muṉ"},{"kind":"nēr","text":"கைக்","tr":"kaik"}]},{"text":"குறுந்தொடி","tr":"kuṟuntoṭi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குறுந்","tr":"kuṟun"},{"kind":"nirai","text":"தொடி","tr":"toṭi"}]},{"text":"மகளிர்","tr":"makaḷir","foot":"puḷimā","acai":[{"kind":"nirai","text":"மக","tr":"maka"},{"kind":"nēr","text":"ளிர்","tr":"ḷir"}]}],[{"text":"நாறிருங்","tr":"nāṟiruṅ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nirai","text":"றிருங்","tr":"ṟiruṅ"}]},{"text"