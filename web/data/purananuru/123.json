{"text":"purananuru","n":123,"lines":["நாட் கள் உண்டு நாள்மகிழ் மகிழின்","யார்க்கும் எளிதே தேர் ஈதல்லே","தொலையா நல்லிசை விளங்கு மலயன்","மகிழாது ஈத்த இழையணி நெடுந்தேர்","பயன்கிழு முள்ளூர் மீமிசைப்","பட்ட மாரி உறையினும் பலவே"],"tr":["nāṭ kaḷ uṇṭu nāḷmakiḻ makiḻiṉ","yārkkum eḷitē tēr ītallē","tolaiyā nallicai viḷaṅku malayaṉ","makiḻātu ītta iḻaiyaṇi neṭuntēr","payaṉkiḻu muḷḷūr mīmicaip","paṭṭa māri uṟaiyiṉum palavē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"இயன் மொழி","poet_ta":"கபிலர்","addressed_ta":"மலையமான் திருமுடிக்காரி","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 9"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நாட்கள்","tr":"nāṭkaḷ","foot":"tēmā","acai":[{"kind":"nēr","text":"நாட்","tr":"nāṭ"},{"kind":"nēr","text":"கள்","tr":"kaḷ"}]},{"text":"ளுண்டு","tr":"ḷuṇṭu","foot":"tēmā","acai":[{"kind":"nēr","text":"ளுண்","tr":"ḷuṇ"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"நாள்மகிழ்","tr":"nāḷmakiḻ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நாள்","tr":"nāḷ"},{"kind":"nirai","text":"மகிழ்","tr":"makiḻ"}]},{"text":"மகிழின்","tr":"makiḻiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மகி","tr":"maki"},{"kind":"nēr","text":"ழின்","tr":"ḻiṉ"}]}],[{"text":"யார்க்கு","tr":"yārkku","foot":"tēmā","acai":[{"kind":"nēr","text":"யார்க்","tr":"yārk"},{"kind":"nēr","text":"கு","tr":"ku"}]},{"text":"மெளிதே","tr":"meḷitē","foot":"puḷimā","acai":[{"kind":"nirai","text":"மெளி","tr":"meḷi"},{"kind":"nēr","text":"தே","tr":"tē"}]},{"text":"தேரீ","tr":"tērī","foot":"tēmā","acai":[{"kind":"nēr","text":"தே","tr":"tē"},{"kind":"nēr","text":"ரீ","tr":"rī"}]},{"text":"தல்லே","tr":"tallē","foot":"tēmā","acai":[{"kind":"nēr","text":"தல்","tr":"tal"},{"kind":"nēr","text":"லே"