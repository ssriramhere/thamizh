{"text":"purananuru","n":167,"lines":["நீயே அமர்காணின் அமர்கடந்து அவர்","படை விலக்கி எதிர் நிற்றலின்","வாஅள் வாய்த்த வடுவாழ் யாக்கை யடு","கேள்விக்கு இனியை கட்கின் னாயே","அவரே நிற்காணின் புறங் கொடுத்தலின்","ஊறுஅறியா மெய் யாக்கை யடு","கண்ணுக்கு இனியர் செவிக்குஇன் னாரே","அதனால் நீயும் ஒன்று இனியை அவரும்ஒன்றுஇனியர்","ஒவ்வா யாவுள மற்றே வெல்போர்க்","கழல்புனை திருந்தடிக் கடுமான் கிள்ளி","நின்னை வியக்குமிவ் வுலகம் அ·து","என்னோ பெரும உரைத்திசின் எமக்கே"],"tr":["nīyē amarkāṇiṉ amarkaṭantu avar","paṭai vilakki etir niṟṟaliṉ","vāaḷ vāytta vaṭuvāḻ yākkai yaṭu","kēḷvikku iṉiyai kaṭkiṉ ṉāyē","avarē niṟkāṇiṉ puṟaṅ koṭuttaliṉ","ūṟuaṟiyā mey yākkai yaṭu","kaṇṇukku iṉiyar cevikkuiṉ ṉārē","ataṉāl nīyum oṉṟu iṉiyai avarumoṉṟuiṉiyar","ovvā yāvuḷa maṟṟē velpōrk","kaḻalpuṉai tiruntaṭik kaṭumāṉ kiḷḷi","niṉṉai viyakkumiv vulakam atu","eṉṉō peruma uraitticiṉ emakkē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"அரச வாகை","poet_ta":"கோனாட்டு எறிச்சிலூர் மாடலன் மதுரைக் குமரனார்","addressed_ta":"சோழன் கடுமான் கிள்ளி","poet_tr":"Kōṉāṭṭu Eṟiccilūr Māṭalaṉ Maturaik Kumaraṉār"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"12 lines"},{"name":"feet per line","ok":true,"detail":"1×5, 9×4, 2×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 46, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 25, veṇṭaḷai 21"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"1 five-foot line (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"நீயே","tr":"nīyē","foot":"tēmā","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nēr","text":"யே","tr":"yē"}]},{"text":"யமர்கா","tr":"yamarkā","foot":"puḷimā","acai":[{"kind":"nirai","text":"யமர்","tr":"yamar"},{"kind":"nēr","text":"கா","tr":"kā"}]},{"text":"ணினமர்","tr":"ṇiṉamar","foot":"puḷimā","acai":[{"kind":"nirai","text":"ணின","tr":"ṇiṉa"},{"kind":"nēr","text":"மர்","tr":"mar"}]},{"text":"கடந்தவர்","tr":"kaṭantavar","foot":"karuviḷam","acai":[{"kind":"nirai","tex