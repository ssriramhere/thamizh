{"text":"purananuru","n":310,"lines":["பால்கொண்டு மடுப்பவும் உண்ணான் ஆகலின்","செறாஅது ஓச்சிய சிறுகோல் அஞ்சியடு","உயவொடு வருந்தும் மன்னே இனியே","புகர்நிறங் கொண்ட களிறட்டு ஆனான்","முன்நாள் வீழ்ந்த உரவோர் மகனே","உன்னிலன் என்னும் புண்ஒன்று அம்பு","மான்உளை அன்ன குடுமித்","தோல்மிசைக் கிடந்த புல்அண லோனே"],"tr":["pālkoṇṭu maṭuppavum uṇṇāṉ ākaliṉ","ceṟāatu ōcciya ciṟukōl añciyaṭu","uyavoṭu varuntum maṉṉē iṉiyē","pukarniṟaṅ koṇṭa kaḷiṟaṭṭu āṉāṉ","muṉnāḷ vīḻnta uravōr makaṉē","uṉṉilaṉ eṉṉum puṇoṉṟu ampu","māṉuḷai aṉṉa kuṭumit","tōlmicaik kiṭanta pulaṇa lōṉē"],"colophon":{"tinai":"tumpai","tinai_ta":"தும்பை","turai_ta":"நூழிலாட்டு","poet_ta":"பொன்முடியார்","poet_tr":"Poṉmuṭiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 11, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பால்கொண்டு","tr":"pālkoṇṭu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"பால்","tr":"pāl"},{"kind":"nēr","text":"கொண்","tr":"koṇ"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"மடுப்பவு","tr":"maṭuppavu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மடுப்","tr":"maṭup"},{"kind":"nirai","text":"பவு","tr":"pavu"}]},{"text":"முண்ணா","tr":"muṇṇā","foot":"tēmā","acai":[{"kind":"nēr","text":"முண்","tr":"muṇ"},{"kind":"nēr","text":"ணா","tr":"ṇā"}]},{"text":"னாகலின்","tr":"ṉākaliṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"னா","tr":"ṉā"},{"kind":"nirai","text":"கலின்","tr":"kaliṉ"}]}],[{"text":"செறாஅ","tr":"ceṟāa","foot":"puḷimā","acai":[{"kind":"nirai","text":"செறா","tr":"ceṟā"},{"kind":"nēr","text":"அ","tr":"a"}]},{"text":"தோச்சிய","tr":"tōcciya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தோச்","tr":"tōc"},{"kind":"nirai","text":"சிய","tr":"ciya"}]},{"text":"சிறுகோ","tr":"ciṟukō","foot":"puḷimā","acai":[