{"text":"purananuru","n":244,"lines":["பாடலும் சிதைந்தே கிடைத்துள்ளன","பாணர் சென்னியும் வண்டுசென்று ஊதா","விறலியர் முன்கையும் தொடியிற் பொலியா","இரவல் மாக்களும் …"],"tr":["pāṭalum citaintē kiṭaittuḷḷaṉa","pāṇar ceṉṉiyum vaṇṭuceṉṟu ūtā","viṟaliyar muṉkaiyum toṭiyiṟ poliyā","iraval mākkaḷum"],"colophon":{},"scan":{"meter":"not a regular āciriyappā","ok":false,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 1×2 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 13, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 9, āciriyattaḷai 3, kalittaḷai 1"},{"name":"ending","ok":false,"detail":"no usual ending"}],"ending":null,"lines":[[{"text":"பாட","tr":"pāṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"லும்சிதைந்","tr":"lumcitain","foot":"kūviḷam","acai":[{"kind":"nēr","text":"லும்","tr":"lum"},{"kind":"nirai","text":"சிதைந்","tr":"citain"}]},{"text":"தேகிடைத்","tr":"tēkiṭait","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தே","tr":"tē"},{"kind":"nirai","text":"கிடைத்","tr":"kiṭait"}]},{"text":"துள்ளன","tr":"tuḷḷaṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"துள்","tr":"tuḷ"},{"kind":"nirai","text":"ளன","tr":"ḷaṉa"}]}],[{"text":"பாணர்","tr":"pāṇar","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"ணர்","tr":"ṇar"}]},{"text":"சென்னியும்","tr":"ceṉṉiyum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சென்","tr":"ceṉ"},{"kind":"nirai","text":"னியும்","tr":"ṉiyum"}]},{"text":"வண்டுசென்","tr":"vaṇṭuceṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வண்","tr":"vaṇ"},{"kind":"nirai","text":"டுசென்","tr":"ṭuceṉ"}]},{"text":"றூதா","tr":"ṟūtā","foot":"tēmā","acai":[{"kind":"nēr","text":"றூ","tr":"ṟū"},{"kind":"nēr","text":"தா","tr":"tā"}]}],[{"text":"விறலியர்","tr":"viṟaliyar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விற","tr":"viṟa"},{"kind":"nirai","text":"லியர்","tr":"liyar"}]},{"text":"முன்கையும்","tr":"mu