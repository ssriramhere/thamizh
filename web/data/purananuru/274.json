{"text":"purananuru","n":274,"lines":["நீலக் கச்சைப் பூவார் ஆடைப்","பீலிக் கண்ணிப் பெருந்தகை மறவன்","மேல்வரும் களிற்றொடு வேல்துரந்து இனியே","தன்னும் துரக்குவன் போலும் ஒன்னலர்","எ·குடை வலத்தர் மாவொடு பரத்தரக்","கையின் வாங்கித் தழீஇ","மொய்ம்பின் ஊக்கி மெய்க்கொண் டனனே"],"tr":["nīlak kaccaip pūvār āṭaip","pīlik kaṇṇip peruntakai maṟavaṉ","mēlvarum kaḷiṟṟoṭu vēlturantu iṉiyē","taṉṉum turakkuvaṉ pōlum oṉṉalar","ekuṭai valattar māvoṭu parattarak","kaiyiṉ vāṅkit taḻīi","moympiṉ ūkki meykkoṇ ṭaṉaṉē"],"colophon":{"tinai":"tumpai","tinai_ta":"தும்பை","turai_ta":"எருமை மறம்","poet_ta":"உலோச்சனார்","poet_tr":"Ulōccaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நீலக்","tr":"nīlak","foot":"tēmā","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nēr","text":"லக்","tr":"lak"}]},{"text":"கச்சைப்","tr":"kaccaip","foot":"tēmā","acai":[{"kind":"nēr","text":"கச்","tr":"kac"},{"kind":"nēr","text":"சைப்","tr":"caip"}]},{"text":"பூவா","tr":"pūvā","foot":"tēmā","acai":[{"kind":"nēr","text":"பூ","tr":"pū"},{"kind":"nēr","text":"வா","tr":"vā"}]},{"text":"ராடைப்","tr":"rāṭaip","foot":"tēmā","acai":[{"kind":"nēr","text":"ரா","tr":"rā"},{"kind":"nēr","text":"டைப்","tr":"ṭaip"}]}],[{"text":"பீலிக்","tr":"pīlik","foot":"tēmā","acai":[{"kind":"nēr","text":"பீ","tr":"pī"},{"kind":"nēr","text":"லிக்","tr":"lik"}]},{"text":"கண்ணிப்","tr":"kaṇṇip","foot":"tēmā","acai":[{"kind":"nēr","text":"கண்","tr":"kaṇ"},{"kind":"nēr","text":"ணிப்","tr":"ṇip"}]},{"text":"பெருந்தகை","tr":"peruntakai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெருந்","tr":"perun"},{"kind":"nirai","text":"தகை","tr":"takai"}]},{"text":"மறவன்","tr":"maṟavaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text"