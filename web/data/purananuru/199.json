{"text":"purananuru","n":199,"lines":["கடவுள் ஆலத்துத் தடவுச்சினைப் பல்பழம்","நெருநல் உண்டனம் என்னாது பின்னும்","செலவுஆ னாவே கலிகொள் புள்ளினம்","அனையர் வாழியோ இரவலர் அவரைப்","புரவுஎதிர் கொள்ளும் பெருஞ்செய் ஆடவர்","உடைமை ஆகும் அவர் உடைமை","அவர் இன்மை ஆகும் அவர் இன்மையே"],"tr":["kaṭavuḷ ālattut taṭavucciṉaip palpaḻam","nerunal uṇṭaṉam eṉṉātu piṉṉum","celavuā ṉāvē kalikoḷ puḷḷiṉam","aṉaiyar vāḻiyō iravalar avaraip","puravuetir koḷḷum peruñcey āṭavar","uṭaimai ākum avar uṭaimai","avar iṉmai ākum avar iṉmaiyē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"பரிசில் கடா நிலை","poet_ta":"பெரும்பதுமனார்","poet_tr":"Perumpatumaṉār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"7×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 14, āciriyattaḷai 12, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கடவுளா","tr":"kaṭavuḷā","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கட","tr":"kaṭa"},{"kind":"nirai","text":"வுளா","tr":"vuḷā"}]},{"text":"லத்துத்த","tr":"lattutta","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"லத்","tr":"lat"},{"kind":"nēr","text":"துத்","tr":"tut"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"டவுச்சினைப்","tr":"ṭavucciṉaip","foot":"karuviḷam","acai":[{"kind":"nirai","text":"டவுச்","tr":"ṭavuc"},{"kind":"nirai","text":"சினைப்","tr":"ciṉaip"}]},{"text":"பல்பழம்","tr":"palpaḻam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பல்","tr":"pal"},{"kind":"nirai","text":"பழம்","tr":"paḻam"}]}],[{"text":"நெருந","tr":"neruna","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெரு","tr":"neru"},{"kind":"nēr","text":"ந","tr":"na"}]},{"text":"லுண்டன","tr":"luṇṭaṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"லுண்","tr":"luṇ"},{"kind":"nirai","text":"டன","tr":"ṭaṉa"}]},{"text":"மென்னா","tr":"meṉṉā","foot":"tēmā","acai":[{"kind":"nēr