imā","acai":[{"kind":"nirai","text":"ருடை","tr":"ruṭai"},{"kind":"nēr","text":"மை","tr":"mai"}]},{"text":"யாகு","tr":"yāku","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"கு","tr":"ku"}]},{"text":"மவரு","tr":"mavaru","foot":"puḷimā","acai":[{"kind":"nirai","text":"மவ","tr":"mava"},{"kind":"nēr","text":"ரு","tr":"ru"}]},{"text":"டைமை","tr":"ṭaimai","foot":"tēmā","acai":[{"kind":"nēr","text":"டை","tr":"ṭai"},{"kind":"nēr","text":"மை","tr":"mai"}]}],[{"text":"யவரின்மை","tr":"yavariṉmai","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"யவ","tr":"yava"},{"kind":"nēr","text":"ரின்","tr":"riṉ"},{"kind":"nēr","text":"மை","tr":"mai"}]},{"text":"யாகு","tr":"yāku","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"கு","tr":"ku"}]},{"text":"மவரின்","tr":"mavariṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மவ","tr":"mava"},{"kind":"nēr","text":"ரின்","tr":"riṉ"}]},{"text":"மையே","tr":"maiyē","foot":"tēmā","acai":[{"kind":"nēr","text":"மை","tr":"mai"},{"kind":"nēr","text":"யே","tr":"yē"}]}]]},"ai":null}