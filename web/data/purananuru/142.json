{"text":"purananuru","n":142,"lines":["அறுகுளத்து உகுத்தும் அகல்வயல் பொழிந்தும்","உறுமிடத்து உதவாது உவர்நிலம் ஊட்டியும்","வரையா மரபின் மாரி போலக்","கடாஅ யானைக் கழற்கால் பேகன்","கொடைமடம் படுதல் அல்லது","படைமடம் படான் பிறர் படைமயக் குறினே"],"tr":["aṟukuḷattu ukuttum akalvayal poḻintum","uṟumiṭattu utavātu uvarnilam ūṭṭiyum","varaiyā marapiṉ māri pōlak","kaṭāa yāṉaik kaḻaṟkāl pēkaṉ","koṭaimaṭam paṭutal allatu","paṭaimaṭam paṭāṉ piṟar paṭaimayak kuṟiṉē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"இயன்மொழி","poet_ta":"பரணர்","addressed_ta":"வையாவிக் கோப்பெரும் பேகன்","poet_tr":"Paraṇar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அறுகுளத்","tr":"aṟukuḷat","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அறு","tr":"aṟu"},{"kind":"nirai","text":"குளத்","tr":"kuḷat"}]},{"text":"துகுத்து","tr":"tukuttu","foot":"puḷimā","acai":[{"kind":"nirai","text":"துகுத்","tr":"tukut"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"மகல்வயல்","tr":"makalvayal","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மகல்","tr":"makal"},{"kind":"nirai","text":"வயல்","tr":"vayal"}]},{"text":"பொழிந்து","tr":"poḻintu","foot":"puḷimā","acai":[{"kind":"nirai","text":"பொழிந்","tr":"poḻin"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"முறுமிடத்","tr":"muṟumiṭat","foot":"karuviḷam","acai":[{"kind":"nirai","text":"முறு","tr":"muṟu"},{"kind":"nirai","text":"மிடத்","tr":"miṭat"}]},{"text":"துதவா","tr":"tutavā","foot":"puḷimā","acai":[{"kind":"nirai","text":"துத","tr":"tuta"},{"kind":"nēr","text":"வா","tr":"vā"}]},{"text":"துவர்நில","tr":"tuvarnila","foot":"karuviḷam","acai":[{"kind":"nirai","text":"துவர்","tr":"tuvar"},{"kind":"nirai","text":"நில","tr":"nila"}]},{