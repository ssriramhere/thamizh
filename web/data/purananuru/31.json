gn lands"]],[["இறுத்து","having camped"]],[["குண","eastern"]],[["கடல்","sea"]],[["பின்னதாக","being behind"]],[["பின்னதாக","being behind"],["குட","western"]],[["குட","western"]],[["கடல்","sea"]],[["வெண்","white"]],[["தலை","headed"]],[["புணரி","waves"]],[["நின்","your"]],[["மான்குளம்பு","horses' hooves"]],[["அலைப்ப","to splash"]],[["வலமுறை","in a clockwise manner"]],[["வருதலும்","and coming"]],[["உண்டு","is certain"]],[["என்று","having said"]],[["அலமந்து","having been distressed"]],[["நெஞ்சு","heart"]],[["நடுங்கு","trembling"]],[["அவலம்","sorrow"]],[["பாயத்","to spread"]],[["துஞ்சா","sleepless"]],[["கண்ண","possessing eyes"]],[["வட","northern"]],[["புலத்து","of the land"]],[["அரசே","O kings!"]]]}