{"text":"purananuru","n":240,"lines":["ஆடு நடைப் புரவியும் களிறும் தேரும்","வாடா யாணர் நாடும் ஊரும்","பாடுநர்க்கு அருகா ஆஅய் அண்டிரன்","கோடுஏந்து அல்குல் குறுந்தொடி மகளிரொடு","காலன் என்னும் கண்ணிலி உய்ப்ப","மேலோர் உலகம் எய்தினன் எனாஅப்","பொத்த அறையுள் போழ்வாய்க் கூகை","சுட்டுக் குவி எனச் செத்தோர்ப் பயிரும்","கள்ளியம் பறந்தலை ஒருசிறை அல்கி","ஒள்ளெரி நைப்ப உடம்பு மாய்ந்தது","புல்லென் கண்ணர் புரவலர்க் காணாது","கல்லென் சுற்றமொடு கையழிந்து புலவர்","வாடிய பசியர் ஆகிப் பிறர்","நாடுபடு செலவினர் ஆயினர் இனியே"],"tr":["āṭu naṭaip puraviyum kaḷiṟum tērum","vāṭā yāṇar nāṭum ūrum","pāṭunarkku arukā āay aṇṭiraṉ","kōṭuēntu alkul kuṟuntoṭi makaḷiroṭu","kālaṉ eṉṉum kaṇṇili uyppa","mēlōr ulakam eytiṉaṉ eṉāap","potta aṟaiyuḷ pōḻvāyk kūkai","cuṭṭuk kuvi eṉac cettōrp payirum","kaḷḷiyam paṟantalai oruciṟai alki","oḷḷeri naippa uṭampu māyntatu","pulleṉ kaṇṇar puravalark kāṇātu","kalleṉ cuṟṟamoṭu kaiyaḻintu pulavar","vāṭiya paciyar ākip piṟar","nāṭupaṭu celaviṉar āyiṉar iṉiyē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"கையறுநிலை","poet_ta":"குட்டுவன் கீரனார்","addressed_ta":"ஆய்","poet_tr":"Kuṭṭuvaṉ Kīraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"14 lines"},{"name":"feet per line","ok":true,"detail":"13×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 51, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 32, veṇṭaḷai 20, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஆடுநடைப்","tr":"āṭunaṭaip","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nirai","text":"டுந","tr":"ṭuna"},{"kind":"nēr","text":"டைப்","tr":"ṭaip"}]},{"text":"புரவியும்","tr":"puraviyum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"புர","tr":"pura"},{"kind":"nirai","text":"வியும்","tr":"viyum"}]},{"text":"களிறும்","tr":"kaḷiṟum","foot":"puḷimā","acai":[{"kind":"nirai","text":"களி","tr":"kaḷi"},{"kind":"nēr","text":"றும்","tr":"ṟum"}]},{"text":