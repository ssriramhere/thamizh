{"text":"purananuru","n":12,"lines":["பாணர் தாமரை மலையவும் புலவர்","பூநுதல் யானையோடு புனைதேர் பண்ணவும்","அறனோ மற்றஇது விறல்மாண் குடுமி","இன்னா ஆகப் பிறர் மண் கொண்டு","இனிய செய்தி நின் ஆர்வலர் முகத்தே"],"tr":["pāṇar tāmarai malaiyavum pulavar","pūnutal yāṉaiyōṭu puṉaitēr paṇṇavum","aṟaṉō maṟṟaitu viṟalmāṇ kuṭumi","iṉṉā ākap piṟar maṇ koṇṭu","iṉiya ceyti niṉ ārvalar mukattē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"இயன்மொழி","poet_ta":"நெட்டிமையார்","addressed_ta":"பாண்டியன் பல்யாகசாலை முதுகுடுமிப் பெருவழுதி","poet_tr":"Neṭṭimaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 15, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 5, kalittaḷai 3"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பாணர்","tr":"pāṇar","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"ணர்","tr":"ṇar"}]},{"text":"தாமரை","tr":"tāmarai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nirai","text":"மரை","tr":"marai"}]},{"text":"மலையவும்","tr":"malaiyavum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மலை","tr":"malai"},{"kind":"nirai","text":"யவும்","tr":"yavum"}]},{"text":"புலவர்","tr":"pulavar","foot":"puḷimā","acai":[{"kind":"nirai","text":"புல","tr":"pula"},{"kind":"nēr","text":"வர்","tr":"var"}]}],[{"text":"பூநுதல்","tr":"pūnutal","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பூ","tr":"pū"},{"kind":"nirai","text":"நுதல்","tr":"nutal"}]},{"text":"யானையோ","tr":"yāṉaiyō","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னை","tr":"ṉai"},{"kind":"nēr","text":"யோ","tr":"yō"}]},{"text":"டுபுனைதேர்","tr":"ṭupuṉaitēr","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"டுபு","tr":"ṭupu"},{"kind":"nēr","text":"னை","tr":"ṉai"},{"kind":"nēr","text":"தேர்","tr":"t