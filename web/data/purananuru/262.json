{"text":"purananuru","n":262,"lines":["நறவும் தொடுமின் விடையும் வீழ்மின்","பாசுவல் இட்ட புன்காற் பந்தர்ப்","புனல்தரும் இளமணல் நிறையப் பெய்ம்மின்","ஒன்னார் முன்னிலை முருக்கிப் பின்நின்று","நிரையோடு வரூஉம் என்னைக்கு","உழையோர் தன்னினும் பெருஞ்சா யலரே"],"tr":["naṟavum toṭumiṉ viṭaiyum vīḻmiṉ","pācuval iṭṭa puṉkāṟ pantarp","puṉaltarum iḷamaṇal niṟaiyap peymmiṉ","oṉṉār muṉṉilai murukkip piṉniṉṟu","niraiyōṭu varūum eṉṉaikku","uḻaiyōr taṉṉiṉum peruñcā yalarē"],"colophon":{"tinai":"veṭci","tinai_ta":"வெட்சி","turai_ta":"உண்டாட்டு","poet_ta":"மதுரைப் பேராலவாயர்","poet_tr":"Maturaip Pērālavāyar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 6, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நறவும்","tr":"naṟavum","foot":"puḷimā","acai":[{"kind":"nirai","text":"நற","tr":"naṟa"},{"kind":"nēr","text":"வும்","tr":"vum"}]},{"text":"தொடுமின்","tr":"toṭumiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"தொடு","tr":"toṭu"},{"kind":"nēr","text":"மின்","tr":"miṉ"}]},{"text":"விடையும்","tr":"viṭaiyum","foot":"puḷimā","acai":[{"kind":"nirai","text":"விடை","tr":"viṭai"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"வீழ்மின்","tr":"vīḻmiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"வீழ்","tr":"vīḻ"},{"kind":"nēr","text":"மின்","tr":"miṉ"}]}],[{"text":"பாசுவ","tr":"pācuva","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nirai","text":"சுவ","tr":"cuva"}]},{"text":"லிட்ட","tr":"liṭṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"லிட்","tr":"liṭ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"புன்காற்","tr":"puṉkāṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"புன்","tr":"puṉ"},{"kind":"nēr","text":"காற்","tr":"kāṟ"}]},{"text":"பந்தர்ப்","tr":"pantarp","foot":"tēmā","acai":[