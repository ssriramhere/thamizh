{"text":"purananuru","n":332,"lines":["பிறர்வேல் போலா தாகி இவ்வூர்","மறவன் வேலோ பெருந்தகை உடைத்தே","இரும்புறம் நீறும் ஆடிக் கலந்துஇடைக்","குரம்பைக் கூரைக் கிடக்கினும் கிடக்கும்","மங்கல மகளிரொடு மாலை சூட்டி","இன்குரல் இரும்பை யாழொடு ததும்பத்","தெண்ணீர்ப் படுவினும் தெருவினும் திரிந்து","மண்முழுது அழுங்கச் செல்லினும் செல்லும் ஆங்கு","இருங்கடல் தானை வேந்தர்","பெருங்களிற்று முகத்தினும் செலவு ஆனாதே"],"tr":["piṟarvēl pōlā tāki ivvūr","maṟavaṉ vēlō peruntakai uṭaittē","irumpuṟam nīṟum āṭik kalantuiṭaik","kurampaik kūraik kiṭakkiṉum kiṭakkum","maṅkala makaḷiroṭu mālai cūṭṭi","iṉkural irumpai yāḻoṭu tatumpat","teṇṇīrp paṭuviṉum teruviṉum tirintu","maṇmuḻutu aḻuṅkac celliṉum cellum āṅku","iruṅkaṭal tāṉai vēntar","peruṅkaḷiṟṟu mukattiṉum celavu āṉātē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"மூதின் முல்லை","poet_ta":"விரியூர் கிழார்","poet_tr":"Viriyūr Kiḻār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"10 lines"},{"name":"feet per line","ok":true,"detail":"9×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 38, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 26, veṇṭaḷai 11, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பிறர்வேல்","tr":"piṟarvēl","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிறர்","tr":"piṟar"},{"kind":"nēr","text":"வேல்","tr":"vēl"}]},{"text":"போலா","tr":"pōlā","foot":"tēmā","acai":[{"kind":"nēr","text":"போ","tr":"pō"},{"kind":"nēr","text":"லா","tr":"lā"}]},{"text":"தாகி","tr":"tāki","foot":"tēmā","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"கி","tr":"ki"}]},{"text":"யிவ்வூர்","tr":"yivvūr","foot":"tēmā","acai":[{"kind":"nēr","text":"யிவ்","tr":"yiv"},{"kind":"nēr","text":"வூர்","tr":"vūr"}]}],[{"text":"மறவன்","tr":"maṟavaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மற","tr":"maṟa"},{"kind":"nēr","text":"வன்","tr":"vaṉ"}]},{"text":"வேலோ","tr":"vēlō","foot":"tēmā","acai":[{"kind":"nēr",