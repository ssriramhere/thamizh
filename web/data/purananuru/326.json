{"text":"purananuru","n":326,"lines":["ஊர்முது வேலிப் பார்நடை வெருகின்","இருட்பகை வெரீஇய நாகுஇளம் பேடை","உயிர்நடுக் குற்றுப் புலாவிட் டரற்றச்","சிறையும் செற்றையும் புடையுநள் எழுந்த","பருத்திப் பெண்டின் சிறுதீ விளக்கத்துக்","கலிர்ப்பூ நெற்றிச் சேவலின் தணியும்","அருமிளை இருக்கை யதுவே மனைவியும்","வேட்டச் சிறா அர் சேட்புலம் படராது","படமடைக் கொண்ட குறுந்தாள் உடும்பின்","விழுக்குநிணம் பெய்த தயிர்க்கண் மிதவை","யாணர் நல்லவை பாணரொடு ஒராங்கு","வருவிருந்து அயரும் விருப்பினள் கிழவனும்","அருஞ்சமம் ததையத் தாக்கிப் பெருஞ்சமத்து","அண்ணல் யானை அணிந்த","பொன்செய் ஓடைப் பெரும்பரி சிலனே"],"tr":["ūrmutu vēlip pārnaṭai verukiṉ","iruṭpakai verīiya nākuiḷam pēṭai","uyirnaṭuk kuṟṟup pulāviṭ ṭaraṟṟac","ciṟaiyum ceṟṟaiyum puṭaiyunaḷ eḻunta","paruttip peṇṭiṉ ciṟutī viḷakkattuk","kalirppū neṟṟic cēvaliṉ taṇiyum","arumiḷai irukkai yatuvē maṉaiviyum","vēṭṭac ciṟā ar cēṭpulam paṭarātu","paṭamaṭaik koṇṭa kuṟuntāḷ uṭumpiṉ","viḻukkuniṇam peyta tayirkkaṇ mitavai","yāṇar nallavai pāṇaroṭu orāṅku","varuviruntu ayarum viruppiṉaḷ kiḻavaṉum","aruñcamam tataiyat tākkip peruñcamattu","aṇṇal yāṉai aṇinta","poṉcey ōṭaip perumpari cilaṉē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"மூதின் முல்லை","poet_ta":"தங்கால் பொற்கொல்லன் வெண்ணாகனார்","poet_tr":"Taṅkāl Poṟkollaṉ Veṇṇākaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"15 lines"},{"name":"feet per line","ok":true,"detail":"14×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 55, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 31, āciriyattaḷai 24, kalittaḷai 3"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஊர்முது","tr":"ūrmutu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஊர்","tr":"ūr"},{"kind":"nirai","text":"முது","tr":"mutu"}]},{"text":"வேலிப்","tr":"vēlip","foot":"tēmā","acai":[{"kind":"nēr","text":"வே","tr":"vē"},{"kind":"nēr","text":"லிப்","tr":"lip"}]},{"text":"பார்நடை","tr":"pārnaṭai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பார்","tr":"pār"},{"kind":"nirai","text":"நடை","tr":"naṭai"}]},{"text":"வெருகி","tr":"veruki","foot":"puḷimā","acai":[{"kind":"nirai","text":"வெரு","tr":"veru"},{"kind":"nēr","text":"கி","tr":"ki"}]}],[{"text":"னிருட்பகை","tr":"ṉiruṭpakai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"னிருட்","tr":"ṉiruṭ"},{"kind":"nirai","text":"பகை","tr":"pakai"}]},{"text":"வெரீஇய","tr":"verīiya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வெரீ","tr":"verī"},{"kind":"nirai","text":"இய","tr":"iya"}]},{"text":"நாகிளம்","tr":"nākiḷam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nirai","text":"கிளம்","tr":"kiḷam"}]},{"text":"பேடை","tr":"pēṭai","foot":"tēmā","acai":[{"kind":"nēr","text":"பே","tr":"pē"},{"kind":"nēr","text":"டை","tr":"ṭai"}]}],[{"text":"யுயிர்நடுக்","tr":"yuyirnaṭuk","foot":"karuviḷam","acai":[{"kind":"nirai","text":"யுயிர்","tr":"yuyir"},{"kind":"nirai","text":"நடுக்","tr":"naṭuk"}]},{"text":"குற்றுப்","tr":"kuṟṟup","foot":"tēmā","acai":[{"kind":"nēr","text":"குற்","tr":"kuṟ"},{"kind":"nēr","text":"றுப்","tr":"ṟup"}]},{"text":"புலாவிட்","tr":"pulāviṭ","foot":"puḷimā","acai":[{"kind":"nirai","text":"புலா","tr":"pulā"},{"kind":"nēr","text":"விட்","tr":"viṭ"}]},{"text":"டரற்றச்","tr":"ṭaraṟṟac","foot":"puḷimā","acai":[{"kind":"nirai","text":"டரற்","tr":"ṭaraṟ"},{"kind":"nēr","text":"றச்","tr":"ṟac"}]}],[{"text":"சிறையும்","tr":"ciṟaiyum","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிறை","tr":"ciṟai"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"செற்றையும்","tr":"ceṟṟaiyum","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"செற்","tr":"ceṟ"},{"kind":"nēr","text":"றை","tr":"ṟai"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"புடையுந","tr":"puṭaiyuna","foot":"karuviḷam","acai":[{"kind":"nirai","text":"புடை","tr":"puṭai"},{"kind":"nirai","text":"யுந","tr":"yuna"}]},{"text":"ளெழுந்த","tr":"ḷeḻunta","foot":"puḷimā","acai":[{"kind":"nirai","text":"ளெழுந்","tr":"ḷeḻun"},{"kind":"nēr","text":"த","tr":"ta"}]}],[{"text":"பருத