"foot":"puḷimā","acai":[{"kind":"nirai","text":"டொராங்","tr":"ṭorāṅ"},{"kind":"nēr","text":"கு","tr":"ku"}]}],[{"text":"வருவிருந்","tr":"varuvirun","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வரு","tr":"varu"},{"kind":"nirai","text":"விருந்","tr":"virun"}]},{"text":"தயரும்","tr":"tayarum","foot":"puḷimā","acai":[{"kind":"nirai","text":"தய","tr":"taya"},{"kind":"nēr","text":"ரும்","tr":"rum"}]},{"text":"விருப்பினள்","tr":"viruppiṉaḷ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விருப்","tr":"virup"},{"kind":"nirai","text":"பினள்","tr":"piṉaḷ"}]},{"text":"கிழவனு","tr":"kiḻavaṉu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கிழ","tr":"kiḻa"},{"kind":"nirai","text":"வனு","tr":"vaṉu"}]}],[{"text":"மருஞ்சமம்","tr":"maruñcamam","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மருஞ்","tr":"maruñ"},{"kind":"nirai","text":"சமம்","tr":"camam"}]},{"text":"ததையத்","tr":"tataiyat","foot":"puḷimā","acai":[{"kind":"nirai","text":"ததை","tr":"tatai"},{"kind":"nēr","text":"யத்","tr":"yat"}]},{"text":"தாக்கிப்","tr":"tākkip","foot":"tēmā","acai":[{"kind":"nēr","text":"தாக்","tr":"tāk"},{"kind":"nēr","text":"கிப்","tr":"kip"}]},{"text":"பெருஞ்சமத்","tr":"peruñcamat","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெருஞ்","tr":"peruñ"},{"kind":"nirai","text":"சமத்","tr":"camat"}]}],[{"text":"தண்ணல்","tr":"taṇṇal","foot":"tēmā","acai":[{"kind":"nēr","text":"தண்","tr":"taṇ"},{"kind":"nēr","text":"ணல்","tr":"ṇal"}]},{"text":"யானை","tr":"yāṉai","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னை","tr":"ṉai"}]},{"text":"யணிந்த","tr":"yaṇinta","foot":"puḷimā","acai":[{"kind":"nirai","text":"யணிந்","tr":"yaṇin"},{"kind":"nēr","text":"த","tr":"ta"}]}],[{"text":"பொன்செ","tr":"poṉce","foot":"tēmā","acai":[{"kind":"nēr","text":"பொன்","tr":"poṉ"},{"kind":"nēr","text":"செ","tr":"ce"}]},{"text":"யோடைப்","tr":"yōṭaip","foot":"tēmā","acai":[{"kind":"nēr","text":"யோ","tr":"yō"},{"kind":"nēr","text":"டைப்","tr":"ṭaip"}]},{"text":"பெரும்பரி","tr":"per