{"text":"purananuru","n":291,"lines":["சிறாஅஅர் துடியர் பாடுவல் மகாஅஅர்","தூவெள் அறுவை மாயோற் குறுகி","இரும்புள் பூசல் ஓம்புமின் யானும்","விளரிக் கொட்பின் வெண்ணரி கடிகுவென்","என்போற் பெருவிதுப்பு உறுக வேந்தே_","கொன்னும் சாதல் வெய்யோற்குத் தன்தலை","மணிமருள் மாலை சூட்டி அவன் தலை","ஒருகாழ் மாலை தான்மலைந் தனனே"],"tr":["ciṟāaar tuṭiyar pāṭuval makāaar","tūveḷ aṟuvai māyōṟ kuṟuki","irumpuḷ pūcal ōmpumiṉ yāṉum","viḷarik koṭpiṉ veṇṇari kaṭikuveṉ","eṉpōṟ peruvituppu uṟuka vēntē","koṉṉum cātal veyyōṟkut taṉtalai","maṇimaruḷ mālai cūṭṭi avaṉ talai","orukāḻ mālai tāṉmalain taṉaṉē"],"colophon":{"tinai":"karantai","tinai_ta":"கரந்தை","turai_ta":"வேத்தியல்","poet_ta":"நெடுங்கழுத்துப் பரணர்","poet_tr":"Neṭuṅkaḻuttup Paraṇar"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"8×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 31, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 20, veṇṭaḷai 11"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"சிறாஅவர்","tr":"ciṟāavar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சிறா","tr":"ciṟā"},{"kind":"nirai","text":"அவர்","tr":"avar"}]},{"text":"துடியர்","tr":"tuṭiyar","foot":"puḷimā","acai":[{"kind":"nirai","text":"துடி","tr":"tuṭi"},{"kind":"nēr","text":"யர்","tr":"yar"}]},{"text":"பாடுவல்","tr":"pāṭuval","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nirai","text":"டுவல்","tr":"ṭuval"}]},{"text":"மகாஅவர்","tr":"makāavar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மகா","tr":"makā"},{"kind":"nirai","text":"அவர்","tr":"avar"}]}],[{"text":"தூவெ","tr":"tūve","foot":"tēmā","acai":[{"kind":"nēr","text":"தூ","tr":"tū"},{"kind":"nēr","text":"வெ","tr":"ve"}]},{"text":"ளறுவை","tr":"ḷaṟuvai","foot":"puḷimā","acai":[{"kind":"nirai","text":"ளறு","tr":"ḷaṟu"},{"kind":"nēr","text":"வை","tr":"vai"}]},{"text":"மாயோற்","tr":"māyōṟ","foot":"tēmā","acai":[{"kind":"nēr"