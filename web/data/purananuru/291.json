"},{"text":"வல்","lemma":"-val","gloss":"first person singular future suffix"}],"gloss":"I will sing"},{"surface":"மகாஅஅர்","parts":[{"text":"மகாஅஅர்","lemma":"மகாஅஅர்","gloss":"young warriors"}],"gloss":"young warriors","split_unverified":true}]},{"words":[{"surface":"தூ","parts":[{"text":"தூ","lemma":"tū","gloss":"pure"}],"gloss":"pure"},{"surface":"வெள்","parts":[{"text":"வெள்","lemma":"veḷ","gloss":"white"}],"gloss":"white"},{"surface":"அறுவை","parts":[{"text":"அறுவை","lemma":"aṟuvai","gloss":"cloth"}],"gloss":"shroud"},{"surface":"மாயோன்","parts":[{"text":"மாயோன்","lemma":"māyōṉ","gloss":"dark-complexioned man"}],"gloss":"the dark-complexioned hero"},{"surface":"குறுகி","parts":[{"text":"குறுகு","lemma":"kuṟuku","gloss":"approach"},{"text":"இ","lemma":"-i","gloss":"verbal participle suffix"}],"gloss":"having approached"}]},{"words":[{"surface":"இரும்","parts":[{"text":"இரும்","lemma":"irum","gloss":"dark"}],"gloss":"dark"},{"surface":"புள்","parts":[{"text":"புள்","lemma":"puḷ","gloss":"bird"}],"gloss":"carrion birds"},{"surface":"பூசல்","parts":[{"text":"பூசல்","lemma":"pūcal","gloss":"clamor"}],"gloss":"clamor"},{"surface":"ஓம்புமின்","parts":[{"text":"ஓம்பு","lemma":"ōmpu","gloss":"ward off"},{"text":"மின்","lemma":"-miṉ","gloss":"plural imperative suffix"}],"gloss":"ward off!"},{"surface":"யானும்","parts":[{"text":"யான்","lemma":"yāṉ","gloss":"I"},{"text":"உம்","lemma":"-um","gloss":"also"}],"gloss":"I too"}]},{"words":[{"surface":"விளரி","parts":[{"text":"விளரி","lemma":"viḷari","gloss":"Viḷari melody"}],"gloss":"Viḷari melody"},{"surface":"கொட்பின்","parts":[{"text":"கொட்பு","lemma":"koṭpu","gloss":"whirling"},{"text":"இன்","lemma":"-iṉ","gloss":"with"}],"gloss":"with whirling"},{"surface":"வெள்","parts":[{"text":"வெள்","lemma":"veḷ","gloss":"white"}],"gloss":"white"},{"surface":"நரி","parts":[{"text":"நரி","lemma":"nari","gloss":"jackal"}],"gloss":"jackals"},{"surface":"கடிகுவென்","parts":[{"text":"கடி","lemma":"kaṭi","gloss":"chase away"},{"text":"கு","lemma":"-ku-","gloss":"future tense marker"},{"text":"என்","lemma":"-eṉ","gloss":"first person singular suffix"}],"gloss":"I will chase away"}]},{"words":[{"surface":"என்போற்","parts":[{"text":"என்போற்","lemma":"என்போற்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"பெருவிதுப்பு","parts":[{"text":"பெருவிதுப்பு","lemma":"பெருவிதுப்பு","gloss":""}],"gloss":"","split_unverified":true},{"surface":"உறுக","parts":[{"text":"உறுக","lemma":"உறுக","gloss":""}],"gloss":"","split_unverified":true},{"surface":"வேந்தே","parts":[{"text":"வேந்தே","lemma":"வேந்தே","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"கொன்னும்","parts":[{"text":"கொன்","lemma":"koṉ","gloss":"uselessness"},{"text":"உம்","lemma":"-um","gloss":"even"}],"gloss":"even in vain"},{"surface":"சாதல்","parts":[{"text":"சாதல்","lemma":"cātal","gloss":"dying"}],"gloss":"dying"},{"surface":"வெய்யோற்கு","parts":[{"text":"வெய்யோன்","lemma":"veyyōṉ","gloss":"he who desired"},{"text":"கு","lemma":"-ku","gloss":"to"}],"gloss":"to him who desired"},{"surface":"தன்","parts":[{"text":"தன்","lemma":"taṉ","gloss":"his"}],"gloss":"his"},{"surface":"தலை","parts":[{"text":"தலை","lemma":"talai","gloss":"head"}],"gloss":"head"}]},{"words":[{"surface":"மணி","parts":[{"text":"மணி","lemma":"maṇi","gloss":"sapphire"}],"gloss":"sapphire"},{"surface":"மருள்","parts":[{"text":"மருள்","lemma":"maruḷ","gloss":"resembling"}],"gloss":"resembling"},{"surface":"மாலை","parts":[{"text":"மாலை","lemma":"mālai","gloss":"garland"}],"gloss":"garland"},{"surface":"சூட்டி","parts":[{"text":"சூட்டு","lemma":"cūṭṭu","gloss":"adorn"},{"text":"இ","lemma":"-i","gloss":"verbal participle suffix"}],"gloss":"having adorned"},{"surface":"அவன்","parts":[{"text":"அவன்","lemma":"avaṉ","gloss":"his"}],"gloss":"his"},{"surface":"தலை","parts":[{"text":"தலை","lemma":"talai","gloss":"head"}],"gloss":"head"}]},{"words":[{"surface":"ஒரு","parts":[{"text":"ஒரு","lemma":"oru","gloss":"one"}],"gloss":"one"},{"surface":"காழ்","parts":[{"text":"காழ்","lemma":"kāḻ","gloss":"strand"}],"gloss":"strand"},{"surface":"மாலை","parts":[{"text":"மாலை","lemma":"mālai","gloss":"garland"}],"gloss":"garland"},{"surface":"தான்","parts":[{"text":"தான்","lemma":"tāṉ","gloss":"himself"}],"gloss":"himself"},{"surface":"மலைந்தனனே","parts":[{"text":"மலை","lemma":"malai","gloss":"wear"},{"text":"ந்தனனே","lemma":"-ntaṉaṉē","gloss":"he did (past masculine singular with emphasis)"}],"gloss":"he wore"}]}],"literal":"Young drummers, I will sing, O young warriors! / Approaching the dark-complexioned hero in a pure white shroud, / ward off the clamor of dark carrion birds! I too, / with the whirling of the Viḷari melody, will chase away the white jackals. / May the king experience a great distress like me! / To him who desired even a useless death, placing on his head / a sapphire-resembling garland, on his own head / he wore a single-strand garland.","translation":"O young drummers! O young warriors! I shall sing. Approach the dark-complexioned hero wrapped in a pure white shroud, and ward off the clamor of the dark carrion birds! I too, singing the mournful Viḷari melody in circles, will chase away the white jackals. May the king suffer a great distress like me! To this hero who desired death even in vain, the king adorned his head with his own sapphire-like garland, while on his own head, he wore only a single-strand wreath.","modern":"இளம் துடியர்களே! இளம் வீரர்களே! நான் பாடுவேன். தூய வெள்ளை ஆடையால் மூடப்பட்டிருக்கும் கரிய நிறத்து வீரனை நெருங்கி, கரிய பறவைகளின் ஆரவாரத்தைத் தடுத்து விரட்டுங்கள்! நானும் விளரிப் பண்ணைச் சுழன்று பாடி, வெண்மையான நரிகளை விரட்டுவேன். என்னைப்போலவே அரசனும் பெரும் துயரத்தை அடைவானாக! வீணாகச் சாவதையும் விரும்பிய இவ்வீரனுக்குத் தன் தலையிலிருந்த மணி போன்ற மாலையைச் சூட்டிவிட்டு, அவன் தன் தலையில் ஒரு தனி மாலையை மட்டுமே அணிந்து கொண்டானே!","explanation":"The poet, acting as a guardian of the fallen hero's body on the battlefield, speaks to the young drummers and warriors. He urges them to keep the carrion birds away from the corpse of the brave warrior who lies wrapped in a white shroud, while he himself promises to sing the mournful Viḷari melody to ward off the jackals. He expresses a deep empathy with the king, wishing that the king too feels the immense grief of losing such a warrior. The poem highlights the king's profound respect for the deceased hero, as the king placed his own precious sapphire-like garland on the hero's head and wore a simple single-strand garland himself. Key words include 'விதுப்பு' (distress/grief) and 'மாலை' (garland).","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,1.28],[1.28,1.7],[1.7,2.4],[2.9,3.3],[3.3,3.3],[3.3,3.9],[3.9,4.4],[4.4,5.4],[5.4,5.8],[5.8,6.1],[6.1,6.6],[6.6,6.6],[6.6,6.6],[6.6,6.6],[6.6,6.6],[6.6,9.7],[9.7,10.07],[10.07,10.16],[10.16,10.53],[10.62,10.9],[10.9,12.4],[12.4,12.9],[12.9,13.4],[13.4,14.3],[14.3,14.5],[14.5,15.0],[15.0,15.2],[15.2,15.3],[15.3,16.5],[16.5,16.9],[16.9,17.65],[17.65,17.9]],"female":[[0.0,0.9],[0.9,1.41],[1.41,1.9],[1.9,2.2],[2.2,2.5],[2.5,3.45],[3.45,4.6],[4.6,4.86],[4.86,4.9],[4.9,6.6],[6.6,6.8],[6.8,7.5],[7.5,7.5],[7.5,7.5],[7.5,7.5],[7.5,7.5],[7.5,9.3],[9.3,11.5],[11.9,12.18],[12.18,12.42],[12.5,12.7],[12.7,13.1],[13.1,14.3],[14.3,14.9],[14.9,15.8],[15.8,16.1],[16.1,16.7],[16.7,16.9],[16.9,17.0],[17.0,18.2],[18.2,18.6],[18.6,19.35],[19.35,19.6]]},"sync":[[["சிறாஅஅர்","youths"]],[["துடியர்","drummers"]],[["பாடுவல்","I will sing"]],[["மகாஅஅர்","young warriors"]],[["தூ","pure"],["வெள்","white"]],[["அறுவை","shroud"]],[["மாயோன்","the dark-complexioned hero"]],[["குறுகி","having approached"]],[["இரும்","dark"],["புள்","carrion birds"]],[["பூசல்","clamor"]],[["ஓம்புமின்","ward off!"]],[["யானும்","I too"]],[["விளரி","Viḷari melody"]],[["கொட்பின்","with whirling"]],[["வெள்","white"],["நரி","jackals"]],[["கடிகுவென்","I will chase away"]],[["என்போற்",""]],[["பெருவிதுப்பு",""]],[["உறுக",""]],[["வேந்தே",""]],[["கொன்னும்","even in vain"]],[["சாதல்","dying"]],[["வெய்யோற்கு","to him who desired"],["தன்","his"]],[["தன்","his"],["தலை","head"]],[["மணி","sapphire"],["மருள்","resembling"]],[["மாலை","garland"]],[["சூட்டி","having adorned"]],[["அவன்","his"]],[["தலை","head"]],[["ஒரு","one"],["காழ்","strand"]],[["மாலை","garland"]],[["தான்","himself"],["மலைந்தனனே","he wore"]],[["மலைந்தனனே","he wore"]]]}