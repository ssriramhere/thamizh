{"text":"purananuru","n":96,"lines":["அலர்பூந் தும்பை அம்பகட்டு மார்பின்","திரண்டுநீடு தடக்கை என்னை இளையோற்கு","இரண்டு எழுந் தனவால் பகையே ஒன்றே","பூப்போல் உண்கண் பசந்து தோள் நுணுகி","நோக்கிய மகளிர்ப் பிணித்தன்று ஒன்றே","விழவு இன்று ஆயினும் படு பதம் பிழை யாது","மைஊன் மொசித்த ஒக்கலொடு துறை நீர்க்","கைமான் கொள்ளு மோ என","உறையுள் முனியும் அவன் செல்லும் ஊரே"],"tr":["alarpūn tumpai ampakaṭṭu mārpiṉ","tiraṇṭunīṭu taṭakkai eṉṉai iḷaiyōṟku","iraṇṭu eḻun taṉavāl pakaiyē oṉṟē","pūppōl uṇkaṇ pacantu tōḷ nuṇuki","nōkkiya makaḷirp piṇittaṉṟu oṉṟē","viḻavu iṉṟu āyiṉum paṭu patam piḻai yātu","maiūṉ mocitta okkaloṭu tuṟai nīrk","kaimāṉ koḷḷu mō eṉa","uṟaiyuḷ muṉiyum avaṉ cellum ūrē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"இயன் மொழி","poet_ta":"ஔவையார்","addressed_ta":"அதியமான் மகன் பொகுட்டெழினி","poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"8×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 33, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 19, veṇṭaḷai 14, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அலர்பூந்","tr":"alarpūn","foot":"puḷimā","acai":[{"kind":"nirai","text":"அலர்","tr":"alar"},{"kind":"nēr","text":"பூந்","tr":"pūn"}]},{"text":"தும்பை","tr":"tumpai","foot":"tēmā","acai":[{"kind":"nēr","text":"தும்","tr":"tum"},{"kind":"nēr","text":"பை","tr":"pai"}]},{"text":"யம்பகட்","tr":"yampakaṭ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யம்","tr":"yam"},{"kind":"nirai","text":"பகட்","tr":"pakaṭ"}]},{"text":"டுமார்பின்","tr":"ṭumārpiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"டுமார்","tr":"ṭumār"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]}],[{"text":"திரண்டுநீடு","tr":"tiraṇṭunīṭu","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"திரண்","tr":"tiraṇ"},{"kind":"nirai","text":"டுநீ","tr":"ṭunī"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"தடக்க