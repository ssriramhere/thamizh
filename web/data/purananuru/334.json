்றத்து","gloss":"in the common ground"}],"gloss":"in the common ground","split_unverified":true},{"surface":"ஆர்ப்பின்","parts":[{"text":"ஆர்ப்பு","lemma":"ārppu","gloss":"shouting"},{"text":"இன்","lemma":"iṉ","gloss":"at/conditional suffix"}],"gloss":"at the shouting"}]},{"words":[{"surface":"படப்பு","parts":[{"text":"படப்பு","lemma":"paṭappu","gloss":"backyard garden"}],"gloss":"backyard garden"},{"surface":"ஒடுங்கும்மே","parts":[{"text":"ஒடுங்கும்","lemma":"oṭuṅkum","gloss":"will shrink/hide"},{"text":"ஏ","lemma":"ē","gloss":"emphatic particle"}],"gloss":"will shrink and hide"},{"surface":"…","parts":[{"text":"…","lemma":"…","gloss":"gap"}],"gloss":"gap"},{"surface":"பின்பு","parts":[{"text":"பின்பு","lemma":"piṉpu","gloss":"afterwards"}],"gloss":"afterwards"},{"surface":"…","parts":[{"text":"…","lemma":"…","gloss":"gap"}],"gloss":"gap"}]},{"words":[{"surface":"…","parts":[{"text":"…","lemma":"…","gloss":"gap"}],"gloss":"gap"},{"surface":"ஊரே","parts":[{"text":"ஊர்","lemma":"ūr","gloss":"town"},{"text":"ஏ","lemma":"ē","gloss":"emphatic particle"}],"gloss":"in the town"},{"surface":"மனையோள்","parts":[{"text":"மனை","lemma":"manai","gloss":"house"},{"text":"ஓள்","lemma":"ōḷ","gloss":"she who belongs to"}],"gloss":"the housewife"}]},{"words":[{"surface":"பாணர்","parts":[{"text":"பாணர்","lemma":"pāṇar","gloss":"bards"}],"gloss":"bards"},{"surface":"ஆர்த்தவும்","parts":[{"text":"ஆர்த்த","lemma":"ārtta","gloss":"to feed/satisfy"},{"text":"உம்","lemma":"um","gloss":"and"}],"gloss":"to feed"},{"surface":"பரிசிலர்","parts":[{"text":"பரிசிலர்","lemma":"paricilar","gloss":"gift-seekers"}],"gloss":"gift-seekers"},{"surface":"ஓம்பவும்","parts":[{"text":"ஓம்ப","lemma":"ōmpa","gloss":"to protect/cherish"},{"text":"உம்","lemma":"um","gloss":"and"}],"gloss":"to cherish"}]},{"words":[{"surface":"ஊணொலி","parts":[{"text":"ஊண்","lemma":"ūṇ","gloss":"food"},{"text":"ஒலி","lemma":"oli","gloss":"sound"}],"gloss":"sound of food preparation"},{"surface":"அரவமொடு","parts":[{"text":"அரவம்","lemma":"aravam","gloss":"noise"},{"text":"ஒடு","lemma":"oṭu","gloss":"with"}],"gloss":"with the noise"},{"surface":"கைதூவாளே","parts":[{"text":"கை","lemma":"kai","gloss":"hand"},{"text":"தூவாள்","lemma":"tūvāḷ","gloss":"she will not rest"},{"text":"ஏ","lemma":"ē","gloss":"emphatic particle"}],"gloss":"she does not rest her hands"}]},{"words":[{"surface":"உயர்மருப்பு","parts":[{"text":"உயர்","lemma":"uyar","gloss":"high/tall"},{"text":"மருப்பு","lemma":"maruppu","gloss":"tusk"}],"gloss":"high tusks"},{"surface":"யானை","parts":[{"text":"யானை","lemma":"yāṉai","gloss":"elephant"}],"gloss":"elephant"},{"surface":"புகர்முகத்து","parts":[{"text":"புகர்முகத்து","lemma":"புகர்முகத்து","gloss":"on the spotted face"}],"gloss":"on the spotted face","split_unverified":true},{"surface":"அணிந்த","parts":[{"text":"அணிந்த","lemma":"aṇinta","gloss":"adorned"}],"gloss":"adorned"}]},{"words":[{"surface":"பொலம்","parts":[{"text":"பொலம்","lemma":"polam","gloss":"gold"}],"gloss":"gold"},{"surface":"…","parts":[{"text":"…","lemma":"…","gloss":"gap"}],"gloss":"gap"}]},{"words":[{"surface":"பரிசில்","parts":[{"text":"பரிசில்","lemma":"paricil","gloss":"gifts"}],"gloss":"gifts"},{"surface":"பரிசிலர்க்கு","parts":[{"text":"பரிசிலர்","lemma":"paricilar","gloss":"gift-seekers"},{"text":"க்கு","lemma":"kku","gloss":"to"}],"gloss":"to the gift-seekers"},{"surface":"ஈய","parts":[{"text":"ஈய","lemma":"īya","gloss":"to give"}],"gloss":"to give"}]},{"words":[{"surface":"உரவேல்","parts":[{"text":"உரம்","lemma":"uram","gloss":"strength"},{"text":"வேல்","lemma":"vēl","gloss":"spear"}],"gloss":"strong spear"},{"surface":"காளையும்","parts":[{"text":"காளை","lemma":"kāḷai","gloss":"young warrior"},{"text":"உம்","lemma":"um","gloss":"and/too"}],"gloss":"the young warrior too"},{"surface":"கைதூவானே","parts":[{"text":"கை","lemma":"kai","gloss":"hand"},{"text":"தூவான்","lemma":"tūvāṉ","gloss":"he will not rest"},{"text":"ஏ","lemma":"ē","gloss":"emphatic particle"}],"gloss":"does not rest his hands"}]}],"literal":"Like the kaṇpu grass of the kākaru fields / the short-legged, long-eared, small hare with pure fur / at the shouting of the sparse-haired children in the common ground / will shrink and hide in the backyard garden … afterwards … / … in the town, the housewife / to feed the bards and to cherish the gift-seekers / with the sound of eating and noise, does not rest her hands / adorned on the spotted face of the elephant with high tusks / golden … / to give gifts to the gift-seekers / the young warrior with the strong spear too does not rest his hands.","translation":"The small hare with pure fur, short legs, and long ears, resembling the kaṇpu grass of the kākaru fields, shrinks and hides in the backyard garden when the sparse-haired children shout in the common ground. In that town, the housewife never rests her hands, busy preparing food amidst the bustling noise to feed the bards and cherish the guests. Likewise, the young warrior with the strong spear never rests his hands, constantly giving away gifts, such as the golden ornaments adorned on the spotted faces of high-tusked elephants, to those who seek them.","modern":"காகரு வயல்களின் கண்புப் புல்லைப் போன்ற தூய்மையான முடிகளையும், குட்டையான கால்களையும், நீண்ட காதுகளையும் உடைய சிறிய முயல், பொதுமன்றத்தில் மெல்லிய தலைமுடியைக் கொண்ட சிறுவர்கள் ஆரவாரம் செய்யும்போது, வீட்டுப் பின்புறத் தோட்டத்தில் போய் ஒடுங்கி மறைந்து கொள்ளும். அத்தகைய ஊரில் வாழும் இல்லத்தரசி, பாணர்களுக்கு உணவளிக்கவும் பரிசிலர்களை உபசரிக்கவும் உணவு சமைக்கும் ஒலியோடும் ஆரவாரத்தோடும் தன் கைகளுக்கு ஓய்வில்லாமல் உழைக்கிறாள். அதேபோல, உயர்ந்த தந்தங்களை உடைய யானைகளின் புள்ளிகள் பொருந்திய முகத்தில் அணிவிக்கப்பட்ட பொன்னாலான அணிகலன்களைப் பரிசிலர்களுக்குக் கொடையாக வழங்குவதில், வலிமையான வேலை ஏந்திய அந்த இளங்காளையும் தன் கைகளுக்கு ஓய்வில்லாமல் கொடுத்துக்கொண்டே இருக்கிறான்.","explanation":"This poem belongs to the Vākai tiṇai (victory/heroism) and the theme of Mūtiṉ mullai (the valor of an ancient martial family). The poet, Madurai Tamila Kūttaṉār, praises both the domestic generosity of the housewife and the martial generosity of her husband, the warrior. The poem opens with a vivid description of a small, soft hare hiding in the backyard garden when startled by the shouts of children playing in the common ground, illustrating the peaceful yet lively nature of their settlement. Inside the home, the housewife's hands are never still as she constantly prepares food to feed visiting bards and guests. Outside, her husband, a brave warrior with a strong spear, is equally tireless, constantly distributing rich spoils of war, such as golden ornaments taken from enemy elephants, to needy suppliants. Through these parallel descriptions of tireless hands, the poet highlights the noble virtues of hospitality and charity that define this heroic household.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.5],[0.6,1.0],[1.09,1.3],[1.3,1.48],[1.6,2.54],[2.54,2.7],[2.7,3.33],[3.6,4.0],[4.0,5.2],[5.2,5.5],[5.5,5.9],[5.9,6.4],[6.4,7.78],[7.78,8.0],[8.0,8.5],[8.5,9.4],[9.4,10.0],[10.0,10.25],[10.25,11.4],[11.4,11.96],[12.01,12.4],[12.4,13.2],[13.2,13.6],[13.6,14.2],[14.4,14.8],[14.8,15.6],[15.6,16.0],[16.0,16.6],[16.6,16.8],[17.8,18.28],[18.28,18.4],[18.4,18.6],[18.6,19.1],[19.1,19.5],[19.5,19.85],[19.97,20.8],[20.8,21.1],[21.2,21.5]],"female":[[0.0,0.7],[0.7,1.2],[1.31,1.6],[1.6,1.9],[1.9,3.04],[3.04,3.2],[3.2,4.31],[4.31,5.0],[5.0,6.3],[6.3,6.6],[6.6,7.0],[7.0,7.5],[8.1,8.7],[8.7,9.0],[9.3,9.7],[10.1,10.3],[10.3,12.3],[12.3,12.36],[12.36,12.9],[12.9,13.5],[13.56,14.0],[14.0,14.0],[14.0,15.44],[15.44,16.5],[16.6,16.8],[17.0,18.5],[18.5,19.0],[19.0,19.7],[19.7,19.9],[20.92,21.38],[21.49,21.72],[21.72,21.82],[21.82,22.62],[22.62,23.02],[23.02,23.37],[23.49,24.32],[24.32,24.69],[24.69,24.99]]},"sync":[[["காகரு","kākaru grass"]],[["பழன","of the agricultural field"]],[["கண்பின்","like the kaṇpu grass"]],[["அன்ன","resembling"]],[["தூமயிர்","pure fur"]],[["குறுந்தாள்","short legs"]],[["நெடுஞ்செவி","long ears"],["குறுமுயல்","small hare"]],[["குறுமுயல்","small hare"]],[["புன்றலை","sparse-haired head"]],[["சிறாஅர்","children"]],[["மன்றத்து","in the common ground"]],[["ஆர்ப்பின்","at the shouting"]],[["படப்பு","backyard garden"],["ஒடுங்கும்மே","will shrink and hide"]],[["ஒடுங்கும்மே","will shrink and hide"]],[["பின்பு","afterwards"]],[["ஊரே","in the town"]],[["மனையோள்","the housewife"]],[["பாணர்","bards"]],[["ஆர்த்தவும்","to feed"]],[["பரிசிலர்","gift-seekers"]],[["ஓம்பவும்","to cherish"]],[["ஊணொலி","sound of food preparation"]],[["அரவமொடு","with the noise"]],[["கைதூவாளே","she does not rest her hands"]],[["கைதூவாளே","she does not rest her hands"]],[["உயர்மருப்பு","high tusks"]],[["யானை","elephant"]],[["புகர்முகத்து","on the spotted face"]],[["அணிந்த","adorned"]],[["பொலம்","gold"]],[],[["பரிசில்","gifts"]],[["பரிசிலர்க்கு","to the gift-seekers"]],[["ஈய","to give"]],[["உரவேல்","strong spear"]],[["காளையும்","the young warrior too"]],[["கைதூவானே","does not rest his hands"]],[["கைதூவானே","does not rest his hands"]]]}