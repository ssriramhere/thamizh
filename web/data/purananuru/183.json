:[{"text":"உள்","lemma":"உள்","gloss":"inside/among"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"even among"}]},{"words":[{"surface":"மூத்தோன்","parts":[{"text":"மூத்து","lemma":"மூத்து","gloss":"having aged"},{"text":"ஓன்","lemma":"ஓன்","gloss":"he who"}],"gloss":"the eldest son"},{"surface":"வருக","parts":[{"text":"வரு","lemma":"வரு","gloss":"come"},{"text":"க","lemma":"க","gloss":"optative suffix"}],"gloss":"let him come"},{"surface":"என்னாது","parts":[{"text":"என்","lemma":"என்","gloss":"say"},{"text":"ஆது","lemma":"ஆது","gloss":"without"}],"gloss":"without saying"},{"surface":"அவருள்","parts":[{"text":"அவர்","lemma":"அவர்","gloss":"they"},{"text":"உள்","lemma":"உள்","gloss":"among"}],"gloss":"among them"}]},{"words":[{"surface":"அறிவுடையோன்","parts":[{"text":"அறிவு","lemma":"அறிவு","gloss":"knowledge"},{"text":"உடை","lemma":"உடை","gloss":"possess"},{"text":"ஓன்","lemma":"ஓன்","gloss":"he who"}],"gloss":"the wise one"},{"surface":"ஆறு","parts":[{"text":"ஆறு","lemma":"ஆறு","gloss":"way/path"}],"gloss":"way"},{"surface":"அரசும்","parts":[{"text":"அரசு","lemma":"அரசு","gloss":"king/government"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"even the king"},{"surface":"செல்லும்","parts":[{"text":"செல்","lemma":"செல்","gloss":"go"},{"text":"உம்","lemma":"உம்","gloss":"will"}],"gloss":"will go"}]},{"words":[{"surface":"வேற்றுமை","parts":[{"text":"வேற்றுமை","lemma":"வேற்றுமை","gloss":"difference/division"}],"gloss":"difference/division","split_unverified":true},{"surface":"தெரிந்த","parts":[{"text":"தெரி","lemma":"தெரி","gloss":"know/distinguish"},{"text":"ந்த","lemma":"ந்த","gloss":"past relative participle suffix"}],"gloss":"distinguished"},{"surface":"நாற்பால்","parts":[{"text":"நால்","lemma":"நால்","gloss":"four"},{"text":"பால்","lemma":"பால்","gloss":"class/division"}],"gloss":"four classes"},{"surface":"உள்ளும்","parts":[{"text":"உள்","lemma":"உள்","gloss":"inside/among"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"even among"}]},{"words":[{"surface":"கீழ்ப்பால்","parts":[{"text":"கீழ்","lemma":"கீழ்","gloss":"lower"},{"text":"பால்","lemma":"பால்","gloss":"class/division"}],"gloss":"lower class"},{"surface":"ஒருவன்","parts":[{"text":"ஒரு","lemma":"ஒரு","gloss":"one"},{"text":"அன்","lemma":"அன்","gloss":"masculine suffix"}],"gloss":"one person"},{"surface":"கற்பின்","parts":[{"text":"கல்","lemma":"கல்","gloss":"learn"},{"text":"பின்","lemma":"பின்","gloss":"if"}],"gloss":"if he learns"}]},{"words":[{"surface":"மேற்பால்","parts":[{"text":"மேல்","lemma":"மேல்","gloss":"higher"},{"text":"பால்","lemma":"பால்","gloss":"class/division"}],"gloss":"higher class"},{"surface":"ஒருவனும்","parts":[{"text":"ஒருவன்","lemma":"ஒருவன்","gloss":"one person"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"even a person of"},{"surface":"அவன்கண்","parts":[{"text":"அவன்","lemma":"அவன்","gloss":"him"},{"text":"கண்","lemma":"கண்","gloss":"locative/with"}],"gloss":"with him / under him"},{"surface":"படுமே","parts":[{"text":"படு","lemma":"படு","gloss":"fall/submit"},{"text":"உம்","lemma":"உம்","gloss":"will"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"will submit indeed"}]}],"literal":"Helping at the time of distress and giving abundant wealth / without despising the submissive posture of a disciple, learning is good indeed. / Even among those born of the same womb, whose birth is identical, / because of the quality of excellence, even the mother's mind will change. / Even among many people born in one family, / without saying 'let the eldest come', among them, / the way of the wise one even the king will follow. / Even among the four classes distinguished by differences, / if one of the lower class learns, / even one of the higher class will submit to him.","translation":"It is good to learn, by helping the teacher in times of distress, by giving abundant wealth, and by serving submissively without any resentment. Even among siblings born of the same womb with identical births, a mother's heart will lean towards the one who excels in learning. Among the many born in a single family, the king will not summon the eldest, but will follow the path of the one who is wise. Even among the four distinct classes of society, if a person of the lower class is educated, even a person of the higher class will bow to him.","modern":"ஆபத்துக் காலத்தில் உதவியும், மிகுந்த பொருளைக் கொடுத்தும், பணிவான நிலையை வெறுக்காமல் கல்வி கற்பது மிகவும் நல்லது. ஒரே வயிற்றில் பிறந்த உடன்பிறப்புகளுக்குள் கூட, சிறப்பான அறிவுடைய பிள்ளையின் பக்கமே தாயின் மனமும் சாயும். ஒரே குடும்பத்தில் பிறந்த பலருள், 'மூத்தவன் வரட்டும்' என்று கூறாமல், அறிவுடையவனின் வழியையே அரசனும் பின்பற்றுவான். வேறுபாடுகள் தெரிந்த நான்கு பிரிவுகளுக்குள்ளும், கீழான பிரிவைச் சேர்ந்த ஒருவன் கல்வி கற்றால், மேலான பிரிவைச் சேர்ந்தவனும் அவனிடம் பணிந்து போவான்.","explanation":"This poem is composed by the Pandya king Āriyap paṭai kaṭanta Neṭuñceḻiyaṉ, belonging to the Potuviyal tiṇai and Poruṇmoḻik kāñci tuṟai, which offers timeless moral guidance. The king addresses his subjects, emphasizing that education is the ultimate equalizer that transcends birth, age, and social hierarchy. He illustrates this with three powerful examples: a mother's love, royal governance, and social structure. Even a mother favors her educated child over others born of her same womb. Similarly, a king bypasses the traditional privilege of the eldest son to seek the counsel of the wisest sibling. Finally, the poet boldly asserts that if a person from a lower social division acquires learning, even those from the highest division will bow to him.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,1.1],[1.1,1.5],[1.5,1.8],[1.8,3.2],[3.2,3.3],[3.3,3.8],[3.8,4.2],[4.2,5.3],[5.3,5.6],[5.6,5.6],[5.6,6.4],[6.4,6.8],[6.8,7.7],[7.7,7.9],[7.9,8.1],[8.1,8.6],[8.6,8.9],[8.9,10.2],[10.2,10.4],[10.4,10.71],[10.71,11.2],[11.2,12.2],[12.2,12.3],[12.3,12.5],[12.5,13.1],[13.1,14.05],[14.05,14.6],[14.6,14.7],[14.7,15.1],[15.1,15.6],[15.6,16.9],[16.9,17.1],[17.1,17.4],[17.44,17.7],[18.68,19.38],[19.38,19.48],[19.48,19.78],[19.78,20.18],[20.18,21.28],[21.28,21.38],[21.38,21.88]],"female":[[0.0,0.8],[0.8,1.2],[1.2,1.6],[1.6,1.9],[1.9,3.6],[3.6,3.9],[3.9,4.7],[4.7,5.1],[5.1,6.6],[6.6,6.9],[6.9,6.9],[6.9,8.0],[8.0,8.3],[8.3,9.5],[9.5,9.8],[9.8,10.1],[10.1,10.6],[10.6,10.9],[10.9,12.6],[12.6,12.8],[12.8,13.18],[13.18,13.8],[13.8,15.2],[15.2,15.2],[15.2,15.6],[15.6,16.2],[16.2,17.41],[17.41,18.1],[18.1,18.2],[18.2,18.6],[18.6,19.1],[19.1,20.4],[20.4,20.6],[20.6,21.0],[21.06,21.4],[22.44,23.14],[23.14,23.14],[23.14,23.54],[23.54,24.04],[24.04,25.44],[25.44,25.54],[25.54,26.14]]}}