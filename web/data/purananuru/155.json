{"text":"purananuru","n":155,"lines":["வணர் கோட்டுச் சீறியாழ் வாடுபுடைத் தழீஇ","`உணர்வோர் யார் என் இடும்பை தீர்க்க``எனக்","கிளக்கும் பாண கேள் இனி நயத்தின்","பாழ்ஊர் நெருஞ்சிப் பசலை வான்பூ","ஏர்தரு சுடரின் எதிர்கொண்டு ஆஅங்கு","இலம்படு புலவர் மண்டை விளங்கு புகழ்க்","கொண்பெருங்காலத்துக் கிழவன்","தண்தார் அகலம் நோக்கின் மலர்ந்தே"],"tr":["vaṇar kōṭṭuc cīṟiyāḻ vāṭupuṭait taḻīi","uṇarvōr yār eṉ iṭumpai tīrkkaeṉak","kiḷakkum pāṇa kēḷ iṉi nayattiṉ","pāḻūr neruñcip pacalai vāṉpū","ērtaru cuṭariṉ etirkoṇṭu āaṅku","ilampaṭu pulavar maṇṭai viḷaṅku pukaḻk","koṇperuṅkālattuk kiḻavaṉ","taṇtār akalam nōkkiṉ malarntē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"பாணாற்றுப்படை","poet_ta":"மோசி கீரனார்","addressed_ta":"கொண்கானங் கிழான்","poet_tr":"Mōci Kīraṉār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"8×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 13, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வணர்கோட்டுச்","tr":"vaṇarkōṭṭuc","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"வணர்","tr":"vaṇar"},{"kind":"nēr","text":"கோட்","tr":"kōṭ"},{"kind":"nēr","text":"டுச்","tr":"ṭuc"}]},{"text":"சீறியாழ்","tr":"cīṟiyāḻ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சீ","tr":"cī"},{"kind":"nirai","text":"றியாழ்","tr":"ṟiyāḻ"}]},{"text":"வாடுபுடைத்","tr":"vāṭupuṭait","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nirai","text":"டுபு","tr":"ṭupu"},{"kind":"nēr","text":"டைத்","tr":"ṭait"}]},{"text":"தழீஇ","tr":"taḻīi","foot":"puḷimā","acai":[{"kind":"nirai","text":"தழீ","tr":"taḻī"},{"kind":"nēr","text":"இ","tr":"i"}]}],[{"text":"யுணர்வோர்","tr":"yuṇarvōr","foot":"puḷimā","acai":[{"kind":"nirai","text":"யுணர்","tr":"yuṇar"},{"kind":"nēr","text":"வோர்","tr":"vōr"}]},{"text":"யாரென்","tr":"yāreṉ","foot":"