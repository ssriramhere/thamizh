{"text":"purananuru","n":155,"lines":["வணர் கோட்டுச் சீறியாழ் வாடுபுடைத் தழீஇ","உணர்வோர் யார் என் இடும்பை தீர்க்கஎனக்","கிளக்கும் பாண கேள் இனி நயத்தின்","பாழ்ஊர் நெருஞ்சிப் பசலை வான்பூ","ஏர்தரு சுடரின் எதிர்கொண்டு ஆஅங்கு","இலம்படு புலவர் மண்டை விளங்கு புகழ்க்","கொண்பெருங்காலத்துக் கிழவன்","தண்தார் அகலம் நோக்கின் மலர்ந்தே"],"tr":["vaṇar kōṭṭuc cīṟiyāḻ vāṭupuṭait taḻīi","uṇarvōr yār eṉ iṭumpai tīrkkaeṉak","kiḷakkum pāṇa kēḷ iṉi nayattiṉ","pāḻūr neruñcip pacalai vāṉpū","ērtaru cuṭariṉ etirkoṇṭu āaṅku","ilampaṭu pulavar maṇṭai viḷaṅku pukaḻk","koṇperuṅkālattuk kiḻavaṉ","taṇtār akalam nōkkiṉ malarntē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"பாணாற்றுப்படை","poet_ta":"மோசி கீரனார்","addressed_ta":"கொண்கானங் கிழான்","poet_tr":"Mōci Kīraṉār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"8×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 13, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வணர்கோட்டுச்","tr":"vaṇarkōṭṭuc","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"வணர்","tr":"vaṇar"},{"kind":"nēr","text":"கோட்","tr":"kōṭ"},{"kind":"nēr","text":"டுச்","tr":"ṭuc"}]},{"text":"சீறியாழ்","tr":"cīṟiyāḻ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சீ","tr":"cī"},{"kind":"nirai","text":"றியாழ்","tr":"ṟiyāḻ"}]},{"text":"வாடுபுடைத்","tr":"vāṭupuṭait","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nirai","text":"டுபு","tr":"ṭupu"},{"kind":"nēr","text":"டைத்","tr":"ṭait"}]},{"text":"தழீஇ","tr":"taḻīi","foot":"puḷimā","acai":[{"kind":"nirai","text":"தழீ","tr":"taḻī"},{"kind":"nēr","text":"இ","tr":"i"}]}],[{"text":"யுணர்வோர்","tr":"yuṇarvōr","foot":"puḷimā","acai":[{"kind":"nirai","text":"யுணர்","tr":"yuṇar"},{"kind":"nēr","text":"வோர்","tr":"vōr"}]},{"text":"யாரென்","tr":"yāreṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"ரென்","tr":"reṉ"}]},{"text":"னிடும்பை","tr":"ṉiṭumpai","foot":"puḷimā","acai":[{"kind":"nirai","text":"னிடும்","tr":"ṉiṭum"},{"kind":"nēr","text":"பை","tr":"pai"}]},{"text":"தீர்க்கவெனக்","tr":"tīrkkaveṉak","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"தீர்க்","tr":"tīrk"},{"kind":"nirai","text":"கவெ","tr":"kave"},{"kind":"nēr","text":"னக்","tr":"ṉak"}]}],[{"text":"கிளக்கும்","tr":"kiḷakkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிளக்","tr":"kiḷak"},{"kind":"nēr","text":"கும்","tr":"kum"}]},{"text":"பாண","tr":"pāṇa","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"ண","tr":"ṇa"}]},{"text":"கேளினி","tr":"kēḷiṉi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கே","tr":"kē"},{"kind":"nirai","text":"ளினி","tr":"ḷiṉi"}]},{"text":"நயத்தின்","tr":"nayattiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"நயத்","tr":"nayat"},{"kind":"nēr","text":"தின்","tr":"tiṉ"}]}],[{"text":"பாழூர்","tr":"pāḻūr","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"ழூர்","tr":"ḻūr"}]},{"text":"நெருஞ்சிப்","tr":"neruñcip","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெருஞ்","tr":"neruñ"},{"kind":"nēr","text":"சிப்","tr":"cip"}]},{"text":"பசலை","tr":"pacalai","foot":"puḷimā","acai":[{"kind":"nirai","text":"பச","tr":"paca"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"வான்பூ","tr":"vāṉpū","foot":"tēmā","acai":[{"kind":"nēr","text":"வான்","tr":"vāṉ"},{"kind":"nēr","text":"பூ","tr":"pū"}]}],[{"text":"வேர்தரு","tr":"vērtaru","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வேர்","tr":"vēr"},{"kind":"nirai","text":"தரு","tr":"taru"}]},{"text":"சுடரி","tr":"cuṭari","foot":"puḷimā","acai":[{"kind":"nirai","text":"சுட","tr":"cuṭa"},{"kind":"nēr","text":"ரி","tr":"ri"}]},{"text":"னெதிர்கொண்","tr":"ṉetirkoṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"னெதிர்","tr":"ṉetir"},{"kind":"nēr","text":"கொண்","tr":"koṇ"}]},{"text":"டாஅங்","tr":"ṭāaṅ","foot":"tē