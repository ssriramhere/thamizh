oss":"frame"}],"gloss":"of the frame"},{"surface":"சீறியாழ்","parts":[{"text":"சீறியாழ்","lemma":"cīṟiyāḻ","gloss":"small lute"}],"gloss":"small lute"},{"surface":"வாடுபுடைத்","parts":[{"text":"வாடுபுடைத்","lemma":"vāṭupuṭai","gloss":"faded side"}],"gloss":"faded side"},{"surface":"தழீஇ","parts":[{"text":"தழீஇ","lemma":"taḻīi","gloss":"embracing"}],"gloss":"embracing"}]},{"words":[{"surface":"உணர்வோர்","parts":[{"text":"உணர்வோர்","lemma":"uṇarvōr","gloss":"those who understand"}],"gloss":"those who understand"},{"surface":"யார்","parts":[{"text":"யார்","lemma":"yār","gloss":"who"}],"gloss":"who"},{"surface":"என்","parts":[{"text":"என்","lemma":"eṉ","gloss":"my"}],"gloss":"my"},{"surface":"இடும்பை","parts":[{"text":"இடும்பை","lemma":"iṭumpai","gloss":"suffering"}],"gloss":"suffering"},{"surface":"தீர்க்க","parts":[{"text":"தீர்க்க","lemma":"tīrkka","gloss":"to resolve"}],"gloss":"to resolve"},{"surface":"எனக்","parts":[{"text":"எனக்","lemma":"eṉa","gloss":"saying"}],"gloss":"saying"}]},{"words":[{"surface":"கிளக்கும்","parts":[{"text":"கிளக்கும்","lemma":"kiḷakkum","gloss":"speaking"}],"gloss":"speaking"},{"surface":"பாண","parts":[{"text":"பாண","lemma":"pāṇa","gloss":"O bard"}],"gloss":"O bard"},{"surface":"கேள்","parts":[{"text":"கேள்","lemma":"kēḷ","gloss":"listen"}],"gloss":"listen"},{"surface":"இனி","parts":[{"text":"இனி","lemma":"iṉi","gloss":"now"}],"gloss":"now"},{"surface":"நயத்தின்","parts":[{"text":"நயத்தின்","lemma":"nayam","gloss":"with desire"}],"gloss":"with desire"}]},{"words":[{"surface":"பாழ்","parts":[{"text":"பாழ்","lemma":"pāḻ","gloss":"desolate"}],"gloss":"desolate"},{"surface":"ஊர்","parts":[{"text":"ஊர்","lemma":"ūr","gloss":"village"}],"gloss":"village"},{"surface":"நெருஞ்சிப்","parts":[{"text":"நெருஞ்சிப்","lemma":"neruñci","gloss":"puncture-vine"}],"gloss":"puncture-vine"},{"surface":"பசலை","parts":[{"text":"பசலை","lemma":"pacalai","gloss":"yellow"}],"gloss":"yellow"},{"surface":"வான்பூ","parts":[{"text":"வான்பூ","lemma":"vāṉpū","gloss":"bright flower"}],"gloss":"bright flower"}]},{"words":[{"surface":"ஏர்தரு","parts":[{"text":"ஏர்தரு","lemma":"ērtaru","gloss":"rising"}],"gloss":"rising"},{"surface":"சுடரின்","parts":[{"text":"சுடரின்","lemma":"cuṭar","gloss":"sun"}],"gloss":"sun"},{"surface":"எதிர்கொண்டு","parts":[{"text":"எதிர்கொண்டு","lemma":"etirkoṇṭu","gloss":"facing"}],"gloss":"facing"},{"surface":"ஆஅங்கு","parts":[{"text":"ஆஅங்கு","lemma":"āṅku","gloss":"just like that"}],"gloss":"just like that"}]},{"words":[{"surface":"இலம்படு","parts":[{"text":"இலம்படு","lemma":"ilampaṭu","gloss":"impoverished"}],"gloss":"impoverished"},{"surface":"புலவர்","parts":[{"text":"புலவர்","lemma":"pulavar","gloss":"poets"}],"gloss":"poets"},{"surface":"மண்டை","parts":[{"text":"மண்டை","lemma":"maṇṭai","gloss":"begging bowl"}],"gloss":"begging bowl"},{"surface":"விளங்கு","parts":[{"text":"விளங்கு","lemma":"viḷaṅku","gloss":"shining"}],"gloss":"shining"},{"surface":"புகழ்க்","parts":[{"text":"புகழ்க்","lemma":"pukaḻ","gloss":"fame"}],"gloss":"fame"}]},{"words":[{"surface":"கொண்பெருங்காலத்துக்","parts":[{"text":"கொண்பெருங்காலத்துக்","lemma":"koṇperuṅkāṉam","gloss":"of the great Konkaṉam region"}],"gloss":"of the great Konkaṉam region"},{"surface":"கிழவன்","parts":[{"text":"கிழவன்","lemma":"kiḻavaṉ","gloss":"lord"}],"gloss":"lord"}]},{"words":[{"surface":"தண்தார்","parts":[{"text":"தண்தார்","lemma":"taṇṭār","gloss":"cool garland"}],"gloss":"cool garland"},{"surface":"அகலம்","parts":[{"text":"அகலம்","lemma":"akalam","gloss":"chest"}],"gloss":"chest"},{"surface":"நோக்கின்","parts":[{"text":"நோக்கின்","lemma":"nōkkiṉ","gloss":"if looked at"}],"gloss":"if looked at"},{"surface":"மலர்ந்தே","parts":[{"text":"மலர்ந்தே","lemma":"malarntē","gloss":"blooming indeed"}],"gloss":"blooming indeed"}]}],"literal":"Embracing the faded side of the small lute with a curved frame, / saying, \"Who is there that understands to resolve my suffering?\" / O bard who speaks thus, listen now with desire! / The bright yellow flower of the puncture-vine in a desolate village, / just like it faces the rising sun, / the begging bowls of impoverished poets, and his shining fame, / the lord of the great Konkaṉam region, / if you look at his chest wearing a cool garland, they will bloom indeed.","translation":"O bard, who embraces the worn side of your small, curved lute, asking, 'Who is there to understand and end my misery?' Listen now with hope: Just as the bright yellow flower of the puncture-vine in a desolate village turns to face the rising sun, the empty begging bowls of impoverished poets will bloom with joy if you but look upon the broad chest, adorned with cool garlands, of the lord of the great Konkaṉam hills, whose fame shines bright.","modern":"வளைந்த தண்டுடைய சிறிய யாழின் வாடிய பக்கத்தை அணைத்துக் கொண்டு, \"என் துன்பத்தைத் தீர்க்கக்கூடிய அறிவுடையவர் யார்?\" என்று கேட்கும் பாணனே, இப்போது அன்போடு கேட்பாயாக! பாழடைந்த ஊரில் உள்ள நெருஞ்சிச் செடியின் மஞ்சள் நிறப் பூவானது, மேலே எழும் சூரியனை நோக்கித் திரும்புவது போல, வறுமையுற்ற புலவர்களின் இரப்பக் கலன்களும், விளங்கும் புகழுடைய கொண்பெருங்கானத்துத் தலைவனுடைய குளிர்ந்த மாலை அணிந்த மார்பினை நோக்கினால் மகிழ்ச்சியால் மலரும்.","explanation":"The poet Mōci Kīraṉār is addressing a poor bard who is wandering in deep distress, carrying his worn-out lute and wondering who will relieve his poverty. The poet guides the bard to Koṇkāṉaṅ Kiḻāṉ, the generous chieftain of the Konkaṉam region. He assures the bard that just as the yellow flower of the puncture-vine in a desolate wasteland turns to face the rising sun, the empty begging bowls of poor poets will instantly bloom with abundance upon seeing the chieftain's generous chest. The simile of the neruñci flower in a barren village facing the sun beautifully captures the transition from bleak despair to life-giving hope. The chieftain is compared to the sun, whose mere presence brings light and sustenance to those in the dark shadow of poverty.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.5],[0.5,0.85],[0.85,1.21],[1.21,1.65],[1.65,2.2],[2.2,3.1],[3.4,3.7],[3.7,3.9],[3.9,4.2],[4.2,4.8],[4.8,5.59],[5.59,5.9],[5.9,6.5],[6.5,6.7],[6.7,7.35],[7.35,7.86],[7.86,8.51],[8.51,8.9],[8.9,9.3],[9.3,9.96],[9.96,10.61],[10.61,11.6],[11.6,12.1],[12.1,12.72],[13.1,13.6],[13.6,13.8],[13.8,14.27],[14.27,14.73],[14.73,15.9],[16.1,16.3],[16.3,16.72],[16.72,17.15],[17.15,17.57],[17.57,18.1]],"female":[[0.0,0.3],[0.3,0.7],[0.7,1.1],[1.1,1.74],[1.74,2.12],[2.3,3.22],[3.4,3.8],[3.8,4.02],[4.02,4.45],[4.45,5.2],[5.2,6.0],[6.0,6.2],[6.2,6.8],[6.8,7.2],[7.2,7.92],[7.92,8.5],[8.5,9.0],[9.0,9.2],[9.2,9.5],[9.5,10.24],[10.24,10.99],[10.99,12.1],[12.1,12.6],[12.6,13.35],[13.8,14.3],[14.3,14.6],[14.6,14.98],[14.98,15.36],[15.36,16.19],[16.19,16.53],[16.53,16.86],[16.86,17.0],[17.0,18.6],[18.6,18.8]]},"sync":[[["வணர்","curved"]],[["கோட்டுச்","of the frame"]],[["சீறியாழ்","small lute"]],[["வாடுபுடைத்","faded side"]],[["தழீஇ","embracing"]],[["உணர்வோர்","those who understand"]],[["யார்","who"]],[["என்","my"]],[["இடும்பை","suffering"]],[["தீர்க்க","to resolve"],["எனக்","saying"]],[["கிளக்கும்","speaking"]],[["பாண","O bard"]],[["கேள்","listen"]],[["இனி","now"]],[["நயத்தின்","with desire"]],[["பாழ்","desolate"],["ஊர்","village"]],[["நெருஞ்சிப்","puncture-vine"]],[["பசலை","yellow"]],[["வான்பூ","bright flower"]],[["ஏர்தரு","rising"]],[["சுடரின்","sun"]],[["எதிர்கொண்டு","facing"]],[["ஆஅங்கு","just like that"]],[["இலம்படு","impoverished"]],[["புலவர்","poets"]],[["மண்டை","begging bowl"]],[["விளங்கு","shining"]],[["புகழ்க்","fame"]],[["கொண்பெருங்காலத்துக்","of the great Konkaṉam region"]],[["கிழவன்","lord"]],[["தண்தார்","cool garland"]],[["அகலம்","chest"]],[["நோக்கின்","if looked at"]],[["மலர்ந்தே","blooming indeed"]]]}