{"text":"purananuru","n":312,"lines":["ஈன்று புறந்தருதல் என்தலைக் கடனே","சான்றோன் ஆக்குதல் தந்தைக்குக் கடனே","வேல்வடித்துக் கொடுத்தல் கொல்லற்குக் கடனே","நன்னடை நல்கல் வேந்தற்குக் கடனே","ஒளிறுவாள் அருஞ்சமம் முருக்கிக்","களிறுஎறிந்து பெயர்தல் காளைக்குக் கடனே"],"tr":["īṉṟu puṟantarutal eṉtalaik kaṭaṉē","cāṉṟōṉ ākkutal tantaikkuk kaṭaṉē","vēlvaṭittuk koṭuttal kollaṟkuk kaṭaṉē","naṉṉaṭai nalkal vēntaṟkuk kaṭaṉē","oḷiṟuvāḷ aruñcamam murukkik","kaḷiṟueṟintu peyartal kāḷaikkuk kaṭaṉē"],"colophon":{},"scan":{"meter":"not a regular āciriyappā","ok":false,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"6×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 6"},{"name":"linkage","ok":false,"detail":"āciriyattaḷai 12, kalittaḷai 6, veṇṭaḷai 5"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஈன்று","tr":"īṉṟu","foot":"tēmā","acai":[{"kind":"nēr","text":"ஈன்","tr":"īṉ"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"புறந்தரு","tr":"puṟantaru","foot":"karuviḷam","acai":[{"kind":"nirai","text":"புறந்","tr":"puṟan"},{"kind":"nirai","text":"தரு","tr":"taru"}]},{"text":"தலென்தலைக்","tr":"taleṉtalaik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தலென்","tr":"taleṉ"},{"kind":"nirai","text":"தலைக்","tr":"talaik"}]},{"text":"கடனே","tr":"kaṭaṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"கட","tr":"kaṭa"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}],[{"text":"சான்றோ","tr":"cāṉṟō","foot":"tēmā","acai":[{"kind":"nēr","text":"சான்","tr":"cāṉ"},{"kind":"nēr","text":"றோ","tr":"ṟō"}]},{"text":"னாக்குதல்","tr":"ṉākkutal","foot":"kūviḷam","acai":[{"kind":"nēr","text":"னாக்","tr":"ṉāk"},{"kind":"nirai","text":"குதல்","tr":"kutal"}]},{"text":"தந்தைக்குக்","tr":"tantaikkuk","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"தந்","tr":"tan"},{"kind":"nēr","text":"தைக்","tr":"taik"},{"kind":"nēr","text":"குக்","tr":"kuk"}]},{"text":"கடனே","tr":"kaṭaṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":