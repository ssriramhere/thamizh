nirai","text":"றெறிந்","tr":"ṟeṟin"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"பெயர்தல்","tr":"peyartal","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெயர்","tr":"peyar"},{"kind":"nēr","text":"தல்","tr":"tal"}]},{"text":"காளைக்குக்","tr":"kāḷaikkuk","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"ளைக்","tr":"ḷaik"},{"kind":"nēr","text":"குக்","tr":"kuk"}]},{"text":"கடனே","tr":"kaṭaṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"கட","tr":"kaṭa"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"ஈன்று","parts":[{"text":"ஈன்று","lemma":"ஈனு","gloss":"having given birth"}],"gloss":"having given birth"},{"surface":"புறந்தருதல்","parts":[{"text":"புறம்","lemma":"புறம்","gloss":"outside/protection"},{"text":"தருதல்","lemma":"தருதல்","gloss":"giving/nurturing"}],"gloss":"nurturing"},{"surface":"என்தலைக்","parts":[{"text":"என்தலைக்","lemma":"என்தலைக்","gloss":"my foremost"}],"gloss":"my foremost","split_unverified":true},{"surface":"கடனே","parts":[{"text":"கடன்","lemma":"கடன்","gloss":"duty"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"duty indeed"}]},{"words":[{"surface":"சான்றோன்","parts":[{"text":"சான்றோன்","lemma":"சான்றோன்","gloss":"noble man"}],"gloss":"noble man"},{"surface":"ஆக்குதல்","parts":[{"text":"ஆக்குதல்","lemma":"ஆக்கு","gloss":"making"}],"gloss":"making"},{"surface":"தந்தைக்குக்","parts":[{"text":"தந்தைக்குக்","lemma":"தந்தைக்குக்","gloss":"to the father"}],"gloss":"to the father","split_unverified":true},{"surface":"கடனே","parts":[{"text":"கடன்","lemma":"கடன்","gloss":"duty"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"duty indeed"}]},{"words":[{"surface":"வேல்வடித்துக்","parts":[{"text":"வேல்வடித்துக்","lemma":"வேல்வடித்துக்","gloss":"having forged a spear"}],"gloss":"having forged a spear","split_unverified":true},{"surface":"கொடுத்தல்","parts":[{"text":"கொடுத்தல்","lemma":"கொடு","gloss":"giving"}],"gloss":"giving"},{"surface":"கொல்லற்குக்","parts":[{"text":"கொல்லற்குக்","lemma":"கொல்லற்குக்","gloss":"to the blacksmith"}],"gloss":"to the blacksmith","split_unverified":true},{"surface":"கடனே","parts":[{"text":"கடன்","lemma":"கடன்","gloss":"duty"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"duty indeed"}]},{"words":[{"surface":"நன்னடை","parts":[{"text":"நல்","lemma":"நல்","gloss":"good"},{"text":"நடை","lemma":"நடை","gloss":"conduct"}],"gloss":"good conduct"},{"surface":"நல்கல்","parts":[{"text":"நல்கல்","lemma":"நல்கு","gloss":"granting"}],"gloss":"granting"},{"surface":"வேந்தற்குக்","parts":[{"text":"வேந்தற்குக்","lemma":"வேந்தற்குக்","gloss":"to the king"}],"gloss":"to the king","split_unverified":true},{"surface":"கடனே","parts":[{"text":"கடன்","lemma":"கடன்","gloss":"duty"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"duty indeed"}]},{"words":[{"surface":"ஒளிறுவாள்","parts":[{"text":"ஒளிறு","lemma":"ஒளிறு","gloss":"shining"},{"text":"வாள்","lemma":"வாள்","gloss":"sword"}],"gloss":"shining sword"},{"surface":"அருஞ்சமம்","parts":[{"text":"அருஞ்சமம்","lemma":"அருஞ்சமம்","gloss":"difficult battle"}],"gloss":"difficult battle","split_unverified":true},{"surface":"முருக்கிக்","parts":[{"text":"முருக்கிக்","lemma":"முருக்கிக்","gloss":"having destroyed"}],"gloss":"having destroyed","split_unverified":true}]},{"words":[{"surface":"களிறுஎறிந்து","parts":[{"text":"களிறு","lemma":"களிறு","gloss":"male elephant"},{"text":"எறிந்து","lemma":"எறி","gloss":"having struck"}],"gloss":"having slain the war-elephant"},{"surface":"பெயர்தல்","parts":[{"text":"பெயர்தல்","lemma":"பெயர்","gloss":"returning"}],"gloss":"returning"},{"surface":"காளைக்குக்","parts":[{"text":"காளைக்குக்","lemma":"காளைக்குக்","gloss":"to the young man"}],"gloss":"to the young man","split_unverified":true},{"surface":"கடனே","parts":[{"text":"கடன்","lemma":"கடன்","gloss":"duty"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"duty indeed"}]}],"literal":"Having given birth and nurturing is my foremost duty. / Making him a noble man is the father's duty. / Forging and giving a spear is the blacksmith's duty. / Granting good conduct is the king's duty. / Destroying the difficult battle with a shining sword, / slaying the war-elephant and returning is the young man's duty.","translation":"To give birth and nurture him is my foremost duty. To make him a noble man of character is his father's duty. To forge and give him a sharp spear is the blacksmith's duty. To guide him in righteous conduct is the king's duty. To destroy the enemy in fierce battle with a shining sword, slay their war-elephant, and return victorious is the young man's duty.","modern":"பெற்று வளர்ப்பது என் தலையாய கடமையாகும். அவனைச் சான்றோனாக ஆக்குவது தந்தையின் கடமையாகும். அவனுக்கு வேல் வடித்துக் கொடுப்பது கொல்லனின் கடமையாகும். அவனுக்கு நன்னடத்தையை வழங்குவது அரசனின் கடமையாகும். ஒளிரும் வாளோடு கடினமான போர்க்களத்தில் பகைவரை அழித்து, யானையைக் கொன்று வெற்றி பெற்றுத் திரும்புவது காளையாகிய இளைஞனின் கடமையாகும்.","explanation":"This famous poem from the Purananuru anthology is attributed to the poet Ponmudiyar, speaking in the voice of a mother or wise elder. It outlines the interconnected social and personal duties of different individuals in a heroic society. The poem systematically divides responsibilities: the mother's duty is to birth and nurture, the father's is to educate, the blacksmith's is to arm, the king's is to civilize, and finally, the young warrior's duty is to fight bravely and return victorious. The imagery of the 'shining sword' and 'slaying the war-elephant' represents the ultimate test of manhood and bravery in the Puram landscape. The key word 'katane' (duty) is repeated at the end of almost every line, emphasizing the absolute nature of these societal roles.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,0.6],[0.6,1.4],[1.4,1.6],[1.6,3.0],[3.0,3.4],[3.4,3.5],[3.5,4.1],[4.1,5.3],[5.3,5.4],[5.4,6.0],[6.0,6.4],[6.4,6.9],[6.9,8.0],[8.0,8.6],[8.6,8.7],[8.7,9.8],[9.8,10.1],[10.1,10.6],[10.6,11.9],[11.9,12.1],[12.1,12.6],[12.6,13.2]],"female":[[0.0,0.7],[0.7,0.7],[0.7,1.6],[1.6,1.9],[1.9,3.4],[3.4,3.8],[3.8,3.9],[3.9,4.4],[4.4,5.8],[5.8,5.8],[5.8,6.5],[6.5,6.8],[6.8,7.4],[7.4,8.6],[8.6,9.2],[9.2,9.4],[9.4,9.4],[9.4,9.4],[9.4,9.4],[9.4,12.9],[12.9,13.2],[13.2,13.7],[13.7,14.2]]},"sync":[[["ஈன்று","having given birth"]],[["புறந்தருதல்","nurturing"]],[["என்தலைக்","my foremost"]],[["கடனே","duty indeed"]],[["சான்றோன்","noble man"]],[["ஆக்குதல்","making"]],[["தந்தைக்குக்","to the father"]],[["கடனே","duty indeed"]],[["வேல்வடித்துக்","having forged a spear"]],[["கொடுத்தல்","giving"]],[["கொல்லற்குக்","to the blacksmith"]],[["கடனே","duty indeed"]],[["நன்னடை","good conduct"]],[["நல்கல்","granting"]],[["வேந்தற்குக்","to the king"]],[["கடனே","duty indeed"]],[["ஒளிறுவாள்","shining sword"]],[["அருஞ்சமம்","difficult battle"]],[["முருக்கிக்","having destroyed"]],[["களிறுஎறிந்து","having slain the war-elephant"]],[["பெயர்தல்","returning"]],[["காளைக்குக்","to the young man"]],[["கடனே","duty indeed"]]]}