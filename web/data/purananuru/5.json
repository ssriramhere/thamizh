{"text":"purananuru","n":5,"lines":["எருமை அன்ன கருங்கல் இடை தோறு","ஆனிற் பரக்கும் யானைய முன்பின்","கானக நாடனை நீயோ பெரும","நீயோர் ஆகலின் நின் ஒன்று மொழிவல்","அருளும் அன்பும் நீக்கி நீங்கா","நிரயங் கொள்பவரொடு ஒன்றாது காவல்","குழவி கொள் பவரின் ஓம்புமதி","அளிதோ தானே அது பெறல்அருங் குரைத்தே"],"tr":["erumai aṉṉa karuṅkal iṭai tōṟu","āṉiṟ parakkum yāṉaiya muṉpiṉ","kāṉaka nāṭaṉai nīyō peruma","nīyōr ākaliṉ niṉ oṉṟu moḻival","aruḷum aṉpum nīkki nīṅkā","nirayaṅ koḷpavaroṭu oṉṟātu kāval","kuḻavi koḷ pavariṉ ōmpumati","aḷitō tāṉē atu peṟalaruṅ kuraittē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"வெவியறிவுறூஉ: பொருண் மொழிக் காஞ்சியும் ஆம்","poet_ta":"நரிவெரூஉத் தலையார்","addressed_ta":"சேரமான் கருவூரேறிய ஒள்வாட் கோப்பெருஞ் சேரல்","poet_tr":"Nariverūut Talaiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"8×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 31, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 16, āciriyattaḷai 15"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"எருமை","tr":"erumai","foot":"puḷimā","acai":[{"kind":"nirai","text":"எரு","tr":"eru"},{"kind":"nēr","text":"மை","tr":"mai"}]},{"text":"யன்ன","tr":"yaṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"யன்","tr":"yaṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"கருங்க","tr":"karuṅka","foot":"puḷimā","acai":[{"kind":"nirai","text":"கருங்","tr":"karuṅ"},{"kind":"nēr","text":"க","tr":"ka"}]},{"text":"லிடைதோ","tr":"liṭaitō","foot":"puḷimā","acai":[{"kind":"nirai","text":"லிடை","tr":"liṭai"},{"kind":"nēr","text":"தோ","tr":"tō"}]}],[{"text":"றானிற்","tr":"ṟāṉiṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"றா","tr":"ṟā"},{"kind":"nēr","text":"னிற்","tr":"ṉiṟ"}]},{"text":"பரக்கும்","tr":"parakkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"பரக்","tr":"parak"},{"kind":"nēr","text":"கும்","tr":"kum"}]},{"text":"யானை","tr":"yāṉai","foo