lemma":"iṭai","gloss":"middle/space"}],"gloss":"among/in the spaces of"},{"surface":"தோறு","parts":[{"text":"தோறு","lemma":"tōṟu","gloss":"every"}],"gloss":"every"}]},{"words":[{"surface":"ஆனின்","parts":[{"text":"ஆன்","lemma":"āṉ","gloss":"cow"},{"text":"இன்","lemma":"iṉ","gloss":"like/than"}],"gloss":"like cows"},{"surface":"பரக்கும்","parts":[{"text":"பரக்கு","lemma":"parakkum","gloss":"spread/roam"},{"text":"உம்","lemma":"um","gloss":"adjectival suffix"}],"gloss":"roaming"},{"surface":"யானைய","parts":[{"text":"யானை","lemma":"yāṉai","gloss":"elephant"},{"text":"அ","lemma":"a","gloss":"possessive suffix"}],"gloss":"having elephants"},{"surface":"முன்பின்","parts":[{"text":"முன்பு","lemma":"muṉpu","gloss":"strength"},{"text":"இன்","lemma":"iṉ","gloss":"with"}],"gloss":"with strength"}]},{"words":[{"surface":"கானக","parts":[{"text":"கானக","lemma":"கானக","gloss":"forest"}],"gloss":"forest","split_unverified":true},{"surface":"நாடனை","parts":[{"text":"நாடு","lemma":"nāṭu","gloss":"country"},{"text":"அன்","lemma":"aṉ","gloss":"he"},{"text":"ஐ","lemma":"ai","gloss":"accusative case marker"}],"gloss":"lord of the land"},{"surface":"நீயோ","parts":[{"text":"நீ","lemma":"nī","gloss":"you"},{"text":"ஓ","lemma":"ō","gloss":"emphasis/question"}],"gloss":"are you indeed?"},{"surface":"பெரும","parts":[{"text":"பெரும","lemma":"பெரும","gloss":"O Great Lord!"}],"gloss":"O Great Lord!","split_unverified":true}]},{"words":[{"surface":"நீயோர்","parts":[{"text":"நீ","lemma":"nī","gloss":"you"},{"text":"ஓர்","lemma":"ōr","gloss":"unique person"}],"gloss":"you are a unique person"},{"surface":"ஆகலின்","parts":[{"text":"ஆகலின்","lemma":"ஆகலின்","gloss":"therefore"}],"gloss":"therefore","split_unverified":true},{"surface":"நின்","parts":[{"text":"நின்","lemma":"நின்","gloss":"to you"}],"gloss":"to you","split_unverified":true},{"surface":"ஒன்று","parts":[{"text":"ஒன்று","lemma":"oṉṟu","gloss":"one thing"}],"gloss":"one thing"},{"surface":"மொழிவல்","parts":[{"text":"மொழி","lemma":"moḻi","gloss":"speak"},{"text":"வ்","lemma":"v","gloss":"future marker"},{"text":"அல்","lemma":"al","gloss":"first-person singular"}],"gloss":"I shall speak"}]},{"words":[{"surface":"அருளும்","parts":[{"text":"அருள்","lemma":"aruḷ","gloss":"grace"},{"text":"உம்","lemma":"um","gloss":"and"}],"gloss":"compassion too"},{"surface":"அன்பும்","parts":[{"text":"அன்பு","lemma":"aṉpu","gloss":"love"},{"text":"உம்","lemma":"um","gloss":"and"}],"gloss":"love too"},{"surface":"நீக்கி","parts":[{"text":"நீக்கு","lemma":"nīkku","gloss":"remove"},{"text":"இ","lemma":"i","gloss":"having done"}],"gloss":"having discarded"},{"surface":"நீங்கா","parts":[{"text":"நீங்கு","lemma":"nīṅgu","gloss":"leave"},{"text":"ஆ","lemma":"ā","gloss":"negative adjectival"}],"gloss":"never-leaving"}]},{"words":[{"surface":"நிரயம்","parts":[{"text":"நிரயம்","lemma":"nirayam","gloss":"hell"}],"gloss":"hell"},{"surface":"கொள்பவரொடு","parts":[{"text":"கொள்","lemma":"koḷ","gloss":"attain"},{"text":"பவர்","lemma":"pavar","gloss":"they who"},{"text":"ஒடு","lemma":"oṭu","gloss":"with"}],"gloss":"with those who attain"},{"surface":"ஒன்றாது","parts":[{"text":"ஒன்று","lemma":"oṉṟu","gloss":"unite"},{"text":"ஆது","lemma":"ātu","gloss":"without"}],"gloss":"without aligning"},{"surface":"காவல்","parts":[{"text":"காவல்","lemma":"kāval","gloss":"protection"}],"gloss":"the duty of protection"}]},{"words":[{"surface":"குழவி","parts":[{"text":"குழவி","lemma":"kuḻavi","gloss":"infant"}],"gloss":"an infant"},{"surface":"கொள்","parts":[{"text":"கொள்","lemma":"koḷ","gloss":"nurture"}],"gloss":"nurturing"},{"surface":"பவரின்","parts":[{"text":"பவர்","lemma":"pavar","gloss":"they who"},{"text":"இன்","lemma":"iṉ","gloss":"like"}],"gloss":"like those who"},{"surface":"ஓம்புமதி","parts":[{"text":"ஓம்பு","lemma":"ōmpu","gloss":"protect"},{"text":"மதி","lemma":"mati","gloss":"imperative suffix"}],"gloss":"please protect!"}]},{"words":[{"surface":"அளிதோ","parts":[{"text":"அளி","lemma":"aḷi","gloss":"pity/grace"},{"text":"து","lemma":"tu","gloss":"it"},{"text":"ஓ","lemma":"ō","gloss":"exclamatory"}],"gloss":"it is a matter of great pity!"},{"surface":"தானே","parts":[{"text":"தான்","lemma":"tāṉ","gloss":"indeed"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"indeed"},{"surface":"அது","parts":[{"text":"அது","lemma":"atu","gloss":"that"}],"gloss":"that"},{"surface":"பெறல்","parts":[{"text":"பெறு","lemma":"peṟu","gloss":"obtain"},{"text":"அல்","lemma":"al","gloss":"verbal noun"}],"gloss":"obtaining"},{"surface":"அருங்","parts":[{"text":"அருங்","lemma":"அருங்","gloss":"rare"}],"gloss":"rare","split_unverified":true},{"surface":"குரைத்தே","parts":[{"text":"குரை","lemma":"kurai","gloss":"nature particle"},{"text":"த்து","lemma":"ttu","gloss":"empty morph"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"indeed has the nature of"}]}],"literal":"Like buffaloes, among every black stone / roaming like cows, having elephants with strength, / are you the lord of the forest country, O Great One? / Since you are a unique person, I shall say one thing to you: / Discarding grace and love, without aligning with those who go to eternal hell, / protect your kingdom like those who nurture an infant! / It is indeed a matter of great preciousness; that state is rare to obtain.","translation":"O Great Lord of the forest country, where strong elephants roam like cows among black rocks that resemble buffaloes! Because you are a wise and unique ruler, I shall say one thing to you: Do not align yourself with those who, devoid of grace and love, are bound for eternal hell. Instead, guard your kingdom as tenderly as a mother nurtures her infant. To rule thus is a rare and precious thing, difficult to attain.","modern":"எருமைகளைப் போன்ற கரிய பாறைகளுக்கு இடையே, பசுக்களைப் போல வலிமை மிக்க யானைகள் கூட்டம் கூட்டமாகத் திரியும் காடுகள் நிறைந்த நாட்டின் தலைவனே, பெருமானே! நீ அறிவுடைய சான்றோனாக இருப்பதால் உனக்கு ஒரு அறிவுரையைக் கூறுவேன். அருளும் அன்பும் இல்லாமல், என்றும் நீங்காத நரகத்தை அடையும் தீயோருடன் சேராமல், உனது நாட்டை ஒரு குழந்தையை வளர்ப்பவரைப் போலப் பாதுகாப்பாயாக! அவ்வாறு நாட்டைப் பாதுகாக்கும் நற்பண்பைப் பெறுவது மிகவும் அரியது, அதுவே போற்றத்தக்கது.","explanation":"The poet Nariverūut Talaiyār addresses the Chera king Cēramāṉ Karuvūrēṟiya Oḷvāṭ Kōpperuñ Cēral in this poem of advice. He describes the king's mountainous forest country where mighty elephants roam peacefully like gentle cows among dark rocks that resemble buffaloes. The poet advises the king to shun the company of heartless rulers who lack love and compassion and are destined for hell. Instead, the king must protect his subjects with the same tender care that a nurse or mother shows to an infant. This central metaphor of protecting the kingdom like an infant highlights the delicate, selfless, and constant vigilance required of a righteous ruler.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,0.6],[0.6,0.9],[0.9,1.4],[1.4,1.5],[1.5,2.3],[2.3,2.4],[2.4,2.7],[2.7,3.1],[3.1,4.3],[4.3,4.7],[4.7,5.1],[5.1,5.3],[5.3,6.6],[6.6,6.6],[6.6,7.1],[7.1,7.4],[7.4,7.7],[7.7,8.9],[8.9,9.4],[9.4,9.8],[9.8,9.8],[9.8,11.1],[11.1,11.58],[11.7,12.3],[12.3,12.3],[12.3,13.4],[13.4,13.52],[13.52,13.7],[13.7,14.0],[14.0,15.2],[15.2,15.3],[15.3,15.6],[15.6,16.3],[16.3,16.62]],"female":[[0.0,0.7],[0.7,0.7],[0.7,1.1],[1.1,1.5],[1.5,1.8],[1.8,2.6],[2.6,2.8],[2.8,3.1],[3.1,3.6],[3.6,4.9],[4.9,5.4],[5.4,5.9],[5.9,6.0],[6.0,7.3],[7.3,7.4],[7.4,7.9],[7.9,8.1],[8.1,8.5],[8.5,9.8],[9.8,10.3],[10.3,10.8],[10.8,10.8],[10.8,12.0],[12.0,12.7],[12.7,13.3],[13.3,13.4],[13.4,14.7],[14.7,14.86],[14.86,15.1],[15.1,15.5],[15.5,16.9],[16.9,17.1],[17.1,17.4],[17.4,17.9],[18.0,18.2]]}}