{"text":"purananuru","n":234,"lines":["நோகோ யானே தேய்கமா காலை","பிடி அடி அன்ன சிறுவழி மெழுகித்","தன்அமர் காதலி புன்மேல் வைத்த","இன்சிறு பிண்டம் யாங்குஉண் டனன்கொல்","உலகுபுகத் திறந்த வாயில்","பலரோடு உண்டல் மரீஇ யோனே"],"tr":["nōkō yāṉē tēykamā kālai","piṭi aṭi aṉṉa ciṟuvaḻi meḻukit","taṉamar kātali puṉmēl vaitta","iṉciṟu piṇṭam yāṅkuuṇ ṭaṉaṉkol","ulakupukat tiṟanta vāyil","palarōṭu uṇṭal marīi yōṉē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"கையறுநிலை","poet_ta":"வெள்ளெருக்கிலையார்","addressed_ta":"வேள் எவ்வி","poet_tr":"Veḷḷerukkilaiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"6×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 24"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 12, āciriyattaḷai 11"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நோகோ","tr":"nōkō","foot":"tēmā","acai":[{"kind":"nēr","text":"நோ","tr":"nō"},{"kind":"nēr","text":"கோ","tr":"kō"}]},{"text":"யானே","tr":"yāṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னே","tr":"ṉē"}]},{"text":"தேய்கமா","tr":"tēykamā","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தேய்","tr":"tēy"},{"kind":"nirai","text":"கமா","tr":"kamā"}]},{"text":"காலை","tr":"kālai","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"லை","tr":"lai"}]}],[{"text":"பிடியடி","tr":"piṭiyaṭi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பிடி","tr":"piṭi"},{"kind":"nirai","text":"யடி","tr":"yaṭi"}]},{"text":"யன்ன","tr":"yaṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"யன்","tr":"yaṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"சிறுவழி","tr":"ciṟuvaḻi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nirai","text":"வழி","tr":"vaḻi"}]},{"text":"மெழுகித்","tr":"meḻukit","foot":"puḷimā","acai":[{"kind":"nirai","text":"மெழு","tr":"meḻu"},{"kind":"nēr","text":"கித்