xt":"மரீ","tr":"marī"},{"kind":"nēr","text":"இ","tr":"i"}]},{"text":"யோனே","tr":"yōṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"யோ","tr":"yō"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"நோகோ","parts":[{"text":"நோகு","lemma":"நோகு","gloss":"I ache"},{"text":"ஓ","lemma":"ஓ","gloss":"clitic of lament"}],"gloss":"I ache"},{"surface":"யானே","parts":[{"text":"யான்","lemma":"யான்","gloss":"I"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"I indeed"},{"surface":"தேய்கமா","parts":[{"text":"தேய்க","lemma":"தேய்","gloss":"may it waste away"},{"text":"மா","lemma":"மா","gloss":"expletive particle"}],"gloss":"may it waste away"},{"surface":"காலை","parts":[{"text":"காலை","lemma":"காலை","gloss":"morning"}],"gloss":"morning"}]},{"words":[{"surface":"பிடி","parts":[{"text":"பிடி","lemma":"பிடி","gloss":"female elephant"}],"gloss":"female elephant"},{"surface":"அடி","parts":[{"text":"அடி","lemma":"அடி","gloss":"footprint"}],"gloss":"footprint"},{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"அன்ன","gloss":"like"}],"gloss":"like"},{"surface":"சிறுவழி","parts":[{"text":"சிறு","lemma":"சிறு","gloss":"small"},{"text":"வழி","lemma":"வழி","gloss":"space"}],"gloss":"small space"},{"surface":"மெழுகி","parts":[{"text":"மெழுகி","lemma":"மெழுகு","gloss":"having smeared"}],"gloss":"having smeared"}]},{"words":[{"surface":"தன்","parts":[{"text":"தன்","lemma":"தான்","gloss":"his"}],"gloss":"his"},{"surface":"அமர்","parts":[{"text":"அமர்","lemma":"அமர்","gloss":"beloved"}],"gloss":"beloved"},{"surface":"காதலி","parts":[{"text":"காதலி","lemma":"காதலி","gloss":"wife"}],"gloss":"wife"},{"surface":"புன்மேல்","parts":[{"text":"புன்மேல்","lemma":"புன்மேல்","gloss":"upon the grass"}],"gloss":"upon the grass","split_unverified":true},{"surface":"வைத்த","parts":[{"text":"வைத்த","lemma":"வை","gloss":"placed"}],"gloss":"placed"}]},{"words":[{"surface":"இன்","parts":[{"text":"இன்","lemma":"இனிமை","gloss":"sweet"}],"gloss":"sweet"},{"surface":"சிறு","parts":[{"text":"சிறு","lemma":"சிறு","gloss":"small"}],"gloss":"small"},{"surface":"பிண்டம்","parts":[{"text":"பிண்டம்","lemma":"பிண்டம்","gloss":"ball of rice"}],"gloss":"ball of rice"},{"surface":"யாங்கு","parts":[{"text":"யாங்கு","lemma":"யாங்கு","gloss":"how"}],"gloss":"how"},{"surface":"உண்டனன்கொல்","parts":[{"text":"உண்டனன்","lemma":"உண்","gloss":"he ate"},{"text":"கொல்","lemma":"கொல்","gloss":"particle of sorrow"}],"gloss":"did he eat?"}]},{"words":[{"surface":"உலகு","parts":[{"text":"உலகு","lemma":"உலகு","gloss":"world"}],"gloss":"world"},{"surface":"புக","parts":[{"text":"புக","lemma":"புகு","gloss":"to enter"}],"gloss":"to enter"},{"surface":"திறந்த","parts":[{"text":"திறந்த","lemma":"திற","gloss":"opened"}],"gloss":"opened"},{"surface":"வாயில்","parts":[{"text":"வாயில்","lemma":"வாயில்","gloss":"gate"}],"gloss":"gate"}]},{"words":[{"surface":"பலரோடு","parts":[{"text":"பலர்","lemma":"பலர்","gloss":"many people"},{"text":"ஓடு","lemma":"ஓடு","gloss":"with"}],"gloss":"with many people"},{"surface":"உண்டல்","parts":[{"text":"உண்டல்","lemma":"உண்","gloss":"eating"}],"gloss":"eating"},{"surface":"மரீஇயோனே","parts":[{"text":"மரீஇயோன்","lemma":"மரீஇயோன்","gloss":"he who was accustomed to"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"he who was accustomed to"}]}],"literal":"I ache, I indeed! May the morning waste away! / Smeared a small space like the footprint of a female elephant, / his beloved wife placed upon the grass / a sweet small ball of rice; how did he eat it? / With gates opened for the world to enter, / he who was accustomed to eating with many people!","translation":"I suffer, indeed! May this morning perish! How could he eat that sweet, tiny ball of rice, placed upon the grass by his beloved wife, after she smeared a small space no larger than a female elephant's footprint? He, who was accustomed to eating with many people, keeping his gates wide open for the whole world to enter!","modern":"நான் மிகவும் வருந்துகிறேன்! இந்த விடியற்காலை பொழுது அழியட்டும்! பெண் யானையின் காலடி போன்ற சிறிய இடத்தை மெழுகி, அவனது அன்பான மனைவி தர்பைப் புல்லின் மேல் வைத்த அந்த இனிய சிறிய சோற்றுப் பிண்டத்தை அவன் எவ்வாறு உண்டானோ? உலகமே உள்ளே நுழையும்படி தன் வாயிலைத் திறந்து வைத்து, எப்போதும் பலரோடு சேர்ந்து உண்பதை வழக்கமாகக் கொண்டிருந்தானே அவன்!","explanation":"This poem is an elegy (kaiyaṟunilai) composed by the poet Veḷḷerukkilaiyār on the death of his patron, the generous chieftain Veḷ Evvi. The poet expresses his intense grief, wishing that the morning would never dawn now that his patron is gone. He describes the funerary ritual where Evvi's grieving wife has cleared a tiny patch of ground, the size of a female elephant's footprint, and placed a small ball of rice (piṇṭam) on the grass as an offering to the deceased. The poet laments how Evvi, who was famous for keeping his palace gates wide open to feed the entire world and who never ate without the company of many guests, could now accept such a tiny, solitary offering. The contrast between Evvi's grand, open-handed life and his meager, silent death forms the emotional core of the poem.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.5],[0.5,0.78],[0.78,1.35],[1.5,1.9],[1.9,2.2],[2.2,2.4],[2.4,2.62],[2.7,3.12],[3.33,3.76],[3.76,4.3],[4.3,4.66],[4.66,5.1],[5.1,5.3],[5.3,6.1],[6.1,6.6],[6.6,7.11],[7.11,7.5],[7.5,8.4],[8.4,9.0],[9.0,9.4],[9.4,10.1],[10.1,10.4],[10.4,10.9],[10.9,11.4]],"female":[[0.0,0.6],[0.6,0.8],[0.8,1.6],[1.6,2.0],[2.0,2.6],[2.6,2.8],[2.8,3.3],[3.3,3.66],[3.66,4.35],[4.35,5.2],[5.2,5.72],[5.72,6.4],[6.4,6.7],[6.8,7.2],[7.2,7.5],[7.5,8.41],[8.41,8.7],[8.7,9.9],[9.9,10.5],[10.5,10.9],[10.9,11.6],[11.6,11.8],[11.8,12.3],[12.3,12.8]]},"sync":[[["நோகோ","I ache"]],[["யானே","I indeed"]],[["தேய்கமா","may it waste away"]],[["காலை","morning"]],[["பிடி","female elephant"]],[["அடி","footprint"]],[["அன்ன","like"]],[["சிறுவழி","small space"]],[["மெழுகி","having smeared"]],[["தன்","his"],["அமர்","beloved"]],[["காதலி","wife"]],[["புன்மேல்","upon the grass"]],[["வைத்த","placed"]],[["இன்","sweet"],["சிறு","small"]],[["பிண்டம்","ball of rice"]],[["யாங்கு","how"],["உண்டனன்கொல்","did he eat?"]],[["உண்டனன்கொல்","did he eat?"]],[["உலகு","world"],["புக","to enter"]],[["திறந்த","opened"]],[["வாயில்","gate"]],[["பலரோடு","with many people"]],[["உண்டல்","eating"]],[["மரீஇயோனே","he who was accustomed to"]],[["மரீஇயோனே","he who was accustomed to"]]]}