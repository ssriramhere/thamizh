{"text":"purananuru","n":112,"lines":["அற்றைத் திங்கள் அவ் வெண் நிலவில்","எந்தையும் உடையேம் எம் குன்றும் பிறர் கொளார்","இற்றைத் திங்கள் இவ் வெண் நிலவில்","வென்று எறி முரசின் வேந்தர் எம்","குன்றும் கொண்டார் யாம் எந்தையும் இலமே"],"tr":["aṟṟait tiṅkaḷ av veṇ nilavil","entaiyum uṭaiyēm em kuṉṟum piṟar koḷār","iṟṟait tiṅkaḷ iv veṇ nilavil","veṉṟu eṟi muraciṉ vēntar em","kuṉṟum koṇṭār yām entaiyum ilamē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"கையறு நிலை","poet_ta":"பாரி மகளிர்","poet_tr":"Pāri Makaḷir"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 16, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 4, kalittaḷai 3"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அற்றைத்","tr":"aṟṟait","foot":"tēmā","acai":[{"kind":"nēr","text":"அற்","tr":"aṟ"},{"kind":"nēr","text":"றைத்","tr":"ṟait"}]},{"text":"திங்க","tr":"tiṅka","foot":"tēmā","acai":[{"kind":"nēr","text":"திங்","tr":"tiṅ"},{"kind":"nēr","text":"க","tr":"ka"}]},{"text":"ளவ்வெண்","tr":"ḷavveṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"ளவ்","tr":"ḷav"},{"kind":"nēr","text":"வெண்","tr":"veṇ"}]},{"text":"நிலவி","tr":"nilavi","foot":"puḷimā","acai":[{"kind":"nirai","text":"நில","tr":"nila"},{"kind":"nēr","text":"வி","tr":"vi"}]}],[{"text":"லெந்தையு","tr":"lentaiyu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"லெந்","tr":"len"},{"kind":"nēr","text":"தை","tr":"tai"},{"kind":"nēr","text":"யு","tr":"yu"}]},{"text":"முடையே","tr":"muṭaiyē","foot":"puḷimā","acai":[{"kind":"nirai","text":"முடை","tr":"muṭai"},{"kind":"nēr","text":"யே","tr":"yē"}]},{"text":"மெம்குன்றும்","tr":"memkuṉṟum","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"மெம்","tr":"mem"},{"kind":"nēr","text":"குன்","tr":"kuṉ"},{"kind":"nēr","text":"றும்","tr":"ṟum"}]},{"text":"பிறர்கொளா","tr":"piṟarkoḷā","foot":