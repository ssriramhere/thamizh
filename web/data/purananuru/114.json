{"text":"purananuru","n":114,"lines":["ஈண்டு நின் றோர்க்கும் தோன்றும் சிறு வரை","சென்று நின் றோர்க்கும் தோன்றும் மன்ற","களிறு மென்று இட்ட கவளம் போல","நறவுப் பிழிந் திட்ட கோதுடைச் சிதறல்","வார் அசும்பு ஒழுகு முன்றில்","தேர் வீசு இருக்கை நெடியோன் குன்றே"],"tr":["īṇṭu niṉ ṟōrkkum tōṉṟum ciṟu varai","ceṉṟu niṉ ṟōrkkum tōṉṟum maṉṟa","kaḷiṟu meṉṟu iṭṭa kavaḷam pōla","naṟavup piḻin tiṭṭa kōtuṭaic citaṟal","vār acumpu oḻuku muṉṟil","tēr vīcu irukkai neṭiyōṉ kuṉṟē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"கையறுநிலை","poet_ta":"கபிலர்","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 12, āciriyattaḷai 10"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஈண்டுநின்","tr":"īṇṭuniṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஈண்","tr":"īṇ"},{"kind":"nirai","text":"டுநின்","tr":"ṭuniṉ"}]},{"text":"றோர்க்கும்","tr":"ṟōrkkum","foot":"tēmā","acai":[{"kind":"nēr","text":"றோர்க்","tr":"ṟōrk"},{"kind":"nēr","text":"கும்","tr":"kum"}]},{"text":"தோன்றும்","tr":"tōṉṟum","foot":"tēmā","acai":[{"kind":"nēr","text":"தோன்","tr":"tōṉ"},{"kind":"nēr","text":"றும்","tr":"ṟum"}]},{"text":"சிறுவரை","tr":"ciṟuvarai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nirai","text":"வரை","tr":"varai"}]}],[{"text":"சென்றுநின்","tr":"ceṉṟuniṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சென்","tr":"ceṉ"},{"kind":"nirai","text":"றுநின்","tr":"ṟuniṉ"}]},{"text":"றோர்க்கும்","tr":"ṟōrkkum","foot":"tēmā","acai":[{"kind":"nēr","text":"றோர்க்","tr":"ṟōrk"},{"kind":"nēr","text":"கும்","tr":"kum"}]},{"text":"தோன்றும்","tr":"tōṉṟum","foot":"tēmā","acai":[{"kind":"nēr","text":"தோன்","tr":"tōṉ"},{"kind":"nēr","text":"றும்","tr":"ṟum"}]},{"text":"மன்ற","tr":"maṉṟa","foot":"tēmā","acai":[{"