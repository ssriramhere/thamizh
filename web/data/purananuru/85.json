loss":"good"}],"gloss":"great and good"},{"surface":"மொழியே","parts":[{"text":"மொழி","lemma":"மொழி","gloss":"word"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"words indeed"}]},{"words":[{"surface":"அஞ்சிலம்பு","parts":[{"text":"அம்","lemma":"அழகிய","gloss":"beautiful"},{"text":"சிலம்பு","lemma":"சிலம்பு","gloss":"anklet"}],"gloss":"beautiful anklets"},{"surface":"ஒலிப்ப","parts":[{"text":"ஒலி","lemma":"ஒலி","gloss":"sound"},{"text":"ப்ப","lemma":"ப்ப","gloss":"to sound"}],"gloss":"sounding"},{"surface":"ஓடி","parts":[{"text":"ஓடு","lemma":"ஓடு","gloss":"run"},{"text":"இ","lemma":"இ","gloss":"having run"}],"gloss":"running"},{"surface":"எம்இல்","parts":[{"text":"எம்","lemma":"எம்","gloss":"our"},{"text":"இல்","lemma":"இல்","gloss":"house"}],"gloss":"to our house"}]},{"words":[{"surface":"முழா","parts":[{"text":"முழா","lemma":"முழா","gloss":"drum"}],"gloss":"drum-like"},{"surface":"அரைப்","parts":[{"text":"அரை","lemma":"அரை","gloss":"trunk"},{"text":"ப்","lemma":"ப்","gloss":"sandhi"}],"gloss":"trunk of"},{"surface":"போந்தை","parts":[{"text":"போந்தை","lemma":"போந்தை","gloss":"palmyra tree"}],"gloss":"palmyra tree"},{"surface":"பொருந்தி","parts":[{"text":"பொருந்து","lemma":"பொருந்து","gloss":"to cling/fit"},{"text":"இ","lemma":"இ","gloss":"having clung"}],"gloss":"clinging to"},{"surface":"நின்று","parts":[{"text":"நின்று","lemma":"நின்று","gloss":"standing"}],"gloss":"standing","split_unverified":true}]},{"words":[{"surface":"யான்கண்","parts":[{"text":"யான்","lemma":"யான்","gloss":"I"},{"text":"கண்","lemma":"காண்","gloss":"see"}],"gloss":"I saw"},{"surface":"டனன்","parts":[{"text":"டனன்","lemma":"கண்டனன்","gloss":"saw (suffix part)"}],"gloss":"saw"},{"surface":"அவன்","parts":[{"text":"அவன்","lemma":"அவன்","gloss":"he"}],"gloss":"his"},{"surface":"ஆடா","parts":[{"text":"ஆடா","lemma":"ஆடா","gloss":"not fighting"}],"gloss":"not fighting"},{"surface":"குதலே","parts":[{"text":"குதல்","lemma":"ஆகுதல்","gloss":"becoming"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"indeed happening"}]}],"literal":"Because this is not my lord's town, / Because this is not my lord's country, / 'He fights, he fights!' say some people, / 'He does not fight!' say some other people, / among the many good words of many people, / with my beautiful anklets sounding, running to our house, / clinging to the drum-like trunk of the palmyra tree and standing, / I saw his not fighting.","translation":"Because this is neither my lord's town nor his country, people are divided. 'He fights, he fights!' say some, while others say, 'He does not fight!' Amidst these many voices, running to our house with my beautiful anklets sounding, and standing close behind the drum-like trunk of the palmyra tree, I saw for myself that he was indeed not fighting.","modern":"இது என் தலைவனுடைய ஊர் இல்லை என்பதனாலும், இது என் தலைவனுடைய நாடு இல்லை என்பதனாலும், 'அவன் போரிடுகிறான், போரிடுகிறான்' என்று ஒரு சாராரும், 'அவன் போரிடவில்லை' என்று மற்றொரு சாராரும் கூறுகின்றனர். பலருடைய நல்ல சொற்களுக்கு இடையே, என் அழகிய சிலம்புகள் ஒலிக்க ஓடிவந்து, எம்முடைய இல்லத்தில் உள்ள முழவு போன்ற அடிமரத்தைக் கொண்ட பனைமரத்தின் பின்னே மறைந்து நின்று, அவன் போரிடாத தன்மையை நான் கண்டேன்.","explanation":"The poet Nakkaṇṇaiyār, speaking as a young woman in love, describes her secret admiration for the Chola king Pōrvaikkō Perunaṟkiḷḷi. Since the town and country do not belong to her lord, people are divided in their opinions, some saying he is fighting bravely and others saying he is not. Amidst these conflicting voices, she runs to her house, her beautiful anklets sounding, and hides behind a palmyra tree with a trunk as thick as a drum. From there, she watches him and witnesses his calm, non-fighting stance, which reveals his supreme confidence and stature. The image of her hiding behind the palmyra tree beautifully captures her shyness and intense love.","model":"gemini-3.5-flash"}}