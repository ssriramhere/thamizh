{"text":"purananuru","n":85,"lines":["என்னைக்கு ஊர் இ·து அன்மை யானும்","என்னைக்கு நாடு இ·து அன்மை யானும்","ஆடுஆடு என்ப ஒருசா ரோரே","ஆடன்று என்ப ஒருசா ரோரே","நல்ல பல்லோர் இருநன் மொழியே","அஞ்சிலம்பு ஒலிப்ப ஓடி எம்இல்","முழா அரைப் போந்தை பொருந்தி நின்று","யான்கண் டனன் அவன் ஆடா குதலே"],"tr":["eṉṉaikku ūr itu aṉmai yāṉum","eṉṉaikku nāṭu itu aṉmai yāṉum","āṭuāṭu eṉpa orucā rōrē","āṭaṉṟu eṉpa orucā rōrē","nalla pallōr irunaṉ moḻiyē","añcilampu olippa ōṭi emil","muḻā araip pōntai porunti niṉṟu","yāṉkaṇ ṭaṉaṉ avaṉ āṭā kutalē"],"colophon":{"tinai":"kaikkiḷai","tinai_ta":"கைக்கிளை","turai_ta":"பழிச்சுதல்","poet_ta":"பெருங்கோழி நாய்கன் மகள் நக்கண்ணையார்","addressed_ta":"சோழன் போர்வைக்கோப் பெருநற்கிள்ளி","poet_tr":"Peruṅkōḻi Nāykaṉ Makaḷ Nakkaṇṇaiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"8×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 32"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 13"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"என்னைக்","tr":"eṉṉaik","foot":"tēmā","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nēr","text":"னைக்","tr":"ṉaik"}]},{"text":"கூரிது","tr":"kūritu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கூ","tr":"kū"},{"kind":"nirai","text":"ரிது","tr":"ritu"}]},{"text":"வன்மை","tr":"vaṉmai","foot":"tēmā","acai":[{"kind":"nēr","text":"வன்","tr":"vaṉ"},{"kind":"nēr","text":"மை","tr":"mai"}]},{"text":"யானு","tr":"yāṉu","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னு","tr":"ṉu"}]}],[{"text":"மென்னைக்","tr":"meṉṉaik","foot":"tēmā","acai":[{"kind":"nēr","text":"மென்","tr":"meṉ"},{"kind":"nēr","text":"னைக்","tr":"ṉaik"}]},{"text":"குநாடிது","tr":"kunāṭitu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குநா","tr":"kunā"},{"kind":"nirai","text":"டிது","tr":"ṭitu"}]},{"text":"வன்மை","tr":"vaṉmai","foot":"tēmā","acai":[{"kind":"nēr","tex