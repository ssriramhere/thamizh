{"text":"purananuru","n":208,"lines":["குன்றும் மலையும் பலபின் ஒழிய","வந்தனென் பரிசில் கொண்டனென் செலற்கு என","நின்ற என்நயந்து அருளி ஈது கொண்டு","ஈங்கனம் செல்க தான் என என்னை","யாங்குஅறிந் தனனோ தாங்கரும் காவலன்","காணாது ஈத்த இப்பொருட்கு யானோர்","வாணிகப் பரிசிலன் அல்லேன் பேணித்","தினை அனைத்து ஆயினும் இனிதுஅவர்","துணை அளவு அறிந்து நல்கினர் விடினே"],"tr":["kuṉṟum malaiyum palapiṉ oḻiya","vantaṉeṉ paricil koṇṭaṉeṉ celaṟku eṉa","niṉṟa eṉnayantu aruḷi ītu koṇṭu","īṅkaṉam celka tāṉ eṉa eṉṉai","yāṅkuaṟin taṉaṉō tāṅkarum kāvalaṉ","kāṇātu ītta ipporuṭku yāṉōr","vāṇikap paricilaṉ allēṉ pēṇit","tiṉai aṉaittu āyiṉum iṉituavar","tuṇai aḷavu aṟintu nalkiṉar viṭiṉē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்:","turai_ta":"பரிசில்","poet_ta":"பெருஞ்சித்திரனார்","addressed_ta":"அதியமான் நெடுமான் அஞ்சி","poet_tr":"Peruñcittiraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"8×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 34, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 21, veṇṭaḷai 12, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"குன்றும்","tr":"kuṉṟum","foot":"tēmā","acai":[{"kind":"nēr","text":"குன்","tr":"kuṉ"},{"kind":"nēr","text":"றும்","tr":"ṟum"}]},{"text":"மலையும்","tr":"malaiyum","foot":"puḷimā","acai":[{"kind":"nirai","text":"மலை","tr":"malai"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"பலபி","tr":"palapi","foot":"puḷimā","acai":[{"kind":"nirai","text":"பல","tr":"pala"},{"kind":"nēr","text":"பி","tr":"pi"}]},{"text":"னொழிய","tr":"ṉoḻiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"னொழி","tr":"ṉoḻi"},{"kind":"nēr","text":"ய","tr":"ya"}]}],[{"text":"வந்தனென்","tr":"vantaṉeṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வந்","tr":"van"},{"kind":"nirai","text":"தனென்","tr":"taṉeṉ"}]},{"text":"பரிசில்","tr":"paricil","foot":"puḷimā","acai":[{"kind":"nirai","text":"பரி","tr":"pari"},{"kind":"nēr","text":"சில்","tr":"cil"}]},{"text":"கொண்டனென்","tr":"koṇṭaṉeṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கொண்","tr":"koṇ"},{"kind":"nirai","text":"டனென்","tr":"ṭaṉeṉ"}]},{"text":"செலற்கென","tr":"celaṟkeṉa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"செலற்","tr":"celaṟ"},{"kind":"nirai","text":"கென","tr":"keṉa"}]}],[{"text":"நின்ற","tr":"niṉṟa","foot":"tēmā","acai":[{"kind":"nēr","text":"நின்","tr":"niṉ"},{"kind":"nēr","text":"ற","tr":"ṟa"}]},{"text":"வென்நயந்","tr":"veṉnayan","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வென்","tr":"veṉ"},{"kind":"nirai","text":"நயந்","tr":"nayan"}]},{"text":"தருளி","tr":"taruḷi","foot":"puḷimā","acai":[{"kind":"nirai","text":"தரு","tr":"taru"},{"kind":"nēr","text":"ளி","tr":"ḷi"}]},{"text":"யீதுகொண்","tr":"yītukoṇ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யீ","tr":"yī"},{"kind":"nirai","text":"துகொண்","tr":"tukoṇ"}]}],[{"text":"டீங்கனம்","tr":"ṭīṅkaṉam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"டீங்","tr":"ṭīṅ"},{"kind":"nirai","text":"கனம்","tr":"kaṉam"}]},{"text":"செல்க","tr":"celka","foot":"tēmā","acai":[{"kind":"nēr","text":"செல்","tr":"cel"},{"kind":"nēr","text":"க","tr":"ka"}]},{"text":"தானென","tr":"tāṉeṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nirai","text":"னென","tr":"ṉeṉa"}]},{"text":"வென்னை","tr":"veṉṉai","foot":"tēmā","acai":[{"kind":"nēr","text":"வென்","tr":"veṉ"},{"kind":"nēr","text":"னை","tr":"ṉai"}]}],[{"text":"யாங்கறிந்","tr":"yāṅkaṟin","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யாங்","tr":"yāṅ"},{"kind":"nirai","text":"கறிந்","tr":"kaṟin"}]},{"text":"தனனோ","tr":"taṉaṉō","foot":"puḷimā","acai":[{"kind":"nirai","text":"தன","tr":"taṉa"},{"kind":"nēr","text":"னோ","tr":"ṉō"}]},{"text":"தாங்கரும்","tr":"tāṅkarum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தாங்","tr":"tāṅ"},{"kind":"nirai","text":"கரும்","tr":"karum"}]},{"text":"காவலன்","tr":"kāvalaṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"