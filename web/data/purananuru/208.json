:"உ","gloss":"past participle suffix"}],"gloss":"esteeming me"},{"surface":"அருளி","parts":[{"text":"அருள்","lemma":"அருள்","gloss":"grace"},{"text":"இ","lemma":"இ","gloss":"having done"}],"gloss":"having graced"},{"surface":"`ஈது","parts":[{"text":"`ஈது","lemma":"`ஈது","gloss":"\"this"}],"gloss":"\"this","split_unverified":true},{"surface":"கொண்டு","parts":[{"text":"கொண்","lemma":"கொள்","gloss":"take"},{"text":"ட்","lemma":"த்","gloss":"past tense marker"},{"text":"உ","lemma":"உ","gloss":"past participle suffix"}],"gloss":"taking"}]},{"words":[{"surface":"ஈங்கனம்","parts":[{"text":"ஈங்கு","lemma":"ஈங்கு","gloss":"here"},{"text":"அனம்","lemma":"அனம்","gloss":"manner"}],"gloss":"in this manner"},{"surface":"செல்க","parts":[{"text":"செல்","lemma":"செல்","gloss":"go"},{"text":"க","lemma":"க","gloss":"optative suffix"}],"gloss":"let him go"},{"surface":"தான்`","parts":[{"text":"தான்`","lemma":"தான்`","gloss":"indeed\""}],"gloss":"indeed\"","split_unverified":true},{"surface":"என","parts":[{"text":"என","lemma":"என்","gloss":"saying"}],"gloss":"saying"},{"surface":"என்னை","parts":[{"text":"என்","lemma":"யான்","gloss":"me"},{"text":"ஐ","lemma":"ஐ","gloss":"accusative case marker"}],"gloss":"me"}]},{"words":[{"surface":"யாங்குஅறிந்","parts":[{"text":"யாங்கு","lemma":"யாங்கு","gloss":"how"},{"text":"அறிந்","lemma":"அறி","gloss":"know"}],"gloss":"how did he know"},{"surface":"தனனோ","parts":[{"text":"த்","lemma":"த்","gloss":"past tense marker"},{"text":"அன்","lemma":"அன்","gloss":"empty particle"},{"text":"அன்","lemma":"அன்","gloss":"he"},{"text":"ஓ","lemma":"ஓ","gloss":"interrogative particle"}],"gloss":"did he know?"},{"surface":"தாங்கரும்","parts":[{"text":"தாங்கு","lemma":"தாங்கு","gloss":"bear"},{"text":"அரும்","lemma":"அருமை","gloss":"difficult"}],"gloss":"hard to resist"},{"surface":"காவலன்","parts":[{"text":"காவல்","lemma":"காவல்","gloss":"protection"},{"text":"அன்","lemma":"அன்","gloss":"masculine singular suffix"}],"gloss":"protector"}]},{"words":[{"surface":"காணாது","parts":[{"text":"காண்","lemma":"காண்","gloss":"see"},{"text":"ஆது","lemma":"ஆது","gloss":"without"}],"gloss":"without seeing"},{"surface":"ஈத்த","parts":[{"text":"ஈ","lemma":"ஈ","gloss":"give"},{"text":"த்","lemma":"த்","gloss":"past tense marker"},{"text":"த்","lemma":"த்","gloss":"past tense marker"},{"text":"அ","lemma":"அ","gloss":"adjectival participle suffix"}],"gloss":"given"},{"surface":"இப்பொருட்கு","parts":[{"text":"இ","lemma":"இ","gloss":"this"},{"text":"பொருள்","lemma":"பொருள்","gloss":"wealth"},{"text":"கு","lemma":"கு","gloss":"to"}],"gloss":"for this wealth"},{"surface":"யானோர்","parts":[{"text":"யான்","lemma":"யான்","gloss":"I"},{"text":"ஓர்","lemma":"ஒரு","gloss":"a"}],"gloss":"I am not a"}]},{"words":[{"surface":"வாணிகப்","parts":[{"text":"வாணிகப்","lemma":"வாணிகப்","gloss":"trading"}],"gloss":"trading","split_unverified":true},{"surface":"பரிசிலன்","parts":[{"text":"பரிசில்","lemma":"பரிசில்","gloss":"gift"},{"text":"அன்","lemma":"அன்","gloss":"masculine singular suffix"}],"gloss":"seeker of gifts"},{"surface":"அல்லேன்","parts":[{"text":"அல்","lemma":"அல்","gloss":"not"},{"text":"ஏன்","lemma":"ஏன்","gloss":"I (1sg suffix)"}],"gloss":"I am not"},{"surface":"பேணித்","parts":[{"text":"பேண்","lemma":"பேண்","gloss":"cherish"},{"text":"இ","lemma":"இ","gloss":"past participle suffix"},{"text":"த்","lemma":"த்","gloss":"sandhi consonant"}],"gloss":"cherishing"}]},{"words":[{"surface":"தினை","parts":[{"text":"தினை","lemma":"தினை","gloss":"millet"}],"gloss":"millet"},{"surface":"அனைத்து","parts":[{"text":"அனை","lemma":"அனை","gloss":"that much"},{"text":"த்","lemma":"த்","gloss":"sandhi consonant"},{"text":"து","lemma":"து","gloss":"neuter singular suffix"}],"gloss":"as small as that"},{"surface":"ஆயினும்","parts":[{"text":"ஆயின்","lemma":"ஆயின்","gloss":"if it is"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"even if it is"},{"surface":"இனிதுஅவர்","parts":[{"text":"இனிது","lemma":"இனிது","gloss":"sweet"},{"text":"அவர்","lemma":"அவர்","gloss":"his/their"}],"gloss":"sweet is their"}]},{"words":[{"surface":"துணை","parts":[{"text":"துணை","lemma":"துணை","gloss":"measure"}],"gloss":"measure"},{"surface":"அளவு","parts":[{"text":"அளவு","lemma":"அளவு","gloss":"extent"}],"gloss":"extent"},{"surface":"அறிந்து","parts":[{"text":"அறி","lemma":"அறி","gloss":"know"},{"text":"ந்","lemma":"த்","gloss":"past tense marker"},{"text":"த்","lemma":"த்","gloss":"past tense marker"},{"text":"உ","lemma":"உ","gloss":"past participle suffix"}],"gloss":"knowing"},{"surface":"நல்கினர்","parts":[{"text":"நல்கு","lemma":"நல்கு","gloss":"give"},{"text":"இன்","lemma":"இன்","gloss":"past tense marker"},{"text":"அர்","lemma":"அர்","gloss":"they"}],"gloss":"if they gave"},{"surface":"விடினே","parts":[{"text":"விடின்","lemma":"விடின்","gloss":"if"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"indeed if they gave"}]}],"literal":"Leaving behind many hills and mountains / I came, saying 'I will receive gifts and go' / To me who stood, he showed grace, and saying 'Take this / and go from here', how did he know me, / the protector hard to resist? / For this wealth given without seeing me, I am not / a trading seeker of gifts! Cherishing, / even if it is as small as a millet grain, it is sweet, if they / gave knowing the measure of their relationship.","translation":"Leaving behind many hills and mountains, I came here thinking, 'I shall receive gifts and depart.' To me who stood waiting, he showed grace, and saying, 'Take this and go from here,' how did the hard-to-resist protector know my worth? For this wealth given without even seeing me, I am not a trading seeker of gifts! Even if it is as small as a millet grain, it is sweet if given with love, knowing the measure of our relationship.","modern":"பல குன்றுகளையும் மலைகளையும் பின்னே விட்டுவிட்டு, 'பரிசில் பெற்றுக்கொண்டு செல்வேன்' என்று வந்தேன். அவ்வாறு நின்ற என்மீது அன்பு காட்டி, 'இதை வாங்கிக்கொண்டு இங்கிருந்து போகட்டும்' என்று என்னை எவ்வாறு அறிந்து கொண்டான் அந்தத் தாங்கற்கரிய காவலன்? என்னைக் காணாமலேயே கொடுத்த இந்தச் செல்வத்தைப் பெறுவதற்கு நான் ஒன்றும் வியாபாரப் பரிசிலன் அல்லன். அன்போடு போற்றி, தினை அளவு சிறியதாக இருந்தாலும், நம்முடைய உறவின் அளவை அறிந்து கொடுத்தால் அதுவே நமக்கு இனியதாகும்.","explanation":"The poet Peruñcittiraṉār is speaking to the messengers or associates of King Atiyamāṉ Neṭumāṉ Añci, expressing his self-respect and refusal of a gift given without a personal audience. Having traveled a long distance across hills and mountains, the poet arrived expecting a warm reception and a mutual appreciation of his poetic worth. Instead, the king sent a generous gift through intermediaries without granting an audience, treating the transaction like a mere trade. The poet proudly declares that he is not a merchant of words who sells poetry for material wealth. He asserts that even a tiny gift, as small as a millet seed, is sweet and acceptable if given with personal regard and an understanding of their relationship.","model":"gemini-3.5-flash"}}