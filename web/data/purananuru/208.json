{"text":"purananuru","n":208,"lines":["`குன்றும் மலையும் பலபின் ஒழிய","வந்தனென் பரிசில் கொண்டனென் செலற்கு` என","நின்ற என்நயந்து அருளி `ஈது கொண்டு","ஈங்கனம் செல்க தான்` என என்னை","யாங்குஅறிந் தனனோ தாங்கரும் காவலன்","காணாது ஈத்த இப்பொருட்கு யானோர்","வாணிகப் பரிசிலன் அல்லேன் பேணித்","தினை அனைத்து ஆயினும் இனிதுஅவர்","துணை அளவு அறிந்து நல்கினர் விடினே"],"tr":["kuṉṟum malaiyum palapiṉ oḻiya","vantaṉeṉ paricil koṇṭaṉeṉ celaṟku eṉa","niṉṟa eṉnayantu aruḷi ītu koṇṭu","īṅkaṉam celka tāṉ eṉa eṉṉai","yāṅkuaṟin taṉaṉō tāṅkarum kāvalaṉ","kāṇātu ītta ipporuṭku yāṉōr","vāṇikap paricilaṉ allēṉ pēṇit","tiṉai aṉaittu āyiṉum iṉituavar","tuṇai aḷavu aṟintu nalkiṉar viṭiṉē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்:","turai_ta":"பரிசில்","poet_ta":"பெருஞ்சித்திரனார்","addressed_ta":"அதியமான் நெடுமான் அஞ்சி","poet_tr":"Peruñcittiraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"8×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 34, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 21, veṇṭaḷai 12, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"குன்றும்","tr":"kuṉṟum","foot":"tēmā","acai":[{"kind":"nēr","text":"குன்","tr":"kuṉ"},{"kind":"nēr","text":"றும்","tr":"ṟum"}]},{"text":"மலையும்","tr":"malaiyum","foot":"puḷimā","acai":[{"kind":"nirai","text":"மலை","tr":"malai"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"பலபி","tr":"palapi","foot":"puḷimā","acai":[{"kind":"nirai","text":"பல","tr":"pala"},{"kind":"nēr","text":"பி","tr":"pi"}]},{"text":"னொழிய","tr":"ṉoḻiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"னொழி","tr":"ṉoḻi"},{"kind":"nēr","text":"ய","tr":"ya"}]}],[{"text":"வந்தனென்","tr":"vantaṉeṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வந்","tr":"van"},{"kind":"nirai","text":"தனென்","tr":"taṉeṉ"}]},{"text":"பரிசில்","tr":"paricil","foot":"puḷimā","acai":[{"kind":"nirai","text":"பரி","t