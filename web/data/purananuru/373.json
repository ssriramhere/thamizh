்","tr":"paṇ"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]},{"text":"பேயடு","tr":"pēyaṭu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பே","tr":"pē"},{"kind":"nirai","text":"யடு","tr":"yaṭu"}]}],[{"text":"கணநரி","tr":"kaṇanari","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கண","tr":"kaṇa"},{"kind":"nirai","text":"நரி","tr":"nari"}]},{"text":"திரிதரு","tr":"tiritaru","foot":"karuviḷam","acai":[{"kind":"nirai","text":"திரி","tr":"tiri"},{"kind":"nirai","text":"தரு","tr":"taru"}]},{"text":"மாங்கண்","tr":"māṅkaṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"மாங்","tr":"māṅ"},{"kind":"nēr","text":"கண்","tr":"kaṇ"}]},{"text":"நிணனருந்து","tr":"niṇaṉaruntu","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"நிண","tr":"niṇa"},{"kind":"nirai","text":"னருந்","tr":"ṉarun"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"செஞ்செவி","tr":"ceñcevi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"செஞ்","tr":"ceñ"},{"kind":"nirai","text":"செவி","tr":"cevi"}]},{"text":"யெருவை","tr":"yeruvai","foot":"puḷimā","acai":[{"kind":"nirai","text":"யெரு","tr":"yeru"},{"kind":"nēr","text":"வை","tr":"vai"}]},{"text":"குழீஇ","tr":"kuḻīi","foot":"puḷimā","acai":[{"kind":"nirai","text":"குழீ","tr":"kuḻī"},{"kind":"nēr","text":"இ","tr":"i"}]}],[{"text":"யஞ்சுவரு","tr":"yañcuvaru","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"யஞ்","tr":"yañ"},{"kind":"nirai","text":"சுவ","tr":"cuva"},{"kind":"nēr","text":"ரு","tr":"ru"}]},{"text":"கிடக்கைய","tr":"kiṭakkaiya","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"கிடக்","tr":"kiṭak"},{"kind":"nēr","text":"கை","tr":"kai"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"களங்கிழ","tr":"kaḷaṅkiḻa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"களங்","tr":"kaḷaṅ"},{"kind":"nirai","text":"கிழ","tr":"kiḻa"}]},{"text":"வோயே","tr":"vōyē","foot":"tēmā","acai":[{"kind":"nēr","text":"வோ","tr":"vō"},{"kind":"nēr","text":"யே","tr":"yē"}]}]]},"ai":null}