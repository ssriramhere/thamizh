{"text":"purananuru","n":241,"lines":["திண்தேர் இரவலர்க்கு ஈத்த தண்தார்","அண்டிரன் வரூஉம் என்ன ஒண்தொடி","வச்சிரத் தடக்கை நெடியோன் கோயிலுள்","போர்ப்புறு முரசும் கறங்க","ஆர்ப்புஎழுந் தன்றால் விசும்பி னானே"],"tr":["tiṇtēr iravalarkku ītta taṇtār","aṇṭiraṉ varūum eṉṉa oṇtoṭi","vaccirat taṭakkai neṭiyōṉ kōyiluḷ","pōrppuṟu muracum kaṟaṅka","ārppueḻun taṉṟāl vicumpi ṉāṉē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"கையறுநிலை","poet_ta":"உறையூர் ஏணிச்சேரி முடமோசியார்","addressed_ta":"ஆய்","poet_tr":"Uṟaiyūr Ēṇiccēri Muṭamōciyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"திண்தே","tr":"tiṇtē","foot":"tēmā","acai":[{"kind":"nēr","text":"திண்","tr":"tiṇ"},{"kind":"nēr","text":"தே","tr":"tē"}]},{"text":"ரிரவலர்க்","tr":"riravalark","foot":"karuviḷam","acai":[{"kind":"nirai","text":"ரிர","tr":"rira"},{"kind":"nirai","text":"வலர்க்","tr":"valark"}]},{"text":"கீத்த","tr":"kītta","foot":"tēmā","acai":[{"kind":"nēr","text":"கீத்","tr":"kīt"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"தண்தா","tr":"taṇtā","foot":"tēmā","acai":[{"kind":"nēr","text":"தண்","tr":"taṇ"},{"kind":"nēr","text":"தா","tr":"tā"}]}],[{"text":"ரண்டிரன்","tr":"raṇṭiraṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ரண்","tr":"raṇ"},{"kind":"nirai","text":"டிரன்","tr":"ṭiraṉ"}]},{"text":"வரூஉ","tr":"varūu","foot":"puḷimā","acai":[{"kind":"nirai","text":"வரூ","tr":"varū"},{"kind":"nēr","text":"உ","tr":"u"}]},{"text":"மென்ன","tr":"meṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"மென்","tr":"meṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"வொண்தொடி","tr":"voṇtoṭi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வொண்","tr":"voṇ"},{"kind":"nirai","text":"தொடி","tr":"t