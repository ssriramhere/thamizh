{"text":"purananuru","n":215,"lines":["கவைக் கதிர் வரகின் அவைப்புறு வாக்கல்","தாதொரு மறுகின் போதொடு பொதுளிய","வேளை வெண்பூ வெண்தயிர்க் கொளீஇ","ஆய்மகள் அட்ட அம்புளி மிதவை","அவரை கொய்யுநர் ஆர மாந்தும்","தென்னம் பொருப்பன் நன்னாட்டு உள்ளும்","பிசிரோன் என்ப என் உயிர்ஓம் புநனே","செல்வ்க் காலை நிற்பினும்","அல்லற் காலை நில்லலன் மன்னே"],"tr":["kavaik katir varakiṉ avaippuṟu vākkal","tātoru maṟukiṉ pōtoṭu potuḷiya","vēḷai veṇpū veṇtayirk koḷīi","āymakaḷ aṭṭa ampuḷi mitavai","avarai koyyunar āra māntum","teṉṉam poruppaṉ naṉṉāṭṭu uḷḷum","picirōṉ eṉpa eṉ uyirōm punaṉē","celvk kālai niṟpiṉum","allaṟ kālai nillalaṉ maṉṉē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"இயன்மொழி","poet_ta":"கோப்பெருஞ் சோழன்","poet_tr":"Kōpperuñ Cōḻaṉ"},"scan":{"meter":"iṇaikkuṟaḷ āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"8×4, 1×2 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 33, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 21, veṇṭaḷai 12"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கவைக்கதிர்","tr":"kavaikkatir","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கவைக்","tr":"kavaik"},{"kind":"nirai","text":"கதிர்","tr":"katir"}]},{"text":"வரகி","tr":"varaki","foot":"puḷimā","acai":[{"kind":"nirai","text":"வர","tr":"vara"},{"kind":"nēr","text":"கி","tr":"ki"}]},{"text":"னவைப்புறு","tr":"ṉavaippuṟu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"னவைப்","tr":"ṉavaip"},{"kind":"nirai","text":"புறு","tr":"puṟu"}]},{"text":"வாக்கல்","tr":"vākkal","foot":"tēmā","acai":[{"kind":"nēr","text":"வாக்","tr":"vāk"},{"kind":"nēr","text":"கல்","tr":"kal"}]}],[{"text":"தாதொரு","tr":"tātoru","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nirai","text":"தொரு","tr":"toru"}]},{"text":"மறுகின்","tr":"maṟukiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மறு","tr":"maṟu"},{"kind":"nēr","text":"கின்","tr":"kiṉ"}]},{"text":"போதொடு","tr