{"text":"purananuru","n":318,"lines":["கொய்யடகு வாடத் தருவிறகு உணங்க","மயில்அம் சாயல் மாஅ யோளடு","பசித்தன்று அம்ம பெருந்தகை ஊரே","மனைஉறை குரீஇக் கறையணற் சேவல்","பாணர் நரம்பின் சுகிரொடு வயமான்","குரல்செய் பீலியின் இழைத்த குடம்பைப்","பெருஞ்செய் நெல்லின் அரிசி ஆர்ந்து தன்","புன்புறப் பெடையடு வதியும்","யாணர்த்து ஆகும்வேந்துவிழு முறினே"],"tr":["koyyaṭaku vāṭat taruviṟaku uṇaṅka","mayilam cāyal māa yōḷaṭu","pacittaṉṟu amma peruntakai ūrē","maṉaiuṟai kurīik kaṟaiyaṇaṟ cēval","pāṇar narampiṉ cukiroṭu vayamāṉ","kuralcey pīliyiṉ iḻaitta kuṭampaip","peruñcey nelliṉ arici ārntu taṉ","puṉpuṟap peṭaiyaṭu vatiyum","yāṇarttu ākumvēntuviḻu muṟiṉē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"வல்லாண் முல்லை","poet_ta":"பெருங்குன்றூர் கிழார்","poet_tr":"Peruṅkuṉṟūr Kiḻār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"9×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 36"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 21, veṇṭaḷai 14"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கொய்யட","tr":"koyyaṭa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கொய்","tr":"koy"},{"kind":"nirai","text":"யட","tr":"yaṭa"}]},{"text":"குவாடத்","tr":"kuvāṭat","foot":"puḷimā","acai":[{"kind":"nirai","text":"குவா","tr":"kuvā"},{"kind":"nēr","text":"டத்","tr":"ṭat"}]},{"text":"தருவிற","tr":"taruviṟa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தரு","tr":"taru"},{"kind":"nirai","text":"விற","tr":"viṟa"}]},{"text":"குணங்க","tr":"kuṇaṅka","foot":"puḷimā","acai":[{"kind":"nirai","text":"குணங்","tr":"kuṇaṅ"},{"kind":"nēr","text":"க","tr":"ka"}]}],[{"text":"மயிலம்","tr":"mayilam","foot":"puḷimā","acai":[{"kind":"nirai","text":"மயி","tr":"mayi"},{"kind":"nēr","text":"லம்","tr":"lam"}]},{"text":"சாயல்","tr":"cāyal","foot":"tēmā","acai":[{"kind":"nēr","text":"சா","tr":"cā"},{"kind":"nēr","text":"யல்","tr":"yal"}]},{"text":"மாஅ","tr":"māa",