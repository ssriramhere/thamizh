{"text":"purananuru","n":330,"lines":["வேந்துடைத் தானை முனைகெட நெரிதர","ஏந்துவாள் வலத்தன் ஒருவன் ஆகித்","தன்இறந்து வாராமை விலக்கலின் பெருங் கடற்கு","ஆழி அனையன் மாதோ என்றும்","பாடிச் சென்றோர்க்கு அன்றியும் வாரிப்","புரவிற்கு ஆற்றாச் சீறூர்த்","தொன்மை சுட்டிய வண்மை யோனே"],"tr":["vēntuṭait tāṉai muṉaikeṭa neritara","ēntuvāḷ valattaṉ oruvaṉ ākit","taṉiṟantu vārāmai vilakkaliṉ peruṅ kaṭaṟku","āḻi aṉaiyaṉ mātō eṉṟum","pāṭic ceṉṟōrkku aṉṟiyum vārip","puraviṟku āṟṟāc cīṟūrt","toṉmai cuṭṭiya vaṇmai yōṉē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"மூதின் முல்லை","poet_ta":"மதுரை கணக்காயனார்","poet_tr":"Maturai Kaṇakkāyaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 9, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வேந்துடைத்","tr":"vēntuṭait","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வேந்","tr":"vēn"},{"kind":"nirai","text":"துடைத்","tr":"tuṭait"}]},{"text":"தானை","tr":"tāṉai","foot":"tēmā","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"னை","tr":"ṉai"}]},{"text":"முனைகெட","tr":"muṉaikeṭa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"முனை","tr":"muṉai"},{"kind":"nirai","text":"கெட","tr":"keṭa"}]},{"text":"நெரிதர","tr":"neritara","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நெரி","tr":"neri"},{"kind":"nirai","text":"தர","tr":"tara"}]}],[{"text":"வேந்துவாள்","tr":"vēntuvāḷ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வேந்","tr":"vēn"},{"kind":"nirai","text":"துவாள்","tr":"tuvāḷ"}]},{"text":"வலத்த","tr":"valatta","foot":"puḷimā","acai":[{"kind":"nirai","text":"வலத்","tr":"valat"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"னொருவ","tr":"ṉoruva","foot":"puḷimā","acai":[{"kind":"nirai","text":"னொரு","tr":"ṉoru"},{"kind":"nēr","te