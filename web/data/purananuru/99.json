{"text":"purananuru","n":99,"lines":["அமரர்ப் பேணியும் ஆவுதி அருத்தியும்","அரும்பெறல் மரபின் கரும்பு இவண் தந்தும்","நீர்அக இருக்கை ஆழி சூட்டிய","தொன்னிலை மரபின் நின் முன்னோர் போல","ஈகைஅம் கழற்கால் இரும்பனம் புடையல்","பூவார் காவின் புனிற்றுப் புலால் நெடுவேல்","எழுபொறி நாட்டத்து எழாஅத் தாயம்","வழுவின்று எய்தியும் அமையாய் செருவேட்டு","இமிழ்குரல் முரசின் எழுவரொடு முரணிச்","சென்று அமர் கடந்து நின் ஆற்றல் தோற்றிய","அன்றும் பாடுநர்க்கு அரியை இன்றும்","பரணன் பாடினன் மற்கொல் மற்று நீ","முரண் மிகு கோவலூர் நூறி நின்","அரண் அடு திகிரி ஏந்திய தோளே","வட்கர் போகிய வளரிளம் போந்தை","உச்சிக் கொண்ட ஊசி வெண்தோட்டு"],"tr":["amararp pēṇiyum āvuti aruttiyum","arumpeṟal marapiṉ karumpu ivaṇ tantum","nīraka irukkai āḻi cūṭṭiya","toṉṉilai marapiṉ niṉ muṉṉōr pōla","īkaiam kaḻaṟkāl irumpaṉam puṭaiyal","pūvār kāviṉ puṉiṟṟup pulāl neṭuvēl","eḻupoṟi nāṭṭattu eḻāat tāyam","vaḻuviṉṟu eytiyum amaiyāy ceruvēṭṭu","imiḻkural muraciṉ eḻuvaroṭu muraṇic","ceṉṟu amar kaṭantu niṉ āṟṟal tōṟṟiya","aṉṟum pāṭunarkku ariyai iṉṟum","paraṇaṉ pāṭiṉaṉ maṟkol maṟṟu nī","muraṇ miku kōvalūr nūṟi niṉ","araṇ aṭu tikiri ēntiya tōḷē","vaṭkar pōkiya vaḷariḷam pōntai","uccik koṇṭa ūci veṇtōṭṭu"],"colophon":{},"scan":{"meter":"not a regular āciriyappā","ok":false,"checks":[{"name":"lines","ok":true,"detail":"16 lines"},{"name":"feet per line","ok":true,"detail":"15×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 60, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 36, veṇṭaḷai 24, kalittaḷai 2"},{"name":"ending","ok":false,"detail":"no usual ending"}],"ending":null,"lines":[[{"text":"அமரர்ப்","tr":"amararp","foot":"puḷimā","acai":[{"kind":"nirai","text":"அம","tr":"ama"},{"kind":"nēr","text":"ரர்ப்","tr":"rarp"}]},{"text":"பேணியு","tr":"pēṇiyu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பே","tr":"pē"},{"kind":"nirai","text":"ணியு","tr":"ṇiyu"}]},{"text":"மாவுதி","tr":"māvuti","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"வுதி","tr":"vuti"}]},{"text":"யருத்தியு","tr":"yaruttiyu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"யருத்","tr":"yarut"},{"kind":"nirai","text":"தியு","tr":"tiyu"}]}],[{"text":"மரும்பெறல்","tr":"marumpeṟal","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மரும்","tr":"marum"},{"kind":"nirai","text":"பெறல்","tr":"peṟal"}]},{"text":"மரபின்","tr":"marapiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மர","tr":"mara"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]},{"text":"கரும்பிவண்","tr":"karumpivaṇ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கரும்","tr":"karum"},{"kind":"nirai","text":"பிவண்","tr":"pivaṇ"}]},{"text":"தந்தும்","tr":"tantum","foot":"tēmā","acai":[{"kind":"nēr","text":"தந்","tr":"tan"},{"kind":"nēr","text":"தும்","tr":"tum"}]}],[{"text":"நீரக","tr":"nīraka","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nirai","text":"ரக","tr":"raka"}]},{"text":"விருக்கை","tr":"virukkai","foot":"puḷimā","acai":[{"kind":"nirai","text":"விருக்","tr":"viruk"},{"kind":"nēr","text":"கை","tr":"kai"}]},{"text":"யாழி","tr":"yāḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"சூட்டிய","tr":"cūṭṭiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சூட்","tr":"cūṭ"},{"kind":"nirai","text":"டிய","tr":"ṭiya"}]}],[{"text":"தொன்னிலை","tr":"toṉṉilai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தொன்","tr":"toṉ"},{"kind":"nirai","text":"னிலை","tr":"ṉilai"}]},{"text":"மரபின்","tr":"marapiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மர","tr":"mara"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]},{"text":"நின்முன்னோர்","tr":"niṉmuṉṉōr","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"நின்","tr":"niṉ"},{"kind":"nēr","text":"முன்","tr":"muṉ"},{"kind":"nēr","text":"னோர்","tr":"ṉōr"}]},{"text":"போல","tr":"pōla","foot":"tēmā","acai":[{"kind":"nēr","text":"போ","tr":"pō"},{"kind":"nēr","text":"ல","tr":"la"}]}],[{"text":"வீகையம்","tr":"vīkaiyam","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"வீ","tr":"vī"},{"kind":"nēr","text":"