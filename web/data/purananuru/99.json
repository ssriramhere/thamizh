{"text":"purananuru","n":99,"lines":["அமரர்ப் பேணியும் ஆவுதி அருத்தியும்","அரும்பெறல் மரபின் கரும்பு இவண் தந்தும்","நீர்அக இருக்கை ஆழி சூட்டிய","தொன்னிலை மரபின் நின் முன்னோர் போல","ஈகைஅம் கழற்கால் இரும்பனம் புடையல்","பூவார் காவின் புனிற்றுப் புலால் நெடுவேல்","எழுபொறி நாட்டத்து எழாஅத் தாயம்","வழுவின்று எய்தியும் அமையாய் செருவேட்டு","இமிழ்குரல் முரசின் எழுவரொடு முரணிச்","சென்று அமர் கடந்து நின் ஆற்றல் தோற்றிய","அன்றும் பாடுநர்க்கு அரியை இன்றும்","பரணன் பாடினன் மற்கொல் மற்று நீ","முரண் மிகு கோவலூர் நூறி நின்","அரண் அடு திகிரி ஏந்திய தோளே","வட்கர் போகிய வளரிளம் போந்தை","உச்சிக் கொண்ட ஊசி வெண்தோட்டு"],"tr":["amararp pēṇiyum āvuti aruttiyum","arumpeṟal marapiṉ karumpu ivaṇ tantum","nīraka irukkai āḻi cūṭṭiya","toṉṉilai marapiṉ niṉ muṉṉōr pōla","īkaiam kaḻaṟkāl irumpaṉam puṭaiyal","pūvār kāviṉ puṉiṟṟup pulāl neṭuvēl","eḻupoṟi nāṭṭattu eḻāat tāyam","vaḻuviṉṟu eytiyum amaiyāy ceruvēṭṭu","imiḻkural muraciṉ eḻuvaroṭu muraṇic","ceṉṟu amar kaṭantu niṉ āṟṟal tōṟṟiya","aṉṟum pāṭunarkku ariyai iṉṟum","paraṇaṉ pāṭiṉaṉ maṟkol maṟṟu nī","muraṇ miku kōvalūr nūṟi niṉ","araṇ aṭu tikiri ēntiya tōḷē","vaṭkar pōkiya vaḷariḷam pōntai","uccik koṇṭa ūci veṇtōṭṭu"],"colophon":{},"scan":{"meter":"not a regular āciriyappā","ok":false,"checks":[{"name":"lines","ok":true,"detail":"16 lines"},{"name":"feet per line","ok":true,"detail":"15×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 60, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 36, veṇṭaḷai 24, kalittaḷai 2"},{"name":"ending","ok":false,"detail":"no usual ending"}],"ending":null,"lines":[[{"text":"அமரர்ப்","tr":"amararp","foot":"puḷimā","acai":[{"kind":"nirai","text":"அம","tr":"ama"},{"kind":"nēr","text":"ரர்ப்","tr":"rarp"}]},{"text":"பேணியு","tr":"pēṇiyu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பே","tr":"pē"},{"kind":"nirai","text":"ணியு","tr":"ṇiyu"}]},{"text":"மாவுதி","tr":"māvuti","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"வுதி","tr":"vuti"}]},{"text":"யருத்தியு","tr":"yaruttiyu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"யருத்","tr":"yarut"},{"kind":"nirai","text":"தியு","tr":"tiyu"}]}],[{"text":"மரும்பெறல்","tr":"marumpeṟal","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மரும்","tr":"marum"},{"kind":"nirai","text":"பெறல்","tr":"peṟal"}]},{"text":"மரபின்","tr":"marapiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மர","tr":"mara"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]},{"text":"கரும்பிவண்","tr":"karumpivaṇ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கரும்","tr":"karum"},{"kind":"nirai","text":"பிவண்","tr":"pivaṇ"}]},{"text":"தந்தும்","tr":"tantum","foot":"tēmā","acai":[{"kind":"nēr","text":"தந்","tr":"tan"},{"kind":"nēr","text":"தும்","tr":"tum"}]}],[{"text":"நீரக","tr":"nīraka","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nirai","text":"ரக","tr":"raka"}]},{"text":"விருக்கை","tr":"virukkai","foot":"puḷimā","acai":[{"kind":"nirai","text":"விருக்","tr":"viruk"},{"kind":"nēr","text":"கை","tr":"kai"}]},{"text":"யாழி","tr":"yāḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"சூட்டிய","tr":"cūṭṭiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சூட்","tr":"cūṭ"},{"kind":"nirai","text":"டிய","tr":"ṭiya"}]}],[{"text":"தொன்னிலை","tr":"toṉṉilai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தொன்","tr":"toṉ"},{"kind":"nirai","text":"னிலை","tr":"ṉilai"}]},{"text":"மரபின்","tr":"marapiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மர","tr":"mara"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]},{"text":"நின்முன்னோர்","tr":"niṉmuṉṉōr","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"நின்","tr":"niṉ"},{"kind":"nēr","text":"முன்","tr":"muṉ"},{"kind":"nēr","text":"னோர்","tr":"ṉōr"}]},{"text":"போல","tr":"pōla","foot":"tēmā","acai":[{"kind":"nēr","text":"போ","tr":"pō"},{"kind":"nēr","text":"ல","tr":"la"}]}],[{"text":"வீகையம்","tr":"vīkaiyam","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"வீ","tr":"vī"},{"kind":"nēr","text":"கை","tr":"kai"},{"kind":"nēr","text":"யம்","tr":"yam"}]},{"text":"கழற்கா","tr":"kaḻaṟkā","foot":"puḷimā","acai":[{"kind":"nirai","text":"கழற்","tr":"kaḻaṟ"},{"kind":"nēr","text":"கா","tr":"kā"}]},{"text":"லிரும்பனம்","tr":"lirumpaṉam","foot":"karuviḷam","acai":[{"kind":"nirai","text":"லிரும்","tr":"lirum"},{"kind":"nirai","text":"பனம்","tr":"paṉam"}]},{"text":"புடையல்","tr":"puṭaiyal","foot":"puḷimā","acai":[{"kind":"nirai","text":"புடை","tr":"puṭai"},{"kind":"nēr","text":"யல்","tr":"yal"}]}],[{"text":"பூவார்","tr":"pūvār","foot":"tēmā","acai":[{"kind":"nēr","text":"பூ","tr":"pū"},{"kind":"nēr","text":"வார்","tr":"vār"}]},{"text":"காவின்","tr":"kāviṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"வின்","tr":"viṉ"}]},{"text":"புனிற்றுப்","tr":"puṉiṟṟup","foot":"puḷimā","acai":[{"kind":"nirai","text":"புனிற்","tr":"puṉiṟ"},{"kind":"nēr","text":"றுப்","tr":"ṟup"}]},{"text":"புலால்நெடுவே","tr":"pulālneṭuvē","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"புலால்","tr":"pulāl"},{"kind":"nirai","text":"நெடு","tr":"neṭu"},{"kind":"nēr","text":"வே","tr":"vē"}]}],[{"text":"லெழுபொறி","tr":"leḻupoṟi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"லெழு","tr":"leḻu"},{"kind":"nirai","text":"பொறி","tr":"poṟi"}]},{"text":"நாட்டத்","tr":"nāṭṭat","foot":"tēmā","acai":[{"kind":"nēr","text":"நாட்","tr":"nāṭ"},{"kind":"nēr","text":"டத்","tr":"ṭat"}]},{"text":"தெழாஅத்","tr":"teḻāat","foot":"puḷimā","acai":[{"kind":"nirai","text":"தெழா","tr":"teḻā"},{"kind":"nēr","text":"அத்","tr":"at"}]},{"text":"தாயம்","tr":"tāyam","foot":"tēmā","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"யம்","tr":"yam"}]}],[{"text":"வழுவின்","tr":"vaḻuviṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"வழு","tr":"vaḻu"},{"kind":"nēr","text":"வின்","tr":"viṉ"}]},{"text":"றெய்தியு","tr":"ṟeytiyu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"றெய்","tr":"ṟey"},{"kind":"nirai","text":"தியு","tr":"tiyu"}]},{"text":"மமையாய்","tr":"mamaiyāy","foot":"puḷimā","acai":[{"kind":"nirai","text":"மமை","tr":"mamai"},{"kind":"nēr","text":"யாய்","tr":"yāy"}]},{"text":"செருவேட்","tr":"ceruvēṭ","foot":"puḷimā","acai":[{"kind":"nirai","text":"செரு","tr":"ceru"},{"kind":"nēr","text":"வேட்","tr":"vēṭ"}]}],[{"text":"டிமிழ்குரல்","tr":"ṭimiḻkural","foot":"karuviḷam","acai":[{"kind":"nirai","text":"டிமிழ்","tr":"ṭimiḻ"},{"kind":"nirai","text":"குரல்","tr":"kural"}]},{"text":"முரசி","tr":"muraci","foot":"puḷimā","acai":[{"kind":"nirai","text":"முர","tr":"mura"},{"kind":"nēr","text":"சி","tr":"ci"}]},{"text":"னெழுவரொ","tr":"ṉeḻuvaro","foot":"karuviḷam","acai":[{"kind":"nirai","text":"னெழு","tr":"ṉeḻu"},{"kind":"nirai","text":"வரொ","tr":"varo"}]},{"text":"டுமுரணிச்","tr":"ṭumuraṇic","foot":"karuviḷam","acai":[{"kind":"nirai","text":"டுமு","tr":"ṭumu"},{"kind":"nirai","text":"ரணிச்","tr":"raṇic"}]}],[{"text":"சென்றமர்","tr":"ceṉṟamar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சென்","tr":"ceṉ"},{"kind":"nirai","text":"றமர்","tr":"ṟamar"}]},{"text":"கடந்துநின்","tr":"kaṭantuniṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கடந்","tr":"kaṭan"},{"kind":"nirai","text":"துநின்","tr":"tuniṉ"}]},{"text":"னாற்றல்","tr":"ṉāṟṟal","foot":"tēmā","acai":[{"kind":"nēr","text":"னாற்","tr":"ṉāṟ"},{"kind":"nēr","text":"றல்","tr":"ṟal"}]},{"text":"தோற்றிய","tr":"tōṟṟiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தோற்","tr":"tōṟ"},{"kind":"nirai","text":"றிய","tr":"ṟiya"}]}],[{"text":"வன்றும்","tr":"vaṉṟum","foot":"tēmā","acai":[{"kind":"nēr","text":"வன்","tr":"vaṉ"},{"kind":"nēr","text":"றும்","tr":"ṟum"}]},{"text":"பாடுநர்க்","tr":"pāṭunark","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nirai","text":"டுநர்க்","tr":"ṭunark"}]},{"text":"கரியை","tr":"kariyai","foot":"puḷimā","acai":[{"kind":"nirai","text":"கரி","tr":"kari"},{"kind":"nēr","text":"யை","tr":"yai"}]},{"text":"யின்றும்","tr":"yiṉṟum","foot":"tēmā","acai":[{"kind":"nēr","text":"யின்","tr":"yiṉ"},{"kind":"nēr","text":"றும்","tr":"ṟum"}]}],[{"text":"பரணன்","tr":"paraṇaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பர","tr":"para"},{"kind":"nēr","text":"ணன்","tr":"ṇaṉ"}]},{"text":"பாடினன்","tr":"pāṭiṉaṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nirai","text":"டினன்","tr":"ṭiṉaṉ"}]},{"text":"மற்கொல்","tr":"maṟkol","foot":"tēmā","acai":[{"kind":"nēr","text":"மற்","tr":"maṟ"},{"kind":"nēr","text":"கொல்","tr":"kol"}]},{"text":"மற்றுநீ","tr":"maṟṟunī","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மற்","tr":"maṟ"},{"kind":"nirai","text":"றுநீ","tr":"ṟunī"}]}],[{"text":"முரண்மிகு","tr":"muraṇmiku","foot":"karuviḷam","acai":[{"kind":"nirai","text":"முரண்","tr":"muraṇ"},{"kind":"nirai","text":"மிகு","tr":"miku"}]},{"text":"கோவலூர்","tr":"kōvalūr","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கோ","tr":"kō"},{"kind":"nirai","text":"வலூர்","tr":"valūr"}]},{"text":"நூறிநின்","tr":"nūṟiniṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நூ","tr":"nū"},{"kind":"nirai","text":"றிநின்","tr":"ṟiniṉ"}]}],[{"text":"னரணடு","tr":"ṉaraṇaṭu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"னர","tr":"ṉara"},{"kind":"nirai","text":"ணடு","tr":"ṇaṭu"}]},{"text":"திகிரி","tr":"tikiri","foot":"puḷimā","acai":[{"kind":"nirai","text":"திகி","tr":"tiki"},{"kind":"nēr","text":"ரி","tr":"ri"}]},{"text":"யேந்திய","tr":"yēntiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யேந்","tr":"yēn"},{"kind":"nirai","text":"திய","tr":"tiya"}]},{"text":"தோளே","tr":"tōḷē","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ளே","tr":"ḷē"}]}],[{"text":"வட்கர்","tr":"vaṭkar","foot":"tēmā","acai":[{"kind":"nēr","text":"வட்","tr":"vaṭ"},{"kind":"nēr","text":"கர்","tr":"kar"}]},{"text":"போகிய","tr":"pōkiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"போ","tr":"pō"},{"kind":"nirai","text":"கிய","tr":"kiya"}]},{"text":"வளரிளம்","tr":"vaḷariḷam","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வள","tr":"vaḷa"},{"kind":"nirai","text":"ரிளம்","tr":"riḷam"}]},{"text":"போந்தை","tr":"pōntai","foot":"tēmā","acai":[{"kind":"nēr","text":"போந்","tr":"pōn"},{"kind":"nēr","text":"தை","tr":"tai"}]}],[{"text":"யுச்சிக்","tr":"yuccik","foot":"tēmā","acai":[{"kind":"nēr","text":"யுச்","tr":"yuc"},{"kind":"nēr","text":"சிக்","tr":"cik"}]},{"text":"கொண்ட","tr":"koṇṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"கொண்","tr":"koṇ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"வூசிவெண்","tr":"vūciveṇ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வூ","tr":"vū"},{"kind":"nirai","text":"சிவெண்","tr":"civeṇ"}]},{"text":"தோட்டு","tr":"tōṭṭu","foot":"tēmā","acai":[{"kind":"nēr","text":"தோட்","tr":"tōṭ"},{"kind":"nēr","text":"டு","tr":"ṭu"}]}]]},"ai":null}