{"text":"purananuru","n":80,"lines":["இன்கடுங் கள்ளின் ஆமூர் ஆங்கண்","மைந்துடைமல்லன் மதவலி முருக்கி","ஒருகால் மார்பொதுங் கின்றே ஒருகால்","வருதார் தாங்கிப் பின்னெதுங் கின்றே","நல்கினும் நல்கான் ஆயினும் வெல்போர்ப்","போர் அருந் தித்தன் காண்கதில் அம்ம","பசித்துப் பணைமுயலும் யானை போல","இருதலை ஒசிய எற்றிக்","களம்புகும் மல்லன் கடந்துஅடு நிலையே"],"tr":["iṉkaṭuṅ kaḷḷiṉ āmūr āṅkaṇ","maintuṭaimallaṉ matavali murukki","orukāl mārpotuṅ kiṉṟē orukāl","varutār tāṅkip piṉṉetuṅ kiṉṟē","nalkiṉum nalkāṉ āyiṉum velpōrp","pōr arun tittaṉ kāṇkatil amma","pacittup paṇaimuyalum yāṉai pōla","irutalai ociya eṟṟik","kaḷampukum mallaṉ kaṭantuaṭu nilaiyē"],"colophon":{"tinai":"tumpai","tinai_ta":"தும்பை","turai_ta":"எருமை மறம்","poet_ta":"சாத்தந்தையார்","addressed_ta":"சோழன் போர்வைக்கோப் பெருநற்கிள்ளி","poet_tr":"Cāttantaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"8×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 34, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 19, āciriyattaḷai 15"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இன்கடுங்","tr":"iṉkaṭuṅ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"இன்","tr":"iṉ"},{"kind":"nirai","text":"கடுங்","tr":"kaṭuṅ"}]},{"text":"கள்ளி","tr":"kaḷḷi","foot":"tēmā","acai":[{"kind":"nēr","text":"கள்","tr":"kaḷ"},{"kind":"nēr","text":"ளி","tr":"ḷi"}]},{"text":"னாமூ","tr":"ṉāmū","foot":"tēmā","acai":[{"kind":"nēr","text":"னா","tr":"ṉā"},{"kind":"nēr","text":"மூ","tr":"mū"}]},{"text":"ராங்கண்","tr":"rāṅkaṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"ராங்","tr":"rāṅ"},{"kind":"nēr","text":"கண்","tr":"kaṇ"}]}],[{"text":"மைந்துடை","tr":"maintuṭai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மைந்","tr":"main"},{"kind":"nirai","text":"துடை","tr":"tuṭai"}]},{"text":"மல்லன்","tr":"mallaṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"மல்","tr":"mal"},{"kind":"nēr","text":"லன்","tr":"laṉ"}]},{"t