{"text":"purananuru","n":90,"lines":["உடைவளை கடுப்ப மலர்ந்த காந்தள்","அடைமல்கு குளவியடு கமழும் சாரல்","மறப்புலி உடலின் மான்கணம் உளவோ","மருளின விசும்பின் மாதிரத்து ஈண்டிய","இருளும் உண்டோ ஞாயிறு சினவின்","அச்சொடு தாக்கிப் பாருற்று இயங்கிய","பண்டச் சாகாட்டு ஆழ்ச்சி சொல்லிய","விரிமணல் ஞெமரக் கல்பக நடக்கும்","பெருமிதப் பகட்டுக்குத் துறையும் உண்டோ","எழுமரம் கடுக்கும் தாள்தோய் தடக்கை","வழுவில் வன்கை மழவர் பெரும","இருநில மண் கொண்டு சிலைக்கும்","பொருநரும் உளரோ நீ களம் புகினே"],"tr":["uṭaivaḷai kaṭuppa malarnta kāntaḷ","aṭaimalku kuḷaviyaṭu kamaḻum cāral","maṟappuli uṭaliṉ māṉkaṇam uḷavō","maruḷiṉa vicumpiṉ mātirattu īṇṭiya","iruḷum uṇṭō ñāyiṟu ciṉaviṉ","accoṭu tākkip pāruṟṟu iyaṅkiya","paṇṭac cākāṭṭu āḻcci colliya","virimaṇal ñemarak kalpaka naṭakkum","perumitap pakaṭṭukkut tuṟaiyum uṇṭō","eḻumaram kaṭukkum tāḷtōy taṭakkai","vaḻuvil vaṉkai maḻavar peruma","irunila maṇ koṇṭu cilaikkum","porunarum uḷarō nī kaḷam pukiṉē"],"colophon":{"tinai":"tumpai","tinai_ta":"தும்பை","turai_ta":"தானை மறம்","poet_ta":"ஔவையார்","addressed_ta":"அதியமான் நெடுமான் அஞ்சி","poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"13 lines"},{"name":"feet per line","ok":true,"detail":"12×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 48, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 29, veṇṭaḷai 18, kalittaḷai 3"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"உடைவளை","tr":"uṭaivaḷai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"உடை","tr":"uṭai"},{"kind":"nirai","text":"வளை","tr":"vaḷai"}]},{"text":"கடுப்ப","tr":"kaṭuppa","foot":"puḷimā","acai":[{"kind":"nirai","text":"கடுப்","tr":"kaṭup"},{"kind":"nēr","text":"ப","tr":"pa"}]},{"text":"மலர்ந்த","tr":"malarnta","foot":"puḷimā","acai":[{"kind":"nirai","text":"மலர்ந்","tr":"malarn"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"காந்த","tr":"kānta","foot":"tēmā","acai":[{"kind":"nēr","text":"காந்","tr":"kān"},{"kind":"nēr",