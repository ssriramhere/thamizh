{"text":"purananuru","n":276,"lines":["நல்லுரை துறந்த நறைவெண் கூந்தல்","இருங்காழ் அன்ன திரங்குகண் வறுமுலைச்","செம்முது பெண்டின் காதலஞ் சிறாஅன்","மடப்பால் ஆய்மகள் வள்உகிர்த் தெறித்த","குடப்பால் சில்லுறை போலப்","படைக்குநோய் எல்லாம் தான்ஆ யினனே"],"tr":["nallurai tuṟanta naṟaiveṇ kūntal","iruṅkāḻ aṉṉa tiraṅkukaṇ vaṟumulaic","cemmutu peṇṭiṉ kātalañ ciṟāaṉ","maṭappāl āymakaḷ vaḷukirt teṟitta","kuṭappāl cilluṟai pōlap","paṭaikkunōy ellām tāṉā yiṉaṉē"],"colophon":{"tinai":"tumpai","tinai_ta":"தும்பை","turai_ta":"தானைநிலை","poet_ta":"மாதுரைப் பூதன் இளநாகனார்","poet_tr":"Māturaip Pūtaṉ Iḷanākaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 12, āciriyattaḷai 10"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நல்லுரை","tr":"nallurai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நல்","tr":"nal"},{"kind":"nirai","text":"லுரை","tr":"lurai"}]},{"text":"துறந்த","tr":"tuṟanta","foot":"puḷimā","acai":[{"kind":"nirai","text":"துறந்","tr":"tuṟan"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"நறைவெண்","tr":"naṟaiveṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"நறை","tr":"naṟai"},{"kind":"nēr","text":"வெண்","tr":"veṇ"}]},{"text":"கூந்த","tr":"kūnta","foot":"tēmā","acai":[{"kind":"nēr","text":"கூந்","tr":"kūn"},{"kind":"nēr","text":"த","tr":"ta"}]}],[{"text":"லிருங்கா","tr":"liruṅkā","foot":"puḷimā","acai":[{"kind":"nirai","text":"லிருங்","tr":"liruṅ"},{"kind":"nēr","text":"கா","tr":"kā"}]},{"text":"ழன்ன","tr":"ḻaṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"ழன்","tr":"ḻaṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"திரங்குகண்","tr":"tiraṅkukaṇ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"திரங்","tr":"tiraṅ"},{"kind":"nirai","text":"குகண்","tr":"kukaṇ"}]},{"text":"வறுமுலைச்","tr":"vaṟumulaic","foot":"karuviḷam","a