{"text":"purananuru","n":327,"lines":["எருது கால் உறாஅது இளைஞர் கொன்ற","சில்விளை வரகின் புல்லென் குப்பை","தொடுத்த கடவர்க்குக் கொடுத்த மிச்சில்","பசித்த பாணர் உண்டு கடை தப்பலின்","ஒக்கல் ஒற்கம் சொலியத் தன்னூர்ச்","சிறுபுல் லாளர் முகத்தவை கூறி","வரகுடன் இரக்கும் நெடுந்தகை","அரசுவரின் தாங்கும் வல்லா ளன்னே"],"tr":["erutu kāl uṟāatu iḷaiñar koṉṟa","cilviḷai varakiṉ pulleṉ kuppai","toṭutta kaṭavarkkuk koṭutta miccil","pacitta pāṇar uṇṭu kaṭai tappaliṉ","okkal oṟkam coliyat taṉṉūrc","ciṟupul lāḷar mukattavai kūṟi","varakuṭaṉ irakkum neṭuntakai","aracuvariṉ tāṅkum vallā ḷaṉṉē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"மூதின் முல்லை","poet_ta":"பெயர் தெரிந்திலது","poet_tr":"Peyar Terintilatu"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 12"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"எருதுகா","tr":"erutukā","foot":"karuviḷam","acai":[{"kind":"nirai","text":"எரு","tr":"eru"},{"kind":"nirai","text":"துகா","tr":"tukā"}]},{"text":"லுறாஅ","tr":"luṟāa","foot":"puḷimā","acai":[{"kind":"nirai","text":"லுறா","tr":"luṟā"},{"kind":"nēr","text":"அ","tr":"a"}]},{"text":"திளைஞர்","tr":"tiḷaiñar","foot":"puḷimā","acai":[{"kind":"nirai","text":"திளை","tr":"tiḷai"},{"kind":"nēr","text":"ஞர்","tr":"ñar"}]},{"text":"கொன்ற","tr":"koṉṟa","foot":"tēmā","acai":[{"kind":"nēr","text":"கொன்","tr":"koṉ"},{"kind":"nēr","text":"ற","tr":"ṟa"}]}],[{"text":"சில்விளை","tr":"cilviḷai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சில்","tr":"cil"},{"kind":"nirai","text":"விளை","tr":"viḷai"}]},{"text":"வரகின்","tr":"varakiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"வர","tr":"vara"},{"kind":"nēr","text":"கின்","tr":"kiṉ"}]},{"text":"புல்லென்","tr":"pulleṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"புல்