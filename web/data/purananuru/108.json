t":"னா","tr":"ṉā"}]},{"text":"னவர்வரை","tr":"ṉavarvarai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"னவர்","tr":"ṉavar"},{"kind":"nirai","text":"வரை","tr":"varai"}]},{"text":"யன்னே","tr":"yaṉṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"யன்","tr":"yaṉ"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"குறத்தி","parts":[{"text":"குறத்தி","lemma":"குறத்தி","gloss":"mountain woman"}],"gloss":"mountain woman"},{"surface":"மாட்டிய","parts":[{"text":"மாட்டிய","lemma":"மாட்டிய","gloss":"kindled"}],"gloss":"kindled","split_unverified":true},{"surface":"வறற்கடை","parts":[{"text":"வறல்","lemma":"வறல்","gloss":"dryness"},{"text":"கடை","lemma":"கடை","gloss":"end"}],"gloss":"dry end of wood"},{"surface":"கொள்ளி","parts":[{"text":"கொள்ளி","lemma":"கொள்ளி","gloss":"firebrand"}],"gloss":"firebrand"}]},{"words":[{"surface":"ஆரம்","parts":[{"text":"ஆரம்","lemma":"ஆரம்","gloss":"sandalwood"}],"gloss":"sandalwood"},{"surface":"ஆதலின்","parts":[{"text":"ஆதல்","lemma":"ஆதல்","gloss":"becoming"},{"text":"இன்","lemma":"இன்","gloss":"because of"}],"gloss":"because it is"},{"surface":"அம்","parts":[{"text":"அம்","lemma":"அம்","gloss":"beautiful"}],"gloss":"beautiful"},{"surface":"புகை","parts":[{"text":"புகை","lemma":"புகை","gloss":"smoke"}],"gloss":"smoke"},{"surface":"அயலது","parts":[{"text":"அயல்","lemma":"அயல்","gloss":"neighborhood"},{"text":"அது","lemma":"அது","gloss":"pronominal suffix"}],"gloss":"of the nearby place"}]},{"words":[{"surface":"சாரல்","parts":[{"text":"சாரல்","lemma":"சாரல்","gloss":"mountain slope"}],"gloss":"mountain slope"},{"surface":"வேங்கை","parts":[{"text":"வேங்கை","lemma":"வேங்கை","gloss":"kino tree"}],"gloss":"kino tree"},{"surface":"பூஞ்சினை","parts":[{"text":"பூஞ்சினை","lemma":"பூஞ்சினை","gloss":"flowering branch"}],"gloss":"flowering branch","split_unverified":true},{"surface":"தவழும்","parts":[{"text":"தவழ்","lemma":"தவழ்","gloss":"crawl"},{"text":"உம்","lemma":"உம்","gloss":"habitual future suffix"}],"gloss":"crawls"}]},{"words":[{"surface":"பறம்பு","parts":[{"text":"பறம்பு","lemma":"பறம்பு","gloss":"Parampu hill"}],"gloss":"Parampu hill"},{"surface":"பாடினர்","parts":[{"text":"பாடு","lemma":"பாடு","gloss":"sing"},{"text":"இன்","lemma":"இன்","gloss":"past tense marker"},{"text":"அர்","lemma":"அர்","gloss":"plural personal suffix"}],"gloss":"they sang"},{"surface":"அதுவே","parts":[{"text":"அது","lemma":"அது","gloss":"that"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"that indeed"},{"surface":"அறம்பூண்டு","parts":[{"text":"அறம்","lemma":"அறம்","gloss":"virtue"},{"text":"பூண்டு","lemma":"பூண்","gloss":"having undertaken"}],"gloss":"having undertaken virtue"}]},{"words":[{"surface":"பாரியும்","parts":[{"text":"பாரி","lemma":"பாரி","gloss":"Pari"},{"text":"உம்","lemma":"உம்","gloss":"also"}],"gloss":"Pari also"},{"surface":"பரிசிலர்","parts":[{"text":"பரிசில்","lemma":"பரிசில்","gloss":"gift"},{"text":"அர்","lemma":"அர்","gloss":"personal suffix"}],"gloss":"supplicants"},{"surface":"இரப்பின்","parts":[{"text":"இர","lemma":"இர","gloss":"beg"},{"text":"ப்பு","lemma":"ப்பு","gloss":"causative/formative"},{"text":"இன்","lemma":"இன்","gloss":"conditional suffix"}],"gloss":"if they ask"}]},{"words":[{"surface":"வாரேன்","parts":[{"text":"வாரேன்","lemma":"வாரேன்","gloss":"I will not give"}],"gloss":"I will not give"},{"surface":"என்னான்","parts":[{"text":"என்","lemma":"என்","gloss":"say"},{"text":"ஆன்","lemma":"ஆன்","gloss":"negative third person singular masculine suffix"}],"gloss":"he will not say"},{"surface":"அவர்","parts":[{"text":"அவர்","lemma":"அவர்","gloss":"their"}],"gloss":"their"},{"surface":"வரை","parts":[{"text":"வரை","lemma":"வரை","gloss":"mountain"}],"gloss":"mountain"},{"surface":"அன்னே","parts":[{"text":"அன்னே","lemma":"அன்னே","gloss":"like indeed"}],"gloss":"like indeed","split_unverified":true}]}],"literal":"The firebrand at the dry end kindled by the mountain woman / because it is sandalwood, its beautiful smoke, of the nearby / mountain slope, crawls on the flowering branches of the kino tree. / Those who sang of Parampu, having undertaken that very virtue, / Pari also, if supplicants ask, / will not say \"I will not give\", like their mountain.","translation":"The firebrand kindled by the mountain woman is of dry sandalwood; hence, its fragrant, beautiful smoke crawls over the flowering branches of the kino trees on the nearby mountain slopes. If supplicants come begging, Pari, who has made it his virtue to give to those who sing of his Parampu hill, will never say, \"I will not give.\" He gives as generously as his own mountain.","modern":"குறிஞ்சி நிலப் பெண் மூட்டிய காய்ந்த விறகுக் கொள்ளி சந்தன மரத்தால் ஆனது என்பதால், அதன் அழகிய நறுமணப் புகை பக்கத்திலுள்ள மலைச்சரிவில் இருக்கும் வேங்கை மரத்தின் பூத்துக் குலுங்கும் கிளைகளில் தவழ்கிறது. பறம்பு மலையைப் பாடி வரும் இரவலர்கள் கேட்கும்போது, பாரியும் 'தரமாட்டேன்' என்று சொல்லாமல், தன் மலையைப் போன்ற கொடையை அவர்களுக்கு வழங்குவான்.","explanation":"The poet Kapilar praises the extraordinary generosity of his patron, Vēḷ Pāri, the ruler of the Parampu hill. He describes the rich mountain landscape (Kuriñci) where even the firewood used by a mountain woman (kuṟatti) is precious sandalwood (āram), filling the slopes with fragrant smoke that drifts over the flowering kino (vēṅkai) trees. This rich, fragrant environment serves as a metaphor for Pari's boundless wealth and noble nature. When singers and supplicants come to Parampu hill, Pari considers it his sacred duty (aṟam) to give. He never utters a refusal (\"vārēṉ eṉṉāṉ\"), giving away his entire mountain-like wealth to those who ask.","model":"gemini-3.5-flash"}}