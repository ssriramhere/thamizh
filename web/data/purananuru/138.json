{"text":"purananuru","n":138,"lines":["ஆனினம் கலித்த அதர்பல கடந்து","மானினம் கலித்த மலையின் ஒழிய","மீளினம் கலித்த துறைபல நீந்தி","உள்ளி வந்த வள்ளுயிர்ச் சீறியாழ்","சிதாஅர் உடுக்கை முதாஅரிப் பாண","நீயே பேரெண் ணலையே நின்இறை","மாறி வா என மொழியலன் மாதோ","ஒலியிருங் கதுப்பின் ஆயிழை கணவன்","கிளி மரீஇய வியன் புனத்து","மரன் அணி பெருங்குரல் அனையன் ஆதலின்","நின்னை வருதல் அறிந்தனர் யாரே"],"tr":["āṉiṉam kalitta atarpala kaṭantu","māṉiṉam kalitta malaiyiṉ oḻiya","mīḷiṉam kalitta tuṟaipala nīnti","uḷḷi vanta vaḷḷuyirc cīṟiyāḻ","citāar uṭukkai mutāarip pāṇa","nīyē pēreṇ ṇalaiyē niṉiṟai","māṟi vā eṉa moḻiyalaṉ mātō","oliyiruṅ katuppiṉ āyiḻai kaṇavaṉ","kiḷi marīiya viyaṉ puṉattu","maraṉ aṇi peruṅkural aṉaiyaṉ ātaliṉ","niṉṉai varutal aṟintaṉar yārē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"பாணாற்றுப் படை","poet_ta":"மருதன் இளநாகனார்","addressed_ta":"ஆய் அண்டிரன்","poet_tr":"Marutaṉ Iḷanākaṉār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"11 lines"},{"name":"feet per line","ok":true,"detail":"11×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 44"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 22, veṇṭaḷai 21"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஆனினம்","tr":"āṉiṉam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nirai","text":"னினம்","tr":"ṉiṉam"}]},{"text":"கலித்த","tr":"kalitta","foot":"puḷimā","acai":[{"kind":"nirai","text":"கலித்","tr":"kalit"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"வதர்பல","tr":"vatarpala","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வதர்","tr":"vatar"},{"kind":"nirai","text":"பல","tr":"pala"}]},{"text":"கடந்து","tr":"kaṭantu","foot":"puḷimā","acai":[{"kind":"nirai","text":"கடந்","tr":"kaṭan"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"மானினம்","tr":"māṉiṉam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"னினம்","tr":"ṉiṉam"}]},{"text":"கலித்த","tr"