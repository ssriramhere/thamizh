{"text":"purananuru","n":83,"lines":["அடிபுனை தொடுகழல் மையணல் காளைக்குஎன்","தொடிகழித் திடுதல்யான் யாய்அஞ் சுவலே","அடுதோள் முயங்கல் அவைநா ணுவலே","என்போற் பெருவிதுப் புறுக என்றும்","ஒருபால் படாஅது ஆகி","இருபாற் பட்ட இம் மையல் ஊரே"],"tr":["aṭipuṉai toṭukaḻal maiyaṇal kāḷaikkueṉ","toṭikaḻit tiṭutalyāṉ yāyañ cuvalē","aṭutōḷ muyaṅkal avainā ṇuvalē","eṉpōṟ peruvitup puṟuka eṉṟum","orupāl paṭāatu āki","irupāṟ paṭṭa im maiyal ūrē"],"colophon":{"tinai":"kaikkiḷai","tinai_ta":"கைக்கிளை","turai_ta":"பழிச்சுதல்","poet_ta":"பெருங்கோழி நாய்கண் மகள் நக்கண்ணையார்","addressed_ta":"சோழன் போர்வைக்கோப் பெருநற்கிள்ளி","poet_tr":"Peruṅkōḻi Nāykaṇ Makaḷ Nakkaṇṇaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 13, āciriyattaḷai 8, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அடிபுனை","tr":"aṭipuṉai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அடி","tr":"aṭi"},{"kind":"nirai","text":"புனை","tr":"puṉai"}]},{"text":"தொடுகழல்","tr":"toṭukaḻal","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தொடு","tr":"toṭu"},{"kind":"nirai","text":"கழல்","tr":"kaḻal"}]},{"text":"மையணல்","tr":"maiyaṇal","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மை","tr":"mai"},{"kind":"nirai","text":"யணல்","tr":"yaṇal"}]},{"text":"காளைக்கென்","tr":"kāḷaikkeṉ","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"ளைக்","tr":"ḷaik"},{"kind":"nēr","text":"கென்","tr":"keṉ"}]}],[{"text":"தொடிகழித்","tr":"toṭikaḻit","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தொடி","tr":"toṭi"},{"kind":"nirai","text":"கழித்","tr":"kaḻit"}]},{"text":"திடுதல்யான்","tr":"tiṭutalyāṉ","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"திடு","tr":"tiṭu"},{"kind":"nēr","text":"தல்","tr":"tal"},{"kind":"nēr","text":"யான்","tr"