d":"nēr","text":"பட்","tr":"paṭ"},{"kind":"nirai","text":"டவிம்","tr":"ṭavim"}]},{"text":"மைய","tr":"maiya","foot":"tēmā","acai":[{"kind":"nēr","text":"மை","tr":"mai"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"லூரே","tr":"lūrē","foot":"tēmā","acai":[{"kind":"nēr","text":"லூ","tr":"lū"},{"kind":"nēr","text":"ரே","tr":"rē"}]}]]},"ai":{"lines":[{"words":[{"surface":"அடிபுனை","parts":[{"text":"அடி","lemma":"அடி","gloss":"foot"},{"text":"புனை","lemma":"புனை","gloss":"adorn"}],"gloss":"adorned on the feet"},{"surface":"தொடுகழல்","parts":[{"text":"தொடு","lemma":"தொடு","gloss":"fasten"},{"text":"கழல்","lemma":"கழல்","gloss":"warrior's anklet"}],"gloss":"fastened warrior's anklet"},{"surface":"மையணல்","parts":[{"text":"மை","lemma":"மை","gloss":"dark"},{"text":"அணல்","lemma":"அணல்","gloss":"beard"}],"gloss":"dark-bearded"},{"surface":"காளைக்கு","parts":[{"text":"காளை","lemma":"காளை","gloss":"youth"},{"text":"கு","lemma":"கு","gloss":"to"}],"gloss":"to the youth"},{"surface":"என்","parts":[{"text":"என்","lemma":"என்","gloss":"my"}],"gloss":"my"}]},{"words":[{"surface":"தொடி","parts":[{"text":"தொடி","lemma":"தொடி","gloss":"bangle"}],"gloss":"bangle"},{"surface":"கழித்திடுதல்","parts":[{"text":"கழித்து","lemma":"கழி","gloss":"slipping off"},{"text":"இடுதல்","lemma":"இடு","gloss":"doing"}],"gloss":"slipping off"},{"surface":"யான்","parts":[{"text":"யான்","lemma":"யான்","gloss":"I"}],"gloss":"I"},{"surface":"யாய்","parts":[{"text":"யாய்","lemma":"யாய்","gloss":"my mother"}],"gloss":"my mother"},{"surface":"அஞ்சுவலே","parts":[{"text":"அஞ்சுவல்","lemma":"அஞ்சு","gloss":"I fear"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"I fear indeed"}]},{"words":[{"surface":"அடுதோள்","parts":[{"text":"அடு","lemma":"அடு","gloss":"conquering"},{"text":"தோள்","lemma":"தோள்","gloss":"shoulders"}],"gloss":"conquering shoulders"},{"surface":"முயங்கல்","parts":[{"text":"முயங்கல்","lemma":"முயங்கு","gloss":"embracing"}],"gloss":"embracing"},{"surface":"அவை","parts":[{"text":"அவை","lemma":"அவை","gloss":"public assembly"}],"gloss":"public assembly"},{"surface":"நாணுவலே","parts":[{"text":"நாணுவல்","lemma":"நாணு","gloss":"I feel shy"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"I feel shy indeed"}]},{"words":[{"surface":"என்போல்","parts":[{"text":"என்","lemma":"என்","gloss":"me"},{"text":"போல்","lemma":"போல்","gloss":"like"}],"gloss":"like me"},{"surface":"பெருவிதுப்பு","parts":[{"text":"பெரு","lemma":"பெரு","gloss":"great"},{"text":"விதுப்பு","lemma":"விதுப்பு","gloss":"anxiety"}],"gloss":"great anxiety"},{"surface":"உறுக","parts":[{"text":"உறு","lemma":"உறு","gloss":"experience"},{"text":"க","lemma":"க","gloss":"optative suffix"}],"gloss":"may it experience"},{"surface":"என்றும்","parts":[{"text":"என்று","lemma":"என்று","gloss":"always"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"forever"}]},{"words":[{"surface":"ஒருபால்","parts":[{"text":"ஒரு","lemma":"ஒரு","gloss":"one"},{"text":"பால்","lemma":"பால்","gloss":"side"}],"gloss":"on one side"},{"surface":"படாஅது","parts":[{"text":"படாஅது","lemma":"படு","gloss":"not siding"}],"gloss":"without siding"},{"surface":"ஆகி","parts":[{"text":"ஆகி","lemma":"ஆகு","gloss":"becoming"}],"gloss":"becoming"}]},{"words":[{"surface":"இருபால்","parts":[{"text":"இரு","lemma":"இரு","gloss":"two"},{"text":"பால்","lemma":"பால்","gloss":"sides"}],"gloss":"into two sides"},{"surface":"பட்ட","parts":[{"text":"பட்ட","lemma":"படு","gloss":"divided"}],"gloss":"divided"},{"surface":"இம்","parts":[{"text":"இம்","lemma":"இம்","gloss":"this"}],"gloss":"this","split_unverified":true},{"surface":"மையல்","parts":[{"text":"மையல்","lemma":"மையல்","gloss":"confused"}],"gloss":"confused"},{"surface":"ஊரே","parts":[{"text":"ஊர்","lemma":"ஊர்","gloss":"town"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"town indeed"}]}],"literal":"Adorned on the feet, fastened warrior's anklet, dark-bearded youth, for him, my / bangle slipping off, I, my mother fear indeed / conquering shoulders embracing, in public assembly I feel shy indeed / like me great anxiety may it experience forever / on one side without siding / into two sides divided, this confused town indeed.","translation":"For the dark-bearded youth who wears the warrior's anklet adorning his feet, my bangles slip off in my pining, and I fear my mother. To embrace his conquering shoulders, I feel too shy in public. May this confused town, which never takes one side but is always divided into two, suffer great anxiety forever, just like me!","modern":"கால்களில் அணிந்த வீரக்கழலையும் கரிய தாடியையும் உடைய காளை போன்ற தலைவனுக்காக, என் வளையல்கள் கழன்று விழுவதை எண்ணி என் தாய்க்கு அஞ்சுகிறேன். அவனுடைய வெற்றி தரும் தோள்களைத் தழுவுவதற்குப் பொது அவையில் நாணமடைகிறேன். ஒரு பக்கமும் சாராமல், இரண்டு பக்கமாகப் பிரிந்து அலர் தூற்றும் இந்த மயக்கமுற்ற ஊரானது, என்னைப்போலவே எப்போதும் பெருந்துன்பத்தை அடையட்டும்.","explanation":"This poem belongs to the Kaikkiḷai tiṇai (one-sided love) where the poet, speaking as a young woman, expresses her unrequited love for the Chola king Peruṉaṟkiḷḷi. She is caught in a painful dilemma: her body wastes away with longing, causing her bangles to slip off, which she fears her mother will notice, yet she is too shy to embrace him in public. The townspeople, instead of being supportive, are divided into two factions, gossiping and spreading rumors without understanding her plight. Frustrated by their lack of empathy, she wishes that this confused town would experience the same intense anxiety and distress that she suffers. The key words are 'மையல் ஊர்' (confused town) and 'பெருவிதுப்பு' (great anxiety), highlighting the emotional isolation of the heroine.","model":"gemini-3.5-flash"}}