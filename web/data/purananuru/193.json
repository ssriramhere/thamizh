{"text":"purananuru","n":193,"lines":["அதள்எறிந் தன்ன நெடுவெண் களரின்","ஒருவன் ஆட்டும் புல்வாய் போல","ஓடி உய்தலும் கூடும்மன்","ஒக்கல் வாழ்க்கை தட்கும்மா காலே"],"tr":["ataḷeṟin taṉṉa neṭuveṇ kaḷariṉ","oruvaṉ āṭṭum pulvāy pōla","ōṭi uytalum kūṭummaṉ","okkal vāḻkkai taṭkummā kālē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"பொருண்மொழிக் காஞ்சி","poet_ta":"ஓரேருழவர்","poet_tr":"Ōrēruḻavar"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"4×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 15, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 5"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அதளெறிந்","tr":"ataḷeṟin","foot":"karuviḷam","acai":[{"kind":"nirai","text":"அத","tr":"ata"},{"kind":"nirai","text":"ளெறிந்","tr":"ḷeṟin"}]},{"text":"தன்ன","tr":"taṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"தன்","tr":"taṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"நெடுவெண்","tr":"neṭuveṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"நெடு","tr":"neṭu"},{"kind":"nēr","text":"வெண்","tr":"veṇ"}]},{"text":"களரி","tr":"kaḷari","foot":"puḷimā","acai":[{"kind":"nirai","text":"கள","tr":"kaḷa"},{"kind":"nēr","text":"ரி","tr":"ri"}]}],[{"text":"னொருவ","tr":"ṉoruva","foot":"puḷimā","acai":[{"kind":"nirai","text":"னொரு","tr":"ṉoru"},{"kind":"nēr","text":"வ","tr":"va"}]},{"text":"னாட்டும்","tr":"ṉāṭṭum","foot":"tēmā","acai":[{"kind":"nēr","text":"னாட்","tr":"ṉāṭ"},{"kind":"nēr","text":"டும்","tr":"ṭum"}]},{"text":"புல்வாய்","tr":"pulvāy","foot":"tēmā","acai":[{"kind":"nēr","text":"புல்","tr":"pul"},{"kind":"nēr","text":"வாய்","tr":"vāy"}]},{"text":"போல","tr":"pōla","foot":"tēmā","acai":[{"kind":"nēr","text":"போ","tr":"pō"},{"kind":"nēr","text":"ல","tr":"la"}]}],[{"text":"வோடி","tr":"vōṭi","foot":"tēmā","acai":[{"kind":"nēr","text":"வோ","tr":"vō"},{"kind":"nēr","text":"டி","tr":"ṭi"}]},{"t