{"text":"purananuru","n":194,"lines":["ஓரில் நெய்தல் கறங்க ஓர்இல்","ஈர்ந்தண் முழவின் பாணி ததும்பப்","புணர்ந்தோர் பூவணி அணியப் பிரிந்தோர்","பைதல் உண்கண் பனிவார்பு உறைப்பப்","படைத்தோன் மன்ற அப் பண்பி லாளன்","இன்னாது அம்ம இவ் வுலகம்","இனிய காண்க இதன் இயல்புணர்ந் தோரே"],"tr":["ōril neytal kaṟaṅka ōril","īrntaṇ muḻaviṉ pāṇi tatumpap","puṇarntōr pūvaṇi aṇiyap pirintōr","paital uṇkaṇ paṉivārpu uṟaippap","paṭaittōṉ maṉṟa ap paṇpi lāḷaṉ","iṉṉātu amma iv vulakam","iṉiya kāṇka itaṉ iyalpuṇarn tōrē"],"colophon":{},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 12"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஓரில்","tr":"ōril","foot":"tēmā","acai":[{"kind":"nēr","text":"ஓ","tr":"ō"},{"kind":"nēr","text":"ரில்","tr":"ril"}]},{"text":"நெய்தல்","tr":"neytal","foot":"tēmā","acai":[{"kind":"nēr","text":"நெய்","tr":"ney"},{"kind":"nēr","text":"தல்","tr":"tal"}]},{"text":"கறங்க","tr":"kaṟaṅka","foot":"puḷimā","acai":[{"kind":"nirai","text":"கறங்","tr":"kaṟaṅ"},{"kind":"nēr","text":"க","tr":"ka"}]},{"text":"வோரில்","tr":"vōril","foot":"tēmā","acai":[{"kind":"nēr","text":"வோ","tr":"vō"},{"kind":"nēr","text":"ரில்","tr":"ril"}]}],[{"text":"லீர்ந்தண்","tr":"līrntaṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"லீர்ந்","tr":"līrn"},{"kind":"nēr","text":"தண்","tr":"taṇ"}]},{"text":"முழவின்","tr":"muḻaviṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"முழ","tr":"muḻa"},{"kind":"nēr","text":"வின்","tr":"viṉ"}]},{"text":"பாணி","tr":"pāṇi","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"ணி","tr":"ṇi"}]},{"text":"ததும்பப்","tr":"tatumpap","foot":"puḷimā","acai":[{"kind":"nirai","text":"ததும்","tr":"tatum"},{"kind":"nēr","text":"பப்","tr":"pap"}]}],[{"text":"புணர்ந்தோர்","tr":"puṇarntōr","foot":