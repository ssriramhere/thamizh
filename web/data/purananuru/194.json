a"},{"kind":"nēr","text":"க","tr":"ka"}]}],[{"text":"மினியகாண்","tr":"miṉiyakāṇ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மினி","tr":"miṉi"},{"kind":"nirai","text":"யகாண்","tr":"yakāṇ"}]},{"text":"கவித","tr":"kavita","foot":"puḷimā","acai":[{"kind":"nirai","text":"கவி","tr":"kavi"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"னியல்புணர்ந்","tr":"ṉiyalpuṇarn","foot":"karuviḷam","acai":[{"kind":"nirai","text":"னியல்","tr":"ṉiyal"},{"kind":"nirai","text":"புணர்ந்","tr":"puṇarn"}]},{"text":"தோரே","tr":"tōrē","foot":"tēmā","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nēr","text":"ரே","tr":"rē"}]}]]},"ai":{"lines":[{"words":[{"surface":"ஓரில்","parts":[{"text":"ஓர்","lemma":"ōr","gloss":"one"},{"text":"இல்","lemma":"il","gloss":"house"}],"gloss":"in one house"},{"surface":"நெய்தல்","parts":[{"text":"நெய்தல்","lemma":"neytal","gloss":"funeral drum"}],"gloss":"the funeral drum"},{"surface":"கறங்க","parts":[{"text":"கறங்க","lemma":"kaṟaṅku","gloss":"to sound"}],"gloss":"sounds"},{"surface":"ஓர்இல்","parts":[{"text":"ஓர்","lemma":"ōr","gloss":"one"},{"text":"இல்","lemma":"il","gloss":"house"}],"gloss":"in another house"}]},{"words":[{"surface":"ஈர்ந்தண்","parts":[{"text":"ஈர்ந்தண்","lemma":"ஈர்ந்தண்","gloss":"cool and moist"}],"gloss":"cool and moist","split_unverified":true},{"surface":"முழவின்","parts":[{"text":"முழவு","lemma":"muḻavu","gloss":"festive drum"},{"text":"இன்","lemma":"iṉ","gloss":"of"}],"gloss":"of the festive drum"},{"surface":"பாணி","parts":[{"text":"பாணி","lemma":"pāṇi","gloss":"beat"}],"gloss":"the beat"},{"surface":"ததும்ப","parts":[{"text":"ததும்ப","lemma":"tatumpi","gloss":"to reverberate"}],"gloss":"reverberates"}]},{"words":[{"surface":"புணர்ந்தோர்","parts":[{"text":"புணர்ந்தோர்","lemma":"puṇar","gloss":"those who are united"}],"gloss":"those who are united"},{"surface":"பூவணி","parts":[{"text":"பூ","lemma":"pū","gloss":"flower"},{"text":"அணி","lemma":"aṇi","gloss":"ornament"}],"gloss":"flower ornaments"},{"surface":"அணிய","parts":[{"text":"அணிய","lemma":"aṇi","gloss":"to wear"}],"gloss":"wear"},{"surface":"பிரிந்தோர்","parts":[{"text":"பிரிந்தோர்","lemma":"piri","gloss":"those who are separated"}],"gloss":"those who are separated"}]},{"words":[{"surface":"பைதல்","parts":[{"text":"பைதல்","lemma":"paital","gloss":"grief"}],"gloss":"with grief"},{"surface":"உண்கண்","parts":[{"text":"உண்","lemma":"uṇ","gloss":"kohl-lined"},{"text":"கண்","lemma":"kaṇ","gloss":"eye"}],"gloss":"kohl-lined eyes"},{"surface":"பனிவார்பு","parts":[{"text":"பனி","lemma":"paṉi","gloss":"tears"},{"text":"வார்பு","lemma":"vār","gloss":"flowing"}],"gloss":"shedding tears"},{"surface":"உறைப்ப","parts":[{"text":"உறைப்ப","lemma":"uṟai","gloss":"to drip"}],"gloss":"drip"}]},{"words":[{"surface":"படைத்தோன்","parts":[{"text":"படைத்தோன்","lemma":"paṭai","gloss":"he who created"}],"gloss":"the creator"},{"surface":"மன்ற","parts":[{"text":"மன்ற","lemma":"maṉṟa","gloss":"surely"}],"gloss":"surely"},{"surface":"அ","parts":[{"text":"அ","lemma":"a","gloss":"that"}],"gloss":"that"},{"surface":"பண்பிலாளன்","parts":[{"text":"பண்பு","lemma":"paṇpu","gloss":"virtue"},{"text":"இலாளன்","lemma":"ilāḷaṉ","gloss":"one who lacks"}],"gloss":"graceless person"}]},{"words":[{"surface":"இன்னாது","parts":[{"text":"இன்னாது","lemma":"iṉṉātu","gloss":"unpleasant"}],"gloss":"is unpleasant"},{"surface":"அம்ம","parts":[{"text":"அம்ம","lemma":"amma","gloss":"alas"}],"gloss":"alas"},{"surface":"இவ்","parts":[{"text":"இவ்","lemma":"இவ்","gloss":"this"}],"gloss":"this","split_unverified":true},{"surface":"உலகம்","parts":[{"text":"உலகம்","lemma":"ulakam","gloss":"world"}],"gloss":"world"}]},{"words":[{"surface":"இனிய","parts":[{"text":"இனிய","lemma":"iṉiya","gloss":"pleasant things"}],"gloss":"pleasant things"},{"surface":"காண்க","parts":[{"text":"காண்க","lemma":"kāṇ","gloss":"may they seek"}],"gloss":"may they seek"},{"surface":"இதன்","parts":[{"text":"இதன்","lemma":"itu","gloss":"of this"}],"gloss":"its"},{"surface":"இயல்புணர்ந்தோரே","parts":[{"text":"இயல்பு","lemma":"iyalpu","gloss":"nature"},{"text":"உணர்ந்தோரே","lemma":"uṇar","gloss":"those who understand indeed"}],"gloss":"those who understand the nature"}]}],"literal":"In one house, the funeral drum sounds; in another house, / the beat of the cool, moist festive drum reverberates. / Those who are united wear flower ornaments; those who are separated, / with grief, shed tears that drip from their kohl-lined eyes. / The creator is surely a graceless person. / Unpleasant, alas, is this world. / May they seek pleasant things, those who understand its nature.","translation":"In one house, the funeral drum tolls; in another, the festive drum beats joyfully. Those who are united adorn themselves with flowers; those who are parted weep, tears dripping from their dark, kohl-lined eyes. Surely, the creator who made this world is a heartless, graceless being. Alas, this world is full of pain! Therefore, let those who understand its true nature seek out and cherish whatever is sweet and pleasant.","modern":"ஒரு வீட்டில் சாவுப் பறை ஒலிக்கிறது; மற்றொரு வீட்டில் குளிர்ந்த முழவின் திருமண இசை முழங்குகிறது. கணவரோடு கூடிய மகளிர் மலர் மாலைகளை அணிகின்றனர்; பிரிந்த மகளிர் வருத்தத்தோடு மை தீட்டிய கண்களிலிருந்து கண்ணீர் வடிக்கின்றனர். இந்த உலகத்தைப் படைத்தவன் இரக்கமில்லாத பண்பற்றவன் ஆவான். ஐயோ, இவ்வுலகம் துன்பம் நிறைந்தது! ஆகவே, இதன் இயல்பை உணர்ந்தவர்கள் இதில் உள்ள இன்பமானவற்றைத் தேடி நுகரக்கடவர்.","explanation":"This poem belongs to the Potuviyal tiṇai (general themes) and reflects on the transience and contradictory nature of human life. The poet Pakkutukkai Nankaniyar contrasts the simultaneous existence of extreme grief and extreme joy in the world. In one household, people mourn a death to the sound of the funeral drum (neytal), while next door, a wedding or festival is celebrated with the joyous beat of the festive drum (mulavu). Similarly, some couples enjoy the bliss of union, while others suffer the agony of separation. Seeing these stark contradictions, the poet declares that the creator of such a world must be entirely devoid of grace (pampilan). He concludes with a philosophical advice: since the world is inherently painful and unpredictable, those who understand this reality should actively seek out and appreciate whatever goodness and joy they can find.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,0.7],[0.7,1.1],[1.1,1.5],[1.5,2.5],[2.5,2.6],[2.6,3.2],[3.2,3.3],[3.3,4.6],[4.6,4.8],[4.8,5.1],[5.1,5.4],[5.4,7.1],[7.1,7.4],[7.4,7.9],[7.9,8.44],[8.44,9.6],[9.6,9.6],[9.6,10.0],[10.0,10.3],[10.3,10.8],[10.8,12.4],[12.4,12.5],[12.5,12.67],[12.67,13.0],[13.0,14.2],[14.2,14.5],[14.5,14.8],[14.8,15.36],[15.36,15.4]],"female":[[0.0,0.7],[0.7,0.8],[0.8,1.2],[1.2,1.6],[1.6,2.8],[2.8,2.9],[2.9,3.6],[3.6,3.6],[3.6,5.1],[5.1,5.4],[5.4,5.7],[5.7,6.1],[6.1,7.6],[7.6,7.8],[7.8,8.3],[8.3,8.76],[8.76,10.0],[10.0,10.1],[10.1,10.4],[10.4,10.6],[10.6,11.0],[11.0,12.5],[12.5,12.8],[12.8,12.97],[12.97,13.3],[13.3,14.3],[14.3,14.6],[14.6,14.9],[14.9,15.46],[15.46,15.5]]},"sync":[[["ஓரில்","in one house"]],[["நெய்தல்","the funeral drum"]],[["கறங்க","sounds"]],[["ஓர்இல்","in another house"]],[["ஈர்ந்தண்","cool and moist"]],[["முழவின்","of the festive drum"]],[["பாணி","the beat"]],[["ததும்ப","reverberates"]],[["புணர்ந்தோர்","those who are united"]],[["பூவணி","flower ornaments"]],[["அணிய","wear"],["பிரிந்தோர்","those who are separated"]],[["பிரிந்தோர்","those who are separated"]],[["பைதல்","with grief"]],[["உண்கண்","kohl-lined eyes"]],[["பனிவார்பு","shedding tears"]],[["உறைப்ப","drip"]],[["படைத்தோன்","the creator"]],[["மன்ற","surely"]],[["அ","that"],["பண்பிலாளன்","graceless person"]],[["பண்பிலாளன்","graceless person"]],[["பண்பிலாளன்","graceless person"]],[["இன்னாது","is unpleasant"]],[["அம்ம","alas"]],[["இவ்","this"]],[["உலகம்","world"]],[["இனிய","pleasant things"]],[["காண்க","may they seek"]],[["இதன்","its"]],[["இயல்புணர்ந்தோரே","those who understand the nature"]],[["இயல்புணர்ந்தோரே","those who understand the nature"]]]}