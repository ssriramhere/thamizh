{"text":"purananuru","n":127,"lines":["களங் கனி யன்ன கருங்கோட்டுச் சீறி யாழ்ப்","பாடு இன் பனுவல் பாணர் உய்த்தெனக்","களிறில வாகிய புல்லரை நெடுவெளிற்","கான மஞ்ஞை கணனுடு சேப்ப","ஈகை அரிய இழையணி மகளிரொடு","சாயின்று என்ப ஆஅய் கோயில்","சுவைக்கு இனி தாகிய குய்யுடை அடிசில்","பிறர்க்கு ஈவு இன்றித் தம் வயிறு அருத்தி","உரைசால் ஓங்குபுகழ் ஒரிஇய","முரைசு கெழு செல்வர் நகர்போ லாதே"],"tr":["kaḷaṅ kaṉi yaṉṉa karuṅkōṭṭuc cīṟi yāḻp","pāṭu iṉ paṉuval pāṇar uytteṉak","kaḷiṟila vākiya pullarai neṭuveḷiṟ","kāṉa maññai kaṇaṉuṭu cēppa","īkai ariya iḻaiyaṇi makaḷiroṭu","cāyiṉṟu eṉpa āay kōyil","cuvaikku iṉi tākiya kuyyuṭai aṭicil","piṟarkku īvu iṉṟit tam vayiṟu arutti","uraicāl ōṅkupukaḻ oriiya","muraicu keḻu celvar nakarpō lātē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"கடைஇநிலை","poet_ta":"உறையூர் ஏணிச்சேரி முடமோசியார்","addressed_ta":"வேள் ஆய் அரண்டின்","poet_tr":"Uṟaiyūr Ēṇiccēri Muṭamōciyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"10 lines"},{"name":"feet per line","ok":true,"detail":"10×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 38, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 23, āciriyattaḷai 16"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"களங்கனி","tr":"kaḷaṅkaṉi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"களங்","tr":"kaḷaṅ"},{"kind":"nirai","text":"கனி","tr":"kaṉi"}]},{"text":"யன்ன","tr":"yaṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"யன்","tr":"yaṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"கருங்கோட்டுச்","tr":"karuṅkōṭṭuc","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"கருங்","tr":"karuṅ"},{"kind":"nēr","text":"கோட்","tr":"kōṭ"},{"kind":"nēr","text":"டுச்","tr":"ṭuc"}]},{"text":"சீறியாழ்ப்","tr":"cīṟiyāḻp","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சீ","tr":"cī"},{"kind":"nirai","text":"றியாழ்ப்","tr":"ṟiyāḻp"}]}],[{"text":"பாடின்","tr":"pāṭiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":