{"text":"purananuru","n":313,"lines":["அத்தம் நண்ணிய நாடுகெழு பெருவிறல்","கைப்பொருள் யாதொன்றும் இலனே நச்சிக்","காணிய சென்ற இரவன் மாக்கள்","களிறொடு நெடுந்தேர் வேண்டினும் கடவ","உப்பொய் சாகாட்டு உமணர் காட்ட","கழிமுரி குன்றத்து அற்றே","எள் அமைவு இன்று அவன் உள்ளிய பொருளே"],"tr":["attam naṇṇiya nāṭukeḻu peruviṟal","kaipporuḷ yātoṉṟum ilaṉē naccik","kāṇiya ceṉṟa iravaṉ mākkaḷ","kaḷiṟoṭu neṭuntēr vēṇṭiṉum kaṭava","uppoy cākāṭṭu umaṇar kāṭṭa","kaḻimuri kuṉṟattu aṟṟē","eḷ amaivu iṉṟu avaṉ uḷḷiya poruḷē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"வல்லான் முல்லை","poet_ta":"மாங்குடி மருதனார்","poet_tr":"Māṅkuṭi Marutaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 12, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அத்தம்","tr":"attam","foot":"tēmā","acai":[{"kind":"nēr","text":"அத்","tr":"at"},{"kind":"nēr","text":"தம்","tr":"tam"}]},{"text":"நண்ணிய","tr":"naṇṇiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நண்","tr":"naṇ"},{"kind":"nirai","text":"ணிய","tr":"ṇiya"}]},{"text":"நாடுகெழு","tr":"nāṭukeḻu","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nirai","text":"டுகெ","tr":"ṭuke"},{"kind":"nēr","text":"ழு","tr":"ḻu"}]},{"text":"பெருவிறல்","tr":"peruviṟal","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெரு","tr":"peru"},{"kind":"nirai","text":"விறல்","tr":"viṟal"}]}],[{"text":"கைப்பொருள்","tr":"kaipporuḷ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கைப்","tr":"kaip"},{"kind":"nirai","text":"பொருள்","tr":"poruḷ"}]},{"text":"யாதொன்","tr":"yātoṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"தொன்","tr":"toṉ"}]},{"text":"றுமிலனே","tr":"ṟumilaṉē","foot":"karuviḷam","acai":[{"kind":"nirai","text":"றுமி