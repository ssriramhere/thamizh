{"text":"purananuru","n":40,"lines":["நீயே பிறர் ஓம்புறு மறமன் னெயில்","ஓம்பாது கடந்தட்டு அவர்","முடி புனைந்த பசும் பொன்னின்","அடி பொலியக் கழல் தைஇய","வல் லாளனை வய வேந்தே","யாமே நின் இகழ் பாடுவோர் எருத்தடங்கப்","புகழ் பாடுவோர் பொலிவு தோன்ற","இன்றுகண் டாங்குக் காண்குவம் என்றும்","இன்சொல் எண்பதத்தை ஆகுமதி பெரும","ஒருபிடி படியுஞ் சீறிடம்","எழுகளிறு புரக்கும் நாடுகிழ வோயே"],"tr":["nīyē piṟar ōmpuṟu maṟamaṉ ṉeyil","ōmpātu kaṭantaṭṭu avar","muṭi puṉainta pacum poṉṉiṉ","aṭi poliyak kaḻal taiiya","val lāḷaṉai vaya vēntē","yāmē niṉ ikaḻ pāṭuvōr eruttaṭaṅkap","pukaḻ pāṭuvōr polivu tōṉṟa","iṉṟukaṇ ṭāṅkuk kāṇkuvam eṉṟum","iṉcol eṇpatattai ākumati peruma","orupiṭi paṭiyuñ cīṟiṭam","eḻukaḷiṟu purakkum nāṭukiḻa vōyē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"செவியறிவுறூஉ","poet_ta":"ஆவூர் மூலங்கிழார்","addressed_ta":"சோழன் குளமுற்றத்துத் துஞ்சிய கிள்ளிவளவன்","poet_tr":"Āvūr Mūlaṅkiḻār"},"scan":{"meter":"not a regular āciriyappā","ok":false,"checks":[{"name":"lines","ok":true,"detail":"11 lines"},{"name":"feet per line","ok":false,"detail":"5×4, 6×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 36, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 20, veṇṭaḷai 15, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நீயே","tr":"nīyē","foot":"tēmā","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nēr","text":"யே","tr":"yē"}]},{"text":"பிறரோம்","tr":"piṟarōm","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிற","tr":"piṟa"},{"kind":"nēr","text":"ரோம்","tr":"rōm"}]},{"text":"புறும","tr":"puṟuma","foot":"puḷimā","acai":[{"kind":"nirai","text":"புறு","tr":"puṟu"},{"kind":"nēr","text":"ம","tr":"ma"}]},{"text":"றமன்னெயி","tr":"ṟamaṉṉeyi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"றமன்","tr":"ṟamaṉ"},{"kind":"nirai","text":"னெயி","tr":"ṉeyi"}]}],[{"text":"லோம்பா","tr":"lōmpā","foot":"tēmā","acai":[{"kind":"nēr","text":"லோம்","tr":"lōm"},{"kind":"nēr","text":"பா","tr":"pā"}]},{"text":"துகடந்",