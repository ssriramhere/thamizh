{"text":"purananuru","n":286,"lines":["வெள்ளை வெள்யாட்டுச் செச்சை போலத்","தன்னோர் அன்ன இளையர் இருப்பப்","பலர்மீது நீட்டிய மண்டைஎன் சிறுவனைக்","கால்வழி கட்டிலிற் கிடப்பித்","தூவெள் அறுவை போர்ப்பித் திலதே"],"tr":["veḷḷai veḷyāṭṭuc ceccai pōlat","taṉṉōr aṉṉa iḷaiyar iruppap","palarmītu nīṭṭiya maṇṭaieṉ ciṟuvaṉaik","kālvaḻi kaṭṭiliṟ kiṭappit","tūveḷ aṟuvai pōrppit tilatē"],"colophon":{"tinai":"karantai","tinai_ta":"கரந்தை","turai_ta":"வேத்தியல்","poet_ta":"ஔவையார்","poet_tr":"Auvaiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"5×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 10, āciriyattaḷai 8, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வெள்ளை","tr":"veḷḷai","foot":"tēmā","acai":[{"kind":"nēr","text":"வெள்","tr":"veḷ"},{"kind":"nēr","text":"ளை","tr":"ḷai"}]},{"text":"வெள்யாட்டுச்","tr":"veḷyāṭṭuc","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"வெள்","tr":"veḷ"},{"kind":"nēr","text":"யாட்","tr":"yāṭ"},{"kind":"nēr","text":"டுச்","tr":"ṭuc"}]},{"text":"செச்சை","tr":"ceccai","foot":"tēmā","acai":[{"kind":"nēr","text":"செச்","tr":"cec"},{"kind":"nēr","text":"சை","tr":"cai"}]},{"text":"போலத்","tr":"pōlat","foot":"tēmā","acai":[{"kind":"nēr","text":"போ","tr":"pō"},{"kind":"nēr","text":"லத்","tr":"lat"}]}],[{"text":"தன்னோ","tr":"taṉṉō","foot":"tēmā","acai":[{"kind":"nēr","text":"தன்","tr":"taṉ"},{"kind":"nēr","text":"னோ","tr":"ṉō"}]},{"text":"ரன்ன","tr":"raṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"ரன்","tr":"raṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"விளைய","tr":"viḷaiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"விளை","tr":"viḷai"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"ரிருப்பப்","tr":"riruppap","foot":"puḷimā","acai":[{"kind":"nirai","text":"ரிருப்","tr":"rirup"},{"kind":"nēr","text":"பப்","tr":"pap"}]}],[{"