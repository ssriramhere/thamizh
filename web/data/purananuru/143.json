"lemma":"iraṅku","gloss":"sound/roar"},{"text":"உம்","lemma":"-um","gloss":"adjectival participle suffix"}],"gloss":"roaring"},{"surface":"அருவி","parts":[{"text":"அருவி","lemma":"aruvi","gloss":"waterfall"}],"gloss":"waterfall"}]},{"words":[{"surface":"நளி","parts":[{"text":"நளி","lemma":"naḷi","gloss":"dense/cold"}],"gloss":"dense"},{"surface":"இரும்","parts":[{"text":"இரும்","lemma":"irum","gloss":"dark/big"}],"gloss":"dark"},{"surface":"சிலம்பின்","parts":[{"text":"சிலம்பு","lemma":"silampu","gloss":"mountain slope"},{"text":"இன்","lemma":"-iṉ","gloss":"genitive suffix"}],"gloss":"of the mountain slope"},{"surface":"சீறூர்","parts":[{"text":"சீறூர்","lemma":"சீறூர்","gloss":"small village"}],"gloss":"small village","split_unverified":true},{"surface":"ஆங்கண்","parts":[{"text":"ஆங்கண்","lemma":"ஆங்கண்","gloss":"in that place"}],"gloss":"in that place","split_unverified":true}]},{"words":[{"surface":"வாயில்","parts":[{"text":"வாயில்","lemma":"vāyil","gloss":"doorway"}],"gloss":"doorway"},{"surface":"தோன்றி","parts":[{"text":"தோன்று","lemma":"tōṉṟu","gloss":"appear"},{"text":"இ","lemma":"-i","gloss":"verbal participle suffix"}],"gloss":"appearing"},{"surface":"வாழ்த்தி","parts":[{"text":"வாழ்த்து","lemma":"vāḻttu","gloss":"praise"},{"text":"இ","lemma":"-i","gloss":"verbal participle suffix"}],"gloss":"praising"},{"surface":"நின்று","parts":[{"text":"நின்று","lemma":"நின்று","gloss":"standing"}],"gloss":"standing","split_unverified":true}]},{"words":[{"surface":"நின்னும்","parts":[{"text":"நின்","lemma":"nī","gloss":"you (oblique)"},{"text":"உம்","lemma":"-um","gloss":"and/also"}],"gloss":"you too"},{"surface":"நின்","parts":[{"text":"நின்","lemma":"nī","gloss":"your"}],"gloss":"your"},{"surface":"மலையும்","parts":[{"text":"மலை","lemma":"malai","gloss":"mountain"},{"text":"உம்","lemma":"-um","gloss":"and/also"}],"gloss":"mountain too"},{"surface":"பாட","parts":[{"text":"பாடு","lemma":"pāṭu","gloss":"sing"},{"text":"அ","lemma":"-a","gloss":"infinitive suffix"}],"gloss":"when singing"},{"surface":"இன்னாது","parts":[{"text":"இன்னாது","lemma":"iṉṉātu","gloss":"painfully"}],"gloss":"painfully"}]},{"words":[{"surface":"இகுத்த","parts":[{"text":"இகு","lemma":"iku","gloss":"shed/pour"},{"text":"த்த","lemma":"-tta","gloss":"adjectival participle suffix"}],"gloss":"shed"},{"surface":"கண்ணீர்","parts":[{"text":"கண்","lemma":"kaṇ","gloss":"eye"},{"text":"நீர்","lemma":"nīr","gloss":"water"}],"gloss":"tears"},{"surface":"நிறுத்தல்","parts":[{"text":"நிறுத்து","lemma":"niṟuttu","gloss":"stop"},{"text":"அல்","lemma":"-al","gloss":"verbal noun suffix"}],"gloss":"stopping"},{"surface":"செல்லாள்","parts":[{"text":"செல்","lemma":"cel","gloss":"go/be able"},{"text":"ஆள்","lemma":"-āḷ","gloss":"feminine negative singular suffix"}],"gloss":"she who is unable"}]},{"words":[{"surface":"முலையகம்","parts":[{"text":"முலை","lemma":"mulai","gloss":"breast"},{"text":"அகம்","lemma":"akam","gloss":"chest/interior"}],"gloss":"chest"},{"surface":"நனைப்ப","parts":[{"text":"நனை","lemma":"naṉai","gloss":"wet/drench"},{"text":"ப்ப","lemma":"-ppa","gloss":"infinitive suffix"}],"gloss":"to drench"},{"surface":"விம்மி","parts":[{"text":"விம்மு","lemma":"vimmu","gloss":"sob"},{"text":"இ","lemma":"-i","gloss":"verbal participle suffix"}],"gloss":"sobbing"}]},{"words":[{"surface":"குழல்","parts":[{"text":"குழல்","lemma":"kuḻal","gloss":"flute"}],"gloss":"flute"},{"surface":"இனைவது","parts":[{"text":"இனை","lemma":"iṉai","gloss":"grieve/sound sadly"},{"text":"வது","lemma":"-vatu","gloss":"nominalizing suffix"}],"gloss":"grieving"},{"surface":"போல்","parts":[{"text":"போல்","lemma":"pōl","gloss":"like"}],"gloss":"like"},{"surface":"அழுதனள்","parts":[{"text":"அழுதனள்","lemma":"அழுதனள்","gloss":"she wept"}],"gloss":"she wept","split_unverified":true},{"surface":"பெரிதே","parts":[{"text":"பெரிது","lemma":"peritu","gloss":"greatly"},{"text":"ஏ","lemma":"-ē","gloss":"emphatic particle"}],"gloss":"greatly"}]}],"literal":"Saying \"May the mountain sky receive [it]\", scattering high offerings / Saying \"May the rain cease and the clouds rise upwards\", / the Kuravar people who worshipped the deity, / with joy when the rain ceased, on the mountain slope / eating the beautiful millet, O lord of the land! In angry war / with generous-handed charity and swift horses, O Pegan! / Who is she, so pitiable, herself, yesterday, / because her kinsfolk who suffered traversing the difficult path were hungry, / near the waterfall roaring like a drum struck by a drumstick, / in that small village on the dense, dark mountain slope, / appearing at the doorway, standing and praising, / when singing of you and your mountain, painfully / unable to stop the shed tears, / sobbing so that they drenched her chest, / wept greatly, like a grieving flute?","translation":"O Pegan, lord of the land where Kuravar people worship the deity with high offerings so that the mountain sky may receive them, and pray for the rain to cease and the clouds to rise upwards, and then joyfully eat beautiful millet on the slopes when the rain stops! O Pegan of angry wars, generous-handed charity, and swift horses! Who is she, that pitiable woman? Yesterday, because her kinsfolk who had suffered traversing the difficult path were hungry, she appeared at the doorway of a small village on the dense, dark mountain slope where waterfalls roar like drums struck by drumsticks. Standing there and praising, as she sang of you and your mountain, she could not stop her falling tears. Sobbing so that they drenched her chest, she wept bitterly, sounding like a grieving flute.","modern":"மலையில் உள்ள மேகம் மழையைப் பொழியட்டும் என்று உயர்ந்த பலியைத் தூவி, பின்னர் மழை நின்று மேகங்கள் மேலே உயரட்டும் என்று தெய்வத்தை வழிபட்ட குறவர்கள், மழை நின்ற மகிழ்ச்சியோடு மலைச்சாரலில் விளைந்த தினையை உண்ணும் நாட்டை உடையவனே! சினங்கொண்ட போரையும், வாரி வழங்கும் கொடையையும், வேகமான குதிரைகளையும் உடைய பேகனே! நேற்று, கடினமான வழியில் நடந்து பசியால் வருந்திய தன் சுற்றத்தாருக்காக, முரசு போல முழங்கும் அருவிகளைக் கொண்ட அடர்ந்த கரிய மலைச்சாரலில் உள்ள ஒரு சிறு ஊரின் வீட்டு வாசலில் வந்து நின்று, உன்னையும் உன் மலையையும் பாடினாள். அப்போது, துன்பத்தோடு சிந்திய கண்ணீரை நிறுத்த முடியாமல், தன் மார்பகம் நனையுமாறு விம்மி அழுது, குழல் இசைப்பது போலப் பெரிதும் அழுதாள். அந்த இரங்கத்தக்கவள் யார்?","explanation":"The poet Kapilar is addressing the chieftain Vaiyāvik Kōpperum Pēkaṉ, who has abandoned his wife Kaṇṇaki. Kapilar describes a pitiable woman (Kaṇṇaki) whom he encountered in a small mountain village. When the poet sang praises of Pegan and his mountain, this woman began to weep uncontrollably, her tears drenching her chest. Her sobbing sounded like the mournful notes of a grieving flute. By asking Pegan \"Who is this woman?\", Kapilar subtly and powerfully reminds the chieftain of his wife's deep suffering and urges him to return to her.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,0.93],[1.0,1.2],[1.2,1.7],[1.7,1.9],[1.9,2.8],[2.8,3.1],[3.1,3.7],[3.7,3.97],[4.1,4.3],[4.3,5.3],[5.3,5.7],[5.7,5.9],[5.9,6.2],[6.2,7.3],[7.3,7.9],[7.9,8.1],[8.1,8.4],[8.4,8.4],[8.4,8.4],[8.4,10.5],[10.5,10.7],[10.8,11.1],[11.1,12.13],[12.13,12.3],[12.3,12.8],[12.8,12.9],[12.9,14.2],[14.2,14.7],[14.7,14.8],[14.8,15.2],[15.2,16.2],[16.2,16.3],[16.3,16.9],[16.9,17.0],[17.09,17.8],[18.44,19.14],[19.14,19.54],[19.54,19.94],[19.94,20.34],[20.34,21.44],[21.44,21.54],[21.54,22.04],[22.04,22.34],[22.34,23.34],[23.34,23.74],[23.74,23.84],[23.84,24.24],[24.24,25.44],[25.44,25.64],[25.64,26.24],[26.24,26.24],[26.24,27.44],[27.44,28.04],[28.04,28.24],[28.24,28.44],[28.44,28.44],[28.44,28.44],[28.44,28.44],[28.44,31.54],[31.54,32.04],[32.04,32.24],[32.24,32.74]],"female":[[0.0,0.8],[0.8,1.05],[1.1,1.4],[1.4,1.9],[1.9,2.1],[2.1,3.1],[3.1,3.4],[3.4,4.4],[4.4,4.67],[4.8,5.1],[5.1,6.0],[6.0,6.3],[6.3,6.6],[6.6,6.9],[6.9,8.0],[8.0,8.6],[8.6,8.8],[8.8,9.2],[9.2,9.72],[9.72,9.72],[9.72,9.72],[9.72,9.72],[9.72,12.3],[12.3,13.2],[13.2,13.3],[13.3,13.8],[13.8,14.3],[14.3,15.5],[15.5,15.9],[15.9,16.1],[16.1,16.4],[16.4,17.6],[17.