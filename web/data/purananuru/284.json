{"text":"purananuru","n":284,"lines":["வருகதில் வல்லே வருகதில் வல் என","வேந்துவிடு விழுத்தூது ஆங்காங்கு இசைப்ப","நூலரி மாலை சூடிக் காலின்","தமியன் வந்த மூதி லாளன்","அருஞ்சமம் தாங்கி முன்னின்று எறிந்த","ஒருகை இரும்பிணத்து எயிறு மிறையாகத்","திரிந்த வாய்வாள் திருத்தாத்","தனக்குஇரிந் தானைப் பெயர்புறம் நகுமே"],"tr":["varukatil vallē varukatil val eṉa","vēntuviṭu viḻuttūtu āṅkāṅku icaippa","nūlari mālai cūṭik kāliṉ","tamiyaṉ vanta mūti lāḷaṉ","aruñcamam tāṅki muṉṉiṉṟu eṟinta","orukai irumpiṇattu eyiṟu miṟaiyākat","tirinta vāyvāḷ tiruttāt","taṉakkuirin tāṉaip peyarpuṟam nakumē"],"colophon":{"tinai":"tumpai","tinai_ta":"தும்பை","turai_ta":"பண்பாட்டு","poet_ta":"ஓரம் போகியார்","poet_tr":"Ōram Pōkiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 29, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 17, āciriyattaḷai 11, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வருகதில்","tr":"varukatil","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வரு","tr":"varu"},{"kind":"nirai","text":"கதில்","tr":"katil"}]},{"text":"வல்லே","tr":"vallē","foot":"tēmā","acai":[{"kind":"nēr","text":"வல்","tr":"val"},{"kind":"nēr","text":"லே","tr":"lē"}]},{"text":"வருகதில்","tr":"varukatil","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வரு","tr":"varu"},{"kind":"nirai","text":"கதில்","tr":"katil"}]},{"text":"வல்லென","tr":"valleṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வல்","tr":"val"},{"kind":"nirai","text":"லென","tr":"leṉa"}]}],[{"text":"வேந்துவிடு","tr":"vēntuviṭu","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"வேந்","tr":"vēn"},{"kind":"nirai","text":"துவி","tr":"tuvi"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"விழுத்தூ","tr":"viḻuttū","foot":"puḷimā","acai":[{"kind":"nirai","text":"விழுத்","tr":"viḻut"},{"kind":"nēr","text":"தூ","tr":"tū"}]},{"text"