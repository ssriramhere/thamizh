{"text":"purananuru","n":277,"lines":["மீன்உண் கொக்கின் தூவிஅன்ன","வால்நரைக் கூந்தல் முதியோள் சிறுவன்","களிறுஎறிந்து பட்டனன் என்னும் உவகை","ஈன்ற ஞான்றினும் பெரிதே கண்ணீர்","நோன்கழை துயல்வரும் வெதிரத்து","வான்பெயத் தூங்கிய சிதரினும் பலவே"],"tr":["mīṉuṇ kokkiṉ tūviaṉṉa","vālnaraik kūntal mutiyōḷ ciṟuvaṉ","kaḷiṟueṟintu paṭṭaṉaṉ eṉṉum uvakai","īṉṟa ñāṉṟiṉum peritē kaṇṇīr","nōṉkaḻai tuyalvarum vetirattu","vāṉpeyat tūṅkiya citariṉum palavē"],"colophon":{"tinai":"tumpai","tinai_ta":"தும்பை","turai_ta":"உவகைக் கலுழ்ச்சி","poet_ta":"பூங்கணுத்திரையார்","poet_tr":"Pūṅkaṇuttiraiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"6×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 24"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மீனுண்","tr":"mīṉuṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"மீ","tr":"mī"},{"kind":"nēr","text":"னுண்","tr":"ṉuṇ"}]},{"text":"கொக்கின்","tr":"kokkiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"கொக்","tr":"kok"},{"kind":"nēr","text":"கின்","tr":"kiṉ"}]},{"text":"தூவி","tr":"tūvi","foot":"tēmā","acai":[{"kind":"nēr","text":"தூ","tr":"tū"},{"kind":"nēr","text":"வி","tr":"vi"}]},{"text":"யன்ன","tr":"yaṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"யன்","tr":"yaṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]}],[{"text":"வால்நரைக்","tr":"vālnaraik","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வால்","tr":"vāl"},{"kind":"nirai","text":"நரைக்","tr":"naraik"}]},{"text":"கூந்தல்","tr":"kūntal","foot":"tēmā","acai":[{"kind":"nēr","text":"கூந்","tr":"kūn"},{"kind":"nēr","text":"தல்","tr":"tal"}]},{"text":"முதியோள்","tr":"mutiyōḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"முதி","tr":"muti"},{"kind":"nēr","text":"யோள்","tr":"yōḷ"}]},{"text":"சிறுவன்","tr":"ciṟuvaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nēr