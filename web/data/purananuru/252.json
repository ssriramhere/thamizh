{"text":"purananuru","n":252,"lines":["கறங்குவெள் அருவி ஏற்றலின் நிறம் பெயர்ந்து","தில்லை அன்ன புல்லென் சடையோடு","அள்இலைத் தாளி கொய்யு மோனே","இல்வழங்கு மடமயில் பிணிக்கும்","சொல்வலை வேட்டுவன் ஆயினன் முன்னே"],"tr":["kaṟaṅkuveḷ aruvi ēṟṟaliṉ niṟam peyarntu","tillai aṉṉa pulleṉ caṭaiyōṭu","aḷilait tāḷi koyyu mōṉē","ilvaḻaṅku maṭamayil piṇikkum","colvalai vēṭṭuvaṉ āyiṉaṉ muṉṉē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"தாபத வாகை","poet_ta":"மாற்பித்தியார்","poet_tr":"Māṟpittiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"5×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 20"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 6"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கறங்குவெ","tr":"kaṟaṅkuve","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கறங்","tr":"kaṟaṅ"},{"kind":"nirai","text":"குவெ","tr":"kuve"}]},{"text":"ளருவியேற்","tr":"ḷaruviyēṟ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"ளரு","tr":"ḷaru"},{"kind":"nirai","text":"வியேற்","tr":"viyēṟ"}]},{"text":"றலின்நிறம்","tr":"ṟaliṉniṟam","foot":"karuviḷam","acai":[{"kind":"nirai","text":"றலின்","tr":"ṟaliṉ"},{"kind":"nirai","text":"நிறம்","tr":"niṟam"}]},{"text":"பெயர்ந்து","tr":"peyarntu","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெயர்ந்","tr":"peyarn"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"தில்லை","tr":"tillai","foot":"tēmā","acai":[{"kind":"nēr","text":"தில்","tr":"til"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"யன்ன","tr":"yaṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"யன்","tr":"yaṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"புல்லென்","tr":"pulleṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"புல்","tr":"pul"},{"kind":"nēr","text":"லென்","tr":"leṉ"}]},{"text":"சடையோ","tr":"caṭaiyō","foot":"puḷimā","acai":[{"kind":"nirai","text":"சடை","tr":"caṭai"},{"kind":"nēr","text":"யோ","tr":"yō"