{"text":"purananuru","n":130,"lines":["விளங்குமணிக் கொடும்பூண் ஆஅய் நின்னாட்டு","இளம்பிடி ஒருசூல் பத்து ஈனும்மோ","நின்னும் நின் மலையும் பாடி வருநர்க்கு","இன்முகம் கரவாது உவந்து நீ அளித்த","அண்ணல் யானை எண்ணின் கொங்கர்க்","குடகடல் ஓட்டிய ஞான்றைத்","தலைப்பெயர்த் திட்ட வேலினும் பலவே"],"tr":["viḷaṅkumaṇik koṭumpūṇ āay niṉṉāṭṭu","iḷampiṭi orucūl pattu īṉummō","niṉṉum niṉ malaiyum pāṭi varunarkku","iṉmukam karavātu uvantu nī aḷitta","aṇṇal yāṉai eṇṇiṉ koṅkark","kuṭakaṭal ōṭṭiya ñāṉṟait","talaippeyart tiṭṭa vēliṉum palavē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"இயன் மொழி","poet_ta":"உறையூர் ஏணிச்சேரி முடமோசியார்","addressed_ta":"ஆய் அண்டிரன்","poet_tr":"Uṟaiyūr Ēṇiccēri Muṭamōciyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 9, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"விளங்குமணிக்","tr":"viḷaṅkumaṇik","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"விளங்","tr":"viḷaṅ"},{"kind":"nirai","text":"கும","tr":"kuma"},{"kind":"nēr","text":"ணிக்","tr":"ṇik"}]},{"text":"கொடும்பூ","tr":"koṭumpū","foot":"puḷimā","acai":[{"kind":"nirai","text":"கொடும்","tr":"koṭum"},{"kind":"nēr","text":"பூ","tr":"pū"}]},{"text":"ணாஅய்","tr":"ṇāay","foot":"tēmā","acai":[{"kind":"nēr","text":"ணா","tr":"ṇā"},{"kind":"nēr","text":"அய்","tr":"ay"}]},{"text":"நின்னாட்","tr":"niṉṉāṭ","foot":"tēmā","acai":[{"kind":"nēr","text":"நின்","tr":"niṉ"},{"kind":"nēr","text":"னாட்","tr":"ṉāṭ"}]}],[{"text":"டிளம்பிடி","tr":"ṭiḷampiṭi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"டிளம்","tr":"ṭiḷam"},{"kind":"nirai","text":"பிடி","tr":"piṭi"}]},{"text":"யொருசூல்","tr":"yorucūl","foot":"puḷimā","acai":[{"kind":"nirai","text":"யொரு","tr":"yoru"},{"kind":"nēr","text":"சூல்","tr":"cūl"}]},{"