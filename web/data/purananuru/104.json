:"nirai","text":"பெற","tr":"peṟa"},{"kind":"nirai","text":"லரி","tr":"lari"}]},{"text":"தாடே","tr":"tāṭē","foot":"tēmā","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"டே","tr":"ṭē"}]}]]},"ai":{"lines":[{"words":[{"surface":"போற்றுமின்","parts":[{"text":"போற்று","lemma":"போற்று","gloss":"protect"},{"text":"மின்","lemma":"மின்","gloss":"plural imperative suffix"}],"gloss":"protect yourselves"},{"surface":"மறவீர்","parts":[{"text":"மறம்","lemma":"மறம்","gloss":"bravery"},{"text":"வீர்","lemma":"வீர்","gloss":"pronominal suffix for second person plural"}],"gloss":"O warriors"},{"surface":"சாற்றுதும்","parts":[{"text":"சாற்று","lemma":"சாற்று","gloss":"declare"},{"text":"தும்","lemma":"தும்","gloss":"first person plural future suffix"}],"gloss":"we declare"},{"surface":"நும்மை","parts":[{"text":"நும்","lemma":"நீயிர்","gloss":"you (plural)"},{"text":"ஐ","lemma":"ஐ","gloss":"accusative case marker"}],"gloss":"to you"}]},{"words":[{"surface":"ஊர்","parts":[{"text":"ஊர்","lemma":"ஊர்","gloss":"town"}],"gloss":"town"},{"surface":"குறு","parts":[{"text":"குறு","lemma":"குறு","gloss":"small"}],"gloss":"small"},{"surface":"மாக்கள்","parts":[{"text":"மாக்கள்","lemma":"மாக்கள்","gloss":"children"}],"gloss":"children"},{"surface":"ஆட","parts":[{"text":"ஆடு","lemma":"ஆடு","gloss":"bathe"},{"text":"அ","lemma":"அ","gloss":"infinitive suffix"}],"gloss":"to bathe"},{"surface":"கலங்கும்","parts":[{"text":"கலங்கு","lemma":"கலங்கு","gloss":"become stirred up"},{"text":"உம்","lemma":"உம்","gloss":"relative participle suffix"}],"gloss":"that is stirred up"}]},{"words":[{"surface":"தாள்","parts":[{"text":"தாள்","lemma":"தாள்","gloss":"leg"}],"gloss":"leg"},{"surface":"படு","parts":[{"text":"படு","lemma":"படு","gloss":"reaching"}],"gloss":"reaching"},{"surface":"சில்","parts":[{"text":"சில்","lemma":"சில்","gloss":"little"}],"gloss":"little"},{"surface":"நீர்","parts":[{"text":"நீர்","lemma":"நீர்","gloss":"water"}],"gloss":"water"},{"surface":"களிறு","parts":[{"text":"களிறு","lemma":"களிறு","gloss":"male elephant"}],"gloss":"male elephant"},{"surface":"அட்டு","parts":[{"text":"அட்டு","lemma":"அட்டு","gloss":"having killed"}],"gloss":"having killed","split_unverified":true},{"surface":"வீழ்க்கும்","parts":[{"text":"வீழ்க்கும்","lemma":"வீழ்க்கும்","gloss":"that drags down"}],"gloss":"that drags down","split_unverified":true}]},{"words":[{"surface":"ஈர்ப்பு","parts":[{"text":"ஈர்","lemma":"ஈர்","gloss":"drag"},{"text":"ப்பு","lemma":"ப்பு","gloss":"noun derivative suffix"}],"gloss":"dragging power"},{"surface":"உடை","parts":[{"text":"உடை","lemma":"உடை","gloss":"having"}],"gloss":"having"},{"surface":"கராஅத்து","parts":[{"text":"கராஅத்து","lemma":"கராஅத்து","gloss":"of the crocodile"}],"gloss":"of the crocodile","split_unverified":true},{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"அன்ன","gloss":"like"}],"gloss":"like"},{"surface":"என்","parts":[{"text":"என்","lemma":"யான்","gloss":"my"}],"gloss":"my"},{"surface":"ஐ","parts":[{"text":"ஐ","lemma":"ஐ","gloss":"lord"}],"gloss":"lord"}]},{"words":[{"surface":"நுண்","parts":[{"text":"நுண்","lemma":"நுண்","gloss":"subtle"}],"gloss":"subtle"},{"surface":"பல்","parts":[{"text":"பல்","lemma":"பல்","gloss":"many"}],"gloss":"many"},{"surface":"கருமம்","parts":[{"text":"கருமம்","lemma":"கருமம்","gloss":"deeds"}],"gloss":"deeds"},{"surface":"நினையாது","parts":[{"text":"நினை","lemma":"நினை","gloss":"think"},{"text":"ஆது","lemma":"ஆது","gloss":"negative adverbial participle suffix"}],"gloss":"without thinking"}]},{"words":[{"surface":"இளையன்","parts":[{"text":"இளையன்","lemma":"இளையன்","gloss":"he is young"}],"gloss":"he is young","split_unverified":true},{"surface":"என்று","parts":[{"text":"என்","lemma":"என்","gloss":"say"},{"text":"து","lemma":"து","gloss":"past adverbial participle suffix"}],"gloss":"saying"},{"surface":"இகழின்","parts":[{"text":"இகழ்","lemma":"இகழ்","gloss":"despise"},{"text":"இன்","lemma":"இன்","gloss":"conditional suffix"}],"gloss":"if you despise"},{"surface":"பெறல்","parts":[{"text":"பெறு","lemma":"பெறு","gloss":"obtain"},{"text":"அல்","lemma":"அல்","gloss":"verbal noun suffix"}],"gloss":"obtaining"},{"surface":"அரிது","parts":[{"text":"அரிது","lemma":"அரிது","gloss":"difficult"}],"gloss":"difficult"},{"surface":"ஆடு","parts":[{"text":"ஆடு","lemma":"ஆடு","gloss":"victory"}],"gloss":"victory"},{"surface":"ஏ","parts":[{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"indeed"}]}],"literal":"Protect yourselves, O warriors! We declare to you / The town's small children, to bathe, stir up / reaching the leg, little water, a male elephant, having killed, drags down / having dragging power, crocodile-like is my lord / subtle, many deeds, without thinking / 'He is young,' saying, if you despise, obtaining is difficult, victory indeed!","translation":"Protect yourselves, O warriors! We warn you: Like a crocodile with immense dragging power that lurks in shallow, ankle-deep water—stirred up by the playing of little children from the town—and yet kills and drags down a mighty elephant, so is my lord. Without considering his many subtle deeds, if you despise him thinking 'he is young,' victory in battle will be impossible for you to attain!","modern":"வீரர்களே! உங்களை எச்சரிக்கிறோம், உங்களைக் காத்துக் கொள்ளுங்கள். ஊரிலுள்ள சிறு பிள்ளைகள் விளையாடுவதால் கலங்கிப் போகும், கணுக்கால் அளவு மட்டுமே உள்ள ஆழமில்லாத கொஞ்ச நீரிலும், ஒரு பெரிய ஆண் யானையைக் கொன்று இழுத்துச் செல்லும் வலிமை வாய்ந்த முதலை வாழும். அந்த முதலையைப் போன்றவன் என் தலைவனாகிய அதியமான். அவனுடைய நுட்பமான பல செயல்களைப் பற்றிச் சிந்திக்காமல், 'அவன் வயதால் இளையவன்' என்று எண்ணி நீங்கள் அவனை இகழ்ந்தால், உங்களால் போர்க்களத்தில் வெற்றியைப் பெறுவது மிகவும் அரிது.","explanation":"In this poem, the famous poet Avvaiyar addresses the enemy warriors on behalf of her patron, Adhiyaman Neduman Anji. She warns them not to underestimate Adhiyaman because of his youth or the seemingly modest size of his domain. She employs a vivid simile of a crocodile lurking in shallow, ankle-deep water that is easily stirred up by playing children. Despite the water being shallow, the crocodile possesses enough power to drag down and kill a massive elephant. Similarly, Adhiyaman may appear young and accessible, but his strategic prowess and strength are lethal to any mighty opponent. This poem belongs to the Vākai tiṇai (victory/bravery), specifically the Arasavākai theme, which extols the supreme valor and strategic greatness of a king.","model":"gemini-3.5-flash"}}