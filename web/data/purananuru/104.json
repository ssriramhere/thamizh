{"text":"purananuru","n":104,"lines":["போற்றுமின் மறவீர் சாற்றுதும் நும்மை","ஊர்க்குறு மாக்கள் ஆடக் கலங்கும்","தாள்படு சின்னீர் களிறு அட்டு வீழ்க்கும்","ஈர்ப்புடைக் கராஅத்து அன்ன என்ஐ","நுண்பல் கருமம் நினையாது","இளையன் என்று இகழின் பெறல் அரிது ஆடே"],"tr":["pōṟṟumiṉ maṟavīr cāṟṟutum nummai","ūrkkuṟu mākkaḷ āṭak kalaṅkum","tāḷpaṭu ciṉṉīr kaḷiṟu aṭṭu vīḻkkum","īrppuṭaik karāattu aṉṉa eṉai","nuṇpal karumam niṉaiyātu","iḷaiyaṉ eṉṟu ikaḻiṉ peṟal aritu āṭē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"அரசவாகை","poet_ta":"ஔவையார்","addressed_ta":"அதியமான் நெடுமான் அஞ்சி","poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 11"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"போற்றுமின்","tr":"pōṟṟumiṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"போற்","tr":"pōṟ"},{"kind":"nirai","text":"றுமின்","tr":"ṟumiṉ"}]},{"text":"மறவீர்","tr":"maṟavīr","foot":"puḷimā","acai":[{"kind":"nirai","text":"மற","tr":"maṟa"},{"kind":"nēr","text":"வீர்","tr":"vīr"}]},{"text":"சாற்றுதும்","tr":"cāṟṟutum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சாற்","tr":"cāṟ"},{"kind":"nirai","text":"றுதும்","tr":"ṟutum"}]},{"text":"நும்மை","tr":"nummai","foot":"tēmā","acai":[{"kind":"nēr","text":"நும்","tr":"num"},{"kind":"nēr","text":"மை","tr":"mai"}]}],[{"text":"யூர்க்குறு","tr":"yūrkkuṟu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யூர்க்","tr":"yūrk"},{"kind":"nirai","text":"குறு","tr":"kuṟu"}]},{"text":"மாக்க","tr":"mākka","foot":"tēmā","acai":[{"kind":"nēr","text":"மாக்","tr":"māk"},{"kind":"nēr","text":"க","tr":"ka"}]},{"text":"ளாடக்","tr":"ḷāṭak","foot":"tēmā","acai":[{"kind":"nēr","text":"ளா","tr":"ḷā"},{"kind":"nēr","text":"டக்","tr":"ṭak"}]},{"text":"கலங்கும்","tr":"kalaṅkum","foot":"puḷimā","