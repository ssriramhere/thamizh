tal","gloss":"pointed out"}],"gloss":"pointed out"},{"surface":"மூவர்","parts":[{"text":"மூவர்","lemma":"mūvar","gloss":"three kings"}],"gloss":"three kings"},{"surface":"உலகமும்","parts":[{"text":"உலகம்","lemma":"ulakam","gloss":"world"},{"text":"உம்","lemma":"-um","gloss":"also"}],"gloss":"world also"}]},{"words":[{"surface":"பொதுமை","parts":[{"text":"பொதுமை","lemma":"potumai","gloss":"common ownership"}],"gloss":"common ownership"},{"surface":"இன்றி","parts":[{"text":"இன்றி","lemma":"iṉṟi","gloss":"without"}],"gloss":"without"},{"surface":"ஆண்டிசினோர்க்கும்","parts":[{"text":"ஆண்டு","lemma":"āḷtal","gloss":"having ruled"},{"text":"இசின்","lemma":"-iciṉ","gloss":"past tense particle"},{"text":"ஓர்க்கு","lemma":"-ōr","gloss":"to those"},{"text":"உம்","lemma":"-um","gloss":"even"}],"gloss":"even to those who ruled"}]},{"words":[{"surface":"மாண்ட","parts":[{"text":"மாண்ட","lemma":"māṇṭal","gloss":"ended"}],"gloss":"ended"},{"surface":"அன்றே","parts":[{"text":"அன்றே","lemma":"aṉṟē","gloss":"indeed"}],"gloss":"indeed"},{"surface":"ஆண்டுகள்","parts":[{"text":"ஆண்டுகள்","lemma":"āṇṭu","gloss":"years"}],"gloss":"years"},{"surface":"துணையே","parts":[{"text":"துணை","lemma":"tuṇai","gloss":"measure"},{"text":"ஏ","lemma":"-ē","gloss":"indeed"}],"gloss":"measure indeed"}]},{"words":[{"surface":"வைத்தது","parts":[{"text":"வைத்தது","lemma":"vaittal","gloss":"that which was accumulated"}],"gloss":"that which was accumulated"},{"surface":"அன்றே","parts":[{"text":"அன்றே","lemma":"aṉṟē","gloss":"indeed"}],"gloss":"indeed"},{"surface":"வெறுக்கை","parts":[{"text":"வெறுக்கை","lemma":"veṟukkai","gloss":"wealth"}],"gloss":"wealth"}]},{"words":[{"surface":"…","parts":[{"text":"…","lemma":"…","gloss":"gap"}],"gloss":"gap"},{"surface":"ணை","parts":[{"text":"ணை","lemma":"tuṇai","gloss":"support"}],"gloss":"support"}]},{"words":[{"surface":"புணை","parts":[{"text":"புணை","lemma":"puṇai","gloss":"raft"}],"gloss":"raft"},{"surface":"கைவிட்டோர்க்கு","parts":[{"text":"கை","lemma":"kai","gloss":"hand"},{"text":"விட்டோர்க்கு","lemma":"viṭutal","gloss":"to those who let go"}],"gloss":"to those who let go"},{"surface":"அரிதே","parts":[{"text":"அரிது","lemma":"aritu","gloss":"difficult"},{"text":"ஏ","lemma":"-ē","gloss":"indeed"}],"gloss":"difficult indeed"},{"surface":"துணை","parts":[{"text":"துணை","lemma":"tuṇai","gloss":"companion"}],"gloss":"companion"},{"surface":"அழ","parts":[{"text":"அழ","lemma":"aḻutal","gloss":"to weep"}],"gloss":"to weep"}]},{"words":[{"surface":"தொக்கு","parts":[{"text":"தொக்கு","lemma":"tokutal","gloss":"having gathered"}],"gloss":"having gathered"},{"surface":"உயிர்","parts":[{"text":"உயிர்","lemma":"uyir","gloss":"life"}],"gloss":"life"},{"surface":"வெளவும்","parts":[{"text":"வெளவும்","lemma":"veḷavutal","gloss":"snatching"}],"gloss":"snatching"},{"surface":"காலை","parts":[{"text":"காலை","lemma":"kālai","gloss":"time"}],"gloss":"time"}]},{"words":[{"surface":"இக்கரை","parts":[{"text":"இ","lemma":"i","gloss":"this"},{"text":"கரை","lemma":"karai","gloss":"bank"}],"gloss":"this bank"},{"surface":"நின்று","parts":[{"text":"நின்று","lemma":"niṟṟal","gloss":"standing"}],"gloss":"standing"},{"surface":"இவர்ந்து","parts":[{"text":"இவர்ந்து","lemma":"ivartal","gloss":"crossing over"}],"gloss":"crossing over"},{"surface":"உக்கரை","parts":[{"text":"உ","lemma":"u","gloss":"that"},{"text":"கரை","lemma":"karai","gloss":"bank"}],"gloss":"that bank"},{"surface":"கொளலே","parts":[{"text":"கொளல்","lemma":"koḷal","gloss":"reaching"},{"text":"ஏ","lemma":"-ē","gloss":"indeed"}],"gloss":"reaching indeed"}]}],"literal":"The earth bound and tied by mountains where hills join / the world of the three kings who claimed common ownership / even to those who ruled without sharing / the measure of their years has indeed ended / the wealth they accumulated has indeed remained / … support / to those who let go of the raft, it is difficult indeed, while companions weep / at the time when life is gathered and snatched away / standing on this bank, crossing over and reaching that bank.","translation":"Even for the three great kings who ruled without sharing this earth, which is bound and tied by mountains where hills join, the measure of their years has ended, and the wealth they accumulated has remained behind. When life is gathered and snatched away, while companions weep, for those who have let go of the raft of virtue, it is indeed difficult to cross over from this bank of life and reach the other bank.","modern":"குன்றுகள் பொருந்திய மலைகளால் பிணைத்துக் கட்டப்பட்ட இந்த உலகத்தை, தங்களுக்கு மட்டுமே உரியதாகப் பொதுமையின்றி ஆண்ட மூவேந்தர்களுக்கும் அவர்களுடைய ஆயுட்காலம் முடிந்துவிட்டது; அவர்கள் சேர்த்து வைத்த செல்வமும் இங்கேயே தங்கிவிட்டது. உறவினர்கள் கதறி அழ, உயிர் உடலை விட்டுப் பிரியும் காலத்தில், நற்செயல் என்னும் புணையை (தெப்பத்தை)க் கைவிட்டவர்களுக்கு, இக்கரையாகிய இவ்வுலகிலிருந்து அக்கரையாகிய அவ்வுலகிற்குச் செல்வது மிகவும் அரிதானதாகும்.","explanation":"This poem belongs to the Kañci tiṇai and Perunkañci tuṟai, which deals with the transience of worldly life and the importance of virtue. The poet Piramaṉār addresses the rulers and people, reminding them that even the mighty three kings (Chera, Chola, and Pandya) who ruled the vast earth bounded by mountains could not take their wealth or years with them when they died. He uses the metaphor of a river crossing, where life is 'this bank' and the afterlife is 'that bank'. The raft (puṇai) represents the virtuous deeds that one must hold onto to cross safely. Without this raft, when death snatches life away amidst the weeping of companions, crossing over becomes impossible.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.38],[0.38,0.8],[0.8,1.52],[1.52,1.8],[1.8,2.3],[2.3,2.3],[2.3,2.9],[2.9,3.1],[3.1,4.4],[4.4,4.6],[4.6,5.15],[5.2,5.6],[5.6,6.5],[6.5,6.6],[6.6,6.8],[6.8,7.3],[7.3,9.1],[9.1,9.82],[9.82,9.82],[9.82,9.82],[9.82,9.82],[9.82,10.9],[10.9,11.23],[11.23,11.89],[11.89,13.3],[13.3,13.5],[13.5,14.2],[14.96,15.56],[15.56,15.86],[15.86,15.96],[15.96,16.26],[16.26,16.66]],"female":[[0.0,0.5],[0.5,0.9],[0.9,1.6],[1.6,2.0],[2.0,2.7],[2.7,2.8],[2.8,3.5],[3.5,3.6],[3.6,5.1],[5.1,5.3],[5.3,5.95],[6.0,6.4],[6.4,7.2],[7.2,7.3],[7.3,7.6],[7.6,8.2],[8.2,9.5],[9.5,9.62],[9.7,10.3],[10.3,11.62],[11.62,11.62],[11.62,12.06],[12.06,12.5],[12.5,13.25],[13.25,14.1],[14.1,14.63],[14.63,14.9],[15.64,16.34],[16.34,16.74],[16.74,16.74],[16.74,17.14],[17.14,17.54]]}}