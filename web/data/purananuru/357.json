{"text":"purananuru","n":357,"lines":["குன்று மணந்த மலைபிணித் தியாத்தமண்","பொதுமை சுட்டிய மூவர் உலகமும்","பொதுமை இன்றி ஆண்டிசி னோர்க்கும்","மாண்ட வன்றே ஆண்டுகள் துணையே","வைத்த தன்றே வெறுக்கை","… ணை","புணைகை விட்டோர்க்கு அரிதே துணைஅழத்","தொக்குஉயிர் வெளவுங் காலை","இக்கரை நின்று இவர்ந்து உக்கரை கொளலே"],"tr":["kuṉṟu maṇanta malaipiṇit tiyāttamaṇ","potumai cuṭṭiya mūvar ulakamum","potumai iṉṟi āṇṭici ṉōrkkum","māṇṭa vaṉṟē āṇṭukaḷ tuṇaiyē","vaitta taṉṟē veṟukkai","ṇai","puṇaikai viṭṭōrkku aritē tuṇaiaḻat","tokkuuyir veḷavuṅ kālai","ikkarai niṉṟu ivarntu ukkarai koḷalē"],"colophon":{"tinai":"kāñci","tinai_ta":"காஞ்சி","turai_ta":"பெருங்காஞ்சி","poet_ta":"பிரமனார்","poet_tr":"Piramaṉār"},"scan":{"meter":"not a regular āciriyappā","ok":false,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":false,"detail":"6×4, 2×3, 1×0 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 12"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"குன்று","tr":"kuṉṟu","foot":"tēmā","acai":[{"kind":"nēr","text":"குன்","tr":"kuṉ"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"மணந்த","tr":"maṇanta","foot":"puḷimā","acai":[{"kind":"nirai","text":"மணந்","tr":"maṇan"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"மலைபிணித்","tr":"malaipiṇit","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மலை","tr":"malai"},{"kind":"nirai","text":"பிணித்","tr":"piṇit"}]},{"text":"தியாத்தமண்","tr":"tiyāttamaṇ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தியாத்","tr":"tiyāt"},{"kind":"nirai","text":"தமண்","tr":"tamaṇ"}]}],[{"text":"பொதுமை","tr":"potumai","foot":"puḷimā","acai":[{"kind":"nirai","text":"பொது","tr":"potu"},{"kind":"nēr","text":"மை","tr":"mai"}]},{"text":"சுட்டிய","tr":"cuṭṭiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சுட்","tr":"cuṭ"},{"kind":"nirai","text":"டிய","tr":"ṭiya"}]},{"text":"மூவ","tr":"mūva","foot":"tēmā","acai":[{"kind":"nēr","text":"மூ