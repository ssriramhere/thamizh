{"text":"purananuru","n":186,"lines":["ஆட்சியாளர் நெஞ்சங்களில் ஆழப் பதியவேண்டிய ஒரு செய்யுளும் ஆம்","நெல்லும் உயிர் அன்றே நீரும் உயிர் அன்றே","மன்னன் உயிர்த்தே மலர்தலை உலகம்","அதனால் யான்உயிர் என்பது அறிகை","வேன்மிகு தானை வேந்தற்குக் கடனே"],"tr":["āṭciyāḷar neñcaṅkaḷil āḻap patiyavēṇṭiya oru ceyyuḷum ām","nellum uyir aṉṟē nīrum uyir aṉṟē","maṉṉaṉ uyirttē malartalai ulakam","ataṉāl yāṉuyir eṉpatu aṟikai","vēṉmiku tāṉai vēntaṟkuk kaṭaṉē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"பொருண்மொழிக் காஞ்சி","poet_ta":"மோசிகீரனார்","poet_tr":"Mōcikīraṉār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"5×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 18, other 1, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 7, ? 1, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஆட்சி","tr":"āṭci","foot":"tēmā","acai":[{"kind":"nēr","text":"ஆட்","tr":"āṭ"},{"kind":"nēr","text":"சி","tr":"ci"}]},{"text":"யாளர்","tr":"yāḷar","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"ளர்","tr":"ḷar"}]},{"text":"நெஞ்சங்","tr":"neñcaṅ","foot":"tēmā","acai":[{"kind":"nēr","text":"நெஞ்","tr":"neñ"},{"kind":"nēr","text":"சங்","tr":"caṅ"}]},{"text":"களிலாழப்பதியவேண்டியவொருசெய்யுளுமாம்","tr":"kaḷilāḻappatiyavēṇṭiyavoruceyyuḷumām","foot":"?","acai":[{"kind":"nirai","text":"களி","tr":"kaḷi"},{"kind":"nēr","text":"லா","tr":"lā"},{"kind":"nēr","text":"ழப்","tr":"ḻap"},{"kind":"nirai","text":"பதி","tr":"pati"},{"kind":"nirai","text":"யவேண்","tr":"yavēṇ"},{"kind":"nirai","text":"டிய","tr":"ṭiya"},{"kind":"nirai","text":"வொரு","tr":"voru"},{"kind":"nēr","text":"செய்","tr":"cey"},{"kind":"nirai","text":"யுளு","tr":"yuḷu"},{"kind":"nēr","text":"மாம்","tr":"mām"}]}],[{"text":"நெல்லுமு","tr":"nellumu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நெல்","tr":"nel"},{"kind":"