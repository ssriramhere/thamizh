{"text":"purananuru","n":146,"lines":["அன்ன வாக நின் அருங்கல வெறுக்கை","அவை பெறல் வேண்டேம் அடுபோர்ப் பேக","சீறியாழ் செவ்வழி பண்ணி நின் வன்புல","நன்னாடு பாட என்னை நயந்து","பரிசில் நல்குவை யாயின் குரிசில் நீ","நல்கா மையின் நைவரச் சாஅய்","அருந்துயர் உழக்கும்நின் திருந்திழை அரிவை","கலிமயிற் கலாவம் கால்குவித் தன்ன","ஒலிமென் கூந்தல் கமழ்புகை கொளீஇத்","தண்கமழ் கோதை புனைய","வண்பரி நெடுந்தேர் பூண்க நின் மாவே"],"tr":["aṉṉa vāka niṉ aruṅkala veṟukkai","avai peṟal vēṇṭēm aṭupōrp pēka","cīṟiyāḻ cevvaḻi paṇṇi niṉ vaṉpula","naṉṉāṭu pāṭa eṉṉai nayantu","paricil nalkuvai yāyiṉ kuricil nī","nalkā maiyiṉ naivarac cāay","aruntuyar uḻakkumniṉ tiruntiḻai arivai","kalimayiṟ kalāvam kālkuvit taṉṉa","olimeṉ kūntal kamaḻpukai koḷīit","taṇkamaḻ kōtai puṉaiya","vaṇpari neṭuntēr pūṇka niṉ māvē"],"colophon":{"tinai":"peruntiṇai","tinai_ta":"பெருந்திணை","turai_ta":"குறுங்கலி","poet_ta":"அரிசில் கிழார்","addressed_ta":"வையாவிக் கோப்பெரும் பேகன்","poet_tr":"Aricil Kiḻār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"11 lines"},{"name":"feet per line","ok":true,"detail":"10×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 41, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 22, āciriyattaḷai 19, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அன்ன","tr":"aṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"அன்","tr":"aṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"வாகநின்","tr":"vākaniṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nirai","text":"கநின்","tr":"kaniṉ"}]},{"text":"னருங்கல","tr":"ṉaruṅkala","foot":"karuviḷam","acai":[{"kind":"nirai","text":"னருங்","tr":"ṉaruṅ"},{"kind":"nirai","text":"கல","tr":"kala"}]},{"text":"வெறுக்கை","tr":"veṟukkai","foot":"puḷimā","acai":[{"kind":"nirai","text":"வெறுக்","tr":"veṟuk"},{"kind":"nēr","text":"கை","tr":"kai"}]}],[{"text":"யவைபெறல்","tr":"yavaipeṟal","foot":"karuviḷam","acai":[{"kind":"nirai","text":"யவை","tr