{"text":"purananuru","n":303,"lines":["நிலம்பிறக் கிடுவது போலக் குளம்பு குடையூஉ","உள்ளம் அழிக்கும் கொட்பின் மான்மேல்","எள்ளுநர்ச் செகுக்கும் காளை கூர்த்த","வெந்திறல் எ·கம் நெஞ்சுவடு விளைப்ப","ஆட்டிக் காணிய வருமே நெருநை","உரைசால் சிறப்பின் வேந்தர் முன்னர்க்","கரைபொரு முந்நீர்த் திமிலின் போழ்ந்து அவர்","கயந்தலை மடப்பிடி புலம்ப","இலங்கு மருப்பு யானை எறிந்த எற்கே"],"tr":["nilampiṟak kiṭuvatu pōlak kuḷampu kuṭaiyūu","uḷḷam aḻikkum koṭpiṉ māṉmēl","eḷḷunarc cekukkum kāḷai kūrtta","ventiṟal ekam neñcuvaṭu viḷaippa","āṭṭik kāṇiya varumē nerunai","uraicāl ciṟappiṉ vēntar muṉṉark","karaiporu munnīrt timiliṉ pōḻntu avar","kayantalai maṭappiṭi pulampa","ilaṅku maruppu yāṉai eṟinta eṟkē"],"colophon":{"tinai":"tumpai","tinai_ta":"தும்பை","turai_ta":"குதிரை மறம்","poet_ta":"எருமை வெளியனார்","poet_tr":"Erumai Veḷiyaṉār"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"1×5, 8×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 35, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 20, veṇṭaḷai 16"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"1 five-foot line (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"நிலம்பிறக்","tr":"nilampiṟak","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நிலம்","tr":"nilam"},{"kind":"nirai","text":"பிறக்","tr":"piṟak"}]},{"text":"கிடுவது","tr":"kiṭuvatu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கிடு","tr":"kiṭu"},{"kind":"nirai","text":"வது","tr":"vatu"}]},{"text":"போலக்","tr":"pōlak","foot":"tēmā","acai":[{"kind":"nēr","text":"போ","tr":"pō"},{"kind":"nēr","text":"லக்","tr":"lak"}]},{"text":"குளம்பு","tr":"kuḷampu","foot":"puḷimā","acai":[{"kind":"nirai","text":"குளம்","tr":"kuḷam"},{"kind":"nēr","text":"பு","tr":"pu"}]},{"text":"குடையூஉ","tr":"kuṭaiyūu","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"குடை","tr":"kuṭai"},{"kind":"nēr","text":"யூ","tr":"yū"},{"kind":"nēr","text":"உ","tr":"u