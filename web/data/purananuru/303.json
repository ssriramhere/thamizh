{"text":"purananuru","n":303,"lines":["நிலம்பிறக் கிடுவது போலக் குளம்பு குடையூஉ","உள்ளம் அழிக்கும் கொட்பின் மான்மேல்","எள்ளுநர்ச் செகுக்கும் காளை கூர்த்த","வெந்திறல் எஃகம் நெஞ்சுவடு விளைப்ப","ஆட்டிக் காணிய வருமே நெருநை","உரைசால் சிறப்பின் வேந்தர் முன்னர்க்","கரைபொரு முந்நீர்த் திமிலின் போழ்ந்து அவர்","கயந்தலை மடப்பிடி புலம்ப","இலங்கு மருப்பு யானை எறிந்த எற்கே"],"tr":["nilampiṟak kiṭuvatu pōlak kuḷampu kuṭaiyūu","uḷḷam aḻikkum koṭpiṉ māṉmēl","eḷḷunarc cekukkum kāḷai kūrtta","ventiṟal eḵkam neñcuvaṭu viḷaippa","āṭṭik kāṇiya varumē nerunai","uraicāl ciṟappiṉ vēntar muṉṉark","karaiporu munnīrt timiliṉ pōḻntu avar","kayantalai maṭappiṭi pulampa","ilaṅku maruppu yāṉai eṟinta eṟkē"],"colophon":{"tinai":"tumpai","tinai_ta":"தும்பை","turai_ta":"குதிரை மறம்","poet_ta":"எருமை வெளியனார்","poet_tr":"Erumai Veḷiyaṉār"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"1×5, 8×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 34, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 20, veṇṭaḷai 15, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"1 five-foot line (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"நிலம்பிறக்","tr":"nilampiṟak","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நிலம்","tr":"nilam"},{"kind":"nirai","text":"பிறக்","tr":"piṟak"}]},{"text":"கிடுவது","tr":"kiṭuvatu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கிடு","tr":"kiṭu"},{"kind":"nirai","text":"வது","tr":"vatu"}]},{"text":"போலக்","tr":"pōlak","foot":"tēmā","acai":[{"kind":"nēr","text":"போ","tr":"pō"},{"kind":"nēr","text":"லக்","tr":"lak"}]},{"text":"குளம்பு","tr":"kuḷampu","foot":"puḷimā","acai":[{"kind":"nirai","text":"குளம்","tr":"kuḷam"},{"kind":"nēr","text":"பு","tr":"pu"}]},{"text":"குடையூஉ","tr":"kuṭaiyūu","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"குடை","tr":"kuṭai"},{"kind":"nēr","text":"யூ","tr":"yū"},{"kind":"nēr","text":"உ","tr":"u"}]}],[{"text":"வுள்ள","tr":"vuḷḷa","foot":"tēmā","acai":[{"kind":"nēr","text":"வுள்","tr":"vuḷ"},{"kind":"nēr","text":"ள","tr":"ḷa"}]},{"text":"மழிக்கும்","tr":"maḻikkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"மழிக்","tr":"maḻik"},{"kind":"nēr","text":"கும்","tr":"kum"}]},{"text":"கொட்பின்","tr":"koṭpiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"கொட்","tr":"koṭ"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]},{"text":"மான்மே","tr":"māṉmē","foot":"tēmā","acai":[{"kind":"nēr","text":"மான்","tr":"māṉ"},{"kind":"nēr","text":"மே","tr":"mē"}]}],[{"text":"லெள்ளுநர்ச்","tr":"leḷḷunarc","foot":"kūviḷam","acai":[{"kind":"nēr","text":"லெள்","tr":"leḷ"},{"kind":"nirai","text":"ளுநர்ச்","tr":"ḷunarc"}]},{"text":"செகுக்கும்","tr":"cekukkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"செகுக்","tr":"cekuk"},{"kind":"nēr","text":"கும்","tr":"kum"}]},{"text":"காளை","tr":"kāḷai","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"ளை","tr":"ḷai"}]},{"text":"கூர்த்த","tr":"kūrtta","foot":"tēmā","acai":[{"kind":"nēr","text":"கூர்த்","tr":"kūrt"},{"kind":"nēr","text":"த","tr":"ta"}]}],[{"text":"வெந்திற","tr":"ventiṟa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வெந்","tr":"ven"},{"kind":"nirai","text":"திற","tr":"tiṟa"}]},{"text":"லெஃகம்","tr":"leḵkam","foot":"tēmā","acai":[{"kind":"nēr","text":"லெஃ","tr":"leḵ"},{"kind":"nēr","text":"கம்","tr":"kam"}]},{"text":"நெஞ்சுவடு","tr":"neñcuvaṭu","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"நெஞ்","tr":"neñ"},{"kind":"nirai","text":"சுவ","tr":"cuva"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"விளைப்ப","tr":"viḷaippa","foot":"puḷimā","acai":[{"kind":"nirai","text":"விளைப்","tr":"viḷaip"},{"kind":"nēr","text":"ப","tr":"pa"}]}],[{"text":"வாட்டிக்","tr":"vāṭṭik","foot":"tēmā","acai":[{"kind":"nēr","text":"வாட்","tr":"vāṭ"},{"kind":"nēr","text":"டிக்","tr":"ṭik"}]},{"text":"காணிய","tr":"kāṇiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"ணிய","