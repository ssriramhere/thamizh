{"text":"purananuru","n":263,"lines":["பெருங்களிற்று அடியின் தோன்றும் ஒருகண்","இரும்பறை இரவல சேறி ஆயின்","தொழாதனை கழிதல் ஓம்புமதி வழாது","வண்டுமேம் படூஉம் இவ் வறநிலை யாறே","பல்லாத் திரள்நிரை பெயர்தரப் பெயர்தந்து","கல்லா இளையர் நீங்க நீங்கான்","வில்லுமிழ் கடுங்கணை மூழ்கக்","கொல்புனல் சிறையின் விலங்கியோன் கல்லே"],"tr":["peruṅkaḷiṟṟu aṭiyiṉ tōṉṟum orukaṇ","irumpaṟai iravala cēṟi āyiṉ","toḻātaṉai kaḻital ōmpumati vaḻātu","vaṇṭumēm paṭūum iv vaṟanilai yāṟē","pallāt tiraḷnirai peyartarap peyartantu","kallā iḷaiyar nīṅka nīṅkāṉ","villumiḻ kaṭuṅkaṇai mūḻkak","kolpuṉal ciṟaiyiṉ vilaṅkiyōṉ kallē"],"colophon":{"tinai":"karantai","tinai_ta":"கரந்தை","turai_ta":"கையறுநிலை"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"8×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 31, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 19, veṇṭaḷai 12"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பெருங்களிற்","tr":"peruṅkaḷiṟ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெருங்","tr":"peruṅ"},{"kind":"nirai","text":"களிற்","tr":"kaḷiṟ"}]},{"text":"றடியின்","tr":"ṟaṭiyiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"றடி","tr":"ṟaṭi"},{"kind":"nēr","text":"யின்","tr":"yiṉ"}]},{"text":"தோன்று","tr":"tōṉṟu","foot":"tēmā","acai":[{"kind":"nēr","text":"தோன்","tr":"tōṉ"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"மொருக","tr":"moruka","foot":"puḷimā","acai":[{"kind":"nirai","text":"மொரு","tr":"moru"},{"kind":"nēr","text":"க","tr":"ka"}]}],[{"text":"ணிரும்பறை","tr":"ṇirumpaṟai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"ணிரும்","tr":"ṇirum"},{"kind":"nirai","text":"பறை","tr":"paṟai"}]},{"text":"யிரவல","tr":"yiravala","foot":"karuviḷam","acai":[{"kind":"nirai","text":"யிர","tr":"yira"},{"kind":"nirai","text":"வல","tr":"vala"}]},{"text":"சேறி","tr":"cēṟi","foot":"tēmā","acai":[{"kind":"nēr","text":"சே","tr":"cē"},{"kind":"nēr","text":"றி","tr":"ṟi"}]},{"text":"யாயின்","tr":"yāyiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"யின்","tr":"yiṉ"}]}],[{"text":"தொழாதனை","tr":"toḻātaṉai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தொழா","tr":"toḻā"},{"kind":"nirai","text":"தனை","tr":"taṉai"}]},{"text":"கழிதலோம்","tr":"kaḻitalōm","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கழி","tr":"kaḻi"},{"kind":"nirai","text":"தலோம்","tr":"talōm"}]},{"text":"புமதி","tr":"pumati","foot":"puḷimā","acai":[{"kind":"nirai","text":"பும","tr":"puma"},{"kind":"nēr","text":"தி","tr":"ti"}]},{"text":"வழாது","tr":"vaḻātu","foot":"puḷimā","acai":[{"kind":"nirai","text":"வழா","tr":"vaḻā"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"வண்டுமேம்","tr":"vaṇṭumēm","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வண்","tr":"vaṇ"},{"kind":"nirai","text":"டுமேம்","tr":"ṭumēm"}]},{"text":"படூஉமிவ்","tr":"paṭūumiv","foot":"karuviḷam","acai":[{"kind":"nirai","text":"படூ","tr":"paṭū"},{"kind":"nirai","text":"உமிவ்","tr":"umiv"}]},{"text":"வறநிலை","tr":"vaṟanilai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வற","tr":"vaṟa"},{"kind":"nirai","text":"நிலை","tr":"nilai"}]},{"text":"யாறே","tr":"yāṟē","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"றே","tr":"ṟē"}]}],[{"text":"பல்லாத்","tr":"pallāt","foot":"tēmā","acai":[{"kind":"nēr","text":"பல்","tr":"pal"},{"kind":"nēr","text":"லாத்","tr":"lāt"}]},{"text":"திரள்நிரை","tr":"tiraḷnirai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"திரள்","tr":"tiraḷ"},{"kind":"nirai","text":"நிரை","tr":"nirai"}]},{"text":"பெயர்தரப்","tr":"peyartarap","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெயர்","tr":"peyar"},{"kind":"nirai","text":"தரப்","tr":"tarap"}]},{"text":"பெயர்தந்து","tr":"peyartantu","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"பெயர்","tr":"peyar"},{"kind":"nēr","text":"தந்","tr":"tan"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"கல்லா","tr":"kallā","foot":"tēmā","aca