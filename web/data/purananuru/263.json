","parts":[{"text":"தோன்று","lemma":"tōṉṟu","gloss":"appear"},{"text":"உம்","lemma":"um","gloss":"adjectival suffix"}],"gloss":"appearing"},{"surface":"ஒருகண்","parts":[{"text":"ஒருகண்","lemma":"ஒருகண்","gloss":"single drumhead"}],"gloss":"single drumhead","split_unverified":true}]},{"words":[{"surface":"இரும்பறை","parts":[{"text":"இரும்பறை","lemma":"இரும்பறை","gloss":"dark drum"}],"gloss":"dark drum","split_unverified":true},{"surface":"இரவல","parts":[{"text":"இரவல","lemma":"இரவல","gloss":"oh suppliant!"}],"gloss":"oh suppliant!","split_unverified":true},{"surface":"சேறி","parts":[{"text":"சேறி","lemma":"சேறி","gloss":"you go"}],"gloss":"you go","split_unverified":true},{"surface":"ஆயின்","parts":[{"text":"ஆ","lemma":"ā","gloss":"become"},{"text":"இன்","lemma":"iṉ","gloss":"if"}],"gloss":"if it be so"}]},{"words":[{"surface":"தொழாதனை","parts":[{"text":"தொழு","lemma":"toḻu","gloss":"worship"},{"text":"ஆது","lemma":"ātu","gloss":"negative suffix"},{"text":"அன்","lemma":"aṉ","gloss":"pronominal suffix"},{"text":"ஐ","lemma":"ai","gloss":"accusative suffix"}],"gloss":"without worshipping"},{"surface":"கழிதல்","parts":[{"text":"கழி","lemma":"kaḻi","gloss":"pass by"},{"text":"தல்","lemma":"tal","gloss":"verbal noun suffix"}],"gloss":"passing by"},{"surface":"ஓம்புமதி","parts":[{"text":"ஓம்பு","lemma":"ōmpu","gloss":"avoid"},{"text":"மதி","lemma":"mati","gloss":"imperative particle"}],"gloss":"do avoid"},{"surface":"வழாது","parts":[{"text":"வழாது","lemma":"வழாது","gloss":"without failing"}],"gloss":"without failing","split_unverified":true}]},{"words":[{"surface":"வண்டு","parts":[{"text":"வண்டு","lemma":"vaṇṭu","gloss":"bees"}],"gloss":"bees"},{"surface":"மேம்படூஉம்","parts":[{"text":"மேம்படூஉம்","lemma":"மேம்படூஉம்","gloss":"hovering over"}],"gloss":"hovering over","split_unverified":true},{"surface":"இவ்","parts":[{"text":"இ","lemma":"i","gloss":"this"},{"text":"வ்","lemma":"v","gloss":"doubled consonant"}],"gloss":"this"},{"surface":"வறநிலை","parts":[{"text":"வறநிலை","lemma":"வறநிலை","gloss":"dry state"}],"gloss":"dry state","split_unverified":true},{"surface":"யாறே","parts":[{"text":"யாறு","lemma":"yāṟu","gloss":"path"},{"text":"ஏ","lemma":"e","gloss":"emphasis"}],"gloss":"path indeed"}]},{"words":[{"surface":"பல்லா","parts":[{"text":"பல்","lemma":"pal","gloss":"many"},{"text":"ஆ","lemma":"ā","gloss":"cows"}],"gloss":"many cows"},{"surface":"திரள்","parts":[{"text":"திரள்","lemma":"tiraḷ","gloss":"herd"}],"gloss":"herd"},{"surface":"நிரை","parts":[{"text":"நிரை","lemma":"nirai","gloss":"row/herd"}],"gloss":"herd of cattle"},{"surface":"பெயர்தர","parts":[{"text":"பெயர்","lemma":"peyar","gloss":"move"},{"text":"தர","lemma":"tara","gloss":"give/bring"}],"gloss":"to retrieve"},{"surface":"பெயர்தந்து","parts":[{"text":"பெயர்","lemma":"peyar","gloss":"move"},{"text":"தந்து","lemma":"tantu","gloss":"having brought"}],"gloss":"having retrieved"}]},{"words":[{"surface":"கல்லா","parts":[{"text":"கல்","lemma":"kal","gloss":"learn"},{"text":"ஆ","lemma":"ā","gloss":"negative suffix"}],"gloss":"unlearned/young"},{"surface":"இளையர்","parts":[{"text":"இளையர்","lemma":"iḷaiyar","gloss":"youths/warriors"}],"gloss":"young warriors"},{"surface":"நீங்க","parts":[{"text":"நீங்கு","lemma":"nīṅku","gloss":"retreat"},{"text":"அ","lemma":"a","gloss":"infinitive suffix"}],"gloss":"to retreat"},{"surface":"நீங்கான்","parts":[{"text":"நீங்கு","lemma":"nīṅku","gloss":"retreat"},{"text":"ஆன்","lemma":"āṉ","gloss":"negative third person singular masculine suffix"}],"gloss":"he did not retreat"}]},{"words":[{"surface":"வில்லுமிழ்","parts":[{"text":"வில்","lemma":"vil","gloss":"bow"},{"text":"உமிழ்","lemma":"umiḻ","gloss":"spit/discharge"}],"gloss":"bow-discharged"},{"surface":"கடுங்கணை","parts":[{"text":"கடுமை","lemma":"kaṭumai","gloss":"swiftness"},{"text":"கணை","lemma":"kaṇai","gloss":"arrow"}],"gloss":"swift arrows"},{"surface":"மூழ்க","parts":[{"text":"மூழ்கு","lemma":"mūḻku","gloss":"pierce deep"},{"text":"அ","lemma":"a","gloss":"infinitive suffix"}],"gloss":"to pierce deep"}]},{"words":[{"surface":"கொல்புனல்","parts":[{"text":"கொல்","lemma":"kol","gloss":"kill/destroy"},{"text":"புனல்","lemma":"puṉal","gloss":"water/flood"}],"gloss":"destructive flood"},{"surface":"சிறையின்","parts":[{"text":"சிறை","lemma":"ciṟai","gloss":"dam/barrier"},{"text":"இன்","lemma":"iṉ","gloss":"like"}],"gloss":"like a dam"},{"surface":"விலங்கியோன்","parts":[{"text":"விலங்கு","lemma":"vilaṅku","gloss":"stand across"},{"text":"இ","lemma":"i","gloss":"past tense marker"},{"text":"ஓன்","lemma":"ōṉ","gloss":"he who"}],"gloss":"he who stood across"},{"surface":"கல்லே","parts":[{"text":"கல்","lemma":"kal","gloss":"stone"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"is the hero stone indeed"}]}],"literal":"Like the footprint of a great male elephant appearing, the single-headed / dark drum, oh suppliant, if you go, / without worshipping, passing by, avoid without fail, / on this dry path where bees hover. / To retrieve the herd of many cows, / when the young undisciplined warriors retreated, he did not retreat, / as swift arrows discharged from bows pierced deep, / like a dam blocking a destructive flood, he who stood across, this is his hero stone.","translation":"Oh suppliant with the large, single-headed drum that looks like the footprint of a great male elephant! If you go along this dry path where bees hover, do not pass by without worshipping. When the young, untrained warriors retreated, he did not retreat; instead, as swift arrows discharged from bows pierced him deep, he stood across to block them like a dam blocking a destructive flood to retrieve the herd of many cows. This is the hero stone of that brave man.","modern":"பெரிய ஆண் யானையின் காலடி போன்ற ஒரு பக்கத்தைக் கொண்ட கரிய பறையை உடைய இரவலனே! நீ வண்டுகள் மொய்க்கும் இந்த வறண்ட வழியே போவாயானால், தவறாமல் இந்த நடுகல்லை வணங்காமல் கடந்து போவதைத் தவிர். பல பசுக்களைக் கொண்ட கூட்டத்தை மீட்பதற்காக, போர்ப் பயிற்சி பெறாத இளைய வீரர்கள் பின்வாங்கி ஓடியபோதும் இவன் பின்வாங்கவில்லை. வில்லிலிருந்து உமிழப்பட்ட கடுமையான அம்புகள் தன் உடலில் மூழ்கியபோதும், வேகமாக வரும் அழிக்கும் வெள்ளத்தைத் தடுக்கும் அணையைப் போல எதிர்த்து நின்று தடுத்தவனுடைய நடுகல் இதுவாகும்.","explanation":"This poem belongs to the Karantai tiṇai (recovering stolen cattle) and the Kaiyaṟunilai tuṟai (lamenting a fallen hero). A passerby addresses a wandering bard carrying a large drum, which is compared to the footprint of a great male elephant. The speaker advises the bard not to pass by this hero stone on the dry desert path without paying respects. The hero commemorated here died defending and recovering cattle from raiders. When other young, inexperienced warriors fled in fear, this hero stood firm like a dam blocking a raging torrent, taking all the arrows on his body. Key words include 'irumpaṟai' (dark drum), 'iravala' (oh suppliant), 'vaṟanilai' (dry path), 'vilaṅkiyōṉ' (he who stood across), and 'kallē' (hero stone).","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,0.9],[0.9,1.3],[1.3,1.6],[1.6,2.5],[2.5,2.9],[2.9,3.1],[3.1,3.4],[3.4,4.6],[4.6,5.1],[5.1,5.5],[5.5,5.8],[5.8,6.38],[6.38,6.84],[6.84,7.08],[7.08,7.54],[7.54,7.71],[7.8,8.16],[8.16,8.6],[8.6,9.0],[9.4,11.0],[11.0,11.9],[11.9,12.3],[12.3,12.9],[12.9,13.4],[13.4,13.95],[13.95,14.5],[14.5,15.2],[15.2,16.26],[16.26,17.1],[17.1,17.74],[17.74,17.9]],"female":[[0.0,0.7],[0.7,0.9],[0.9,1.5],[1.5,1.8],[1.8,2.8],[2.8,3.48],[3.48,3.82],[3.82,4.34],[4.34,5.02],[5.02,5.7],[5.7,6.1],[6.1,6.5],[6.5,7.81],[7.81,8.2],[8.4,8.67],[8.67,9.21],[9.21,9.48],[9.48,10.01],[10.01,10.69],[10.69,11.49],[11.49,12.3],[12.3,13.3],[13.3,13.7],[13.7,14.1],[14.1,14.6],[14.6,15.1],[15.1,15.6],[15.6,16.2],[16.2,17.26],[17.26,18.1],[18.1,18.63],[18.63,18.9]]},"sync":[[["பெருங்களிற்று","of the great male elephant"]],[["அடியின்","like the footprint"]],[["தோன்றும்","appearing"]],[["ஒருகண்","single drumhead"]],[["இரும்பறை","dark drum"]],[["இரவல","oh suppliant!"]],[["சேறி","you go"]],[["ஆயின்","if it be so"]],[["தொழாதனை","without worshipping"]],[["கழிதல்","passing by"]],[["ஓம்புமதி","do avoid"]],[["வழாது","without failing"]],[["வண்டு","bees"],["மேம்படூஉம்","hovering over"]],[["மேம்படூஉம்","hovering over"]],[["இவ்","this"]],[["வறநிலை","dry state"]],[["யாறே","path indeed"]],[["பல்லா","many cows"]],[["திரள்","herd"],["நிரை","herd of cattle"]],[["பெயர்தர","to retrieve"],["பெயர்தந்து","having retrieved"]],[["பெயர்தந்து","having retrieved"]],[["கல்லா","unlearned/young"]],[["இளையர்","young warriors"]],[["நீங்க","to retreat"]],[["நீங்கான்","he did not retreat"]],[["வில்லுமிழ்","bow-discharged"]],[["கடுங்கணை","swift arrows"]],[["மூழ்க","to pierce deep"]],[["கொல்புனல்","destructive flood"]],[["சிறையின்","like a dam"]],[["விலங்கியோன்","he who stood across"]],[["கல்லே","is the hero stone indeed"]]]}