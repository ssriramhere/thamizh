{"text":"purananuru","n":348,"lines":["வெண்ணெல் அரிஞர் தண்ணுமை வெரீஇக்","கண்மடற் கொண்ட தீந்தேன் இரியக்","கள்ளரிக்கும் குயம் சிறுசின்","மீன் சீவும் பாண் சேரி","வாய்மொழித் தழும்பன் ஊணூர் அன்ன","குவளை உண்கண் இவளைத் தாயே","ஈனா ளாயினள் ஆயின் ஆனாது","நிழல்தொறும் நெடுந்தேர் நிற்ப வயின்தொறும்","செந்நுதல் யானை பிணிப்ப","வருந்தல மன் எம் பெருந்துறை மரனே"],"tr":["veṇṇel ariñar taṇṇumai verīik","kaṇmaṭaṟ koṇṭa tīntēṉ iriyak","kaḷḷarikkum kuyam ciṟuciṉ","mīṉ cīvum pāṇ cēri","vāymoḻit taḻumpaṉ ūṇūr aṉṉa","kuvaḷai uṇkaṇ ivaḷait tāyē","īṉā ḷāyiṉaḷ āyiṉ āṉātu","niḻaltoṟum neṭuntēr niṟpa vayiṉtoṟum","cennutal yāṉai piṇippa","varuntala maṉ em peruntuṟai maraṉē"],"colophon":{"tinai":"kāñci","tinai_ta":"காஞ்சி","turai_ta":"மகட்பாற் காஞ்சி","poet_ta":"பரணர்","poet_tr":"Paraṇar"},"scan":{"meter":"iṇaikkuṟaḷ āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"10 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 3×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 37"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 20, veṇṭaḷai 16"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வெண்ணெ","tr":"veṇṇe","foot":"tēmā","acai":[{"kind":"nēr","text":"வெண்","tr":"veṇ"},{"kind":"nēr","text":"ணெ","tr":"ṇe"}]},{"text":"லரிஞர்","tr":"lariñar","foot":"puḷimā","acai":[{"kind":"nirai","text":"லரி","tr":"lari"},{"kind":"nēr","text":"ஞர்","tr":"ñar"}]},{"text":"தண்ணுமை","tr":"taṇṇumai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தண்","tr":"taṇ"},{"kind":"nirai","text":"ணுமை","tr":"ṇumai"}]},{"text":"வெரீஇக்","tr":"verīik","foot":"puḷimā","acai":[{"kind":"nirai","text":"வெரீ","tr":"verī"},{"kind":"nēr","text":"இக்","tr":"ik"}]}],[{"text":"கண்மடற்","tr":"kaṇmaṭaṟ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கண்","tr":"kaṇ"},{"kind":"nirai","text":"மடற்","tr":"maṭaṟ"}]},{"text":"கொண்ட","tr":"koṇṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"கொண்","tr":"koṇ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"தீந்தே","tr":"tīntē","foot":"tēm