{"text":"purananuru","n":348,"lines":["வெண்ணெல் அரிஞர் தண்ணுமை வெரீஇக்","கண்மடற் கொண்ட தீந்தேன் இரியக்","கள்ளரிக்கும் குயம் சிறுசின்","மீன் சீவும் பாண் சேரி","வாய்மொழித் தழும்பன் ஊணூர் அன்ன","குவளை உண்கண் இவளைத் தாயே","ஈனா ளாயினள் ஆயின் ஆனாது","நிழல்தொறும் நெடுந்தேர் நிற்ப வயின்தொறும்","செந்நுதல் யானை பிணிப்ப","வருந்தல மன் எம் பெருந்துறை மரனே"],"tr":["veṇṇel ariñar taṇṇumai verīik","kaṇmaṭaṟ koṇṭa tīntēṉ iriyak","kaḷḷarikkum kuyam ciṟuciṉ","mīṉ cīvum pāṇ cēri","vāymoḻit taḻumpaṉ ūṇūr aṉṉa","kuvaḷai uṇkaṇ ivaḷait tāyē","īṉā ḷāyiṉaḷ āyiṉ āṉātu","niḻaltoṟum neṭuntēr niṟpa vayiṉtoṟum","cennutal yāṉai piṇippa","varuntala maṉ em peruntuṟai maraṉē"],"colophon":{"tinai":"kāñci","tinai_ta":"காஞ்சி","turai_ta":"மகட்பாற் காஞ்சி","poet_ta":"பரணர்","poet_tr":"Paraṇar"},"scan":{"meter":"iṇaikkuṟaḷ āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"10 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 3×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 37"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 20, veṇṭaḷai 16"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வெண்ணெ","tr":"veṇṇe","foot":"tēmā","acai":[{"kind":"nēr","text":"வெண்","tr":"veṇ"},{"kind":"nēr","text":"ணெ","tr":"ṇe"}]},{"text":"லரிஞர்","tr":"lariñar","foot":"puḷimā","acai":[{"kind":"nirai","text":"லரி","tr":"lari"},{"kind":"nēr","text":"ஞர்","tr":"ñar"}]},{"text":"தண்ணுமை","tr":"taṇṇumai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தண்","tr":"taṇ"},{"kind":"nirai","text":"ணுமை","tr":"ṇumai"}]},{"text":"வெரீஇக்","tr":"verīik","foot":"puḷimā","acai":[{"kind":"nirai","text":"வெரீ","tr":"verī"},{"kind":"nēr","text":"இக்","tr":"ik"}]}],[{"text":"கண்மடற்","tr":"kaṇmaṭaṟ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கண்","tr":"kaṇ"},{"kind":"nirai","text":"மடற்","tr":"maṭaṟ"}]},{"text":"கொண்ட","tr":"koṇṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"கொண்","tr":"koṇ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"தீந்தே","tr":"tīntē","foot":"tēmā","acai":[{"kind":"nēr","text":"தீந்","tr":"tīn"},{"kind":"nēr","text":"தே","tr":"tē"}]},{"text":"னிரியக்","tr":"ṉiriyak","foot":"puḷimā","acai":[{"kind":"nirai","text":"னிரி","tr":"ṉiri"},{"kind":"nēr","text":"யக்","tr":"yak"}]}],[{"text":"கள்ளரிக்","tr":"kaḷḷarik","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கள்","tr":"kaḷ"},{"kind":"nirai","text":"ளரிக்","tr":"ḷarik"}]},{"text":"கும்குயம்","tr":"kumkuyam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கும்","tr":"kum"},{"kind":"nirai","text":"குயம்","tr":"kuyam"}]},{"text":"சிறுசின்","tr":"ciṟuciṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிறு","tr":"ciṟu"},{"kind":"nēr","text":"சின்","tr":"ciṉ"}]}],[{"text":"மீன்சீ","tr":"mīṉcī","foot":"tēmā","acai":[{"kind":"nēr","text":"மீன்","tr":"mīṉ"},{"kind":"nēr","text":"சீ","tr":"cī"}]},{"text":"வும்பாண்","tr":"vumpāṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"வும்","tr":"vum"},{"kind":"nēr","text":"பாண்","tr":"pāṇ"}]},{"text":"சேரி","tr":"cēri","foot":"tēmā","acai":[{"kind":"nēr","text":"சே","tr":"cē"},{"kind":"nēr","text":"ரி","tr":"ri"}]}],[{"text":"வாய்மொழித்","tr":"vāymoḻit","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வாய்","tr":"vāy"},{"kind":"nirai","text":"மொழித்","tr":"moḻit"}]},{"text":"தழும்ப","tr":"taḻumpa","foot":"puḷimā","acai":[{"kind":"nirai","text":"தழும்","tr":"taḻum"},{"kind":"nēr","text":"ப","tr":"pa"}]},{"text":"னூணூ","tr":"ṉūṇū","foot":"tēmā","acai":[{"kind":"nēr","text":"னூ","tr":"ṉū"},{"kind":"nēr","text":"ணூ","tr":"ṇū"}]},{"text":"ரன்ன","tr":"raṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"ரன்","tr":"raṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]}],[{"text":"குவளை","tr":"kuvaḷai","foot":"puḷimā","acai":[{"kind":"nirai","text":"குவ","tr":"kuva"},{"kind":"nēr","text":"ளை","tr":"ḷai"}]},{"text":"யுண்க","tr":"yuṇka","foot":"tēmā","acai":[{"kind":"nēr","text":"யுண்","tr":"yuṇ"},{"kind":"nēr","text":"க","tr":"ka"}]},{"text":"ணிவளைத்","tr":"ṇivaḷait","foot":"puḷimā","acai":[{"kind":"nirai","text":"ணிவ","tr":"ṇiva"},{"kind":"nēr","text":"ளை