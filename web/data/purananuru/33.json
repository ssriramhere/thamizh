e"}],"gloss":"resembling"}]},{"words":[{"surface":"காம","parts":[{"text":"காம","lemma":"காம","gloss":"loving"}],"gloss":"loving","split_unverified":true},{"surface":"இருவர்","parts":[{"text":"இருவர்","lemma":"இருவர்","gloss":"two persons"}],"gloss":"lovers"},{"surface":"அல்லது","parts":[{"text":"அல்லது","lemma":"அல்லது","gloss":"except"}],"gloss":"except"},{"surface":"யாமத்து","parts":[{"text":"யாமத்து","lemma":"யாமத்து","gloss":"at midnight"}],"gloss":"at midnight","split_unverified":true}]},{"words":[{"surface":"தனிமகன்","parts":[{"text":"தனி","lemma":"தனி","gloss":"solitary"},{"text":"மகன்","lemma":"மகன்","gloss":"man"}],"gloss":"solitary man"},{"surface":"வழங்கா","parts":[{"text":"வழங்கா","lemma":"வழங்கு","gloss":"not walking"}],"gloss":"not frequenting"},{"surface":"பனி","parts":[{"text":"பனி","lemma":"பனி","gloss":"cool"}],"gloss":"cool"},{"surface":"மலர்க்","parts":[{"text":"மலர்க்","lemma":"மலர்க்","gloss":"flower"}],"gloss":"flower","split_unverified":true},{"surface":"காவின்","parts":[{"text":"கா","lemma":"கா","gloss":"grove"},{"text":"இன்","lemma":"இன்","gloss":"in"}],"gloss":"in the grove"}]},{"words":[{"surface":"ஒதுக்கு","parts":[{"text":"ஒதுக்கு","lemma":"ஒதுக்கு","gloss":"secluded"}],"gloss":"secluded"},{"surface":"இன்","parts":[{"text":"இன்","lemma":"இனிமை","gloss":"sweet"}],"gloss":"pleasant"},{"surface":"திணி","parts":[{"text":"திணி","lemma":"திணி","gloss":"dense"}],"gloss":"dense"},{"surface":"மணல்","parts":[{"text":"மணல்","lemma":"மணல்","gloss":"sand"}],"gloss":"sand"},{"surface":"புது","parts":[{"text":"புது","lemma":"புதுமை","gloss":"fresh"}],"gloss":"fresh"},{"surface":"பூம்","parts":[{"text":"பூம்","lemma":"பூம்","gloss":"flower"}],"gloss":"flower","split_unverified":true},{"surface":"பள்ளி","parts":[{"text":"பள்ளி","lemma":"பள்ளி","gloss":"bed"}],"gloss":"bed"}]},{"words":[{"surface":"வாயின்","parts":[{"text":"வாயின்","lemma":"வாயின்","gloss":"at the gates"}],"gloss":"at the gates","split_unverified":true},{"surface":"மாடந்தொறும்","parts":[{"text":"மாடம்","lemma":"மாடம்","gloss":"mansion"},{"text":"தொறும்","lemma":"தொறும்","gloss":"every"}],"gloss":"in every mansion"},{"surface":"மை","parts":[{"text":"மை","lemma":"மை","gloss":"black"}],"gloss":"black"},{"surface":"விடை","parts":[{"text":"விடை","lemma":"விடை","gloss":"ram"}],"gloss":"ram"},{"surface":"வீழ்ப்ப","parts":[{"text":"வீழ்ப்ப","lemma":"வீழ்த்து","gloss":"sacrificing"}],"gloss":"sacrificing"}]},{"words":[{"surface":"நீ","parts":[{"text":"நீ","lemma":"நீ","gloss":"you"}],"gloss":"you"},{"surface":"ஆங்கு","parts":[{"text":"ஆங்கு","lemma":"ஆங்கு","gloss":"there"}],"gloss":"there"},{"surface":"கொண்ட","parts":[{"text":"கொண்ட","lemma":"கொள்","gloss":"celebrated"}],"gloss":"celebrated"},{"surface":"விழவினும்","parts":[{"text":"விழவு","lemma":"விழவு","gloss":"festival"},{"text":"இன்","lemma":"இன்","gloss":"than"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"than the festivals"},{"surface":"பலவே","parts":[{"text":"பல","lemma":"பல","gloss":"many"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"are many indeed"}]}],"literal":"Forest-dwelling life furious-dog hunter / deer-flesh filled basket-and cowherd-woman / curd-bringing came pot-and to-be-filled / by-the-plough living-ones big-house women / under-the-tank grown threshing-floor-gathered white-paddy / scooped-out giving, rejoicing departed / southern lord-of-hills bad-country-even-in / seven-fortresses gate battering capturing your / wide-mouthed tiger engraving might / singers Vañci-songs singing, warriors / dust-dung street military-camp to-shine / unfading green-leaves placing-between strung / unopened garland ball resembled / meat-rice heap bard's-family feeding / majestic-is behold! your fierce-battlefront camp / skilled-artisan fashioned painted-beauty possessed / pith puppet dancing-beauty resembling / loving two-persons except midnight / solitary-man not-frequenting cool-flower grove-in / secluded pleasant dense sand fresh-flower bed / at-the-gates mansion-every black-ram sacrificing / you there celebrated than-festivals are-many-indeed","translation":"The hunter with furious dogs from the forest brings baskets filled with venison, and the cowherd woman brings pots filled with curd. To fill these, the women of the spacious homes of the farmers who live by the plough scoop out and give white paddy grown under the irrigation tanks and gathered at the threshing floors, and they depart rejoicing. Even in the poor land of the southern lord of the hills, you battered down the gates of the seven fortresses, captured them, and engraved your wide-mouthed tiger emblem. While bards sing songs of victory and warriors shine in the military camp on streets dusty with dry dung, you feed the bards' families with heaps of meat and rice that resemble balls made of tightly strung garlands of unopened buds and fresh green leaves. Behold, your camp on the fierce battlefront is majestic indeed! The military camps you have held are even more numerous than the festivals you celebrated there, where black rams are sacrificed at every mansion gate, and where lovers (and no solitary man) walk at midnight in the cool flower groves on secluded, pleasant, sandy beds of fresh flowers, resembling the dancing beauty of pith puppets fashioned with painted beauty by a skilled artisan.","modern":"காட்டில் வாழும் சினமிகுந்த நாய்களைக் கொண்ட வேடன் கொண்டுவந்த மான் தசை நிறைந்த கூடையும், இடைமகள் தயிர் கொண்டுவந்த பானையும் நிறையுமாறு, ஏர்த்தொழில் செய்து வாழும் உழவர்களின் பெரிய வீட்டுப் பெண்கள், குளத்து நீர்ப்பாசனத்தால் விளைந்து களத்தில் குவிக்கப்பட்ட வெண்ணெல்லை அள்ளி அள்ளிக் கொடுக்க, அவர்கள் மகிழ்ச்சியோடு திரும்புவர். தென்னாட்டிற்குரிய பாண்டியனின் புன்னாட்டிலும், அவனது ஏழு கோட்டைகளின் கதவுகளைத் தகர்த்து, அவற்றைக் கைப்பற்றி, உனது அகன்ற வாயையுடைய புலிச் சின்னத்தைப் பொறித்தாய். உனது ஆற்றலைப் பாணர்கள் வஞ்சிப் பாடல்களாகப் பாட, வீரர்கள் துகள் நிறைந்த தெருக்களைக் கொண்ட பாசறையில் விளங்க, வாடாத பச்சிலைகளுக்கு இடையே தொடுக்கப்பட்ட மலராத அரும்பு மாலைப் பந்தைப் போன்ற ஊன் சோற்றின் திரளைப் பாணர்களின் சுற்றத்தாருக்கு நீ உணவாக அளிக்கிறாய். உனது வெம்மையான போர்க்களப் பாசறை மிகவும் பெருமைக்குரியது! திறமைமிக்க கலைஞன் செய்த அழகிய அல்லிப் பாவை ஆடுவதைப் போல, காதலர் இருவரைத் தவிர நள்ளிரவில் வேறு எவரும் நடமாடாத, குளிர்ந்த மலர்ச் சோலையின் ஒதுக்குப்புறமான மணல் பரப்பிய புதுப்பூப் படுக்கையிடத்தே, வாயிலின் மாடங்கள் தோறும் கரிய கடாக்களைப் பலியிட்டு நீ கொண்டாடிய விழாக்களைக் காட்டிலும், நீ மேற்கொண்ட போர்க்களப் பாசறைகள் பலவாகும்!","explanation":"The poet Kovur Kilar praises the Chola king Nalankilli in this poem belonging to the Vakai tinai (victory and bravery), specifically the theme of Arasavakai. The poem begins by illustrating the prosperity of the Chola land, where forest hunters and pastoral cowherds exchange their venison and curd for the abundant white paddy given by farming women. It then highlights the king's military conquests, describing how he shattered the gates of seven fortresses in the southern Pandya territory and engraved his tiger emblem. In the battle camp, the king generously feeds the bards' families with massive heaps of meat and rice, which are beautifully compared to balls of tightly strung flower buds and green leaves. Finally, the poet praises the king's constant campaigns by stating that his military camps are even more numerous than the grand festivals celebrated in his land, where black rams are sacrificed and lovers meet in secluded, sandy groves.","model":"gemini-3.5-flash"}}