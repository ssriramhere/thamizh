,"gloss":"high"}],"gloss":"high"},{"surface":"நிலை","parts":[{"text":"நிலை","lemma":"nilai","gloss":"level"}],"gloss":"level"},{"surface":"மாடத்து","parts":[{"text":"மாடத்து","lemma":"மாடத்து","gloss":"of the mansion"}],"gloss":"of the mansion","split_unverified":true},{"surface":"குறும்பறை","parts":[{"text":"குறும்","lemma":"kuṟum","gloss":"short"},{"text":"பறை","lemma":"paṟai","gloss":"wing/flight"}],"gloss":"short-winged/short flight"},{"surface":"அசைஇ","parts":[{"text":"அசைஇ","lemma":"acaii","gloss":"having rested"}],"gloss":"having rested"}]},{"words":[{"surface":"வாயில்","parts":[{"text":"வாயில்","lemma":"vāyil","gloss":"gate/guard"}],"gloss":"gate/guard"},{"surface":"விடாது","parts":[{"text":"விடாது","lemma":"viṭātu","gloss":"without stopping"}],"gloss":"without stopping"},{"surface":"கோயில்","parts":[{"text":"கோயில்","lemma":"kōyil","gloss":"palace"}],"gloss":"palace"},{"surface":"புக்கு","parts":[{"text":"புக்கு","lemma":"pukku","gloss":"having entered"}],"gloss":"having entered"},{"surface":"எம்","parts":[{"text":"எம்","lemma":"em","gloss":"our"}],"gloss":"our"}]},{"words":[{"surface":"பெருங்","parts":[{"text":"பெருங்","lemma":"பெருங்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"கோக்","parts":[{"text":"கோக்","lemma":"கோக்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"கிள்ளி","parts":[{"text":"கிள்ளி","lemma":"கிள்ளி","gloss":""}],"gloss":"","split_unverified":true},{"surface":"கேட்க","parts":[{"text":"கேட்க","lemma":"கேட்க","gloss":""}],"gloss":"","split_unverified":true},{"surface":"இரும்பிசிர்","parts":[{"text":"இரும்பிசிர்","lemma":"இரும்பிசிர்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"ஆந்தை","parts":[{"text":"ஆந்தை","lemma":"āntai","gloss":"Antai"}],"gloss":"Antai"},{"surface":"அடியுறை","parts":[{"text":"அடி","lemma":"aṭi","gloss":"feet"},{"text":"உறை","lemma":"uṟai","gloss":"dwelling"}],"gloss":"servant"},{"surface":"எனினே","parts":[{"text":"எனின்","lemma":"eṉiṉ","gloss":"if you say"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"if you say indeed"},{"surface":"மாண்ட","parts":[{"text":"மாண்ட","lemma":"māṇṭa","gloss":"glorious"}],"gloss":"glorious"},{"surface":"நின்","parts":[{"text":"நின்","lemma":"niṉ","gloss":"your"}],"gloss":"your"}]},{"words":[{"surface":"இன்புறு","parts":[{"text":"இன்பு","lemma":"iṉpu","gloss":"pleasure"},{"text":"உறு","lemma":"uṟu","gloss":"having"}],"gloss":"sweet"},{"surface":"பேடை","parts":[{"text":"பேடை","lemma":"pēṭai","gloss":"female bird"}],"gloss":"female bird"},{"surface":"அணிய","parts":[{"text":"அணிய","lemma":"aṇiya","gloss":"to adorn"}],"gloss":"to adorn"},{"surface":"தன்","parts":[{"text":"தன்","lemma":"taṉ","gloss":"his"}],"gloss":"his"}]},{"words":[{"surface":"அன்புறு","parts":[{"text":"அன்பு","lemma":"aṉpu","gloss":"love"},{"text":"உறு","lemma":"uṟu","gloss":"having"}],"gloss":"loving"},{"surface":"நன்கலம்","parts":[{"text":"நன்கலம்","lemma":"நன்கலம்","gloss":"fine ornaments"}],"gloss":"fine ornaments","split_unverified":true},{"surface":"நல்குவன்","parts":[{"text":"நல்கு","lemma":"nalku","gloss":"give"},{"text":"அன்","lemma":"aṉ","gloss":"he"}],"gloss":"he will give"},{"surface":"நினக்கே","parts":[{"text":"நினக்கு","lemma":"niṉakku","gloss":"to you"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"to you indeed"}]}],"literal":"O male swan! O male swan! / The lord of victorious battles who wins wars, / like his bright face that protects the country, / the crescent moon joins to shine with budding moonlight / in this confusing evening, while we grieve helplessly, / if you, after eating ayirai fish in the beautiful great ghat of Kumari, / return to the northern mountains, on the way / if you land in the good Chola country, at Kōḻi, / resting your short wings on the high-level mansions, / without being stopped at the gate, entering the palace, / if you say to our great king Kiḷḷi: 'I am a servant of Pisir Āntai', / he will give you his own loving, fine ornaments / for your sweet female mate to wear.","translation":"O male swan, O male swan! While we grieve helplessly in this confusing evening, when the crescent moon joins to shine with budding moonlight, resembling the bright face of our lord who wins victorious battles and protects his land, if you, after feeding on the ayirai fish in the beautiful, great ghat of Kumari, fly back to the northern mountains, and on your way land in Kōḻi in the fertile Chola country, rest your short wings on the high mansions, enter the palace without being stopped by the guards, and say to our great king Kiḷḷi: 'I am a servant of Pisir Āntai,' he will surely give you precious, loving ornaments for your sweet mate to wear.","modern":"அன்னச் சேவலே! அன்னச் சேவலே! வெற்றி கொள்ளும் போர்களைச் செய்யும் தலைவன் தன் நாட்டைப் பாதுகாக்கும் ஒளி பொருந்திய முகத்தைப் போல, பிறை நிலா கூடி இளநிலவாக விளங்கும் இந்த மயக்கத்தைத் தரும் மாலைப் பொழுதில் நாம் துணையின்றி வருந்த, குமரியின் அழகிய பெரிய துறையில் அயிரை மீன்களை உண்டு, வடதிசை மலைக்குத் திரும்புவாயானால், வழியில் உள்ள வளமிக்க சோழ நாட்டின் தலைநகரான உறையூரில் (கோழியில்), உயர்ந்த மாடங்களில் உனது சிறிய சிறகுகளை அசைத்து இளைப்பாறி, வாயில் காவலர்கள் தடுக்காமல் அரண்மனைக்குள் புகுந்து, எம் பெருவரசனான கிள்ளியிடம், 'நான் பெருமைக்குரிய பிசிரில் வாழும் ஆந்தையின் அடியவன்' என்று சொன்னால், அவன் உனக்கு, உன்னுடைய இனிய பெண் அன்னம் அணிந்து கொள்ளத் தன் அன்பான சிறந்த அணிகலன்களை வழங்குவான்.","explanation":"This poem belongs to the pāṭāṇ tiṇai (praise of a patron) and is composed by the poet Picirāntaiyār, addressed to the Chola king Kōpperuñ Cōḻaṉ. The poet, residing in the Pandya country, has never met the Chola king but has formed a deep, legendary friendship with him through reputation. He addresses a migrating swan as a messenger, asking it to stop at the Chola capital, Kōḻi (Uraiyur), on its way from Cape Comorin (Kumari) to the Himalayas. The poet assures the swan that if it enters the palace and introduces itself as a friend of Picir Āntai, the generous king will gift it precious ornaments for its mate. The imagery of the crescent moon resembling the king's protective face highlights the king's benevolence, while the swan's journey connects the far south to the north, symbolizing the universal fame of the king.","model":"gemini-3.5-flash"}}