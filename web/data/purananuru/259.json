{"text":"purananuru","n":259,"lines":["ஏறுஉடைப் பெருநிரை பெயர்தரப் பெயராது","இலைபுதை பெருங்காட்டுத் தலைகரந்து இருந்த","வல்வில் மறவர் ஒடுக்கம் காணாய்","செல்லல் செல்லல் சிறக்க நின் உள்ளம்","முதுகுமெய்ப் புலைத்தி போலத்","தாவுபு தெறிக்கும் ஆன்மேல்","புடையிலங்கு ஒள்வாள் புனைகழ லோயே"],"tr":["ēṟuuṭaip perunirai peyartarap peyarātu","ilaiputai peruṅkāṭṭut talaikarantu irunta","valvil maṟavar oṭukkam kāṇāy","cellal cellal ciṟakka niṉ uḷḷam","mutukumeyp pulaitti pōlat","tāvupu teṟikkum āṉmēl","puṭaiyilaṅku oḷvāḷ puṉaikaḻa lōyē"],"colophon":{"tinai":"karantai","tinai_ta":"கரந்தை","turai_ta":"செருமலைதல்","poet_ta":"கோடை பாடிய பெரும்பூதனார்","poet_tr":"Kōṭai Pāṭiya Perumpūtaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 10, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஏறுடைப்","tr":"ēṟuṭaip","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஏ","tr":"ē"},{"kind":"nirai","text":"றுடைப்","tr":"ṟuṭaip"}]},{"text":"பெருநிரை","tr":"perunirai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெரு","tr":"peru"},{"kind":"nirai","text":"நிரை","tr":"nirai"}]},{"text":"பெயர்தரப்","tr":"peyartarap","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெயர்","tr":"peyar"},{"kind":"nirai","text":"தரப்","tr":"tarap"}]},{"text":"பெயரா","tr":"peyarā","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெய","tr":"peya"},{"kind":"nēr","text":"ரா","tr":"rā"}]}],[{"text":"திலைபுதை","tr":"tilaiputai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"திலை","tr":"tilai"},{"kind":"nirai","text":"புதை","tr":"putai"}]},{"text":"பெருங்காட்டுத்","tr":"peruṅkāṭṭut","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"பெருங்","tr":"peruṅ"},{"kind":"nēr","text":"காட்","tr":"kāṭ"},{"kind":"nēr","text":"டுத்","tr":"ṭut"}]}