{"text":"purananuru","n":121,"lines":["ஒரு திசை ஒருவனை உள்ளி நாற்றிசைப்","பலரும் வருவர் பரிசில் மாக்கள்","வரிசை அறிதலோ அரிதே பெரிதும்","ஈதல் எளிதே மாவண் தோன்றல்","அது நற்கு அறிந்தனை யாயின்","பொது நோக்கு ஒழிமதி புலவர் மாட்டே"],"tr":["oru ticai oruvaṉai uḷḷi nāṟṟicaip","palarum varuvar paricil mākkaḷ","varicai aṟitalō aritē peritum","ītal eḷitē māvaṇ tōṉṟal","atu naṟku aṟintaṉai yāyiṉ","potu nōkku oḻimati pulavar māṭṭē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"பொருண் மொழிக் காஞ்சி","poet_ta":"கபிலர்","addressed_ta":"மலையமான் திருமுடிக்காரி","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 12, āciriyattaḷai 10"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஒருதிசை","tr":"oruticai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"ஒரு","tr":"oru"},{"kind":"nirai","text":"திசை","tr":"ticai"}]},{"text":"யொருவனை","tr":"yoruvaṉai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"யொரு","tr":"yoru"},{"kind":"nirai","text":"வனை","tr":"vaṉai"}]},{"text":"யுள்ளி","tr":"yuḷḷi","foot":"tēmā","acai":[{"kind":"nēr","text":"யுள்","tr":"yuḷ"},{"kind":"nēr","text":"ளி","tr":"ḷi"}]},{"text":"நாற்றிசைப்","tr":"nāṟṟicaip","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நாற்","tr":"nāṟ"},{"kind":"nirai","text":"றிசைப்","tr":"ṟicaip"}]}],[{"text":"பலரும்","tr":"palarum","foot":"puḷimā","acai":[{"kind":"nirai","text":"பல","tr":"pala"},{"kind":"nēr","text":"ரும்","tr":"rum"}]},{"text":"வருவர்","tr":"varuvar","foot":"puḷimā","acai":[{"kind":"nirai","text":"வரு","tr":"varu"},{"kind":"nēr","text":"வர்","tr":"var"}]},{"text":"பரிசில்","tr":"paricil","foot":"puḷimā","acai":[{"kind":"nirai","text":"பரி","tr":"pari"},{"kind":"nēr","text":"சில்","tr":"cil"}]},{"text":"மாக்கள்","tr":"mākkaḷ","foot":"tēmā"