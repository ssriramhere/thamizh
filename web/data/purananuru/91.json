{"text":"purananuru","n":91,"lines":["வலம்படு வாய்வாள் ஏந்தி ஒன்னார்","களம்படக் கடந்த கழல்தொடி தடக்கை","ஆர்கலி நறவின் அதியர் கோமான்","போர்அடு திருவின் பொலந்தார் அஞ்சி","பால் புரை பிறைநுதல் பொலிந்த சென்னி","நீல மணிமிடற்று ஒருவன் போல","மன்னுக பெரும நீயே தொன்னிலைப்","பெருமலை விடரகத்து அருமிசை கொண்ட","சிறியிலை நெல்லித் தீங்கனி குறியாது","ஆதல் நின்னகத்து அடக்கிச்","சாதல் நீங்க எமக்கு ஈத்தனையே"],"tr":["valampaṭu vāyvāḷ ēnti oṉṉār","kaḷampaṭak kaṭanta kaḻaltoṭi taṭakkai","ārkali naṟaviṉ atiyar kōmāṉ","pōraṭu tiruviṉ polantār añci","pāl purai piṟainutal polinta ceṉṉi","nīla maṇimiṭaṟṟu oruvaṉ pōla","maṉṉuka peruma nīyē toṉṉilaip","perumalai viṭarakattu arumicai koṇṭa","ciṟiyilai nellit tīṅkaṉi kuṟiyātu","ātal niṉṉakattu aṭakkic","cātal nīṅka emakku īttaṉaiyē"],"colophon":{"tinai":"tumpai","tinai_ta":"தும்பை","turai_ta":"வாழ்த்தியல்","poet_ta":"ஔவையார்","addressed_ta":"அதியமான் நெடுமான் அஞ்சி","poet_tr":"Auvaiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"11 lines"},{"name":"feet per line","ok":true,"detail":"11×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 44"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 32, veṇṭaḷai 11"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வலம்படு","tr":"valampaṭu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வலம்","tr":"valam"},{"kind":"nirai","text":"படு","tr":"paṭu"}]},{"text":"வாய்வா","tr":"vāyvā","foot":"tēmā","acai":[{"kind":"nēr","text":"வாய்","tr":"vāy"},{"kind":"nēr","text":"வா","tr":"vā"}]},{"text":"ளேந்தி","tr":"ḷēnti","foot":"tēmā","acai":[{"kind":"nēr","text":"ளேந்","tr":"ḷēn"},{"kind":"nēr","text":"தி","tr":"ti"}]},{"text":"யொன்னார்","tr":"yoṉṉār","foot":"tēmā","acai":[{"kind":"nēr","text":"யொன்","tr":"yoṉ"},{"kind":"nēr","text":"னார்","tr":"ṉār"}]}],[{"text":"களம்படக்","tr":"kaḷampaṭak","foot":"karuviḷam","acai":[{"kind":"nirai","text":"களம்","tr":"kaḷam"},{"kind":"nirai","text":"படக்","tr":"paṭak"}]},{"text":"கடந்