:"நின்","tr":"niṉ"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"தோல்","parts":[{"text":"தோல்","lemma":"தோல்","gloss":"shield"}],"gloss":"shield"},{"surface":"தா","parts":[{"text":"தா","lemma":"தா","gloss":"give"}],"gloss":"give"},{"surface":"தோல்","parts":[{"text":"தோல்","lemma":"தோல்","gloss":"shield"}],"gloss":"shield"},{"surface":"தா","parts":[{"text":"தா","lemma":"தா","gloss":"give"}],"gloss":"give"},{"surface":"என்றி","parts":[{"text":"என்","lemma":"எனல்","gloss":"say"},{"text":"தி","lemma":"-தி","gloss":"you (singular suffix)"}],"gloss":"you say"},{"surface":"தோலொடு","parts":[{"text":"தோல்","lemma":"தோல்","gloss":"shield"},{"text":"ஒடு","lemma":"-ஒடு","gloss":"with (sociative suffix)"}],"gloss":"with the shield"}]},{"words":[{"surface":"துறுகல்","parts":[{"text":"துறு","lemma":"துறு","gloss":"dense/thick"},{"text":"கல்","lemma":"கல்","gloss":"stone/rock"}],"gloss":"boulder"},{"surface":"மறையினும்","parts":[{"text":"மறை","lemma":"மறைதல்","gloss":"hide"},{"text":"இன்","lemma":"-இன்","gloss":"conditional suffix"},{"text":"உம்","lemma":"-உம்","gloss":"even/although"}],"gloss":"even if hiding"},{"surface":"உய்குவை","parts":[{"text":"உய்","lemma":"உய்தல்","gloss":"escape"},{"text":"கு","lemma":"-கு-","gloss":"future tense marker"},{"text":"வை","lemma":"-வை","gloss":"you (singular suffix)"}],"gloss":"you will escape"},{"surface":"போலாய்","parts":[{"text":"போல்","lemma":"போலுதல்","gloss":"resemble/seem"},{"text":"ஆய்","lemma":"-ஆய்","gloss":"not (negative second person suffix)"}],"gloss":"you do not seem"}]},{"words":[{"surface":"நெருநல்","parts":[{"text":"நெருநல்","lemma":"நெருநல்","gloss":"yesterday"}],"gloss":"yesterday"},{"surface":"எல்லை","parts":[{"text":"எல்லை","lemma":"எல்லை","gloss":"daytime/sun"}],"gloss":"daytime"},{"surface":"நீ","parts":[{"text":"நீ","lemma":"நீ","gloss":"you"}],"gloss":"you"},{"surface":"எறிந்தோன்","parts":[{"text":"எறிந்தோன்","lemma":"எறிந்தோன்","gloss":"he who struck"}],"gloss":"he who struck","split_unverified":true},{"surface":"தம்பி","parts":[{"text":"தம்பி","lemma":"தம்பி","gloss":"younger brother"}],"gloss":"younger brother"}]},{"words":[{"surface":"அகல்","parts":[{"text":"அகல்","lemma":"அகல்","gloss":"wide bowl/lamp"}],"gloss":"wide bowl"},{"surface":"பெய்","parts":[{"text":"பெய்","lemma":"பெய்தல்","gloss":"place/pour"}],"gloss":"placed"},{"surface":"குன்றியின்","parts":[{"text":"குன்றி","lemma":"குன்றி","gloss":"kunri seed"},{"text":"இன்","lemma":"-இன்","gloss":"like (comparative suffix)"}],"gloss":"like a kunri seed"},{"surface":"சுழலும்","parts":[{"text":"சுழல்","lemma":"சுழலுதல்","gloss":"spin/roll"},{"text":"உம்","lemma":"-உம்","gloss":"adjectival participle suffix"}],"gloss":"spinning"},{"surface":"கண்ணன்","parts":[{"text":"கண்","lemma":"கண்","gloss":"eye"},{"text":"அன்","lemma":"-அன்","gloss":"he who has (masculine suffix)"}],"gloss":"he who has eyes"}]},{"words":[{"surface":"பேரூர்","parts":[{"text":"பேர்","lemma":"பெருமை","gloss":"big"},{"text":"ஊர்","lemma":"ஊர்","gloss":"village"}],"gloss":"big village"},{"surface":"அட்ட","parts":[{"text":"அட்ட","lemma":"அட்ட","gloss":"brewed"}],"gloss":"brewed","split_unverified":true},{"surface":"கள்ளிற்கு","parts":[{"text":"கள்","lemma":"கள்","gloss":"toddy"},{"text":"இன்","lemma":"-இன்-","gloss":"oblique case marker"},{"text":"கு","lemma":"-கு","gloss":"for (dative suffix)"}],"gloss":"for the toddy"}]},{"words":[{"surface":"ஓர்","parts":[{"text":"ஓர்","lemma":"ஒன்று","gloss":"one"}],"gloss":"one"},{"surface":"இல்","parts":[{"text":"இல்","lemma":"இல்","gloss":"house"}],"gloss":"house"},{"surface":"கோயின்","parts":[{"text":"கோயின்","lemma":"கோயின்","gloss":"like a temple"}],"gloss":"like a temple","split_unverified":true},{"surface":"தேருமால்","parts":[{"text":"தேரும்","lemma":"தேருதல்","gloss":"will search"},{"text":"ஆல்","lemma":"-ஆல்","gloss":"indeed (emphatic clitic)"}],"gloss":"searches indeed"},{"surface":"நின்னே","parts":[{"text":"நின்","lemma":"நீ","gloss":"you"},{"text":"ஏ","lemma":"-ஏ","gloss":"indeed (emphatic particle)"}],"gloss":"you indeed"}]}],"literal":"\"Give [me] a shield, give [me] a shield!\" you say, with a shield / even if you hide behind a boulder, you do not seem like one who will escape. / Yesterday, in the daytime, the younger brother of the one you struck, / having eyes that spin like a kunri seed placed in a wide bowl, / for the sake of the toddy brewed in the big village, / searches for you indeed, house by house, as if searching a temple!","translation":"\"Give me a shield! Give me a shield!\" you cry out. But even if you hide behind a massive boulder with your shield, you do not seem like one who will escape. Yesterday, in the broad daylight, you struck down a warrior. Now, his younger brother—with eyes rolling red and furious like kunri seeds placed in a wide bowl—is searching for you house by house, as if searching a temple, eager to claim you as the price for the strong toddy brewed in this great town!","modern":"\"எனக்குக் கேடயம் தா, கேடயம் தா!\" என்று நீ கேட்கிறாய். கேடயத்தோடு ஒரு பெரிய பாறையின் பின்னே மறைந்து கொண்டாலும் நீ தப்பிப் பிழைப்பாய் என்று தோன்றவில்லை. நேற்று பகல் பொழுதில் உன்னால் கொல்லப்பட்டவனுடைய தம்பி, அகன்ற தட்டில் வைக்கப்பட்ட குன்றிமணி போலச் சுழலும் கண்களை உடையவனாய், பெரிய ஊரில் வடிக்கப்பட்ட கள்ளைக் குடிப்பதற்காக, உன்னைத் தேடி ஒவ்வொரு வீடாகக் கோயில் போலக் கருதித் தேடி வருகிறான்.","explanation":"An onlooker or poet addresses a terrified warrior on the battlefield who is desperately begging for a shield to hide behind a boulder. The speaker warns him that hiding is completely futile because of his actions from the previous day. Yesterday, this warrior killed another soldier in broad daylight, and now the slain soldier's younger brother is hunting him down. The brother's eyes are described as spinning with rage, compared vividly to red-and-black kunri seeds rolling in a wide bowl. He is searching every single house in the settlement with absolute focus, treating each house like a temple, determined to find and kill this warrior to earn the celebratory toddy brewed in the town.","model":"gemini-3.5-flash"}}