{"text":"purananuru","n":300,"lines":["தோல்தா தோல்தா என்றி தோலொடு","துறுகல் மறையினும் உய்குவை போலாய்","நெருநல் எல்லைநீ எறிந்தோன் தம்பி","அகல்பெய் குன்றியின் சுழலும் கண்ணன்","பேரூர் அட்ட கள்ளிற்கு","ஓர் இல் கோயின் தேருமால் நின்னே"],"tr":["tōltā tōltā eṉṟi tōloṭu","tuṟukal maṟaiyiṉum uykuvai pōlāy","nerunal ellainī eṟintōṉ tampi","akalpey kuṉṟiyiṉ cuḻalum kaṇṇaṉ","pērūr aṭṭa kaḷḷiṟku","ōr il kōyiṉ tērumāl niṉṉē"],"colophon":{"tinai":"tumpai","tinai_ta":"தும்பை","turai_ta":"தானைமறம்","poet_ta":"அரிசில் கிழார்","poet_tr":"Aricil Kiḻār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 14, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"தோல்தா","tr":"tōltā","foot":"tēmā","acai":[{"kind":"nēr","text":"தோல்","tr":"tōl"},{"kind":"nēr","text":"தா","tr":"tā"}]},{"text":"தோல்தா","tr":"tōltā","foot":"tēmā","acai":[{"kind":"nēr","text":"தோல்","tr":"tōl"},{"kind":"nēr","text":"தா","tr":"tā"}]},{"text":"வென்றி","tr":"veṉṟi","foot":"tēmā","acai":[{"kind":"nēr","text":"வென்","tr":"veṉ"},{"kind":"nēr","text":"றி","tr":"ṟi"}]},{"text":"தோலொடு","tr":"tōloṭu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nirai","text":"லொடு","tr":"loṭu"}]}],[{"text":"துறுகல்","tr":"tuṟukal","foot":"puḷimā","acai":[{"kind":"nirai","text":"துறு","tr":"tuṟu"},{"kind":"nēr","text":"கல்","tr":"kal"}]},{"text":"மறையினு","tr":"maṟaiyiṉu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மறை","tr":"maṟai"},{"kind":"nirai","text":"யினு","tr":"yiṉu"}]},{"text":"முய்குவை","tr":"muykuvai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"முய்","tr":"muy"},{"kind":"nirai","text":"குவை","tr":"kuvai"}]},{"text":"போலாய்","tr":"pōlāy","foot":"tēmā","acai":[{"kind":"nēr","text":"போ","tr":"pō"},{"kind":"nēr","text":"லாய்","tr":"lāy"}]}],