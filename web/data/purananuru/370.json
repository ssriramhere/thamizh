aving heaped"]],[["படுபிணப்","fallen corpses"]],[["பல்போர்பு","many heaps"]],[["அழிய","to scatter"]],[["வாங்கி","having gathered"]],[["எருது","bull"],["களிறாக","as male elephants"]],[["களிறாக","as male elephants"]],[["வாள்மடல்","sword-blades"]],[["ஓச்சி","having wielded"]],[["அதரி","threshing floor"]],[["திரித்த","threshed"]],[["ஆளுகு","where men fall"]],[["கடாவின்","of the male buffalo"]],[["அகன்","wide"],["கண்","drumhead"]],[["தடாரி","Taṭāri drum"]],[["தெளிர்ப்ப","to sound clearly"]],[["ஒற்றி","having beaten"]],[["வெந்திறல்","fierce victory"]],[["வியன்களம்","wide field"]],[["பொலிக","may it flourish"]],[["என்று","saying"]],[["ஏத்தி","having praised"]],[["இருப்புமுகம்","iron-tipped"]],[["செறித்த","fitted"]],[["ஏந்து","lofty"]],[["எழில்","beautiful"]],[["மருப்பின்","of the tusk"]],[["வரைமருள்","mountain-resembling"]],[["முகவைக்கு","for the gift"]],[["வந்தனென்","I came"]],[["பெரும","O great lord"]],[["வடிநவில்",""]],[["எஃகம்",""]],[["பாய்ந்தெனக்",""]],[["கிடந்த",""]],[["தொடியுடைத்","having armlets"]],[["தடக்கை","large hands"]],[["ஓச்சி","having raised"]],[["வெருவார்","those who do not fear"]],[["இனத்துஅடி","flesh of the group"]],[["விராய","mixed"]],[["வரிக்குடர்","striped intestines"]],[["அடைச்சி","having stuffed"]],[["அழுகுரற்","weeping voice"]],[["பேய்மகள்","demoness"]],[["அயரக்","to dance"]],[["கழுகொடு","with vultures"]],[["செஞ்செவி","red-eared"]],[["எருவை","vulture"]],[["திரிதரும்","wandering"]],[["அஞ்சுவரு","fear-inducing"]],[["கிடக்கைய","having the expanse"]],[["களம்","battlefield"],["கிழவோயே","O lord!"]],[["கிழவோயே","O lord!"]]]}