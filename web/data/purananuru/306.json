{"text":"purananuru","n":306,"lines":["களிறுபொரக் கலங்கு கழன்முள் வேலி","அரிதுஉண் கூவல் அங்குடிச் சீறூர்","ஒலிமென் கூந்தல் ஒண்ணுதல் அரிவை","நடுகல் கைதொழுது பரவும் ஒடியாது","விருந்து எதிர் பெறுகதில் யானே என்ஐயும்","ஒ … வேந்தனொடு","நாடுதரு விழுப்பகை எய்துக எனவே"],"tr":["kaḷiṟuporak kalaṅku kaḻaṉmuḷ vēli","arituuṇ kūval aṅkuṭic cīṟūr","olimeṉ kūntal oṇṇutal arivai","naṭukal kaitoḻutu paravum oṭiyātu","viruntu etir peṟukatil yāṉē eṉaiyum","o vēntaṉoṭu","nāṭutaru viḻuppakai eytuka eṉavē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"மூதின் முல்லை","poet_ta":"அள்ளூர் நன் முல்லையார்","poet_tr":"Aḷḷūr Naṉ Mullaiyār"},"scan":{"meter":"iṇaikkuṟaḷ āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×2 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 4, other 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 7, kalittaḷai 4, ? 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"களிறுபொரக்","tr":"kaḷiṟuporak","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"களி","tr":"kaḷi"},{"kind":"nirai","text":"றுபொ","tr":"ṟupo"},{"kind":"nēr","text":"ரக்","tr":"rak"}]},{"text":"கலங்கு","tr":"kalaṅku","foot":"puḷimā","acai":[{"kind":"nirai","text":"கலங்","tr":"kalaṅ"},{"kind":"nēr","text":"கு","tr":"ku"}]},{"text":"கழன்முள்","tr":"kaḻaṉmuḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கழன்","tr":"kaḻaṉ"},{"kind":"nēr","text":"முள்","tr":"muḷ"}]},{"text":"வேலி","tr":"vēli","foot":"tēmā","acai":[{"kind":"nēr","text":"வே","tr":"vē"},{"kind":"nēr","text":"லி","tr":"li"}]}],[{"text":"யரிதுண்","tr":"yarituṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"யரி","tr":"yari"},{"kind":"nēr","text":"துண்","tr":"tuṇ"}]},{"text":"கூவ","tr":"kūva","foot":"tēmā","acai":[{"kind":"nēr","text":"கூ","tr":"kū"},{"kind":"nēr","text":"வ","tr":"va"}]},{"text":"லங்குடிச்","tr":"laṅkuṭic","foot":"kūviḷam","acai":[{"kind":"nēr","text":"லங்","tr":"laṅ"}