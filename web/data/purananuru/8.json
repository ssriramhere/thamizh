":true}]},{"words":[{"surface":"இடம்","parts":[{"text":"இடம்","lemma":"iṭam","gloss":"space/territory"}],"gloss":"space"},{"surface":"சிறிது","parts":[{"text":"சிறிது","lemma":"ciṟitu","gloss":"is small"}],"gloss":"is small"},{"surface":"என்னும்","parts":[{"text":"என்னும்","lemma":"eṉ","gloss":"saying/thinking"}],"gloss":"thinking"},{"surface":"ஊக்கம்","parts":[{"text":"ஊக்கம்","lemma":"ūkkam","gloss":"zeal/drive"}],"gloss":"zeal"},{"surface":"துரப்ப","parts":[{"text":"துரப்ப","lemma":"turattu","gloss":"to urge/drive"}],"gloss":"driving"}]},{"words":[{"surface":"ஒடுங்கா","parts":[{"text":"ஒடுங்கா","lemma":"oṭuṅku","gloss":"unshrinking"}],"gloss":"unshrinking"},{"surface":"உள்ளத்து","parts":[{"text":"உள்ளத்து","lemma":"உள்ளத்து","gloss":"of the mind"}],"gloss":"of the mind","split_unverified":true},{"surface":"ஓம்பா","parts":[{"text":"ஓம்பா","lemma":"ōmputal","gloss":"unsparing/limitless"}],"gloss":"unsparing"},{"surface":"ஈகை","parts":[{"text":"ஈகை","lemma":"īkai","gloss":"generosity/giving"}],"gloss":"generosity"}]},{"words":[{"surface":"கடந்து","parts":[{"text":"கடந்து","lemma":"kaṭa","gloss":"having conquered"}],"gloss":"having conquered"},{"surface":"அடு","parts":[{"text":"அடு","lemma":"aṭu","gloss":"destroying/killing"}],"gloss":"destroying"},{"surface":"தானை","parts":[{"text":"தானை","lemma":"tāṉai","gloss":"army"}],"gloss":"army"},{"surface":"சேரலாதனை","parts":[{"text":"சேரலாதன்","lemma":"cēralātaṉ","gloss":"Cheralathan"},{"text":"ஐ","lemma":"-ai","gloss":"accusative suffix"}],"gloss":"Cheralathan (accusative)"}]},{"words":[{"surface":"யாங்கனம்","parts":[{"text":"யாங்கனம்","lemma":"yāṅkaṉam","gloss":"how/in what way"}],"gloss":"how"},{"surface":"ஒத்தியோ","parts":[{"text":"ஒத்தி","lemma":"ottu","gloss":"you resemble"},{"text":"ஓ","lemma":"-ō","gloss":"interrogative particle"}],"gloss":"do you resemble?"},{"surface":"வீங்குசெலல்","parts":[{"text":"வீங்கு","lemma":"vīṅku","gloss":"swelling/mighty"},{"text":"செலல்","lemma":"celal","gloss":"movement/course"}],"gloss":"mighty-coursed"},{"surface":"மண்டிலம்","parts":[{"text":"மண்டிலம்","lemma":"maṇṭilam","gloss":"disc/sun"}],"gloss":"sun disc"}]},{"words":[{"surface":"பொழுது","parts":[{"text":"பொழுது","lemma":"poḻutu","gloss":"time/day"}],"gloss":"time"},{"surface":"என","parts":[{"text":"என","lemma":"eṉa","gloss":"as/saying"}],"gloss":"as"},{"surface":"வரைதி","parts":[{"text":"வரைதி","lemma":"varai","gloss":"you limit/measure"}],"gloss":"you limit"},{"surface":"புறக்கொடுத்து","parts":[{"text":"புறக்கொடுத்து","lemma":"புறக்கொடுத்து","gloss":"turning your back"}],"gloss":"turning your back","split_unverified":true},{"surface":"இறத்தி","parts":[{"text":"இறத்தி","lemma":"iṟa","gloss":"you pass/set"}],"gloss":"you set"}]},{"words":[{"surface":"மாறி","parts":[{"text":"மாறி","lemma":"māṟu","gloss":"changing/alternating"}],"gloss":"alternating"},{"surface":"வருதி","parts":[{"text":"வருதி","lemma":"vā","gloss":"you come"}],"gloss":"you come"},{"surface":"மலைமறைந்து","parts":[{"text":"மலை","lemma":"malai","gloss":"mountain"},{"text":"மறைந்து","lemma":"maṟai","gloss":"having hidden"}],"gloss":"hiding behind the mountain"},{"surface":"ஒளித்தி","parts":[{"text":"ஒளித்தி","lemma":"oḷi","gloss":"you hide"}],"gloss":"you hide yourself"}]},{"words":[{"surface":"அகல்","parts":[{"text":"அகல்","lemma":"akal","gloss":"wide"}],"gloss":"wide"},{"surface":"இரு","parts":[{"text":"இரு","lemma":"iru","gloss":"dark/vast"}],"gloss":"vast"},{"surface":"விசும்பினானும்","parts":[{"text":"விசும்பு","lemma":"vicumbu","gloss":"sky"},{"text":"இன்","lemma":"-iṉ","gloss":"oblique suffix"},{"text":"ஆனும்","lemma":"-āṉum","gloss":"even though/even in"}],"gloss":"even though in the sky"}]},{"words":[{"surface":"பகல்","parts":[{"text":"பகல்","lemma":"pakal","gloss":"daytime"}],"gloss":"daytime"},{"surface":"விளங்குதியால்","parts":[{"text":"விளங்குதி","lemma":"viḷaṅku","gloss":"you shine"},{"text":"ஆல்","lemma":"-āl","gloss":"indeed (emphatic)"}],"gloss":"you shine indeed"},{"surface":"பல்கதிர்","parts":[{"text":"பல்","lemma":"pala","gloss":"many"},{"text":"கதிர்","lemma":"katir","gloss":"rays"}],"gloss":"many rays"},{"surface":"விரித்தே","parts":[{"text":"விரித்து","lemma":"viri","gloss":"having spread"},{"text":"ஏ","lemma":"-ē","gloss":"emphasis"}],"gloss":"having spread"}]}],"literal":"While the protectors of the earth obey and follow your words, / desiring enjoyment and not tolerating any shared claim over the land, / driven by the zeal that says 'this space is too small', / with an unshrinking mind and unsparing generosity, / Cheralathan, who has an army that conquers and destroys! / How can you be compared to the sun of mighty course? / You limit yourself to a specific time, you turn your back and set, / you return in turns, and you hide behind the mountains, / and even though you are in the wide, vast sky, / you shine only during the day, spreading your many rays!","translation":"While other kings of the earth obey your words and follow you, you do not tolerate any shared claim over the land, desiring sole possession. Driven by the constant zeal that your territory is too small, with an unshrinking mind and unsparing generosity, you conquer and destroy with your army, O Cheralathan! How can the mighty-coursed sun ever be compared to you? For the sun is limited by time, turns its back and sets, returns only in turns, hides behind the mountains, and even though it dwells in the wide, vast sky, it shines only during the day by spreading its many rays!","modern":"உலகைக் காக்கும் பிற மன்னர்கள் உனது கட்டளைக்குக் கீழ்ப்படிந்து நடக்க, இந்த நிலப்பரப்பு பிறரோடு பகிர்ந்து கொள்ளத்தக்க பொதுவானது என்பதைப் பொறுக்காமல், முழுமையான ஆட்சியை விரும்பி, 'நம்முடைய நாடு மிகச் சிறியது' என்று கருதும் ஊக்கம் உன்னைத் தூண்டுகிறது. சுருங்காத நெஞ்சமும், எல்லையற்ற கொடைத்தன்மையும் கொண்டு, பகைவரை வென்று அழிக்கும் படையையுடைய சேரலாதனே! உன்னை இந்த வானத்துச் சூரியன் எவ்வாறு ஒப்பிட முடியும்? சூரியனோ பகல் பொழுதை மட்டும் எல்லையாகக் கொண்டு விளங்குகிறான்; மாலையில் தன் முதுகைக் காட்டி ஓடி மறைகிறான்; மீண்டும் மாறி வருகிறான்; மலைக்குப் பின்னால் ஒளிந்து கொள்கிறான்; அகன்ற பெரிய வானத்தில் இருந்தாலும், பகலில் மட்டுமே தன் பல கதிர்களை விரித்து விளங்குகிறான்.","explanation":"In this poem, the poet Kapilar praises the Chera king, Cheraman Selvak Kadungo Vazhiyathan (referred to as Cheralathan). The poem belongs to the pāṭāṇ tiṇai, specifically the iyaṉmoḻi tuṟai, which extols the king's natural virtues. Kapilar compares the king to the sun but concludes that the sun is far inferior to him. The king possesses an unshrinking mind, boundless ambition, and limitless generosity, and his glory shines constantly. In contrast, the sun is limited by time, retreats by turning its back (puṟakkoṭuttu) to set, hides behind mountains, and shines only during the day. Through these vivid contrasts, the poet elevates the king's heroic stature above the grandest cosmic entity.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.5],[0.5,0.8],[0.8,1.1],[1.1,1.6],[1.6,2.8],[2.8,3.16],[3.16,3.7],[3.7,4.2],[4.2,5.0],[5.0,5.3],[5.3,5.4],[5.4,5.8],[5.8,6.1],[6.1,7.0],[7.0,7.1],[7.1,7.5],[7.5,8.38],[8.38,9.3],[9.3,9.5],[9.5,9.9],[9.9,10.5],[10.5,10.5],[10.5,10.5],[10.5,12.4],[12.4,12.9],[12.9,14.03],[14.2,14.59],[14.59,14.67],[14.76,15.1],[15.1,16.6],[16.6,16.6],[16.6,17.8],[17.89,18.06],[18.88,19.48],[19.48,19.98],[19.98,20.18],[20.18,20.3],[20.3,21.28],[21.28,21.78],[21.78,21.88]],"female":[[0.0,0.7],[0.7,0.9],[0.9,1.2],[1.2,1.9],[1.9,3.3],[3.3,3.66],[3.66,4.18],[4.18,4.3],[4.3,5.7],[5.7,5.9],[5.9,6.1],[6.1,6.5],[6.5,6.8],[6.8,8.1],[8.1,8.1],[8.1,8.6],[8.6,9.5],[9.5,10.6],[10.6,11.0],[11.0,11.4],[11.4,12.2],[12.2,13.2],[13.27,13.7],[13.7,14.5],[14.5,15.0],[15.0,16.4],[16.4,17.0],[17.0,17.7],[17.7,18.1],[18.1,19.2],[19.2,19.2],[19.2,20.4],[20.4,20.6],[21.56,22.16],[22.16,22.66],[22.73,23.06],[23.06,24.11],[24.11,24.46],[24.46,25.06],[25.06,25.16]]}}