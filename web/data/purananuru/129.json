puḷimā","acai":[{"kind":"nirai","text":"பிழை","tr":"piḻai"},{"kind":"nēr","text":"யா","tr":"yā"}]},{"text":"துமன்னே","tr":"tumaṉṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"துமன்","tr":"tumaṉ"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"குறியிறை","parts":[{"text":"குறி","lemma":"kuṟi","gloss":"short"},{"text":"இறை","lemma":"iṟai","gloss":"eaves"}],"gloss":"short-eaved"},{"surface":"குரம்பை","parts":[{"text":"குரம்பை","lemma":"kurampai","gloss":"hut"}],"gloss":"hut"},{"surface":"குறவர்","parts":[{"text":"குறவர்","lemma":"kuṟavar","gloss":"hill-tribe people"}],"gloss":"hill-tribe people"},{"surface":"மாக்கள்","parts":[{"text":"மாக்கள்","lemma":"mākkaḷ","gloss":"people"}],"gloss":"people"}]},{"words":[{"surface":"வாங்கு","parts":[{"text":"வாங்கு","lemma":"vāṅku","gloss":"bent"}],"gloss":"bent"},{"surface":"அமை","parts":[{"text":"அமை","lemma":"amai","gloss":"bamboo"}],"gloss":"bamboo"},{"surface":"பழுனிய","parts":[{"text":"பழுனிய","lemma":"paḻuniya","gloss":"matured"}],"gloss":"matured"},{"surface":"தேறல்","parts":[{"text":"தேறல்","lemma":"tēṟal","gloss":"liquor"}],"gloss":"liquor"},{"surface":"மகிழ்ந்து","parts":[{"text":"மகிழ்ந்து","lemma":"makiḻntu","gloss":"having rejoiced"}],"gloss":"having rejoiced"}]},{"words":[{"surface":"வேங்கை","parts":[{"text":"வேங்கை","lemma":"vēṅkai","gloss":"Kino tree"}],"gloss":"Kino tree"},{"surface":"முன்றில்","parts":[{"text":"முன்றில்","lemma":"muṉṟil","gloss":"front yard"}],"gloss":"front yard"},{"surface":"குரவை","parts":[{"text":"குரவை","lemma":"kuravai","gloss":"Kuravai dance"}],"gloss":"Kuravai dance"},{"surface":"அயரும்","parts":[{"text":"அயரும்","lemma":"ayarum","gloss":"performing"}],"gloss":"performing"}]},{"words":[{"surface":"தீஞ்சுளை","parts":[{"text":"தீம்","lemma":"tīm","gloss":"sweet"},{"text":"சுளை","lemma":"cuḷai","gloss":"carpel"}],"gloss":"sweet carpel"},{"surface":"பலவின்","parts":[{"text":"பலவின்","lemma":"பலவின்","gloss":"of the jackfruit tree"}],"gloss":"of the jackfruit tree","split_unverified":true},{"surface":"மாமலை","parts":[{"text":"மா","lemma":"mā","gloss":"great"},{"text":"மலை","lemma":"malai","gloss":"mountain"}],"gloss":"great mountain"},{"surface":"கிழவன்","parts":[{"text":"கிழவன்","lemma":"kiḻavaṉ","gloss":"lord"}],"gloss":"lord"}]},{"words":[{"surface":"ஆஅய்","parts":[{"text":"ஆஅய்","lemma":"āay","gloss":"Ay"}],"gloss":"Ay"},{"surface":"அண்டிரன்","parts":[{"text":"அண்டிரன்","lemma":"aṇṭiraṉ","gloss":"Andiran"}],"gloss":"Andiran"},{"surface":"அடுபோர்","parts":[{"text":"அடு","lemma":"aṭu","gloss":"slaying"},{"text":"போர்","lemma":"pōr","gloss":"war"}],"gloss":"slaying war"},{"surface":"அண்ணல்","parts":[{"text":"அண்ணல்","lemma":"aṇṇal","gloss":"lord"}],"gloss":"lord"}]},{"words":[{"surface":"இரவலர்க்கு","parts":[{"text":"இரவலர்","lemma":"iravalar","gloss":"suppliants"},{"text":"க்கு","lemma":"kku","gloss":"to"}],"gloss":"to suppliants"},{"surface":"ஈத்த","parts":[{"text":"ஈத்த","lemma":"ītta","gloss":"given"}],"gloss":"given"},{"surface":"யானையின்","parts":[{"text":"யானை","lemma":"yāṉai","gloss":"elephant"},{"text":"இன்","lemma":"iṉ","gloss":"than"}],"gloss":"than the elephants"},{"surface":"கரவின்று","parts":[{"text":"கரவு","lemma":"karavu","gloss":"withholding"},{"text":"இன்று","lemma":"iṉṟu","gloss":"without"}],"gloss":"without withholding"}]},{"words":[{"surface":"வானம்","parts":[{"text":"வானம்","lemma":"vāṉam","gloss":"sky"}],"gloss":"sky"},{"surface":"மீன்பல","parts":[{"text":"மீன்","lemma":"mīṉ","gloss":"star"},{"text":"பல","lemma":"pala","gloss":"many"}],"gloss":"many stars"},{"surface":"பூப்பின்","parts":[{"text":"பூப்பு","lemma":"pūppu","gloss":"blossoming"},{"text":"இன்","lemma":"iṉ","gloss":"if"}],"gloss":"if blossomed"},{"surface":"ஆனாது","parts":[{"text":"ஆனாது","lemma":"āṉātu","gloss":"unceasingly"}],"gloss":"unceasingly"}]},{"words":[{"surface":"ஒருவழி","parts":[{"text":"ஒரு","lemma":"oru","gloss":"one"},{"text":"வழி","lemma":"vaḻi","gloss":"place"}],"gloss":"in one place"},{"surface":"கருவழி","parts":[{"text":"கரு","lemma":"karu","gloss":"dark"},{"text":"வழி","lemma":"vaḻi","gloss":"space"}],"gloss":"dark space"},{"surface":"இன்றி","parts":[{"text":"இன்றி","lemma":"iṉṟi","gloss":"without"}],"gloss":"without"}]},{"words":[{"surface":"பெருவெள்","parts":[{"text":"பெரு","lemma":"peru","gloss":"great"},{"text":"வெள்","lemma":"veḷ","gloss":"white"}],"gloss":"great white expanse"},{"surface":"என்னின்","parts":[{"text":"என்","lemma":"eṉ","gloss":"reckon"},{"text":"இன்","lemma":"iṉ","gloss":"if"}],"gloss":"if reckoned"},{"surface":"பிழையாது","parts":[{"text":"பிழையாது","lemma":"piḻaiyātu","gloss":"will not fail"}],"gloss":"will not fail"},{"surface":"மன்னே","parts":[{"text":"மன்","lemma":"maṉ","gloss":"indeed"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"indeed"}]}],"literal":"Short-eaved hut hill-tribe people / having rejoiced in liquor matured in bent bamboo / performing Kuravai dance in the front yard of Kino trees, / lord of the great mountain of sweet-carpeled jackfruit, / Ay Andiran, the lord of slaying war, / without withholding, than the elephants given to suppliants, / if the sky blossomed with many stars, unceasingly, / without even a single dark space anywhere, / if reckoned as a great white expanse, it will not fail indeed.","translation":"The hill-tribe people of short-eaved huts rejoice in the liquor matured in bent bamboo and dance the kuravai in the front yard of Kino trees. He is the lord of the great mountain of sweet-carpeled jackfruit, Ay Andiran, the chief of victorious war. If the sky blossomed with so many stars that not a single dark space remained anywhere, turning the heavens into a vast, solid white expanse, and if one were to count them, the number of elephants he has generously given to suppliants without withholding would still not fail to match or exceed that count.","modern":"குறுகிய கூரையுடைய குடில்களில் வாழும் குறவர் மக்கள், வளைந்த மூங்கிலில் முதிர்ந்த கள்ளைக் குடித்து மகிழ்ந்து, வேங்கை மரங்கள் நிறைந்த முற்றத்தில் குரவை நடனம் ஆடுவர். அத்தகைய இனிமையான சுளைகளைக் கொண்ட பலா மரங்கள் நிறைந்த பெரிய மலைக்குத் தலைவனும், கொல்லும் போரைச் செய்யும் அண்ணலுமாகிய ஆய் அண்டிரன், இரவலர்களுக்கு வஞ்சனையின்றி வழங்கிய யானைகளின் எண்ணிக்கை மிக அதிகம். வானத்தில் உள்ள விண்மீன்கள் அனைத்தும் இடைவெளியின்றிப் பூத்து, கருமையான இடமே இல்லாமல் வானம் முழுவதும் ஒரு பெரிய வெண்மையான பரப்பாக மாறினாலும், அந்த விண்மீன்களின் எண்ணிக்கையை விட ஆய் அண்டிரன் கொடையாகக் கொடுத்த யானைகளின் எண்ணிக்கை குறையாது; அதுவே உண்மை.","explanation":"In this poem, the poet Uṟaiyūr Ēṇiccēri Muṭamōciyār praises the boundless generosity of the chieftain Āy Aṇṭiraṉ. He begins by describing Ay's fertile mountain country, where the hill-tribe people live happily, drinking bamboo-fermented liquor and dancing the kuravai under Kino trees. The poet then compares the immense number of elephants Ay has gifted to suppliants with the stars in the night sky. He states that even if the sky were so densely packed with stars that not a single dark space remained, turning the heavens into a solid white expanse, the count of Ay's gifted elephants would still not fail to match or exceed that number. This hyperbolic comparison beautifully highlights the chieftain's legendary and unstinting patronage.","model":"gemini-3.5-flash"}}