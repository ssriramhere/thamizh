{"text":"purananuru","n":129,"lines":["குறியிறைக் குரம்பைக் குறவர் மாக்கள்","வாங்குஅமைப் பழுனிய தேறல் மகிழ்ந்து","வேங்கை முன்றில் குரவை அயரும்","தீஞ்சுளைப் பலவின் மாமலைக் கிழவன்","ஆஅய் அண்டிரன் அடுபோர் அண்ணல்","இரவலர்க்கு ஈத்த யானையின் கரவின்று","வானம் மீன்பல பூப்பின் ஆனாது","ஒருவழிக் கருவழி யின்றிப்","பெருவெள் ளென்னிற் பிழையாது மன்னே"],"tr":["kuṟiyiṟaik kurampaik kuṟavar mākkaḷ","vāṅkuamaip paḻuṉiya tēṟal makiḻntu","vēṅkai muṉṟil kuravai ayarum","tīñcuḷaip palaviṉ māmalaik kiḻavaṉ","āay aṇṭiraṉ aṭupōr aṇṇal","iravalarkku ītta yāṉaiyiṉ karaviṉṟu","vāṉam mīṉpala pūppiṉ āṉātu","oruvaḻik karuvaḻi yiṉṟip","peruveḷ ḷeṉṉiṟ piḻaiyātu maṉṉē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"இயன் மொழி","poet_ta":"உறையூர் ஏணிச்சேரி முடமோசியார்","addressed_ta":"ஆய் அண்டிரன்","poet_tr":"Uṟaiyūr Ēṇiccēri Muṭamōciyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"9×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 35, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 19, veṇṭaḷai 16"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"குறியிறைக்","tr":"kuṟiyiṟaik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குறி","tr":"kuṟi"},{"kind":"nirai","text":"யிறைக்","tr":"yiṟaik"}]},{"text":"குரம்பைக்","tr":"kurampaik","foot":"puḷimā","acai":[{"kind":"nirai","text":"குரம்","tr":"kuram"},{"kind":"nēr","text":"பைக்","tr":"paik"}]},{"text":"குறவர்","tr":"kuṟavar","foot":"puḷimā","acai":[{"kind":"nirai","text":"குற","tr":"kuṟa"},{"kind":"nēr","text":"வர்","tr":"var"}]},{"text":"மாக்கள்","tr":"mākkaḷ","foot":"tēmā","acai":[{"kind":"nēr","text":"மாக்","tr":"māk"},{"kind":"nēr","text":"கள்","tr":"kaḷ"}]}],[{"text":"வாங்கமைப்","tr":"vāṅkamaip","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வாங்","tr":"vāṅ"},{"kind":"nirai","text":"கமைப்","tr":"kamaip"}]},{"text":"பழுனிய","tr":"paḻuṉiya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பழு","tr":"paḻu"},{"kind":"nirai","text":"னிய","tr":"ṉiya"}]},{"text":"தேறல்","tr":"tēṟal","foot":"tēmā","acai":[{"kind":"nēr","text":"தே","tr":"tē"},{"kind":"nēr","text":"றல்","tr":"ṟal"}]},{"text":"மகிழ்ந்து","tr":"makiḻntu","foot":"puḷimā","acai":[{"kind":"nirai","text":"மகிழ்ந்","tr":"makiḻn"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"வேங்கை","tr":"vēṅkai","foot":"tēmā","acai":[{"kind":"nēr","text":"வேங்","tr":"vēṅ"},{"kind":"nēr","text":"கை","tr":"kai"}]},{"text":"முன்றில்","tr":"muṉṟil","foot":"tēmā","acai":[{"kind":"nēr","text":"முன்","tr":"muṉ"},{"kind":"nēr","text":"றில்","tr":"ṟil"}]},{"text":"குரவை","tr":"kuravai","foot":"puḷimā","acai":[{"kind":"nirai","text":"குர","tr":"kura"},{"kind":"nēr","text":"வை","tr":"vai"}]},{"text":"யயரும்","tr":"yayarum","foot":"puḷimā","acai":[{"kind":"nirai","text":"யய","tr":"yaya"},{"kind":"nēr","text":"ரும்","tr":"rum"}]}],[{"text":"தீஞ்சுளைப்","tr":"tīñcuḷaip","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தீஞ்","tr":"tīñ"},{"kind":"nirai","text":"சுளைப்","tr":"cuḷaip"}]},{"text":"பலவின்","tr":"palaviṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பல","tr":"pala"},{"kind":"nēr","text":"வின்","tr":"viṉ"}]},{"text":"மாமலைக்","tr":"māmalaik","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"மலைக்","tr":"malaik"}]},{"text":"கிழவ","tr":"kiḻava","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிழ","tr":"kiḻa"},{"kind":"nēr","text":"வ","tr":"va"}]}],[{"text":"னாஅ","tr":"ṉāa","foot":"tēmā","acai":[{"kind":"nēr","text":"னா","tr":"ṉā"},{"kind":"nēr","text":"அ","tr":"a"}]},{"text":"யண்டிர","tr":"yaṇṭira","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யண்","tr":"yaṇ"},{"kind":"nirai","text":"டிர","tr":"ṭira"}]},{"text":"னடுபோ","tr":"ṉaṭupō","foot":"puḷimā","acai":[{"kind":"nirai","text":"னடு","tr":"ṉaṭu"},{"kind":"nēr","text":"போ","tr":"pō"}]},{"text":"ரண்ண","tr":"raṇṇa","foot":"tēmā","acai":[{"kind":"nēr","text":"ரண்","tr":"raṇ"},{"kind":"nēr","text":"ண","tr":"ṇa"}]}],[{"