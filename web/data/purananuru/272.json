{"text":"purananuru","n":272,"lines":["மணிதுணர்ந் தன்ன மாக்குரல் நொச்சி","போதுவிரி பன்மர னுள்ளும் சிறந்த","காதல் நன்மரம் நீ நிழற் றிசினே","கடியுடை வியன்நகர்க் காண்வரப் பொலிந்த","தொடியுடை மகளிர் அல்குலும் கிடத்தி","காப்புடைப் புரிசை புக்குமாறு அழித்தலின்","ஊர்ப்புறம் கொடாஅ நெடுந்தகை","பீடுகெழு சென்னிக் கிழமையும் நினதே"],"tr":["maṇituṇarn taṉṉa mākkural nocci","pōtuviri paṉmara ṉuḷḷum ciṟanta","kātal naṉmaram nī niḻaṟ ṟiciṉē","kaṭiyuṭai viyaṉnakark kāṇvarap polinta","toṭiyuṭai makaḷir alkulum kiṭatti","kāppuṭaip puricai pukkumāṟu aḻittaliṉ","ūrppuṟam koṭāa neṭuntakai","pīṭukeḻu ceṉṉik kiḻamaiyum niṉatē"],"colophon":{"tinai":"nocci","tinai_ta":"நொட்சி","turai_ta":"செருவிடை வீழ்தல்","poet_ta":"மோசிசாத்தனார்","poet_tr":"Mōcicāttaṉār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"8×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 31, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 12, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மணிதுணர்ந்","tr":"maṇituṇarn","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மணி","tr":"maṇi"},{"kind":"nirai","text":"துணர்ந்","tr":"tuṇarn"}]},{"text":"தன்ன","tr":"taṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"தன்","tr":"taṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"மாக்குரல்","tr":"mākkural","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மாக்","tr":"māk"},{"kind":"nirai","text":"குரல்","tr":"kural"}]},{"text":"நொச்சி","tr":"nocci","foot":"tēmā","acai":[{"kind":"nēr","text":"நொச்","tr":"noc"},{"kind":"nēr","text":"சி","tr":"ci"}]}],[{"text":"போதுவி","tr":"pōtuvi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"போ","tr":"pō"},{"kind":"nirai","text":"துவி","tr":"tuvi"}]},{"text":"ரிபன்மர","tr":"ripaṉmara","foot":"karuviḷam","acai":[{"kind":"nirai","text":"ரிபன்","tr":"ripaṉ"},{"kind":"nirai","text":"மர","tr":"mara"}]},{"text":"னுள்ளும்","tr