oss":"dark"},{"text":"குரல்","lemma":"kural","gloss":"flower-bud cluster"}],"gloss":"dark flower-bud clusters"},{"surface":"நொச்சி","parts":[{"text":"நொச்சி","lemma":"nocci","gloss":"Nocci tree"}],"gloss":"Nocci tree"}]},{"words":[{"surface":"போதுவிரி","parts":[{"text":"போது","lemma":"pōtu","gloss":"flower bud"},{"text":"விரி","lemma":"viri","gloss":"expanding"}],"gloss":"expanding flower buds"},{"surface":"பன்மரனுள்ளும்","parts":[{"text":"பன்மரனுள்ளும்","lemma":"பன்மரனுள்ளும்","gloss":"even among many trees"}],"gloss":"even among many trees","split_unverified":true},{"surface":"சிறந்த","parts":[{"text":"சிறந்த","lemma":"சிறந்த","gloss":"distinguished"}],"gloss":"distinguished","split_unverified":true}]},{"words":[{"surface":"காதல்","parts":[{"text":"காதல்","lemma":"kātal","gloss":"beloved"}],"gloss":"beloved"},{"surface":"நன்மரம்","parts":[{"text":"நன்மரம்","lemma":"நன்மரம்","gloss":"good tree"}],"gloss":"good tree","split_unverified":true},{"surface":"நீ","parts":[{"text":"நீ","lemma":"nī","gloss":"you"}],"gloss":"you"},{"surface":"நிழற்றிசினே","parts":[{"text":"நிழற்றிசினே","lemma":"நிழற்றிசினே","gloss":"you cast shade indeed"}],"gloss":"you cast shade indeed","split_unverified":true}]},{"words":[{"surface":"கடியுடை","parts":[{"text":"கடி","lemma":"kaṭi","gloss":"protection"},{"text":"உடை","lemma":"uṭai","gloss":"possessing"}],"gloss":"possessing protection"},{"surface":"வியன்","parts":[{"text":"வியன்","lemma":"viyaṉ","gloss":"wide"}],"gloss":"wide"},{"surface":"நகர்","parts":[{"text":"நகர்","lemma":"nakar","gloss":"mansion"}],"gloss":"mansion"},{"surface":"காண்வர","parts":[{"text":"காண்","lemma":"kāṇ","gloss":"to see"},{"text":"வர","lemma":"vara","gloss":"beautifully"}],"gloss":"beautifully to see"},{"surface":"பொலிந்த","parts":[{"text":"பொலிந்த","lemma":"பொலிந்த","gloss":"shining"}],"gloss":"shining","split_unverified":true}]},{"words":[{"surface":"தொடியுடை","parts":[{"text":"தொடி","lemma":"toṭi","gloss":"bangle"},{"text":"உடை","lemma":"uṭai","gloss":"possessing"}],"gloss":"possessing bangles"},{"surface":"மகளிர்","parts":[{"text":"மகளிர்","lemma":"makaḷir","gloss":"women"}],"gloss":"women"},{"surface":"அல்குலும்","parts":[{"text":"அல்குல்","lemma":"alkul","gloss":"waist"},{"text":"உம்","lemma":"um","gloss":"also"}],"gloss":"and the waists"},{"surface":"கிடத்தி","parts":[{"text":"கிட","lemma":"kiṭa","gloss":"to lie down"},{"text":"த்","lemma":"t","gloss":"transition marker"},{"text":"தி","lemma":"ti","gloss":"second person singular suffix"}],"gloss":"you lie upon"}]},{"words":[{"surface":"காப்புடை","parts":[{"text":"காப்பு","lemma":"kāppu","gloss":"guard"},{"text":"உடை","lemma":"uṭai","gloss":"possessing"}],"gloss":"possessing guard"},{"surface":"புரிசை","parts":[{"text":"புரிசை","lemma":"puricai","gloss":"fortress wall"}],"gloss":"fortress wall"},{"surface":"புக்குமாறு","parts":[{"text":"புக்குமாறு","lemma":"புக்குமாறு","gloss":"the way of entering"}],"gloss":"the way of entering","split_unverified":true},{"surface":"அழித்தலின்","parts":[{"text":"அழித்தல்","lemma":"aḻittal","gloss":"destroying"},{"text":"இன்","lemma":"iṉ","gloss":"because of"}],"gloss":"because of destroying"}]},{"words":[{"surface":"ஊர்ப்புறம்","parts":[{"text":"ஊர்","lemma":"ūr","gloss":"town"},{"text":"புறம்","lemma":"puṟam","gloss":"back"}],"gloss":"the back of the town"},{"surface":"கொடாஅ","parts":[{"text":"கொடா","lemma":"koṭā","gloss":"not giving"},{"text":"அ","lemma":"a","gloss":"alapeṭai"}],"gloss":"not giving"},{"surface":"நெடுந்தகை","parts":[{"text":"நெடும்","lemma":"neṭum","gloss":"great"},{"text":"தகை","lemma":"takai","gloss":"noble hero"}],"gloss":"great noble hero"}]},{"words":[{"surface":"பீடுகெழு","parts":[{"text":"பீடு","lemma":"pīṭu","gloss":"glory"},{"text":"கெழு","lemma":"keḻu","gloss":"possessing"}],"gloss":"possessing glory"},{"surface":"சென்னி","parts":[{"text":"சென்னி","lemma":"ceṉṉi","gloss":"head"}],"gloss":"head"},{"surface":"கிழமையும்","parts":[{"text":"கிழமை","lemma":"kiḻamai","gloss":"ownership"},{"text":"உம்","lemma":"um","gloss":"also"}],"gloss":"and the ownership"},{"surface":"நினதே","parts":[{"text":"நினது","lemma":"niṉatu","gloss":"yours"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"is yours indeed"}]}],"literal":"Like sapphire clusters, dark flower-bud clusters of Nocci, / among many trees with expanding buds, distinguished, / beloved good tree, you cast shade indeed! / In the protected wide mansion, beautifully to see, shining, / on the bangled women's waists also you lie, / because of destroying the way of entering the guarded fortress wall, / not giving the back of the town, the great noble hero's / glorious head's ownership is also yours.","translation":"O Nocci tree, with dark flower clusters like bunches of sapphires! Among all the many trees that bloom with expanding buds, you are the most distinguished and beloved good tree. You cast your cool shade here. You once lay upon the beautiful waists of the bangled women in their protected, spacious mansions. And now, because the great noble hero destroyed the enemy's attempt to breach the guarded fortress wall and refused to retreat, the ownership of his glorious head, adorned with your leaves, is yours indeed.","modern":"நீலமணி போன்ற கொத்துக்களை உடைய கரிய பூங்கொத்துக்களைக் கொண்ட நொச்சி மரமே! மலரும் மொட்டுகளைக் கொண்ட பல மரங்களுக்குள்ளும் சிறந்த அன்பிற்குரிய நல்ல மரமாகிய நீ நிழல் தருகிறாய். காவல் பொருந்திய அகன்ற மாளிகையில் காண்பதற்கு அழகாக விளங்கும் வளையல் அணிந்த பெண்களின் அல்குல் மீதும் நீ கிடக்கிறாய். காவல் உடைய மதிலுக்குள் பகைவர் புகாதவாறு தடுத்து அழித்ததால், தன் ஊரின் புறமுதுகைக் காட்டாத பெருந்தகையினது பெருமை பொருந்திய தலையைச் சூடும் உரிமையும் உனக்குரியதே ஆகும்.","explanation":"This poem belongs to the Nocci tiṇai, which represents the defense of a fortress, and the theme is falling in battle. The poet Mōcicāttaṉār addresses the Nocci (chaste tree) whose leaves are traditionally worn by soldiers defending a fort. The poet praises the tree's beauty, comparing its dark flower clusters to sapphires, and notes its dual role in peace and war. In times of peace, its leaves and flowers adorn the waists of beautiful women in the palace. In times of war, they are worn as a chaplet by the brave hero who defends the fort. Since the hero died defending the fort without retreating, his glorious head now belongs to the Nocci tree.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.8],[0.8,1.1],[1.28,1.7],[1.7,2.0],[2.0,2.8],[2.8,3.0],[3.0,3.6],[3.6,3.7],[3.7,5.1],[5.1,5.3],[5.3,5.6],[5.6,5.99],[6.11,6.5],[6.5,7.5],[7.5,8.1],[8.1,8.4],[8.55,9.0],[9.33,10.0],[10.0,10.4],[10.4,10.6],[10.6,10.9],[10.9,12.37],[12.37,12.7],[12.7,13.2],[13.2,13.9],[13.9,15.0],[15.0,15.0],[15.0,15.8],[15.8,16.7],[16.7,16.9],[16.9,17.2],[17.2,17.7]],"female":[[0.0,0.7],[0.7,1.26],[1.4,1.8],[1.8,2.3],[2.3,3.22],[3.22,3.33],[3.44,3.6],[3.6,4.7],[4.7,5.8],[5.8,6.0],[6.0,6.4],[6.4,7.1],[7.17,7.43],[7.5,8.7],[8.7,9.4],[9.4,9.7],[9.7,10.3],[10.3,11.2],[11.2,12.1],[12.1,12.3],[12.3,12.7],[12.7,13.84],[13.84,14.6],[14.6,15.0],[15.0,15.8],[15.8,15.8],[15.8,15.8],[15.8,17.9],[17.9,18.8],[18.8,19.1],[19.1,19.5],[19.5,20.0]]}}