{"text":"purananuru","n":329,"lines":["இல்லடு கள்ளின் சில்குடிச் சீறூர்ப்","புடைநடு கல்லின் நாட்பலி யூட்டி","நன்னீர் ஆட்டி நெய்ந்நறைக் கொளீஇய","மங்குல் மாப்புகை மறுகுடன் கமழும்","அருமுனை இருக்கைத்து ஆயினும் வரிமிடற்று","அரவுஉறை புற்றத்து அற்றே நாளும்","புரவலர் புன்கண் நோக்காது இரவலர்க்கு","அருகாது ஈயும் வண்மை","உரைசால் நெடுந்தகை ஓம்பும் ஊரே"],"tr":["illaṭu kaḷḷiṉ cilkuṭic cīṟūrp","puṭainaṭu kalliṉ nāṭpali yūṭṭi","naṉṉīr āṭṭi neynnaṟaik koḷīiya","maṅkul māppukai maṟukuṭaṉ kamaḻum","arumuṉai irukkaittu āyiṉum varimiṭaṟṟu","aravuuṟai puṟṟattu aṟṟē nāḷum","puravalar puṉkaṇ nōkkātu iravalarkku","arukātu īyum vaṇmai","uraicāl neṭuntakai ōmpum ūrē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"மூதின் முல்லை","poet_ta":"மதுரை அறுவை வாணிகன் இளவேட்டனார்","poet_tr":"Maturai Aṟuvai Vāṇikaṉ Iḷavēṭṭaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"8×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 34, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 20, veṇṭaḷai 14"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இல்லடு","tr":"illaṭu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"இல்","tr":"il"},{"kind":"nirai","text":"லடு","tr":"laṭu"}]},{"text":"கள்ளின்","tr":"kaḷḷiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"கள்","tr":"kaḷ"},{"kind":"nēr","text":"ளின்","tr":"ḷiṉ"}]},{"text":"சில்குடிச்","tr":"cilkuṭic","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சில்","tr":"cil"},{"kind":"nirai","text":"குடிச்","tr":"kuṭic"}]},{"text":"சீறூர்ப்","tr":"cīṟūrp","foot":"tēmā","acai":[{"kind":"nēr","text":"சீ","tr":"cī"},{"kind":"nēr","text":"றூர்ப்","tr":"ṟūrp"}]}],[{"text":"புடைநடு","tr":"puṭainaṭu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"புடை","tr":"puṭai"},{"kind":"nirai","text":"நடு","tr":"naṭu"}]},{"text":"கல்லின்","tr":"kalliṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"கல்","tr":"kal"},{"kind":"