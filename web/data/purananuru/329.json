having caused to hold"}],"gloss":"having kindled"}]},{"words":[{"surface":"மங்குல்","parts":[{"text":"மங்குல்","lemma":"maṅkul","gloss":"cloud"}],"gloss":"cloud"},{"surface":"மாப்புகை","parts":[{"text":"மா","lemma":"mā","gloss":"dark"},{"text":"புகை","lemma":"pukai","gloss":"smoke"}],"gloss":"dark smoke"},{"surface":"மறுகுடன்","parts":[{"text":"மறுகு","lemma":"maṟuku","gloss":"street"},{"text":"உடன்","lemma":"uṭaṉ","gloss":"with"}],"gloss":"along with the street"},{"surface":"கமழும்","parts":[{"text":"கமழ்","lemma":"kamaḻ","gloss":"be fragrant"},{"text":"உம்","lemma":"um","gloss":"will"}],"gloss":"spreads fragrance"}]},{"words":[{"surface":"அருமுனை","parts":[{"text":"அரு","lemma":"aru","gloss":"difficult"},{"text":"முனை","lemma":"muṉai","gloss":"frontier"}],"gloss":"difficult frontier"},{"surface":"இருக்கைத்து","parts":[{"text":"இருக்கை","lemma":"irukkai","gloss":"settlement"},{"text":"து","lemma":"tu","gloss":"it is of that nature"}],"gloss":"having the nature of a settlement"},{"surface":"ஆயினும்","parts":[{"text":"ஆயின்","lemma":"āyiṉ","gloss":"if it is"},{"text":"உம்","lemma":"um","gloss":"even"}],"gloss":"even though it is"},{"surface":"வரிமிடற்று","parts":[{"text":"வரிமிடற்று","lemma":"வரிமிடற்று","gloss":"of the striped throat"}],"gloss":"of the striped throat","split_unverified":true}]},{"words":[{"surface":"அரவு","parts":[{"text":"அரவு","lemma":"aravu","gloss":"snake"}],"gloss":"snake"},{"surface":"உறை","parts":[{"text":"உறை","lemma":"uṟai","gloss":"dwelling"}],"gloss":"dwelling"},{"surface":"புற்றத்து","parts":[{"text":"புற்று","lemma":"puṟṟu","gloss":"anthill"},{"text":"அத்து","lemma":"attu","gloss":"oblique suffix"}],"gloss":"of the anthill"},{"surface":"அற்றே","parts":[{"text":"அற்று","lemma":"aṟṟu","gloss":"like that"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"it is like that indeed"},{"surface":"நாளும்","parts":[{"text":"நாள்","lemma":"nāḷ","gloss":"day"},{"text":"உம்","lemma":"um","gloss":"every"}],"gloss":"every day"}]},{"words":[{"surface":"புரவலர்","parts":[{"text":"புரவலர்","lemma":"puravalar","gloss":"patrons"}],"gloss":"patrons"},{"surface":"புன்கண்","parts":[{"text":"புன்","lemma":"puṉ","gloss":"distressed"},{"text":"கண்","lemma":"kaṇ","gloss":"state"}],"gloss":"distress"},{"surface":"நோக்காது","parts":[{"text":"நோக்கு","lemma":"nōkku","gloss":"look"},{"text":"ஆது","lemma":"ātu","gloss":"without"}],"gloss":"without looking at"},{"surface":"இரவலர்க்கு","parts":[{"text":"இரவலர்","lemma":"iravalar","gloss":"suppliants"},{"text":"கு","lemma":"ku","gloss":"to"}],"gloss":"to the suppliants"}]},{"words":[{"surface":"அருகாது","parts":[{"text":"அருகு","lemma":"aruku","gloss":"diminish"},{"text":"ஆது","lemma":"ātu","gloss":"without"}],"gloss":"without diminishing"},{"surface":"ஈயும்","parts":[{"text":"ஈ","lemma":"ī","gloss":"give"},{"text":"உம்","lemma":"um","gloss":"that gives"}],"gloss":"giving"},{"surface":"வண்மை","parts":[{"text":"வண்மை","lemma":"vaṇmai","gloss":"generosity"}],"gloss":"generosity"}]},{"words":[{"surface":"உரைசால்","parts":[{"text":"உரை","lemma":"urai","gloss":"praise"},{"text":"சால்","lemma":"sāl","gloss":"abundant"}],"gloss":"praise-worthy"},{"surface":"நெடுந்தகை","parts":[{"text":"நெடுந்தகை","lemma":"நெடுந்தகை","gloss":"great noble hero"}],"gloss":"great noble hero","split_unverified":true},{"surface":"ஓம்பும்","parts":[{"text":"ஓம்பு","lemma":"ōmpu","gloss":"protect"},{"text":"உம்","lemma":"um","gloss":"who protects"}],"gloss":"protecting"},{"surface":"ஊரே","parts":[{"text":"ஊர்","lemma":"ūr","gloss":"village"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"the village indeed"}]}],"literal":"In the small village of few households with house-brewed toddy, / having offered the morning sacrifice to the hero-stone planted on the side, / having bathed it with good water and kindled ghee-perfumed incense, / the dark smoke like a cloud spreads fragrant along with the street. / Even though it is a settlement on a difficult frontier, like an anthill where a striped-necked / snake dwells, it is indeed so. Every day, / without looking at the distress of other patrons, to the suppliants, / without diminishing, giving generosity, / the praise-worthy great hero protects this village!","translation":"In this small village of a few households where toddy is brewed at home, they bathe the hero-stone planted on the outskirts with pure water, offer the morning sacrifice, and burn fragrant incense with ghee. The dark smoke, like a cloud, spreads its fragrance throughout the street. Although it is a settlement on a dangerous frontier, it is like an anthill inhabited by a striped-necked cobra. Here, every day, without seeking help from other patrons, the famous and noble chief protects his village, giving generously to suppliants without ever holding back.","modern":"வீடுகளில் கள் காய்ச்சும் சில குடும்பங்களே வாழும் இந்தச் சிறிய ஊரின் எல்லையில் நடப்பட்டுள்ள நடுகல்லுக்கு, தூய நீரால் நீராட்டி, காலையிலேயே பலி கொடுத்து, நெய் கலந்த நறுமணப் புகையை ஏற்றி வழிபடுகின்றனர். மேகம் போன்ற அந்த அடர்ந்த நறுமணப் புகை தெரு முழுவதும் கமழ்கிறது. இது ஆபத்தான எல்லையில் உள்ள ஊராக இருந்தாலும், நஞ்சுடைய வரிப் பிடரிப் பாம்பு வாழும் புற்று போன்ற வலிமை உடையது. பிற வள்ளல்களின் உதவியை நாடாமல், இரப்பவர்க்கு எப்போதும் குறையாமல் வாரி வழங்கும் கொடைத்தன்மை கொண்ட, புகழ்பெற்ற பெருந்தகை காக்கும் ஊர் இதுவாகும்.","explanation":"This poem belongs to the Vākai tiṇai and the theme of Mūtiṉ mullai, which praises the ancient martial lineage and valor of a warrior's home. The poet describes a small, fierce frontier village protected by a noble chieftain. The villagers worship their fallen heroes by bathing the hero-stones (naṭukal) and burning rich incense, creating a fragrant smoke that fills the streets. The poet compares the dangerous, heavily guarded village to an anthill inhabited by a deadly, striped-necked cobra, warning enemies to stay away. Despite its small size and constant state of war, the chieftain is incredibly generous, giving freely to all suppliants without needing to rely on wealthier patrons.","model":"gemini-3.5-flash"},"timing":{"male":[[0.4,0.7],[0.7,1.0],[1.0,1.5],[1.5,2.05],[2.05,2.81],[2.81,3.3],[3.3,3.74],[3.8,4.1],[4.1,5.1],[5.1,5.4],[5.4,6.1],[6.4,6.5],[6.5,7.1],[7.1,7.1],[7.1,7.7],[7.7,7.7],[7.7,9.2],[9.88,10.3],[10.3,10.9],[10.9,11.6],[11.6,12.7],[12.7,13.1],[13.1,13.4],[13.4,14.0],[14.0,14.9],[14.9,15.2],[15.2,15.8],[15.8,16.0],[16.0,17.3],[17.3,18.0],[18.0,18.1],[19.08,19.68],[19.68,19.78],[19.78,20.28],[20.28,20.78]],"female":[[0.0,0.58],[0.7,1.2],[1.2,1.8],[1.8,2.4],[2.4,3.18],[3.18,3.6],[3.6,4.13],[4.26,4.5],[4.5,5.18],[5.21,5.32],[6.45,6.8],[6.8,6.8],[6.8,6.8],[6.8,6.8],[6.8,7.86],[7.86,8.7],[8.7,9.4],[9.4,9.75],[9.75,9.75],[9.75,10.1],[10.1,13.2],[13.2,13.8],[13.8,14.2],[14.2,14.8],[14.8,15.9],[15.9,16.1],[16.1,16.7],[16.7,17.0],[17.0,18.5],[18.5,19.2],[19.2,19.3],[20.36,21.06],[21.06,21.26],[21.26,21.86],[21.86,22.46]]},"sync":[[["இல்","house"],["அடு","brewed"]],[["கள்ளின்","of toddy"]],[["சில்குடி","few households"],["சீறூர்","small village"]],[["சீறூர்","small village"]],[["புடை","side"],["நடு","planted"]],[["கல்லின்","to the stone"]],[["நாட்பலி","morning offering"]],[["ஊட்டி","having offered"]],[["நன்னீர்","good water"]],[["ஆட்டி","having bathed"]],[["நெய்ந்நறை","ghee-perfumed incense"],["கொளீஇய","having kindled"]],[["கொளீஇய","having kindled"]],[["மங்குல்","cloud"]],[["மாப்புகை","dark smoke"]],[["மறுகுடன்","along with the street"]],[["கமழும்","spreads fragrance"]],[["அருமுனை","difficult frontier"]],[["இருக்கைத்து","having the nature of a settlement"]],[["ஆயினும்","even though it is"]],[["வரிமிடற்று","of the striped throat"]],[["அரவு","snake"],["உறை","dwelling"]],[["புற்றத்து","of the anthill"]],[["அற்றே","it is like that indeed"]],[["நாளும்","every day"]],[["புரவலர்","patrons"]],[["புன்கண்","distress"]],[["நோக்காது","without looking at"]],[["இரவலர்க்கு","to the suppliants"]],[["அருகாது","without diminishing"]],[["ஈயும்","giving"]],[["வண்மை","generosity"]],[["உரைசால்","praise-worthy"]],[["நெடுந்தகை","great noble hero"]],[["ஓம்பும்","protecting"]],[["ஊரே","the village indeed"]]]}