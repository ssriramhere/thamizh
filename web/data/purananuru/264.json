plit_unverified":true},{"surface":"கண்ணியடு","parts":[{"text":"கண்ணியடு","lemma":"கண்ணியடு","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"அணி","parts":[{"text":"அணி","lemma":"அணி","gloss":"beautiful"}],"gloss":"beautiful"},{"surface":"மயில்","parts":[{"text":"மயில்","lemma":"மயில்","gloss":"peacock"}],"gloss":"peacock"},{"surface":"பீலி","parts":[{"text":"பீலி","lemma":"பீலி","gloss":"feather"}],"gloss":"feather"},{"surface":"சூட்டி","parts":[{"text":"சூட்டி","lemma":"சூட்டுதல்","gloss":"having adorned"}],"gloss":"having adorned"},{"surface":"பெயர்பொறித்து","parts":[{"text":"பெயர்","lemma":"பெயர்","gloss":"name"},{"text":"பொறித்து","lemma":"பொறித்தல்","gloss":"having engraved"}],"gloss":"having engraved the name"}]},{"words":[{"surface":"இனி","parts":[{"text":"இனி","lemma":"இனி","gloss":"now"}],"gloss":"now"},{"surface":"நட்டனரே","parts":[{"text":"நட்டனர்","lemma":"நடு","gloss":"they planted"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"they indeed planted"},{"surface":"கல்லும்","parts":[{"text":"கல்","lemma":"கல்","gloss":"stone"},{"text":"உம்","lemma":"உம்","gloss":"also"}],"gloss":"the stone also"},{"surface":"கன்றொடு","parts":[{"text":"கன்று","lemma":"கன்று","gloss":"calf"},{"text":"ஒடு","lemma":"ஒடு","gloss":"with"}],"gloss":"with the calf"}]},{"words":[{"surface":"கறவை","parts":[{"text":"கறவை","lemma":"கறவை","gloss":"milch cow"}],"gloss":"milch cows"},{"surface":"தந்து","parts":[{"text":"தந்து","lemma":"தா","gloss":"having brought back"}],"gloss":"having brought back"},{"surface":"பகைவர்","parts":[{"text":"பகைவர்","lemma":"பகைவர்","gloss":"enemies"}],"gloss":"enemies"},{"surface":"ஓட்டிய","parts":[{"text":"ஓட்டிய","lemma":"ஓட்டுதல்","gloss":"who drove away"}],"gloss":"who drove away"}]},{"words":[{"surface":"நெடுந்தகை","parts":[{"text":"நெடும்","lemma":"நெடுமை","gloss":"great"},{"text":"தகை","lemma":"தகைமை","gloss":"hero"}],"gloss":"noble hero"},{"surface":"கழிந்தமை","parts":[{"text":"கழிந்த","lemma":"கழிதல்","gloss":"passed away"},{"text":"மை","lemma":"மை","gloss":"nominalizing suffix"}],"gloss":"the passing away"},{"surface":"அறியாது","parts":[{"text":"அறியாது","lemma":"அறிதல்","gloss":"not knowing"}],"gloss":"not knowing"}]},{"words":[{"surface":"இன்றும்","parts":[{"text":"இன்று","lemma":"இன்று","gloss":"today"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"even today"},{"surface":"வருங்கொல்","parts":[{"text":"வரும்","lemma":"வருதல்","gloss":"will come"},{"text":"கொல்","lemma":"கொல்","gloss":"particle of doubt"}],"gloss":"will they come?"},{"surface":"பாணரது","parts":[{"text":"பாணர்","lemma":"பாணர்","gloss":"bards"},{"text":"அது","lemma":"அது","gloss":"genitive suffix"}],"gloss":"of the bards"},{"surface":"கடும்பே","parts":[{"text":"கடும்பு","lemma":"கடும்பு","gloss":"kin"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"the group indeed"}]}],"literal":"Having raised a stone heap on the pebbly side, / having adorned it with a chaplet of red flowers strung with split bowstring hemp, / having adorned it with beautiful peacock feathers and engraved his name, / now they indeed planted the stone. / Having brought back the milch cows with their calves and driven away the enemies, / not knowing that the noble hero has passed away, / will the group of bards come even today?","translation":"On the pebbly slope, they raised a mound of stones. They adorned it with a chaplet of red flowers strung on split bowstring hemp, decorated it with beautiful peacock feathers, engraved his name, and have now planted this hero-stone. Unaware that the noble hero—who rescued the milch cows along with their calves and drove away the enemies—has passed away, will the troupe of bards still come today seeking his patronage?","modern":"பருக்கைக் கற்கள் நிறைந்த பக்கத்தில் ஒரு கல் குவியலை எழுப்பி, பிளந்த மரல் நாரால் தொடுக்கப்பட்ட சிவந்த பூக்களாலான மாலையைச் சூட்டி, அழகான மயில்தோகையை அணிவித்து, அவனது பெயரைப் பொறித்து, இப்போது நடுகல்லை நட்டுவிட்டார்கள். கன்றுகளோடு கூடிய பசுக்களை மீட்டுக்கொண்டு வந்து பகைவர்களை விரட்டியடித்த அந்தப் பெருந்தகை இறந்துவிட்டதை அறியாமல், பாணர்களின் சுற்றம் இன்றும் அவனிடம் பரிசு பெற வருவார்களோ?","explanation":"This poem belongs to the Puram genre, specifically the Karanthai tiṇai (cattle recovery) and Kaiyaṟunilai tuṟai (state of helplessness). The poet, Uṟaiyūr Iḷampoṉ Vāṇikaṉār, laments the death of a young hero who died while recovering stolen cattle from enemies. The villagers have raised a hero-stone (naṭukal) on a pebbly slope, decorated it with peacock feathers and red flowers, and engraved his name on it. The poet wonders with deep sorrow whether the traveling bards (pāṇar), unaware of his death, will still come today expecting his usual generous patronage. The key words are 'naṭṭaṉarē kallum' (they planted the stone) and 'neṭuntakai kaḻintamai aṟiyātu' (not knowing that the noble hero has passed away).","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,1.0],[1.0,1.1],[1.1,1.5],[1.5,2.7],[2.7,3.3],[3.3,3.8],[3.8,4.2],[4.2,5.1],[5.1,5.6],[5.6,5.86],[5.9,6.5],[6.5,7.03],[7.03,7.2],[7.2,8.1],[8.1,8.3],[8.3,9.4],[9.4,9.7],[9.7,10.1],[10.1,10.1],[10.1,10.9],[10.9,11.56],[11.56,11.9],[11.9,12.8],[12.8,13.3],[13.3,13.7],[13.7,14.1]],"female":[[0.0,0.7],[0.7,1.2],[1.2,1.3],[1.3,1.7],[1.7,3.4],[3.46,3.8],[3.8,4.3],[4.3,4.54],[4.54,4.54],[4.54,4.6],[4.6,6.8],[6.8,7.6],[7.6,8.45],[8.45,8.9],[8.9,9.4],[9.4,9.6],[9.6,10.9],[10.9,11.3],[11.3,11.7],[11.7,11.8],[11.8,12.8],[12.8,13.4],[13.4,14.0],[14.0,15.0],[15.0,15.5],[15.5,16.1],[16.1,16.5]]},"sync":[[["பரலுடை","having pebbles"]],[["மருங்கின்","on the side"]],[["பதுக்கை","stone heap"]],[["சேர்த்தி","having raised"]],[["மரல்வகுந்து",""]],[["தொடுத்த",""]],[["செம்பூங்",""]],[["கண்ணியடு",""]],[["அணி","beautiful"],["மயில்","peacock"]],[["பீலி","feather"]],[["சூட்டி","having adorned"]],[["பெயர்பொறித்து","having engraved the name"]],[["இனி","now"],["நட்டனரே","they indeed planted"]],[["நட்டனரே","they indeed planted"]],[["கல்லும்","the stone also"]],[["கன்றொடு","with the calf"]],[["கறவை","milch cows"]],[["தந்து","having brought back"]],[["பகைவர்","enemies"]],[["ஓட்டிய","who drove away"]],[["நெடுந்தகை","noble hero"]],[["கழிந்தமை","the passing away"]],[["அறியாது","not knowing"]],[["இன்றும்","even today"]],[["வருங்கொல்","will they come?"]],[["பாணரது","of the bards"]],[["கடும்பே","the group indeed"]]]}