{"text":"purananuru","n":264,"lines":["பரலுடை மருங்கிற் பதுக்கை சேர்த்தி","மரல்வகுந்து தொடுத்த செம்பூங் கண்ணியடு","அணிமயிற் பீலி சூட்டிப் பெயர்பொறித்து","இனிநட் டனரே கல்லும் கன்றொடு","கறவை தந்து பகைவர் ஓட்டிய","நெடுந்தகை கழிந்தமை அறியாது","இன்றும் வருங்கொல் பாணரது கடும்பே"],"tr":["paraluṭai maruṅkiṟ patukkai cērtti","maralvakuntu toṭutta cempūṅ kaṇṇiyaṭu","aṇimayiṟ pīli cūṭṭip peyarpoṟittu","iṉinaṭ ṭaṉarē kallum kaṉṟoṭu","kaṟavai tantu pakaivar ōṭṭiya","neṭuntakai kaḻintamai aṟiyātu","iṉṟum varuṅkol pāṇaratu kaṭumpē"],"colophon":{"tinai":"karantai","tinai_ta":"கரந்தை","turai_ta":"கையறுநிலை","poet_ta":"உறையூர் இளம்பொன் வாணிகனார்","poet_tr":"Uṟaiyūr Iḷampoṉ Vāṇikaṉār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"7×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 7, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பரலுடை","tr":"paraluṭai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பர","tr":"para"},{"kind":"nirai","text":"லுடை","tr":"luṭai"}]},{"text":"மருங்கிற்","tr":"maruṅkiṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மருங்","tr":"maruṅ"},{"kind":"nēr","text":"கிற்","tr":"kiṟ"}]},{"text":"பதுக்கை","tr":"patukkai","foot":"puḷimā","acai":[{"kind":"nirai","text":"பதுக்","tr":"patuk"},{"kind":"nēr","text":"கை","tr":"kai"}]},{"text":"சேர்த்தி","tr":"cērtti","foot":"tēmā","acai":[{"kind":"nēr","text":"சேர்த்","tr":"cērt"},{"kind":"nēr","text":"தி","tr":"ti"}]}],[{"text":"மரல்வகுந்து","tr":"maralvakuntu","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"மரல்","tr":"maral"},{"kind":"nirai","text":"வகுந்","tr":"vakun"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"தொடுத்த","tr":"toṭutta","foot":"puḷimā","acai":[{"kind":"nirai","text":"தொடுத்","tr":"toṭut"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"செம்பூங்","tr"