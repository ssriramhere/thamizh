{"text":"purananuru","n":115,"lines":["ஒரு சார் அருவி ஆர்ப்ப ஒரு சார்","பாணர் மண்டை நிறையப் பெய்ம்மார்","வாக்க உக்க தேக் கள் தேறல்","கல்அலைத்து ஒழுகும் மன்னே பல் வேல்","அண்ணல் யானை வேந்தர்க்கு","இன்னான் ஆகிய இனியோன் குன்றே"],"tr":["oru cār aruvi ārppa oru cār","pāṇar maṇṭai niṟaiyap peymmār","vākka ukka tēk kaḷ tēṟal","kalalaittu oḻukum maṉṉē pal vēl","aṇṇal yāṉai vēntarkku","iṉṉāṉ ākiya iṉiyōṉ kuṉṟē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"கையறுநிலை","poet_ta":"கபிலர்","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 19, veṇṭaḷai 3"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஒருசா","tr":"orucā","foot":"puḷimā","acai":[{"kind":"nirai","text":"ஒரு","tr":"oru"},{"kind":"nēr","text":"சா","tr":"cā"}]},{"text":"ரருவி","tr":"raruvi","foot":"puḷimā","acai":[{"kind":"nirai","text":"ரரு","tr":"raru"},{"kind":"nēr","text":"வி","tr":"vi"}]},{"text":"யார்ப்ப","tr":"yārppa","foot":"tēmā","acai":[{"kind":"nēr","text":"யார்ப்","tr":"yārp"},{"kind":"nēr","text":"ப","tr":"pa"}]},{"text":"வொருசார்","tr":"vorucār","foot":"puḷimā","acai":[{"kind":"nirai","text":"வொரு","tr":"voru"},{"kind":"nēr","text":"சார்","tr":"cār"}]}],[{"text":"பாணர்","tr":"pāṇar","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"ணர்","tr":"ṇar"}]},{"text":"மண்டை","tr":"maṇṭai","foot":"tēmā","acai":[{"kind":"nēr","text":"மண்","tr":"maṇ"},{"kind":"nēr","text":"டை","tr":"ṭai"}]},{"text":"நிறையப்","tr":"niṟaiyap","foot":"puḷimā","acai":[{"kind":"nirai","text":"நிறை","tr":"niṟai"},{"kind":"nēr","text":"யப்","tr":"yap"}]},{"text":"பெய்ம்மார்","tr":"peymmār","foot":"tēmā","acai":[{"kind":"nēr","text":"பெய்ம்","tr":"peym"},{"kind":"nēr","text":"மார்","tr":"mār"}]}],[{"text":"வாக்க","tr":