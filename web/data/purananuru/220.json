{"text":"purananuru","n":220,"lines":["பெருங்சோறு பயந்து பல்யாண்டு புரந்த","பெருங்களிறு இழந்த பைதற் பாகன்","அதுசேர்ந்து அல்கிய அழுங்கல் ஆலை","வெளில்பாழ் ஆகக் கண்டு கலுழ்ந்தாங்குக்","கலங்கினேன் அல்லனோ யானே பொலந்தார்த்","தேர்வண் கிள்ளி போகிய","பேரிசை மூதூர் மன்றங் கண்டே"],"tr":["peruṅcōṟu payantu palyāṇṭu puranta","peruṅkaḷiṟu iḻanta paitaṟ pākaṉ","atucērntu alkiya aḻuṅkal ālai","veḷilpāḻ ākak kaṇṭu kaluḻntāṅkuk","kalaṅkiṉēṉ allaṉō yāṉē polantārt","tērvaṇ kiḷḷi pōkiya","pēricai mūtūr maṉṟaṅ kaṇṭē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"கையறுநிலை","poet_ta":"பொத்தியார்","poet_tr":"Pottiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 11, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பெருங்சோறு","tr":"peruṅcōṟu","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"பெருங்","tr":"peruṅ"},{"kind":"nēr","text":"சோ","tr":"cō"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"பயந்துபல்","tr":"payantupal","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பயந்","tr":"payan"},{"kind":"nirai","text":"துபல்","tr":"tupal"}]},{"text":"யாண்டு","tr":"yāṇṭu","foot":"tēmā","acai":[{"kind":"nēr","text":"யாண்","tr":"yāṇ"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"புரந்த","tr":"puranta","foot":"puḷimā","acai":[{"kind":"nirai","text":"புரந்","tr":"puran"},{"kind":"nēr","text":"த","tr":"ta"}]}],[{"text":"பெருங்களி","tr":"peruṅkaḷi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெருங்","tr":"peruṅ"},{"kind":"nirai","text":"களி","tr":"kaḷi"}]},{"text":"றிழந்த","tr":"ṟiḻanta","foot":"puḷimā","acai":[{"kind":"nirai","text":"றிழந்","tr":"ṟiḻan"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"பைதற்","tr":"paitaṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"பை","tr"