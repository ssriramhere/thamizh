{"text":"purananuru","n":311,"lines":["களர்ப்படு கூவல் தோண்டி நாளும்","புலைத்தி கழீஇய தூவெள் அறுவை","தாதுஎரு மறுகின் மாசுண இருந்து","பலர்குறை செய்த மலர்த்தார் அண்ணற்கு","ஒருவரும் இல்லை மாதோ செருவத்துச்","சிறப்புடைச் செங்கண் புகைய வோர்","தோல்கொண்டு மறைக்கும் சால்புடை யோனே"],"tr":["kaḷarppaṭu kūval tōṇṭi nāḷum","pulaitti kaḻīiya tūveḷ aṟuvai","tātueru maṟukiṉ mācuṇa iruntu","palarkuṟai ceyta malarttār aṇṇaṟku","oruvarum illai mātō ceruvattuc","ciṟappuṭaic ceṅkaṇ pukaiya vōr","tōlkoṇṭu maṟaikkum cālpuṭai yōṉē"],"colophon":{"tinai":"tumpai","tinai_ta":"தும்பை","turai_ta":"பாண் பாட்டு","poet_ta":"ஔவையார்","poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 25, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 15, āciriyattaḷai 9, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"களர்ப்படு","tr":"kaḷarppaṭu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"களர்ப்","tr":"kaḷarp"},{"kind":"nirai","text":"படு","tr":"paṭu"}]},{"text":"கூவல்","tr":"kūval","foot":"tēmā","acai":[{"kind":"nēr","text":"கூ","tr":"kū"},{"kind":"nēr","text":"வல்","tr":"val"}]},{"text":"தோண்டி","tr":"tōṇṭi","foot":"tēmā","acai":[{"kind":"nēr","text":"தோண்","tr":"tōṇ"},{"kind":"nēr","text":"டி","tr":"ṭi"}]},{"text":"நாளும்","tr":"nāḷum","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"ளும்","tr":"ḷum"}]}],[{"text":"புலைத்தி","tr":"pulaitti","foot":"puḷimā","acai":[{"kind":"nirai","text":"புலைத்","tr":"pulait"},{"kind":"nēr","text":"தி","tr":"ti"}]},{"text":"கழீஇய","tr":"kaḻīiya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கழீ","tr":"kaḻī"},{"kind":"nirai","text":"இய","tr":"iya"}]},{"text":"தூவெ","tr":"tūve","foot":"tēmā","acai":[{"kind":"nēr","text":"தூ","tr":"tū"},{"kind":"nēr","text":"வெ","tr":"ve"}]},{"text":"ளறுவை","tr":"ḷaṟu