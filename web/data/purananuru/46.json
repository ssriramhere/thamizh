}]},{"text":"மறந்த","tr":"maṟanta","foot":"puḷimā","acai":[{"kind":"nirai","text":"மறந்","tr":"maṟan"},{"kind":"nēr","text":"த","tr":"ta"}]}],[{"text":"புன்றலைச்","tr":"puṉṟalaic","foot":"kūviḷam","acai":[{"kind":"nēr","text":"புன்","tr":"puṉ"},{"kind":"nirai","text":"றலைச்","tr":"ṟalaic"}]},{"text":"சிறாஅர்","tr":"ciṟāar","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிறா","tr":"ciṟā"},{"kind":"nēr","text":"அர்","tr":"ar"}]},{"text":"மன்று","tr":"maṉṟu","foot":"tēmā","acai":[{"kind":"nēr","text":"மன்","tr":"maṉ"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"மருண்டுநோக்கி","tr":"maruṇṭunōkki","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"மருண்","tr":"maruṇ"},{"kind":"nirai","text":"டுநோக்","tr":"ṭunōk"},{"kind":"nēr","text":"கி","tr":"ki"}]}],[{"text":"விருந்திற்","tr":"viruntiṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"விருந்","tr":"virun"},{"kind":"nēr","text":"திற்","tr":"tiṟ"}]},{"text":"புன்கண்","tr":"puṉkaṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"புன்","tr":"puṉ"},{"kind":"nēr","text":"கண்","tr":"kaṇ"}]},{"text":"நோவு","tr":"nōvu","foot":"tēmā","acai":[{"kind":"nēr","text":"நோ","tr":"nō"},{"kind":"nēr","text":"வு","tr":"vu"}]},{"text":"டையர்","tr":"ṭaiyar","foot":"tēmā","acai":[{"kind":"nēr","text":"டை","tr":"ṭai"},{"kind":"nēr","text":"யர்","tr":"yar"}]}],[{"text":"கெட்டனை","tr":"keṭṭaṉai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கெட்","tr":"keṭ"},{"kind":"nirai","text":"டனை","tr":"ṭaṉai"}]},{"text":"யாயின்நீ","tr":"yāyiṉnī","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"யின்","tr":"yiṉ"},{"kind":"nēr","text":"நீ","tr":"nī"}]},{"text":"வேட்டது","tr":"vēṭṭatu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வேட்","tr":"vēṭ"},{"kind":"nirai","text":"டது","tr":"ṭatu"}]},{"text":"செய்ம்மே","tr":"ceymmē","foot":"tēmā","acai":[{"kind":"nēr","text":"செய்ம்","tr":"ceym"},{"kind":"nēr","text":"மே","tr":"mē"}]}]]},"ai":{"lines":[{"words":[{"surface":"நீயே","parts":[{"text":"நீ","lemma":"நீ","gloss":"yo