{"text":"purananuru","n":46,"lines":["நீயே புறவின் அல்லல் அன்றியும் பிறவும்","இடுக்கண் பலவும் விடுத்தோன் மருகனை","இவரே புலனுழுது உண்மார் புன்கண் அஞ்சித்","தமதுபகுத்து உண்ணும் தண்ணிழல் வாழ்நர்","களிறுகண்டு அழூஉம் அழாஅல் மறந்த","புன்றலைச் சிறாஅர் மன்று மருண்டு நோக்கி","விருந்திற் புன்கண்நோ வுடையர்","கெட்டனை யாயின் நீ வேட்டது செய்ம்மே"],"tr":["nīyē puṟaviṉ allal aṉṟiyum piṟavum","iṭukkaṇ palavum viṭuttōṉ marukaṉai","ivarē pulaṉuḻutu uṇmār puṉkaṇ añcit","tamatupakuttu uṇṇum taṇṇiḻal vāḻnar","kaḷiṟukaṇṭu aḻūum aḻāal maṟanta","puṉṟalaic ciṟāar maṉṟu maruṇṭu nōkki","viruntiṟ puṉkaṇnō vuṭaiyar","keṭṭaṉai yāyiṉ nī vēṭṭatu ceymmē"],"colophon":{"tinai":"vañci","tinai_ta":"வஞ்சி","turai_ta":"துணை வஞ்சி","poet_ta":"கோவூர் கிழார்","addressed_ta":"சோழன் குளமுற்றத்துத் துஞ்சிய கிள்ளி வளவன்","poet_tr":"Kōvūr Kiḻār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"8×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 16, āciriyattaḷai 13, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நீயே","tr":"nīyē","foot":"tēmā","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nēr","text":"யே","tr":"yē"}]},{"text":"புறவினல்","tr":"puṟaviṉal","foot":"karuviḷam","acai":[{"kind":"nirai","text":"புற","tr":"puṟa"},{"kind":"nirai","text":"வினல்","tr":"viṉal"}]},{"text":"லலன்றியும்","tr":"lalaṉṟiyum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"லலன்","tr":"lalaṉ"},{"kind":"nirai","text":"றியும்","tr":"ṟiyum"}]},{"text":"பிறவு","tr":"piṟavu","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிற","tr":"piṟa"},{"kind":"nēr","text":"வு","tr":"vu"}]}],[{"text":"மிடுக்கண்","tr":"miṭukkaṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மிடுக்","tr":"miṭuk"},{"kind":"nēr","text":"கண்","tr":"kaṇ"}]},{"text":"பலவும்","tr":"palavum","foot":"puḷimā","acai":[{"kind":"nirai","text":"பல","t