aving smeared"}]},{"words":[{"surface":"ஐயவி","parts":[{"text":"ஐயவி","lemma":"aiyavi","gloss":"white mustard"}],"gloss":"white mustard seeds"},{"surface":"சிதறி","parts":[{"text":"சிதறி","lemma":"citaṟi","gloss":"having scattered"}],"gloss":"having scattered"},{"surface":"ஆம்பல்","parts":[{"text":"ஆம்பல்","lemma":"āmpal","gloss":"reed pipe"}],"gloss":"reed pipe"},{"surface":"ஊதி","parts":[{"text":"ஊதி","lemma":"ūti","gloss":"having blown"}],"gloss":"having blown"}]},{"words":[{"surface":"இசைமணி","parts":[{"text":"இசை","lemma":"icai","gloss":"sound"},{"text":"மணி","lemma":"maṇi","gloss":"bell"}],"gloss":"sounding bell"},{"surface":"எறிந்து","parts":[{"text":"எறிந்து","lemma":"eṟintu","gloss":"having struck"}],"gloss":"having rung"},{"surface":"காஞ்சி","parts":[{"text":"காஞ்சி","lemma":"kāñci","gloss":"Kāñci song"}],"gloss":"Kāñci song"},{"surface":"பாடி","parts":[{"text":"பாடி","lemma":"pāṭi","gloss":"having sung"}],"gloss":"having sung"}]},{"words":[{"surface":"நெடுநகர்","parts":[{"text":"நெடு","lemma":"neṭu","gloss":"large"},{"text":"நகர்","lemma":"nakar","gloss":"house"}],"gloss":"large house"},{"surface":"வரைப்பின்","parts":[{"text":"வரைப்பு","lemma":"varaippu","gloss":"boundary"},{"text":"இன்","lemma":"iṉ","gloss":"of"}],"gloss":"of the boundary"},{"surface":"கடிநறை","parts":[{"text":"கடி","lemma":"kaṭi","gloss":"protective/fragrant"},{"text":"நறை","lemma":"naṟai","gloss":"incense"}],"gloss":"fragrant incense"},{"surface":"புகைஇ","parts":[{"text":"புகைஇ","lemma":"pukaiyi","gloss":"having fumigated"}],"gloss":"having fumigated"}]},{"words":[{"surface":"காக்கம்","parts":[{"text":"காக்கம்","lemma":"kākkam","gloss":"let us guard"}],"gloss":"let us guard"},{"surface":"வம்மோ","parts":[{"text":"வம்மோ","lemma":"vammō","gloss":"come"}],"gloss":"come"},{"surface":"காதலம்","parts":[{"text":"காதலம்","lemma":"kātalam","gloss":"beloved"}],"gloss":"beloved"},{"surface":"தோழீ","parts":[{"text":"தோழீ","lemma":"tōḻī","gloss":"O friend"}],"gloss":"O friend!"}]},{"words":[{"surface":"வேந்துறு","parts":[{"text":"வேந்து","lemma":"vēntu","gloss":"king"},{"text":"உறு","lemma":"uṟu","gloss":"inflicted"}],"gloss":"inflicted by the king"},{"surface":"விழுமம்","parts":[{"text":"விழுமம்","lemma":"viḻumam","gloss":"distress"}],"gloss":"distress"},{"surface":"தாங்கிய","parts":[{"text":"தாங்கிய","lemma":"tāṅkiya","gloss":"who bore"}],"gloss":"who bore"}]},{"words":[{"surface":"பூம்பொறி","parts":[{"text":"பூம்பொறி","lemma":"பூம்பொறி","gloss":"beautiful designs"}],"gloss":"beautiful designs","split_unverified":true},{"surface":"கழற்கால்","parts":[{"text":"கழல்","lemma":"kaḻal","gloss":"hero's anklet"},{"text":"கால்","lemma":"kāl","gloss":"leg"}],"gloss":"anklet-wearing leg"},{"surface":"நெடுந்தகை","parts":[{"text":"நெடுந்தகை","lemma":"நெடுந்தகை","gloss":"noble hero"}],"gloss":"noble hero","split_unverified":true},{"surface":"புண்ணே","parts":[{"text":"புண்","lemma":"puṇ","gloss":"wound"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"the wound indeed"}]}],"literal":"Sweet fruit of iravam along with neem in the house inserting / curved-stem lute with many instruments resounding / hands gently moving, black ointment smearing / white mustard scattering, reed pipe blowing / sounding bell ringing, Kāñci song singing / large house boundary's fragrant incense fumigating / let us guard, come, beloved friend! / king-inflicted distress who bore / beautifully-designed anklet-wearing-legged noble hero's wound!","translation":"Tucking neem leaves and sweet iravam fruits into the eaves of the house, sounding the curved-stem lute along with many other instruments, gently moving our hands to smear black ointment, scattering white mustard seeds, blowing the reed pipe, ringing the sounding bells, singing the Kāñci song, and fumigating the boundaries of this great mansion with fragrant incense—come, my beloved friend, let us guard the wounds of our noble hero, whose ankleted legs are adorned with beautiful designs, who bore the brunt of the distress inflicted by the enemy king!","modern":"இனிய பழங்களை உடைய இரவ மரத்தின் கிளைகளையும் வேப்பிலைகளையும் வீட்டில் செருகி, வளைந்த தண்டுடைய யாழுடன் பல இசைக் கருவிகளும் ஒலிக்குமாறு செய்து, கைகளை மெதுவாக அசைத்துக் கரிய நெய்யைத் தடவி, வெண்கடுகைத் தூவி, ஆம்பல் குழலை ஊதி, ஓசையெழுப்பும் மணியை அடித்து, காஞ்சிப் பண்ணைப் பாடி, பெரிய வீட்டின் எல்லைக்குள் நறுமணப் புகையை எழுப்பி, பகை வேந்தனால் உண்டான துன்பத்தைத் தாங்கி நின்ற, அழகிய வேலைப்பாடுகள் அமைந்த வீரக்கழல் அணிந்த கால்களையுடைய நம் தலைவனுடைய புண்ணைப் பேய்களிடமிருந்து காப்போம், வாராய் என் அன்பான தோழியே!","explanation":"This poem belongs to the Kāñci tiṇai and the specific theme of Pēyk kāñci, which involves guarding a wounded warrior from malevolent spirits. A woman speaks to her close female friend, urging her to join in performing protective rituals for her wounded husband or leader. The hero has returned from battle with severe injuries sustained while defending his land against the enemy king. To ward off evil spirits that might feast on or infect the wounds, the women tuck neem and iravam leaves into the house, play loud music, smear black ointment, scatter white mustard seeds, ring bells, and burn incense. These traditional apotropaic practices highlight the community's care for their brave defenders.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.5],[0.5,1.22],[1.22,1.8],[1.8,2.25],[2.25,3.3],[3.3,3.6],[3.6,4.2],[4.2,4.6],[4.6,5.22],[5.22,6.0],[6.07,6.36],[6.36,6.51],[6.51,6.8],[6.8,8.5],[8.5,8.7],[8.7,8.9],[8.9,10.2],[10.2,10.4],[10.4,10.8],[10.8,11.2],[11.2,11.9],[11.9,12.6],[12.6,13.0],[13.0,13.9],[13.9,14.47],[14.47,14.9],[14.9,15.6],[15.6,15.97],[15.97,16.7],[16.7,17.0],[17.0,17.5],[18.4,19.0],[19.0,19.6],[19.6,20.1],[20.1,20.3]],"female":[[0.0,0.6],[0.6,1.4],[1.4,2.0],[2.0,2.13],[2.2,3.7],[3.7,4.0],[4.0,4.7],[4.7,5.0],[5.0,5.67],[5.67,6.5],[6.5,7.2],[7.2,7.9],[7.9,8.4],[8.4,8.9],[8.9,9.2],[9.2,9.7],[9.7,11.3],[11.3,11.6],[11.6,11.8],[11.8,12.2],[12.2,13.5],[13.5,13.7],[13.7,14.1],[14.1,15.0],[15.0,15.44],[15.44,15.76],[15.76,16.2],[16.2,16.5],[16.6,18.3],[18.3,18.5],[18.5,19.1],[20.0,20.6],[20.6,21.2],[21.2,21.7],[21.7,21.9]]},"sync":[[["தீங்கனி","sweet fruit"]],[["இரவமொடு","with the iravam leaves"]],[["வேம்பு","neem"],["மனை","house"],["செரீஇ","having tucked in"]],[["செரீஇ","having tucked in"]],[["வாங்குமருப்பு","curved stem"]],[["யாழொடு","with the lute"]],[["பல்இயம்","many musical instruments"]],[["கறங்க","to resound"]],[["கை","hand"],["பய","gently"]],[["பெயர்த்து","having moved"]],[["மைஇழுது","black ointment"]],[["இழுகி","having smeared"]],[["ஐயவி","white mustard seeds"]],[["சிதறி","having scattered"]],[["ஆம்பல்","reed pipe"]],[["ஊதி","having blown"]],[["இசைமணி","sounding bell"]],[["எறிந்து","having rung"]],[["காஞ்சி","Kāñci song"]],[["பாடி","having sung"]],[["நெடுநகர்","large house"]],[["வரைப்பின்","of the boundary"]],[["கடிநறை","fragrant incense"]],[["புகைஇ","having fumigated"]],[["காக்கம்","let us guard"]],[["வம்மோ","come"]],[["காதலம்","beloved"]],[["தோழீ","O friend!"]],[["வேந்துறு","inflicted by the king"]],[["விழுமம்","distress"]],[["தாங்கிய","who bore"]],[["பூம்பொறி","beautiful designs"]],[["கழற்கால்","anklet-wearing leg"]],[["நெடுந்தகை","noble hero"]],[["புண்ணே","the wound indeed"]]]}