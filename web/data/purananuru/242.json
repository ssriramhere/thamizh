{"text":"purananuru","n":242,"lines":["இளையோர் சூடார் வளையோர் கொய்யார்","நல்யாழ் மருப்பின் மெல்ல வாங்கிப்","பாணன் சூடான் பாடினி அணியாள்","ஆண்மை தோன்ற ஆடவர்க் கடந்த","வல்வேற் சாத்தன் மாய்ந்த பின்றை","முல்லையும் பூத்தியோ ஒல்லையூர் நாட்டே"],"tr":["iḷaiyōr cūṭār vaḷaiyōr koyyār","nalyāḻ maruppiṉ mella vāṅkip","pāṇaṉ cūṭāṉ pāṭiṉi aṇiyāḷ","āṇmai tōṉṟa āṭavark kaṭanta","valvēṟ cāttaṉ māynta piṉṟai","mullaiyum pūttiyō ollaiyūr nāṭṭē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"கையறுநிலை","poet_ta":"குடவாயிற் தீரத்தனார்","addressed_ta":"ஒல்லையூர் கிழான் மகன் பெருஞ்சாத்தன்","poet_tr":"Kuṭavāyiṟ Tīrattaṉār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"6×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 5"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இளையோர்","tr":"iḷaiyōr","foot":"puḷimā","acai":[{"kind":"nirai","text":"இளை","tr":"iḷai"},{"kind":"nēr","text":"யோர்","tr":"yōr"}]},{"text":"சூடார்","tr":"cūṭār","foot":"tēmā","acai":[{"kind":"nēr","text":"சூ","tr":"cū"},{"kind":"nēr","text":"டார்","tr":"ṭār"}]},{"text":"வளையோர்","tr":"vaḷaiyōr","foot":"puḷimā","acai":[{"kind":"nirai","text":"வளை","tr":"vaḷai"},{"kind":"nēr","text":"யோர்","tr":"yōr"}]},{"text":"கொய்யார்","tr":"koyyār","foot":"tēmā","acai":[{"kind":"nēr","text":"கொய்","tr":"koy"},{"kind":"nēr","text":"யார்","tr":"yār"}]}],[{"text":"நல்யாழ்","tr":"nalyāḻ","foot":"tēmā","acai":[{"kind":"nēr","text":"நல்","tr":"nal"},{"kind":"nēr","text":"யாழ்","tr":"yāḻ"}]},{"text":"மருப்பின்","tr":"maruppiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மருப்","tr":"marup"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]},{"text":"மெல்ல","tr":"mella","foot":"tēmā","acai":[{"kind":"nēr","text":"மெல்","tr":"mel"},{"kind":"nēr","text":"ல","tr":"la"}]},{"text":"வாங்கிப்","tr":"vāṅkip","foo