{"text":"purananuru","n":355,"lines":["தோற்றக் கிடையாத போயின செய்யுள் இது","மதிலும் ஞாயில் இன்றே கிடங்கும்","நீஇர் இன்மையின் கன்றுமேய்ந்து உகளும்","ஊரது நிலைமையும் இதுவே"],"tr":["tōṟṟak kiṭaiyāta pōyiṉa ceyyuḷ itu","matilum ñāyil iṉṟē kiṭaṅkum","nīir iṉmaiyiṉ kaṉṟumēyntu ukaḷum","ūratu nilaimaiyum ituvē"],"colophon":{"tinai":"kāñci","tinai_ta":"காஞ்சி","turai_ta":"பெயர் தெரிந்திலது","poet_ta":"பெயர் தெரிந்திலது","poet_tr":"Peyar Terintilatu"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"4×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 15, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 7, āciriyattaḷai 7, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"தோற்றக்","tr":"tōṟṟak","foot":"tēmā","acai":[{"kind":"nēr","text":"தோற்","tr":"tōṟ"},{"kind":"nēr","text":"றக்","tr":"ṟak"}]},{"text":"கிடையா","tr":"kiṭaiyā","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிடை","tr":"kiṭai"},{"kind":"nēr","text":"யா","tr":"yā"}]},{"text":"தபோயின","tr":"tapōyiṉa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தபோ","tr":"tapō"},{"kind":"nirai","text":"யின","tr":"yiṉa"}]},{"text":"செய்யுளிது","tr":"ceyyuḷitu","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"செய்","tr":"cey"},{"kind":"nirai","text":"யுளி","tr":"yuḷi"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"மதிலும்","tr":"matilum","foot":"puḷimā","acai":[{"kind":"nirai","text":"மதி","tr":"mati"},{"kind":"nēr","text":"லும்","tr":"lum"}]},{"text":"ஞாயி","tr":"ñāyi","foot":"tēmā","acai":[{"kind":"nēr","text":"ஞா","tr":"ñā"},{"kind":"nēr","text":"யி","tr":"yi"}]},{"text":"லின்றே","tr":"liṉṟē","foot":"tēmā","acai":[{"kind":"nēr","text":"லின்","tr":"liṉ"},{"kind":"nēr","text":"றே","tr":"ṟē"}]},{"text":"கிடங்கும்","tr":"kiṭaṅkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிடங்","tr":"kiṭaṅ"},{"kind":"nēr","text":"கும்","tr":"kum"}]}],[{"text":"நீஇரின்","tr":"nīiriṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nirai","text":"இரின்","tr":"iriṉ"}]},{"text":"மையின்","tr":"maiyiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"மை","tr":"mai"},{"kind":"nēr","text":"யின்","tr":"yiṉ"}]},{"text":"கன்றுமேய்ந்","tr":"kaṉṟumēyn","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கன்","tr":"kaṉ"},{"kind":"nirai","text":"றுமேய்ந்","tr":"ṟumēyn"}]},{"text":"துகளு","tr":"tukaḷu","foot":"puḷimā","acai":[{"kind":"nirai","text":"துக","tr":"tuka"},{"kind":"nēr","text":"ளு","tr":"ḷu"}]}],[{"text":"மூர","tr":"mūra","foot":"tēmā","acai":[{"kind":"nēr","text":"மூ","tr":"mū"},{"kind":"nēr","text":"ர","tr":"ra"}]},{"text":"துநிலை","tr":"tunilai","foot":"puḷimā","acai":[{"kind":"nirai","text":"துநி","tr":"tuni"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"மையு","tr":"maiyu","foot":"tēmā","acai":[{"kind":"nēr","text":"மை","tr":"mai"},{"kind":"nēr","text":"யு","tr":"yu"}]},{"text":"மிதுவே","tr":"mituvē","foot":"puḷimā","acai":[{"kind":"nirai","text":"மிது","tr":"mitu"},{"kind":"nēr","text":"வே","tr":"vē"}]}]]},"ai":null}