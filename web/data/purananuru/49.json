{"text":"purananuru","n":49,"lines":["நாடன் என்கோ ஊரன் என்கோ","பாடிமிழ் பனிக்கடற் சேர்ப்பன் என்கோ","யாங்கனம் மொழிகோ ஓங்குவாள் கோதையை","புனவர் தட்டை புடைப்பின் அயலது","இறங்குகதிர் அலமரு கழனியும்","பிறங்குநீர்ச் சேர்ப்பினும் புள் ஒருங்கு எழுமே"],"tr":["nāṭaṉ eṉkō ūraṉ eṉkō","pāṭimiḻ paṉikkaṭaṟ cērppaṉ eṉkō","yāṅkaṉam moḻikō ōṅkuvāḷ kōtaiyai","puṉavar taṭṭai puṭaippiṉ ayalatu","iṟaṅkukatir alamaru kaḻaṉiyum","piṟaṅkunīrc cērppiṉum puḷ oruṅku eḻumē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"புலவராற்றுப் படை","poet_ta":"பொய்கையார்","addressed_ta":"சேரமான் கோக்கோதை மார்பன்","poet_tr":"Poykaiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"6×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 10, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நாட","tr":"nāṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"னென்கோ","tr":"ṉeṉkō","foot":"tēmā","acai":[{"kind":"nēr","text":"னென்","tr":"ṉeṉ"},{"kind":"nēr","text":"கோ","tr":"kō"}]},{"text":"வூர","tr":"vūra","foot":"tēmā","acai":[{"kind":"nēr","text":"வூ","tr":"vū"},{"kind":"nēr","text":"ர","tr":"ra"}]},{"text":"னென்கோ","tr":"ṉeṉkō","foot":"tēmā","acai":[{"kind":"nēr","text":"னென்","tr":"ṉeṉ"},{"kind":"nēr","text":"கோ","tr":"kō"}]}],[{"text":"பாடிமிழ்","tr":"pāṭimiḻ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nirai","text":"டிமிழ்","tr":"ṭimiḻ"}]},{"text":"பனிக்கடற்","tr":"paṉikkaṭaṟ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பனிக்","tr":"paṉik"},{"kind":"nirai","text":"கடற்","tr":"kaṭaṟ"}]},{"text":"சேர்ப்ப","tr":"cērppa","foot":"tēmā","acai":[{"kind":"nēr","text":"சேர்ப்","tr":"cērp"},{"kind":"nēr","text":"ப","tr":"pa"}]},{"text":"னென்கோ","tr":"ṉeṉkō","foot":"tēmā","acai":[{"