m","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சேர்ப்","tr":"cērp"},{"kind":"nirai","text":"பினும்","tr":"piṉum"}]},{"text":"புள்ளொருங்","tr":"puḷḷoruṅ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"புள்","tr":"puḷ"},{"kind":"nirai","text":"ளொருங்","tr":"ḷoruṅ"}]},{"text":"கெழுமே","tr":"keḻumē","foot":"puḷimā","acai":[{"kind":"nirai","text":"கெழு","tr":"keḻu"},{"kind":"nēr","text":"மே","tr":"mē"}]}]]},"ai":{"lines":[{"words":[{"surface":"நாடன்","parts":[{"text":"நாடு","lemma":"nāṭu","gloss":"mountain country"},{"text":"அன்","lemma":"aṉ","gloss":"he/masculine suffix"}],"gloss":"lord of the mountain country"},{"surface":"என்கோ","parts":[{"text":"என்","lemma":"eṉ","gloss":"say"},{"text":"கோ","lemma":"kō","gloss":"shall I"}],"gloss":"shall I say?"},{"surface":"ஊரன்","parts":[{"text":"ஊர்","lemma":"ūr","gloss":"agricultural town"},{"text":"அன்","lemma":"aṉ","gloss":"he/masculine suffix"}],"gloss":"lord of the agricultural town"},{"surface":"என்கோ","parts":[{"text":"என்","lemma":"eṉ","gloss":"say"},{"text":"கோ","lemma":"kō","gloss":"shall I"}],"gloss":"shall I say?"}]},{"words":[{"surface":"பாடு","parts":[{"text":"பாடு","lemma":"pāṭu","gloss":"roaring"}],"gloss":"roaring"},{"surface":"இமிழ்","parts":[{"text":"இமிழ்","lemma":"imiḻ","gloss":"sounding"}],"gloss":"sounding"},{"surface":"பனி","parts":[{"text":"பனி","lemma":"paṉi","gloss":"cold"}],"gloss":"cold"},{"surface":"கடல்","parts":[{"text":"கடல்","lemma":"kaṭal","gloss":"ocean"}],"gloss":"ocean"},{"surface":"சேர்ப்பன்","parts":[{"text":"சேர்ப்பு","lemma":"cērppu","gloss":"coast"},{"text":"அன்","lemma":"aṉ","gloss":"he/masculine suffix"}],"gloss":"lord of the coast"},{"surface":"என்கோ","parts":[{"text":"என்","lemma":"eṉ","gloss":"say"},{"text":"கோ","lemma":"kō","gloss":"shall I"}],"gloss":"shall I say?"}]},{"words":[{"surface":"யாங்கனம்","parts":[{"text":"யாங்கனம்","lemma":"yāṅkaṉam","gloss":"how"}],"gloss":"how"},{"surface":"மொழிகோ","parts":[{"text":"மொழி","lemma":"moḻi","gloss":"speak"},{"text":"கோ","lemma":"kō","gloss":"shall I"}],"gloss":"shall I speak of?"},{"surface":"ஓங்கு","parts":[{"text":"ஓங்கு","lemma":"ōṅku","gloss":"raised"}],"gloss":"raised"},{"surface":"வாள்","parts":[{"text":"வாள்","lemma":"vāḷ","gloss":"sword"}],"gloss":"sword"},{"surface":"கோதையை","parts":[{"text":"கோதை","lemma":"kōtai","gloss":"Kōtai"},{"text":"ஐ","lemma":"ai","gloss":"accusative case marker"}],"gloss":"Kōtai (accusative)"}]},{"words":[{"surface":"புனவர்","parts":[{"text":"புனவர்","lemma":"புனவர்","gloss":"forest-field farmers"}],"gloss":"forest-field farmers","split_unverified":true},{"surface":"தட்டை","parts":[{"text":"தட்டை","lemma":"taṭṭai","gloss":"bamboo clapper"}],"gloss":"bamboo clapper"},{"surface":"புடைப்பின்","parts":[{"text":"புடை","lemma":"puṭai","gloss":"strike"},{"text":"ப்பு","lemma":"ppu","gloss":"noun-forming suffix"},{"text":"இன்","lemma":"iṉ","gloss":"when/if"}],"gloss":"when they strike"},{"surface":"அயலது","parts":[{"text":"அயல்","lemma":"ayal","gloss":"adjacent place"},{"text":"அது","lemma":"atu","gloss":"pronominal suffix"}],"gloss":"of the adjacent place"}]},{"words":[{"surface":"இறங்கு","parts":[{"text":"இறங்கு","lemma":"iṟaṅku","gloss":"bend down"}],"gloss":"bending down"},{"surface":"கதிர்","parts":[{"text":"கதிர்","lemma":"katir","gloss":"ear of grain"}],"gloss":"ears of grain"},{"surface":"அலமரு","parts":[{"text":"அலமர்","lemma":"alamar","gloss":"wave"},{"text":"உ","lemma":"u","gloss":"verbal participle suffix"}],"gloss":"waving"},{"surface":"கழனியும்","parts":[{"text":"கழனி","lemma":"kaḻaṉi","gloss":"agricultural field"},{"text":"உம்","lemma":"um","gloss":"and"}],"gloss":"and the agricultural fields"}]},{"words":[{"surface":"பிறங்கு","parts":[{"text":"பிறங்கு","lemma":"piṟaṅku","gloss":"surge"}],"gloss":"surging"},{"surface":"நீர்","parts":[{"text":"நீர்","lemma":"nīr","gloss":"water"}],"gloss":"water"},{"surface":"சேர்ப்பினும்","parts":[{"text":"சேர்ப்பு","lemma":"cērppu","gloss":"coast"},{"text":"இன்","lemma":"iṉ","gloss":"locative marker"},{"text":"உம்","lemma":"um","gloss":"and"}],"gloss":"and in the coast"},{"surface":"புள்","parts":[{"text":"புள்","lemma":"puḷ","gloss":"bird"}],"gloss":"birds"},{"surface":"ஒருங்கு","parts":[{"text":"ஒருங்கு","lemma":"oruṅku","gloss":"together"}],"gloss":"together"},{"surface":"எழுமே","parts":[{"text":"எழும்","lemma":"eḻu","gloss":"rise"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"will rise indeed"}]}],"literal":"Lord of the mountain country shall I say? Lord of the agricultural town shall I say? / Lord of the coast of the roaring cold ocean shall I say? / How shall I speak of Kōtai with the raised sword? / When the forest-field farmers strike their bamboo clappers, in the adjacent / agricultural fields with drooping ears of grain waving, / and in the coast of surging water, the birds rise together at once!","translation":"Shall I call him the lord of the mountains? Or shall I call him the lord of the fertile towns? Or shall I call him the lord of the coast where the cold, roaring ocean sounds? How shall I describe Kōtai of the raised sword? When the upland farmers strike their bamboo clappers to scare birds, the birds in the adjacent agricultural fields of waving, drooping grain, and those on the coast of surging waters, all rise up together at once!","modern":"உயர்ந்த வாளினை ஏந்திய கோதையை நான் எவ்வாறு அழைப்பேன்? குறிஞ்சி நிலத்துத் தலைவன் என்பேனா? மருத நிலத்து ஊரன் என்பேனா? அல்லது ஒலிக்கும் குளிர்ந்த கடலை உடைய நெய்தல் நிலத்துச் சேர்ப்பன் என்பேனா? ஏனெனில், புனத்தில் உள்ள தினைப்புனக் காவலாளிகள் பறவைகளை ஓட்டுவதற்காகத் தட்டையைத் தட்டும்போது, அதன் அருகில் உள்ள குனிந்த கதிர்களை உடைய மருத நிலத்துக் கழனிகளிலும், விளங்கும் நீரைக் கொண்ட நெய்தல் நிலத்துக் கடற்கரையிலும் உள்ள பறவைகள் அனைத்தும் ஒரே நேரத்தில் அச்சமடைந்து ஒன்றாக மேலே பறக்கின்றன. அவனது நாடு மூன்று நிலங்களும் மிக நெருக்கமாக அமைந்த வளத்தைக் கொண்டுள்ளது.","explanation":"The poet Poykaiyār praises the Cēra king Cēramāṉ Kōkkōtai Mārpaṉ by highlighting the unique geographical integration of his kingdom. He wonders whether to address the king as the lord of the mountains, the plains, or the seashore. To illustrate how closely these three landscapes are knit together, the poet describes how the sound of a bamboo clapper beaten by upland farmers to scare birds instantly echoes through the adjacent agricultural fields and reaches the seashore. Consequently, the birds in all three regions rise up in flight at the exact same moment. This vivid imagery beautifully conveys the richness, proximity, and unity of the king's diverse territories.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,1.0],[1.0,1.5],[1.5,1.8],[1.8,2.5],[2.5,2.7],[2.7,3.6],[3.6,3.6],[3.6,3.6],[3.6,4.93],[4.93,5.7],[5.7,6.08],[6.08,6.08],[6.08,6.2],[6.2,7.5],[7.5,7.6],[7.6,7.6],[7.6,9.6],[9.6,9.7],[9.7,10.33],[10.33,11.58],[11.58,12.0],[12.0,12.3],[12.55,12.72]],"female":[[0.0,0.6],[0.6,0.9],[0.9,1.3],[1.3,1.6],[1.6,2.6],[2.6,3.1],[3.1,3.7],[3.7,3.8],[3.8,4.2],[4.46,4.71],[4.97,6.28],[6.28,6.63],[6.63,6.63],[6.63,6.7],[6.7,8.3],[8.3,8.4],[8.4,8.4],[8.4,10.6],[10.6,10.8],[10.8,12.3],[12.3,12.7],[12.78,13.1],[13.1,13.6],[13.6,14.0]]},"sync":[[["நாடன்","lord of the mountain country"]],[["என்கோ","shall I say?"]],[["ஊரன்","lord of the agricultural town"]],[["என்கோ","shall I say?"]],[["பாடு","roaring"],["இமிழ்","sounding"]],[["பனி","cold"],["கடல்","ocean"]],[["சேர்ப்பன்","lord of the coast"]],[["என்கோ","shall I say?"]],[["யாங்கனம்","how"]],[["மொழிகோ","shall I speak of?"]],[["ஓங்கு","raised"],["வாள்","sword"]],[["கோதையை","Kōtai (accusative)"]],[["புனவர்","forest-field farmers"]],[["தட்டை","bamboo clapper"]],[["புடைப்பின்","when they strike"]],[["அயலது","of the adjacent place"]],[["இறங்கு","bending down"],["கதிர்","ears of grain"]],[["அலமரு","waving"]],[["கழனியும்","and the agricultural fields"]],[["பிறங்கு","surging"],["நீர்","water"]],[["சேர்ப்பினும்","and in the coast"]],[["புள்","birds"]],[["ஒருங்கு","together"]],[["எழுமே","will rise indeed"]]]}