{"text":"purananuru","n":153,"lines":["மழையணி குன்றத்துக் கிழவன் நாளும்","இழையணி யானை இரப்போர்க்கு ஈயும்","சுடர்விடு பசும்பூண் சூர்ப்பு அமை முன்கை","அடுபோர் ஆனா ஆதன் ஓரி","மாரி வண்கொடை காணிய நன்றும்","சென்றது மன் எம் கண்ணுளங் கடும்பே","பனிநீர்ப் பூவா மணிமிடை குவளை","வால்நார்த் தொடுத்த கண்ணியும் கலனும்","யானை இனத்தொடு பெற்றனர் நீங்கிப்","பசியார் ஆகல் மாறுகொல் விசிபிணிக்","கூடுகொள் இன்னியம் கறங்க","ஆடலும் ஒல்லார் தம் பாடலும் மறந்தே"],"tr":["maḻaiyaṇi kuṉṟattuk kiḻavaṉ nāḷum","iḻaiyaṇi yāṉai irappōrkku īyum","cuṭarviṭu pacumpūṇ cūrppu amai muṉkai","aṭupōr āṉā ātaṉ ōri","māri vaṇkoṭai kāṇiya naṉṟum","ceṉṟatu maṉ em kaṇṇuḷaṅ kaṭumpē","paṉinīrp pūvā maṇimiṭai kuvaḷai","vālnārt toṭutta kaṇṇiyum kalaṉum","yāṉai iṉattoṭu peṟṟaṉar nīṅkip","paciyār ākal māṟukol vicipiṇik","kūṭukoḷ iṉṉiyam kaṟaṅka","āṭalum ollār tam pāṭalum maṟantē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"இயன் மொழி","poet_ta":"வண்பரணர்","addressed_ta":"வல்வில் ஓரி","poet_tr":"Vaṇparaṇar"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"12 lines"},{"name":"feet per line","ok":true,"detail":"12×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 46, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 25, veṇṭaḷai 21, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மழையணி","tr":"maḻaiyaṇi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மழை","tr":"maḻai"},{"kind":"nirai","text":"யணி","tr":"yaṇi"}]},{"text":"குன்றத்துக்","tr":"kuṉṟattuk","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"குன்","tr":"kuṉ"},{"kind":"nēr","text":"றத்","tr":"ṟat"},{"kind":"nēr","text":"துக்","tr":"tuk"}]},{"text":"கிழவன்","tr":"kiḻavaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிழ","tr":"kiḻa"},{"kind":"nēr","text":"வன்","tr":"vaṉ"}]},{"text":"நாளு","tr":"nāḷu","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"ளு","tr":"ḷu"}]}],[{"text":"மிழையணி","tr":"miḻaiyaṇi",