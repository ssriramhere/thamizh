{"text":"purananuru","n":218,"lines":["பொன்னும் துகிரும் முத்தும் மன்னிய","மாமலை பயந்த காமரு மணியும்","இடைபடச் சேய ஆயினும் தொடை புணர்ந்து","அருவிலை நன்கலம் அமைக்கும் காலை","ஒருவழித் தோன்றியாங்கு என்றும் சான்றோர்","சான்றோர் பாலர் ஆப","சாலார் சாலார் பாலர் ஆகுபவே"],"tr":["poṉṉum tukirum muttum maṉṉiya","māmalai payanta kāmaru maṇiyum","iṭaipaṭac cēya āyiṉum toṭai puṇarntu","aruvilai naṉkalam amaikkum kālai","oruvaḻit tōṉṟiyāṅku eṉṟum cāṉṟōr","cāṉṟōr pālar āpa","cālār cālār pālar ākupavē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"கையறுநிலை","poet_ta":"கண்ணகனார் நத்தத்தனார் எனவும் பாடம்","poet_tr":"Kaṇṇakaṉār Nattattaṉār Eṉavum Pāṭam"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பொன்னும்","tr":"poṉṉum","foot":"tēmā","acai":[{"kind":"nēr","text":"பொன்","tr":"poṉ"},{"kind":"nēr","text":"னும்","tr":"ṉum"}]},{"text":"துகிரும்","tr":"tukirum","foot":"puḷimā","acai":[{"kind":"nirai","text":"துகி","tr":"tuki"},{"kind":"nēr","text":"ரும்","tr":"rum"}]},{"text":"முத்தும்","tr":"muttum","foot":"tēmā","acai":[{"kind":"nēr","text":"முத்","tr":"mut"},{"kind":"nēr","text":"தும்","tr":"tum"}]},{"text":"மன்னிய","tr":"maṉṉiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மன்","tr":"maṉ"},{"kind":"nirai","text":"னிய","tr":"ṉiya"}]}],[{"text":"மாமலை","tr":"māmalai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"மலை","tr":"malai"}]},{"text":"பயந்த","tr":"payanta","foot":"puḷimā","acai":[{"kind":"nirai","text":"பயந்","tr":"payan"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"காமரு","tr":"kāmaru","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nirai","text":"மரு","tr":"maru"}]},{"text