{"text":"purananuru","n":231,"lines":["எரிபுனக் குறவன் குறையல் அன்ன","கரிபுற விறகின் ஈம ஒள்அழல்","குருகினும் குறுகுக குறுகாது சென்று","விசும்பஉற நீளினும் நீள்க பசுங்கதிர்","திங்கள் அன்ன வெண்குடை","ஒண்ஞாயிறு அன்னோன் புகழ் மாயலவே"],"tr":["eripuṉak kuṟavaṉ kuṟaiyal aṉṉa","karipuṟa viṟakiṉ īma oḷaḻal","kurukiṉum kuṟukuka kuṟukātu ceṉṟu","vicumpauṟa nīḷiṉum nīḷka pacuṅkatir","tiṅkaḷ aṉṉa veṇkuṭai","oṇñāyiṟu aṉṉōṉ pukaḻ māyalavē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"கையறுநிலை","poet_ta":"ஔவையார்","addressed_ta":"அதியமான் நெடுமான் அஞ்சி","poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 11"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"எரிபுனக்","tr":"eripuṉak","foot":"karuviḷam","acai":[{"kind":"nirai","text":"எரி","tr":"eri"},{"kind":"nirai","text":"புனக்","tr":"puṉak"}]},{"text":"குறவன்","tr":"kuṟavaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"குற","tr":"kuṟa"},{"kind":"nēr","text":"வன்","tr":"vaṉ"}]},{"text":"குறைய","tr":"kuṟaiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"குறை","tr":"kuṟai"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"லன்ன","tr":"laṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"லன்","tr":"laṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]}],[{"text":"கரிபுற","tr":"karipuṟa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கரி","tr":"kari"},{"kind":"nirai","text":"புற","tr":"puṟa"}]},{"text":"விறகி","tr":"viṟaki","foot":"puḷimā","acai":[{"kind":"nirai","text":"விற","tr":"viṟa"},{"kind":"nēr","text":"கி","tr":"ki"}]},{"text":"னீம","tr":"ṉīma","foot":"tēmā","acai":[{"kind":"nēr","text":"னீ","tr":"ṉī"},{"kind":"nēr","text":"ம","tr":"ma"}]},{"text":"வொள்ளழல்","tr":"voḷḷaḻal","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வொள்","tr