{"text":"purananuru","n":245,"lines":["யங்குப் பெரிது ஆயினும் நோய்அளவு எனைத்தே","உயிர்செகுக் கல்லா மதுகைத்து அன்மையின்","கள்ளி போகிய களரியம் பறந்தலை","வெள்ளிடைப் பொத்திய விளைவிறகு ஈமத்து","ஒள்ளழற் பள்ளிப் பாயல் சேர்த்தி","ஞாங்கர் மாய்ந்தனள் மடந்தை","இன்னும் வாழ்வல் என்இதன் பண்பே"],"tr":["yaṅkup peritu āyiṉum nōyaḷavu eṉaittē","uyircekuk kallā matukaittu aṉmaiyiṉ","kaḷḷi pōkiya kaḷariyam paṟantalai","veḷḷiṭaip pottiya viḷaiviṟaku īmattu","oḷḷaḻaṟ paḷḷip pāyal cērtti","ñāṅkar māyntaṉaḷ maṭantai","iṉṉum vāḻval eṉitaṉ paṇpē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"கையறுநிலை","poet_ta":"சேரமான் கோட்டம்பலத்துத் துஞ்சிய மாக்கோதை","poet_tr":"Cēramāṉ Kōṭṭampalattut Tuñciya Mākkōtai"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"1×5, 6×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 13"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"1 five-foot line (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"யங்குப்","tr":"yaṅkup","foot":"tēmā","acai":[{"kind":"nēr","text":"யங்","tr":"yaṅ"},{"kind":"nēr","text":"குப்","tr":"kup"}]},{"text":"பெரிதா","tr":"peritā","foot":"puḷimā","acai":[{"kind":"nirai","text":"பெரி","tr":"peri"},{"kind":"nēr","text":"தா","tr":"tā"}]},{"text":"யினும்நோ","tr":"yiṉumnō","foot":"puḷimā","acai":[{"kind":"nirai","text":"யினும்","tr":"yiṉum"},{"kind":"nēr","text":"நோ","tr":"nō"}]},{"text":"யளவு","tr":"yaḷavu","foot":"puḷimā","acai":[{"kind":"nirai","text":"யள","tr":"yaḷa"},{"kind":"nēr","text":"வு","tr":"vu"}]},{"text":"வெனைத்தே","tr":"veṉaittē","foot":"puḷimā","acai":[{"kind":"nirai","text":"வெனைத்","tr":"veṉait"},{"kind":"nēr","text":"தே","tr":"tē"}]}],[{"text":"யுயிர்செகுக்","tr":"yuyircekuk","foot":"karuviḷam","acai":[{"kind":"nirai","text":"யுயிர்","tr":"yuyir"},{"kind":"nirai","text":"செகுக்","tr":"cekuk"}]