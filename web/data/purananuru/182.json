{"text":"purananuru","n":182,"lines":["உண்டால் அம்ம இவ்வுலகம் இந்திரர்","அமிழ்தம் இயைவ தாயினும் இனிதுஎனத்","தமியர் உண்டலும் இலரே முனிவிலர்","துஞ்சலும் இலர் பிறர் அஞ்சுவது அஞ்சிப்","புகழ்எனின் உயிருங் கொடுக்குவர் பழியெனின்","உலகுடன் பெறினும் கொள்ளலர் அயர்விலர்","அன்ன மாட்சி அனைய ராகித்","தமக்கென முயலா நோன்தாள்","பிறர்க்கென முயலுநர் உண்மை யானே"],"tr":["uṇṭāl amma ivvulakam intirar","amiḻtam iyaiva tāyiṉum iṉitueṉat","tamiyar uṇṭalum ilarē muṉivilar","tuñcalum ilar piṟar añcuvatu añcip","pukaḻeṉiṉ uyiruṅ koṭukkuvar paḻiyeṉiṉ","ulakuṭaṉ peṟiṉum koḷḷalar ayarvilar","aṉṉa māṭci aṉaiya rākit","tamakkeṉa muyalā nōṉtāḷ","piṟarkkeṉa muyalunar uṇmai yāṉē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"பொருண்மொழிக் காஞ்சி","poet_ta":"கடலுள் மாய்ந்த இளம்பெரு வழுதி","poet_tr":"Kaṭaluḷ Māynta Iḷamperu Vaḻuti"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"8×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 35"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 22, veṇṭaḷai 12"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"உண்டா","tr":"uṇṭā","foot":"tēmā","acai":[{"kind":"nēr","text":"உண்","tr":"uṇ"},{"kind":"nēr","text":"டா","tr":"ṭā"}]},{"text":"லம்ம","tr":"lamma","foot":"tēmā","acai":[{"kind":"nēr","text":"லம்","tr":"lam"},{"kind":"nēr","text":"ம","tr":"ma"}]},{"text":"விவ்வுல","tr":"vivvula","foot":"kūviḷam","acai":[{"kind":"nēr","text":"விவ்","tr":"viv"},{"kind":"nirai","text":"வுல","tr":"vula"}]},{"text":"கமிந்திர","tr":"kamintira","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கமிந்","tr":"kamin"},{"kind":"nirai","text":"திர","tr":"tira"}]}],[{"text":"ரமிழ்த","tr":"ramiḻta","foot":"puḷimā","acai":[{"kind":"nirai","text":"ரமிழ்","tr":"ramiḻ"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"மியைவ","tr":"miyaiva","foot":"puḷimā","acai":[{"kind":"nirai","text":"மியை","tr":"miyai"},{"kind":"nēr","text":"வ"