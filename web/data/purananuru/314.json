kind":"nirai","text":"யெடுத்","tr":"yeṭut"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"நிறைய","tr":"niṟaiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"நிறை","tr":"niṟai"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"ழிந்தெ","tr":"ḻinte","foot":"tēmā","acai":[{"kind":"nēr","text":"ழிந்","tr":"ḻin"},{"kind":"nēr","text":"தெ","tr":"te"}]},{"text":"ழுதருதா","tr":"ḻutarutā","foot":"karuviḷam","acai":[{"kind":"nirai","text":"ழுத","tr":"ḻuta"},{"kind":"nirai","text":"ருதா","tr":"rutā"}]},{"text":"னைக்குச்","tr":"ṉaikkuc","foot":"tēmā","acai":[{"kind":"nēr","text":"னைக்","tr":"ṉaik"},{"kind":"nēr","text":"குச்","tr":"kuc"}]}],[{"text":"சிறையும்","tr":"ciṟaiyum","foot":"puḷimā","acai":[{"kind":"nirai","text":"சிறை","tr":"ciṟai"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"தானேதன்","tr":"tāṉētaṉ","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"னே","tr":"ṉē"},{"kind":"nēr","text":"தன்","tr":"taṉ"}]},{"text":"னிறைவிழு","tr":"ṉiṟaiviḻu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"னிறை","tr":"ṉiṟai"},{"kind":"nirai","text":"விழு","tr":"viḻu"}]},{"text":"முறினே","tr":"muṟiṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"முறி","tr":"muṟi"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"மனைக்கு","parts":[{"text":"மனை","lemma":"maṉai","gloss":"house"},{"text":"கு","lemma":"ku","gloss":"to"}],"gloss":"for the house"},{"surface":"விளக்காகிய","parts":[{"text":"விளக்கு","lemma":"viḷakku","gloss":"lamp"},{"text":"ஆகிய","lemma":"ākiya","gloss":"who became"}],"gloss":"who became the lamp"},{"surface":"வாள்நுதல்","parts":[{"text":"வாள்","lemma":"vāḷ","gloss":"bright"},{"text":"நுதல்","lemma":"nutal","gloss":"forehead"}],"gloss":"bright forehead"},{"surface":"கணவன்","parts":[{"text":"கணவன்","lemma":"kaṇavaṉ","gloss":"husband"}],"gloss":"husband"}]},{"words":[{"surface":"முனைக்கு","parts":[{"text":"முனை","lemma":"muṉai","gloss":"battlefront"},{"text":"கு","lemma":"ku","gloss":"to"}],"gloss":"for the battlefront"},{"surface":"வரம்பாகிய","parts":[{"text":"வரம்பு","lemma":"varampu","gloss":"boundary"},{"text":"ஆகிய","lemma":"ākiya","gloss":"who became"}],"gloss":"who became the boundary"},{"surface":"வென்வேல்","parts":[{"text":"வென்வேல்","lemma":"வென்வேல்","gloss":"victorious spear"}],"gloss":"victorious spear","split_unverified":true},{"surface":"நெடுந்தகை","parts":[{"text":"நெடுந்தகை","lemma":"நெடுந்தகை","gloss":"great noble man"}],"gloss":"great noble man","split_unverified":true}]},{"words":[{"surface":"நடுகல்","parts":[{"text":"நடு","lemma":"naṭu","gloss":"erect"},{"text":"கல்","lemma":"kal","gloss":"stone"}],"gloss":"hero stone"},{"surface":"பிறங்கிய","parts":[{"text":"பிறங்கு","lemma":"piṟaṅku","gloss":"be prominent"},{"text":"இய","lemma":"iya","gloss":"adjectival suffix"}],"gloss":"prominent"},{"surface":"உவல்இடு","parts":[{"text":"உவல்","lemma":"uval","gloss":"brushwood"},{"text":"இடு","lemma":"iṭu","gloss":"place"}],"gloss":"covered with brushwood"},{"surface":"பறந்தலைப்","parts":[{"text":"பறந்தலை","lemma":"paṟantalai","gloss":"wasteland"},{"text":"ப்","lemma":"p","gloss":"sandhi increment"}],"gloss":"wasteland/battlefield"}]},{"words":[{"surface":"புன்காழ்","parts":[{"text":"புன்","lemma":"puṉ","gloss":"dry/poor"},{"text":"காழ்","lemma":"kāḻ","gloss":"seed/core"}],"gloss":"dry seed"},{"surface":"நெல்லி","parts":[{"text":"நெல்லி","lemma":"nelli","gloss":"gooseberry"}],"gloss":"gooseberry"},{"surface":"வன்புலச்","parts":[{"text":"வன்புலச்","lemma":"வன்புலச்","gloss":"hard/dry land"}],"gloss":"hard/dry land","split_unverified":true},{"surface":"சீறூர்க்","parts":[{"text":"சீறூர்க்","lemma":"சீறூர்க்","gloss":"small village"}],"gloss":"small village","split_unverified":true}]},{"words":[{"surface":"குடியும்","parts":[{"text":"குடி","lemma":"kuṭi","gloss":"clan"},{"text":"உம்","lemma":"um","gloss":"and"}],"gloss":"and the clan"},{"surface":"மன்னுந்","parts":[{"text":"மன்னுந்","lemma":"மன்னுந்","gloss":"indeed"}],"gloss":"indeed","split_unverified":true},{"surface":"தானே","parts":[{"text":"தான்","lemma":"tāṉ","gloss":"himself"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"he himself"},{"surface":"கொடியெடுத்து","parts":[{"text":"கொடி","lemma":"koṭi","gloss":"banner"},{"text":"எடுத்து","lemma":"eṭuttu","gloss":"raising"}],"gloss":"raising the banner"}]},{"words":[{"surface":"நிறையழிந்து","parts":[{"text":"நிறை","lemma":"niṟai","gloss":"discipline"},{"text":"அழிந்து","lemma":"aḻintu","gloss":"having broken"}],"gloss":"discipline having broken"},{"surface":"எழுதரு","parts":[{"text":"எழு","lemma":"eḻu","gloss":"rise"},{"text":"தரு","lemma":"taru","gloss":"auxiliary verb"}],"gloss":"rising up"},{"surface":"தானைக்குச்","parts":[{"text":"தானை","lemma":"tāṉai","gloss":"army"},{"text":"கு","lemma":"ku","gloss":"to"},{"text":"ச்","lemma":"c","gloss":"sandhi increment"}],"gloss":"to the army"}]},{"words":[{"surface":"சிறையும்","parts":[{"text":"சிறை","lemma":"ciṟai","gloss":"shield"},{"text":"உம்","lemma":"um","gloss":"also"}],"gloss":"and the shield"},{"surface":"தானே","parts":[{"text":"தானே","lemma":"தானே","gloss":"he himself"}],"gloss":"he himself","split_unverified":true},{"surface":"தன்","parts":[{"text":"தன்","lemma":"taṉ","gloss":"his"}],"gloss":"his"},{"surface":"இறைவிழு","parts":[{"text":"இறைவிழு","lemma":"இறைவிழு","gloss":"king's distress"}],"gloss":"king's distress","split_unverified":true},{"surface":"முறினே","parts":[{"text":"முறினே","lemma":"முறினே","gloss":"if [he] suffers"}],"gloss":"if [he] suffers","split_unverified":true}]}],"literal":"For the house, the husband who became the lamp, / For the battlefront, the great noble man of victorious spear who became the boundary, / In the wasteland covered with brushwood where hero stones are prominent, / In the small village of hard land with gooseberry of dry seeds, / He himself is indeed the clan, / To the army rising up with broken discipline, raising the banner, / He himself is also the shield, if his king suffers distress.","translation":"The husband who is the lamp of his home, the great noble man of victorious spear who is the protective boundary of the battlefront, lives in a small village in the dry, hard lands where gooseberry trees bear dry-seeded fruits, and where hero stones stand prominent in the brushwood-covered wasteland. He himself is the strength of his clan; and when the enemy army advances, raising their banners and breaking all order, he himself becomes the protective shield, if his king suffers distress.","modern":"வீட்டுக்கு விளக்காக விளங்கும் ஒளி பொருந்திய நெற்றியைக் கொண்டவளின் கணவன், போர்க்களத்திற்கு எல்லையாக விளங்கும் வெற்றி தரும் வேலை ஏந்திய பெருந்தகை ஆவான். நடுகற்கள் நிறைந்த, உலர் இலைகள் மூடிய போர்க்களத்தையும், உலர்ந்த விதைகளைக் கொண்ட நெல்லி மரங்கள் நிறைந்த வன்புலத்துச் சிற்றூரையும் சேர்ந்த அவனது குடிக்கு அவனே தலைவன் ஆவான். கொடிகளை ஏந்தி, ஒழுங்கு குலைந்து எதிர்த்து வரும் பகைப்படைக்கு எதிராக, தன் தலைவனுக்குத் துன்பம் நேரும்போது அவனே அரணாக விளங்குவான்.","explanation":"This poem belongs to the Vaakai tiṇai and the theme of Vallāṉ Mullai, which praises the valor of a warrior from a small, dry-land village. The poet, Aiyūr Muṭavaṉār, describes the hero as both a gentle husband at home and a fierce protector on the battlefield. His village is located in a harsh, arid landscape (vaṉpulam) marked by hero stones (naṭukal) and gooseberry trees (nelli). The poem emphasizes that the hero is the sole pillar of his clan and the ultimate shield (ciṟai) for his king (iṟai) when distress (viḦumam) strikes. Through these vivid images, the poet illustrates the warrior's dual nature of domestic tenderness and martial duty.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,1.0],[1.0,1.3],[1.3,1.9],[1.9,2.41],[2.58,3.6],[3.6,4.1],[4.1,4.2],[4.2,5.6],[5.6,5.8],[6.28,6.6],[6.6,7.1],[7.1,10.2],[10.2,10.2],[10.2,10.2],[10.2,10.2],[10.2,10.2],[10.2,10.2],[10.2,10.9],[10.9,11.5],[11.5,12.8],[12.8,13.31],[13.31,13.6],[13.6,14.4],[14.4,14.8],[14.8,15.1],[15.1,15.63],[15.63,15.9]],"female":[[0.0,0.7],[0.7,1.1],[1.1,1.5],[1.5,2.0],[2.0,2.6],[2.8,4.0],[4.0,4.6],[4.6,4.7],[4.7,6.2],[6.2,6.4],[6.4,7.49],[7.76,8.3],[8.3,8.7],[8.7,8.7],[8.7,8.7],[8.7,10.3],[10.3,10.43],[10.43,10.43],[10.43,10.43],[10.43,12.3],[12.3,13.6],[13.6,14.17],[14.17,14.5],[14.5,15.4],[15.4,15.8],[15.8,16.06],[16.31,16.6],[16.6,17.0]]}}