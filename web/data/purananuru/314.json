{"text":"purananuru","n":314,"lines":["மனைக்கு விளக்காகிய வாள்நுதல் கணவன்","முனைக்கு வரம்பாகிய வென்வேல் நெடுந்தகை","நடுகல் பிறங்கிய உவல்இடு பறந்தலைப்","புன்காழ் நெல்லி வன்புலச் சீறூர்க்","குடியும் மன்னுந் தானே கொடியெடுத்து","நிறையழிந்து எழுதரு தானைக்குச்","சிறையும் தானே_ தன் இறைவிழு முறினே"],"tr":["maṉaikku viḷakkākiya vāḷnutal kaṇavaṉ","muṉaikku varampākiya veṉvēl neṭuntakai","naṭukal piṟaṅkiya uvaliṭu paṟantalaip","puṉkāḻ nelli vaṉpulac cīṟūrk","kuṭiyum maṉṉun tāṉē koṭiyeṭuttu","niṟaiyaḻintu eḻutaru tāṉaikkuc","ciṟaiyum tāṉē taṉ iṟaiviḻu muṟiṉē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"வல்லான் முல்லை","poet_ta":"ஐயூர் முடவனார்","poet_tr":"Aiyūr Muṭavaṉār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"7×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 24, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 12, āciriyattaḷai 11, kalittaḷai 4"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மனைக்கு","tr":"maṉaikku","foot":"puḷimā","acai":[{"kind":"nirai","text":"மனைக்","tr":"maṉaik"},{"kind":"nēr","text":"கு","tr":"ku"}]},{"text":"விளக்காகி","tr":"viḷakkāki","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"விளக்","tr":"viḷak"},{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"கி","tr":"ki"}]},{"text":"யவாள்நுதல்","tr":"yavāḷnutal","foot":"karuviḷam","acai":[{"kind":"nirai","text":"யவாள்","tr":"yavāḷ"},{"kind":"nirai","text":"நுதல்","tr":"nutal"}]},{"text":"கணவன்","tr":"kaṇavaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கண","tr":"kaṇa"},{"kind":"nēr","text":"வன்","tr":"vaṉ"}]}],[{"text":"முனைக்கு","tr":"muṉaikku","foot":"puḷimā","acai":[{"kind":"nirai","text":"முனைக்","tr":"muṉaik"},{"kind":"nēr","text":"கு","tr":"ku"}]},{"text":"வரம்பா","tr":"varampā","foot":"puḷimā","acai":[{"kind":"nirai","text":"வரம்","tr":"varam"},{"kind":"nēr","text":"பா","tr":"pā"}]},{"text":"கியவென்வேல்"