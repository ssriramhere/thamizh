்","the subject of the song"]],[["திணை","poetic landscape"]],[["துறை","poetic theme"]],[["தெரிந்தில","are not known"]],[["கார்","rainy season"]],[["எதிர்","opposing"]],[["உருமின்","like thunder"]],[["உரறி","roaring"],["கல்லென","with a loud noise"]],[["கல்லென","with a loud noise"]],[["ஆருயிர்க்கு","to precious life"]],[["அலமரும்","causing to suffer"]],[["ஆராக்","insatiable"]],[["கூற்றம்","Death"]],[["நின்வரவு","your arrival"]],[["அஞ்சலன்","he fears not"]],[["மாதோ","indeed"]],[["நன்பல","many good things"]],[["கேள்வி","learning"]],[["முற்றிய","completed"]],[["வேள்வி","sacrificial"]],[["அந்தணர்க்கு","to Brahmins"]],[["அருங்கலம்","rare ornaments"]],[["நீரொடு","with water"]],[["சிதறிப்","scattering"]],[["பெருந்தகைத்","with great dignity"]],[["தாயின்நன்று","more kindly than a mother"]],[["பலர்க்கு","to many"]],[["ஈத்துத்","having given"]],[["தெருணடை","disciplined gait"]],[["மாகளிறொடு","with great male elephants"]],[["தன்","his"]],[["அருள்","grace"]],[["பாடுநர்க்கு","to those who sing"]],[["நன்கு","well"]],[["அருளியும்","and having bestowed"]],[["உருள்நடைப்","rolling movement"]],[["பஃறேர்","many chariots"]],[["ஒன்னார்க்","to enemies"]],[["கொன்றுதன்","having killed, his"]],[["தாள்","feet"]],[["சேருநர்க்கு","to those seeking refuge"]],[["இனிது","sweetly"]],[["ஈத்தும்","and having given"]],[["புரி","twisted"]],[["மாலையர்","garlanded ones"]],[["பாடினிக்குப்","to the songstress"]],[["பாடினிக்குப்","to the songstress"]],[["பொலந்","golden"]],[["தாமரைப்","lotus"]],[["பூம்","flower"]],[["பாணரொடு","with bards"]],[["கலந்","mingled"]],[["தளைஇய","embraced"]],[["நீள்","long"]],[["இருக்","dark"]],[["கையால்","with hands"]],[["பொறையடு","with patience"]],[["மலிந்த","filled"]],[["கற்பின்","of chastity"]],[["மான்நோக்கின்","of deer-like glance"]],[["வில்என","like a bow"]],[["விலங்கிய","curved"]],[["புருவத்து","of eyebrows"]],[["வல்லென","quickly"]],[["நல்கின்","if they speak"]],[["நாஅஞ்சும்","whose tongues fear"]],[["முள்எயிற்று","of thorn-like teeth"]],[["மகளிர்","women"]],[["அல்குல்","loins"]]