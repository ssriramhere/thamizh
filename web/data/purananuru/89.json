{"text":"purananuru","n":89,"lines":["இழை யணிப் பொலிந்த ஏந்துகோட் டல்குல்","மடவரல் உண்கண் வாள்நதல் விறலி","பொருநரும் உளரோ நும் அகன்றலை நாட்டு என","வினவல் ஆனாப் பொருபடை வேந்தே","எறிகோல் அஞ்சா அரவின் அன்ன","சிறுவன் மள்ளரும் உளரே அதாஅன்று","பொதுவில் தூங்கும் விசியுறு தண்ணுமை","வளி பொரு தெண்கண் கேட்பின்","அது போர் என்னும் என்னையும் உளனே"],"tr":["iḻai yaṇip polinta ēntukōṭ ṭalkul","maṭavaral uṇkaṇ vāḷnatal viṟali","porunarum uḷarō num akaṉṟalai nāṭṭu eṉa","viṉaval āṉāp porupaṭai vēntē","eṟikōl añcā araviṉ aṉṉa","ciṟuvaṉ maḷḷarum uḷarē atāaṉṟu","potuvil tūṅkum viciyuṟu taṇṇumai","vaḷi poru teṇkaṇ kēṭpiṉ","atu pōr eṉṉum eṉṉaiyum uḷaṉē"],"colophon":{"tinai":"tumpai","tinai_ta":"தும்பை","turai_ta":"தானை மறம்","poet_ta":"ஔவையார்","addressed_ta":"அதியமான் நெடுமான் அஞ்சி","poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"8×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 33, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 16, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இழையணிப்","tr":"iḻaiyaṇip","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இழை","tr":"iḻai"},{"kind":"nirai","text":"யணிப்","tr":"yaṇip"}]},{"text":"பொலிந்த","tr":"polinta","foot":"puḷimā","acai":[{"kind":"nirai","text":"பொலிந்","tr":"polin"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"வேந்துகோட்","tr":"vēntukōṭ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வேந்","tr":"vēn"},{"kind":"nirai","text":"துகோட்","tr":"tukōṭ"}]},{"text":"டல்குல்","tr":"ṭalkul","foot":"tēmā","acai":[{"kind":"nēr","text":"டல்","tr":"ṭal"},{"kind":"nēr","text":"குல்","tr":"kul"}]}],[{"text":"மடவர","tr":"maṭavara","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மட","tr":"maṭa"},{"kind":"nirai","text":"வர","tr":"vara"}]},{"text":"லுண்கண்","tr":"luṇkaṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"லுண்","tr":"luṇ"},{"kind"