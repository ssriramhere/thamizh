{"text":"purananuru","n":356,"lines":["களரி பரந்து கள்ளி போகிப்","பகலும் கூஉம் கூகையடு பிறழ்பல்","ஈம விளக்கின் பேஎய் மகளிரொடு","அஞ்சுவந் தன்று இம் மஞ்சுபடு முதுகாடு","நெஞ்சமர் காதலர் அழுத கண்ணீர்","என்புபடு சுடலை வெண்ணீறு அவிப்ப","எல்லார் புறனும் தான்கண்டு உலகத்து","மன்பதைக் கெல்லாம் தானாய்த்","தன்புறம் காண்போர்க் காண்புஅறி யாதே"],"tr":["kaḷari parantu kaḷḷi pōkip","pakalum kūum kūkaiyaṭu piṟaḻpal","īma viḷakkiṉ pēey makaḷiroṭu","añcuvan taṉṟu im mañcupaṭu mutukāṭu","neñcamar kātalar aḻuta kaṇṇīr","eṉpupaṭu cuṭalai veṇṇīṟu avippa","ellār puṟaṉum tāṉkaṇṭu ulakattu","maṉpataik kellām tāṉāyt","taṉpuṟam kāṇpōrk kāṇpuaṟi yātē"],"colophon":{"tinai":"kāñci","tinai_ta":"காஞ்சி","turai_ta":"பெருங்காஞ்சி","poet_ta":"தாயங்கண்ணனார்","poet_tr":"Tāyaṅkaṇṇaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"8×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 32, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 18, āciriyattaḷai 16"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"களரி","tr":"kaḷari","foot":"puḷimā","acai":[{"kind":"nirai","text":"கள","tr":"kaḷa"},{"kind":"nēr","text":"ரி","tr":"ri"}]},{"text":"பரந்து","tr":"parantu","foot":"puḷimā","acai":[{"kind":"nirai","text":"பரந்","tr":"paran"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"கள்ளி","tr":"kaḷḷi","foot":"tēmā","acai":[{"kind":"nēr","text":"கள்","tr":"kaḷ"},{"kind":"nēr","text":"ளி","tr":"ḷi"}]},{"text":"போகிப்","tr":"pōkip","foot":"tēmā","acai":[{"kind":"nēr","text":"போ","tr":"pō"},{"kind":"nēr","text":"கிப்","tr":"kip"}]}],[{"text":"பகலும்","tr":"pakalum","foot":"puḷimā","acai":[{"kind":"nirai","text":"பக","tr":"paka"},{"kind":"nēr","text":"லும்","tr":"lum"}]},{"text":"கூஉம்","tr":"kūum","foot":"tēmā","acai":[{"kind":"nēr","text":"கூ","tr":"kū"},{"kind":"nēr","text":"உம்","tr":"um"}]},{"text":"கூகை","tr":"kūkai","foot":"tēmā","acai":[{"kind":"nēr","text":"