{"text":"purananuru","n":164,"lines":["ஆடுநனி மறந்த கோடுஉயர் அடுப்பின்","ஆம்பி பூப்பத் தேம்புபசி உழவாப்","பாஅல் இன்மையின் தோலொடு திரங்கி","இல்லி தூர்த்த பொல்லா வறுமுலை","சுவைத்தொறும் அழூஉம்தன் மகத்துவம் நோக்கி","நீரொடு நிறைந்த ஈர்இதழ் மழைக்கண்என்","மனையோள் எவ்வம் நோக்கி நினைஇ","நிற்படர்ந் திசினே நற்போர்க் குமண","என்நிலை அறிந்தனை யாயின் இந்நிலைத்","தொடுத்தும் கொள்ளாது அமையலென் அடுக்கிய","பண்ணமை நரம்பின் பச்சை நல்யாழ்","மண்ணமை முழவின் வயிரியர்","இன்மை தீர்க்குங் குடிப்பிறந் தோயே"],"tr":["āṭunaṉi maṟanta kōṭuuyar aṭuppiṉ","āmpi pūppat tēmpupaci uḻavāp","pāal iṉmaiyiṉ tōloṭu tiraṅki","illi tūrtta pollā vaṟumulai","cuvaittoṟum aḻūumtaṉ makattuvam nōkki","nīroṭu niṟainta īritaḻ maḻaikkaṇeṉ","maṉaiyōḷ evvam nōkki niṉaii","niṟpaṭarn ticiṉē naṟpōrk kumaṇa","eṉnilai aṟintaṉai yāyiṉ innilait","toṭuttum koḷḷātu amaiyaleṉ aṭukkiya","paṇṇamai narampiṉ paccai nalyāḻ","maṇṇamai muḻaviṉ vayiriyar","iṉmai tīrkkuṅ kuṭippiṟan tōyē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"பரிசில் கடாநிலை","poet_ta":"பெருந்தலைச் சாத்தனார்","addressed_ta":"குமணன்","poet_tr":"Peruntalaic Cāttaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"13 lines"},{"name":"feet per line","ok":true,"detail":"12×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 49, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 35, veṇṭaḷai 13, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஆடுநனி","tr":"āṭunaṉi","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nirai","text":"டுந","tr":"ṭuna"},{"kind":"nēr","text":"னி","tr":"ṉi"}]},{"text":"மறந்த","tr":"maṟanta","foot":"puḷimā","acai":[{"kind":"nirai","text":"மறந்","tr":"maṟan"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"கோடுய","tr":"kōṭuya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கோ","tr":"kō"},{"kind":"nirai","text":"டுய","tr":"ṭuya"}]},{"text":"ரடுப்பி","tr":"raṭuppi","foot":"puḷimā","acai":[{"kind":"nir