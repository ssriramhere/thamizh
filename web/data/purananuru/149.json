[{"text":"நள்","lemma":"நள்","gloss":"dense/middle"},{"text":"என்","lemma":"என்","gloss":"say/like"}],"gloss":"dense/deep"}]},{"words":[{"surface":"மாலை","parts":[{"text":"மாலை","lemma":"மாலை","gloss":"evening"}],"gloss":"evening"},{"surface":"மருதம்","parts":[{"text":"மருதம்","lemma":"மருதம்","gloss":"Marutam raga"}],"gloss":"Marutam raga"},{"surface":"பண்ணி","parts":[{"text":"பண்","lemma":"பண்","gloss":"tune/play"},{"text":"இ","lemma":"இ","gloss":"having done (participle)"}],"gloss":"having tuned/played"},{"surface":"காலை","parts":[{"text":"காலை","lemma":"காலை","gloss":"morning"}],"gloss":"morning"}]},{"words":[{"surface":"கைவழி","parts":[{"text":"கை","lemma":"கை","gloss":"hand"},{"text":"வழி","lemma":"வழி","gloss":"way"}],"gloss":"by the hand's way"},{"surface":"மருங்கின்","parts":[{"text":"மருங்கு","lemma":"மருங்கு","gloss":"side/manner"},{"text":"இன்","lemma":"இன்","gloss":"locative suffix"}],"gloss":"on the side"},{"surface":"செவ்வழி","parts":[{"text":"செவ்வழி","lemma":"செவ்வழி","gloss":"Cevvazhi raga"}],"gloss":"Cevvazhi raga"},{"surface":"பண்ணி","parts":[{"text":"பண்","lemma":"பண்","gloss":"tune/play"},{"text":"இ","lemma":"இ","gloss":"having done (participle)"}],"gloss":"having tuned/played"}]},{"words":[{"surface":"வரவு","parts":[{"text":"வரவு","lemma":"வரவு","gloss":"coming/return"}],"gloss":"coming/return"},{"surface":"எமர்","parts":[{"text":"எமர்","lemma":"எமர்","gloss":"my people"}],"gloss":"my people"},{"surface":"மறந்தனர்","parts":[{"text":"மறந்தனர்","lemma":"மறந்தனர்","gloss":"they forgot"}],"gloss":"they forgot","split_unverified":true},{"surface":"அது","parts":[{"text":"அது","lemma":"அது","gloss":"that"}],"gloss":"that"},{"surface":"நீ","parts":[{"text":"நீ","lemma":"நீ","gloss":"you"}],"gloss":"you"}]},{"words":[{"surface":"புரவு","parts":[{"text":"புரவு","lemma":"புரவு","gloss":"patronage/giving"}],"gloss":"patronage"},{"surface":"கடன்","parts":[{"text":"கடன்","lemma":"கடன்","gloss":"duty"}],"gloss":"duty"},{"surface":"பூண்ட","parts":[{"text":"பூண்","lemma":"பூண்","gloss":"undertake/wear"},{"text":"ட","lemma":"அ","gloss":"relative participle suffix"}],"gloss":"who undertook"},{"surface":"வண்மையானே","parts":[{"text":"வண்மை","lemma":"வண்மை","gloss":"generosity"},{"text":"ஆன்","lemma":"ஆன்","gloss":"he who has"},{"text":"ஏ","lemma":"ஏ","gloss":"vocative/emphasis"}],"gloss":"O generous one"}]}],"literal":"Nalli! May you live long, Nalli! In the dense / evening, playing the Marutam raga, and in the morning, / through the hand's way, playing the Cevvazhi raga, / my people forgot to return. That is because of you, / O generous one who undertook the duty of patronage!","translation":"May you live long, Nalli, O Nalli! In the deep evening, my people played the morning raga Marutam, and in the morning, they played the evening raga Cevvaḻi on their strings. They have completely forgotten when to return home. This confusion is all because of you, O generous patron who has taken giving as your bounden duty!","modern":"நள்ளியே! நீ டூழி வாழ்க! நள்ளியே! அடர்ந்த மாலைப் பொழுதில் காலையில் பாட வேண்டிய மருதப் பண்ணை வாசித்தும், காலையில் மாலையில் பாட வேண்டிய செவ்வழிப் பண்ணை யாழின் வழியே வாசித்தும், என் சுற்றத்தாராகிய பாணர்கள் தம் இருப்பிடம் திரும்புவதை மறந்துவிட்டனர். கொடைத் தன்மையைக் கடமையாகக் கொண்ட வள்ளலே! இது உன்னுடைய வள்ளல் தன்மையால் நிகழ்ந்தது.","explanation":"The poet Vaṉparaṇar addresses the chieftain Kaṇṭīrakakōp Peru-naḷḷi in this praise poem. The poet describes how his troupe of bards has been so lavishly entertained and gifted by Nalli that they have lost all track of time. In their joyful confusion, they play the morning raga (Marutam) in the evening and the evening raga (Cevvaḻi) in the morning. This temporal disorientation beautifully symbolizes the timeless, ecstatic state of the artists under Nalli's patronage. The poem highlights the patron's immense generosity not by listing material gifts, but by showing how his hospitality has made the bards forget their homes.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,1.0],[1.0,1.38],[1.44,1.8],[1.8,2.04],[2.04,2.52],[2.52,3.0],[3.0,3.3],[3.3,3.86],[3.86,4.8],[4.8,5.5],[5.5,5.8],[5.8,6.66],[6.66,7.51],[7.51,7.8],[7.8,8.0],[8.0,9.3],[9.3,9.7],[9.7,10.0],[10.0,10.2]],"female":[[0.0,0.6],[0.6,1.1],[1.1,1.6],[1.6,1.9],[2.0,2.26],[2.26,2.78],[2.78,3.3],[3.3,3.6],[3.6,4.2],[4.2,5.2],[5.2,5.9],[5.9,6.2],[6.2,7.06],[7.06,7.91],[7.91,8.2],[8.2,8.5],[8.5,10.0],[10.0,10.69],[10.69,10.82],[10.82,11.1]]},"sync":[[["நள்ளி","Nalli"]],[["வாழியோ","may you live long"]],[["நள்ளி","Nalli"]],[["நள்ளென்","dense/deep"]],[["மாலை","evening"]],[["மருதம்","Marutam raga"]],[["பண்ணி","having tuned/played"],["காலை","morning"]],[["காலை","morning"]],[["கைவழி","by the hand's way"]],[["மருங்கின்","on the side"]],[["செவ்வழி","Cevvazhi raga"]],[["பண்ணி","having tuned/played"]],[["வரவு","coming/return"],["எமர்","my people"]],[["மறந்தனர்","they forgot"]],[["அது","that"]],[["நீ","you"]],[["புரவு","patronage"],["கடன்","duty"]],[["பூண்ட","who undertook"]],[["வண்மையானே","O generous one"]],[["வண்மையானே","O generous one"]]]}