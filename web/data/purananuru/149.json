{"text":"purananuru","n":149,"lines":["நள்ளி வாழியோ நள்ளி நள்ளென்","மாலை மருதம் பண்ணிக் காலைக்","கைவழி மருங்கிற் செவ்வழி பண்ணி","வரவுஎமர் மறந்தனர் அது நீ","புரவுக்கடன் பூண்ட வண்மை யானே"],"tr":["naḷḷi vāḻiyō naḷḷi naḷḷeṉ","mālai marutam paṇṇik kālaik","kaivaḻi maruṅkiṟ cevvaḻi paṇṇi","varavuemar maṟantaṉar atu nī","puravukkaṭaṉ pūṇṭa vaṇmai yāṉē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"பரிசில்","poet_ta":"வன்பரணர்","addressed_ta":"கண்டீரக் கோப் பெருநள்ளி","poet_tr":"Vaṉparaṇar"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"5×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 20"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நள்ளி","tr":"naḷḷi","foot":"tēmā","acai":[{"kind":"nēr","text":"நள்","tr":"naḷ"},{"kind":"nēr","text":"ளி","tr":"ḷi"}]},{"text":"வாழியோ","tr":"vāḻiyō","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nirai","text":"ழியோ","tr":"ḻiyō"}]},{"text":"நள்ளி","tr":"naḷḷi","foot":"tēmā","acai":[{"kind":"nēr","text":"நள்","tr":"naḷ"},{"kind":"nēr","text":"ளி","tr":"ḷi"}]},{"text":"நள்ளென்","tr":"naḷḷeṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"நள்","tr":"naḷ"},{"kind":"nēr","text":"ளென்","tr":"ḷeṉ"}]}],[{"text":"மாலை","tr":"mālai","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"மருதம்","tr":"marutam","foot":"puḷimā","acai":[{"kind":"nirai","text":"மரு","tr":"maru"},{"kind":"nēr","text":"தம்","tr":"tam"}]},{"text":"பண்ணிக்","tr":"paṇṇik","foot":"tēmā","acai":[{"kind":"nēr","text":"பண்","tr":"paṇ"},{"kind":"nēr","text":"ணிக்","tr":"ṇik"}]},{"text":"காலைக்","tr":"kālaik","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"லைக்","tr":"laik"}]}],[{"text":"கைவழி","tr":"kaivaḻi","foot":"kūviḷam","acai":[{"kind":"nēr