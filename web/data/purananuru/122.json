{"text":"purananuru","n":122,"lines":["கடல் கொளப் படாஅது உடலுநர் ஊக்கார்","கழல்புனை திருந்துஅடிக் காரி நின் நாடே","அழல் புறம் தரூஉம் அந்தணர் அதுவே","வீயாத் திருவின் விறல் கெழு தானை","மூவருள் ஒருவன் துப்பா கியர் என","ஏத்தினர் தரூஉங் கூழே நும்குடி","வாழ்த்தினர் வரூஉம் இரவலர் அதுவே","வடமீன் புரையுங் கற்பின் மடமொழி","அரிவை தோள் அளவு அல்லதை","நினது என இலைநீ பெருமிதத் தையே"],"tr":["kaṭal koḷap paṭāatu uṭalunar ūkkār","kaḻalpuṉai tiruntuaṭik kāri niṉ nāṭē","aḻal puṟam tarūum antaṇar atuvē","vīyāt tiruviṉ viṟal keḻu tāṉai","mūvaruḷ oruvaṉ tuppā kiyar eṉa","ēttiṉar tarūuṅ kūḻē numkuṭi","vāḻttiṉar varūum iravalar atuvē","vaṭamīṉ puraiyuṅ kaṟpiṉ maṭamoḻi","arivai tōḷ aḷavu allatai","niṉatu eṉa ilainī perumitat taiyē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"இயன் மொழி","poet_ta":"கபிலர்","addressed_ta":"மலையமான் திருமுடிக்காரி","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"10 lines"},{"name":"feet per line","ok":true,"detail":"9×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 39"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 20, veṇṭaḷai 18"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கடல்கொளப்","tr":"kaṭalkoḷap","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கடல்","tr":"kaṭal"},{"kind":"nirai","text":"கொளப்","tr":"koḷap"}]},{"text":"படாஅ","tr":"paṭāa","foot":"puḷimā","acai":[{"kind":"nirai","text":"படா","tr":"paṭā"},{"kind":"nēr","text":"அ","tr":"a"}]},{"text":"துடலுந","tr":"tuṭaluna","foot":"karuviḷam","acai":[{"kind":"nirai","text":"துட","tr":"tuṭa"},{"kind":"nirai","text":"லுந","tr":"luna"}]},{"text":"ரூக்கார்","tr":"rūkkār","foot":"tēmā","acai":[{"kind":"nēr","text":"ரூக்","tr":"rūk"},{"kind":"nēr","text":"கார்","tr":"kār"}]}],[{"text":"கழல்புனை","tr":"kaḻalpuṉai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கழல்","tr":"kaḻal"},{"kind":"nirai","text":"புனை","tr":"puṉai"}]},{"text":"திருந்தடிக்","tr":"tiruntaṭik","foo