{"text":"purananuru","n":131,"lines":["மழைக் கணஞ் சேக்கும் மாமலைக் கிழவன்","வழைப் பூங் கண்ணி வாய்வாள் அண்டிரன்","குன்றம் பாடின கொல்லோ","களிறு மிக உடைய இக் கவின் பெறு காடே"],"tr":["maḻaik kaṇañ cēkkum māmalaik kiḻavaṉ","vaḻaip pūṅ kaṇṇi vāyvāḷ aṇṭiraṉ","kuṉṟam pāṭiṉa kollō","kaḷiṟu mika uṭaiya ik kaviṉ peṟu kāṭē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"இயன் மொழி","poet_ta":"உறையூர் ஏணிச்சேரி முடமோசியார்","addressed_ta":"ஆய் அண்டிரன்","poet_tr":"Uṟaiyūr Ēṇiccēri Muṭamōciyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 14, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 7, veṇṭaḷai 6, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மழைக்கணஞ்","tr":"maḻaikkaṇañ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மழைக்","tr":"maḻaik"},{"kind":"nirai","text":"கணஞ்","tr":"kaṇañ"}]},{"text":"சேக்கும்","tr":"cēkkum","foot":"tēmā","acai":[{"kind":"nēr","text":"சேக்","tr":"cēk"},{"kind":"nēr","text":"கும்","tr":"kum"}]},{"text":"மாமலைக்","tr":"māmalaik","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"மலைக்","tr":"malaik"}]},{"text":"கிழவன்","tr":"kiḻavaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிழ","tr":"kiḻa"},{"kind":"nēr","text":"வன்","tr":"vaṉ"}]}],[{"text":"வழைப்பூங்","tr":"vaḻaippūṅ","foot":"puḷimā","acai":[{"kind":"nirai","text":"வழைப்","tr":"vaḻaip"},{"kind":"nēr","text":"பூங்","tr":"pūṅ"}]},{"text":"கண்ணி","tr":"kaṇṇi","foot":"tēmā","acai":[{"kind":"nēr","text":"கண்","tr":"kaṇ"},{"kind":"nēr","text":"ணி","tr":"ṇi"}]},{"text":"வாய்வா","tr":"vāyvā","foot":"tēmā","acai":[{"kind":"nēr","text":"வாய்","tr":"vāy"},{"kind":"nēr","text":"வா","tr":"vā"}]},{"text":"ளண்டிரன்","tr":"ḷaṇṭiraṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ளண்","tr":"ḷaṇ"},{"kind":"nirai","text":"டிரன்"