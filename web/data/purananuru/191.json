{"text":"purananuru","n":191,"lines":["யாண்டுபல வாக நரையில ஆகுதல்","யாங்கு ஆகியர் என வினவுதிர் ஆயின்","மாண்டஎன் மனைவியோடு மக்களும் நிரம்பினர்","யான்கண் டனையர்என் இளையரும் வேந்தனும்","அல்லவை செய்யான் காக்க அதன்தலை","ஆன்றுஅவிந்து அடங்கிய கொள்கைச்","சான்றோர் பலர் யான் வாழும் ஊரே"],"tr":["yāṇṭupala vāka naraiyila ākutal","yāṅku ākiyar eṉa viṉavutir āyiṉ","māṇṭaeṉ maṉaiviyōṭu makkaḷum nirampiṉar","yāṉkaṇ ṭaṉaiyareṉ iḷaiyarum vēntaṉum","allavai ceyyāṉ kākka ataṉtalai","āṉṟuavintu aṭaṅkiya koḷkaic","cāṉṟōr palar yāṉ vāḻum ūrē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"பொருண்மொழிக் காஞ்சி","poet_ta":"பிசிராந்தையர்","poet_tr":"Picirāntaiyar"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"7×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 14, āciriyattaḷai 13"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"யாண்டுப","tr":"yāṇṭupa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யாண்","tr":"yāṇ"},{"kind":"nirai","text":"டுப","tr":"ṭupa"}]},{"text":"லவாக","tr":"lavāka","foot":"puḷimā","acai":[{"kind":"nirai","text":"லவா","tr":"lavā"},{"kind":"nēr","text":"க","tr":"ka"}]},{"text":"நரையில","tr":"naraiyila","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நரை","tr":"narai"},{"kind":"nirai","text":"யில","tr":"yila"}]},{"text":"வாகுதல்","tr":"vākutal","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nirai","text":"குதல்","tr":"kutal"}]}],[{"text":"யாங்கா","tr":"yāṅkā","foot":"tēmā","acai":[{"kind":"nēr","text":"யாங்","tr":"yāṅ"},{"kind":"nēr","text":"கா","tr":"kā"}]},{"text":"கியரென","tr":"kiyareṉa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கிய","tr":"kiya"},{"kind":"nirai","text":"ரென","tr":"reṉa"}]},{"text":"வினவுதி","tr":"viṉavuti","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வின","tr":"viṉa"},{"kind":"nirai","text":"வ