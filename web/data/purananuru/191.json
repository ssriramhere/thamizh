ative suffix"}],"gloss":"you became so"},{"surface":"என","parts":[{"text":"என்","lemma":"எனல்","gloss":"to say"},{"text":"அ","lemma":"அ","gloss":"infinitive suffix"}],"gloss":"thus"},{"surface":"வினவுதிர்","parts":[{"text":"வினவு","lemma":"வினவுதல்","gloss":"to ask"},{"text":"திர்","lemma":"திர்","gloss":"second person plural suffix"}],"gloss":"you ask"},{"surface":"ஆயின்","parts":[{"text":"ஆயின்","lemma":"ஆயின்","gloss":"if"}],"gloss":"if"}]},{"words":[{"surface":"மாண்ட","parts":[{"text":"மாண்","lemma":"மாணுதல்","gloss":"to be virtuous"},{"text":"த","lemma":"த","gloss":"adjectival participle suffix"}],"gloss":"virtuous"},{"surface":"என்","parts":[{"text":"என்","lemma":"யான்","gloss":"my"}],"gloss":"my"},{"surface":"மனைவியோடு","parts":[{"text":"மனைவி","lemma":"மனைவி","gloss":"wife"},{"text":"ஓடு","lemma":"ஓடு","gloss":"sociative case suffix"}],"gloss":"along with my wife"},{"surface":"மக்களும்","parts":[{"text":"மக்கள்","lemma":"மக்கள்","gloss":"children"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and my children"},{"surface":"நிரம்பினர்","parts":[{"text":"நிரம்பு","lemma":"நிரம்புதல்","gloss":"to be mature"},{"text":"இன்","lemma":"இன்","gloss":"past tense"},{"text":"அர்","lemma":"அர்","gloss":"third person plural suffix"}],"gloss":"are mature in character"}]},{"words":[{"surface":"யான்","parts":[{"text":"யான்","lemma":"யான்","gloss":"I"}],"gloss":"I"},{"surface":"கண்டு","parts":[{"text":"கண்டு","lemma":"கண்டு","gloss":"having seen"}],"gloss":"having seen","split_unverified":true},{"surface":"அனையர்","parts":[{"text":"அனை","lemma":"அனையர்","gloss":"such as"},{"text":"அர்","lemma":"அர்","gloss":"third person plural suffix"}],"gloss":"are like that"},{"surface":"என்","parts":[{"text":"என்","lemma":"யான்","gloss":"my"}],"gloss":"my"},{"surface":"இளையரும்","parts":[{"text":"இளையர்","lemma":"இளையர்","gloss":"servants"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and my servants"},{"surface":"வேந்தனும்","parts":[{"text":"வேந்தன்","lemma":"வேந்தன்","gloss":"king"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and the king"}]},{"words":[{"surface":"அல்லவை","parts":[{"text":"அல்","lemma":"அல்லவை","gloss":"not"},{"text":"அவை","lemma":"அவை","gloss":"things"}],"gloss":"evil deeds"},{"surface":"செய்யான்","parts":[{"text":"செய்","lemma":"செய்தல்","gloss":"to do"},{"text":"ஆன்","lemma":"ஆன்","gloss":"negative third person singular masculine suffix"}],"gloss":"he does not do"},{"surface":"காக்க","parts":[{"text":"கா","lemma":"காத்தல்","gloss":"to protect"},{"text":"க்க","lemma":"க்க","gloss":"optative suffix"}],"gloss":"may he protect"},{"surface":"அதன்","parts":[{"text":"அது","lemma":"அது","gloss":"that"},{"text":"அன்","lemma":"அன்","gloss":"oblique suffix"}],"gloss":"of that"},{"surface":"தலை","parts":[{"text":"தலை","lemma":"தலை","gloss":"besides"}],"gloss":"besides"}]},{"words":[{"surface":"ஆன்று","parts":[{"text":"ஆன்று","lemma":"ஆன்று","gloss":"having matured"}],"gloss":"having matured"},{"surface":"அவிந்து","parts":[{"text":"அவிந்து","lemma":"அவிந்து","gloss":"having subdued desires"}],"gloss":"having subdued desires","split_unverified":true},{"surface":"அடங்கிய","parts":[{"text":"அடங்கு","lemma":"அடங்குதல்","gloss":"to be self-controlled"},{"text":"இய","lemma":"இய","gloss":"adjectival participle suffix"}],"gloss":"self-controlled"},{"surface":"கொள்கை","parts":[{"text":"கொள்","lemma":"கொள்கை","gloss":"to hold"},{"text":"கை","lemma":"கை","gloss":"noun suffix"}],"gloss":"principles"}]},{"words":[{"surface":"சான்றோர்","parts":[{"text":"சான்றோர்","lemma":"சான்றோர்","gloss":"noble people"}],"gloss":"noble people","split_unverified":true},{"surface":"பலர்","parts":[{"text":"பலர்","lemma":"பலர்","gloss":"many people"}],"gloss":"are many"},{"surface":"யான்","parts":[{"text":"யான்","lemma":"யான்","gloss":"I"}],"gloss":"I"},{"surface":"வாழும்","parts":[{"text":"வாழ்","lemma":"வாழ்தல்","gloss":"to live"},{"text":"உம்","lemma":"உம்","gloss":"adjectival participle suffix"}],"gloss":"living"},{"surface":"ஊரே","parts":[{"text":"ஊர்","lemma":"ஊர்","gloss":"town"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"in the town itself"}]}],"literal":"Years many becoming, gray hair not having, the state of becoming / how you became so, thus if you ask / excellent my wife along with, children also are mature / I having seen, are like that, my servants and the king / evil deeds he does not do, may he protect, besides / matured, subdued, self-controlled principles / noble people are many, I living town.","translation":"If you ask how it is that, though many years have passed, I have no gray hair: my virtuous wife and my children are full of good qualities; my servants act according to my wishes; and the king, doing no evil, protects us. Above all, in the town where I live, there are many noble people who are wise, calm, and self-controlled.","modern":"பல ஆண்டுகள் கடந்தும் எனக்கு நரைமுடி இல்லாமல் இருப்பது எப்படி என்று நீங்கள் கேட்டால்: மாண்புடைய என் மனைவியும் என் பிள்ளைகளும் அறிவு ஒழுக்கங்களில் சிறந்தவர்களாக இருக்கிறார்கள். என் ஏவலாளர்கள் என் எண்ணப்படியே நடக்கிறார்கள். நாட்டை ஆளும் மன்னனும் தீமைகளைச் செய்யாமல் எங்களைக் காக்கிறான். எல்லாவற்றிற்கும் மேலாக, நான் வாழும் ஊரில், பேரறிவும் அடக்கமும் கொண்ட சான்றோர்கள் பலர் வாழ்கிறார்கள்.","explanation":"The poet Picirāntaiyār is speaking to people who ask him the secret of his youthful appearance despite his advanced age. He explains that his lack of gray hair is due to the peaceful and virtuous environment he enjoys. His wife and children are excellent, his servants are loyal and share his thoughts, the king rules justly without doing evil, and his town is filled with wise, self-controlled, and noble people. This is a potuviyal (general) poem under the theme poruṇmoḻik kāñci (counsel on virtue and life). It highlights that peace of mind, which keeps one young, is a collective result of a harmonious family, a just ruler, and a virtuous society.","model":"gemini-3.5-flash"}}