a","gloss":"genitive suffix"}],"gloss":"your"},{"surface":"கண்ணியும்","parts":[{"text":"கண்ணி","lemma":"kaṇṇi","gloss":"chaplet"},{"text":"உம்","lemma":"um","gloss":"also"}],"gloss":"chaplet also"},{"surface":"ஆர்","parts":[{"text":"ஆர்","lemma":"ār","gloss":"Ātti flower"}],"gloss":"Ātti flower"},{"surface":"மிடைந்தன்றே","parts":[{"text":"மிடைந்து","lemma":"miṭaintu","gloss":"having closely woven"},{"text":"அன்று","lemma":"aṉṟu","gloss":"it is"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"is woven indeed"},{"surface":"நின்னொடு","parts":[{"text":"நின்","lemma":"niṉ","gloss":"you"},{"text":"ஒடு","lemma":"oṭu","gloss":"with"}],"gloss":"with you"}]},{"words":[{"surface":"பொருவோன்","parts":[{"text":"பொரு","lemma":"poru","gloss":"to fight"},{"text":"வ்","lemma":"v","gloss":"glide"},{"text":"ஓன்","lemma":"ōṉ","gloss":"he who"}],"gloss":"he who fights"},{"surface":"கண்ணியும்","parts":[{"text":"கண்ணி","lemma":"kaṇṇi","gloss":"chaplet"},{"text":"உம்","lemma":"um","gloss":"also"}],"gloss":"chaplet also"},{"surface":"ஆர்","parts":[{"text":"ஆர்","lemma":"ār","gloss":"Ātti flower"}],"gloss":"Ātti flower"},{"surface":"மிடைந்தன்றே","parts":[{"text":"மிடைந்து","lemma":"miṭaintu","gloss":"having closely woven"},{"text":"அன்று","lemma":"aṉṟu","gloss":"it is"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"is woven indeed"}]},{"words":[{"surface":"ஒருவீர்","parts":[{"text":"ஒரு","lemma":"oru","gloss":"one"},{"text":"வீர்","lemma":"vīr","gloss":"you (plural)"}],"gloss":"one of you"},{"surface":"தோற்பினும்","parts":[{"text":"தோல்","lemma":"tōl","gloss":"to lose"},{"text":"ப்","lemma":"p","gloss":"future"},{"text":"இன்","lemma":"iṉ","gloss":"if"},{"text":"உம்","lemma":"um","gloss":"even"}],"gloss":"even if defeated"},{"surface":"தோற்ப","parts":[{"text":"தோல்","lemma":"tōl","gloss":"to lose"},{"text":"ப்","lemma":"p","gloss":"future"},{"text":"அ","lemma":"a","gloss":"neuter plural"}],"gloss":"will lose"},{"surface":"நும்","parts":[{"text":"நும்","lemma":"num","gloss":"your"}],"gloss":"your"},{"surface":"குடியே","parts":[{"text":"குடி","lemma":"kuṭi","gloss":"lineage"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"lineage indeed"}]},{"words":[{"surface":"இருவீர்","parts":[{"text":"இரு","lemma":"iru","gloss":"two"},{"text":"வீர்","lemma":"vīr","gloss":"you (plural)"}],"gloss":"both of you"},{"surface":"வேறல்","parts":[{"text":"வேறல்","lemma":"வேறல்","gloss":"winning"}],"gloss":"winning","split_unverified":true},{"surface":"இயற்கையும்","parts":[{"text":"இயற்கை","lemma":"iyarkai","gloss":"nature"},{"text":"உம்","lemma":"um","gloss":"also"}],"gloss":"natural also"},{"surface":"அன்றே","parts":[{"text":"அன்றே","lemma":"அன்றே","gloss":"is not indeed"}],"gloss":"is not indeed","split_unverified":true},{"surface":"அதனால்","parts":[{"text":"அது","lemma":"atu","gloss":"that"},{"text":"அன்","lemma":"aṉ","gloss":"oblique"},{"text":"ஆல்","lemma":"āl","gloss":"by/therefore"}],"gloss":"therefore"}]},{"words":[{"surface":"குடிப்பொருள்","parts":[{"text":"குடி","lemma":"kuṭi","gloss":"lineage"},{"text":"பொருள்","lemma":"poruḷ","gloss":"fitting thing"}],"gloss":"fitting for the lineage"},{"surface":"அன்று","parts":[{"text":"அன்று","lemma":"அன்று","gloss":"is not"}],"gloss":"is not","split_unverified":true},{"surface":"நும்","parts":[{"text":"நும்","lemma":"num","gloss":"your"}],"gloss":"your"},{"surface":"செய்தி","parts":[{"text":"செய்தி","lemma":"செய்தி","gloss":"deed"}],"gloss":"deed","split_unverified":true},{"surface":"கொடித்தேர்","parts":[{"text":"கொடி","lemma":"koṭi","gloss":"banner"},{"text":"தேர்","lemma":"tēr","gloss":"chariot"}],"gloss":"banner-bearing chariot"}]},{"words":[{"surface":"நும்மோர்","parts":[{"text":"நும்","lemma":"num","gloss":"you"},{"text":"ஓர்","lemma":"ōr","gloss":"those like"}],"gloss":"those like you"},{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"aṉṉa","gloss":"like"}],"gloss":"like"},{"surface":"வேந்தர்க்கு","parts":[{"text":"வேந்தர்","lemma":"vēntar","gloss":"kings"},{"text":"க்கு","lemma":"kku","gloss":"to"}],"gloss":"to kings"}]},{"words":[{"surface":"மெய்ம்மலி","parts":[{"text":"மெய்ம்மலி","lemma":"மெய்ம்மலி","gloss":"body-swelling"}],"gloss":"body-swelling","split_unverified":true},{"surface":"உவகை","parts":[{"text":"உவகை","lemma":"uvakai","gloss":"joy"}],"gloss":"joy"},{"surface":"செய்யும்","parts":[{"text":"செய்","lemma":"cey","gloss":"to cause"},{"text":"உம்","lemma":"um","gloss":"will"}],"gloss":"will cause"},{"surface":"இவ்","parts":[{"text":"இவ்","lemma":"இவ்","gloss":"this"}],"gloss":"this","split_unverified":true},{"surface":"இகலே","parts":[{"text":"இகல்","lemma":"ikal","gloss":"feud"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"feud indeed"}]}],"literal":"He who wore the white leaf of the dark palmyra is not your foe / He who wore the garland of the dark-branched neem is not your foe / Your chaplet is woven with Ātti flowers, and with you / the chaplet of the one who fights is also woven with Ātti flowers / If one of you loses, it is your own lineage that loses / For both of you to win is not in the nature of things, therefore / your deed is not fitting for your lineage, O owners of banner-bearing chariots / To other kings who are like you / this feud will cause body-swelling joy!","translation":"Your opponent is not the Chera king who wears the white leaf of the dark palmyra palm. He is not the Pandya king who wears the garland of the dark-branched neem. Your own chaplet is woven of Ātti flowers, and the chaplet of the one who fights against you is also woven of Ātti flowers. If one of you is defeated, it is your own Chola lineage that suffers defeat. It is impossible for both of you to win. Therefore, this war you wage is not worthy of your noble house. O lords of banner-bearing chariots, this feud of yours will only bring immense, body-swelling joy to rival kings who watch you!","modern":"உன்னோடு போரிடுபவன் கரிய பனைமரத்தின் வெண்மையான குருத்தோலையைச் சூடிய சேர மன்னன் அல்லன். கரிய கிளைகளையுடைய வேப்பம்பூ மாலையை அணிந்த பாண்டிய மன்னனும் அல்லன். உன்னுடைய தலையில் சூடியுள்ள மாலையும் ஆத்திப் பூக்களால் தொடுக்கப்பட்டது; உன்னோடு போரிடும் மற்றொருவனுடைய மாலையும் ஆத்திப் பூக்களால் தொடுக்கப்பட்டதே ஆகும். உங்களில் ஒருவர் தோற்றாலும் தோற்பது உங்கள் சோழர் குடியே ஆகும். நீங்கள் இருவருமே வெற்றி பெறுவது என்பது இயற்கையில் இல்லாத ஒன்று. ஆகவே, கொடிகளையுடைய தேர்களைக் கொண்டவர்களே! நீங்கள் செய்யும் இச்செயல் உங்கள் குடிப்பெருமைக்கு ஏற்றது அன்று. உங்களைப் போன்ற பிற பகை அரசர்களுக்கு இந்த மோதல் உடலெங்கும் மகிழ்ச்சியைத் தரும் செயலாகவே முடியும்.","explanation":"In this poem, the poet Kovur Kilar acts as a mediator addressing the Chola princes Nalankilli and Netunkilli, who are engaged in a destructive civil war. He points out that neither of them is fighting their traditional rivals, the Cheras or the Pandyas, who are symbolized by the palmyra leaf and neem garland respectively. Instead, both princes wear the Atti garland, which is the emblem of their own Chola dynasty. The poet warns them that if either of them is defeated, it is their own lineage that suffers, and it is impossible for both to emerge victorious. Therefore, this fratricidal war is unworthy of their noble house and will only bring immense joy to their rival kings who watch them destroy themselves.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.8],[0.8,1.24],[1.24,1.8],[1.87,2.2],[2.2,3.1],[3.1,3.5],[3.5,4.0],[4.1,4.4],[4.4,4.78],[4.78,5.4],[5.53,6.2],[6.2,6.7],[6.7,7.4],[7.4,8.1],[8.1,8.7],[8.7,8.83],[8.97,9.37],[9.5,10.12],[10.12,10.9],[10.9,11.26],[11.4,12.1],[12.1,12.79],[12.79,13.7],[13.7,14.1],[14.1,14.89],[14.89,15.28],[15.28,15.81],[15.81,16.38],[16.38,16.66],[16.66,16.85],[16.85,17.13],[17.13,17.6],[18.64,18.91],[18.91,19.27],[19.27,20.0],[20.72,21.32],[21.32,21.52],[21.52,22.12],[22.12,22.32],[22.42,22.72]],"female":[[0.0,0.7],[0.7,1.23],[1.23,1.9],[1.9,2.3],[2.3,3.4],[3.4,3.8],[3.8,4.4],[4.48,4.9],[4.9,5.31],[5.31,6.0],[6.15,6.9],[6.9,7.5],[7.5,8.05],[8.05,8.6],[8.6,9.37],[9.37,10.14],[10.14,10.6],[10.6,11.13],[11.13,11.8],[11.8,12.16],[12.3,13.1],[13.1,13.49],[13.49,14.02],[14.02,14.41],[14.41,15.2],[15.2,15.8],[15.8,16.2],[16.2,17.8],[17.8,18.1],[18.1,18.43],[18.43,18.92],[18.92,19.74],[19.74,20.4],[20.4,20.7],[20.7,20.9],[22.08,22.78],[22.78,22.98],[22.98,23.68],[23.68,23.95],[24.08,24.48]]},"sync":[[["இரும்பனை","dark palmyra"]],[["வெண்தோடு","white palm leaf"]],[["மலைந்தோன்","he who wore"]],[["அல்லன்","he is not"]],[["கருஞ்சினை","dark-branched"]],[["வேம்பின்","of neem"]],[["தெரியலோன்","he who has a garland"]],[["அல்லன்","he is not"]],[["நின்ன","your"]],[["கண்ணியும்","chaplet also"]],[["ஆர்","Ātti flower"],["மிடைந்தன்றே","is woven indeed"]],[["மிடைந்தன்றே","is woven indeed"]],[["நின்னொடு","with you"]],[["பொருவோன்","he who fights"]],[["கண்ணியும்","chaplet also"]],[["ஆர்","Ātti flower"],["மிடைந்தன்றே","is woven indeed"]],[["மிடைந்தன்றே","is woven indeed"]],[["ஒருவீர்","one of you"]],[["தோற்பினும்","even if defeated"]],[["தோற்ப","will lose"]],[["நும்","your"]],[["குடியே","lineage indeed"]],[["இருவீர்","both of you"]],[["வேறல்","winning"]],[["இயற்கையும்","natural also"]],[["அன்றே","is not indeed"]],[["அதனால்","therefore"]],[["குடிப்பொருள்","fitting for the lineage"]],[["அன்று","is not"]],[["நும்","your"]],[["செய்தி","deed"]],[["கொடித்தேர்","banner-bearing chariot"]],[["நும்மோர்","those like you"]],[["அன்ன","like"]],[["வேந்தர்க்கு","to kings"]],[["மெய்ம்மலி","body-swelling"]],[["உவகை","joy"]],[["செய்யும்","will cause"]],[["இவ்","this"]],[["இகலே","feud indeed"]]]}