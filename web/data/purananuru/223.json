ind":"nēr","text":"னட்","tr":"ṉaṭ"}]},{"text":"புடையார்","tr":"puṭaiyār","foot":"puḷimā","acai":[{"kind":"nirai","text":"புடை","tr":"puṭai"},{"kind":"nēr","text":"யார்","tr":"yār"}]},{"text":"தம்முழைச்","tr":"tammuḻaic","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தம்","tr":"tam"},{"kind":"nirai","text":"முழைச்","tr":"muḻaic"}]},{"text":"செலினே","tr":"celiṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"செலி","tr":"celi"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"பலர்க்கு","parts":[{"text":"பலர்","lemma":"palar","gloss":"many people"},{"text":"கு","lemma":"ku","gloss":"to"}],"gloss":"to many people"},{"surface":"நிழல்","parts":[{"text":"நிழல்","lemma":"niḻal","gloss":"shade/protection"}],"gloss":"shade/protection"},{"surface":"ஆகி","parts":[{"text":"ஆகி","lemma":"āku","gloss":"having become"}],"gloss":"having become"},{"surface":"உலகம்","parts":[{"text":"உலகம்","lemma":"ulakam","gloss":"world"}],"gloss":"the world"},{"surface":"மீக்கூறி","parts":[{"text":"மீ","lemma":"mī","gloss":"highly"},{"text":"கூறி","lemma":"kūṟu","gloss":"having praised"}],"gloss":"having praised highly"}]},{"words":[{"surface":"தலைப்போகன்மையின்","parts":[{"text":"தலைப்போகு","lemma":"talaippōku","gloss":"reaching the end of life"},{"text":"அன்மை","lemma":"aṉmai","gloss":"not being"},{"text":"இன்","lemma":"iṉ","gloss":"because of"}],"gloss":"because of not reaching the natural end of life"},{"surface":"சிறுவழி","parts":[{"text":"சிறு","lemma":"ciṟu","gloss":"narrow/small"},{"text":"வழி","lemma":"vaḻi","gloss":"path"}],"gloss":"in a narrow path"},{"surface":"மடங்கி","parts":[{"text":"மடங்கி","lemma":"maṭaṅku","gloss":"having shrunk/turned back"}],"gloss":"having shrunk"}]},{"words":[{"surface":"நிலைபெறு","parts":[{"text":"நிலை","lemma":"nilai","gloss":"permanence"},{"text":"பெறு","lemma":"peṟu","gloss":"obtain"}],"gloss":"obtaining permanence"},{"surface":"நடுகல்","parts":[{"text":"நடு","lemma":"naṭu","gloss":"erect"},{"text":"கல்","lemma":"kal","gloss":"stone"}],"gloss":"hero stone"},{"surface":"ஆகியக்கண்ணும்","parts":[{"text":"ஆகிய","lemma":"āku","gloss":"having become"},{"text":"கண்","lemma":"kaṇ","gloss":"time/place"},{"text":"உம்","lemma":"um","gloss":"even"}],"gloss":"even when having become"}]},{"words":[{"surface":"இடங்கொடுத்து","parts":[{"text":"இடம்","lemma":"iṭam","gloss":"space"},{"text":"கொடுத்து","lemma":"koṭu","gloss":"having given"}],"gloss":"having given space"},{"surface":"அளிப்ப","parts":[{"text":"அளிப்ப","lemma":"aḷi","gloss":"they will bestow grace"}],"gloss":"they will bestow grace"},{"surface":"மன்ற","parts":[{"text":"மன்ற","lemma":"maṉṟa","gloss":"surely"}],"gloss":"surely"},{"surface":"உடம்போடு","parts":[{"text":"உடம்பு","lemma":"uṭampu","gloss":"body"},{"text":"ஓடு","lemma":"ōṭu","gloss":"with"}],"gloss":"with the body"}]},{"words":[{"surface":"இன்னுயிர்","parts":[{"text":"இன்","lemma":"iṉ","gloss":"sweet"},{"text":"உயிர்","lemma":"uyir","gloss":"life"}],"gloss":"sweet life"},{"surface":"விரும்பும்","parts":[{"text":"விரும்பும்","lemma":"virumpu","gloss":"desiring"}],"gloss":"desiring"},{"surface":"கிழமைத்","parts":[{"text":"கிழமை","lemma":"kiḻamai","gloss":"bond/relationship"},{"text":"த்","lemma":"t","gloss":"sandhi consonant"}],"gloss":"bond"}]},{"words":[{"surface":"தொன்னட்புடையார்","parts":[{"text":"தொல்","lemma":"tol","gloss":"ancient"},{"text":"நட்பு","lemma":"naṭpu","gloss":"friendship"},{"text":"உடையார்","lemma":"uṭaiyār","gloss":"those who have"}],"gloss":"those who have ancient friendship"},{"surface":"தம்உழைச்","parts":[{"text":"தம்","lemma":"tam","gloss":"their"},{"text":"உழை","lemma":"uḻai","gloss":"nearness"},{"text":"ச்","lemma":"c","gloss":"sandhi consonant"}],"gloss":"near them"},{"surface":"செலினே","parts":[{"text":"செலின்","lemma":"cel","gloss":"if one goes"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"if one goes indeed"}]}],"literal":"Having become a shade to many, the world praising highly, / because of not reaching the natural end of life, shrinking into a narrow path, / even when having become a permanent hero stone, / having given space, they will surely bestow grace, / with the body, the sweet life desiring, the bond of / those who have ancient friendship, if they go near them.","translation":"He who was a protective shade to many, highly praised by the world, did not live out his full span of life but shrank into a narrow path. Even though he has now become a permanent hero stone, he will surely make room and welcome me, if those with ancient friendship—a bond as close as that between the body and the sweet life that loves it—go near him.","modern":"பலருக்குப் புகலிடமாக விளங்கி, உலகத்தாரால் பெரிதும் புகழப்பட்டு, முழுமையான ஆயுளை அடையாமல் வடக்கிருந்து உயிர் துறந்து, நிலைபெற்ற நடுகல்லாக மாறிய பின்பும், உடம்போடு கூடிய இனிய உயிரைப் போன்ற நெருக்கமான பழைய நட்பினை உடையவர்கள் அவரிடம் சென்றால், அவர் நிச்சயம் இடம் கொடுத்து அருள் செய்வார்.","explanation":"This poem is spoken by the poet Pōttiyār, a close friend of the Chola king Kōpperuñcōḻaṉ. When the king decided to fast unto death (vaṭakkiruttal), Pōttiyār wanted to die with him, but the king asked him to wait until his child was born. After the birth of his child, Pōttiyār returned to the spot where the king was commemorated with a hero stone (naṭukal). The poet expresses his deep grief and absolute faith in their friendship, saying that even though the king is now just a stone, he will still make room for his friend. The poem beautifully compares ancient friendship (toṉṉaṭpu) to the inseparable bond between the body (uṭampu) and the sweet life (iṉṉuyir) that dwells within it. It highlights the immortality of true friendship, which transcends death itself.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,0.7],[0.7,1.1],[1.1,1.7],[1.7,2.38],[2.38,2.73],[2.73,3.8],[3.8,4.2],[4.2,4.3],[4.3,5.5],[5.5,5.6],[5.6,6.3],[6.3,6.7],[6.7,7.5],[7.5,7.9],[7.9,7.9],[7.9,8.6],[8.6,9.1],[9.1,9.9],[9.9,10.0],[10.0,10.7],[10.7,10.89],[10.89,12.0],[12.0,12.5],[12.5,12.9]],"female":[[0.0,0.7],[0.7,0.8],[0.8,1.2],[1.2,2.0],[2.2,2.6],[2.6,3.5],[3.65,4.4],[4.4,4.9],[4.9,5.0],[5.0,6.2],[6.2,6.3],[6.3,7.2],[7.2,7.5],[7.5,8.4],[8.4,8.8],[8.8,8.9],[8.9,9.6],[9.6,10.1],[10.1,11.0],[11.0,11.2],[11.2,11.9],[11.9,12.96],[12.96,13.3],[13.3,13.83],[13.83,14.1]]}}