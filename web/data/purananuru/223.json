{"text":"purananuru","n":223,"lines":["பலர்க்கு நிழ லாகி உலகம் மீக்கூறித்","தலைப்போ கன்மையிற் சிறுவழி மடங்கி","நிலைபெறு நடுகல் ஆகியக் கண்ணும்","இடங் கொடுத்து அளிப்ப மன்ற உடம்போடு","இன்னுயிர் விரும்பும் கிழமைத்","தொன்னட் புடையார் தம்உழைச் செலினே"],"tr":["palarkku niḻa lāki ulakam mīkkūṟit","talaippō kaṉmaiyiṟ ciṟuvaḻi maṭaṅki","nilaipeṟu naṭukal ākiyak kaṇṇum","iṭaṅ koṭuttu aḷippa maṉṟa uṭampōṭu","iṉṉuyir virumpum kiḻamait","toṉṉaṭ puṭaiyār tamuḻaic celiṉē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"கையறுநிலை","poet_ta":"பொத்தியார்","addressed_ta":"கோப்பெருஞ் சோழன்","poet_tr":"Pottiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"6×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 9, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பலர்க்கு","tr":"palarkku","foot":"puḷimā","acai":[{"kind":"nirai","text":"பலர்க்","tr":"palark"},{"kind":"nēr","text":"கு","tr":"ku"}]},{"text":"நிழலா","tr":"niḻalā","foot":"puḷimā","acai":[{"kind":"nirai","text":"நிழ","tr":"niḻa"},{"kind":"nēr","text":"லா","tr":"lā"}]},{"text":"கியுலகம்","tr":"kiyulakam","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கியு","tr":"kiyu"},{"kind":"nirai","text":"லகம்","tr":"lakam"}]},{"text":"மீக்கூறித்","tr":"mīkkūṟit","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"மீக்","tr":"mīk"},{"kind":"nēr","text":"கூ","tr":"kū"},{"kind":"nēr","text":"றித்","tr":"ṟit"}]}],[{"text":"தலைப்போ","tr":"talaippō","foot":"puḷimā","acai":[{"kind":"nirai","text":"தலைப்","tr":"talaip"},{"kind":"nēr","text":"போ","tr":"pō"}]},{"text":"கன்மையிற்","tr":"kaṉmaiyiṟ","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"கன்","tr":"kaṉ"},{"kind":"nēr","text":"மை","tr":"mai"},{"kind":"nēr","text":"யிற்","tr":"yiṟ"}]},{"text":"சிறுவழி","tr":"ciṟuvaḻi","foot":"karuviḷam","aca