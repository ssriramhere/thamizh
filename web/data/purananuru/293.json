{"text":"purananuru","n":293,"lines":["நிறப்புடைக்கு ஒல்கா யானை மேலோன்","குறும்பர்க்கு எறியும் ஏவல் தண்ணுமை","நாண்உடை மாக்கட்கு இரங்கும் ஆயின்","எம்மினும் பேர்எழில் இழந்து வினை எனப்","பிறர்மனை புகுவள் கொல்லோ","அளியள் தானே பூவிலைப் பெண்டே"],"tr":["niṟappuṭaikku olkā yāṉai mēlōṉ","kuṟumparkku eṟiyum ēval taṇṇumai","nāṇuṭai mākkaṭku iraṅkum āyiṉ","emmiṉum pēreḻil iḻantu viṉai eṉap","piṟarmaṉai pukuvaḷ kollō","aḷiyaḷ tāṉē pūvilaip peṇṭē"],"colophon":{"tinai":"kāñci","tinai_ta":"காஞ்சி","turai_ta":"பூக்கோட் காஞ்சி","poet_ta":"நொச்சி நியமங்கிழார்","poet_tr":"Nocci Niyamaṅkiḻār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 10"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நிறப்புடைக்","tr":"niṟappuṭaik","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நிறப்","tr":"niṟap"},{"kind":"nirai","text":"புடைக்","tr":"puṭaik"}]},{"text":"கொல்கா","tr":"kolkā","foot":"tēmā","acai":[{"kind":"nēr","text":"கொல்","tr":"kol"},{"kind":"nēr","text":"கா","tr":"kā"}]},{"text":"யானை","tr":"yāṉai","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னை","tr":"ṉai"}]},{"text":"மேலோன்","tr":"mēlōṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"மே","tr":"mē"},{"kind":"nēr","text":"லோன்","tr":"lōṉ"}]}],[{"text":"குறும்பர்க்","tr":"kuṟumpark","foot":"puḷimā","acai":[{"kind":"nirai","text":"குறும்","tr":"kuṟum"},{"kind":"nēr","text":"பர்க்","tr":"park"}]},{"text":"கெறியு","tr":"keṟiyu","foot":"puḷimā","acai":[{"kind":"nirai","text":"கெறி","tr":"keṟi"},{"kind":"nēr","text":"யு","tr":"yu"}]},{"text":"மேவல்","tr":"mēval","foot":"tēmā","acai":[{"kind":"nēr","text":"மே","tr":"mē"},{"kind":"nēr","text":"வல்","tr":"val"}]},{"text":"தண்ணுமை","tr":"taṇṇumai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தண்","t