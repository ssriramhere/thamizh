{"text":"purananuru","n":59,"lines":["ஆரம் தாழ்ந்த அணிகிளிர் மார்பின்","தாள்தோய் தடக்கைத் தகைமாண் வழுதி","வல்லை மன்ற நீநயந் தளித்தல்","தேற்றாய் பெரும பொய்யே என்றும்","காய்சினம் தவிராது கடல்ஊர்பு எழுதரும்","ஞாயிறு அனையை நின் பகைவர்க்குத்","திங்கள் அனையை எம்ம னோர்க்கே"],"tr":["āram tāḻnta aṇikiḷir mārpiṉ","tāḷtōy taṭakkait takaimāṇ vaḻuti","vallai maṉṟa nīnayan taḷittal","tēṟṟāy peruma poyyē eṉṟum","kāyciṉam tavirātu kaṭalūrpu eḻutarum","ñāyiṟu aṉaiyai niṉ pakaivarkkut","tiṅkaḷ aṉaiyai emma ṉōrkkē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"பூவைநிலை","poet_ta":"மதுரைக் கூலவாணிகன் சீத்தலைச் சாத்தனார்","addressed_ta":"பாண்டியன் சித்திரமாடத்துத் துஞ்சிய நன்மாறன்","poet_tr":"Maturaik Kūlavāṇikaṉ Cīttalaic Cāttaṉār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"7×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 11"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஆரம்","tr":"āram","foot":"tēmā","acai":[{"kind":"nēr","text":"ஆ","tr":"ā"},{"kind":"nēr","text":"ரம்","tr":"ram"}]},{"text":"தாழ்ந்த","tr":"tāḻnta","foot":"tēmā","acai":[{"kind":"nēr","text":"தாழ்ந்","tr":"tāḻn"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"வணிகிளிர்","tr":"vaṇikiḷir","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வணி","tr":"vaṇi"},{"kind":"nirai","text":"கிளிர்","tr":"kiḷir"}]},{"text":"மார்பின்","tr":"mārpiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"மார்","tr":"mār"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]}],[{"text":"தாள்தோய்","tr":"tāḷtōy","foot":"tēmā","acai":[{"kind":"nēr","text":"தாள்","tr":"tāḷ"},{"kind":"nēr","text":"தோய்","tr":"tōy"}]},{"text":"தடக்கைத்","tr":"taṭakkait","foot":"puḷimā","acai":[{"kind":"nirai","text":"தடக்","tr":"taṭak"},{"kind":"nēr","text":"கைத்","tr":"kait"}]},{"text":"தகைமாண்","tr":"takaimāṇ","foot":"puḷimā","acai":[{"kind"