lemma":"நல்","gloss":"good"},{"text":"நாடு","lemma":"நாடு","gloss":"country"}],"gloss":"good country"}]},{"words":[{"surface":"முந்நூறு","parts":[{"text":"முந்நூறு","lemma":"முந்நூறு","gloss":"three hundred"}],"gloss":"three hundred"},{"surface":"ஊரும்","parts":[{"text":"ஊர்","lemma":"ஊர்","gloss":"village"},{"text":"உம்","lemma":"உம்","gloss":"all"}],"gloss":"all the villages"},{"surface":"பரிசிலர்","parts":[{"text":"பரிசிலர்","lemma":"பரிசிலர்","gloss":"bards"}],"gloss":"bards"},{"surface":"பெற்றனர்","parts":[{"text":"பெற்றனர்","lemma":"பெறு","gloss":"they received"}],"gloss":"they received"}]},{"words":[{"surface":"யாமும்","parts":[{"text":"யாம்","lemma":"யாம்","gloss":"we"},{"text":"உம்","lemma":"உம்","gloss":"also"}],"gloss":"we also"},{"surface":"பாரியும்","parts":[{"text":"பாரி","lemma":"பாரி","gloss":"Pari"},{"text":"உம்","lemma":"உம்","gloss":"also"}],"gloss":"and Pari"},{"surface":"உளமே","parts":[{"text":"உளம்","lemma":"உள்","gloss":"we exist"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"are here indeed"}]},{"words":[{"surface":"குன்றும்","parts":[{"text":"குன்று","lemma":"குன்று","gloss":"hill"},{"text":"உம்","lemma":"உம்","gloss":"also"}],"gloss":"the hill also"},{"surface":"உண்டு","parts":[{"text":"உண்டு","lemma":"உள்","gloss":"exists"}],"gloss":"is there"},{"surface":"நீர்","parts":[{"text":"நீர்","lemma":"நீர்","gloss":"you (plural)"}],"gloss":"you"},{"surface":"பாடினிர்","parts":[{"text":"பாடினிர்","lemma":"பாடினிர்","gloss":"having sung"}],"gloss":"having sung","split_unverified":true},{"surface":"செலினே","parts":[{"text":"செலின்","lemma":"செல்","gloss":"if go"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"if you go indeed"}]}],"literal":"Having conquered and destroying armies, all three of you having united / even though you fought, Parampu is difficult to capture! / Three hundred villages indeed has the cool Parampu, the good country; / all those three hundred villages, bards have received. / We and Pari are here indeed; / the hill also is there, if you go singing!","translation":"Even if all three of you, with your conquering and destructive armies, unite and wage war, Parampu is impossible to capture. The cool, fertile land of Parampu had three hundred villages; all three hundred villages have been given away to bards. Only we and Pari are left here now. But the hill is still here—if you go there singing as bards, you can have it!","modern":"வெற்றி பெற்றுப் பகைவரைக் கொல்லும் படைகளைக் கொண்ட மூவேந்தர்களே! நீங்கள் மூவரும் ஒன்று கூடிப் போர் செய்தாலும் பறம்பு மலையைக் கைப்பற்றுவது கடினம். குளிர்ந்த பறம்பு என்னும் நல்ல நாட்டில் முந்நூறு ஊர்கள் இருந்தன. அந்த முந்நூறு ஊர்களையும் இரவலர்கள் பரிசாகப் பெற்றுக்கொண்டனர். இப்போது நானும் பாரியும் மட்டுமே இங்கு இருக்கிறோம். குன்றும் எஞ்சியுள்ளது. நீங்கள் பாணர்களாகப் பாடிக்கொண்டு சென்றால், இந்த மலையையும் பெற்றுக்கொள்ளலாம்!","explanation":"The poet Kapilar addresses the three crowned kings of Tamilakam (Cera, Cola, and Pandya) who have jointly besieged the hill fortress of Vel Pari. He mockingly tells them that their massive armies cannot conquer Parampu hill by force. He explains that Pari has already given away all three hundred villages of his territory to bards and supplicants. Only Kapilar, Pari, and the hill itself remain. If the kings want the hill, they should lay down their weapons, take up musical instruments, and go to Pari as singing bards, and he will gladly give them the hill too. This poem of defiance highlights the boundless generosity of the chieftain Pari and the futility of military might against honor.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,0.7],[0.7,1.1],[1.1,1.2],[1.2,1.7],[1.7,2.9],[2.9,2.9],[2.9,3.6],[3.6,4.0],[4.0,4.4],[4.4,5.6],[5.6,6.07],[6.13,6.6],[6.6,7.0],[7.0,8.0],[8.0,8.2],[8.2,8.3],[8.3,8.8],[8.8,9.9],[9.9,10.1],[10.1,10.4],[10.4,11.7],[11.7,11.9],[11.9,12.1],[12.1,12.3],[12.3,12.8]],"female":[[0.0,0.6],[0.6,0.7],[0.7,1.3],[1.3,1.4],[1.4,1.8],[1.8,3.1],[3.1,3.2],[3.2,4.0],[4.0,4.5],[4.5,4.9],[4.9,6.3],[6.3,6.62],[6.7,7.2],[7.2,7.6],[7.6,9.1],[9.1,9.4],[9.4,9.5],[9.5,10.0],[10.0,11.3],[11.3,11.5],[11.5,11.8],[11.8,13.2],[13.2,13.4],[13.4,13.6],[13.6,13.9],[13.9,14.4]]},"sync":[[["கடந்து","having conquered"]],[["அடு","destroying"]],[["தானை","army"]],[["மூவிரும்","all three of you"]],[["கூடி","having united"]],[["உடன்றனிர்","you fought"]],[["ஆயினும்","even though"]],[["பறம்பு","Parampu hill"]],[["கொள்ற்கு","to capture"]],[["அரிதே","is difficult indeed"]],[["முந்நூறு","three hundred"]],[["ஊர்த்தே","has villages indeed"]],[["தண்பறம்பு","cool Parampu"]],[["நல்நாடு","good country"]],[["முந்நூறு","three hundred"]],[["ஊரும்","all the villages"]],[["பரிசிலர்","bards"]],[["பெற்றனர்","they received"]],[["யாமும்","we also"]],[["பாரியும்","and Pari"]],[["உளமே","are here indeed"]],[["குன்றும்","the hill also"]],[["உண்டு","is there"]],[["நீர்","you"]],[["பாடினிர்","having sung"]],[["செலினே","if you go indeed"]]]}