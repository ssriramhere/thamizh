{"text":"purananuru","n":179,"lines":["ஞாலம் மீமிசை வள்ளியோர் மாய்ந் தென","ஏலாது கவிழ்ந்தஎன் இரவல் மண்டை","மலர்ப்போர் யார் என வினவலின் மலைந்தோர்","விசிபிணி முரசமொடு மண்பல தந்த","திருவீழ் நுண்பூண் பாண்டியன் மறவன்","படை வேண்டுவழி வாள் உதவியும்","வினை வேண்டுவழி அறிவு உதவியும்","வேண்டுப வேண்டுப வேந்தன் தேஎத்து","அசைநுகம் படாஅ ஆண்தகை உள்ளத்துத்","தோலா நல்லிசை நாலை கிழவன்","பருந்துபசி தீர்க்கும் நற்போர்த்","திருந்துவேல் நாகற் கூறினர் பலரே"],"tr":["ñālam mīmicai vaḷḷiyōr māyn teṉa","ēlātu kaviḻntaeṉ iraval maṇṭai","malarppōr yār eṉa viṉavaliṉ malaintōr","vicipiṇi muracamoṭu maṇpala tanta","tiruvīḻ nuṇpūṇ pāṇṭiyaṉ maṟavaṉ","paṭai vēṇṭuvaḻi vāḷ utaviyum","viṉai vēṇṭuvaḻi aṟivu utaviyum","vēṇṭupa vēṇṭupa vēntaṉ tēettu","acainukam paṭāa āṇtakai uḷḷattut","tōlā nallicai nālai kiḻavaṉ","paruntupaci tīrkkum naṟpōrt","tiruntuvēl nākaṟ kūṟiṉar palarē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"வல்லாண் முல்லை","poet_ta":"வடநெடுந்தத்தனார்; வடம நெடுந்தத்தனார் எனவும், வடம நெடுந்தச்சனார் எனவும் பாடம்","addressed_ta":"நாலை கிழவன் நாகன்","poet_tr":"Vaṭaneṭuntattaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"12 lines"},{"name":"feet per line","ok":true,"detail":"11×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 45, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 25, āciriyattaḷai 20, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஞாலம்","tr":"ñālam","foot":"tēmā","acai":[{"kind":"nēr","text":"ஞா","tr":"ñā"},{"kind":"nēr","text":"லம்","tr":"lam"}]},{"text":"மீமிசை","tr":"mīmicai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மீ","tr":"mī"},{"kind":"nirai","text":"மிசை","tr":"micai"}]},{"text":"வள்ளியோர்","tr":"vaḷḷiyōr","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வள்","tr":"vaḷ"},{"kind":"nirai","text":"ளியோர்","tr":"ḷiyōr"}]},{"text":"மாய்ந்தென","tr":"māynteṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மாய்ந்","tr":"māyn"},{"kind":"nirai"