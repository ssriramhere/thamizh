ை","lemma":"முகை","gloss":"bud"},{"text":"வனப்பு","lemma":"வனப்பு","gloss":"beauty"}],"gloss":"beauty of the buds"},{"surface":"ஏந்திய","parts":[{"text":"ஏந்திய","lemma":"ஏந்து","gloss":"bearing"}],"gloss":"bearing"},{"surface":"முற்றா","parts":[{"text":"முற்றா","lemma":"முற்று","gloss":"immature"}],"gloss":"immature"},{"surface":"இளமுலைத்","parts":[{"text":"இள","lemma":"இளமை","gloss":"young"},{"text":"முலை","lemma":"முலை","gloss":"breast"},{"text":"த்","lemma":"த்","gloss":"increment"}],"gloss":"young breasts"}]},{"words":[{"surface":"தகைவளர்த்து","parts":[{"text":"தகை","lemma":"தகை","gloss":"grace"},{"text":"வளர்த்து","lemma":"வளர்ப்பி","gloss":"having nurtured"}],"gloss":"having nurtured with grace"},{"surface":"எடுத்த","parts":[{"text":"எடுத்த","lemma":"எடு","gloss":"raised"}],"gloss":"raised"},{"surface":"நகையடு","parts":[{"text":"நகை","lemma":"நகை","gloss":"smile"},{"text":"அடு","lemma":"ஒடு","gloss":"with"}],"gloss":"with a smile"}]},{"words":[{"surface":"பகைவளர்த்து","parts":[{"text":"பகை","lemma":"பகை","gloss":"enmity"},{"text":"வளர்த்து","lemma":"வளர்ப்பி","gloss":"having nurtured"}],"gloss":"having nurtured enmity"},{"surface":"இருந்த","parts":[{"text":"இருந்த","lemma":"இரு","gloss":"who was"}],"gloss":"who was"},{"surface":"இப்","parts":[{"text":"இ","lemma":"இ","gloss":"this"},{"text":"ப்","lemma":"ப்","gloss":"doubled consonant"}],"gloss":"this"},{"surface":"பண்புஇல்","parts":[{"text":"பண்பு","lemma":"பண்பு","gloss":"virtue"},{"text":"இல்","lemma":"இல்","gloss":"without"}],"gloss":"without virtue"},{"surface":"தாயே","parts":[{"text":"தாய்","lemma":"தாய்","gloss":"mother"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"mother indeed"}]}],"literal":"The desiring king is of fierce anger / The duties of giving her away, her father also does not do / Bearing on their shining faces thick-ringed tusks / the male elephants do not bind to the tutelary tree, and gathered / the warriors with shining spears have indeed shut their mouths / Even the musicians, not knowing how to stop, sound many instruments / Alas! Great distress has attained this highly guarded ancient town / He has no virtue surely, himself indeed, of the victorious mountain / where Kino trees blossom and Kongu buds / of beauty are borne like immature young breasts / who nurtured and raised her with a smile / but nurtured enmity, this mother without virtue!","translation":"The king who desires her is filled with fierce anger, and her father refuses to perform his duty of giving her away. The male elephants, bearing thick-ringed tusks on their shining faces, stand gathered without being bound to their tutelary trees. The warriors with gleaming spears have shut their mouths in grim silence. Even the musicians, not knowing how to stop, keep sounding their many instruments. Alas! A great distress has come upon this highly guarded ancient town. Surely, he has no virtue—the lord of the victorious mountain where Kino trees blossom—nor does this mother have any virtue, who raised her with a smile only to nurture a deadly enmity, she who has no goodness!","modern":"இவளை விரும்பிய அரசன் கடுமையான கோபத்தில் இருக்கிறான். இவளுடைய தந்தையோ தன் கடமையாகிய இவளை மணம் முடித்துக் கொடுப்பதைச் செய்ய மறுக்கிறான். ஒளிரும் முகத்தில் தடித்த வளையங்கள் போன்ற தந்தங்களைக் கொண்ட ஆண் யானைகள் காவல் மரத்தில் கட்டப்படாமல் நிற்கின்றன. ஒளிரும் வேலேந்திய வீரர்களும் வாய் திறவாமல் மௌனமாக இருக்கிறார்கள். வாத்தியக்காரர்களும் நிறுத்தத் தெரியாமல் பலவித இசைக் கருவிகளை ஒலித்துக் கொண்டிருக்கிறார்கள். அந்தோ! மிகுந்த பாதுகாப்புடைய இந்த பழமையான ஊர் பெரும் துயரத்தை அடைந்துள்ளது. வேங்கை மரங்கள் மலரும், கோங்கு மரத்தின் அரும்புகள் இளமுலைகள் போலத் தோன்றும் விறல் பொருந்திய மலைநாடன் அறநெறி இல்லாதவன். அவனோடு பகை வளர்த்து, தன் மகளைச் சிரிப்புடன் வளர்த்து இப்போது போருக்குக் காரணமான இவளது தாயும் நற்பண்பு இல்லாதவள் ஆவாள்.","explanation":"This poem belongs to the Kāñci tiṇai and the theme of Pāṟ pāṟ kāñci, which describes the impending doom of a town due to a conflict over a beautiful girl's hand in marriage. A powerful king desires the girl and threatens war, while her proud father refuses to give her away. The entire town is in a state of tense anticipation: the war elephants are unbound, the warriors are silently preparing for battle, and the musicians play on anxiously. The poet laments the fate of the ancient town, blaming both the mountain lord who demands her and the girl's mother who raised her with love but now fosters a destructive enmity. The imagery of the beautiful Kongu buds resembling the girl's young breasts highlights her youth and beauty, which have tragically become the cause of ruin.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,0.7],[0.7,1.58],[1.58,1.9],[1.9,2.31],[2.73,3.6],[3.6,4.0],[4.0,4.2],[4.2,5.57],[5.6,6.0],[6.0,6.0],[6.0,6.8],[6.8,8.0],[8.0,8.2],[8.2,8.6],[8.6,8.8],[8.8,9.7],[9.7,10.0],[10.0,10.8],[10.96,11.12],[11.29,12.1],[12.1,12.5],[12.5,12.7],[12.7,12.9],[12.9,14.22],[14.22,14.22],[14.22,15.1],[15.1,15.4],[15.4,15.7],[15.7,15.8],[15.8,16.56],[16.56,16.95],[17.14,17.52],[17.52,18.6],[19.32,19.82],[19.82,20.12],[20.12,20.32],[20.32,20.72],[20.72,22.42],[22.42,22.82],[22.82,23.33],[23.42,23.85],[23.85,24.45],[24.51,24.82],[24.82,25.32],[25.32,25.32],[25.32,25.32],[25.32,25.32],[25.32,27.62],[27.62,27.72]],"female":[[0.0,0.6],[0.6,0.8],[0.8,1.28],[1.28,1.52],[1.9,2.11],[2.54,3.6],[3.6,4.1],[4.1,4.3],[4.3,5.94],[6.0,6.4],[6.4,6.4],[6.4,7.3],[7.3,8.5],[8.5,8.7],[8.7,9.1],[9.1,9.5],[9.5,10.8],[10.8,11.1],[11.1,11.89],[12.0,12.3],[12.47,13.3],[13.3,13.7],[13.7,13.8],[13.8,14.0],[14.0,14.0],[14.0,15.28],[15.47,16.5],[16.5,16.8],[16.8,17.1],[17.1,17.3],[17.3,19.0],[19.0,19.0],[19.0,19.7],[19.7,20.4],[21.16,21.76],[21.76,22.06],[22.06,22.36],[22.36,22.76],[22.76,24.36],[24.43,24.56],[24.56,25.07],[25.16,25.51],[25.51,25.86],[25.86,26.76],[26.76,27.39],[27.39,27.61],[27.61,27.61],[27.61,28.04],[28.04,29.56],[29.56,29.96]]},"sync":[[["வேட்ட","desired"]],[["வேந்தனும்","and the king"]],[["வெஞ்சினத்தினனே","is indeed of fierce anger"]],[["வெஞ்ச