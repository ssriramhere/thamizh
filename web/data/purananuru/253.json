{"text":"purananuru","n":253,"lines":["என்திறத்து அவலம் கொள்ளல் இனியே","வல்வார் கண்ணி இளையர் திளைப்ப","நாகாஅல் என வந்த மாறே எழாநெல்","பைங்கழை பொதிகளைந்து அன்ன விளர்ப்பின்","வளைஇல் வறுங்கை ஓச்சிக்","கிளையுள் ஒய்வலோ கூறுநின் உரையே"],"tr":["eṉtiṟattu avalam koḷḷal iṉiyē","valvār kaṇṇi iḷaiyar tiḷaippa","nākāal eṉa vanta māṟē eḻānel","paiṅkaḻai potikaḷaintu aṉṉa viḷarppiṉ","vaḷaiil vaṟuṅkai ōccik","kiḷaiyuḷ oyvalō kūṟuniṉ uraiyē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"முதுபாலை","poet_ta":"குளம்பாதாயனார்","poet_tr":"Kuḷampātāyaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 11"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"என்திறத்","tr":"eṉtiṟat","foot":"kūviḷam","acai":[{"kind":"nēr","text":"என்","tr":"eṉ"},{"kind":"nirai","text":"திறத்","tr":"tiṟat"}]},{"text":"தவலம்","tr":"tavalam","foot":"puḷimā","acai":[{"kind":"nirai","text":"தவ","tr":"tava"},{"kind":"nēr","text":"லம்","tr":"lam"}]},{"text":"கொள்ள","tr":"koḷḷa","foot":"tēmā","acai":[{"kind":"nēr","text":"கொள்","tr":"koḷ"},{"kind":"nēr","text":"ள","tr":"ḷa"}]},{"text":"லினியே","tr":"liṉiyē","foot":"puḷimā","acai":[{"kind":"nirai","text":"லினி","tr":"liṉi"},{"kind":"nēr","text":"யே","tr":"yē"}]}],[{"text":"வல்வார்","tr":"valvār","foot":"tēmā","acai":[{"kind":"nēr","text":"வல்","tr":"val"},{"kind":"nēr","text":"வார்","tr":"vār"}]},{"text":"கண்ணி","tr":"kaṇṇi","foot":"tēmā","acai":[{"kind":"nēr","text":"கண்","tr":"kaṇ"},{"kind":"nēr","text":"ணி","tr":"ṇi"}]},{"text":"யிளையர்","tr":"yiḷaiyar","foot":"puḷimā","acai":[{"kind":"nirai","text":"யிளை","tr":"yiḷai"},{"kind":"nēr","text":"யர்","tr":"yar"}]},{"text":"திளைப்ப","tr":"tiḷaippa","foot":"puḷimā","acai":[{"kind":"nirai","text":"திளைப்","tr":"tiḷaip"},{"kind":"nēr","t