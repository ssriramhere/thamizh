{"text":"purananuru","n":101,"lines":["ஒருநாள் செல்லலம் இருநாட் செல்லலம்","பன்னாள் பயின்று பலரொடு செல்லினும்","தலைநாள் பொன்ற விருப்பினன் மாதோ","அணிபூண் அணிந்த யானை இயல்தேர்","அதியமான் பரிசில் பெறூஉங் காலம்","நீட்டினும் நீட்டா தாயினும் யானைதன்","கோட்டிடை வைத்த கவளம் போலக்","கையகத் தது அது பொய்யா காதே","அருந்தே மாந்த நெஞ்சம்","வருந்த வேண்டா வாழ்க அவன் தாளே"],"tr":["orunāḷ cellalam irunāṭ cellalam","paṉṉāḷ payiṉṟu palaroṭu celliṉum","talaināḷ poṉṟa viruppiṉaṉ mātō","aṇipūṇ aṇinta yāṉai iyaltēr","atiyamāṉ paricil peṟūuṅ kālam","nīṭṭiṉum nīṭṭā tāyiṉum yāṉaitaṉ","kōṭṭiṭai vaitta kavaḷam pōlak","kaiyakat tatu atu poyyā kātē","aruntē mānta neñcam","varunta vēṇṭā vāḻka avaṉ tāḷē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"பரிசில் கடா நிலை","poet_ta":"ஔவையார்,","addressed_ta":"அதியமான் நெடுமான் அஞ்சி","poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"10 lines"},{"name":"feet per line","ok":true,"detail":"9×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 37, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 20, āciriyattaḷai 18"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஒருநாள்","tr":"orunāḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"ஒரு","tr":"oru"},{"kind":"nēr","text":"நாள்","tr":"nāḷ"}]},{"text":"செல்லல","tr":"cellala","foot":"kūviḷam","acai":[{"kind":"nēr","text":"செல்","tr":"cel"},{"kind":"nirai","text":"லல","tr":"lala"}]},{"text":"மிருநாட்","tr":"mirunāṭ","foot":"puḷimā","acai":[{"kind":"nirai","text":"மிரு","tr":"miru"},{"kind":"nēr","text":"நாட்","tr":"nāṭ"}]},{"text":"செல்லலம்","tr":"cellalam","foot":"kūviḷam","acai":[{"kind":"nēr","text":"செல்","tr":"cel"},{"kind":"nirai","text":"லலம்","tr":"lalam"}]}],[{"text":"பன்னாள்","tr":"paṉṉāḷ","foot":"tēmā","acai":[{"kind":"nēr","text":"பன்","tr":"paṉ"},{"kind":"nēr","text":"னாள்","tr":"ṉāḷ"}]},{"text":"பயின்று","tr":"payiṉṟu","foot":"puḷimā","acai":[{"kind":"nirai","text":"