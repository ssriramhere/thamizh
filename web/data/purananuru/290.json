{"text":"purananuru","n":290,"lines":["இவற்குஈந்து உண்மதி கள்ளே சினப்போர்","இனக்களிற்று யானைஇயல்தேர்க் குருசில்","நுந்தை தந்தைக்கு இவன்தந்தை தந்தை","எடுத்துஎறி ஞாட்பின் இமையான் தச்சன்","அடுத்துஎறி குறட்டின் நின்று மாய்ந் தனனே","மறப்புகழ் நிறைந்த மைந்தினோன் இவனும்","உறைப்புழி ஓலை போல","மறைக்குவன் பெரும நிற் குறித்துவரு வேலே"],"tr":["ivaṟkuīntu uṇmati kaḷḷē ciṉappōr","iṉakkaḷiṟṟu yāṉaiiyaltērk kurucil","nuntai tantaikku ivaṉtantai tantai","eṭuttueṟi ñāṭpiṉ imaiyāṉ taccaṉ","aṭuttueṟi kuṟaṭṭiṉ niṉṟu māyn taṉaṉē","maṟappukaḻ niṟainta maintiṉōṉ ivaṉum","uṟaippuḻi ōlai pōla","maṟaikkuvaṉ peruma niṟ kuṟittuvaru vēlē"],"colophon":{"tinai":"karantai","tinai_ta":"கரந்தை","turai_ta":"குடிநிலையுரைத்தல்","poet_ta":"ஔவையார்","poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 15"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இவற்கீந்","tr":"ivaṟkīn","foot":"puḷimā","acai":[{"kind":"nirai","text":"இவற்","tr":"ivaṟ"},{"kind":"nēr","text":"கீந்","tr":"kīn"}]},{"text":"துண்மதி","tr":"tuṇmati","foot":"kūviḷam","acai":[{"kind":"nēr","text":"துண்","tr":"tuṇ"},{"kind":"nirai","text":"மதி","tr":"mati"}]},{"text":"கள்ளே","tr":"kaḷḷē","foot":"tēmā","acai":[{"kind":"nēr","text":"கள்","tr":"kaḷ"},{"kind":"nēr","text":"ளே","tr":"ḷē"}]},{"text":"சினப்போ","tr":"ciṉappō","foot":"puḷimā","acai":[{"kind":"nirai","text":"சினப்","tr":"ciṉap"},{"kind":"nēr","text":"போ","tr":"pō"}]}],[{"text":"ரினக்களிற்","tr":"riṉakkaḷiṟ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"ரினக்","tr":"riṉak"},{"kind":"nirai","text":"களிற்","tr":"kaḷiṟ"}]},{"text":"றுயானை","tr":"ṟuyāṉai","foot":"puḷimā","acai":[{"kind":"nirai","text":"றுயா","tr":"ṟuyā"},{"kind":"nēr","text":"னை","tr":"ṉai"}]},{"text":"இயல்தேர்க்","tr":"iyaltēr