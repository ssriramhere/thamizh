{"text":"purananuru","n":298,"lines":["எமக்கே கலங்கல் தருமே தானே","தேறல் உண்ணும் மன்னே நன்றும்","இன்னான் மன்ற வேந்தே இனியே","நேரார் ஆரெயில் முற்றி","வாய் மடித்து உரறி நீ முந்து என் னானே"],"tr":["emakkē kalaṅkal tarumē tāṉē","tēṟal uṇṇum maṉṉē naṉṟum","iṉṉāṉ maṉṟa vēntē iṉiyē","nērār āreyil muṟṟi","vāy maṭittu uraṟi nī muntu eṉ ṉāṉē"],"colophon":{},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 5"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"எமக்கே","tr":"emakkē","foot":"puḷimā","acai":[{"kind":"nirai","text":"எமக்","tr":"emak"},{"kind":"nēr","text":"கே","tr":"kē"}]},{"text":"கலங்கல்","tr":"kalaṅkal","foot":"puḷimā","acai":[{"kind":"nirai","text":"கலங்","tr":"kalaṅ"},{"kind":"nēr","text":"கல்","tr":"kal"}]},{"text":"தருமே","tr":"tarumē","foot":"puḷimā","acai":[{"kind":"nirai","text":"தரு","tr":"taru"},{"kind":"nēr","text":"மே","tr":"mē"}]},{"text":"தானே","tr":"tāṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}],[{"text":"தேற","tr":"tēṟa","foot":"tēmā","acai":[{"kind":"nēr","text":"தே","tr":"tē"},{"kind":"nēr","text":"ற","tr":"ṟa"}]},{"text":"லுண்ணும்","tr":"luṇṇum","foot":"tēmā","acai":[{"kind":"nēr","text":"லுண்","tr":"luṇ"},{"kind":"nēr","text":"ணும்","tr":"ṇum"}]},{"text":"மன்னே","tr":"maṉṉē","foot":"tēmā","acai":[{"kind":"nēr","text":"மன்","tr":"maṉ"},{"kind":"nēr","text":"னே","tr":"ṉē"}]},{"text":"நன்று","tr":"naṉṟu","foot":"tēmā","acai":[{"kind":"nēr","text":"நன்","tr":"naṉ"},{"kind":"nēr","text":"று","tr":"ṟu"}]}],[{"text":"மின்னான்","tr":"miṉṉāṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"மின்","tr":"miṉ"},{"kind":"nēr","text":"னான்","tr":"ṉāṉ"}]},{"text":"மன்ற","tr":"maṉṟa","foot":"tēmā","acai":[{"kind":"nēr","text":"மன்","tr":"maṉ"},{"k