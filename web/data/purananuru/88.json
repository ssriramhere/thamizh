{"text":"purananuru","n":88,"lines":["யாவிர் அயினும் கூழை தார்கொண்டு","யாம்பொருதும் என்றல் ஓம்புமின் ஓன்ங்குதிறல்","ஓளிறுஇலங்கு நெடுவேல் மழவர் பெருமகன்","கதிர்விடு நுண்பூண் அம்பகட்டு மார்பின்","விழ்வுத்தோள் என்னையைக் காணா ஊங்கே"],"tr":["yāvir ayiṉum kūḻai tārkoṇṭu","yāmporutum eṉṟal ōmpumiṉ ōṉṅkutiṟal","ōḷiṟuilaṅku neṭuvēl maḻavar perumakaṉ","katirviṭu nuṇpūṇ ampakaṭṭu mārpiṉ","viḻvuttōḷ eṉṉaiyaik kāṇā ūṅkē"],"colophon":{"tinai":"tumpai","tinai_ta":"தும்பை","turai_ta":"தானை மறம்","poet_ta":"ஔவையார்","addressed_ta":"அதியமான் நெடுமானஞ்சி","poet_tr":"Auvaiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"5×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 15, veṇcīr 5"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 8, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"யாவி","tr":"yāvi","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"வி","tr":"vi"}]},{"text":"ரயினும்","tr":"rayiṉum","foot":"puḷimā","acai":[{"kind":"nirai","text":"ரயி","tr":"rayi"},{"kind":"nēr","text":"னும்","tr":"ṉum"}]},{"text":"கூழை","tr":"kūḻai","foot":"tēmā","acai":[{"kind":"nēr","text":"கூ","tr":"kū"},{"kind":"nēr","text":"ழை","tr":"ḻai"}]},{"text":"தார்கொண்டு","tr":"tārkoṇṭu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"தார்","tr":"tār"},{"kind":"nēr","text":"கொண்","tr":"koṇ"},{"kind":"nēr","text":"டு","tr":"ṭu"}]}],[{"text":"யாம்பொரு","tr":"yāmporu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யாம்","tr":"yām"},{"kind":"nirai","text":"பொரு","tr":"poru"}]},{"text":"துமென்ற","tr":"tumeṉṟa","foot":"puḷimā","acai":[{"kind":"nirai","text":"துமென்","tr":"tumeṉ"},{"kind":"nēr","text":"ற","tr":"ṟa"}]},{"text":"லோம்புமி","tr":"lōmpumi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"லோம்","tr":"lōm"},{"kind":"nirai","text":"புமி","tr":"pumi"}]},{"text":"னோன்ங்குதிற","tr":"ṉōṉṅkutiṟa","foot"