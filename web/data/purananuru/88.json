":[{"words":[{"surface":"யாவிர்","parts":[{"text":"யாவிர்","lemma":"யாவர்","gloss":"whoever"}],"gloss":"whoever you are"},{"surface":"அயினும்","parts":[{"text":"அயினும்","lemma":"ஆயினும்","gloss":"even if"}],"gloss":"even if"},{"surface":"கூழை","parts":[{"text":"கூழை","lemma":"கூழை","gloss":"rear guard"}],"gloss":"rear guard"},{"surface":"தார்","parts":[{"text":"தார்","lemma":"தார்","gloss":"vanguard"}],"gloss":"vanguard"},{"surface":"கொண்டு","parts":[{"text":"கொண்டு","lemma":"கொள்","gloss":"having"}],"gloss":"having"}]},{"words":[{"surface":"யாம்","parts":[{"text":"யாம்","lemma":"யாம்","gloss":"we"}],"gloss":"we"},{"surface":"பொருதும்","parts":[{"text":"பொருதும்","lemma":"பொரு","gloss":"will fight"}],"gloss":"will fight"},{"surface":"என்றல்","parts":[{"text":"என்றல்","lemma":"என்","gloss":"saying"}],"gloss":"saying"},{"surface":"ஓம்புமின்","parts":[{"text":"ஓம்புமின்","lemma":"ஓம்பு","gloss":"avoid"}],"gloss":"avoid"},{"surface":"ஓன்ங்கு","parts":[{"text":"ஓன்ங்கு","lemma":"ஓங்கு","gloss":"lofty"}],"gloss":"lofty"},{"surface":"திறல்","parts":[{"text":"திறல்","lemma":"திறல்","gloss":"strength"}],"gloss":"strength"}]},{"words":[{"surface":"ஓளிறு","parts":[{"text":"ஓளிறு","lemma":"ஒளிறு","gloss":"shining"}],"gloss":"shining"},{"surface":"இலங்கு","parts":[{"text":"இலங்கு","lemma":"இலங்கு","gloss":"bright"}],"gloss":"bright"},{"surface":"நெடு","parts":[{"text":"நெடு","lemma":"நெடு","gloss":"long"}],"gloss":"long"},{"surface":"வேல்","parts":[{"text":"வேல்","lemma":"வேல்","gloss":"spear"}],"gloss":"spear"},{"surface":"மழவர்","parts":[{"text":"மழவர்","lemma":"மழவர்","gloss":"warriors"}],"gloss":"warriors"},{"surface":"பெருமகன்","parts":[{"text":"பெருமகன்","lemma":"பெருமகன்","gloss":"chief"}],"gloss":"chief"}]},{"words":[{"surface":"கதிர்","parts":[{"text":"கதிர்","lemma":"கதிர்","gloss":"rays"}],"gloss":"rays"},{"surface":"விடு","parts":[{"text":"விடு","lemma":"விடு","gloss":"emitting"}],"gloss":"emitting"},{"surface":"நுண்","parts":[{"text":"நுண்","lemma":"நுண்","gloss":"fine"}],"gloss":"fine"},{"surface":"பூண்","parts":[{"text":"பூண்","lemma":"பூண்","gloss":"ornaments"}],"gloss":"ornaments"},{"surface":"அம்","parts":[{"text":"அம்","lemma":"அம்","gloss":"beautiful"}],"gloss":"beautiful"},{"surface":"பகட்டு","parts":[{"text":"பகட்டு","lemma":"பகட்டு","gloss":"majestic"}],"gloss":"majestic"},{"surface":"மார்பின்","parts":[{"text":"மார்பின்","lemma":"மார்பு","gloss":"chest"}],"gloss":"of the chest"}]},{"words":[{"surface":"விழ்வு","parts":[{"text":"விழ்வு","lemma":"விழுப்பு","gloss":"excellent"}],"gloss":"excellent"},{"surface":"தோள்","parts":[{"text":"தோள்","lemma":"தோள்","gloss":"shoulders"}],"gloss":"shoulders"},{"surface":"என்னையை","parts":[{"text":"என்னையை","lemma":"என்-ஐ-ஐ","gloss":"my lord"}],"gloss":"my lord"},{"surface":"காணா","parts":[{"text":"காணா","lemma":"காண்","gloss":"see"}],"gloss":"before seeing"},{"surface":"ஊங்கே","parts":[{"text":"ஊங்கே","lemma":"ஊங்கு","gloss":"before"}],"gloss":"before"}]}],"literal":"Whoever you may be, taking the rear guard and the vanguard / avoid saying 'we will fight', [he of] lofty strength / the chief of the warriors with long spears that shine and glitter / with a majestic chest wearing fine ornaments that emit rays / before seeing my lord of excellent shoulders!","translation":"Whoever you may be, whether you lead the rear guard or the vanguard, avoid saying, 'We will fight!' before you have laid eyes upon my lord of excellent shoulders, the chief of the spear-wielding warriors of lofty strength, whose majestic chest is adorned with fine, radiant jewels.","modern":"நீங்கள் யாராக இருந்தாலும், உங்கள் பின்னணிப் படையையும் முன்னணிப் படையையும் கொண்டு, 'நாங்கள் போரிடுவோம்' என்று சொல்வதைத் தவிர்ங்கள். ஒளிர்கின்ற நீண்ட வேலை ஏந்திய மழவர் குலத் தலைவனும், கதிர்களை வீசும் நுட்பமான அணிகலன்களை அணிந்த அழகிய மார்பையும் சிறந்த தோள்களையும் உடையவனுமாகிய என் தலைவனைக் காண்பதற்கு முன்னே!","explanation":"The poet Avvaiyār is addressing the rival kings who are preparing to wage war against her patron, Atiyamāṉ Neṭumāṉ Añci. She warns them to refrain from boasting about their military strength, whether they lead the vanguard or the rear guard. She advises them that declaring 'we will fight' is a grave mistake before they have even seen her lord. Atiyamāṉ is described as the formidable chief of the Malavar warriors, possessing lofty strength and wielding shining spears. The sight of his majestic chest, adorned with radiant jewels, and his powerful shoulders would strike fear into any challenger, making them realize the futility of their boast.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.25],[0.32,0.7],[0.7,1.07],[1.2,1.6],[1.6,2.7],[2.7,3.3],[3.3,3.5],[3.5,4.7],[4.93,5.5],[5.5,6.4],[6.4,6.5],[6.5,7.2],[7.2,8.2],[8.2,8.4],[8.4,8.9],[8.9,9.6],[10.03,10.24],[10.46,11.1],[11.1,11.5],[11.5,11.6]],"female":[[0.0,0.33],[0.41,0.9],[0.9,1.22],[1.38,2.0],[2.0,3.4],[3.4,4.0],[4.0,4.2],[4.2,5.4],[5.64,6.9],[6.9,7.4],[7.4,7.7],[7.7,8.3],[8.3,9.4],[9.4,9.6],[9.6,10.1],[10.1,11.0],[11.51,11.77],[12.03,12.8],[12.8,13.2],[13.2,13.2]]},"sync":[[["யாவிர்","whoever you are"]],[["அயினும்","even if"]],[["கூழை","rear guard"]],[["தார்","vanguard"],["கொண்டு","having"]],[["யாம்","we"],["பொருதும்","will fight"]],[["என்றல்","saying"]],[["ஓம்புமின்","avoid"]],[["ஓன்ங்கு","lofty"],["திறல்","strength"]],[["ஓளிறு","shining"],["இலங்கு","bright"]],[["நெடு","long"],["வேல்","spear"]],[["மழவர்","warriors"]],[["பெருமகன்","chief"]],[["கதிர்","rays"],["விடு","emitting"]],[["நுண்","fine"],["பூண்","ornaments"]],[["அம்","beautiful"],["பகட்டு","majestic"]],[["மார்பின்","of the chest"]],[["விழ்வு","excellent"],["தோள்","shoulders"]],[["என்னையை","my lord"],["காணா","before seeing"]],[["காணா","before seeing"]],[["ஊங்கே","before"]]]}