 grain"}],"gloss":"drying grain"},{"surface":"செவ்வி","parts":[{"text":"செவ்வி","lemma":"cevvi","gloss":"perfect state/time"}],"gloss":"perfect state"},{"surface":"கொண்டு","parts":[{"text":"கொண்டு","lemma":"கொண்டு","gloss":"taking"}],"gloss":"taking","split_unverified":true},{"surface":"உடன்","parts":[{"text":"உடன்","lemma":"uṭaṉ","gloss":"together"}],"gloss":"together"}]},{"words":[{"surface":"வேனில்","parts":[{"text":"வேனில்","lemma":"vēṉil","gloss":"summer"}],"gloss":"summer"},{"surface":"கோங்கின்","parts":[{"text":"கோங்கு","lemma":"kōṅku","gloss":"Kongu tree"},{"text":"இன்","lemma":"iṉ","gloss":"genitive suffix"}],"gloss":"of the Kongu tree"},{"surface":"பூம்பொகுட்டு","parts":[{"text":"பூம்பொகுட்டு","lemma":"பூம்பொகுட்டு","gloss":"beautiful flower bud"}],"gloss":"beautiful flower bud","split_unverified":true},{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"aṉṉa","gloss":"like"}],"gloss":"like"}]},{"words":[{"surface":"குடந்தைஅம்","parts":[{"text":"குடந்தைஅம்","lemma":"குடந்தைஅம்","gloss":""}],"gloss":"","split_unverified":true},{"surface":"செவிய","parts":[{"text":"செவிய","lemma":"செவிய","gloss":""}],"gloss":"","split_unverified":true},{"surface":"கோட்டெலி","parts":[{"text":"கோட்டெலி","lemma":"கோட்டெலி","gloss":""}],"gloss":"","split_unverified":true},{"surface":"யாட்டக்","parts":[{"text":"யாட்டக்","lemma":"யாட்டக்","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"கலி","parts":[{"text":"கலி","lemma":"kali","gloss":"abundance"}],"gloss":"abundant"},{"surface":"ஆர்","parts":[{"text":"ஆர்","lemma":"ār","gloss":"full of"}],"gloss":"full of"},{"surface":"வரகின்","parts":[{"text":"வரகு","lemma":"varaku","gloss":"millet"},{"text":"இன்","lemma":"iṉ","gloss":"genitive suffix"}],"gloss":"of the millet"},{"surface":"பிறங்கு","parts":[{"text":"பிறங்கு","lemma":"piṟaṅku","gloss":"prominent/shining"}],"gloss":"prominent"},{"surface":"பீள்","parts":[{"text":"பீள்","lemma":"pīḷ","gloss":"ear of grain"}],"gloss":"ear of grain"},{"surface":"ஒளிக்கும்","parts":[{"text":"ஒளி","lemma":"oḷi","gloss":"hide"},{"text":"க்","lemma":"k","gloss":"future/present infix"},{"text":"உம்","lemma":"um","gloss":"adjectival participle suffix"}],"gloss":"hiding"}]},{"words":[{"surface":"வன்புல","parts":[{"text":"வன்புல","lemma":"வன்புல","gloss":""}],"gloss":"","split_unverified":true},{"surface":"வைப்பி","parts":[{"text":"வைப்பி","lemma":"வைப்பி","gloss":""}],"gloss":"","split_unverified":true},{"surface":"னதுவே_சென்று","parts":[{"text":"னதுவே_சென்று","lemma":"னதுவே_சென்று","gloss":""}],"gloss":"","split_unverified":true}],"as_printed":true},{"words":[{"surface":"தின்","parts":[{"text":"தின்","lemma":"tiṉ","gloss":"eat"}],"gloss":"eat"},{"surface":"பழம்","parts":[{"text":"பழம்","lemma":"paḻam","gloss":"fruit"}],"gloss":"fruit"},{"surface":"பசி","parts":[{"text":"பசி","lemma":"பசி","gloss":"hungry"}],"gloss":"hungry","split_unverified":true},{"surface":"…","parts":[{"text":"…","lemma":"…","gloss":"gap"}],"gloss":"…"},{"surface":"ன்னோ","parts":[{"text":"ன்னோ","lemma":"ṉṉō","gloss":"particle of exclamation"}],"gloss":"exclamation particle"},{"surface":"பாண","parts":[{"text":"பாண","lemma":"pāṇa","gloss":"oh bard"}],"gloss":"oh bard"}]},{"words":[{"surface":"வாள்வடு","parts":[{"text":"வாள்","lemma":"vāḷ","gloss":"sword"},{"text":"வடு","lemma":"vaṭu","gloss":"scar"}],"gloss":"sword scar"},{"surface":"விளங்கிய","parts":[{"text":"விளங்கு","lemma":"viḷaṅku","gloss":"shine/be conspicuous"},{"text":"இ","lemma":"i","gloss":"past tense infix"},{"text":"ய்","lemma":"y","gloss":"glide"},{"text":"அ","lemma":"a","gloss":"adjectival participle suffix"}],"gloss":"shining"},{"surface":"சென்னி","parts":[{"text":"சென்னி","lemma":"ceṉṉi","gloss":"head"}],"gloss":"head"}]},{"words":[{"surface":"செருவெம்","parts":[{"text":"செரு","lemma":"ceru","gloss":"battle"},{"text":"வெம்","lemma":"vem","gloss":"fierce/hot"}],"gloss":"battle-fierce"},{"surface":"குருசில்","parts":[{"text":"குருசில்","lemma":"kurucil","gloss":"lord/hero"}],"gloss":"lord"},{"surface":"ஓம்பும்","parts":[{"text":"ஓம்பு","lemma":"ōmpu","gloss":"protect"},{"text":"உம்","lemma":"um","gloss":"adjectival participle suffix"}],"gloss":"protecting"},{"surface":"ஊரே","parts":[{"text":"ஊர்","lemma":"ūr","gloss":"village"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"the village indeed"}]}],"literal":"Spotted-backed quail's fight-capable male / outer skin removed sweet-tasting white sesame / among winnowing fans drying perfect state taking together / summer Kongu's flower bud like / curved beautiful-eared crooked rats to chase / abundant millet's prominent ear of grain hiding / dry land settlement, that indeed, having gone / eating fruit, hungry ... oh bard! / sword-scars shining head / battle-fierce lord protects village indeed.","translation":"Oh bard! If you go to that dry-land settlement where the male quails with spotted backs, skilled in fighting, chase the crooked rats with curved, beautiful ears—which look like the summer buds of the Kongu tree—causing them to hide among the prominent ears of abundant millet drying on winnowing fans alongside sweet, white sesame peeled of its outer skin; that is the village protected by the battle-fierce lord whose head is illustrious with sword scars, where you can satisfy your hunger by eating fruits.","modern":"புள்ளிகளுடைய முதுகை உடைய, சண்டையிடுவதில் வல்ல ஆண் காடைகள், கோடைக்காலத்துக் கோங்க மரத்தின் அரும்புகளைப் போன்ற வளைந்த அழகிய காதுகளையும் வளைந்த வாலையும் உடைய எலிகளைத் துரத்துகின்றன. அந்த எலிகள், மேல் தோல் நீக்கப்பட்ட இனிமையான வெள்ளை எள்ளோடு முறங்களில் உலர வைக்கப்பட்டிருக்கும் செழிப்பான வரகுத் தினைக்கதிர்களுக்குள் ஓடி ஒளிகின்றன. அத்தகைய வன்புலத்து (முல்லை நிலத்து) ஊருக்கு நீ சென்றால், பழங்களை உண்டு உனது பசியைப் போக்கிக் கொள்ளலாம், பாணனே! வாள் வடுக்கள் விளங்கும் தலையை உடைய, போரை விரும்பும் தலைவன் பாதுகாக்கும் ஊர் அதுவே ஆகும்.","explanation":"This poem is addressed to a wandering bard (pāṇāṉ) by a poet, directing him to the village of a generous warrior-chief. It belongs to the Vākai tiṇai and Vallāṇ mullai tuṟai, which praises the strength and hospitality of a warrior in a dry, rugged forest region. The poet describes a lively scene in the dry-land settlement where fighting male quails chase crooked-tailed rats into the drying millet and sesame on winnowing fans. The rats' curved ears are compared to the summer buds of the Kongu tree, showing the poet's keen observation of nature. This village, though situated in a harsh terrain, is rich in food and is protected by a fierce chief whose head is covered in glorious sword scars.","model":"gemini-3.5-flash"}}