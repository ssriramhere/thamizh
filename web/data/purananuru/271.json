fied":true},{"surface":"இனியே","parts":[{"text":"இனி","lemma":"இனி","gloss":"now"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"now indeed"}]},{"words":[{"surface":"வெருவரு","parts":[{"text":"வெரு","lemma":"வெரு","gloss":"fear"},{"text":"வரு","lemma":"வரு","gloss":"come"}],"gloss":"frightening"},{"surface":"குருதியடு","parts":[{"text":"குருதி","lemma":"குருதி","gloss":"blood"},{"text":"அடு","lemma":"ஒடு","gloss":"with"}],"gloss":"with blood"},{"surface":"மயங்கி","parts":[{"text":"மயங்கு","lemma":"மயங்கு","gloss":"mingle"},{"text":"இ","lemma":"இ","gloss":"verbal participle suffix"}],"gloss":"mingled"},{"surface":"உருவுகரந்து","parts":[{"text":"உருவு","lemma":"உருவம்","gloss":"form"},{"text":"கரந்து","lemma":"கர","gloss":"hiding"}],"gloss":"its form hidden"}]},{"words":[{"surface":"ஒறுவாய்ப்பட்ட","parts":[{"text":"ஒறுவாய்","lemma":"ஒறுவாய்","gloss":"chipped edge"},{"text":"பட்ட","lemma":"படு","gloss":"suffered"}],"gloss":"chipped"},{"surface":"தெரியல்","parts":[{"text":"தெரியல்","lemma":"தெரியல்","gloss":"garland"}],"gloss":"garland"},{"surface":"ஊன்","parts":[{"text":"ஊன்","lemma":"ஊன்","gloss":"flesh"}],"gloss":"flesh"},{"surface":"செத்து","parts":[{"text":"செத்து","lemma":"செகு","gloss":"mistaking"}],"gloss":"mistaking"}]},{"words":[{"surface":"பருந்து","parts":[{"text":"பருந்து","lemma":"பருந்து","gloss":"kite"}],"gloss":"kite"},{"surface":"கொண்டு","parts":[{"text":"கொண்டு","lemma":"கொண்டு","gloss":"taking"}],"gloss":"taking","split_unverified":true},{"surface":"உகப்ப","parts":[{"text":"உகப்ப","lemma":"உக","gloss":"to soar"}],"gloss":"to soar"},{"surface":"யாம்","parts":[{"text":"யாம்","lemma":"யாம்","gloss":"we"}],"gloss":"we"},{"surface":"கண்டனம்","parts":[{"text":"கண்டனம்","lemma":"கண்டனம்","gloss":"we saw"}],"gloss":"we saw","split_unverified":true}]},{"words":[{"surface":"மறம்","parts":[{"text":"மறம்","lemma":"மறம்","gloss":"valor"}],"gloss":"valor"},{"surface":"புகல்","parts":[{"text":"புகல்","lemma":"புகல்","gloss":"desiring"}],"gloss":"desiring"},{"surface":"மைந்தன்","parts":[{"text":"மைந்தன்","lemma":"மைந்தன்","gloss":"warrior"}],"gloss":"warrior"},{"surface":"மலைந்த","parts":[{"text":"மலை","lemma":"மலை","gloss":"fight"},{"text":"ந்","lemma":"த்","gloss":"past tense infix"},{"text":"த்","lemma":"த்","gloss":"past tense infix"},{"text":"அ","lemma":"அ","gloss":"relative participle suffix"}],"gloss":"fought"},{"surface":"மாறே","parts":[{"text":"மாறு","lemma":"மாறு","gloss":"because"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"because of"}]}],"literal":"Water-drying not knowing, rooted in the ground, / dark-clustered nocci's eye-pleasing bright foliage, / we saw as a garland on the delicate, wide waist of women wearing soft jewels; now indeed, / mingled with frightening blood, its form hidden, / that chipped garland, mistaking it for flesh, / we saw a kite take and soar with, / because of the way the valor-desiring warrior fought!","translation":"We once saw the bright, eye-pleasing foliage of the dark-clustered nocci tree, which grows deep in the soil and never knows a lack of water, worn as a garland on the delicate, wide hips of women adorned with soft jewels. But now, because of the way the valor-loving warrior fought, we saw a kite seize that very garland—now chipped, stained with terrifying blood, and its true form hidden—and soar high into the sky, mistaking it for a piece of flesh.","modern":"வேர்கள் எப்போதும் நீரற்றுப் போகாதவாறு நிலத்தோடு பொருந்திய, கரிய பூங்கொத்துகளைக் கொண்ட நொச்சியின் அழகிய பிரகாசமான தழைகளை, மென்மையான அணிகலன்களை அணிந்த பெண்களின் மெல்லிய பரந்த அல்குலில் மாலையாகக் கண்டோம். ஆனால் இப்போது, வீரம் மிக்க அந்த வீரன் போரிட்ட தன்மையால், அச்சம் தரும் குருதியோடு கலந்து தன் வடிவம் மறைந்து, சிதைந்துபோன அந்த நொச்சி மாலையை, ஊன் என்று தவறாக நினைத்துப் பருந்து ஒன்று கவ்விக்கொண்டு மேலே பறந்து செல்வதை நாம் கண்டோம்.","explanation":"This poem belongs to the Nocci tiṇai, which traditionally depicts the defense of a fortress, and the theme is 'falling in battle' (ceruviṭai vīḻtal). The poet, Veṟi Pāṭiya Kāmaakkaṇṇiyār, contrasts the peaceful past of the nocci foliage with its tragic present on the battlefield. Formerly, the lush, green leaves of the nocci tree, which grows near water, were woven into beautiful garlands to adorn the hips of delicate women. Now, after a fierce battle, the brave warrior who wore the nocci garland as a defensive symbol lies dead. His garland is so drenched in blood and mutilated that a hovering kite mistakes it for raw flesh and flies away with it. This stark, gruesome image powerfully conveys the tragedy of war and the ultimate sacrifice of the young warrior.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,0.9],[0.9,1.5],[1.5,1.9],[1.9,3.0],[3.0,3.3],[3.3,3.6],[3.6,4.4],[4.4,5.4],[5.4,5.82],[5.82,5.9],[5.9,6.7],[6.7,7.5],[7.5,7.7],[7.7,8.4],[8.4,8.68],[8.73,8.79],[8.79,8.9],[8.9,10.7],[11.4,11.86],[11.86,12.2],[12.2,12.5],[12.5,12.6],[12.73,14.0],[14.0,14.6],[14.6,15.2],[15.2,15.63],[15.63,15.7],[15.7,17.1],[17.1,17.2],[17.2,17.6]],"female":[[0.0,0.8],[0.8,1.2],[1.2,1.9],[1.9,2.3],[2.3,3.6],[3.6,4.1],[4.1,4.3],[4.3,5.0],[5.44,5.88],[5.88,6.98],[6.98,6.98],[6.98,7.2],[7.2,8.6],[8.6,8.8],[8.8,9.6],[9.6,9.9],[9.9,9.9],[9.9,9.9],[9.9,12.0],[12.0,12.7],[12.7,13.9],[13.9,14.2],[14.2,14.4],[14.57,15.35],[15.5,16.4],[16.4,17.1],[17.1,17.6],[17.6,18.6],[18.6,19.1],[19.1,19.3],[19.3,19.6]]},"sync":[[["நீர்","water"],["அறவு","drying up"]],[["அறியா","not knowing"]],[["நிலமுதல்","ground-base"]],[["கலந்த","mingled"]],[["கருங்குரல்","dark cluster"]],[["நொச்சி","nocci"],["கண்ணார்","eye-pleasing"]],[["கண்ணார்","eye-pleasing"]],[["குரூஉத்தழை","bright foliage"]],[["மெல்","soft"],["இழை","jewels"]],[["மகளிர்","women"]],[["ஐது","delicate"],["அகல்","wide"]],[["அல்குல்","waist"]],[["தொடலை","garland"]],[["ஆகவும்","as"]],[["கண்டனம்","we saw"]],[["இனியே","now indeed"]],[["வெருவரு","frightening"]],[["குருதியடு","with blood"]],[["மயங்கி","mingled"]],[["உருவுகரந்து","its form hidden"]],[["ஒறுவாய்ப்பட்ட","chipped"]],[["ஒறுவாய்ப்பட்ட","chipped"]],[["தெரியல்","garland"]],[["ஊன்","flesh"],["செத்து","mistaking"]],[["பருந்து","kite"],["கொண்டு","taking"]],[["உகப்ப","to soar"],["யாம்","we"]],[["கண்டனம்","we saw"]],[["மறம்","valor"],["புகல்","desiring"]],[["மைந்தன்","warrior"]],[["மலைந்த","fought"]],[["மாறே","because of"]]]}