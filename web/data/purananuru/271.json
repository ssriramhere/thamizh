{"text":"purananuru","n":271,"lines":["நீரறவு அறியா நிலமுதற் கலந்த","கருங்குரல் நொச்சிக் கண்ணார் குரூஉத்தழை","மெல்இழை மகளிர் ஐதகல் அல்குல்","தொடலை ஆகவும் கண்டனம் இனியே","வெருவரு குருதியடு மயங்கி உருவுகரந்து","ஒறுவாய்ப் பட்ட தெரியல் ஊன்செத்துப்","பருந்துகொண்டு உகப்பயாம் கண்டனம்","மறம்புகல் மைந்தன் மலைந்த மாறே"],"tr":["nīraṟavu aṟiyā nilamutaṟ kalanta","karuṅkural noccik kaṇṇār kurūuttaḻai","meliḻai makaḷir aitakal alkul","toṭalai ākavum kaṇṭaṉam iṉiyē","veruvaru kurutiyaṭu mayaṅki uruvukarantu","oṟuvāyp paṭṭa teriyal ūṉcettup","paruntukoṇṭu ukappayām kaṇṭaṉam","maṟampukal maintaṉ malainta māṟē"],"colophon":{"tinai":"nocci","tinai_ta":"நொட்சி","turai_ta":"செருவிடை வீழ்தல்","poet_ta":"வெறி பாடிய காமக்கண்ணியார்","poet_tr":"Veṟi Pāṭiya Kāmakkaṇṇiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"8×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, vañcicīr 1, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 13, oṉṟā vañcittaḷai 1, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நீரற","tr":"nīraṟa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nirai","text":"ரற","tr":"raṟa"}]},{"text":"வுவறியா","tr":"vuvaṟiyā","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வுவ","tr":"vuva"},{"kind":"nirai","text":"றியா","tr":"ṟiyā"}]},{"text":"நிலமுதற்","tr":"nilamutaṟ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நில","tr":"nila"},{"kind":"nirai","text":"முதற்","tr":"mutaṟ"}]},{"text":"கலந்த","tr":"kalanta","foot":"puḷimā","acai":[{"kind":"nirai","text":"கலந்","tr":"kalan"},{"kind":"nēr","text":"த","tr":"ta"}]}],[{"text":"கருங்குரல்","tr":"karuṅkural","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கருங்","tr":"karuṅ"},{"kind":"nirai","text":"குரல்","tr":"kural"}]},{"text":"நொச்சிக்","tr":"noccik","foot":"tēmā","acai":[{"kind":"nēr","text":"நொச்","tr":"noc"},{