{"text":"purananuru","n":132,"lines":["முன்னுள்ளு வோனைப் பின்னுள்ளி னேனே","ஆழ்க என் உள்ளம் போழ்க என் நாவே","பாழ் ஊர்க் கிணற்றின் தூர்க என் செவியே","நரந்தை நறும்புல் மேய்ந்த கவரி","குவளைப் பைஞ்சுனை பருகி அயல","தகரத் தண்ணிழல் பிணையடு வதியும்","வடதிசை யதுவே வான்தோய் இமையம்","தென்திசை ஆஅய் குடி இன்றாயின்","பிறழ்வது மன்னோ இம் மலர்தலை உலகே"],"tr":["muṉṉuḷḷu vōṉaip piṉṉuḷḷi ṉēṉē","āḻka eṉ uḷḷam pōḻka eṉ nāvē","pāḻ ūrk kiṇaṟṟiṉ tūrka eṉ ceviyē","narantai naṟumpul mēynta kavari","kuvaḷaip paiñcuṉai paruki ayala","takarat taṇṇiḻal piṇaiyaṭu vatiyum","vaṭaticai yatuvē vāṉtōy imaiyam","teṉticai āay kuṭi iṉṟāyiṉ","piṟaḻvatu maṉṉō im malartalai ulakē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"இயன் மொழி","poet_ta":"உறையூர் ஏணிச்சேரி முடமோசியார்","addressed_ta":"ஆய் அண்டிரன்","poet_tr":"Uṟaiyūr Ēṇiccēri Muṭamōciyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"9×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 35, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 17, āciriyattaḷai 17, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"முன்னுள்","tr":"muṉṉuḷ","foot":"tēmā","acai":[{"kind":"nēr","text":"முன்","tr":"muṉ"},{"kind":"nēr","text":"னுள்","tr":"ṉuḷ"}]},{"text":"ளுவோனைப்","tr":"ḷuvōṉaip","foot":"puḷimā","acai":[{"kind":"nirai","text":"ளுவோ","tr":"ḷuvō"},{"kind":"nēr","text":"னைப்","tr":"ṉaip"}]},{"text":"பின்னுள்","tr":"piṉṉuḷ","foot":"tēmā","acai":[{"kind":"nēr","text":"பின்","tr":"piṉ"},{"kind":"nēr","text":"னுள்","tr":"ṉuḷ"}]},{"text":"ளினேனே","tr":"ḷiṉēṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"ளினே","tr":"ḷiṉē"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}],[{"text":"யாழ்கவென்","tr":"yāḻkaveṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யாழ்","tr":"yāḻ"},{"kind":"nirai","text":"கவென்","tr":"kaveṉ"}]},{"text":"னுள்ளம்","tr":"ṉuḷḷam","foot":"tēmā","acai":[{"kind":"nēr","text":"னு