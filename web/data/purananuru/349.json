{"text":"purananuru","n":349,"lines":["நுதிவேல் கொண்டு நுதல்வியர் தொடையாக்","கடிய கூறும் வேந்தே தந்தையும்","நெடிய அல்லது பணிந்துமொழி யலனே","இ·துஇவர் படிவம் ஆயின் வைஎயிற்று","அரிமதர் மழைக்கண் அம்மா அரிவை","மரம்படு சிறுதீப் போல","அணங்கா யினள் தான் பிறந்த ஊர்க்கே"],"tr":["nutivēl koṇṭu nutalviyar toṭaiyāk","kaṭiya kūṟum vēntē tantaiyum","neṭiya allatu paṇintumoḻi yalaṉē","ituivar paṭivam āyiṉ vaieyiṟṟu","arimatar maḻaikkaṇ ammā arivai","marampaṭu ciṟutīp pōla","aṇaṅkā yiṉaḷ tāṉ piṟanta ūrkkē"],"colophon":{"tinai":"kāñci","tinai_ta":"காஞ்சி","turai_ta":"மகட்பாற் காஞ்சி","poet_ta":"மதுரை மருதனிள நாகனார்","poet_tr":"Maturai Marutaṉiḷa Nākaṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 7, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நுதிவேல்","tr":"nutivēl","foot":"puḷimā","acai":[{"kind":"nirai","text":"நுதி","tr":"nuti"},{"kind":"nēr","text":"வேல்","tr":"vēl"}]},{"text":"கொண்டு","tr":"koṇṭu","foot":"tēmā","acai":[{"kind":"nēr","text":"கொண்","tr":"koṇ"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"நுதல்வியர்","tr":"nutalviyar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நுதல்","tr":"nutal"},{"kind":"nirai","text":"வியர்","tr":"viyar"}]},{"text":"தொடையாக்","tr":"toṭaiyāk","foot":"puḷimā","acai":[{"kind":"nirai","text":"தொடை","tr":"toṭai"},{"kind":"nēr","text":"யாக்","tr":"yāk"}]}],[{"text":"கடிய","tr":"kaṭiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"கடி","tr":"kaṭi"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"கூறும்","tr":"kūṟum","foot":"tēmā","acai":[{"kind":"nēr","text":"கூ","tr":"kū"},{"kind":"nēr","text":"றும்","tr":"ṟum"}]},{"text":"வேந்தே","tr":"vēntē","foot":"tēmā","acai":[{"kind":"nēr","text":"வேந்","tr":"vēn"},{"kind":"nēr","text":"தே","tr":"tē"