{"text":"purananuru","n":82,"lines":["சாறுதலைக் கொண்டெனப் பெண்ணீற்றுற்றெனப்","பட்ட மாரி ஞான்ற ஞாயிற்றுக்","கட்டில் நிணக்கும் இழிசினன் கையது","போழ்தூண்டு ஊசியின் விரைந்தன்று மாதோ","ஊர்கொள வந்த பொருநனொடு","ஆர்புனை தெரியல் நெடுந்தகை போரே"],"tr":["cāṟutalaik koṇṭeṉap peṇṇīṟṟuṟṟeṉap","paṭṭa māri ñāṉṟa ñāyiṟṟuk","kaṭṭil niṇakkum iḻiciṉaṉ kaiyatu","pōḻtūṇṭu ūciyiṉ viraintaṉṟu mātō","ūrkoḷa vanta porunaṉoṭu","ārpuṉai teriyal neṭuntakai pōrē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"அரசவாகை","poet_ta":"சாத்தந்தையார்","addressed_ta":"சோழன் போர்வைக்கோப் பெருநற்கிள்ளி","poet_tr":"Cāttantaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 14, āciriyattaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"சாறுதலைக்","tr":"cāṟutalaik","foot":"kūviḷaṅkāy","acai":[{"kind":"nēr","text":"சா","tr":"cā"},{"kind":"nirai","text":"றுத","tr":"ṟuta"},{"kind":"nēr","text":"லைக்","tr":"laik"}]},{"text":"கொண்டெனப்","tr":"koṇṭeṉap","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கொண்","tr":"koṇ"},{"kind":"nirai","text":"டெனப்","tr":"ṭeṉap"}]},{"text":"பெண்ணீற்","tr":"peṇṇīṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"பெண்","tr":"peṇ"},{"kind":"nēr","text":"ணீற்","tr":"ṇīṟ"}]},{"text":"றுற்றெனப்","tr":"ṟuṟṟeṉap","foot":"kūviḷam","acai":[{"kind":"nēr","text":"றுற்","tr":"ṟuṟ"},{"kind":"nirai","text":"றெனப்","tr":"ṟeṉap"}]}],[{"text":"பட்ட","tr":"paṭṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"பட்","tr":"paṭ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"மாரி","tr":"māri","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"ரி","tr":"ri"}]},{"text":"ஞான்றஞா","tr":"ñāṉṟañā","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஞான்","tr":"ñāṉ"},{"kind":"nirai","text":"றஞா","tr":"ṟañā"}]},{"text