{"text":"purananuru","n":251,"lines":["ஓவத் தன்ன இடனுடை வரைப்பிற்","பாவை அன்ன குறுந்தொடி மகளிர்","இழைநிலை நெகிழ்ந்த மள்ளற் கண்டிக்கும்","கழைக்கண் நெடுவரை அருவியாடிக்","கான யானை தந்த விறகின்","கடுந்தெறல் செந்தீ வேட்டுப்","புறம்தாழ் புரிசடை புலர்த்து வோனே"],"tr":["ōvat taṉṉa iṭaṉuṭai varaippiṟ","pāvai aṉṉa kuṟuntoṭi makaḷir","iḻainilai nekiḻnta maḷḷaṟ kaṇṭikkum","kaḻaikkaṇ neṭuvarai aruviyāṭik","kāṉa yāṉai tanta viṟakiṉ","kaṭunteṟal centī vēṭṭup","puṟamtāḻ puricaṭai pularttu vōṉē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"தாபத வாகை","poet_ta":"மாற்பித்தியார்","poet_tr":"Māṟpittiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 26, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 16, veṇṭaḷai 9, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஓவத்","tr":"ōvat","foot":"tēmā","acai":[{"kind":"nēr","text":"ஓ","tr":"ō"},{"kind":"nēr","text":"வத்","tr":"vat"}]},{"text":"தன்ன","tr":"taṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"தன்","tr":"taṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"விடனுடை","tr":"viṭaṉuṭai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"விட","tr":"viṭa"},{"kind":"nirai","text":"னுடை","tr":"ṉuṭai"}]},{"text":"வரைப்பிற்","tr":"varaippiṟ","foot":"puḷimā","acai":[{"kind":"nirai","text":"வரைப்","tr":"varaip"},{"kind":"nēr","text":"பிற்","tr":"piṟ"}]}],[{"text":"பாவை","tr":"pāvai","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"வை","tr":"vai"}]},{"text":"யன்ன","tr":"yaṉṉa","foot":"tēmā","acai":[{"kind":"nēr","text":"யன்","tr":"yaṉ"},{"kind":"nēr","text":"ன","tr":"ṉa"}]},{"text":"குறுந்தொடி","tr":"kuṟuntoṭi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குறுந்","tr":"kuṟun"},{"kind":"nirai","text":"தொடி","tr":"toṭi"}]},{"text":"மகளி","tr":"makaḷi","foot":"puḷimā","ac