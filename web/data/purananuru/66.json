{"text":"purananuru","n":66,"lines":["நளியிரு முந்நீர் நாவாய் ஓட்டி","வளிதொழில் ஆண்ட உரவோன் மருக","களி இயல் யானைக் கரிகால் வளவ","சென்று அமர்க் கடந்த நின் ஆற்றல் தோன்ற","வென்றோய் நின்னினும் நல்லன் அன்றே","கலிகொள் யாணர் வெண்ணிப் பறந்தலை","மிகப் புகழ் உலகம் எய்திப்","புறப்புண் நாணி வடக் கிருந்தோனே"],"tr":["naḷiyiru munnīr nāvāy ōṭṭi","vaḷitoḻil āṇṭa uravōṉ maruka","kaḷi iyal yāṉaik karikāl vaḷava","ceṉṟu amark kaṭanta niṉ āṟṟal tōṉṟa","veṉṟōy niṉṉiṉum nallaṉ aṉṟē","kalikoḷ yāṇar veṇṇip paṟantalai","mikap pukaḻ ulakam eytip","puṟappuṇ nāṇi vaṭak kiruntōṉē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"அரச வாகை","poet_ta":"வெண்ணிக் குயத்தியார்: வெண்ணிற் குயத்தியார் எனவும் பாடம்","addressed_ta":"சோழன் கரிகாற் பெருவளத்தான்","poet_tr":"Veṇṇik Kuyattiyār Veṇṇiṟ Kuyattiyār Eṉavum Pāṭam"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 31"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 16, āciriyattaḷai 14"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நளியிரு","tr":"naḷiyiru","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நளி","tr":"naḷi"},{"kind":"nirai","text":"யிரு","tr":"yiru"}]},{"text":"முந்நீர்","tr":"munnīr","foot":"tēmā","acai":[{"kind":"nēr","text":"முந்","tr":"mun"},{"kind":"nēr","text":"நீர்","tr":"nīr"}]},{"text":"நாவா","tr":"nāvā","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"வா","tr":"vā"}]},{"text":"யோட்டி","tr":"yōṭṭi","foot":"tēmā","acai":[{"kind":"nēr","text":"யோட்","tr":"yōṭ"},{"kind":"nēr","text":"டி","tr":"ṭi"}]}],[{"text":"வளிதொழி","tr":"vaḷitoḻi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"வளி","tr":"vaḷi"},{"kind":"nirai","text":"தொழி","tr":"toḻi"}]},{"text":"லாண்ட","tr":"lāṇṭa","foot":"tēmā","acai":[{"kind":"nēr","text":"லாண்","tr":"lāṇ"},{"kind":"nēr","text":"ட","tr":"ṭa"}]},{"text":"வுரவோன்",