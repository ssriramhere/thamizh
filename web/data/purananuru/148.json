{"text":"purananuru","n":148,"lines":["கறங்குமிசை அருவிய பிறங்குமலை நள்ளி நின்","அசைவுஇல் நோந்தாள் நசைவளன் ஏத்தி","நாடொறும் நன்கலம் கனிற்றொடு கொணர்ந்து","கூடுவிளங்கு வியன்நகர்ப் பரிசில் முற்று அளிப்பப்","பீடில் மன்னர்ப் புகழ்ச்சி வேண்டிச்","செய்யா கூறிக் கிளத்தல்","எய்யா தாகின்று எம் சிறு செந்நாவே"],"tr":["kaṟaṅkumicai aruviya piṟaṅkumalai naḷḷi niṉ","acaivuil nōntāḷ nacaivaḷaṉ ētti","nāṭoṟum naṉkalam kaṉiṟṟoṭu koṇarntu","kūṭuviḷaṅku viyaṉnakarp paricil muṟṟu aḷippap","pīṭil maṉṉarp pukaḻcci vēṇṭic","ceyyā kūṟik kiḷattal","eyyā tākiṉṟu em ciṟu cennāvē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"பரிசில்","poet_ta":"வன்பரணர்","addressed_ta":"கண்டீரக் கோப் பெருநள்ளி","poet_tr":"Vaṉparaṇar"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"1×5, 5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 24, veṇcīr 4"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 11, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"},{"name":"long lines","ok":true,"detail":"1 five-foot line (neṭilaṭi)"}],"ending":"ஏ","lines":[[{"text":"கறங்குமிசை","tr":"kaṟaṅkumicai","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"கறங்","tr":"kaṟaṅ"},{"kind":"nirai","text":"குமி","tr":"kumi"},{"kind":"nēr","text":"சை","tr":"cai"}]},{"text":"யருவிய","tr":"yaruviya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"யரு","tr":"yaru"},{"kind":"nirai","text":"விய","tr":"viya"}]},{"text":"பிறங்குமலை","tr":"piṟaṅkumalai","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"பிறங்","tr":"piṟaṅ"},{"kind":"nirai","text":"கும","tr":"kuma"},{"kind":"nēr","text":"லை","tr":"lai"}]},{"text":"நள்ளிநின்","tr":"naḷḷiniṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நள்","tr":"naḷ"},{"kind":"nirai","text":"ளிநின்","tr":"ḷiniṉ"}]}],[{"text":"னசைவுவில்","tr":"ṉacaivuvil","foot":"karuviḷam","acai":[{"kind":"nirai","text":"னசை","tr":"ṉacai"},{"kind":"nirai","text":"வுவில்","