","tr":"māṉ"}]},{"text":"தோன்றல்","tr":"tōṉṟal","foot":"tēmā","acai":[{"kind":"nēr","text":"தோன்","tr":"tōṉ"},{"kind":"nēr","text":"றல்","tr":"ṟal"}]}],[{"text":"வானேறு","tr":"vāṉēṟu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"னே","tr":"ṉē"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"புரையும்நின்","tr":"puraiyumniṉ","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"புரை","tr":"purai"},{"kind":"nēr","text":"யும்","tr":"yum"},{"kind":"nēr","text":"நின்","tr":"niṉ"}]},{"text":"தாள்நிழல்","tr":"tāḷniḻal","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தாள்","tr":"tāḷ"},{"kind":"nirai","text":"நிழல்","tr":"niḻal"}]},{"text":"வாழ்க்கைப்","tr":"vāḻkkaip","foot":"tēmā","acai":[{"kind":"nēr","text":"வாழ்க்","tr":"vāḻk"},{"kind":"nēr","text":"கைப்","tr":"kaip"}]}],[{"text":"பரிசிலர்","tr":"paricilar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பரி","tr":"pari"},{"kind":"nirai","text":"சிலர்","tr":"cilar"}]},{"text":"செல்வ","tr":"celva","foot":"tēmā","acai":[{"kind":"nēr","text":"செல்","tr":"cel"},{"kind":"nēr","text":"வ","tr":"va"}]},{"text":"மன்றியும்","tr":"maṉṟiyum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மன்","tr":"maṉ"},{"kind":"nirai","text":"றியும்","tr":"ṟiyum"}]},{"text":"விரிதார்க்","tr":"viritārk","foot":"puḷimā","acai":[{"kind":"nirai","text":"விரி","tr":"viri"},{"kind":"nēr","text":"தார்க்","tr":"tārk"}]}],[{"text":"கடும்ப","tr":"kaṭumpa","foot":"puḷimā","acai":[{"kind":"nirai","text":"கடும்","tr":"kaṭum"},{"kind":"nēr","text":"ப","tr":"pa"}]},{"text":"கட்டு","tr":"kaṭṭu","foot":"tēmā","acai":[{"kind":"nēr","text":"கட்","tr":"kaṭ"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"யானை","tr":"yāṉai","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னை","tr":"ṉai"}]},{"text":"வேந்த","tr":"vēnta","foot":"tēmā","acai":[{"kind":"nēr","text":"வேந்","tr":"vēn"},{"kind":"nēr","text":"த","tr":"ta"}]}],[{"text":"ரொடுங்க","tr":"roṭuṅka","foot":"puḷimā","acai":[{"kind":"nirai","text":