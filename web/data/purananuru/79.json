{"text":"purananuru","n":79,"lines":["மூதூர் வாயில் பனிக் கயம் மண்ணி","மன்ற வேம்பின் ஒண்குழை மிலைந்து","தெண்கிணை முன்னர்க் களிற்றின் இயலி","வெம்போர்ச் செழியனும் வந்தனன் எதிர்ந்த","வம்ப மள்ளரோ பலரே","எஞ்சுவர் கொல்லோ பகல்தவச் சிறிதே"],"tr":["mūtūr vāyil paṉik kayam maṇṇi","maṉṟa vēmpiṉ oṇkuḻai milaintu","teṇkiṇai muṉṉark kaḷiṟṟiṉ iyali","vempōrc ceḻiyaṉum vantaṉaṉ etirnta","vampa maḷḷarō palarē","eñcuvar kollō pakaltavac ciṟitē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"அரசவாகை","poet_ta":"இடைக்குன்றூர் கிழார்","addressed_ta":"பாண்டியன் தலையாலங்கானத்துச் செருவென்ற நெடுஞ்செழியன்","poet_tr":"Iṭaikkuṉṟūr Kiḻār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 9"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மூதூர்","tr":"mūtūr","foot":"tēmā","acai":[{"kind":"nēr","text":"மூ","tr":"mū"},{"kind":"nēr","text":"தூர்","tr":"tūr"}]},{"text":"வாயில்","tr":"vāyil","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"யில்","tr":"yil"}]},{"text":"பனிக்கயம்","tr":"paṉikkayam","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பனிக்","tr":"paṉik"},{"kind":"nirai","text":"கயம்","tr":"kayam"}]},{"text":"மண்ணி","tr":"maṇṇi","foot":"tēmā","acai":[{"kind":"nēr","text":"மண்","tr":"maṇ"},{"kind":"nēr","text":"ணி","tr":"ṇi"}]}],[{"text":"மன்ற","tr":"maṉṟa","foot":"tēmā","acai":[{"kind":"nēr","text":"மன்","tr":"maṉ"},{"kind":"nēr","text":"ற","tr":"ṟa"}]},{"text":"வேம்பி","tr":"vēmpi","foot":"tēmā","acai":[{"kind":"nēr","text":"வேம்","tr":"vēm"},{"kind":"nēr","text":"பி","tr":"pi"}]},{"text":"னொண்குழை","tr":"ṉoṇkuḻai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"னொண்","tr":"ṉoṇ"},{"kind":"nirai","text":"குழை","tr":"kuḻai"}]},{"text":"மிலைந்து","tr":"milaintu","foot":"puḷimā","acai