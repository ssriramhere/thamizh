ி","tr":"vi"}]},{"text":"டாஅள்","tr":"ṭāaḷ","foot":"tēmā","acai":[{"kind":"nēr","text":"டா","tr":"ṭā"},{"kind":"nēr","text":"அள்","tr":"aḷ"}]},{"text":"திருவே","tr":"tiruvē","foot":"puḷimā","acai":[{"kind":"nirai","text":"திரு","tr":"tiru"},{"kind":"nēr","text":"வே","tr":"vē"}]}],[{"text":"விடாஅ","tr":"viṭāa","foot":"puḷimā","acai":[{"kind":"nirai","text":"விடா","tr":"viṭā"},{"kind":"nēr","text":"அ","tr":"a"}]},{"text":"தோரிவள்","tr":"tōrivaḷ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nirai","text":"ரிவள்","tr":"rivaḷ"}]},{"text":"விடப்பட்","tr":"viṭappaṭ","foot":"puḷimā","acai":[{"kind":"nirai","text":"விடப்","tr":"viṭap"},{"kind":"nēr","text":"பட்","tr":"paṭ"}]},{"text":"டோரே","tr":"ṭōrē","foot":"tēmā","acai":[{"kind":"nēr","text":"டோ","tr":"ṭō"},{"kind":"nēr","text":"ரே","tr":"rē"}]}]]},"ai":{"lines":[{"words":[{"surface":"பருதி","parts":[{"text":"பருதி","lemma":"பருதி","gloss":"sun"}],"gloss":"sun"},{"surface":"சூழ்ந்த","parts":[{"text":"சூழ்ந்த","lemma":"சூழ்ந்த","gloss":"surrounded"}],"gloss":"surrounded","split_unverified":true},{"surface":"இ","parts":[{"text":"இ","lemma":"இ","gloss":"this"}],"gloss":"this"},{"surface":"பயம்","parts":[{"text":"பயம்","lemma":"பயம்","gloss":"yield / benefit"}],"gloss":"yield / benefit"},{"surface":"கெழு","parts":[{"text":"கெழு","lemma":"கெழு","gloss":"having"}],"gloss":"having"},{"surface":"மா","parts":[{"text":"மா","lemma":"மா","gloss":"great"}],"gloss":"great"},{"surface":"நிலம்","parts":[{"text":"நிலம்","lemma":"நிலம்","gloss":"earth"}],"gloss":"earth"}]},{"words":[{"surface":"ஒரு","parts":[{"text":"ஒரு","lemma":"ஒரு","gloss":"one"}],"gloss":"one"},{"surface":"பகல்","parts":[{"text":"பகல்","lemma":"பகல்","gloss":"day"}],"gloss":"day"},{"surface":"எழுவர்","parts":[{"text":"எழுவர்","lemma":"எழுவர்","gloss":"seven people"}],"gloss":"seven people"},{"surface":"எய்தியற்று","parts":[{"text":"எய்தியற்று","lemma":"எய்தியற்று","gloss":"is like obtaining"}],"gloss":"is like obtaining","split_unverified":true},{"surface":"ஏ","parts":[{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"indeed"}]},{"words":[{"surface":"வையமும்","parts":[{"text":"வையம்","lemma":"வையம்","gloss":"world"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and the world"},{"surface":"தவமும்","parts":[{"text":"தவம்","lemma":"தவம்","gloss":"penance"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and penance"},{"surface":"தூக்கின்","parts":[{"text":"தூக்கு","lemma":"தூக்குதல்","gloss":"weigh"},{"text":"இன்","lemma":"இன்","gloss":"if"}],"gloss":"if weighed"},{"surface":"தவத்துக்கு","parts":[{"text":"தவத்துக்கு","lemma":"தவத்துக்கு","gloss":"to penance"}],"gloss":"to penance","split_unverified":true}]},{"words":[{"surface":"ஐயவி","parts":[{"text":"ஐயவி","lemma":"ஐயவி","gloss":"mustard seed"}],"gloss":"mustard seed"},{"surface":"அனைத்தும்","parts":[{"text":"அனைத்து","lemma":"அனைத்து","gloss":"all / even that much"},{"text":"உம்","lemma":"உம்","gloss":"even"}],"gloss":"even as much as"},{"surface":"ஆற்றாது","parts":[{"text":"ஆற்று","lemma":"ஆற்றல்","gloss":"equal"},{"text":"ஆ","lemma":"ஆ","gloss":"negative"},{"text":"து","lemma":"து","gloss":"it"}],"gloss":"cannot equal"},{"surface":"ஆகலின்","parts":[{"text":"ஆகல்","lemma":"ஆகுதல்","gloss":"becoming"},{"text":"இன்","lemma":"இன்","gloss":"because"}],"gloss":"therefore"}]},{"words":[{"surface":"கைவிட்டனரே","parts":[{"text":"கை","lemma":"கை","gloss":"hand"},{"text":"விட்டனர்","lemma":"விடுதல்","gloss":"let go"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"they renounced indeed"},{"surface":"காதலர்","parts":[{"text":"காதல்","lemma":"காதல்","gloss":"love / desire"},{"text":"அர்","lemma":"அர்","gloss":"they (who have)"}],"gloss":"those who love [their souls]"},{"surface":"அதனால்","parts":[{"text":"அதனால்","lemma":"அதனால்","gloss":"therefore"}],"gloss":"therefore","split_unverified":true}]},{"words":[{"surface":"விட்டோரை","parts":[{"text":"விட்டோர்","lemma":"விட்டோர்","gloss":"those who renounced"},{"text":"ஐ","lemma":"ஐ","gloss":"accusative marker"}],"gloss":"those who renounced"},{"surface":"விடாஅள்","parts":[{"text":"விடாஅள்","lemma":"விடாஅள்","gloss":"she will not leave"}],"gloss":"she will not leave","split_unverified":true},{"surface":"திருவே","parts":[{"text":"திரு","lemma":"திரு","gloss":"Goddess of Fortune"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"the Goddess of Fortune indeed"}]},{"words":[{"surface":"விடாஅதோர்","parts":[{"text":"விடாஅதோர்","lemma":"விடாஅதோர்","gloss":"those who do not renounce"}],"gloss":"those who do not renounce","split_unverified":true},{"surface":"இவள்","parts":[{"text":"இவள்","lemma":"இவள்","gloss":"she"}],"gloss":"she"},{"surface":"விடப்பட்டோரே","parts":[{"text":"விடப்பட்டோர்","lemma":"விடப்படுதல்","gloss":"those who are abandoned"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"are those abandoned indeed"}]}],"literal":"This great earth full of benefits surrounded by the sun / is like seven kings obtaining it in a single day. / If one weighs the world and penance, to penance / even a mustard seed's worth [the world] cannot equal, therefore / those who love [their souls] have renounced [it]. / The Goddess of Fortune will not leave those who renounced; / those who do not renounce are those abandoned by her.","translation":"This vast, fertile earth surrounded by the sun is like something ruled and lost by seven kings in a single day. If one weighs the entire world against penance, the world cannot equal even a tiny mustard seed in comparison. Therefore, those who love their souls have renounced it. The Goddess of Fortune never leaves those who renounce; but those who do not renounce are the ones abandoned by her.","modern":"சூரியன் சூழ்ந்த இந்த வளம் நிறைந்த பெரிய உலகத்தை, ஒரே நாளில் ஏழு அரசர்கள் அடுத்தடுத்து அடைந்து ஆண்டது போன்றது இதன் நிலையாமை. உலகத்தையும் தவத்தையும் சீர்தூக்கிப் பார்த்தால், தவத்திற்கு இந்த உலகம் ஒரு சிறு கடுகு அளவும் ஈடாகாது. ஆதலால், தம் ஆன்மாவை நேசிப்பவர்கள் இவ்வுலக இன்பங்களைக் கைவிட்டனர். அவ்வாறு உலகப் பற்றைக் கைவிட்டவர்களைத் திருமகள் விடமாட்டாள்; உலகப் பற்றைக் கைவிடாதவர்களோ இவளால் கைவிடப்பட்டவர்கள் ஆவர்.","explanation":"The poet Valmikiyar speaks about the transience of worldly power and the supreme value of asceticism (renunciation). He compares the vast, sun-encircled earth to a fleeting possession that seven kings might rule and lose in a single day, highlighting its impermanence. When comparing the entire material world to spiritual penance (tavam), the world does not even equal a tiny mustard seed in value. Therefore, those who truly love their souls and seek liberation renounce all worldly attachments. Paradoxically, the Goddess of Fortune (Thiru) never leaves those who have renounced the world, whereas those who cling to wealth and material life are the ones she ultimately abandons.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,1.1],[1.1,1.6],[1.6,2.0],[2.0,2.7],[2.7,2.9],[2.9,3.3],[3.3,3.5],[3.5,4.8],[4.8,5.0],[5.0,5.5],[5.5,5.9],[5.9,7.3],[7.3,7.3],[7.3,7.8],[7.8,8.5],[8.5,9.4],[9.4,9.85],[9.85,10.0],[10.0,11.0],[11.0,11.69],[11.69,12.1],[12.1,12.5],[12.5,12.94],[12.94,13.7],[13.7,14.0],[14.0,14.3]],"female":[[0.0,0.5],[0.5,1.0],[1.0,1.5],[1.5,2.0],[2.0,3.0],[3.0,3.3],[3.3,3.7],[3.7,4.0],[4.0,5.5],[5.5,5.7],[5.7,6.2],[6.2,6.6],[6.6,7.9],[7.9,8.0],[8.0,8.5],[8.5,9.2],[9.2,10.7],[10.7,10.95],[10.95,11.2],[11.2,11.2],[11.2,12.8],[12.8,13.1],[13.1,13.7],[13.7,14.43],[14.43,14.43],[14.43,15.66],[15.66,15.9]]}}