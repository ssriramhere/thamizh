ி","tr":"vi"}]},{"text":"டாஅள்","tr":"ṭāaḷ","foot":"tēmā","acai":[{"kind":"nēr","text":"டா","tr":"ṭā"},{"kind":"nēr","text":"அள்","tr":"aḷ"}]},{"text":"திருவே","tr":"tiruvē","foot":"puḷimā","acai":[{"kind":"nirai","text":"திரு","tr":"tiru"},{"kind":"nēr","text":"வே","tr":"vē"}]}],[{"text":"விடாஅ","tr":"viṭāa","foot":"puḷimā","acai":[{"kind":"nirai","text":"விடா","tr":"viṭā"},{"kind":"nēr","text":"அ","tr":"a"}]},{"text":"தோரிவள்","tr":"tōrivaḷ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தோ","tr":"tō"},{"kind":"nirai","text":"ரிவள்","tr":"rivaḷ"}]},{"text":"விடப்பட்","tr":"viṭappaṭ","foot":"puḷimā","acai":[{"kind":"nirai","text":"விடப்","tr":"viṭap"},{"kind":"nēr","text":"பட்","tr":"paṭ"}]},{"text":"டோரே","tr":"ṭōrē","foot":"tēmā","acai":[{"kind":"nēr","text":"டோ","tr":"ṭō"},{"kind":"nēr","text":"ரே","tr":"rē"}]}]]},"ai":null}