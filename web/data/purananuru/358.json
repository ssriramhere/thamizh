{"text":"purananuru","n":358,"lines":["பருதி சூழ்ந்தஇப் பயங்கெழு மாநிலம்","ஒருபகல் எழுவர் எய்தி யற்றே","வையமும் தவமும் தூக்கின் தவத்துக்கு","ஐயவி யனைத்தும் ஆற்றாது ஆகலின்","கைவிட் டனரே காதலர் அதனால்","விட்டோரை விடாஅள் திருவே","விடாஅ தோர்இவள் விடப்பட் டோரே"],"tr":["paruti cūḻntaip payaṅkeḻu mānilam","orupakal eḻuvar eyti yaṟṟē","vaiyamum tavamum tūkkiṉ tavattukku","aiyavi yaṉaittum āṟṟātu ākaliṉ","kaiviṭ ṭaṉarē kātalar ataṉāl","viṭṭōrai viṭāaḷ tiruvē","viṭāa tōrivaḷ viṭappaṭ ṭōrē"],"colophon":{"tinai":"kāñci","tinai_ta":"காஞ்சி","turai_ta":"மனையறம், துறவறம்","poet_ta":"வான்மீகியார்","poet_tr":"Vāṉmīkiyār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"7×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 21, veṇṭaḷai 6"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பருதி","tr":"paruti","foot":"puḷimā","acai":[{"kind":"nirai","text":"பரு","tr":"paru"},{"kind":"nēr","text":"தி","tr":"ti"}]},{"text":"சூழ்ந்தவிப்","tr":"cūḻntavip","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சூழ்ந்","tr":"cūḻn"},{"kind":"nirai","text":"தவிப்","tr":"tavip"}]},{"text":"பயங்கெழு","tr":"payaṅkeḻu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பயங்","tr":"payaṅ"},{"kind":"nirai","text":"கெழு","tr":"keḻu"}]},{"text":"மாநில","tr":"mānila","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"நில","tr":"nila"}]}],[{"text":"மொருபக","tr":"morupaka","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மொரு","tr":"moru"},{"kind":"nirai","text":"பக","tr":"paka"}]},{"text":"லெழுவ","tr":"leḻuva","foot":"puḷimā","acai":[{"kind":"nirai","text":"லெழு","tr":"leḻu"},{"kind":"nēr","text":"வ","tr":"va"}]},{"text":"ரெய்தி","tr":"reyti","foot":"tēmā","acai":[{"kind":"nēr","text":"ரெய்","tr":"rey"},{"kind":"nēr","text":"தி","tr":"ti"}]},{"text":"யற்றே","tr":"yaṟṟē","foot":"