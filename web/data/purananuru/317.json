{"text":"purananuru","n":317,"lines":["வென்வேல் … நது","முன்றில் கிடந்த பெருங்களி யாளற்கு","அதளுண் டாயினும் பாய்உண்டு ஆயினும்","யாதுண்டு ஆயினும் கொடுமின் வல்லே","வேட்கை மீளப …","… கும் எமக்கும் பிறர்க்கும்","யார்க்கும் ஈய்ந்து துயில்ஏற் பினனே"],"tr":["veṉvēl natu","muṉṟil kiṭanta peruṅkaḷi yāḷaṟku","ataḷuṇ ṭāyiṉum pāyuṇṭu āyiṉum","yātuṇṭu āyiṉum koṭumiṉ vallē","vēṭkai mīḷapa","kum emakkum piṟarkkum","yārkkum īyntu tuyilēṟ piṉaṉē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"வல்லாண் முல்லை","poet_ta":"மவேம்ப்ற்றூர்க் குமரனார்","poet_tr":"Mavēmpṟṟūrk Kumaraṉār"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3, 2×2 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 22, other 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 11, āciriyattaḷai 10, ? 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வென்வேல்","tr":"veṉvēl","foot":"tēmā","acai":[{"kind":"nēr","text":"வென்","tr":"veṉ"},{"kind":"nēr","text":"வேல்","tr":"vēl"}]},{"text":"நது","tr":"natu","foot":"malar","acai":[{"kind":"nirai","text":"நது","tr":"natu"}]}],[{"text":"முன்றில்","tr":"muṉṟil","foot":"tēmā","acai":[{"kind":"nēr","text":"முன்","tr":"muṉ"},{"kind":"nēr","text":"றில்","tr":"ṟil"}]},{"text":"கிடந்த","tr":"kiṭanta","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிடந்","tr":"kiṭan"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"பெருங்களி","tr":"peruṅkaḷi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெருங்","tr":"peruṅ"},{"kind":"nirai","text":"களி","tr":"kaḷi"}]},{"text":"யாளற்","tr":"yāḷaṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"ளற்","tr":"ḷaṟ"}]}],[{"text":"கதளுண்","tr":"kataḷuṇ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கத","tr":"kata"},{"kind":"nēr","text":"ளுண்","tr":"ḷuṇ"}]},{"text":"டாயினும்","tr":"ṭāyiṉum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"டா","tr":"ṭā"},{"kind":"nirai","tex