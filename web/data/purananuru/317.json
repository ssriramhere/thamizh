uḷimā","acai":[{"kind":"nirai","text":"பின","tr":"piṉa"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"வென்வேல்","parts":[{"text":"வென்வேல்","lemma":"வென்வேல்","gloss":"victorious spear"}],"gloss":"victorious spear"},{"surface":"…","parts":[{"text":"…","lemma":"…","gloss":"…"}],"gloss":"…"},{"surface":"நது","parts":[{"text":"நது","lemma":"நது","gloss":"part of word"}],"gloss":"part of word"}]},{"words":[{"surface":"முன்றில்","parts":[{"text":"முன்றில்","lemma":"முன்றில்","gloss":"front yard"}],"gloss":"front yard"},{"surface":"கிடந்த","parts":[{"text":"கிடந்த","lemma":"கிட","gloss":"lying"}],"gloss":"lying"},{"surface":"பெருங்களி","parts":[{"text":"பெருங்களி","lemma":"பெருங்களி","gloss":"great intoxication"}],"gloss":"great intoxication"},{"surface":"ஆளற்கு","parts":[{"text":"ஆளற்கு","lemma":"ஆளன்","gloss":"to the man"}],"gloss":"to the man"}]},{"words":[{"surface":"அதள்","parts":[{"text":"அதள்","lemma":"அதள்","gloss":"deer skin"}],"gloss":"deer skin"},{"surface":"உண்டாயினும்","parts":[{"text":"உண்டாயினும்","lemma":"உண்டாயினும்","gloss":"even if there is"}],"gloss":"even if there is"},{"surface":"பாய்","parts":[{"text":"பாய்","lemma":"பாய்","gloss":"mat"}],"gloss":"mat"},{"surface":"உண்டு","parts":[{"text":"உண்டு","lemma":"உள்","gloss":"is/exists"}],"gloss":"is/exists"},{"surface":"ஆயினும்","parts":[{"text":"ஆயினும்","lemma":"ஆகு","gloss":"even if"}],"gloss":"even if"}]},{"words":[{"surface":"யாது","parts":[{"text":"யாது","lemma":"யாது","gloss":"whatever"}],"gloss":"whatever"},{"surface":"உண்டு","parts":[{"text":"உண்டு","lemma":"உள்","gloss":"is/exists"}],"gloss":"is/exists"},{"surface":"ஆயினும்","parts":[{"text":"ஆயினும்","lemma":"ஆகு","gloss":"even if"}],"gloss":"even if"},{"surface":"கொடுமின்","parts":[{"text":"கொடுமின்","lemma":"கொடு","gloss":"give (plural/polite)"}],"gloss":"give"},{"surface":"வல்லே","parts":[{"text":"வல்லே","lemma":"வல்லே","gloss":"quickly"}],"gloss":"quickly"}]},{"words":[{"surface":"வேட்கை","parts":[{"text":"வேட்கை","lemma":"வேட்கை","gloss":"desire"}],"gloss":"desire"},{"surface":"மீள","parts":[{"text":"மீள","lemma":"மீள","gloss":"to return/be satisfied"}],"gloss":"to be satisfied"},{"surface":"…","parts":[{"text":"…","lemma":"…","gloss":"…"}],"gloss":"…"}]},{"words":[{"surface":"…","parts":[{"text":"…","lemma":"…","gloss":"…"}],"gloss":"…"},{"surface":"கும்","parts":[{"text":"கும்","lemma":"கும்","gloss":"and (suffix)"}],"gloss":"and"},{"surface":"எமக்கும்","parts":[{"text":"எமக்கும்","lemma":"எமக்கும்","gloss":"to us also"}],"gloss":"to us also"},{"surface":"பிறர்க்கும்","parts":[{"text":"பிறர்க்கும்","lemma":"பிறர்க்கும்","gloss":"to others also"}],"gloss":"to others also"}]},{"words":[{"surface":"யார்க்கும்","parts":[{"text":"யார்க்கும்","lemma":"யார்க்கும்","gloss":"to anyone"}],"gloss":"to anyone"},{"surface":"ஈய்ந்து","parts":[{"text":"ஈய்ந்து","lemma":"ஈய்ந்து","gloss":"having given"}],"gloss":"having given"},{"surface":"துயில்","parts":[{"text":"துயில்","lemma":"துயில்","gloss":"sleep"}],"gloss":"sleep"},{"surface":"ஏற்பினனே","parts":[{"text":"ஏற்பினனே","lemma":"ஏற்பினன்","gloss":"he who accepted indeed"}],"gloss":"he who accepted indeed"}]}],"literal":"Victorious spear … / lying in the front yard, to the greatly intoxicated man, / whether there is a deer skin or whether there is a mat, / whatever there is, give quickly! / To satisfy the desire … / … to us and to others, / having given to anyone, he accepted sleep.","translation":"With his victorious spear ... To the great warrior lying drunk in the front yard, give quickly whatever is available, whether it be a deer skin or a mat. To satisfy the desire ... having given to us, to others, and to anyone, he has now accepted his final sleep.","modern":"வெற்றி தரும் வேலை உடைய ... முன்றிலில் கிடக்கும் பெரும் கள்ளுண்ட வீரனுக்கு, மான்தோல் இருந்தாலும் பாய் இருந்தாலும், எது இருந்தாலும் விரைவாகக் கொடுங்கள். விருப்பம் தீர ... நமக்கும் பிறருக்கும் யாருக்கும் வாரி வழங்கிவிட்டு அவன் இப்போது துயில்கொள்கிறான்.","explanation":"This poem belongs to the Vāgai tiṇai and Vallāṇ Mullai tuṟai, which praises the strength and generosity of a brave warrior. The poet, Māvempaṟṟūrk Kumaraṉār, describes a generous warrior who lies in his front yard, deeply intoxicated or perhaps fallen in battle. The speaker urges others to quickly bring whatever bedding is available, whether a simple deer skin or a woven mat, to comfort him. The warrior was known for his boundless generosity, having given away everything he owned to poets, to the speaker, and to anyone who asked. Having exhausted all his wealth in giving, he has now accepted his final, peaceful sleep.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,0.9],[1.0,1.3],[1.3,1.7],[1.7,1.9],[2.34,2.6],[2.6,3.64],[3.64,4.0],[4.0,4.5],[4.5,4.7],[4.7,5.9],[5.9,6.1],[6.1,6.6],[6.6,7.1],[7.1,7.6],[7.6,7.82],[8.03,8.27],[8.27,8.88],[8.88,9.6],[9.6,9.94],[9.94,11.3],[11.3,11.8],[11.8,12.2]],"female":[[0.0,0.7],[0.8,1.0],[1.0,1.7],[1.7,1.9],[1.9,2.3],[2.3,3.1],[3.1,3.31],[3.31,4.6],[4.6,5.2],[5.2,5.5],[5.9,6.9],[6.9,7.3],[7.3,7.8],[7.8,8.0],[8.0,9.1],[9.1,9.64],[9.64,9.88],[9.88,10.75],[10.75,11.8],[11.8,12.7],[12.86,13.1],[13.1,13.7],[13.7,14.1]]},"sync":[[["வென்வேல்","victorious spear"]],[["நது","part of word"]],[["முன்றில்","front yard"]],[["கிடந்த","lying"]],[["பெருங்களி","great intoxication"]],[["ஆளற்கு","to the man"]],[["அதள்","deer skin"],["உண்டாயினும்","even if there is"]],[["உண்டாயினும்","even if there is"]],[["பாய்","mat"],["உண்டு","is/exists"]],[["ஆயினும்","even if"]],[["யாது","whatever"],["உண்டு","is/exists"]],[["ஆயினும்","even if"]],[["கொடுமின்","give"]],[["வல்லே","quickly"]],[["வேட்கை","desire"]],[["மீள","to be satisfied"]],[["கும்","and"]],[["எமக்கும்","to us also"]],[["பிறர்க்கும்","to others also"]],[["யார்க்கும்","to anyone"]],[["ஈய்ந்து","having given"]],[["துயில்","sleep"],["ஏற்பினனே","he who accepted indeed"]],[["ஏற்பினனே","he who accepted indeed"]]]}