{"text":"purananuru","n":106,"lines":["நல்லவும் தீயவும் அல்ல குவி இணர்ப்","புல்லிலை எருக்கம் ஆயினும் உடையவை","கடவுள் பேணேம் என்னா ஆங்கு","மடவர் மெல்லியர் செல்லினும்","கடவன் பாரி கை வண்மையே"],"tr":["nallavum tīyavum alla kuvi iṇarp","pullilai erukkam āyiṉum uṭaiyavai","kaṭavuḷ pēṇēm eṉṉā āṅku","maṭavar melliyar celliṉum","kaṭavaṉ pāri kai vaṇmaiyē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"இயன்மொழி","poet_ta":"கபிலர்","addressed_ta":"வேள் பாரி","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 6"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நல்லவும்","tr":"nallavum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நல்","tr":"nal"},{"kind":"nirai","text":"லவும்","tr":"lavum"}]},{"text":"தீயவு","tr":"tīyavu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தீ","tr":"tī"},{"kind":"nirai","text":"யவு","tr":"yavu"}]},{"text":"மல்ல","tr":"malla","foot":"tēmā","acai":[{"kind":"nēr","text":"மல்","tr":"mal"},{"kind":"nēr","text":"ல","tr":"la"}]},{"text":"குவியிணர்ப்","tr":"kuviyiṇarp","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குவி","tr":"kuvi"},{"kind":"nirai","text":"யிணர்ப்","tr":"yiṇarp"}]}],[{"text":"புல்லிலை","tr":"pullilai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"புல்","tr":"pul"},{"kind":"nirai","text":"லிலை","tr":"lilai"}]},{"text":"யெருக்க","tr":"yerukka","foot":"puḷimā","acai":[{"kind":"nirai","text":"யெருக்","tr":"yeruk"},{"kind":"nēr","text":"க","tr":"ka"}]},{"text":"மாயினு","tr":"māyiṉu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"யினு","tr":"yiṉu"}]},{"text":"முடையவை","tr":"muṭaiyavai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"முடை","tr":"muṭai"},{"kind":"nirai","text":"யவை","tr":"yavai"}]}],[{"text":"கடவுள்","tr":"kaṭavuḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கட","tr":"kaṭa"},{"kind":"nēr","text":"வுள்","tr":"vuḷ"}]},{"text":"பேணே","tr":"pēṇē","foot":"tēmā","acai":[{"kind":"nēr","text":"பே","tr":"pē"},{"kind":"nēr","text":"ணே","tr":"ṇē"}]},{"text":"மென்னா","tr":"meṉṉā","foot":"tēmā","acai":[{"kind":"nēr","text":"மென்","tr":"meṉ"},{"kind":"nēr","text":"னா","tr":"ṉā"}]},{"text":"வாங்கு","tr":"vāṅku","foot":"tēmā","acai":[{"kind":"nēr","text":"வாங்","tr":"vāṅ"},{"kind":"nēr","text":"கு","tr":"ku"}]}],[{"text":"மடவர்","tr":"maṭavar","foot":"puḷimā","acai":[{"kind":"nirai","text":"மட","tr":"maṭa"},{"kind":"nēr","text":"வர்","tr":"var"}]},{"text":"மெல்லியர்","tr":"melliyar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மெல்","tr":"mel"},{"kind":"nirai","text":"லியர்","tr":"liyar"}]},{"text":"செல்லினும்","tr":"celliṉum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"செல்","tr":"cel"},{"kind":"nirai","text":"லினும்","tr":"liṉum"}]}],[{"text":"கடவன்","tr":"kaṭavaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கட","tr":"kaṭa"},{"kind":"nēr","text":"வன்","tr":"vaṉ"}]},{"text":"பாரி","tr":"pāri","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"ரி","tr":"ri"}]},{"text":"கைவண்","tr":"kaivaṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"கை","tr":"kai"},{"kind":"nēr","text":"வண்","tr":"vaṇ"}]},{"text":"மையே","tr":"maiyē","foot":"tēmā","acai":[{"kind":"nēr","text":"மை","tr":"mai"},{"kind":"nēr","text":"யே","tr":"yē"}]}]]},"ai":{"lines":[{"words":[{"surface":"நல்லவும்","parts":[{"text":"நல்ல","lemma":"நல்ல","gloss":"good things"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"even good things"},{"surface":"தீயவும்","parts":[{"text":"தீய","lemma":"தீய","gloss":"bad things"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"even bad things"},{"surface":"அல்ல","parts":[{"text":"அல்ல","lemma":"அல்","gloss":"not being"}],"gloss":"which are neither"},{"surface":"குவி","parts":[{"text":"குவி","lemma":"குவி","gloss":"bunched"}],"gloss":"bunched"},{"surface":"இணர்","parts":[{"text":"இணர்","lemma":"இணர்","gloss":"flower cluster"}],"gloss":"flower clusters"}]},{"words":[{"surface":"புல்","parts":[{"text":"புல்","lemma":"புல்","gloss":"lowly"}],"gloss":"lowly"},{"surface":"இலை","parts":[{"text":"இலை","lemma":"இலை","gloss":"leaf"}],"gloss":"leaves"},{"surface":"எருக்கம்","parts":[{"text":"எருக்கம்","lemma":"எருக்கு","gloss":"calotropis plant"}],"gloss":"of the calotropis plant"},{"surface":"ஆயினும்","parts":[{"text":"ஆயினும்","lemma":"ஆயினும்","gloss":"even if it is"}],"gloss":"even if it is"},{"surface":"உடையவை","parts":[{"text":"உடை","lemma":"உடை","gloss":"possess"},{"text":"அவை","lemma":"அவை","gloss":"those things"}],"gloss":"things that one has"}]},{"words":[{"surface":"கடவுள்","parts":[{"text":"கடவுள்","lemma":"கடவுள்","gloss":"god"}],"gloss":"god"},{"surface":"பேணேம்","parts":[{"text":"பேண்","lemma":"பேண்","gloss":"cherish"},{"text":"ஏம்","lemma":"ஏம்","gloss":"we will not"}],"gloss":"we will not accept"},{"surface":"என்னா","parts":[{"text":"என்னா","lemma":"என்","gloss":"without saying"}],"gloss":"without saying"},{"surface":"ஆங்கு","parts":[{"text":"ஆங்கு","lemma":"ஆங்கு","gloss":"in that manner"}],"gloss":"just like that"}]},{"words":[{"surface":"மடவர்","parts":[{"text":"மடவர்","lemma":"மடவர்","gloss":"simple people"}],"gloss":"simple people"},{"surface":"மெல்லியர்","parts":[{"text":"மெல்லியர்","lemma":"மெல்லியர்","gloss":"weak people"}],"gloss":"humble people"},{"surface":"செல்லினும்","parts":[{"text":"செல்லினும்","lemma":"செல்லினும்","gloss":"even if they go"}],"gloss":"even if they go"}]},{"words":[{"surface":"கடவன்","parts":[{"text":"கடவன்","lemma":"கடமை","gloss":"one who is duty-bound"}],"gloss":"he is duty-bound"},{"surface":"பாரி","parts":[{"text":"பாரி","lemma":"பாரி","gloss":"Pāri"}],"gloss":"Pāri"},{"surface":"கை","parts":[{"text":"கை","lemma":"கை","gloss":"hand"}],"gloss":"hand"},{"surface":"வண்மையே","parts":[{"text":"வண்மை","lemma":"வண்மை","gloss":"generosity"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"indeed generosity"}]}],"literal":"Even good things and bad things which are neither, bunched clusters / of lowly-leaved calotropis, even if it is, those things that are possessed / god, 'we will not accept', without saying, in that manner / simple people and humble people, even if they go / he is duty-bound, Pāri, in the generosity of his hand.","translation":"Even if they are the lowly-leaved calotropis flowers with bunched clusters, which are neither good nor bad, a deity does not refuse them saying, 'We will not accept what you have.' Just so, even if simple, humble folk go to him, Pāri is bound by duty to give with a generous hand.","modern":"நல்லவையும் தீயவையும் அல்லாத, குவிந்த பூங்கொத்துகளையும் சிறிய இலைகளையும் உடைய எருக்கம் பூக்களையே படைத்தாலும், 'இவற்றை நாம் ஏற்றுக்கொள்ள மாட்டோம்' என்று கடவுள் கூற மாட்டார். அதுபோலவே, அறிவில்லாத எளியவர்களும் வறியவர்களும் தன்னிடம் வந்தாலும், அவர்களுக்கு வாரி வழங்குவதையே பாரி தன் கைகளின் கொடைத் தன்மையாகக் கடமையாகக் கொண்டுள்ளான்.","explanation":"This poem is composed by the famous poet Kapilar in praise of his close friend and patron, Vēḷ Pāri. It belongs to the Puram genre, specifically the pāṭāṇ tiṇai, which celebrates a chieftain's virtues and generosity. Kapilar compares Pāri's boundless giving to the grace of a deity. He points out that when devotees offer the humble, wild calotropis (erukku) flower—which is considered neither particularly good nor bad—a god does not reject it. Similarly, Pāri does not judge the status, intelligence, or worthiness of those who approach him. Even if the most simple, weak, or impoverished people come to his gates, Pāri feels it is his absolute duty to give to them with an open hand.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.8],[0.8,1.2],[1.2,1.4],[1.4,1.6],[1.6,1.9],[1.9,2.52],[2.52,3.3],[3.3,3.8],[3.8,4.2],[4.2,5.1],[5.1,5.5],[5.5,5.85],[5.85,6.2],[6.2,7.0],[7.0,8.0],[8.0,8.3],[8.3,9.73],[9.73,10.44],[10.44,10.8],[10.8,11.0]],"female":[[0.0,0.8],[0.8,1.14],[1.14,1.4],[1.4,1.7],[1.7,2.0],[2.0,2.62],[2.62,3.4],[3.4,3.9],[3.9,4.3],[4.3,5.6],[5.6,5.9],[5.9,6.1],[6.1,6.4],[6.4,7.16],[7.16,8.1],[8.1,8.5],[8.5,9.37],[9.37,9.8],[9.8,10.1],[10.1,10.3]]},"sync":[[["நல்லவும்","even good things"]],[["தீயவும்","even bad things"]],[["அல்ல","which are neither"]],[["குவி","bunched"]],[["இணர்","flower clusters"]],[["புல்","lowly"],["இலை","leaves"]],[["எருக்கம்","of the calotropis plant"]],[["ஆயினும்","even if it is"]],[["உடையவை","things that one has"]],[["கடவுள்","god"]],[["பேணேம்","we will not accept"]],[["என்னா","without saying"]],[["ஆங்கு","just like that"]],[["மடவர்","simple people"]],[["மெல்லியர்","humble people"]],[["செல்லினும்","even if they go"]],[["கடவன்","he is duty-bound"]],[["பாரி","Pāri"]],[["கை","hand"]],[["வண்மையே","indeed generosity"]]]}