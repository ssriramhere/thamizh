{"text":"purananuru","n":189,"lines":["தெண்கடல் வளாகம் பொதுமை இன்றி","வெண்குடை நிழற்றிய ஒருமை யோர்க்கும்","நடுநாள் யாமத்தும் பகலும் துஞ்சான்","கடுமாப் பார்க்கும் கல்லா ஒருவற்கும்","உண்பது நாழி உடுப்பவை இரண்டே","பிறவும் எல்லாம் ஓரொக் குமே","அதனால் செல்வத்துப் பயனே ஈதல்","துய்ப்பேம் எனினே தப்புந பலவே"],"tr":["teṇkaṭal vaḷākam potumai iṉṟi","veṇkuṭai niḻaṟṟiya orumai yōrkkum","naṭunāḷ yāmattum pakalum tuñcāṉ","kaṭumāp pārkkum kallā oruvaṟkum","uṇpatu nāḻi uṭuppavai iraṇṭē","piṟavum ellām ōrok kumē","ataṉāl celvattup payaṉē ītal","tuyppēm eṉiṉē tappuna palavē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"பொருண்மொழிக் காஞ்சி","poet_ta":"மதுரைக் கணக்காயனார் மகனார் நக்கீரனார்","poet_tr":"Maturaik Kaṇakkāyaṉār Makaṉār Nakkīraṉār"},"scan":{"meter":"iṇaikkuṟaḷ āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 10, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"தெண்கடல்","tr":"teṇkaṭal","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தெண்","tr":"teṇ"},{"kind":"nirai","text":"கடல்","tr":"kaṭal"}]},{"text":"வளாகம்","tr":"vaḷākam","foot":"puḷimā","acai":[{"kind":"nirai","text":"வளா","tr":"vaḷā"},{"kind":"nēr","text":"கம்","tr":"kam"}]},{"text":"பொதுமை","tr":"potumai","foot":"puḷimā","acai":[{"kind":"nirai","text":"பொது","tr":"potu"},{"kind":"nēr","text":"மை","tr":"mai"}]},{"text":"யின்றி","tr":"yiṉṟi","foot":"tēmā","acai":[{"kind":"nēr","text":"யின்","tr":"yiṉ"},{"kind":"nēr","text":"றி","tr":"ṟi"}]}],[{"text":"வெண்குடை","tr":"veṇkuṭai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வெண்","tr":"veṇ"},{"kind":"nirai","text":"குடை","tr":"kuṭai"}]},{"text":"நிழற்றிய","tr":"niḻaṟṟiya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நிழற்","tr":"niḻaṟ"},{"kind":"nirai","text":"றிய","tr":"ṟiya"}]},{"text":"வொருமை","tr":"vorumai","foot":"puḷimā","acai":[{"kind":"nirai","text":"வொரு","tr":"voru"},{"kind":"nēr","text":"மை","tr":"mai"}]},{"text":"யோர்க்கும்","tr":"yōrkkum","foot":"tēmā","acai":[{"kind":"nēr","text":"யோர்க்","tr":"yōrk"},{"kind":"nēr","text":"கும்","tr":"kum"}]}],[{"text":"நடுநாள்","tr":"naṭunāḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"நடு","tr":"naṭu"},{"kind":"nēr","text":"நாள்","tr":"nāḷ"}]},{"text":"யாமத்தும்","tr":"yāmattum","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"மத்","tr":"mat"},{"kind":"nēr","text":"தும்","tr":"tum"}]},{"text":"பகலும்","tr":"pakalum","foot":"puḷimā","acai":[{"kind":"nirai","text":"பக","tr":"paka"},{"kind":"nēr","text":"லும்","tr":"lum"}]},{"text":"துஞ்சான்","tr":"tuñcāṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"துஞ்","tr":"tuñ"},{"kind":"nēr","text":"சான்","tr":"cāṉ"}]}],[{"text":"கடுமாப்","tr":"kaṭumāp","foot":"puḷimā","acai":[{"kind":"nirai","text":"கடு","tr":"kaṭu"},{"kind":"nēr","text":"மாப்","tr":"māp"}]},{"text":"பார்க்கும்","tr":"pārkkum","foot":"tēmā","acai":[{"kind":"nēr","text":"பார்க்","tr":"pārk"},{"kind":"nēr","text":"கும்","tr":"kum"}]},{"text":"கல்லா","tr":"kallā","foot":"tēmā","acai":[{"kind":"nēr","text":"கல்","tr":"kal"},{"kind":"nēr","text":"லா","tr":"lā"}]},{"text":"வொருவற்கு","tr":"voruvaṟku","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"வொரு","tr":"voru"},{"kind":"nēr","text":"வற்","tr":"vaṟ"},{"kind":"nēr","text":"கு","tr":"ku"}]}],[{"text":"முண்பது","tr":"muṇpatu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"முண்","tr":"muṇ"},{"kind":"nirai","text":"பது","tr":"patu"}]},{"text":"நாழி","tr":"nāḻi","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"ழி","tr":"ḻi"}]},{"text":"யுடுப்பவை","tr":"yuṭuppavai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"யுடுப்","tr":"yuṭup"},{"kind":"nirai","text":"பவை","tr":"pavai"}]},{"text":"யிரண்டே","tr":"yiraṇṭē","foot":"puḷimā","acai":[{"kind":"nirai","text":"யிரண்","tr":"y