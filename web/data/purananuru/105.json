:[{"text":"வாள்","lemma":"vāḷ","gloss":"bright"}],"gloss":"bright"},{"surface":"நுதல்","parts":[{"text":"நுதல்","lemma":"nutal","gloss":"forehead"}],"gloss":"forehead"},{"surface":"விறலி","parts":[{"text":"விறலி","lemma":"viṟali","gloss":"songstress"}],"gloss":"O songstress"}]},{"words":[{"surface":"தடவுவாய்","parts":[{"text":"தடவு","lemma":"taṭavu","gloss":"large"},{"text":"வாய்","lemma":"vāy","gloss":"mouth"}],"gloss":"wide opening"},{"surface":"கலித்த","parts":[{"text":"கலி","lemma":"kali","gloss":"flourish"},{"text":"த்த","lemma":"tta","gloss":"adjectival participle suffix"}],"gloss":"flourished"},{"surface":"மாஇதழ்","parts":[{"text":"மா","lemma":"mā","gloss":"dark"},{"text":"இதழ்","lemma":"itaḻ","gloss":"petal"}],"gloss":"dark petals"},{"surface":"குவளை","parts":[{"text":"குவளை","lemma":"kuvaḷai","gloss":"blue water lily"}],"gloss":"blue water lily"}]},{"words":[{"surface":"வண்டுபடு","parts":[{"text":"வண்டு","lemma":"vaṇṭu","gloss":"bee"},{"text":"படு","lemma":"paṭu","gloss":"settle"}],"gloss":"where bees settle"},{"surface":"புதுமலர்","parts":[{"text":"புது","lemma":"putu","gloss":"fresh"},{"text":"மலர்","lemma":"malar","gloss":"flower"}],"gloss":"fresh flowers"},{"surface":"தண்","parts":[{"text":"தண்","lemma":"taṇ","gloss":"cool"}],"gloss":"cool"},{"surface":"சிதர்","parts":[{"text":"சிதர்","lemma":"citar","gloss":"droplet"}],"gloss":"droplets"},{"surface":"கலாவ","parts":[{"text":"கலா","lemma":"kalā","gloss":"mix"},{"text":"அ","lemma":"a","gloss":"infinitive suffix"}],"gloss":"to mix"}]},{"words":[{"surface":"பெய்யினும்","parts":[{"text":"பெய்","lemma":"pey","gloss":"rain"},{"text":"இனும்","lemma":"iṉum","gloss":"even if"}],"gloss":"even if it rains"},{"surface":"பெய்யாது","parts":[{"text":"பெய்","lemma":"pey","gloss":"rain"},{"text":"ஆது","lemma":"ātu","gloss":"without"}],"gloss":"without raining"},{"surface":"ஆயினும்","parts":[{"text":"ஆயின்","lemma":"āyiṉ","gloss":"even if it is"},{"text":"உம்","lemma":"um","gloss":"even"}],"gloss":"even if it is so"},{"surface":"அருவி","parts":[{"text":"அருவி","lemma":"aruvi","gloss":"waterfall"}],"gloss":"the waterfall"}]},{"words":[{"surface":"கொள்ளுழு","parts":[{"text":"கொள்","lemma":"koḷ","gloss":"horsegram"},{"text":"உழு","lemma":"uḻu","gloss":"ploughed"}],"gloss":"ploughed for horsegram"},{"surface":"வியன்புலத்து","parts":[{"text":"வியன்புலத்து","lemma":"வியன்புலத்து","gloss":"in the wide fields"}],"gloss":"in the wide fields","split_unverified":true},{"surface":"உழைகால்","parts":[{"text":"உழை","lemma":"uḻai","gloss":"deer"},{"text":"கால்","lemma":"kāl","gloss":"leg"}],"gloss":"legs of deer"},{"surface":"ஆட","parts":[{"text":"ஆடு","lemma":"āṭu","gloss":"move"},{"text":"அ","lemma":"a","gloss":"infinitive suffix"}],"gloss":"to move about"}]},{"words":[{"surface":"மால்புஉடை","parts":[{"text":"மால்பு","lemma":"mālpu","gloss":"bamboo support"},{"text":"உடை","lemma":"uṭai","gloss":"having"}],"gloss":"having bamboo supports"},{"surface":"நெடுவரை","parts":[{"text":"நெடு","lemma":"neṭu","gloss":"tall"},{"text":"வரை","lemma":"varai","gloss":"mountain"}],"gloss":"tall mountain"},{"surface":"கோடுதொறு","parts":[{"text":"கோடு","lemma":"kōṭu","gloss":"peak"},{"text":"தொறு","lemma":"toṟu","gloss":"every"}],"gloss":"on every peak"},{"surface":"இழிதரும்","parts":[{"text":"இழி","lemma":"iḻi","gloss":"descend"},{"text":"தரும்","lemma":"tarum","gloss":"bringing"}],"gloss":"descending"}]},{"words":[{"surface":"நீரினும்","parts":[{"text":"நீர்","lemma":"nīr","gloss":"water"},{"text":"இனும்","lemma":"iṉum","gloss":"than"}],"gloss":"more than water"},{"surface":"இனிய","parts":[{"text":"இனி","lemma":"iṉi","gloss":"sweet"},{"text":"அ","lemma":"a","gloss":"adjectival suffix"}],"gloss":"sweet"},{"surface":"சாயல்","parts":[{"text":"சாயல்","lemma":"cāyal","gloss":"gentle nature"}],"gloss":"gentle nature"}]},{"words":[{"surface":"பாரி","parts":[{"text":"பாரி","lemma":"pāri","gloss":"Pari"}],"gloss":"Pari"},{"surface":"வேள்பால்","parts":[{"text":"வேள்","lemma":"vēḷ","gloss":"chieftain"},{"text":"பால்","lemma":"pāl","gloss":"towards"}],"gloss":"towards chieftain"},{"surface":"பாடினை","parts":[{"text":"பாடு","lemma":"pāṭu","gloss":"sing"},{"text":"இனை","lemma":"iṉai","gloss":"you (past suffix)"}],"gloss":"having sung"},{"surface":"செலினே","parts":[{"text":"செல்","lemma":"cel","gloss":"go"},{"text":"இன்","lemma":"iṉ","gloss":"if"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"if you go"}]}],"literal":"You will obtain excellent jewels, O bright-foreheaded songstress! / The wide-mouthed, flourished, dark-petaled blue water lilies, / mixing with the cool droplets of fresh flowers where bees settle, / whether it rains or does not rain, the waterfall / where deer legs move about in the wide fields ploughed for horsegram, / descending on every peak of the tall mountain having bamboo supports, / gentler and sweeter than that water, / if you go singing towards Chieftain Pari.","translation":"O songstress with a bright forehead! You will obtain fine jewels. If you go singing to Chieftain Pari, whose gentle nature is sweeter than the water of the waterfall that cascades down every peak of his tall, bamboo-clad mountain—whether it rains or not—mixing with the cool droplets of fresh, bee-frequented flowers and wide-petaled blue water lilies, flowing into the wide fields ploughed for horsegram where deer roam.","modern":"ஒளிரும் நெற்றியை உடைய விறலியே! நீ சிறந்த அணிகலன்களைப் பெறுவாய். மூங்கில் சாரல் உடைய உயர்ந்த மலையின் சிகரங்கள் தோறும் இறங்கி, வண்டுகள் மொய்க்கும் புதிய மலர்களின் குளிர்ந்த துளிகளோடும், அகன்ற இதழ்களைக் கொண்ட குவளை மலர்களோடும் கலந்து, மழை பெய்தாலும் பெய்யாவிட்டாலும், கொள்ளு விதைப்பதற்காக உழுத அகன்ற நிலத்தில் மான்கள் விளையாடும்படி வீழ்கின்ற அருவி நீரை விடவும் இனிய மென்மையான இயல்பைக் கொண்ட பாரி வள்ளலிடம் நீ பாடிச் சென்றால்.","explanation":"The poet Kapilar is addressing a viṟali (a female singer/dancer), directing her to the great patron Vēḷ Pāri in this viṟaliyāṟṟuppaṭai poem. He assures her that she will receive beautiful ornaments if she goes and sings in praise of Pāri. He describes Pāri's mountain, Parampu, where waterfalls cascade down the peaks regardless of whether it rains, carrying the fragrance of fresh flowers and blue lilies to the fields where deer play. The constant flow of the waterfall, independent of rain, symbolizes Pāri's ceaseless and unconditional generosity. His sweet and gentle nature (cāyal) is compared to this pure mountain water, which is life-giving and refreshing to all.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,0.8],[0.8,1.4],[1.4,1.5],[1.5,1.8],[1.8,3.9],[3.9,3.9],[3.9,4.33],[4.33,4.5],[4.5,5.6],[5.6,5.6],[5.6,6.3],[6.3,6.4],[6.4,6.4],[6.4,6.4],[6.4,6.4],[6.4,9.1],[9.1,9.2],[9.2,9.2],[9.2,10.5],[10.5,10.5],[10.5,10.5],[10.5,13.0],[13.0,13.6],[13.6,13.97],[14.0,14.7],[14.7,15.6],[15.6,15.6],[15.6,16.0],[16.0,16.73],[16.73,16.73],[16.73,18.2],[18.2,18.3]],"female":[[0.0,0.6],[0.6,0.7],[0.7,1.5],[1.5,1.6],[1.6,2.0],[2.0,4.5],[4.5,4.8],[4.8,4.8],[4.8,4.9],[4.9,5.9],[5.9,6.0],[6.0,6.8],[6.8,6.9],[6.9,6.9],[6.9,6.9],[6.9,6.9],[6.9,9.9],[9.9,10.1],[10.1,10.1],[10.1,12.2],[12.2,12.95],[12.95,13.1],[13.1,14.4],[14.4,15.07],[15.15,15.79],[15.79,16.1],[16.1,17.1],[17.1,17.1],[17.1,17.5],[17.5,18.33],[18.33,18.33],[18.33,20.0],[20.0,20.1]]},"sync":[[["சேயிழை","excellent jewels"]],[["பெறுகுவை","you will obtain"]],[["வாள்","bright"]],[["நுதல்","forehead"]],[["விறலி","O songstress"]],[["தடவுவாய்","wide opening"]],[["கலித்த","flourished"]],[["மாஇதழ்","dark petals"],["குவளை","blue water lily"]],[["குவளை","blue water lily"]],[["வண்டுபடு","where bees settle"]],[["புதுமலர்","fresh flowers"],["தண்","cool"]],[["தண்","cool"]],[["சிதர்","droplets"]],[["கலாவ","to mix"]],[["பெய்யினும்","even if it rains"]],[["பெய்யாது","without raining"]],[["பெய்யாது","without raining"],["ஆயினும்","even if it is so"]],[["அருவி","the waterfall"]],[["கொள்ளுழு","ploughed for horsegram"]],[["வியன்புலத்து","in the wide fields"]],[["உழைகால்","legs of deer"]],[["ஆட","to move about"]],[["மால்புஉடை","having bamboo supports"]],[["நெடுவரை","tall mountain"],["கோடுதொறு","on every peak"]],[["கோடுதொறு","on every peak"]],[["இழிதரும்","descending"]],[["நீரினும்","more than water"]],[["இனிய","sweet"]],[["சாயல்","gentle nature"]],[["பாரி","Pari"]],[["வேள்பால்","towards chieftain"]],[["பாடினை","having sung"]],[["செலினே","if you go"]]]}