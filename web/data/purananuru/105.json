{"text":"purananuru","n":105,"lines":["சேயிழை பெறுகுவை வாள் நுதல் விறலி","தடவுவாய்க் கலித்த மாஇதழ்க் குவளை","வண்டுபடு புதுமலர்த் தண் சிதர் கலாவப்","பெய்யினும் பெய்யா தாயினும் அருவி","கொள்ளுழு வியன்புலத்து உழைகால் ஆட","மால்புஉடை நெடுவரைக் கோடுதொறு இழிதரும்","நீரினும் இனிய சாயல்","பாரி வேள்பால் பாடினை செலினே"],"tr":["cēyiḻai peṟukuvai vāḷ nutal viṟali","taṭavuvāyk kalitta māitaḻk kuvaḷai","vaṇṭupaṭu putumalart taṇ citar kalāvap","peyyiṉum peyyā tāyiṉum aruvi","koḷḷuḻu viyaṉpulattu uḻaikāl āṭa","mālpuuṭai neṭuvaraik kōṭutoṟu iḻitarum","nīriṉum iṉiya cāyal","pāri vēḷpāl pāṭiṉai celiṉē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"விறலியாற்றுப்படை","poet_ta":"கபிலர்","addressed_ta":"வேள் பாரி","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 23, veṇṭaḷai 6, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"சேயிழை","tr":"cēyiḻai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சே","tr":"cē"},{"kind":"nirai","text":"யிழை","tr":"yiḻai"}]},{"text":"பெறுகுவை","tr":"peṟukuvai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெறு","tr":"peṟu"},{"kind":"nirai","text":"குவை","tr":"kuvai"}]},{"text":"வாள்நுதல்","tr":"vāḷnutal","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வாள்","tr":"vāḷ"},{"kind":"nirai","text":"நுதல்","tr":"nutal"}]},{"text":"விறலி","tr":"viṟali","foot":"puḷimā","acai":[{"kind":"nirai","text":"விற","tr":"viṟa"},{"kind":"nēr","text":"லி","tr":"li"}]}],[{"text":"தடவுவாய்க்","tr":"taṭavuvāyk","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தட","tr":"taṭa"},{"kind":"nirai","text":"வுவாய்க்","tr":"vuvāyk"}]},{"text":"கலித்த","tr":"kalitta","foot":"puḷimā","acai":[{"kind":"nirai","text":"கலித்","tr":"kalit"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":