{"text":"purananuru","n":163,"lines":["நின் நயந்து உறைநர்க்கும் நீ நயந்து உறைநர்க்கும்","பன்மாண் கற்பின்நின் கிளைமுத லோர்க்கும்","கடும்பின் கடும்பசி தீர யாழநின்","நெடுங்குறி எதிர்ப்பை நல்கி யோர்க்கும்","இன்னோர்க்கு என்னாது என்னோடும் சூழாது","வல்லாங்கு வாழ்தும் என்னாது நீயும்","எல்லோர்க்கும் கொடுமதி மனைகிழ வோயே","பழந்தூங்கு முதிரத்துக் கிழவன்","திருந்துவேல் குமணன் நல்கிய வளனே"],"tr":["niṉ nayantu uṟainarkkum nī nayantu uṟainarkkum","paṉmāṇ kaṟpiṉniṉ kiḷaimuta lōrkkum","kaṭumpiṉ kaṭumpaci tīra yāḻaniṉ","neṭuṅkuṟi etirppai nalki yōrkkum","iṉṉōrkku eṉṉātu eṉṉōṭum cūḻātu","vallāṅku vāḻtum eṉṉātu nīyum","ellōrkkum koṭumati maṉaikiḻa vōyē","paḻantūṅku mutirattuk kiḻavaṉ","tiruntuvēl kumaṇaṉ nalkiya vaḷaṉē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"பரிசில்","poet_ta":"பெருஞ்சித்திரனார்","addressed_ta":"புலவரின் மனைவி","poet_tr":"Peruñcittiraṉār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"9×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 6"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 15, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நின்நயந்","tr":"niṉnayan","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நின்","tr":"niṉ"},{"kind":"nirai","text":"நயந்","tr":"nayan"}]},{"text":"துறைநர்க்கும்","tr":"tuṟainarkkum","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"துறை","tr":"tuṟai"},{"kind":"nēr","text":"நர்க்","tr":"nark"},{"kind":"nēr","text":"கும்","tr":"kum"}]},{"text":"நீநயந்","tr":"nīnayan","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nirai","text":"நயந்","tr":"nayan"}]},{"text":"துறைநர்க்கும்","tr":"tuṟainarkkum","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"துறை","tr":"tuṟai"},{"kind":"nēr","text":"நர்க்","tr":"nark"},{"kind":"nēr","text":"கும்","tr":"kum"}]}],[{"text":"பன்மாண்","tr":"paṉmāṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"பன்","tr":"paṉ"},{"kind":"nēr","text":"மாண்","tr":"māṇ"}]},{"text":"கற்பின்நின்","tr":"kaṟpiṉniṉ","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"கற்","tr":"kaṟ"},{"kind":"nēr","text":"பின்","tr":"piṉ"},{"kind":"nēr","text":"நின்","tr":"niṉ"}]},{"text":"கிளைமுத","tr":"kiḷaimuta","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கிளை","tr":"kiḷai"},{"kind":"nirai","text":"முத","tr":"muta"}]},{"text":"லோர்க்கும்","tr":"lōrkkum","foot":"tēmā","acai":[{"kind":"nēr","text":"லோர்க்","tr":"lōrk"},{"kind":"nēr","text":"கும்","tr":"kum"}]}],[{"text":"கடும்பின்","tr":"kaṭumpiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கடும்","tr":"kaṭum"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]},{"text":"கடும்பசி","tr":"kaṭumpaci","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கடும்","tr":"kaṭum"},{"kind":"nirai","text":"பசி","tr":"paci"}]},{"text":"தீர","tr":"tīra","foot":"tēmā","acai":[{"kind":"nēr","text":"தீ","tr":"tī"},{"kind":"nēr","text":"ர","tr":"ra"}]},{"text":"யாழநின்","tr":"yāḻaniṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nirai","text":"ழநின்","tr":"ḻaniṉ"}]}],[{"text":"நெடுங்குறி","tr":"neṭuṅkuṟi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நெடுங்","tr":"neṭuṅ"},{"kind":"nirai","text":"குறி","tr":"kuṟi"}]},{"text":"யெதிர்ப்பை","tr":"yetirppai","foot":"puḷimā","acai":[{"kind":"nirai","text":"யெதிர்ப்","tr":"yetirp"},{"kind":"nēr","text":"பை","tr":"pai"}]},{"text":"நல்கி","tr":"nalki","foot":"tēmā","acai":[{"kind":"nēr","text":"நல்","tr":"nal"},{"kind":"nēr","text":"கி","tr":"ki"}]},{"text":"யோர்க்கு","tr":"yōrkku","foot":"tēmā","acai":[{"kind":"nēr","text":"யோர்க்","tr":"yōrk"},{"kind":"nēr","text":"கு","tr":"ku"}]}],[{"text":"மின்னோர்க்","tr":"miṉṉōrk","foot":"tēmā","acai":[{"kind":"nēr","text":"மின்","tr":"miṉ"},{"kind":"nēr","text":"னோர்க்","tr":"ṉōrk"}]},{"text":"கென்னா","tr":"keṉṉā","foot":"tēmā","acai":[{"kind":"nēr","text":"கென்","tr":"keṉ"},{"kind":"nēr","text":"னா","tr":"ṉā"}]},{"text":"தென்னோடும்","tr":"teṉṉōṭum","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"தென்","tr":"teṉ"},{"kind":"nēr","text":"னோ","tr":"ṉō"},{"kind":"nēr","text":"டும்","tr":"ṭum"}]},{"text":"சூழாது","tr":"cūḻātu","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"சூ","tr":"cū"},{"kind":"nēr","text":"ழா","tr":"ḻā"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"வல்லாங்","tr":"vallāṅ","foot":"tēmā","acai":[{"kind":"nēr","text":"வல்","tr":"val"},{"kind":"nēr","text":"லாங்","tr":"lāṅ"}]},{"text":"குவாழ்து","tr":"kuvāḻtu","foot":"puḷimā","acai":[{"kind":"nirai","text":"குவாழ்","tr":"kuvāḻ"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"மென்னா","tr":"meṉṉā","foot":"tēmā","acai":[{"kind":"nēr","text":"மென்","tr":"meṉ"},{"kind":"nēr","text":"னா","tr":"ṉā"}]},{"text":"துநீயு","tr":"tunīyu","foot":"puḷimā","acai":[{"kind":"nirai","text":"துநீ","tr":"tunī"},{"kind":"nēr","text":"யு","tr":"yu"}]}],[{"text":"மெல்லோர்க்கும்","tr":"mellōrkkum","foot":"tēmāṅkāy","acai":[{"kind":"nēr","text":"மெல்","tr":"mel"},{"kind":"nēr","text":"லோர்க்","tr":"lōrk"},{"kind":"nēr","text":"கும்","tr":"kum"}]},{"text":"கொடுமதி","tr":"koṭumati","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கொடு","tr":"koṭu"},{"kind":"nirai","text":"மதி","tr":"mati"}]},{"text":"மனைகிழ","tr":"maṉaikiḻa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மனை","tr":"maṉai"},{"kind":"nirai","text":"கிழ","tr":"kiḻa"}]},{"text":"வோயே","tr":"vōyē","foot":"tēmā","acai":[{"kind":"nēr","text":"வோ","tr":"vō"},{"kind":"nēr","text":"யே","tr":"yē"}]}],[{"text":"பழந்தூங்","tr":"paḻantūṅ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பழந்","tr":"paḻan"},{"kind":"nēr","text":"தூங்","tr":"tūṅ"}]},{"text":"குமுதி","tr":"kumuti","foot":"puḷimā","acai":[{"kind":"nirai","text":"குமு","tr":"kumu"},{"kind":"nēr","text":"தி","tr":"ti"}]},{"text":"ரத்துக்","tr":"rattuk","foot":"tēmā","acai":[{"kind":"nēr","text":"ரத்","tr":"rat"},{"kind":"nēr","text":"துக்","tr":"tuk"}]},{"text":"கிழவன்","tr":"kiḻavaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிழ","tr":"kiḻa"},{"kind":"nēr","text":"வன்","tr":"vaṉ"}]}],[{"text":"திருந்துவேல்","tr":"tiruntuvēl","foot":"karuviḷam","acai":[{"kind":"nirai","text":"திருந்","tr":"tirun"},{"kind":"nirai","text":"துவேல்","tr":"tuvēl"}]},{"text":"குமணன்","tr":"kumaṇaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"கும","tr":"kuma"},{"kind":"nēr","text":"ணன்","tr":"ṇaṉ"}]},{"text":"நல்கிய","tr":"nalkiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நல்","tr":"nal"},{"kind":"nirai","text":"கிய","tr":"kiya"}]},{"text":"வளனே","tr":"vaḷaṉē","foot":"puḷimā","acai":[{"kind":"nirai","text":"வள","tr":"vaḷa"},{"kind":"nēr","text":"னே","tr":"ṉē"}]}]]},"ai":{"lines":[{"words":[{"surface":"நின்","parts":[{"text":"நின்","lemma":"நீ","gloss":"you (oblique)"}],"gloss":"you"},{"surface":"நயந்து","parts":[{"text":"நயந்து","lemma":"நய","gloss":"having loved"}],"gloss":"having loved"},{"surface":"உறைநர்க்கும்","parts":[{"text":"உறைநர்","lemma":"உறைநர்","gloss":"those who dwell"},{"text":"கு","lemma":"கு","gloss":"to"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and to those who dwell"},{"surface":"நீ","parts":[{"text":"நீ","lemma":"நீ","gloss":"you"}],"gloss":"you"},{"surface":"நயந்து","parts":[{"text":"நயந்து","lemma":"நய","gloss":"having loved"}],"gloss":"having loved"},{"surface":"உறைநர்க்கும்","parts":[{"text":"உறைநர்","lemma":"உறைநர்","gloss":"those who dwell"},{"text":"கு","lemma":"கு","gloss":"to"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and to those who dwell"}]},{"words":[{"surface":"பன்மாண்","parts":[{"text":"பன்மாண்","lemma":"பன்மாண்","gloss":"many glorious"}],"gloss":"many glorious","split_unverified":true},{"surface":"கற்பின்","parts":[{"text":"கற்பு","lemma":"கற்பு","gloss":"virtue"},{"text":"இன்","lemma":"இன்","gloss":"of"}],"gloss":"of virtue"},{"surface":"நின்","parts":[{"text":"நின்","lemma":"நீ","gloss":"your"}],"gloss":"your"},{"surface":"கிளைமுதலோர்க்கும்","parts":[{"text":"கிளை","lemma":"கிளை","gloss":"kin"},{"text":"முதல்","lemma":"முதல்","gloss":"chief"},{"text":"ஓர்க்கு","lemma":"ஓர்","gloss":"those people"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and to your chief relatives"}]},{"words":[{"surface":"கடும்பின்","parts":[{"text":"கடும்பு","lemma":"கடும்பு","gloss":"family"},{"text":"இன்","lemma":"இன்","gloss":"of"}],"gloss":"of the family"},{"surface":"கடும்பசி","parts":[{"text":"கடும்","lemma":"கடுமை","gloss":"severe"},{"text":"பசி","lemma":"பசி","gloss":"hunger"}],"gloss":"severe hunger"},{"surface":"தீர","parts":[{"text":"தீர","lemma":"தீர்","gloss":"to end"}],"gloss":"to end"},{"surface":"யாழ","parts":[{"text":"யாழ","lemma":"யாழ","gloss":"oh (address particle)"}],"gloss":"oh"},{"surface":"நின்","parts":[{"text":"நின்","lemma":"நீ","gloss":"your"}],"gloss":"your"}]},{"words":[{"surface":"நெடுங்குறி","parts":[{"text":"நெடுங்குறி","lemma":"நெடுங்குறி","gloss":"long-term loan"}],"gloss":"long-term loan","split_unverified":true},{"surface":"எதிர்ப்பை","parts":[{"text":"எதிர்ப்பை","lemma":"எதிர்ப்பை","gloss":"loan to be returned"}],"gloss":"loan"},{"surface":"நல்கியோர்க்கும்","parts":[{"text":"நல்கியோர்","lemma":"நல்கியோர்","gloss":"those who gave"},{"text":"கு","lemma":"கு","gloss":"to"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and to those who gave"}]},{"words":[{"surface":"இன்னோர்க்கு","parts":[{"text":"இன்னோர்","lemma":"இன்னோர்","gloss":"these people"},{"text":"கு","lemma":"கு","gloss":"to"}],"gloss":"to these people"},{"surface":"என்னாது","parts":[{"text":"என்னாது","lemma":"என்","gloss":"without distinguishing"}],"gloss":"without distinguishing"},{"surface":"என்னோடும்","parts":[{"text":"என்","lemma":"யான்","gloss":"me"},{"text":"ஓடு","lemma":"ஓடு","gloss":"with"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and with me"},{"surface":"சூழாது","parts":[{"text":"சூழாது","lemma":"சூழ்","gloss":"without consulting"}],"gloss":"without consulting"}]},{"words":[{"surface":"வல்லாங்கு","parts":[{"text":"வல்","lemma":"வல்","gloss":"ability"},{"text":"ஆங்கு","lemma":"ஆங்கு","gloss":"manner"}],"gloss":"as we can / hoarding"},{"surface":"வாழ்தும்","parts":[{"text":"வாழ்தும்","lemma":"வாழ்","gloss":"we shall live"}],"gloss":"we shall live"},{"surface":"என்னாது","parts":[{"text":"என்னாது","lemma":"என்","gloss":"without thinking"}],"gloss":"without thinking"},{"surface":"நீயும்","parts":[{"text":"நீ","lemma":"நீ","gloss":"you"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"and you"}]},{"words":[{"surface":"எல்லோர்க்கும்","parts":[{"text":"எல்லோர்","lemma":"எல்லோர்","gloss":"all people"},{"text":"கு","lemma":"கு","gloss":"to"},{"text":"உம்","lemma":"உம்","gloss":"and"}],"gloss":"to everyone"},{"surface":"கொடுமதி","parts":[{"text":"கொடு","lemma":"கொடு","gloss":"give"},{"text":"மதி","lemma":"மதி","gloss":"honorific imperative suffix"}],"gloss":"please give"},{"surface":"மனைகிழவோயே","parts":[{"text":"மனை","lemma":"மனை","gloss":"house"},{"text":"கிழவோய்","lemma":"கிழவோள்","gloss":"mistress"},{"text":"ஏ","lemma":"ஏ","gloss":"vocative"}],"gloss":"O mistress of the house!"}]},{"words":[{"surface":"பழந்தூங்கு","parts":[{"text":"பழம்","lemma":"பழம்","gloss":"fruit"},{"text":"தூங்கு","lemma":"தூங்கு","gloss":"hanging"}],"gloss":"where fruits hang"},{"surface":"முதிரத்து","parts":[{"text":"முதிரத்து","lemma":"முதிரத்து","gloss":"of Mutiram hill"}],"gloss":"of Mutiram hill","split_unverified":true},{"surface":"கிழவன்","parts":[{"text":"கிழவன்","lemma":"கிழவன்","gloss":"lord"}],"gloss":"the lord"}]},{"words":[{"surface":"திருந்துவேல்","parts":[{"text":"திருந்து","lemma":"திருந்து","gloss":"perfected"},{"text":"வேல்","lemma":"வேல்","gloss":"spear"}],"gloss":"perfected spear"},{"surface":"குமணன்","parts":[{"text":"குமணன்","lemma":"குமணன்","gloss":"Kumanan"}],"gloss":"Kumanan"},{"surface":"நல்கிய","parts":[{"text":"நல்கிய","lemma":"நல்கு","gloss":"which was granted"}],"gloss":"granted"},{"surface":"வளனே","parts":[{"text":"வளன்","lemma":"வளம்","gloss":"wealth"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"the wealth indeed"}]}],"literal":"To those who love you and dwell with you, and to those whom you love and dwell with, / to your relatives of many-fold excellent virtue, / to end the severe hunger of our family, oh, to those who / gave you long-term loans on trust, / without saying 'to these people' and without consulting with me, / without saying 'we shall hoard this to live well', you too, / give to everyone, O mistress of the house! / The lord of Mutiram hill where fruits hang, / Kumanan of the perfected spear, this is the wealth he granted!","translation":"Give to those who love you and live with you, and to those whom you love and live with. Give to your relatives of great virtue. To end the severe hunger of our kin, give to those who once gave you loans on trust. Without distinguishing among them, without consulting me, and without thinking of hoarding this to secure our own future, give to everyone, O mistress of our home! For this is the boundless wealth granted by Kumanan, the lord of Mt. Mutiram where fruits hang, who wields a flawless spear.","modern":"உன்னை விரும்பி உன்னுடன் வாழ்பவர்களுக்கும், நீ விரும்பி உன்னுடன் வாழ்பவர்களுக்கும், பல நற்பண்புகளைக் கொண்ட உன் சுற்றத்தாருக்கும், நம் சுற்றத்தாரின் கொடிய பசியைப் போக்குவதற்காக உனக்குக் கடன் கொடுத்து உதவியவர்களுக்கும், 'இவருக்குத் தரலாம், இவருக்குத் தர வேண்டாம்' என்று பகுத்துப் பார்க்காமல், என்னிடமும் ஆலோசிக்காமல், 'நாம் பிற்காலத்தில் வசதியாக வாழச் சேமித்து வைப்போம்' என்று எண்ணாமல், நீயும் எல்லோருக்கும் வாரி வழங்குவாயாக, என் இல்லத்தரசியே! பழங்கள் தொங்கும் முதிர மலைக்குத் தலைவனும், சிறந்த வேலை ஏந்தியவனுமாகிய குமணன் நமக்குக் கொடையாக வழங்கிய செல்வம் இது!","explanation":"This poem belongs to the Puram genre under the theme of 'parisil' (gifts/rewards). The poet, Peruñcittiraṉār, has returned home after receiving a massive bounty of wealth from the generous chieftain Kumanan of Mt. Mutiram. Addressing his wife as the mistress of the house, he instructs her to distribute this wealth freely to everyone in need. He lists those who deserve it: those who love them, those they love, virtuous relatives, and the kind neighbors who lent them food and resources during their days of starvation. He urges her not to hoard anything for the future or even consult him, but to give open-handedly, celebrating the limitless generosity of Kumanan.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.4],[0.4,0.6],[0.6,1.2],[1.2,1.3],[1.3,1.8],[1.8,2.4],[2.4,3.7],[3.7,3.8],[3.8,4.65],[4.65,5.2],[5.2,6.1],[6.1,6.6],[6.6,6.8],[6.8,7.1],[7.1,8.3],[8.6,8.9],[8.9,9.1],[9.1,9.5],[9.5,10.7],[10.7,11.4],[11.4,11.6],[11.6,12.0],[12.0,13.3],[13.3,13.8],[13.8,14.0],[14.0,14.4],[14.4,15.7],[15.7,16.0],[16.0,16.47],[16.75,16.8],[16.9,17.4],[17.4,18.02],[18.1,18.5],[19.28,19.88],[19.88,20.08],[20.08,20.48],[20.48,20.88]],"female":[[0.0,0.4],[0.4,0.6],[0.6,1.2],[1.2,1.3],[1.3,1.8],[1.8,2.4],[2.4,2.4],[2.4,4.4],[4.4,4.71],[4.71,5.5],[5.5,6.5],[6.5,6.9],[6.9,7.2],[7.2,7.5],[7.5,8.7],[9.0,9.4],[9.4,9.5],[9.5,10.0],[10.0,11.2],[11.2,11.9],[11.9,12.2],[12.2,12.5],[12.5,14.0],[14.0,14.6],[14.6,14.9],[14.9,15.2],[15.2,16.7],[16.7,17.0],[17.0,17.8],[17.8,18.1],[18.1,19.0],[19.09,19.45],[19.45,20.0],[20.72,21.42],[21.42,21.62],[21.62,22.02],[22.02,22.52]]},"sync":[[["நின்","you"]],[["நயந்து","having loved"]],[["உறைநர்க்கும்","and to those who dwell"]],[["நீ","you"]],[["நயந்து","having loved"]],[["உறைநர்க்கும்","and to those who dwell"]],[["பன்மாண்","many glorious"]],[["கற்பின்","of virtue"],["நின்","your"]],[["கிளைமுதலோர்க்கும்","and to your chief relatives"]],[["கிளைமுதலோர்க்கும்","and to your chief relatives"]],[["கடும்பின்","of the family"]],[["கடும்பசி","severe hunger"]],[["தீர","to end"]],[["யாழ","oh"],["நின்","your"]],[["நெடுங்குறி","long-term loan"]],[["எதிர்ப்பை","loan"]],[["நல்கியோர்க்கும்","and to those who gave"]],[["நல்கியோர்க்கும்","and to those who gave"]],[["இன்னோர்க்கு","to these people"]],[["என்னாது","without distinguishing"]],[["என்னோடும்","and with me"]],[["சூழாது","without consulting"]],[["வல்லாங்கு","as we can / hoarding"]],[["வாழ்தும்","we shall live"]],[["என