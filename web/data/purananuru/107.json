ext":"பாரி","lemma":"பாரி","gloss":"Pāri"}],"gloss":"Pāri"},{"surface":"ஒருவனும்","parts":[{"text":"ஒருவன்","lemma":"ஒருவன்","gloss":"one man"},{"text":"உம்","lemma":"உம்","gloss":"also/only"}],"gloss":"only one man"},{"surface":"அல்லன்","parts":[{"text":"அல்","lemma":"அல்","gloss":"not"},{"text":"அன்","lemma":"அன்","gloss":"he"}],"gloss":"he is not"}]},{"words":[{"surface":"மாரியும்","parts":[{"text":"மாரி","lemma":"மாரி","gloss":"rain"},{"text":"உம்","lemma":"உம்","gloss":"also"}],"gloss":"rain also"},{"surface":"உண்டு","parts":[{"text":"உண்டு","lemma":"உண்டு","gloss":"exists"}],"gloss":"there is"},{"surface":"ஈண்டு","parts":[{"text":"ஈண்டு","lemma":"ஈண்டு","gloss":"here"}],"gloss":"here"},{"surface":"உலகு","parts":[{"text":"உலகு","lemma":"உலகு","gloss":"world"}],"gloss":"the world"},{"surface":"புரப்பதுவே","parts":[{"text":"புரப்பது","lemma":"புரத்தல்","gloss":"protecting"},{"text":"ஏ","lemma":"ஏ","gloss":"indeed"}],"gloss":"to protect indeed"}]}],"literal":"\"Pāri, Pāri,\" saying many times, praising, / one person they praise, the eloquent-tongued poets. / Pāri is not the only one. / Rain also exists here, to protect the world!","translation":"Poets with eloquent tongues praise a single man, crying out \"Pāri! Pāri!\" many times. But Pāri is not the only one who gives; there is also the rain here to protect and sustain the world!","modern":"\"பாரி, பாரி\" என்று பலமுறை துதித்துப் பாடி, செந்நாப் புலவர்கள் ஒருவனையே புகழ்கிறார்கள். பாரி ஒருவன் மட்டும் கொடை அளிப்பவன் அல்லன்; இவ்வுலகைக் காப்பதற்கு மழையும் இங்கே இருக்கிறது அல்லவா!","explanation":"This poem is composed by Kabilar in praise of his patron and close friend, the generous chieftain Vēḷ Pāri. Kabilar uses a beautiful device of mock-criticism to elevate Pāri's fame. He gently chides his fellow poets for praising only Pāri as the sole provider, pointing out that the rain also exists to sustain the world. By comparing Pāri's boundless generosity to the life-giving rain, Kabilar suggests that Pāri's giving is as natural, effortless, and essential to the world as the rain itself. The key words are 'pāri' (the chieftain), 'pulavar' (poets), and 'māri' (rain), establishing a poetic equivalence between the patron and nature's greatest gift.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.5],[0.5,0.8],[0.8,1.1],[1.1,1.4],[1.4,2.2],[2.2,2.4],[2.4,2.8],[2.8,3.2],[3.2,4.5],[4.5,4.9],[4.9,5.0],[5.0,6.4],[6.4,6.6],[6.6,6.7],[6.7,7.7],[7.7,7.8]],"female":[[0.0,0.5],[0.5,0.9],[0.9,1.4],[1.4,1.6],[1.6,2.8],[2.8,2.9],[2.9,3.3],[3.3,3.7],[3.7,4.9],[4.9,5.4],[5.4,5.6],[5.6,6.9],[6.9,7.1],[7.1,7.3],[7.3,8.2],[8.2,8.3]]},"sync":[[["பாரி","Pāri (the chieftain)"]],[["பாரி","Pāri"]],[["என்று","saying"],["பல","many times"]],[["ஏத்தி","praising"]],[["ஒருவர்","one person"]],[["புகழ்வர்","they praise"]],[["செந்நா","eloquent tongue"],["புலவர்","poets"]],[["புலவர்","poets"]],[["பாரி","Pāri"]],[["ஒருவனும்","only one man"]],[["அல்லன்","he is not"]],[["மாரியும்","rain also"]],[["உண்டு","there is"]],[["ஈண்டு","here"]],[["உலகு","the world"],["புரப்பதுவே","to protect indeed"]],[["புரப்பதுவே","to protect indeed"]]]}