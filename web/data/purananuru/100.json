{"text":"purananuru","n":100,"lines":["கையது வேலே காலன பு¨ ழல்","மெய்யது வியரே மிடற்றது பசும்புண் னக","வெட்சி மாமலர் வேங்கையடு விரைஇச்","சுரி இரும் பித்தை பொலியச் சூடி","வரி வயம் பொருத வயக்களிறு போல","இன்னும் மாறாது சினனே அன்னோ","உய்ந்தனர் அல்லர் இவண் உடற்றி யோரே","செறுவர் நோக்கிய கண் தன்","சிறுவனை நோக்கியுஞ் சிவப்பு ஆனாவே"],"tr":["kaiyatu vēlē kālaṉa pu ḻal","meyyatu viyarē miṭaṟṟatu pacumpuṇ ṉaka","veṭci māmalar vēṅkaiyaṭu viraiic","curi irum pittai poliyac cūṭi","vari vayam poruta vayakkaḷiṟu pōla","iṉṉum māṟātu ciṉaṉē aṉṉō","uyntaṉar allar ivaṇ uṭaṟṟi yōrē","ceṟuvar nōkkiya kaṇ taṉ","ciṟuvaṉai nōkkiyuñ civappu āṉāvē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"அரச வாகை","poet_ta":"ஔவையார்","addressed_ta":"அதியமான் நெடுமான் அஞ்சி","poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"8×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 34, vañcicīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 16, oṉṟā vañcittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கையது","tr":"kaiyatu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கை","tr":"kai"},{"kind":"nirai","text":"யது","tr":"yatu"}]},{"text":"வேலே","tr":"vēlē","foot":"tēmā","acai":[{"kind":"nēr","text":"வே","tr":"vē"},{"kind":"nēr","text":"லே","tr":"lē"}]},{"text":"கால","tr":"kāla","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"ல","tr":"la"}]},{"text":"னபுழல்","tr":"ṉapuḻal","foot":"puḷimā","acai":[{"kind":"nirai","text":"னபு","tr":"ṉapu"},{"kind":"nēr","text":"ழல்","tr":"ḻal"}]}],[{"text":"மெய்யது","tr":"meyyatu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மெய்","tr":"mey"},{"kind":"nirai","text":"யது","tr":"yatu"}]},{"text":"வியரே","tr":"viyarē","foot":"puḷimā","acai":[{"kind":"nirai","text":"விய","tr":"viya"},{"kind":"nēr","text":"ரே","tr":"rē"}]},{"text":"மிடற்றது","tr"