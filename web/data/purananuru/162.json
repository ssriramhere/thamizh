{"text":"purananuru","n":162,"lines":["இரவலர் புரவலை நீயும் அல்லை","புரவலர் இரவலர்க்கு இல்லையும் அல்லர்","இரவலர் உண்மையும் காண் இனி இரவலர்க்கு","ஈவோர் உண்மையும் காண் இனி நின்ஊர்க்","கடுமரம் வருந்தத் தந்து யாம் பிணித்த","நெடுநல் யானை எம் பரிசில்","கடுமான் தோன்றல் செல்வல் யானே"],"tr":["iravalar puravalai nīyum allai","puravalar iravalarkku illaiyum allar","iravalar uṇmaiyum kāṇ iṉi iravalarkku","īvōr uṇmaiyum kāṇ iṉi niṉūrk","kaṭumaram varuntat tantu yām piṇitta","neṭunal yāṉai em paricil","kaṭumāṉ tōṉṟal celval yāṉē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"பரிசில் விடை","poet_ta":"பெருஞ்சித்திரனார்","addressed_ta":"இளவெளிமான்","poet_tr":"Peruñcittiraṉār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 24, veṇcīr 3"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 13, veṇṭaḷai 12, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"இரவலர்","tr":"iravalar","foot":"karuviḷam","acai":[{"kind":"nirai","text":"இர","tr":"ira"},{"kind":"nirai","text":"வலர்","tr":"valar"}]},{"text":"புரவலை","tr":"puravalai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"புர","tr":"pura"},{"kind":"nirai","text":"வலை","tr":"valai"}]},{"text":"நீயு","tr":"nīyu","foot":"tēmā","acai":[{"kind":"nēr","text":"நீ","tr":"nī"},{"kind":"nēr","text":"யு","tr":"yu"}]},{"text":"மல்லை","tr":"mallai","foot":"tēmā","acai":[{"kind":"nēr","text":"மல்","tr":"mal"},{"kind":"nēr","text":"லை","tr":"lai"}]}],[{"text":"புரவல","tr":"puravala","foot":"karuviḷam","acai":[{"kind":"nirai","text":"புர","tr":"pura"},{"kind":"nirai","text":"வல","tr":"vala"}]},{"text":"ரிரவலர்க்","tr":"riravalark","foot":"karuviḷam","acai":[{"kind":"nirai","text":"ரிர","tr":"rira"},{"kind":"nirai","text":"வலர்க்","tr":"valark"}]},{"text":"கில்லை","tr":"killai","foot":"tēmā","acai":[{"kind":"nēr","text":"கில்"