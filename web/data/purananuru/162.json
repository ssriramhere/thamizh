loss":"they are not"}],"gloss":"they are not"}]},{"words":[{"surface":"இரவலர்","parts":[{"text":"இரவலர்","lemma":"iravalar","gloss":"supplicants"}],"gloss":"supplicants"},{"surface":"உண்மையும்","parts":[{"text":"உண்மை","lemma":"uṇmai","gloss":"existence"},{"text":"உம்","lemma":"um","gloss":"also"}],"gloss":"existence also"},{"surface":"காண்","parts":[{"text":"காண்","lemma":"kāṇ","gloss":"see"}],"gloss":"see"},{"surface":"இனி","parts":[{"text":"இனி","lemma":"iṉi","gloss":"now"}],"gloss":"now"},{"surface":"இரவலர்க்கு","parts":[{"text":"இரவலர்","lemma":"iravalar","gloss":"supplicants"},{"text":"கு","lemma":"ku","gloss":"to"}],"gloss":"to supplicants"}]},{"words":[{"surface":"ஈவோர்","parts":[{"text":"ஈவோர்","lemma":"īvōr","gloss":"givers"}],"gloss":"givers"},{"surface":"உண்மையும்","parts":[{"text":"உண்மை","lemma":"uṇmai","gloss":"existence"},{"text":"உம்","lemma":"um","gloss":"also"}],"gloss":"existence also"},{"surface":"காண்","parts":[{"text":"காண்","lemma":"kāṇ","gloss":"see"}],"gloss":"see"},{"surface":"இனி","parts":[{"text":"இனி","lemma":"iṉi","gloss":"now"}],"gloss":"now"},{"surface":"நின்","parts":[{"text":"நின்","lemma":"nī","gloss":"your"}],"gloss":"your"},{"surface":"ஊர்","parts":[{"text":"ஊர்","lemma":"ūr","gloss":"town"}],"gloss":"town"}]},{"words":[{"surface":"கடுமரம்","parts":[{"text":"கடு","lemma":"kaṭu","gloss":"strong"},{"text":"மரம்","lemma":"maram","gloss":"tree"}],"gloss":"strong tree"},{"surface":"வருந்த","parts":[{"text":"வருந்த","lemma":"varuntu","gloss":"to strain"}],"gloss":"to strain"},{"surface":"தந்து","parts":[{"text":"தந்து","lemma":"tā","gloss":"having brought"}],"gloss":"having brought"},{"surface":"யாம்","parts":[{"text":"யாம்","lemma":"yām","gloss":"we"}],"gloss":"we"},{"surface":"பிணித்த","parts":[{"text":"பிணித்த","lemma":"piṇi","gloss":"tied"}],"gloss":"tied"}]},{"words":[{"surface":"நெடுநல்","parts":[{"text":"நெடு","lemma":"neṭu","gloss":"tall"},{"text":"நல்","lemma":"nal","gloss":"good"}],"gloss":"tall and good"},{"surface":"யானை","parts":[{"text":"யானை","lemma":"yāṉai","gloss":"elephant"}],"gloss":"elephant"},{"surface":"எம்","parts":[{"text":"எம்","lemma":"yām","gloss":"our"}],"gloss":"our"},{"surface":"பரிசில்","parts":[{"text":"பரிசில்","lemma":"parisil","gloss":"gift"}],"gloss":"gift"}]},{"words":[{"surface":"கடுமான்","parts":[{"text":"கடு","lemma":"kaṭu","gloss":"swift"},{"text":"மான்","lemma":"mā","gloss":"horse"}],"gloss":"swift horse"},{"surface":"தோன்றல்","parts":[{"text":"தோன்றல்","lemma":"tōṉṟal","gloss":"lord"}],"gloss":"lord"},{"surface":"செல்வல்","parts":[{"text":"செல்வல்","lemma":"cel","gloss":"I will go"}],"gloss":"I will go"},{"surface":"யானே","parts":[{"text":"யான்","lemma":"yāṉ","gloss":"I"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"I indeed"}]}],"literal":"Supplicants' protector you also are not / Protectors to supplicants non-existent also are not / Supplicants' existence see now! To supplicants / Givers' existence see now! In your town / Strong tree to strain, having brought, we tied / Tall, good elephant is our gift / Swift-horse lord! I will go indeed!","translation":"You are not the protector of supplicants, nor are there no protectors for those who ask. See now the existence of supplicants! And see now the existence of givers to those supplicants! The tall, fine elephant that we brought and tied to the straining strong tree in your town is our gift. O lord of swift horses! I am leaving!","modern":"இரவலர்களைக் காப்பவன் நீ மட்டும் அல்ல; இரவலர்களுக்குக் கொடுக்கும் வள்ளல்களும் இல்லாமல் போகவில்லை. இரவலர்கள் இன்னும் இருக்கிறார்கள் என்பதை இனி நீ காண்பாய்! அவர்களுக்குக் கொடுக்கும் வள்ளல்களும் இருக்கிறார்கள் என்பதை இனி நீ காண்பாய்! உன்னுடைய ஊரில் உள்ள காவல் மரம் வருந்தும்படி கொண்டு வந்து நாம் கட்டியிருக்கும் நெடிய, நல்ல யானையே நாம் உனக்குத் தரும் பரிசாகும். வேகமான குதிரைகளைக் கொண்ட தலைவனே! நான் செல்கிறேன்!","explanation":"This poem is spoken by the poet Peruñcittiraṉār to the chieftain Iḷaveḷimāṉ. Having been insulted by Iḷaveḷimāṉ's meager offering, the poet went to the generous patron Kumaṇaṉ, who gifted him a majestic elephant. The poet returned to Iḷaveḷimāṉ's town, tied the elephant to a tree in the town's common ground, and spoke these words of defiance. He asserts that while Iḷaveḷimāṉ is not a true patron, the world does not lack generous givers who appreciate poets. By leaving the elephant behind as a 'gift' to the chieftain, the poet reverses the roles of giver and receiver, asserting his supreme dignity. The key words are puravalar (patrons), īvōr (givers), and yāṉai (elephant), which highlight the contrast between miserliness and true grandeur.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,0.84],[0.9,1.6],[1.6,1.8],[1.8,2.8],[2.8,3.0],[3.0,3.8],[3.8,4.0],[4.0,5.2],[5.2,5.3],[5.3,5.9],[5.9,6.0],[6.0,6.8],[6.8,6.8],[6.8,8.2],[8.2,8.4],[8.4,8.6],[8.6,8.9],[8.9,9.0],[9.0,10.8],[10.8,10.9],[10.9,11.2],[11.2,11.5],[11.5,12.4],[12.4,12.8],[12.8,12.9],[12.9,13.1],[13.1,14.4],[14.4,14.5],[14.5,15.3],[15.3,15.3]],"female":[[0.0,0.8],[0.8,1.01],[1.1,1.8],[1.8,2.0],[2.0,3.0],[3.0,3.2],[3.2,4.1],[4.1,4.3],[4.3,5.8],[5.8,5.8],[5.8,6.5],[6.5,6.7],[6.7,7.5],[7.87,8.23],[8.6,9.0],[9.0,9.2],[9.2,9.4],[9.4,10.1],[10.1,11.2],[11.2,11.3],[11.3,11.9],[11.9,12.2],[12.2,12.4],[12.4,13.5],[13.5,13.9],[13.9,14.0],[14.0,14.2],[14.2,15.7],[15.7,15.8],[15.8,16.7],[16.7,16.7]]}}