{"text":"purananuru","n":102,"lines":["எருதே இளைய நுகம் உண ராவே","சகடம் பண்டம் பெரிதுபெய் தன்றே","அவல் இழியினும் மிசை ஏறினும்","அவணது அறியுநர் யார் என உமணர்","கீழ்மரத்து யாத்த சேமஅச்சு அன்ன","இசை விளங்கு கவிகை நெடியோய் திங்கள்","நாள்நிறை மதியத்து அனையை இருள்","யாவண தோ நின் நிழல்வாழ் வோர்க்கே"],"tr":["erutē iḷaiya nukam uṇa rāvē","cakaṭam paṇṭam peritupey taṉṟē","aval iḻiyiṉum micai ēṟiṉum","avaṇatu aṟiyunar yār eṉa umaṇar","kīḻmarattu yātta cēmaaccu aṉṉa","icai viḷaṅku kavikai neṭiyōy tiṅkaḷ","nāḷniṟai matiyattu aṉaiyai iruḷ","yāvaṇa tō niṉ niḻalvāḻ vōrkkē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"இயன்மொழி","poet_ta":"ஔவையார்","addressed_ta":"அதியமான் நெடுமான் அஞ்சியின் மகன் பொகுட்டெழினி","poet_tr":"Auvaiyār"},"scan":{"meter":"iṇaikkuṟaḷ āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 31"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 17, āciriyattaḷai 13"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"எருதே","tr":"erutē","foot":"puḷimā","acai":[{"kind":"nirai","text":"எரு","tr":"eru"},{"kind":"nēr","text":"தே","tr":"tē"}]},{"text":"யிளைய","tr":"yiḷaiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"யிளை","tr":"yiḷai"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"நுகமுண","tr":"nukamuṇa","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நுக","tr":"nuka"},{"kind":"nirai","text":"முண","tr":"muṇa"}]},{"text":"ராவே","tr":"rāvē","foot":"tēmā","acai":[{"kind":"nēr","text":"ரா","tr":"rā"},{"kind":"nēr","text":"வே","tr":"vē"}]}],[{"text":"சகடம்","tr":"cakaṭam","foot":"puḷimā","acai":[{"kind":"nirai","text":"சக","tr":"caka"},{"kind":"nēr","text":"டம்","tr":"ṭam"}]},{"text":"பண்டம்","tr":"paṇṭam","foot":"tēmā","acai":[{"kind":"nēr","text":"பண்","tr":"paṇ"},{"kind":"nēr","text":"டம்","tr":"ṭam"}]},{"text":"பெரிதுபெய்","tr":"peritupey","foot":"karuviḷam","acai":[{"kind":"nirai","te