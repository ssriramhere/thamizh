{"text":"purananuru","n":185,"lines":["கால்பார் கோத்து ஞாலத்து இயக்கும்","காவற் சாகாடு உகைப்போன் மாணின்","ஊறுஇன்றாகி ஆறுஇனிது படுமே","உய்த்தல் தேற்றான் ஆயின் வைகலும்","பகைக்கூழ் அள்ளற் பட்டு","மிகப்பல் தீநோய் தலைத்தலைத் தருமே"],"tr":["kālpār kōttu ñālattu iyakkum","kāvaṟ cākāṭu ukaippōṉ māṇiṉ","ūṟuiṉṟāki āṟuiṉitu paṭumē","uyttal tēṟṟāṉ āyiṉ vaikalum","pakaikkūḻ aḷḷaṟ paṭṭu","mikappal tīnōy talaittalait tarumē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"பொருண்மொழிக் காஞ்சி","poet_ta":"தொண்டைமான் இளந்திரையன்","poet_tr":"Toṇṭaimāṉ Iḷantiraiyaṉ"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 23"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 17, veṇṭaḷai 5"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கால்பார்","tr":"kālpār","foot":"tēmā","acai":[{"kind":"nēr","text":"கால்","tr":"kāl"},{"kind":"nēr","text":"பார்","tr":"pār"}]},{"text":"கோத்து","tr":"kōttu","foot":"tēmā","acai":[{"kind":"nēr","text":"கோத்","tr":"kōt"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"ஞாலத்","tr":"ñālat","foot":"tēmā","acai":[{"kind":"nēr","text":"ஞா","tr":"ñā"},{"kind":"nēr","text":"லத்","tr":"lat"}]},{"text":"தியக்கும்","tr":"tiyakkum","foot":"puḷimā","acai":[{"kind":"nirai","text":"தியக்","tr":"tiyak"},{"kind":"nēr","text":"கும்","tr":"kum"}]}],[{"text":"காவற்","tr":"kāvaṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"வற்","tr":"vaṟ"}]},{"text":"சாகா","tr":"cākā","foot":"tēmā","acai":[{"kind":"nēr","text":"சா","tr":"cā"},{"kind":"nēr","text":"கா","tr":"kā"}]},{"text":"டுகைப்போன்","tr":"ṭukaippōṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"டுகைப்","tr":"ṭukaip"},{"kind":"nēr","text":"போன்","tr":"pōṉ"}]},{"text":"மாணி","tr":"māṇi","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"ணி","tr"