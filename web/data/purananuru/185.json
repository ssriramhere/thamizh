d indeed"}]},{"words":[{"surface":"உய்த்தல்","parts":[{"text":"உய்","lemma":"uy","gloss":"guide/lead"},{"text":"த்தல்","lemma":"ttal","gloss":"verbal noun suffix"}],"gloss":"guiding/driving"},{"surface":"தேற்றான்","parts":[{"text":"தேற்றான்","lemma":"தேற்றான்","gloss":"he who does not know"}],"gloss":"he who does not know","split_unverified":true},{"surface":"ஆயின்","parts":[{"text":"ஆய்","lemma":"āy","gloss":"become"},{"text":"இன்","lemma":"iṉ","gloss":"if"}],"gloss":"if"},{"surface":"வைகலும்","parts":[{"text":"வைகல்","lemma":"vaikal","gloss":"day"},{"text":"உம்","lemma":"um","gloss":"every/all"}],"gloss":"every day"}]},{"words":[{"surface":"பகைக்கூழ்","parts":[{"text":"பகை","lemma":"pakai","gloss":"enmity"},{"text":"கூழ்","lemma":"kūḻ","gloss":"slush/mud"}],"gloss":"slush of enmity"},{"surface":"அள்ளல்","parts":[{"text":"அள்ளல்","lemma":"aḷḷal","gloss":"mud/mire"}],"gloss":"in the mire"},{"surface":"பட்டு","parts":[{"text":"பட்டு","lemma":"பட்டு","gloss":"having sunk"}],"gloss":"having sunk","split_unverified":true}]},{"words":[{"surface":"மிகப்பல்","parts":[{"text":"மிக","lemma":"mika","gloss":"much/very"},{"text":"பல்","lemma":"pal","gloss":"many"}],"gloss":"very many"},{"surface":"தீநோய்","parts":[{"text":"தீ","lemma":"tī","gloss":"evil/bad"},{"text":"நோய்","lemma":"nōy","gloss":"disease/affliction"}],"gloss":"evil afflictions"},{"surface":"தலைத்தலை","parts":[{"text":"தலை","lemma":"talai","gloss":"head/first"},{"text":"தலை","lemma":"talai","gloss":"head/first"}],"gloss":"repeatedly"},{"surface":"தருமே","parts":[{"text":"தரு","lemma":"taru","gloss":"give/bring"},{"text":"உம்","lemma":"um","gloss":"will"},{"text":"ஏ","lemma":"ē","gloss":"emphasis"}],"gloss":"will bring indeed"}]}],"literal":"Wheel and axle fitted together, driving on the earth, / the protective cart's driver, if he is capable, / without hindrance, the path will pleasantly proceed. / If he does not know how to guide it, daily, / sinking into the mud of the hostile swamp, / it will bring very many evil afflictions repeatedly.","translation":"If the driver of the protective cart, which moves on the earth with its wheels and axle fitted together, is highly capable, the journey will proceed pleasantly without any hindrance. But if he does not know how to guide it, the cart will sink daily into the deep mud of enmity, bringing many severe troubles repeatedly.","modern":"சக்கரத்தையும் அச்சையும் இணைத்து உலகத்தில் செலுத்தப்படும் பாதுகாப்பான வண்டியை ஓட்டுபவன் தகுதி உடையவனாக இருந்தால், எந்த இடையூறும் இல்லாமல் வழி இனிதாக அமையும். ஆனால், அவன் வண்டியைச் செலுத்தத் தெரியாதவனாக இருந்தால், நாள்தோறும் பகைமை என்னும் சேற்றில் சிக்கி, அது பல கொடிய துன்பங்களை மீண்டும் மீண்டும் தரும்.","explanation":"This poem belongs to the Potuviyal tiṇai and offers general moral guidance to rulers. The poet, Tondaiman Ilandiraiyan, uses the extended metaphor of a cart and its driver to represent a country and its king. If the king (the driver) is capable and wise, the administration of the state (the cart) runs smoothly and safely. However, if the ruler is incompetent and does not know how to govern, the nation will sink into the swamp of hostility and suffer endless miseries. The key words are 'kāval sākāṭu' (protective cart/state), 'ukaippōṉ' (driver/king), and 'aḷḷal' (mud/mire of enmity).","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,0.7],[0.7,1.1],[1.1,1.5],[1.5,2.3],[2.3,2.3],[2.3,2.43],[2.82,3.6],[3.6,5.0],[5.0,5.6],[5.6,5.8],[5.8,7.0],[7.0,7.0],[7.0,7.5],[7.5,7.9],[8.26,8.45],[8.63,8.99],[8.99,9.9],[9.9,10.68],[10.92,11.0],[11.0,11.6],[11.6,12.0]],"female":[[0.0,0.7],[0.7,0.8],[0.8,1.1],[1.1,1.6],[1.6,2.8],[2.8,2.9],[2.9,3.9],[3.9,3.92],[3.92,5.7],[5.7,6.5],[6.5,6.7],[6.7,8.0],[8.0,8.0],[8.0,8.5],[8.5,8.8],[8.8,8.8],[8.8,8.8],[8.8,8.8],[8.8,12.34],[12.5,12.7],[12.7,13.2],[13.2,13.7]]}}