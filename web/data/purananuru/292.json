{"text":"purananuru","n":292,"lines":["வேந்தற்கு ஏந்திய தீந்தண் நறவம்","யாம்தனக்கு உறுமறை வளாவ விலக்கி","வாய்வாள் பற்றி நின்றனென் என்று","சினவல் ஓம்புமின் சிறுபுல் லாளர்","ஈண்டே போல வேண்டுவன் ஆயின்","என்முறை வருக என்னான் கம்மென","எழுதரு பெரும்படை விலக்கி","ஆண்டு நிற்கும் ஆண்தகை யன்னே"],"tr":["vēntaṟku ēntiya tīntaṇ naṟavam","yāmtaṉakku uṟumaṟai vaḷāva vilakki","vāyvāḷ paṟṟi niṉṟaṉeṉ eṉṟu","ciṉaval ōmpumiṉ ciṟupul lāḷar","īṇṭē pōla vēṇṭuvaṉ āyiṉ","eṉmuṟai varuka eṉṉāṉ kammeṉa","eḻutaru perumpaṭai vilakki","āṇṭu niṟkum āṇtakai yaṉṉē"],"colophon":{"tinai":"vañci","tinai_ta":"வஞ்சி","turai_ta":"பெருஞ்சோற்று நிலை","poet_ta":"விரிச்சியூர் நன்னாகனார்","poet_tr":"Viricciyūr Naṉṉākaṉār"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"8×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 32"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 24, veṇṭaḷai 7"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"வேந்தற்","tr":"vēntaṟ","foot":"tēmā","acai":[{"kind":"nēr","text":"வேந்","tr":"vēn"},{"kind":"nēr","text":"தற்","tr":"taṟ"}]},{"text":"கேந்திய","tr":"kēntiya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கேந்","tr":"kēn"},{"kind":"nirai","text":"திய","tr":"tiya"}]},{"text":"தீந்தண்","tr":"tīntaṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"தீந்","tr":"tīn"},{"kind":"nēr","text":"தண்","tr":"taṇ"}]},{"text":"நறவம்","tr":"naṟavam","foot":"puḷimā","acai":[{"kind":"nirai","text":"நற","tr":"naṟa"},{"kind":"nēr","text":"வம்","tr":"vam"}]}],[{"text":"யாம்தனக்","tr":"yāmtaṉak","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யாம்","tr":"yām"},{"kind":"nirai","text":"தனக்","tr":"taṉak"}]},{"text":"குறுமறை","tr":"kuṟumaṟai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"குறு","tr":"kuṟu"},{"kind":"nirai","text":"மறை","tr":"maṟai"}]},{"text":"வளாவ","tr":"vaḷāva","foot":"puḷimā","acai":[{"kind":"nirai","text":"வளா","tr":"vaḷā"},{"kind":"nē