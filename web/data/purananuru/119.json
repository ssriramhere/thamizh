{"text":"purananuru","n":119,"lines":["கார்ப் பெயல் தலைஇய காண்பு இன் காலைக்","களிற்று முக வரியின் தெறுழ்வீ பூப்பச்","செம் புற்று ஈயலின் இன்அளைப் புளித்து","மெந்தினை யாணர்த்து நந்துங் கொல்லோ","நிழலில் நீளிடைத் தனிமரம் போலப்","பணைகெழு வேந்தரை இறந்தும்","இரவலர்க்கு ஈயும் வள்ளியோன் நாடே"],"tr":["kārp peyal talaiiya kāṇpu iṉ kālaik","kaḷiṟṟu muka variyiṉ teṟuḻvī pūppac","cem puṟṟu īyaliṉ iṉaḷaip puḷittu","mentiṉai yāṇarttu nantuṅ kollō","niḻalil nīḷiṭait taṉimaram pōlap","paṇaikeḻu vēntarai iṟantum","iravalarkku īyum vaḷḷiyōṉ nāṭē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"கையறுநிலை","poet_ta":"கபிலர்","poet_tr":"Kapilar"},"scan":{"meter":"nilaimaṇṭila āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"7×4 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 28"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 15, veṇṭaḷai 12"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"கார்ப்பெயல்","tr":"kārppeyal","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கார்ப்","tr":"kārp"},{"kind":"nirai","text":"பெயல்","tr":"peyal"}]},{"text":"தலைஇய","tr":"talaiiya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தலை","tr":"talai"},{"kind":"nirai","text":"இய","tr":"iya"}]},{"text":"காண்பின்","tr":"kāṇpiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"காண்","tr":"kāṇ"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]},{"text":"காலைக்","tr":"kālaik","foot":"tēmā","acai":[{"kind":"nēr","text":"கா","tr":"kā"},{"kind":"nēr","text":"லைக்","tr":"laik"}]}],[{"text":"களிற்றுமு","tr":"kaḷiṟṟumu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"களிற்","tr":"kaḷiṟ"},{"kind":"nirai","text":"றுமு","tr":"ṟumu"}]},{"text":"கவரியின்","tr":"kavariyiṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கவ","tr":"kava"},{"kind":"nirai","text":"ரியின்","tr":"riyiṉ"}]},{"text":"தெறுழ்வீ","tr":"teṟuḻvī","foot":"puḷimā","acai":[{"kind":"nirai","text":"தெறுழ்","tr":"teṟuḻ"},{"kind":