{"text":"purananuru","n":288,"lines":["மண்கொள வரிந்த வைந்நுதி மறுப்பின்","அண்ணல் நல்ஏறு இரண்டு உடன் மடுத்து","வென்றதன் பச்சை சீவாது போர்த்த","திண்பிணி முரசம் இடைப்புலத்து இரங்க","ஆர்அமர் மயங்கிய ஞாட்பின் தெறுவர","நெடுவேல் பாய்ந்த நாணுடை நெஞ்சத்து","அருகுகை … மன்ற","குருதியடு துயல்வரும் மார்பின்","முயக்கிடை ஈயாது மொய்த்தன பருந்தே"],"tr":["maṇkoḷa varinta vainnuti maṟuppiṉ","aṇṇal nalēṟu iraṇṭu uṭaṉ maṭuttu","veṉṟataṉ paccai cīvātu pōrtta","tiṇpiṇi muracam iṭaippulattu iraṅka","āramar mayaṅkiya ñāṭpiṉ teṟuvara","neṭuvēl pāynta nāṇuṭai neñcattu","arukukai maṉṟa","kurutiyaṭu tuyalvarum mārpiṉ","muyakkiṭai īyātu moyttaṉa paruntē"],"colophon":{"tinai":"tumpai","tinai_ta":"தும்பை","turai_ta":"மூதின் முல்லை","poet_ta":"கழாத்தலையார்","poet_tr":"Kaḻāttalaiyār"},"scan":{"meter":"iṇaikkuṟaḷ āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"8×4, 1×2 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 34"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 15"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மண்கொள","tr":"maṇkoḷa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மண்","tr":"maṇ"},{"kind":"nirai","text":"கொள","tr":"koḷa"}]},{"text":"வரிந்த","tr":"varinta","foot":"puḷimā","acai":[{"kind":"nirai","text":"வரிந்","tr":"varin"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"வைந்நுதி","tr":"vainnuti","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வைந்","tr":"vain"},{"kind":"nirai","text":"நுதி","tr":"nuti"}]},{"text":"மறுப்பி","tr":"maṟuppi","foot":"puḷimā","acai":[{"kind":"nirai","text":"மறுப்","tr":"maṟup"},{"kind":"nēr","text":"பி","tr":"pi"}]}],[{"text":"னண்ணல்","tr":"ṉaṇṇal","foot":"tēmā","acai":[{"kind":"nēr","text":"னண்","tr":"ṉaṇ"},{"kind":"nēr","text":"ணல்","tr":"ṇal"}]},{"text":"நல்லே","tr":"nallē","foot":"tēmā","acai":[{"kind":"nēr","text":"நல்","tr":"nal"},{"kind":"nēr","text":"லே","tr":"lē"}]},{"text":"றிரண்டுடன்","tr":"ṟiraṇṭuṭaṉ","foot"