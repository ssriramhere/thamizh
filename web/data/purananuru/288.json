{"text":"purananuru","n":288,"lines":["மண்கொள வரிந்த வைந்நுதி மறுப்பின்","அண்ணல் நல்ஏறு இரண்டு உடன் மடுத்து","வென்றதன் பச்சை சீவாது போர்த்த","திண்பிணி முரசம் இடைப்புலத்து இரங்க","ஆர்அமர் மயங்கிய ஞாட்பின் தெறுவர","நெடுவேல் பாய்ந்த நாணுடை நெஞ்சத்து","அருகுகை … மன்ற","குருதியடு துயல்வரும் மார்பின்","முயக்கிடை ஈயாது மொய்த்தன பருந்தே"],"tr":["maṇkoḷa varinta vainnuti maṟuppiṉ","aṇṇal nalēṟu iraṇṭu uṭaṉ maṭuttu","veṉṟataṉ paccai cīvātu pōrtta","tiṇpiṇi muracam iṭaippulattu iraṅka","āramar mayaṅkiya ñāṭpiṉ teṟuvara","neṭuvēl pāynta nāṇuṭai neñcattu","arukukai maṉṟa","kurutiyaṭu tuyalvarum mārpiṉ","muyakkiṭai īyātu moyttaṉa paruntē"],"colophon":{"tinai":"tumpai","tinai_ta":"தும்பை","turai_ta":"மூதின் முல்லை","poet_ta":"கழாத்தலையார்","poet_tr":"Kaḻāttalaiyār"},"scan":{"meter":"iṇaikkuṟaḷ āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"9 lines"},{"name":"feet per line","ok":true,"detail":"8×4, 1×2 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 34"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 18, veṇṭaḷai 15"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மண்கொள","tr":"maṇkoḷa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மண்","tr":"maṇ"},{"kind":"nirai","text":"கொள","tr":"koḷa"}]},{"text":"வரிந்த","tr":"varinta","foot":"puḷimā","acai":[{"kind":"nirai","text":"வரிந்","tr":"varin"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"வைந்நுதி","tr":"vainnuti","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வைந்","tr":"vain"},{"kind":"nirai","text":"நுதி","tr":"nuti"}]},{"text":"மறுப்பி","tr":"maṟuppi","foot":"puḷimā","acai":[{"kind":"nirai","text":"மறுப்","tr":"maṟup"},{"kind":"nēr","text":"பி","tr":"pi"}]}],[{"text":"னண்ணல்","tr":"ṉaṇṇal","foot":"tēmā","acai":[{"kind":"nēr","text":"னண்","tr":"ṉaṇ"},{"kind":"nēr","text":"ணல்","tr":"ṇal"}]},{"text":"நல்லே","tr":"nallē","foot":"tēmā","acai":[{"kind":"nēr","text":"நல்","tr":"nal"},{"kind":"nēr","text":"லே","tr":"lē"}]},{"text":"றிரண்டுடன்","tr":"ṟiraṇṭuṭaṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"றிரண்","tr":"ṟiraṇ"},{"kind":"nirai","text":"டுடன்","tr":"ṭuṭaṉ"}]},{"text":"மடுத்து","tr":"maṭuttu","foot":"puḷimā","acai":[{"kind":"nirai","text":"மடுத்","tr":"maṭut"},{"kind":"nēr","text":"து","tr":"tu"}]}],[{"text":"வென்றதன்","tr":"veṉṟataṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வென்","tr":"veṉ"},{"kind":"nirai","text":"றதன்","tr":"ṟataṉ"}]},{"text":"பச்சை","tr":"paccai","foot":"tēmā","acai":[{"kind":"nēr","text":"பச்","tr":"pac"},{"kind":"nēr","text":"சை","tr":"cai"}]},{"text":"சீவா","tr":"cīvā","foot":"tēmā","acai":[{"kind":"nēr","text":"சீ","tr":"cī"},{"kind":"nēr","text":"வா","tr":"vā"}]},{"text":"துபோர்த்த","tr":"tupōrtta","foot":"puḷimā","acai":[{"kind":"nirai","text":"துபோர்த்","tr":"tupōrt"},{"kind":"nēr","text":"த","tr":"ta"}]}],[{"text":"திண்பிணி","tr":"tiṇpiṇi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"திண்","tr":"tiṇ"},{"kind":"nirai","text":"பிணி","tr":"piṇi"}]},{"text":"முரச","tr":"muraca","foot":"puḷimā","acai":[{"kind":"nirai","text":"முர","tr":"mura"},{"kind":"nēr","text":"ச","tr":"ca"}]},{"text":"மிடைப்புலத்","tr":"miṭaippulat","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மிடைப்","tr":"miṭaip"},{"kind":"nirai","text":"புலத்","tr":"pulat"}]},{"text":"திரங்க","tr":"tiraṅka","foot":"puḷimā","acai":[{"kind":"nirai","text":"திரங்","tr":"tiraṅ"},{"kind":"nēr","text":"க","tr":"ka"}]}],[{"text":"வாரமர்","tr":"vāramar","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nirai","text":"ரமர்","tr":"ramar"}]},{"text":"மயங்கிய","tr":"mayaṅkiya","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மயங்","tr":"mayaṅ"},{"kind":"nirai","text":"கிய","tr":"kiya"}]},{"text":"ஞாட்பின்","tr":"ñāṭpiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"ஞாட்","tr":"ñāṭ"},{"kind":"nēr","text":"பின்","tr":"piṉ"}]},{"text":"தெறுவர","tr":"teṟuvara","foot":"karuviḷam","acai":[{"kind":"nirai","text":"தெறு","tr":"teṟu"},{"kind":"nirai","text":"வர","tr":"vara"}]}],[{"text":"நெடுவேல்","tr":"neṭuvēl","foo