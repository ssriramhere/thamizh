{"text":"purananuru","n":124,"lines":["நாளன்று போடிப் புள்ளிடைத் தட்பப்","பதனன்று புக்குத் திறனன்று மொழியினும்","வறிது பெயர்குநர் அல்லர் நெறி கொளப்","பாடு ஆன்று இரங்கும் அருவிப்","பீடு கெழு மலையற் பாடி யோரே"],"tr":["nāḷaṉṟu pōṭip puḷḷiṭait taṭpap","pataṉaṉṟu pukkut tiṟaṉaṉṟu moḻiyiṉum","vaṟitu peyarkunar allar neṟi koḷap","pāṭu āṉṟu iraṅkum aruvip","pīṭu keḻu malaiyaṟ pāṭi yōrē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"இயன் மொழி","poet_ta":"கபிலர்","addressed_ta":"மலையமான் திருமுடிக்காரி","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 13, āciriyattaḷai 4, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நாளன்","tr":"nāḷaṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"ளன்","tr":"ḷaṉ"}]},{"text":"றுபோடிப்","tr":"ṟupōṭip","foot":"puḷimā","acai":[{"kind":"nirai","text":"றுபோ","tr":"ṟupō"},{"kind":"nēr","text":"டிப்","tr":"ṭip"}]},{"text":"புள்ளிடைத்","tr":"puḷḷiṭait","foot":"kūviḷam","acai":[{"kind":"nēr","text":"புள்","tr":"puḷ"},{"kind":"nirai","text":"ளிடைத்","tr":"ḷiṭait"}]},{"text":"தட்பப்","tr":"taṭpap","foot":"tēmā","acai":[{"kind":"nēr","text":"தட்","tr":"taṭ"},{"kind":"nēr","text":"பப்","tr":"pap"}]}],[{"text":"பதனன்","tr":"pataṉaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பத","tr":"pata"},{"kind":"nēr","text":"னன்","tr":"ṉaṉ"}]},{"text":"றுபுக்குத்","tr":"ṟupukkut","foot":"puḷimā","acai":[{"kind":"nirai","text":"றுபுக்","tr":"ṟupuk"},{"kind":"nēr","text":"குத்","tr":"kut"}]},{"text":"திறனன்று","tr":"tiṟaṉaṉṟu","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"திற","tr":"tiṟa"},{"kind":"nēr","text":"னன்","tr":"ṉaṉ"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"மொழியினும்","tr":"moḻiyiṉum","foot":"karuviḷ