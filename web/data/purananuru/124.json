{"text":"purananuru","n":124,"lines":["நாளன்று போடிப் புள்ளிடைத் தட்பப்","பதனன்று புக்குத் திறனன்று மொழியினும்","வறிது பெயர்குநர் அல்லர் நெறி கொளப்","பாடு ஆன்று இரங்கும் அருவிப்","பீடு கெழு மலையற் பாடி யோரே"],"tr":["nāḷaṉṟu pōṭip puḷḷiṭait taṭpap","pataṉaṉṟu pukkut tiṟaṉaṉṟu moḻiyiṉum","vaṟitu peyarkunar allar neṟi koḷap","pāṭu āṉṟu iraṅkum aruvip","pīṭu keḻu malaiyaṟ pāṭi yōrē"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"இயன் மொழி","poet_ta":"கபிலர்","addressed_ta":"மலையமான் திருமுடிக்காரி","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 17, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 13, āciriyattaḷai 4, kalittaḷai 1"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"நாளன்","tr":"nāḷaṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"நா","tr":"nā"},{"kind":"nēr","text":"ளன்","tr":"ḷaṉ"}]},{"text":"றுபோடிப்","tr":"ṟupōṭip","foot":"puḷimā","acai":[{"kind":"nirai","text":"றுபோ","tr":"ṟupō"},{"kind":"nēr","text":"டிப்","tr":"ṭip"}]},{"text":"புள்ளிடைத்","tr":"puḷḷiṭait","foot":"kūviḷam","acai":[{"kind":"nēr","text":"புள்","tr":"puḷ"},{"kind":"nirai","text":"ளிடைத்","tr":"ḷiṭait"}]},{"text":"தட்பப்","tr":"taṭpap","foot":"tēmā","acai":[{"kind":"nēr","text":"தட்","tr":"taṭ"},{"kind":"nēr","text":"பப்","tr":"pap"}]}],[{"text":"பதனன்","tr":"pataṉaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பத","tr":"pata"},{"kind":"nēr","text":"னன்","tr":"ṉaṉ"}]},{"text":"றுபுக்குத்","tr":"ṟupukkut","foot":"puḷimā","acai":[{"kind":"nirai","text":"றுபுக்","tr":"ṟupuk"},{"kind":"nēr","text":"குத்","tr":"kut"}]},{"text":"திறனன்று","tr":"tiṟaṉaṉṟu","foot":"puḷimāṅkāy","acai":[{"kind":"nirai","text":"திற","tr":"tiṟa"},{"kind":"nēr","text":"னன்","tr":"ṉaṉ"},{"kind":"nēr","text":"று","tr":"ṟu"}]},{"text":"மொழியினும்","tr":"moḻiyiṉum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மொழி","tr":"moḻi"},{"kind":"nirai","text":"யினும்","tr":"yiṉum"}]}],[{"text":"வறிது","tr":"vaṟitu","foot":"puḷimā","acai":[{"kind":"nirai","text":"வறி","tr":"vaṟi"},{"kind":"nēr","text":"து","tr":"tu"}]},{"text":"பெயர்குந","tr":"peyarkuna","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெயர்","tr":"peyar"},{"kind":"nirai","text":"குந","tr":"kuna"}]},{"text":"ரல்லர்","tr":"rallar","foot":"tēmā","acai":[{"kind":"nēr","text":"ரல்","tr":"ral"},{"kind":"nēr","text":"லர்","tr":"lar"}]},{"text":"நெறிகொளப்","tr":"neṟikoḷap","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நெறி","tr":"neṟi"},{"kind":"nirai","text":"கொளப்","tr":"koḷap"}]}],[{"text":"பாடான்","tr":"pāṭāṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"டான்","tr":"ṭāṉ"}]},{"text":"றிரங்கு","tr":"ṟiraṅku","foot":"puḷimā","acai":[{"kind":"nirai","text":"றிரங்","tr":"ṟiraṅ"},{"kind":"nēr","text":"கு","tr":"ku"}]},{"text":"மருவிப்","tr":"maruvip","foot":"puḷimā","acai":[{"kind":"nirai","text":"மரு","tr":"maru"},{"kind":"nēr","text":"விப்","tr":"vip"}]}],[{"text":"பீடு","tr":"pīṭu","foot":"tēmā","acai":[{"kind":"nēr","text":"பீ","tr":"pī"},{"kind":"nēr","text":"டு","tr":"ṭu"}]},{"text":"கெழுமலையற்","tr":"keḻumalaiyaṟ","foot":"karuviḷaṅkāy","acai":[{"kind":"nirai","text":"கெழு","tr":"keḻu"},{"kind":"nirai","text":"மலை","tr":"malai"},{"kind":"nēr","text":"யற்","tr":"yaṟ"}]},{"text":"பாடி","tr":"pāṭi","foot":"tēmā","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nēr","text":"டி","tr":"ṭi"}]},{"text":"யோரே","tr":"yōrē","foot":"tēmā","acai":[{"kind":"nēr","text":"யோ","tr":"yō"},{"kind":"nēr","text":"ரே","tr":"rē"}]}]]},"ai":{"lines":[{"words":[{"surface":"நாள்","parts":[{"text":"நாள்","lemma":"நாள்","gloss":"day"}],"gloss":"day"},{"surface":"அன்று","parts":[{"text":"அன்று","lemma":"அன்று","gloss":"not being"}],"gloss":"not being"},{"surface":"போடி","parts":[{"text":"போடி","lemma":"போடி","gloss":"having gone"}],"gloss":"having gone"},{"surface":"புள்","parts":[{"text":"புள்","lemma":"புள்","gloss":"bird"}],"gloss":"bird"},{"surface":"இடை","parts":[{"text":"இடை","lemma":"இடை","gloss":"middle"}],"gloss":"middle"},{"surface":"தட்ப","parts":[{"text":"தட்ப","lemma":"தடு","gloss":"to block"}],"gloss":"to block"}]},{"words":[{"surface":"பதன்","parts":[{"text":"பதன்","lemma":"பதம்","gloss":"proper time"}],"gloss":"proper time"},{"surface":"அன்று","parts":[{"text":"அன்று","lemma":"அன்று","gloss":"not being"}],"gloss":"not being"},{"surface":"புக்கு","parts":[{"text":"புக்கு","lemma":"புகு","gloss":"having entered"}],"gloss":"having entered"},{"surface":"திறன்","parts":[{"text":"திறன்","lemma":"திறம்","gloss":"appropriate manner"}],"gloss":"appropriate manner"},{"surface":"அன்று","parts":[{"text":"அன்று","lemma":"அன்று","gloss":"not being"}],"gloss":"not being"},{"surface":"மொழியினும்","parts":[{"text":"மொழியினும்","lemma":"மொழியினும்","gloss":"even if they speak"}],"gloss":"even if they speak","split_unverified":true}]},{"words":[{"surface":"வறிது","parts":[{"text":"வறிது","lemma":"வறிது","gloss":"empty-handed"}],"gloss":"empty-handed"},{"surface":"பெயர்குநர்","parts":[{"text":"பெயர்","lemma":"பெயர்","gloss":"return"},{"text":"கு","lemma":"கு","gloss":"future tense marker"},{"text":"நர்","lemma":"நர்","gloss":"they"}],"gloss":"those who return"},{"surface":"அல்லர்","parts":[{"text":"அல்","lemma":"அல்","gloss":"not"},{"text":"அர்","lemma":"அர்","gloss":"they"}],"gloss":"they are not"},{"surface":"நெறி","parts":[{"text":"நெறி","lemma":"நெறி","gloss":"way"}],"gloss":"way"},{"surface":"கொள","parts":[{"text":"கொள","lemma":"கொள்","gloss":"to take"}],"gloss":"to take"}]},{"words":[{"surface":"பாடு","parts":[{"text":"பாடு","lemma":"பாடு","gloss":"sounding"}],"gloss":"sounding"},{"surface":"ஆன்று","parts":[{"text":"ஆன்று","lemma":"அமை","gloss":"having become abundant"}],"gloss":"abundantly"},{"surface":"இரங்கும்","parts":[{"text":"இரங்கு","lemma":"இரங்கு","gloss":"roar"},{"text":"உம்","lemma":"உம்","gloss":"adjectival participle suffix"}],"gloss":"roaring"},{"surface":"அருவி","parts":[{"text":"அருவி","lemma":"அருவி","gloss":"waterfall"}],"gloss":"waterfall"}]},{"words":[{"surface":"பீடு","parts":[{"text":"பீடு","lemma":"பீடு","gloss":"greatness"}],"gloss":"greatness"},{"surface":"கெழு","parts":[{"text":"கெழு","lemma":"கெழு","gloss":"possessing"}],"gloss":"possessing"},{"surface":"மலையற்","parts":[{"text":"மலையற்","lemma":"மலையற்","gloss":"to Malaiyaṉ"}],"gloss":"to Malaiyaṉ","split_unverified":true},{"surface":"பாடி","parts":[{"text":"பாடி","lemma":"பாடு","gloss":"having sung"}],"gloss":"having sung"},{"surface":"யோரே","parts":[{"text":"யோரே","lemma":"யோரே","gloss":"indeed those who"}],"gloss":"indeed those who","split_unverified":true}]}],"literal":"Even if they go on an inauspicious day, with birds blocking their way in the middle, / even if they enter at an improper time and speak in an inappropriate manner, / they are not those who return empty-handed, as they take their path, / where waterfalls roar with abundant sound, / those who have sung of Malaiyaṉ, who possesses greatness.","translation":"Even if they set out on an unlucky day and birds block their path, even if they enter at an improper time and speak inelegant words, they never return empty-handed along their path—those who sing of Malaiyaṉ of great renown, whose mountains abound with the roar of cascading waterfalls.","modern":"அபசகுனமான நாளில் புறப்பட்டு, பறவைகள் வழியை மறித்தாலும், தகுதியற்ற நேரத்தில் சென்று, முறையற்ற சொற்களைப் பேசினாலும், மிகுந்த பெருமை உடையவனும், ஓசையோடு ஆரவாரித்து விழும் அருவிகளைக் கொண்ட மலையக நாட்டுத் தலைவனுமாகிய மலையமான் திருமுடிக்காரியைப் பாடிச் செல்பவர்கள், தங்கள் வழியில் வெறும் கையோடு திரும்பிப் போக மாட்டார்கள்.","explanation":"This poem is addressed to the chieftain Malaiyamāṉ Tirumuṭikkāri by the poet Kapilar under the theme of 'iyaṉ moḻi' (praising a patron's natural virtues) in the Paṭāṇ tiṇai. The poet extols the boundless generosity of Kāri, stating that bards who sing his praises never return empty-handed. Even if the singers set out on an unlucky day with bad omens like birds blocking their path, or if they arrive at an inconvenient hour and speak inappropriately, Kāri's grace is so immense that he still rewards them richly. The image of the roaring waterfalls on his mountain slopes reflects his overflowing and unstoppable generosity. Key words include 'puḷ' (bird/omen), 'vaṟitu' (empty-handed), and 'malaiyaṉ' (the mountain lord).","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.7],[0.7,1.15],[1.15,1.57],[1.57,1.9],[1.9,3.0],[3.0,3.2],[3.2,3.9],[3.9,4.4],[4.4,4.4],[4.4,5.84],[6.0,6.6],[6.6,6.8],[6.8,6.9],[6.9,7.7],[7.7,8.0],[8.0,8.1],[8.1,8.5],[8.74,9.47],[9.47,9.71],[9.96,10.2],[10.2,10.2],[10.2,11.0]],"female":[[0.0,0.8],[0.8,1.27],[1.27,1.77],[1.77,3.29],[3.29,3.29],[3.29,3.56],[3.56,4.2],[4.2,4.8],[4.8,5.9],[5.9,6.2],[6.2,7.0],[7.0,7.2],[7.2,7.3],[7.3,8.1],[8.1,8.5],[8.5,8.7],[8.7,9.2],[9.2,9.5],[9.5,9.8],[9.8,10.1],[10.1,10.4],[10.4,10.7]]},"sync":[[["நாள்","day"],["அன்று","not being"]],[["போடி","having gone"],["புள்","bird"]],[["புள்","bird"],["இடை","middle"]],[["தட்ப","to block"]],[["பதன்","proper time"],["அன்று","not being"]],[["புக்கு","having entered"],["திறன்","appropriate manner"]],[["திறன்","appropriate manner"],["அன்று","not being"]],[["மொழியினும்","even if they speak"]],[["வறிது","empty-handed"]],[["பெயர்குநர்","those who return"]],[["அல்லர்","they are not"]],[["நெறி","way"]],[["கொள","to take"]],[["பாடு","sounding"]],[["ஆன்று","abundantly"]],[["இரங்கும்","roaring"]],[["அருவி","waterfall"]],[["பீடு","greatness"]],[["கெழு","possessing"]],[["மலையற்","to Malaiyaṉ"]],[["பாடி","having sung"]],[["யோரே","indeed those who"]]]}