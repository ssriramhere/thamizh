{"text":"purananuru","n":86,"lines":["சிற்றில் நற்றூண் பற்றி நின்மகன்","யாண்டு உளன் ஆயினும் அறியேன் ஓரும்","புலி சேர்ந்து போகிய கல்அளை போல","ஈன்ற வயிறோ இதுவே","தோன்றுவன் மாதோ போர்க்களத் தானே"],"tr":["ciṟṟil naṟṟūṇ paṟṟi niṉmakaṉ","yāṇṭu uḷaṉ āyiṉum aṟiyēṉ ōrum","puli cērntu pōkiya kalaḷai pōla","īṉṟa vayiṟō ituvē","tōṉṟuvaṉ mātō pōrkkaḷat tāṉē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"ஏறாண் முல்லை","poet_ta":"காவற் பெண்டு காதற்பெண்டு எனவும் பாடம்","poet_tr":"Kāvaṟ Peṇṭu Kātaṟpeṇṭu Eṉavum Pāṭam"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 10, āciriyattaḷai 8"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"சிற்றில்","tr":"ciṟṟil","foot":"tēmā","acai":[{"kind":"nēr","text":"சிற்","tr":"ciṟ"},{"kind":"nēr","text":"றில்","tr":"ṟil"}]},{"text":"நற்றூண்","tr":"naṟṟūṇ","foot":"tēmā","acai":[{"kind":"nēr","text":"நற்","tr":"naṟ"},{"kind":"nēr","text":"றூண்","tr":"ṟūṇ"}]},{"text":"பற்றி","tr":"paṟṟi","foot":"tēmā","acai":[{"kind":"nēr","text":"பற்","tr":"paṟ"},{"kind":"nēr","text":"றி","tr":"ṟi"}]},{"text":"நின்மகன்","tr":"niṉmakaṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"நின்","tr":"niṉ"},{"kind":"nirai","text":"மகன்","tr":"makaṉ"}]}],[{"text":"யாண்டுள","tr":"yāṇṭuḷa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யாண்","tr":"yāṇ"},{"kind":"nirai","text":"டுள","tr":"ṭuḷa"}]},{"text":"னாயினு","tr":"ṉāyiṉu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"னா","tr":"ṉā"},{"kind":"nirai","text":"யினு","tr":"yiṉu"}]},{"text":"மறியே","tr":"maṟiyē","foot":"puḷimā","acai":[{"kind":"nirai","text":"மறி","tr":"maṟi"},{"kind":"nēr","text":"யே","tr":"yē"}]},{"text":"னோரும்","tr":"ṉōrum","foot":"tēmā","acai":[{"kind":"nēr","text":"னோ","tr":"ṉō"},{"kind":"nēr","text":"ரும்","tr":"rum"}]}],[{"text":"புலிசேர்ந்","tr"