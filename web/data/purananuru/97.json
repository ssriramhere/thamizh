்தாள்","tr":"taṭantāḷ","foot":"puḷimā","acai":[{"kind":"nirai","text":"தடந்","tr":"taṭan"},{"kind":"nēr","text":"தாள்","tr":"tāḷ"}]}],[{"text":"பிணிக்கதிர்","tr":"piṇikkatir","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பிணிக்","tr":"piṇik"},{"kind":"nirai","text":"கதிர்","tr":"katir"}]},{"text":"நெல்லின்","tr":"nelliṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"நெல்","tr":"nel"},{"kind":"nēr","text":"லின்","tr":"liṉ"}]},{"text":"செம்மல்","tr":"cemmal","foot":"tēmā","acai":[{"kind":"nēr","text":"செம்","tr":"cem"},{"kind":"nēr","text":"மல்","tr":"mal"}]},{"text":"மூதூர்","tr":"mūtūr","foot":"tēmā","acai":[{"kind":"nēr","text":"மூ","tr":"mū"},{"kind":"nēr","text":"தூர்","tr":"tūr"}]}],[{"text":"நுமக்குரித்","tr":"numakkurit","foot":"karuviḷam","acai":[{"kind":"nirai","text":"நுமக்","tr":"numak"},{"kind":"nirai","text":"குரித்","tr":"kurit"}]},{"text":"தாகல்","tr":"tākal","foot":"tēmā","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"கல்","tr":"kal"}]},{"text":"வேண்டின்","tr":"vēṇṭiṉ","foot":"tēmā","acai":[{"kind":"nēr","text":"வேண்","tr":"vēṇ"},{"kind":"nēr","text":"டின்","tr":"ṭiṉ"}]},{"text":"சென்றவற்","tr":"ceṉṟavaṟ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"சென்","tr":"ceṉ"},{"kind":"nirai","text":"றவற்","tr":"ṟavaṟ"}]}],[{"text":"கிறுக்கல்","tr":"kiṟukkal","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிறுக்","tr":"kiṟuk"},{"kind":"nēr","text":"கல்","tr":"kal"}]},{"text":"வேண்டும்","tr":"vēṇṭum","foot":"tēmā","acai":[{"kind":"nēr","text":"வேண்","tr":"vēṇ"},{"kind":"nēr","text":"டும்","tr":"ṭum"}]},{"text":"திறையே","tr":"tiṟaiyē","foot":"puḷimā","acai":[{"kind":"nirai","text":"திறை","tr":"tiṟai"},{"kind":"nēr","text":"யே","tr":"yē"}]},{"text":"மறிப்பி","tr":"maṟippi","foot":"puḷimā","acai":[{"kind":"nirai","text":"மறிப்","tr":"maṟip"},{"kind":"nēr","text":"பி","tr":"pi"}]}],[{"text":"னொல்வா","tr":"ṉolvā","foot":"tēmā","acai":[{"kind":"nēr","text":"னொல்","tr":"ṉol"},{"kind":"nēr","text":"வா","tr":"vā"}]},{"text":"னல்லன்","tr":"ṉallaṉ