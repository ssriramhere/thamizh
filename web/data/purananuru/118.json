{"text":"purananuru","n":118,"lines":["அறையும் பொறையும் மணந்த தலைய","எண் நாள் திங்கள் அனைய கொடுங் கரைத்","தெண் ணீர்ச் சிறுகுளம் கீள்வது மாதோ","கூர் வேல் குவைஇய மொய்ம்பின்","தேர்வண் பாரி தண் பறம்பு நாடே"],"tr":["aṟaiyum poṟaiyum maṇanta talaiya","eṇ nāḷ tiṅkaḷ aṉaiya koṭuṅ karait","teṇ ṇīrc ciṟukuḷam kīḷvatu mātō","kūr vēl kuvaiiya moympiṉ","tērvaṇ pāri taṇ paṟampu nāṭē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"கையறுநிலை","poet_ta":"கபிலர்","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 11, āciriyattaḷai 7"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"அறையும்","tr":"aṟaiyum","foot":"puḷimā","acai":[{"kind":"nirai","text":"அறை","tr":"aṟai"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"பொறையும்","tr":"poṟaiyum","foot":"puḷimā","acai":[{"kind":"nirai","text":"பொறை","tr":"poṟai"},{"kind":"nēr","text":"யும்","tr":"yum"}]},{"text":"மணந்த","tr":"maṇanta","foot":"puḷimā","acai":[{"kind":"nirai","text":"மணந்","tr":"maṇan"},{"kind":"nēr","text":"த","tr":"ta"}]},{"text":"தலைய","tr":"talaiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"தலை","tr":"talai"},{"kind":"nēr","text":"ய","tr":"ya"}]}],[{"text":"வெண்நாள்","tr":"veṇnāḷ","foot":"tēmā","acai":[{"kind":"nēr","text":"வெண்","tr":"veṇ"},{"kind":"nēr","text":"நாள்","tr":"nāḷ"}]},{"text":"திங்க","tr":"tiṅka","foot":"tēmā","acai":[{"kind":"nēr","text":"திங்","tr":"tiṅ"},{"kind":"nēr","text":"க","tr":"ka"}]},{"text":"ளனைய","tr":"ḷaṉaiya","foot":"puḷimā","acai":[{"kind":"nirai","text":"ளனை","tr":"ḷaṉai"},{"kind":"nēr","text":"ய","tr":"ya"}]},{"text":"கொடுங்கரைத்","tr":"koṭuṅkarait","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கொடுங்","tr":"koṭuṅ"},{"kind":"nirai","text":"கரைத்","tr":"karait"}]}],[{"text":"தெண்ணீர்ச்","tr