{"text":"purananuru","n":87,"lines":["களம்புகல் ஓம்புமின் தெவ்விர் போர் எதிர்ந்து","எம்முளும் உளன்ஒரு பொருநன் வைகல்","எண் தேர் செய்யும் தச்சன்","திங்கள் வலித்த கால்அன் னோனே"],"tr":["kaḷampukal ōmpumiṉ tevvir pōr etirntu","emmuḷum uḷaṉoru porunaṉ vaikal","eṇ tēr ceyyum taccaṉ","tiṅkaḷ valitta kālaṉ ṉōṉē"],"colophon":{"tinai":"tumpai","tinai_ta":"தும்பை","turai_ta":"தானை மறம்","poet_ta":"ஔவையார்","addressed_ta":"அதியமான் நெடுமானஞ்சி","poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"4 lines"},{"name":"feet per line","ok":true,"detail":"3×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 15"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 10, veṇṭaḷai 4"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"களம்புக","tr":"kaḷampuka","foot":"karuviḷam","acai":[{"kind":"nirai","text":"களம்","tr":"kaḷam"},{"kind":"nirai","text":"புக","tr":"puka"}]},{"text":"லோம்புமின்","tr":"lōmpumiṉ","foot":"kūviḷam","acai":[{"kind":"nēr","text":"லோம்","tr":"lōm"},{"kind":"nirai","text":"புமின்","tr":"pumiṉ"}]},{"text":"தெவ்விர்","tr":"tevvir","foot":"tēmā","acai":[{"kind":"nēr","text":"தெவ்","tr":"tev"},{"kind":"nēr","text":"விர்","tr":"vir"}]},{"text":"போரெதிர்ந்","tr":"pōretirn","foot":"kūviḷam","acai":[{"kind":"nēr","text":"போ","tr":"pō"},{"kind":"nirai","text":"ரெதிர்ந்","tr":"retirn"}]}],[{"text":"தெம்முளு","tr":"temmuḷu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"தெம்","tr":"tem"},{"kind":"nirai","text":"முளு","tr":"muḷu"}]},{"text":"முளனொரு","tr":"muḷaṉoru","foot":"karuviḷam","acai":[{"kind":"nirai","text":"முள","tr":"muḷa"},{"kind":"nirai","text":"னொரு","tr":"ṉoru"}]},{"text":"பொருநன்","tr":"porunaṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"பொரு","tr":"poru"},{"kind":"nēr","text":"நன்","tr":"naṉ"}]},{"text":"வைக","tr":"vaika","foot":"tēmā","acai":[{"kind":"nēr","text":"வை","tr":"vai"},{"kind":"nēr","text":"க","tr":"ka"}]}],[{"text":"லெண்தேர்","tr":"leṇtēr","