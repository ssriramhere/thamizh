{"text":"purananuru","n":81,"lines":["ஆர்ப்பு எழு கடலினும் பெரிது அவன் களிறே","கார்ப்பெயல் உருமின் முழங்கல் ஆனாவே","யார்கொல் அளியர் தாமே ஆர் நார்ச்","செறியத் தொடுத்த கண்ணிக்","கவிகை மள்ளன் கைப்பட் டோரே"],"tr":["ārppu eḻu kaṭaliṉum peritu avaṉ kaḷiṟē","kārppeyal urumiṉ muḻaṅkal āṉāvē","yārkol aḷiyar tāmē ār nārc","ceṟiyat toṭutta kaṇṇik","kavikai maḷḷaṉ kaippaṭ ṭōrē"],"colophon":{"tinai":"vākai","tinai_ta":"வாகை","turai_ta":"அரசவாகை","poet_ta":"சாத்தந்தையார்","addressed_ta":"சோழன் போர்வைக்கோப் பெருநற்கிள்ளி","poet_tr":"Cāttantaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"5 lines"},{"name":"feet per line","ok":true,"detail":"4×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 19"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 12, veṇṭaḷai 6"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"ஆர்ப்பெழு","tr":"ārppeḻu","foot":"kūviḷam","acai":[{"kind":"nēr","text":"ஆர்ப்","tr":"ārp"},{"kind":"nirai","text":"பெழு","tr":"peḻu"}]},{"text":"கடலினும்","tr":"kaṭaliṉum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"கட","tr":"kaṭa"},{"kind":"nirai","text":"லினும்","tr":"liṉum"}]},{"text":"பெரிதவன்","tr":"peritavaṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பெரி","tr":"peri"},{"kind":"nirai","text":"தவன்","tr":"tavaṉ"}]},{"text":"களிறே","tr":"kaḷiṟē","foot":"puḷimā","acai":[{"kind":"nirai","text":"களி","tr":"kaḷi"},{"kind":"nēr","text":"றே","tr":"ṟē"}]}],[{"text":"கார்ப்பெய","tr":"kārppeya","foot":"kūviḷam","acai":[{"kind":"nēr","text":"கார்ப்","tr":"kārp"},{"kind":"nirai","text":"பெய","tr":"peya"}]},{"text":"லுருமின்","tr":"lurumiṉ","foot":"puḷimā","acai":[{"kind":"nirai","text":"லுரு","tr":"luru"},{"kind":"nēr","text":"மின்","tr":"miṉ"}]},{"text":"முழங்கலா","tr":"muḻaṅkalā","foot":"karuviḷam","acai":[{"kind":"nirai","text":"முழங்","tr":"muḻaṅ"},{"kind":"nirai","text":"கலா","tr":"kalā"}]},{"text":"னாவே","tr":"ṉāvē","foot":"tēmā","acai":[{"kind":"nēr","text":"ன