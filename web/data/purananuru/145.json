{"text":"purananuru","n":145,"lines":["மடத்தகை மாமயில் பனிக்கும் என்று அருளிப்","படாஅம் ஈத்த கெடாஅ நல்லிசைக்","கடாஅ யானைக் கலிமான் பேக","பசித்தும் வாரோம் பாரமும் இலமே","களங்கனி யன்ன கருங்கோட்டுச் சீறியாழ்","நயம்புரிந் துறையுநர் நடுங்கப் பண்ணி","அறம்செய் தீமோ அருள்வெய் யோய் என","இ·தியாம் இரந்த பரிசில் அ·து இருளின்","இனமணி நெடுந்தேர் ஏறி","இன்னாது உறைவி அரும்படர் களைமே"],"tr":["maṭattakai māmayil paṉikkum eṉṟu aruḷip","paṭāam ītta keṭāa nallicaik","kaṭāa yāṉaik kalimāṉ pēka","pacittum vārōm pāramum ilamē","kaḷaṅkaṉi yaṉṉa karuṅkōṭṭuc cīṟiyāḻ","nayampurin tuṟaiyunar naṭuṅkap paṇṇi","aṟamcey tīmō aruḷvey yōy eṉa","itiyām iranta paricil atu iruḷiṉ","iṉamaṇi neṭuntēr ēṟi","iṉṉātu uṟaivi arumpaṭar kaḷaimē"],"colophon":{"tinai":"peruntiṇai","tinai_ta":"பெருந்திணை","turai_ta":"குறுங்கலி","poet_ta":"கபிலர்","addressed_ta":"வையாவிக் கோப்பெரும் பேகன்","poet_tr":"Kapilar"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"10 lines"},{"name":"feet per line","ok":true,"detail":"9×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 38, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 23, veṇṭaḷai 15"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"மடத்தகை","tr":"maṭattakai","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மடத்","tr":"maṭat"},{"kind":"nirai","text":"தகை","tr":"takai"}]},{"text":"மாமயில்","tr":"māmayil","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"மயில்","tr":"mayil"}]},{"text":"பனிக்குமென்","tr":"paṉikkumeṉ","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பனிக்","tr":"paṉik"},{"kind":"nirai","text":"குமென்","tr":"kumeṉ"}]},{"text":"றருளிப்","tr":"ṟaruḷip","foot":"puḷimā","acai":[{"kind":"nirai","text":"றரு","tr":"ṟaru"},{"kind":"nēr","text":"ளிப்","tr":"ḷip"}]}],[{"text":"படாஅ","tr":"paṭāa","foot":"puḷimā","acai":[{"kind":"nirai","text":"படா","tr":"paṭā"},{"kind":"nēr","text":"அ","tr":"a"}]},{"text":"மீத்த","tr":"mītta"