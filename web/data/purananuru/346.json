{"text":"purananuru","n":346,"lines":["பிற … ள பால் என மடுத்தலின்","ஈன்ற தாயோ வேண்டாள் அல்லள்","கல்வியென் என்னும் வல்லாண் சிறாஅன்","ஒள்வேல் நல்லன் அதுவாய் ஆகுதல்_","அழிந்தோர் அழிய ஒழிந்தோர் ஒக்கல்","பேணுநர்ப் பெறாஅது விளியும்","புன்தலைப் பெரும்பாழ் செயும் இவள் நலனே"],"tr":["piṟa ḷa pāl eṉa maṭuttaliṉ","īṉṟa tāyō vēṇṭāḷ allaḷ","kalviyeṉ eṉṉum vallāṇ ciṟāaṉ","oḷvēl nallaṉ atuvāy ākutal","aḻintōr aḻiya oḻintōr okkal","pēṇunarp peṟāatu viḷiyum","puṉtalaip perumpāḻ ceyum ivaḷ nalaṉē"],"colophon":{"tinai":"kāñci","tinai_ta":"காஞ்சி","turai_ta":"மகட்பாற் காஞ்சி","poet_ta":"அண்டர் மகன் குறுவழுதி","poet_tr":"Aṇṭar Makaṉ Kuṟuvaḻuti"},"scan":{"meter":"āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"7 lines"},{"name":"feet per line","ok":true,"detail":"6×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 27"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 19, veṇṭaḷai 7"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பிறள","tr":"piṟaḷa","foot":"puḷimā","acai":[{"kind":"nirai","text":"பிற","tr":"piṟa"},{"kind":"nēr","text":"ள","tr":"ḷa"}]},{"text":"பாலென","tr":"pāleṉa","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nirai","text":"லென","tr":"leṉa"}]},{"text":"மடுத்தலி","tr":"maṭuttali","foot":"karuviḷam","acai":[{"kind":"nirai","text":"மடுத்","tr":"maṭut"},{"kind":"nirai","text":"தலி","tr":"tali"}]}],[{"text":"னீன்ற","tr":"ṉīṉṟa","foot":"tēmā","acai":[{"kind":"nēr","text":"னீன்","tr":"ṉīṉ"},{"kind":"nēr","text":"ற","tr":"ṟa"}]},{"text":"தாயோ","tr":"tāyō","foot":"tēmā","acai":[{"kind":"nēr","text":"தா","tr":"tā"},{"kind":"nēr","text":"யோ","tr":"yō"}]},{"text":"வேண்டா","tr":"vēṇṭā","foot":"tēmā","acai":[{"kind":"nēr","text":"வேண்","tr":"vēṇ"},{"kind":"nēr","text":"டா","tr":"ṭā"}]},{"text":"ளல்லள்","tr":"ḷallaḷ","foot":"tēmā","acai":[{"kind":"nēr","text":"ளல்","tr":"ḷal"},{"kind":"nēr","text":"லள்","tr":"laḷ"}]}],[{"text":"கல்வியெ","tr":"kalviye","foot":"kūviḷam","acai":[{"kind":"nēr","t