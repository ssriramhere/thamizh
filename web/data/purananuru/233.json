{"text":"purananuru","n":233,"lines":["பொய்யா கியரோ பொய்யா கியரோ","பாவடி யானை பரிசிலர்க்கு அருகாச்","சீர்கெழு நோன்றாள் அகுதைகண் தோன்றிய","பொன்புனை திகிரியின் பொய்யா கியரோ","இரும்பாண் ஒக்கல் தலைவன் பெரும்பூண்","போர்அடு தானை எவ்வி மார்பின்","எ·குஉறு விழுப்புண் பல என","வைகறு விடியல் இயம்பிய குரலே"],"tr":["poyyā kiyarō poyyā kiyarō","pāvaṭi yāṉai paricilarkku arukāc","cīrkeḻu nōṉṟāḷ akutaikaṇ tōṉṟiya","poṉpuṉai tikiriyiṉ poyyā kiyarō","irumpāṇ okkal talaivaṉ perumpūṇ","pōraṭu tāṉai evvi mārpiṉ","ekuuṟu viḻuppuṇ pala eṉa","vaikaṟu viṭiyal iyampiya kuralē"],"colophon":{"tinai":"potuviyal","tinai_ta":"பொதுவியல்","turai_ta":"கையறுநிலை","poet_ta":"வெள்ளெருக்கிலையார்","addressed_ta":"வேள் எவ்வி","poet_tr":"Veḷḷerukkilaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"8 lines"},{"name":"feet per line","ok":true,"detail":"7×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 30, veṇcīr 1"},{"name":"linkage","ok":true,"detail":"veṇṭaḷai 18, āciriyattaḷai 12"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"பொய்யா","tr":"poyyā","foot":"tēmā","acai":[{"kind":"nēr","text":"பொய்","tr":"poy"},{"kind":"nēr","text":"யா","tr":"yā"}]},{"text":"கியரோ","tr":"kiyarō","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிய","tr":"kiya"},{"kind":"nēr","text":"ரோ","tr":"rō"}]},{"text":"பொய்யா","tr":"poyyā","foot":"tēmā","acai":[{"kind":"nēr","text":"பொய்","tr":"poy"},{"kind":"nēr","text":"யா","tr":"yā"}]},{"text":"கியரோ","tr":"kiyarō","foot":"puḷimā","acai":[{"kind":"nirai","text":"கிய","tr":"kiya"},{"kind":"nēr","text":"ரோ","tr":"rō"}]}],[{"text":"பாவடி","tr":"pāvaṭi","foot":"kūviḷam","acai":[{"kind":"nēr","text":"பா","tr":"pā"},{"kind":"nirai","text":"வடி","tr":"vaṭi"}]},{"text":"யானை","tr":"yāṉai","foot":"tēmā","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nēr","text":"னை","tr":"ṉai"}]},{"text":"பரிசிலர்க்","tr":"paricilark","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பரி","tr":"pari"},