rface":"தலைவன்","parts":[{"text":"தலைவன்","lemma":"தலைவன்","gloss":"leader"}],"gloss":"leader"},{"surface":"பெரும்பூண்","parts":[{"text":"பெரும்","lemma":"பெரு","gloss":"great"},{"text":"பூண்","lemma":"பூண்","gloss":"ornament"}],"gloss":"great ornaments"}]},{"words":[{"surface":"போர்அடு","parts":[{"text":"போர்","lemma":"போர்","gloss":"war"},{"text":"அடு","lemma":"அடு","gloss":"slaying"}],"gloss":"war-slaying"},{"surface":"தானை","parts":[{"text":"தானை","lemma":"தானை","gloss":"army"}],"gloss":"army"},{"surface":"எவ்வி","parts":[{"text":"எவ்வி","lemma":"எவ்வி","gloss":"Evvi"}],"gloss":"Evvi"},{"surface":"மார்பின்","parts":[{"text":"மார்பு","lemma":"மார்பு","gloss":"chest"},{"text":"இன்","lemma":"இன்","gloss":"of"}],"gloss":"on the chest"}]},{"words":[{"surface":"எஃகுஉறு","parts":[{"text":"எஃகுஉறு","lemma":"எஃகுஉறு","gloss":"received from spears"}],"gloss":"received from spears","split_unverified":true},{"surface":"விழுப்புண்","parts":[{"text":"விழு","lemma":"விழு","gloss":"glorious"},{"text":"புண்","lemma":"புண்","gloss":"wound"}],"gloss":"glorious wounds"},{"surface":"பல","parts":[{"text":"பல","lemma":"பல","gloss":"many"}],"gloss":"many"},{"surface":"என","parts":[{"text":"என","lemma":"என","gloss":"thus"}],"gloss":"thus"}]},{"words":[{"surface":"வைகறு","parts":[{"text":"வைகு","lemma":"வைகு","gloss":"dawn"},{"text":"அறு","lemma":"அறு","gloss":"to end"}],"gloss":"dawn-ending"},{"surface":"விடியல்","parts":[{"text":"விடியல்","lemma":"விடியல்","gloss":"early morning"}],"gloss":"early morning"},{"surface":"இயம்பிய","parts":[{"text":"இயம்பிய","lemma":"இயம்பு","gloss":"sounded"}],"gloss":"sounded"},{"surface":"குரலே","parts":[{"text":"குரல்","lemma":"குரல்","gloss":"voice"},{"text":"ஏ","lemma":"ஏ","gloss":"emphasis"}],"gloss":"the voice"}]}],"literal":"May it become false! May it become false! / The flat-footed elephants to the recipients of gifts, without limit, / with the gold-crafted discus that appeared with Akuthai of excellent and strong effort, / may it become false! / The leader of the large family of bards, with great ornaments, / on the chest of Evvi of the army that slays in war, / 'the glorious wounds received from spears are many', thus / the voice that sounded in the early morning of dawn!","translation":"May it be false! May it be false! Like the gold-crafted discus of Akuthai, of excellent and strong effort, who gave flat-footed elephants to bards without limit, may it be false! The voice that sounded in the early morning of dawn, saying, 'Many are the glorious wounds from spears on the chest of Evvi, the leader of the large family of bards, who has a war-slaying army and wears great ornaments!'","modern":"பொய்யாகக் கடவது! பொய்யாகக் கடவது! கொடைபெறுவோர்க்குப் பரந்த அடிகளையுடைய யானைகளை எல்லையின்றி வழங்கிய, சீர்மிகுந்த வலிமையான முயற்சியையுடைய அகுதையிடம் விளங்கிய பொன்னால் செய்யப்பட்ட சக்கரத்தைப் போல, இச்செய்தி பொய்யாகக் கடவது! பெரிய பாணர் சுற்றத்தின் தலைவனும், பெரிய அணிகலன்களை அணிந்தவனும், போரைக் கொல்லும் படையையுடையவனுமாகிய எவ்வியின் மார்பில், 'வேலினால் ஏற்பட்ட சிறந்த புண்கள் பல உள்ளன' என்று வைகறை விடியலில் ஒலித்த குரல் பொய்யாகக் கடவது!","explanation":"This poem is in the tiṇai of Potuviyal and the tuṟai of Kaiyaṟunilai (state of helplessness/lament). The poet Vellerukkilaiyar laments the death of the chieftain Vel Evvi. Hearing the news at dawn that Evvi has received fatal wounds on his chest in battle, the poet wishes desperately that this news is false. He compares his wish for the news to be false to the legendary gold discus of Akuthai, which was known for its unfailing truth and power. The poem beautifully captures the deep grief of the bards who have lost their generous patron and protector.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.6],[0.6,0.8],[0.8,1.6],[1.6,1.8],[1.8,3.1],[3.1,3.3],[3.3,3.5],[3.5,4.28],[4.5,5.6],[5.6,5.77],[5.77,5.8],[5.8,7.2],[7.2,8.2],[8.2,8.4],[8.4,9.2],[9.2,9.4],[9.4,10.6],[10.6,10.7],[10.7,11.1],[11.1,11.8],[11.8,12.7],[12.7,13.0],[13.0,13.0],[13.0,13.3],[13.3,13.83],[14.23,14.9],[14.9,15.06],[15.54,15.7],[15.7,16.4],[16.4,16.5],[16.5,16.8],[16.8,17.3]],"female":[[0.0,0.5],[0.5,0.7],[0.7,1.5],[1.5,1.6],[1.6,2.7],[2.7,3.0],[3.0,3.2],[3.2,4.21],[4.5,5.7],[5.7,5.9],[5.9,6.7],[6.7,7.5],[7.5,8.4],[8.4,9.2],[9.2,9.5],[9.5,9.8],[9.8,11.2],[11.2,11.3],[11.3,11.8],[11.8,12.7],[12.7,13.6],[13.6,14.0],[14.0,14.1],[14.1,14.5],[14.97,15.9],[15.9,16.5],[16.5,16.8],[16.8,17.1],[17.1,18.0],[18.0,18.1],[18.1,18.5],[18.5,18.9]]}}