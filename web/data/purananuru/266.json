{"text":"purananuru","n":266,"lines":["பயங்கெழு மாமழை பெய்யாது மாறிக்","கயங்களி முளியும் கோடை ஆயினும்","புழற்கால் ஆம்பல் அகலடை நீழல்","கதிர்கோட்டு நந்தின் கரிமுக ஏற்றை","நாகுஇள வளையடு பகல்மணம் புகூஉம்","நீர்திகழ் கழனி நாடுகெழு பெருவிறல்","வான்தோய் நீள்குடை வயமான் சென்னி","சான்றோர் இருந்த அவையத்து உற்றோன்","ஆசாகு என்னும் பூசல்போல","வல்லே களைமதி அத்தை உள்ளிய","விருந்துகண்டு ஒளிக்கும் திருந்தா வாழ்க்கைப்","பொறிப்புணர் உடம்பில் தோன்றிஎன்","அறிவுகெட நின்ற நல்கூர் மையே","267 268 கிடைத்தில"],"tr":["payaṅkeḻu māmaḻai peyyātu māṟik","kayaṅkaḷi muḷiyum kōṭai āyiṉum","puḻaṟkāl āmpal akalaṭai nīḻal","katirkōṭṭu nantiṉ karimuka ēṟṟai","nākuiḷa vaḷaiyaṭu pakalmaṇam pukūum","nīrtikaḻ kaḻaṉi nāṭukeḻu peruviṟal","vāṉtōy nīḷkuṭai vayamāṉ ceṉṉi","cāṉṟōr irunta avaiyattu uṟṟōṉ","ācāku eṉṉum pūcalpōla","vallē kaḷaimati attai uḷḷiya","viruntukaṇṭu oḷikkum tiruntā vāḻkkaip","poṟippuṇar uṭampil tōṉṟieṉ","aṟivukeṭa niṉṟa nalkūr maiyē","kiṭaittila"],"colophon":{"tinai":"pāṭāṇ","tinai_ta":"பாடாண்","turai_ta":"பரிசில் கடாநிலை","poet_ta":"பெருங்குன்றூர் கிழார்","addressed_ta":"சோழன் உருவப்ப·றேர் இளஞ்சேட் சென்னி","poet_tr":"Peruṅkuṉṟūr Kiḻār"},"scan":{"meter":"not a regular āciriyappā","ok":false,"checks":[{"name":"lines","ok":true,"detail":"14 lines"},{"name":"feet per line","ok":true,"detail":"12×4, 1×3, 1×2 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 52, other 1"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 33, veṇṭaḷai 18, ? 1"},{"name":"ending","ok":false,"detail":"no usual ending"}],"ending":null,"lines":[[{"text":"பயங்கெழு","tr":"payaṅkeḻu","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பயங்","tr":"payaṅ"},{"kind":"nirai","text":"கெழு","tr":"keḻu"}]},{"text":"மாமழை","tr":"māmaḻai","foot":"kūviḷam","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nirai","text":"மழை","tr":"maḻai"}]},{"text":"பெய்யா","tr":"peyyā","foot":"tēmā","acai":[{"kind":"nēr","text":"பெய்","tr":"pey"},{"kind":"nēr","text":"யா","tr":"yā"}]},{"text":"துமாறிக்","tr":"tumāṟik","foot":"puḷimā","