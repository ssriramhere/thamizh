{"text":"purananuru","n":92,"lines":["யாழொடும் கொள்ளா பொழுதொடும் புணரா","பொருள்அறி வாரா ஆயினும் தந்தையர்க்கு","அருள்வந் தனவால் புதல்வர்தம் மழலை","என்வாய்ச் சொல்லும் அன்ன ஒன்னார்","கடி மதில் அரண்பல கடந்து","நெடுமான் அஞ்சி நீ அருளல் மாறே"],"tr":["yāḻoṭum koḷḷā poḻutoṭum puṇarā","poruḷaṟi vārā āyiṉum tantaiyarkku","aruḷvan taṉavāl putalvartam maḻalai","eṉvāyc collum aṉṉa oṉṉār","kaṭi matil araṇpala kaṭantu","neṭumāṉ añci nī aruḷal māṟē"],"colophon":{"tinai":"tumpai","tinai_ta":"தும்பை","turai_ta":"இயன் மொழி","poet_ta":"ஔவையார்","addressed_ta":"அதியமான் நெடுமான் அஞ்சி","poet_tr":"Auvaiyār"},"scan":{"meter":"nēricai āciriyappā","ok":true,"checks":[{"name":"lines","ok":true,"detail":"6 lines"},{"name":"feet per line","ok":true,"detail":"5×4, 1×3 feet"},{"name":"foot types","ok":true,"detail":"iyaṟcīr 21, veṇcīr 2"},{"name":"linkage","ok":true,"detail":"āciriyattaḷai 11, veṇṭaḷai 9, kalittaḷai 2"},{"name":"ending","ok":true,"detail":"ends on ஏ"}],"ending":"ஏ","lines":[[{"text":"யாழொடும்","tr":"yāḻoṭum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"யா","tr":"yā"},{"kind":"nirai","text":"ழொடும்","tr":"ḻoṭum"}]},{"text":"கொள்ளா","tr":"koḷḷā","foot":"tēmā","acai":[{"kind":"nēr","text":"கொள்","tr":"koḷ"},{"kind":"nēr","text":"ளா","tr":"ḷā"}]},{"text":"பொழுதொடும்","tr":"poḻutoṭum","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பொழு","tr":"poḻu"},{"kind":"nirai","text":"தொடும்","tr":"toṭum"}]},{"text":"புணரா","tr":"puṇarā","foot":"puḷimā","acai":[{"kind":"nirai","text":"புண","tr":"puṇa"},{"kind":"nēr","text":"ரா","tr":"rā"}]}],[{"text":"பொருளறி","tr":"poruḷaṟi","foot":"karuviḷam","acai":[{"kind":"nirai","text":"பொரு","tr":"poru"},{"kind":"nirai","text":"ளறி","tr":"ḷaṟi"}]},{"text":"வாரா","tr":"vārā","foot":"tēmā","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nēr","text":"ரா","tr":"rā"}]},{"text":"வாயினும்","tr":"vāyiṉum","foot":"kūviḷam","acai":[{"kind":"nēr","text":"வா","tr":"vā"},{"kind":"nirai","text":"யினும்","tr":"yiṉum"}]},{"text":"தந்தையர்க்","tr":"tantaiyark"