நீ","tr":"cinī"}]},{"text":"யருளல்","tr":"yaruḷal","foot":"puḷimā","acai":[{"kind":"nirai","text":"யரு","tr":"yaru"},{"kind":"nēr","text":"ளல்","tr":"ḷal"}]},{"text":"மாறே","tr":"māṟē","foot":"tēmā","acai":[{"kind":"nēr","text":"மா","tr":"mā"},{"kind":"nēr","text":"றே","tr":"ṟē"}]}]]},"ai":{"lines":[{"words":[{"surface":"யாழொடும்","parts":[{"text":"யாழ்","lemma":"yāḻ","gloss":"lute"},{"text":"ஒடும்","lemma":"oṭu","gloss":"with"}],"gloss":"with the lute"},{"surface":"கொள்ளா","parts":[{"text":"கொள்ளா","lemma":"koḷ","gloss":"not agreeing"}],"gloss":"not fitting"},{"surface":"பொழுதொடும்","parts":[{"text":"பொழுது","lemma":"poḻutu","gloss":"time/rhythm"},{"text":"ஒடும்","lemma":"oṭu","gloss":"with"}],"gloss":"with the rhythm"},{"surface":"புணரா","parts":[{"text":"புணரா","lemma":"puṇar","gloss":"not joining"}],"gloss":"not matching"}]},{"words":[{"surface":"பொருள்","parts":[{"text":"பொருள்","lemma":"poruḷ","gloss":"meaning"}],"gloss":"meaning"},{"surface":"அறிவாரா","parts":[{"text":"அறி","lemma":"aṟi","gloss":"to know"},{"text":"வாரா","lemma":"vārā","gloss":"not coming"}],"gloss":"not coming to be understood"},{"surface":"ஆயினும்","parts":[{"text":"ஆயினும்","lemma":"āyiṉum","gloss":"even though"}],"gloss":"even though"},{"surface":"தந்தையர்க்கு","parts":[{"text":"தந்தையர்","lemma":"tantai","gloss":"fathers"},{"text":"க்கு","lemma":"ku","gloss":"to"}],"gloss":"to the fathers"}]},{"words":[{"surface":"அருள்","parts":[{"text":"அருள்","lemma":"aruḷ","gloss":"delight/grace"}],"gloss":"delight"},{"surface":"வந்தனவால்","parts":[{"text":"வந்து","lemma":"vā","gloss":"having come"},{"text":"அன","lemma":"aṉa","gloss":"they (neuter)"},{"text":"ஆல்","lemma":"āl","gloss":"indeed"}],"gloss":"they indeed bring"},{"surface":"புதல்வர்","parts":[{"text":"புதல்வர்","lemma":"putalvaṉ","gloss":"children"}],"gloss":"children's"},{"surface":"தம்","parts":[{"text":"தம்","lemma":"tām","gloss":"their"}],"gloss":"their"},{"surface":"மழலை","parts":[{"text":"மழலை","lemma":"maḻalai","gloss":"babble/lisping speech"}],"gloss":"babble"}]},{"words":[{"surface":"என்","parts":[{"text":"என்","lemma":"yāṉ","gloss":"my"}],"gloss":"my"},{"surface":"வாய்ச்","parts":[{"text":"வாய்ச்","lemma":"வாய்ச்","gloss":"mouth's"}],"gloss":"mouth's","split_unverified":true},{"surface":"சொல்லும்","parts":[{"text":"சொல்","lemma":"col","gloss":"word"},{"text":"உம்","lemma":"um","gloss":"also"}],"gloss":"words also"},{"surface":"அன்ன","parts":[{"text":"அன்ன","lemma":"aṉṉa","gloss":"are like that"}],"gloss":"are like that"},{"surface":"ஒன்னார்","parts":[{"text":"ஒன்னார்","lemma":"oṉṉār","gloss":"enemies"}],"gloss":"enemies'"}]},{"words":[{"surface":"கடி","parts":[{"text":"கடி","lemma":"kaṭi","gloss":"well-guarded"}],"gloss":"well-guarded"},{"surface":"மதில்","parts":[{"text":"மதில்","lemma":"matil","gloss":"wall"}],"gloss":"walled"},{"surface":"அரண்","parts":[{"text":"அரண்","lemma":"araṇ","gloss":"fortress"}],"gloss":"fortresses"},{"surface":"பல","parts":[{"text":"பல","lemma":"pala","gloss":"many"}],"gloss":"many"},{"surface":"கடந்து","parts":[{"text":"கடந்து","lemma":"kaṭa","gloss":"having conquered"}],"gloss":"having conquered"}]},{"words":[{"surface":"நெடுமான்","parts":[{"text":"நெடுமான்","lemma":"neṭumāṉ","gloss":"Neduman"}],"gloss":"Neduman"},{"surface":"அஞ்சி","parts":[{"text":"அஞ்சி","lemma":"añci","gloss":"Anji"}],"gloss":"Anji"},{"surface":"நீ","parts":[{"text":"நீ","lemma":"nī","gloss":"you"}],"gloss":"you"},{"surface":"அருளல்","parts":[{"text":"அருளல்","lemma":"aruḷ","gloss":"bestowing favor"}],"gloss":"bestowing favor"},{"surface":"மாறே","parts":[{"text":"மாறு","lemma":"māṟu","gloss":"because of"},{"text":"ஏ","lemma":"ē","gloss":"indeed"}],"gloss":"because of indeed"}]}],"literal":"Not agreeing with the lute, not matching with the rhythm, / meaning not coming to be understood, even though, to the fathers / delight indeed they bring, the children's babble. / My mouth's words also are like that, of enemies / well-guarded walled fortresses many having conquered, / Neduman Anji, you bestowing favor because of.","translation":"Though it does not tune with the lute, nor match the rhythm, and its meaning cannot be understood, the lisping babble of children still brings immense joy to their fathers. My words are just like that to you, O Neduman Anji, who conquers the heavily guarded fortresses of your enemies, because you look upon me with such grace and favor.","modern":"யாழுடன் பொருந்தாமலும், தாளத்தோடு இணையாமலும், பொருள் விளங்காமலும் இருந்தாலும், பிள்ளைகளின் மழலைச் சொற்கள் தந்தையருக்கு மகிழ்ச்சியைத் தருகின்றன. பகைவர்களின் காவல் மிகுந்த மதில்களைக் கொண்ட பல கோட்டைகளை வென்ற நெடுமான் அஞ்சியே! நீ என் மீது காட்டும் பேரன்பினால், என்னுடைய சொற்களும் உனக்கு அத்தகைய மழலைச் சொற்களைப் போலவே இனிமையாகத் தோன்றுகின்றன.","explanation":"This poem is composed by the famous poet Avvaiyar in praise of her patron, the chieftain Athiyaman Neduman Anji. She beautifully compares her own poetic verses to the sweet, imperfect babble of young children. Just as a father finds deep joy in his child's lisping words, even when they lack proper rhythm, musical tune, or clear meaning, the great king finds joy in her simple poems. This comparison highlights the deep, affectionate bond between the patron and the poet. The poem contrasts the king's fierce, warrior nature in conquering heavily guarded enemy fortresses with his gentle, loving heart when listening to the poet's words.","model":"gemini-3.5-flash"},"timing":{"male":[[0.0,0.8],[0.8,1.1],[1.1,1.3],[1.3,1.7],[1.7,3.3],[3.3,3.7],[3.7,4.2],[4.2,4.4],[4.4,5.85],[5.85,5.9],[5.9,5.9],[5.9,7.5],[7.5,8.2],[8.2,8.4],[8.4,8.5],[8.5,8.9],[8.9,10.1],[10.1,10.3],[10.3,10.6],[10.6,11.4],[11.4,12.3],[12.3,12.6],[12.6,12.8],[12.8,13.4],[13.4,13.4]],"female":[[0.0,0.8],[0.8,1.1],[1.1,1.4],[1.4,1.8],[1.8,2.97],[3.2,3.7],[3.7,3.8],[3.8,4.3],[4.3,6.0],[6.0,6.0],[6.0,7.4],[7.4,7.7],[7.7,8.9],[8.9,9.1],[9.1,9.2],[9.2,9.6],[9.6,10.8],[10.8,11.1],[11.1,11.8],[11.8,11.9],[11.9,13.2],[13.2,13.7],[13.7,13.9],[13.9,14.5],[14.5,14.5]]},"sync":[[["யாழொடு